[
  {
    "start": 0.0,
    "end": 1.924,
    "text": "第七章 轮回"
  },
  {
    "start": 2.172,
    "end": 5.675,
    "text": "长久以来 悉达多虽不属于尘世"
  },
  {
    "start": 5.675,
    "end": 8.011,
    "text": "却经历了尘世生色之娱"
  },
  {
    "start": 8.011,
    "end": 10.53,
    "text": "他在狂热的沙门岁月中"
  },
  {
    "start": 10.53,
    "end": 17.08,
    "text": "被扼杀的感官渐渐苏醒他品尝了财富、淫乐和权力的滋味"
  },
  {
    "start": 17.08,
    "end": 19.479,
    "text": "唯有聪明的迦摩罗深知"
  },
  {
    "start": 19.479,
    "end": 21.639,
    "text": "他内心仍是个沙门"
  },
  {
    "start": 21.639,
    "end": 23.782,
    "text": "指引他生活的一直是"
  },
  {
    "start": 23.782,
    "end": 30.213,
    "text": "思考、等待和斋戒的技艺他和孩童般的世人间彼此依旧陌生"
  },
  {
    "start": 30.461,
    "end": 31.383,
    "text": "岁月如流"
  },
  {
    "start": 31.383,
    "end": 33.919,
    "text": "悉达多在饱食丰衣的日子"
  },
  {
    "start": 33.919,
    "end": 38.53,
    "text": "里几乎觉察不到流逝的光阴他已十分富有"
  },
  {
    "start": 38.53,
    "end": 40.694,
    "text": "早已拥有宅邸、仆从"
  },
  {
    "start": 40.694,
    "end": 47.669,
    "text": "和位于城郊河畔的花园人们攀附他 在需要借贷或忠告时求见他"
  },
  {
    "start": 47.669,
    "end": 50.368,
    "text": "但只有迦摩罗与他知近"
  },
  {
    "start": 50.616,
    "end": 52.99,
    "text": "在意气风发的青年时代"
  },
  {
    "start": 52.99,
    "end": 57.5,
    "text": "在聆听乔达摩宣法、告别乔文达后的岁月"
  },
  {
    "start": 57.5,
    "end": 61.8,
    "text": "悉达多曾拥有崇高的觉醒、迫切的期许"
  },
  {
    "start": 61.8,
    "end": 65.594,
    "text": "绝不仰仗法义和老师的独立豪情"
  },
  {
    "start": 65.594,
    "end": 69.383,
    "text": "他曾恭候内心神性的声音 如今"
  },
  {
    "start": 69.383,
    "end": 71.909,
    "text": "这一切已成记忆、往昔"
  },
  {
    "start": 71.909,
    "end": 74.688,
    "text": "曾在他心中呼啸的圣音"
  },
  {
    "start": 74.688,
    "end": 77.07,
    "text": "如今遥远而微弱地低语着"
  },
  {
    "start": 77.07,
    "end": 79.668,
    "text": "尽管他跟随沙门、乔达摩、"
  },
  {
    "start": 79.668,
    "end": 82.482,
    "text": "他婆罗门的父亲习得的学问"
  },
  {
    "start": 82.482,
    "end": 84.412,
    "text": "诸如节制地生活、"
  },
  {
    "start": 84.412,
    "end": 87.066,
    "text": "思考的乐趣、禅定的习惯"
  },
  {
    "start": 87.066,
    "end": 89.605,
    "text": "以及那关乎既非肉体亦"
  },
  {
    "start": 89.605,
    "end": 95.445,
    "text": "非意识的永恒之我的秘密知识仍长久地留在他心中"
  },
  {
    "start": 95.445,
    "end": 100.4,
    "text": "但许多已覆没 蒙尘 如同陶匠的旋盘"
  },
  {
    "start": 100.4,
    "end": 105.094,
    "text": "一经起模便长久旋转 随后却渐渐倦乏"
  },
  {
    "start": 105.094,
    "end": 105.355,
    "text": "停摆"
  },
  {
    "start": 105.355,
    "end": 108.124,
    "text": "悉达多灵魂的苦修之轮、"
  },
  {
    "start": 108.124,
    "end": 114.669,
    "text": "思想之轮、分辨之轮长久旋转着依旧旋转着 但它已渐缓"
  },
  {
    "start": 114.669,
    "end": 116.735,
    "text": "松动乃至接近静止"
  },
  {
    "start": 116.735,
    "end": 121.643,
    "text": "如同濒死的树干因潮气侵袭、注满而腐朽"
  },
  {
    "start": 121.643,
    "end": 125.652,
    "text": "世俗和惰性侵入并充满悉达多的灵魂"
  },
  {
    "start": 125.652,
    "end": 129.912,
    "text": "它不再轻盈 反而疲惫、麻痹 同时"
  },
  {
    "start": 129.912,
    "end": 133.723,
    "text": "他的感官却活跃起来 它学到许多"
  },
  {
    "start": 133.723,
    "end": 134.676,
    "text": "体验许多"
  },
  {
    "start": 134.924,
    "end": 138.199,
    "text": "悉达多学会做生意 发号施令"
  },
  {
    "start": 138.199,
    "end": 141.942,
    "text": "寻欢作乐 他学会穿戴华美的服饰"
  },
  {
    "start": 141.942,
    "end": 142.878,
    "text": "使唤仆从"
  },
  {
    "start": 142.878,
    "end": 147.184,
    "text": "在芳馥的水中沐浴 他学会品尝佳肴"
  },
  {
    "start": 147.184,
    "end": 149.211,
    "text": "也吃鱼、肉和飞禽"
  },
  {
    "start": 149.211,
    "end": 151.997,
    "text": "他学会享用香料和甜品"
  },
  {
    "start": 151.997,
    "end": 154.263,
    "text": "学会忘乎形骸地纵饮"
  },
  {
    "start": 154.263,
    "end": 158.544,
    "text": "他学会掷骰子、下棋 观赏舞女表演"
  },
  {
    "start": 158.544,
    "end": 161.566,
    "text": "乘轿子 睡在绵软的床上"
  },
  {
    "start": 161.566,
    "end": 165.648,
    "text": "只是他依旧自认与众不同 卓尔不群"
  },
  {
    "start": 165.648,
    "end": 169.01,
    "text": "对待他人 他总带着嘲弄的蔑视"
  },
  {
    "start": 169.01,
    "end": 171.141,
    "text": "如同沙门蔑视俗人"
  },
  {
    "start": 171.141,
    "end": 174.07,
    "text": "当迦摩施瓦弥不安、愤怒"
  },
  {
    "start": 174.07,
    "end": 177.799,
    "text": "自觉被冒犯或为生意烦恼时"
  },
  {
    "start": 177.799,
    "end": 180.243,
    "text": "他总是轻蔑地袖手旁观"
  },
  {
    "start": 180.243,
    "end": 182.932,
    "text": "随着秋收季和雨季的往复"
  },
  {
    "start": 182.932,
    "end": 186.843,
    "text": "他的蔑视在不知不觉间逐渐乏力"
  },
  {
    "start": 186.843,
    "end": 190.321,
    "text": "优越感逐渐平复 随着日进斗金"
  },
  {
    "start": 190.321,
    "end": 193.334,
    "text": "他也沾染了世人的幼稚和胆怯"
  },
  {
    "start": 193.334,
    "end": 194.957,
    "text": "而他羡慕世人"
  },
  {
    "start": 194.957,
    "end": 198.349,
    "text": "他越和他们相像 就越羡慕他们"
  },
  {
    "start": 198.349,
    "end": 199.931,
    "text": "他羡慕他们拥有"
  },
  {
    "start": 199.931,
    "end": 203.096,
    "text": "他却欠缺的对个人生活的重视"
  },
  {
    "start": 203.096,
    "end": 205.958,
    "text": "羡慕他们强烈的快乐和恐惧"
  },
  {
    "start": 205.958,
    "end": 208.343,
    "text": "羡慕他们为不安又甜蜜"
  },
  {
    "start": 208.343,
    "end": 211.205,
    "text": "的幸福感而不断坠入爱河"
  },
  {
    "start": 211.205,
    "end": 214.065,
    "text": "羡慕他们不懈地爱自己、爱"
  },
  {
    "start": 214.065,
    "end": 217.639,
    "text": "女人、爱他们的孩子、爱名望金钱"
  },
  {
    "start": 217.639,
    "end": 221.167,
    "text": "羡慕他们热衷于诸多盘算和祈盼"
  },
  {
    "start": 221.167,
    "end": 224.947,
    "text": "他无法效仿这孩童般的快乐和愚蠢"
  },
  {
    "start": 224.947,
    "end": 226.459,
    "text": "他学会的"
  },
  {
    "start": 226.459,
    "end": 229.941,
    "text": "恰是他最难接受、最蔑视的东西"
  },
  {
    "start": 229.941,
    "end": 234.418,
    "text": "在一夜狂欢后的清晨 他时常长久中辍"
  },
  {
    "start": 234.418,
    "end": 236.359,
    "text": "疲劳倦怠、浑浑噩噩"
  },
  {
    "start": 236.359,
    "end": 239.811,
    "text": "当迦摩施瓦弥的牢骚让他感到无聊时"
  },
  {
    "start": 239.811,
    "end": 241.537,
    "text": "他易怒而不耐"
  },
  {
    "start": 241.537,
    "end": 243.266,
    "text": "在掷骰子输光时"
  },
  {
    "start": 243.266,
    "end": 245.736,
    "text": "他夸张的笑声过分响亮"
  },
  {
    "start": 245.736,
    "end": 249.195,
    "text": "他看起来依旧比旁人聪敏、明智"
  },
  {
    "start": 249.195,
    "end": 251.171,
    "text": "但笑容极少"
  },
  {
    "start": 251.171,
    "end": 255.705,
    "text": "一些富人常见的面貌渐次显现在他脸上："
  },
  {
    "start": 255.705,
    "end": 260.24,
    "text": "焦躁、涣散、无情、贪而不足、饱食无度"
  },
  {
    "start": 260.24,
    "end": 262.794,
    "text": "富人的灵魂病逐渐侵袭他"
  },
  {
    "start": 263.042,
    "end": 265.2,
    "text": "如面纱 如薄雾"
  },
  {
    "start": 265.2,
    "end": 270.057,
    "text": "倦怠一天天席卷悉达多 每月浑浊一些"
  },
  {
    "start": 270.057,
    "end": 271.676,
    "text": "每年沉重一些"
  },
  {
    "start": 271.676,
    "end": 274.351,
    "text": "像一件新衣随时光变旧"
  },
  {
    "start": 274.351,
    "end": 279.433,
    "text": "失去往日华美的色彩 出现斑驳 褶皱"
  },
  {
    "start": 279.433,
    "end": 281.84,
    "text": "衣边磨碎 四处破损"
  },
  {
    "start": 281.84,
    "end": 282.364,
    "text": "抽丝"
  },
  {
    "start": 282.364,
    "end": 286.818,
    "text": "悉达多离开乔文达后的新生活已经枯萎"
  },
  {
    "start": 286.818,
    "end": 290.224,
    "text": "它随荏苒的光阴失去光泽"
  },
  {
    "start": 290.224,
    "end": 293.801,
    "text": "积聚褶皱和斑点 虽藏于深处"
  },
  {
    "start": 293.801,
    "end": 298.4,
    "text": "却不时显露恶劣 失落和厌恶伺机待发"
  },
  {
    "start": 298.4,
    "end": 300.188,
    "text": "悉达多并未察觉"
  },
  {
    "start": 300.188,
    "end": 304.033,
    "text": "他只意识到内心曾觉醒的清悦笃定之音"
  },
  {
    "start": 304.033,
    "end": 307.652,
    "text": "曾不断指引他的声音 已悄然缄默"
  },
  {
    "start": 307.9,
    "end": 312.019,
    "text": "世俗将他囚禁 情欲、贪欲和惰性"
  },
  {
    "start": 312.019,
    "end": 314.844,
    "text": "以及他最蔑视、时常嘲笑、"
  },
  {
    "start": 314.844,
    "end": 320.023,
    "text": "视为最愚昧的唯利是图俘虏了他他拜倒在钱财下"
  },
  {
    "start": 320.023,
    "end": 323.113,
    "text": "赚钱于他不再是游戏和琐事"
  },
  {
    "start": 323.113,
    "end": 327.748,
    "text": "而是枷锁和负荷 在充满诡诈的歧路上"
  },
  {
    "start": 327.748,
    "end": 330.421,
    "text": "他最终沉迷于卑劣的赌博"
  },
  {
    "start": 330.421,
    "end": 333.337,
    "text": "自沙门时代在他心中终结"
  },
  {
    "start": 333.337,
    "end": 337.148,
    "text": "悉达多便开始了这种赌钱和珠宝的游戏"
  },
  {
    "start": 337.148,
    "end": 337.821,
    "text": "起初"
  },
  {
    "start": 337.821,
    "end": 339.656,
    "text": "他心不在焉、略带"
  },
  {
    "start": 339.656,
    "end": 346.31,
    "text": "戏谑地效仿这世人的风俗如今却难以自拔地沉溺其中 成为嗜好"
  },
  {
    "start": 346.31,
    "end": 348.502,
    "text": "他是个令人生畏的赌徒"
  },
  {
    "start": 348.502,
    "end": 351.572,
    "text": "他放肆地高额下注 让人胆寒"
  },
  {
    "start": 351.572,
    "end": 353.984,
    "text": "他出于心灵的焦灼赌博"
  },
  {
    "start": 353.984,
    "end": 358.758,
    "text": "将粗鄙的钱财挥霍殆尽以获得剧烈的快感"
  },
  {
    "start": 358.758,
    "end": 362.164,
    "text": "再没有其他方式能更清晰、更尖锐"
  },
  {
    "start": 362.164,
    "end": 365.797,
    "text": "地表达他对商人们膜拜的金钱的蔑视"
  },
  {
    "start": 365.797,
    "end": 369.677,
    "text": "他挥金如土无所顾忌 憎恶自己"
  },
  {
    "start": 369.677,
    "end": 374.074,
    "text": "自我嘲弄 赢得千金 再一掷千金"
  },
  {
    "start": 374.074,
    "end": 375.626,
    "text": "他输钱 输首饰"
  },
  {
    "start": 375.626,
    "end": 379.626,
    "text": "输农庄 之后再赢回来 再输掉"
  },
  {
    "start": 379.626,
    "end": 382.625,
    "text": "他爱那种在掷骰子时、豪赌时"
  },
  {
    "start": 382.625,
    "end": 385.371,
    "text": "心惊肉跳令人窒息的恐惧感"
  },
  {
    "start": 385.371,
    "end": 386.744,
    "text": "他爱这种恐惧"
  },
  {
    "start": 386.744,
    "end": 390.634,
    "text": "爱不断翻新、不断升级的强烈刺激"
  },
  {
    "start": 390.634,
    "end": 392.303,
    "text": "只有在这种刺激下"
  },
  {
    "start": 392.303,
    "end": 396.645,
    "text": "他才能在浑噩的、醉生梦死的寡淡生活中"
  },
  {
    "start": 396.645,
    "end": 400.987,
    "text": "感受到一丝类似幸福、波澜和生气的东西"
  },
  {
    "start": 400.987,
    "end": 404.546,
    "text": "大笔输钱后 他又去积累新的财富"
  },
  {
    "start": 404.546,
    "end": 408.327,
    "text": "狂热地做生意 严厉地逼迫借贷人还账"
  },
  {
    "start": 408.327,
    "end": 410.539,
    "text": "只为继续赌博、挥霍"
  },
  {
    "start": 410.539,
    "end": 414.472,
    "text": "继续彰显他对财富的蔑视 输钱时"
  },
  {
    "start": 414.472,
    "end": 416.931,
    "text": "悉达多不再处变不惊"
  },
  {
    "start": 416.931,
    "end": 419.653,
    "text": "他对拖欠还贷的人失去耐性"
  },
  {
    "start": 419.653,
    "end": 423.284,
    "text": "对乞丐不再仁慈 对施舍毫无兴趣"
  },
  {
    "start": 423.284,
    "end": 425.78,
    "text": "也不再借钱给求助的人"
  },
  {
    "start": 425.78,
    "end": 428.714,
    "text": "这个在赌局中狂笑着下注的"
  },
  {
    "start": 428.714,
    "end": 434.584,
    "text": "人在生意场上越发苛刻吝啬甚至他的梦里都充满铜臭"
  },
  {
    "start": 434.584,
    "end": 437.489,
    "text": "每逢他从不堪的迷醉中苏醒"
  },
  {
    "start": 437.489,
    "end": 439.909,
    "text": "在卧室墙上的镜中窥见"
  },
  {
    "start": 439.909,
    "end": 443.298,
    "text": "自己业已衰老、不再俊美的脸"
  },
  {
    "start": 443.298,
    "end": 446.824,
    "text": "羞愧和厌恶就袭上心头 接着"
  },
  {
    "start": 446.824,
    "end": 450.35,
    "text": "他继续逃遁 逃到新的赌局中"
  },
  {
    "start": 450.35,
    "end": 452.617,
    "text": "逃到性和酒的麻醉中"
  },
  {
    "start": 452.617,
    "end": 455.032,
    "text": "之后再回到敛钱的冲动里"
  },
  {
    "start": 455.032,
    "end": 458.324,
    "text": "在这荒诞的轮回中 他疲惫不堪"
  },
  {
    "start": 458.324,
    "end": 459.641,
    "text": "衰老而虚弱"
  },
  {
    "start": 459.889,
    "end": 462.414,
    "text": "那时 他被一个梦唤醒"
  },
  {
    "start": 462.414,
    "end": 466.086,
    "text": "当晚他正同迦摩罗在她的后花园交谈"
  },
  {
    "start": 466.086,
    "end": 467.693,
    "text": "他们坐在树下"
  },
  {
    "start": 467.693,
    "end": 470.468,
    "text": "迦摩罗说了些引人深思的话"
  },
  {
    "start": 470.468,
    "end": 472.087,
    "text": "难掩忧愁和倦烦"
  },
  {
    "start": 472.087,
    "end": 476.712,
    "text": "她请求悉达多一再为她描述乔达摩的样子"
  },
  {
    "start": 476.712,
    "end": 480.574,
    "text": "他的目光如何清澈 嘴唇如何优美"
  },
  {
    "start": 480.574,
    "end": 484.676,
    "text": "微笑如何亲善 步态如何沉静 一再地"
  },
  {
    "start": 484.676,
    "end": 488.668,
    "text": "悉达多讲着佛陀的事 迦摩罗嗟叹着"
  },
  {
    "start": 488.668,
    "end": 491.486,
    "text": "又道： 日后 或许不久"
  },
  {
    "start": 491.486,
    "end": 493.13,
    "text": "我也要追随佛陀"
  },
  {
    "start": 493.13,
    "end": 495.143,
    "text": "我要把我的花园献给他"
  },
  {
    "start": 495.143,
    "end": 496.954,
    "text": "皈依他的教义"
  },
  {
    "start": 497.202,
    "end": 499.899,
    "text": "接着 她却开始挑逗他"
  },
  {
    "start": 499.899,
    "end": 501.859,
    "text": "带着苦情与他做爱"
  },
  {
    "start": 501.859,
    "end": 506.516,
    "text": "她狂热地紧紧拥抱他 流着泪亲他、咬他"
  },
  {
    "start": 506.516,
    "end": 508.721,
    "text": "仿佛要从虚幻短促的"
  },
  {
    "start": 508.721,
    "end": 516.071,
    "text": "快感中榨取最后一滴甘露悉达多从未如此明白 性和死是如此相近"
  },
  {
    "start": 516.071,
    "end": 519.845,
    "text": "之后他躺在她身旁 面对她的脸"
  },
  {
    "start": 519.845,
    "end": 524.375,
    "text": "他在她的眼角、唇边读到从未读到的焦虑"
  },
  {
    "start": 524.375,
    "end": 527.059,
    "text": "这些由细密轻浅的皱纹书写"
  },
  {
    "start": 527.059,
    "end": 532.204,
    "text": "的焦虑让人想到秋日和晚景如同悉达多 步入不惑"
  },
  {
    "start": 532.204,
    "end": 537.264,
    "text": "白发依稀 迦摩罗美丽的脸上写满倦怠"
  },
  {
    "start": 537.264,
    "end": 539.513,
    "text": "她的美已开始枯萎"
  },
  {
    "start": 539.513,
    "end": 542.274,
    "text": "带着隐匿的、未被言说、"
  },
  {
    "start": 542.274,
    "end": 549.052,
    "text": "未被察觉的焦虑：惧怕衰老惧怕凋敝之秋 惧怕必死的命运"
  },
  {
    "start": 549.052,
    "end": 553.361,
    "text": "他叹息着和她道别 灵魂充满幽闭的哀愁"
  },
  {
    "start": 553.609,
    "end": 554.077,
    "text": "夜晚"
  },
  {
    "start": 554.077,
    "end": 557.819,
    "text": "悉达多在自己的宅邸同舞女饮酒作乐"
  },
  {
    "start": 557.819,
    "end": 560.158,
    "text": "他傲睨寻欢的同伴"
  },
  {
    "start": 560.158,
    "end": 562.982,
    "text": "尽管他已毫无自负的资本"
  },
  {
    "start": 562.982,
    "end": 567.348,
    "text": "他喝了许多酒 午夜后才踉跄着就寝"
  },
  {
    "start": 567.348,
    "end": 570.172,
    "text": "他疲惫躁动 几近痛哭"
  },
  {
    "start": 570.172,
    "end": 573.581,
    "text": "几近绝望 他徒劳地试图入睡"
  },
  {
    "start": 573.581,
    "end": 577.476,
    "text": "内心满是无法承受的悲哀 满是厌恶"
  },
  {
    "start": 577.476,
    "end": 580.139,
    "text": "就像厌恶令人作呕的劣酒"
  },
  {
    "start": 580.139,
    "end": 582.56,
    "text": "过分甜腻浅白的音乐"
  },
  {
    "start": 582.56,
    "end": 585.057,
    "text": "厌恶舞女的媚笑和她们"
  },
  {
    "start": 585.057,
    "end": 590.549,
    "text": "过分香艳的头发和胸脯但最让他作呕的是他自己"
  },
  {
    "start": 590.549,
    "end": 594.219,
    "text": "他洒了香水的头发 喷着酒气的嘴"
  },
  {
    "start": 594.219,
    "end": 597.888,
    "text": "松懈倦遢的皮肤 一个酒食过度之人"
  },
  {
    "start": 597.888,
    "end": 602.153,
    "text": "需经受折磨、呕吐 才能感到轻松快慰"
  },
  {
    "start": 602.153,
    "end": 604.285,
    "text": "这个夜不能寐的人正"
  },
  {
    "start": 604.285,
    "end": 607.127,
    "text": "希望自己能从欲呕的狂澜中"
  },
  {
    "start": 607.127,
    "end": 611.572,
    "text": "从享乐中、恶习中 从失控的生活中"
  },
  {
    "start": 611.572,
    "end": 614.972,
    "text": "从自身中解脱出来 东方泛白"
  },
  {
    "start": 614.972,
    "end": 617.057,
    "text": "街上的商铺已准备开张"
  },
  {
    "start": 617.057,
    "end": 620.186,
    "text": "他在困意中昏睡了片刻 这一刻"
  },
  {
    "start": 620.186,
    "end": 621.646,
    "text": "他做了一个梦"
  },
  {
    "start": 621.894,
    "end": 625.941,
    "text": "他梦见迦摩罗养在金笼中罕见的知更鸟"
  },
  {
    "start": 625.941,
    "end": 629.988,
    "text": "这只在清晨啼唱的歌鸟突然默不作声"
  },
  {
    "start": 629.988,
    "end": 633.359,
    "text": "他感到意外 走近鸟笼窥探"
  },
  {
    "start": 633.359,
    "end": 637.509,
    "text": "他看见鸟已死去 僵直地躺在笼中"
  },
  {
    "start": 637.509,
    "end": 638.547,
    "text": "他取出它"
  },
  {
    "start": 638.547,
    "end": 642.652,
    "text": "放在手中瞧着 之后把它扔到巷子里"
  },
  {
    "start": 642.652,
    "end": 646.516,
    "text": "这一刻 他感到异常惊恐又十分心痛"
  },
  {
    "start": 646.516,
    "end": 649.339,
    "text": "仿佛他把一切宝贵美好的东西"
  },
  {
    "start": 649.339,
    "end": 652.38,
    "text": "连同这只死去的鸟一起扔掉了"
  },
  {
    "start": 652.628,
    "end": 656.938,
    "text": "惊醒后 他感到自己被深深的悲哀包围"
  },
  {
    "start": 656.938,
    "end": 657.896,
    "text": "毫无价值"
  },
  {
    "start": 657.896,
    "end": 661.727,
    "text": "自己过着既无价值又无意义的生活"
  },
  {
    "start": 661.727,
    "end": 662.672,
    "text": "了无生气"
  },
  {
    "start": 662.672,
    "end": 668.581,
    "text": "他没有得到任何珍贵的、值得保留的东西他孤单伫立"
  },
  {
    "start": 668.581,
    "end": 671.54,
    "text": "空洞得如同岸边遇难的破船"
  },
  {
    "start": 671.788,
    "end": 675.62,
    "text": "悉达多阴郁地走进花园 锁上园门"
  },
  {
    "start": 675.62,
    "end": 679.452,
    "text": "坐在芒果树下 心中充满死意和恐惧"
  },
  {
    "start": 679.452,
    "end": 681.316,
    "text": "他坐在芒果树下"
  },
  {
    "start": 681.316,
    "end": 688.241,
    "text": "体察死意和恐惧又如何在胸中幻灭、枯萎如何走向终结"
  },
  {
    "start": 688.241,
    "end": 692.458,
    "text": "他缓慢地集中思想 回顾自己的生活"
  },
  {
    "start": 692.458,
    "end": 696.427,
    "text": "从有记忆的日子开始 他何时幸福"
  },
  {
    "start": 696.427,
    "end": 697.915,
    "text": "又何时喜悦过"
  },
  {
    "start": 697.915,
    "end": 701.86,
    "text": "哦 是的 他有过许多幸福和喜悦"
  },
  {
    "start": 701.86,
    "end": 704.644,
    "text": "少年时他就品尝过这些滋味"
  },
  {
    "start": 704.644,
    "end": 706.964,
    "text": "当他赢得婆罗门的夸赞"
  },
  {
    "start": 706.964,
    "end": 711.304,
    "text": "当他超过其他孩子 出色地背诵圣诗"
  },
  {
    "start": 711.304,
    "end": 714.878,
    "text": "与贤士们辩论 参与祭祀 那时"
  },
  {
    "start": 714.878,
    "end": 718.565,
    "text": "他听见内心的声音说： 路在前方"
  },
  {
    "start": 718.565,
    "end": 722.498,
    "text": "走这条路是你的使命 诸神在等你"
  },
  {
    "start": 722.498,
    "end": 723.727,
    "text": "青年时"
  },
  {
    "start": 723.727,
    "end": 726.207,
    "text": "随着思想之目标不断高扬"
  },
  {
    "start": 726.207,
    "end": 729.137,
    "text": "他从志向相当的人中脱颖而出"
  },
  {
    "start": 729.137,
    "end": 732.067,
    "text": "他在痛苦中思索梵天真谛"
  },
  {
    "start": 732.067,
    "end": 735.487,
    "text": "每次获得真知都点燃他新的渴求"
  },
  {
    "start": 735.487,
    "end": 737.685,
    "text": "在渴求间 痛苦中"
  },
  {
    "start": 737.685,
    "end": 741.106,
    "text": "他又听到心中的召唤： 继续"
  },
  {
    "start": 741.106,
    "end": 745.619,
    "text": "继续 这是你的使命  这声音召唤他"
  },
  {
    "start": 745.619,
    "end": 748.707,
    "text": "在他离开家乡 成为沙门时"
  },
  {
    "start": 748.707,
    "end": 749.895,
    "text": "在他离开沙门"
  },
  {
    "start": 749.895,
    "end": 754.103,
    "text": "走向世尊佛陀时 在他离开世尊佛陀"
  },
  {
    "start": 754.103,
    "end": 758.064,
    "text": "踏入无常时 他已多久没听见这声音"
  },
  {
    "start": 758.064,
    "end": 759.848,
    "text": "已有多久毫无精进"
  },
  {
    "start": 759.848,
    "end": 763.639,
    "text": "他走过多少平庸、荒芜的路 多年来"
  },
  {
    "start": 763.639,
    "end": 766.538,
    "text": "他没有崇高目标 没有渴望"
  },
  {
    "start": 766.538,
    "end": 769.278,
    "text": "毫无进取 他贪猥无厌"
  },
  {
    "start": 769.278,
    "end": 772.267,
    "text": "餍足于可怜的嗜好 多年来"
  },
  {
    "start": 772.267,
    "end": 776.321,
    "text": "他一直在浑然不觉中试图且盼望成为世人"
  },
  {
    "start": 776.321,
    "end": 778.348,
    "text": "可他的生活却因为他"
  },
  {
    "start": 778.348,
    "end": 780.826,
    "text": "怀着别样的目标和忧虑"
  },
  {
    "start": 780.826,
    "end": 784.76,
    "text": "远比那些孩童般的世人更加不幸和贫穷"
  },
  {
    "start": 784.76,
    "end": 787.097,
    "text": "由迦摩施瓦弥一类人构成"
  },
  {
    "start": 787.097,
    "end": 792.834,
    "text": "的世界于他不过是一场游戏一支供人观赏的舞蹈 一部闹剧"
  },
  {
    "start": 792.834,
    "end": 795.208,
    "text": "他唯一珍惜的是迦摩罗"
  },
  {
    "start": 795.208,
    "end": 798.057,
    "text": "他珍惜她——但依然珍惜吗"
  },
  {
    "start": 798.057,
    "end": 801.618,
    "text": "他还需要她 或她还需要他吗"
  },
  {
    "start": 801.618,
    "end": 804.995,
    "text": "难道他们不是在无尽的游戏中游戏"
  },
  {
    "start": 804.995,
    "end": 809.047,
    "text": "为这游戏而活可有必要 不 没有必要"
  },
  {
    "start": 809.047,
    "end": 813.244,
    "text": "这游戏叫做轮回 一种孩童游戏"
  },
  {
    "start": 813.244,
    "end": 817.441,
    "text": "一种或许可爱的游戏 一次 两次"
  },
  {
    "start": 817.441,
    "end": 820.671,
    "text": "十次——难道要不停地游戏下去"
  },
  {
    "start": 820.918,
    "end": 824.173,
    "text": "悉达多这时清楚 游戏业已终结"
  },
  {
    "start": 824.173,
    "end": 825.908,
    "text": "他不会再游戏下去"
  },
  {
    "start": 825.908,
    "end": 829.163,
    "text": "一阵颤栗袭击了他的肉体和心灵"
  },
  {
    "start": 829.163,
    "end": 831.497,
    "text": "他感到某些东西已经死去"
  },
  {
    "start": 831.745,
    "end": 833.964,
    "text": "他整日坐在芒果树下"
  },
  {
    "start": 833.964,
    "end": 837.664,
    "text": "想着父亲、乔文达 想着乔达摩"
  },
  {
    "start": 837.664,
    "end": 841.777,
    "text": "难道离开他们是为了成为迦摩施瓦弥"
  },
  {
    "start": 841.777,
    "end": 844.861,
    "text": "黑夜方临 他仍坐在树下"
  },
  {
    "start": 844.861,
    "end": 846.918,
    "text": "举头仰望繁星时"
  },
  {
    "start": 846.918,
    "end": 849.922,
    "text": "他想： 我正坐在我的芒果树下"
  },
  {
    "start": 849.922,
    "end": 850.995,
    "text": "我的花园里"
  },
  {
    "start": 850.995,
    "end": 855.072,
    "text": "他淡然一笑——我竟拥有一棵芒果树"
  },
  {
    "start": 855.072,
    "end": 858.878,
    "text": "一座花园 这是真实的 必要的吗"
  },
  {
    "start": 858.878,
    "end": 861.341,
    "text": "难道这不是一场愚蠢的游戏"
  },
  {
    "start": 861.589,
    "end": 863.391,
    "text": "他与这些做了了断"
  },
  {
    "start": 863.391,
    "end": 865.418,
    "text": "它们已在他心中死去"
  },
  {
    "start": 865.418,
    "end": 869.923,
    "text": "他起身告别芒果树和花园 他已整日未食"
  },
  {
    "start": 869.923,
    "end": 870.856,
    "text": "感到饥饿"
  },
  {
    "start": 870.856,
    "end": 874.589,
    "text": "他想到自己在城中的宅邸、卧室和床"
  },
  {
    "start": 874.589,
    "end": 876.922,
    "text": "想到餐桌上的佳肴"
  },
  {
    "start": 876.922,
    "end": 880.756,
    "text": "疲惫地笑着摇了摇头 他已同它们告别"
  },
  {
    "start": 881.004,
    "end": 884.879,
    "text": "当天深夜 悉达多离开花园和城邑"
  },
  {
    "start": 884.879,
    "end": 888.753,
    "text": "一去不返 迦摩施瓦弥唤人四处寻找"
  },
  {
    "start": 888.753,
    "end": 890.706,
    "text": "以为他落入盗匪之手"
  },
  {
    "start": 890.706,
    "end": 892.441,
    "text": "迦摩罗却没有找他"
  },
  {
    "start": 892.441,
    "end": 895.261,
    "text": "她得知悉达多失踪后并不惊讶"
  },
  {
    "start": 895.261,
    "end": 896.997,
    "text": "她早有所料"
  },
  {
    "start": 896.997,
    "end": 900.743,
    "text": "他本来就是沙门 一个无家可归的人"
  },
  {
    "start": 900.743,
    "end": 903.828,
    "text": "一位求道者 在最后的欢聚中"
  },
  {
    "start": 903.828,
    "end": 905.591,
    "text": "她已更强烈地察觉"
  },
  {
    "start": 905.591,
    "end": 907.806,
    "text": "她在失却的痛苦中欣喜"
  },
  {
    "start": 907.806,
    "end": 910.464,
    "text": "她能最后一次把他紧贴胸口"
  },
  {
    "start": 910.464,
    "end": 912.9,
    "text": "再一次彻底被他征服"
  },
  {
    "start": 913.148,
    "end": 915.033,
    "text": "得知悉达多失踪后"
  },
  {
    "start": 915.033,
    "end": 918.801,
    "text": "她走到窗前的金鸟笼前 打开笼门"
  },
  {
    "start": 918.801,
    "end": 921.392,
    "text": "取出那只珍稀的知更鸟"
  },
  {
    "start": 921.392,
    "end": 925.906,
    "text": "放飞了它 她久久地注视着远去的飞鸟"
  },
  {
    "start": 925.906,
    "end": 930.17,
    "text": "从这天起 她关闭宅邸 不再见客"
  },
  {
    "start": 930.17,
    "end": 930.671,
    "text": "不久后"
  },
  {
    "start": 930.671,
    "end": 934.95,
    "text": "她发现同悉达多最后的交欢令她怀了身孕"
  }
