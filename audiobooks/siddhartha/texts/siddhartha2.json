[
  {
    "start": 0.0,
    "end": 1.744,
    "text": "第二章 沙门"
  },
  {
    "start": 1.992,
    "end": 4.703,
    "text": "当晚 他们追上苦行者"
  },
  {
    "start": 4.703,
    "end": 7.661,
    "text": "向三位枯瘦的沙门请求同行"
  },
  {
    "start": 7.661,
    "end": 10.866,
    "text": "并承诺顺从 他们被接纳了"
  },
  {
    "start": 11.114,
    "end": 17.427,
    "text": "悉达多将长袍送给街上一位贫穷的婆罗门身上只系一条遮羞布"
  },
  {
    "start": 17.427,
    "end": 20.233,
    "text": "披一件未缝的土色斗篷"
  },
  {
    "start": 20.233,
    "end": 23.431,
    "text": "他每日只进食一次 且是生食"
  },
  {
    "start": 23.431,
    "end": 27.087,
    "text": "他斋戒了十五日 他斋戒了二十八日"
  },
  {
    "start": 27.087,
    "end": 30.709,
    "text": "他的身躯和面颊日渐消瘦 因消瘦"
  },
  {
    "start": 30.709,
    "end": 34.106,
    "text": "而变大的双眼中闪烁着热烈的幻梦"
  },
  {
    "start": 34.106,
    "end": 36.711,
    "text": "他枯瘦的手指长出长指甲"
  },
  {
    "start": 36.711,
    "end": 39.317,
    "text": "下巴生出干枯蓬乱的胡须"
  },
  {
    "start": 39.317,
    "end": 42.16,
    "text": "他遇见女人时目光冷淡"
  },
  {
    "start": 42.16,
    "end": 44.642,
    "text": "遇见城中穿着华美之人"
  },
  {
    "start": 44.642,
    "end": 48.613,
    "text": "嘴角流露出轻蔑 他见到商贩经商"
  },
  {
    "start": 48.613,
    "end": 51.839,
    "text": "君侯外出狩猎 服丧者哀嚎"
  },
  {
    "start": 51.839,
    "end": 55.369,
    "text": "娼妓出卖色相 医生救治病人"
  },
  {
    "start": 55.369,
    "end": 59.403,
    "text": "祭司定夺播种之日 情侣们相互爱抚"
  },
  {
    "start": 59.403,
    "end": 62.812,
    "text": "母亲们哺乳——这一切都让他不屑"
  },
  {
    "start": 62.812,
    "end": 65.993,
    "text": "一切都是欺骗 都散发着恶臭"
  },
  {
    "start": 65.993,
    "end": 67.357,
    "text": "谎言的恶臭"
  },
  {
    "start": 67.357,
    "end": 70.957,
    "text": "一切欲望、幸福和优美皆为虚幻"
  },
  {
    "start": 70.957,
    "end": 74.556,
    "text": "一切都在腐朽 世界是苦涩的"
  },
  {
    "start": 74.556,
    "end": 76.356,
    "text": "生活即是折磨"
  },
  {
    "start": 76.604,
    "end": 80.865,
    "text": "悉达多唯一的目标是堕入空无 无渴慕"
  },
  {
    "start": 80.865,
    "end": 84.179,
    "text": "无愿望 无梦想 无喜无悲"
  },
  {
    "start": 84.179,
    "end": 85.363,
    "text": "“我”被去除"
  },
  {
    "start": 85.363,
    "end": 89.209,
    "text": "不复存在 让空洞的心灵觅得安宁"
  },
  {
    "start": 89.209,
    "end": 92.334,
    "text": "在无“我”的深思中听便奇迹"
  },
  {
    "start": 92.334,
    "end": 94.017,
    "text": "这是他的目标"
  },
  {
    "start": 94.265,
    "end": 98.445,
    "text": "当“我”被彻底征服 当“我”消亡"
  },
  {
    "start": 98.445,
    "end": 101.149,
    "text": "当渴求和欲望在心中寂灭"
  },
  {
    "start": 101.149,
    "end": 104.338,
    "text": "那最终的、最深的非“我”存在"
  },
  {
    "start": 104.338,
    "end": 106.843,
    "text": "那个大秘密 必定觉醒"
  },
  {
    "start": 107.091,
    "end": 111.296,
    "text": "缄默地 悉达多站在如火的骄阳下"
  },
  {
    "start": 111.296,
    "end": 114.45,
    "text": "疼痛和焦渴燃烧他 他站着"
  },
  {
    "start": 114.45,
    "end": 116.754,
    "text": "直至不再感到疼痛焦渴"
  },
  {
    "start": 117.002,
    "end": 119.944,
    "text": "雨季时 他缄默立于雨中"
  },
  {
    "start": 119.944,
    "end": 123.375,
    "text": "雨水从发梢滴落到他冻僵的肩头"
  },
  {
    "start": 123.375,
    "end": 126.316,
    "text": "滴落到冻僵的髋部和双腿"
  },
  {
    "start": 126.316,
    "end": 128.378,
    "text": "这位苦行者立于雨中"
  },
  {
    "start": 128.378,
    "end": 131.356,
    "text": "直至肩膀和双腿不再感到寒冷"
  },
  {
    "start": 131.356,
    "end": 134.105,
    "text": "直至它们麻痹 缄默地"
  },
  {
    "start": 134.105,
    "end": 138.52,
    "text": "悉达多蹲在刺藤中 灼痛的皮肤渗出血"
  },
  {
    "start": 138.52,
    "end": 142.2,
    "text": "流出脓 悉达多不为所动 他蹲着"
  },
  {
    "start": 142.2,
    "end": 146.854,
    "text": "直至不再滴血 不再感到如针戳 如火灼"
  },
  {
    "start": 147.102,
    "end": 150.347,
    "text": "悉达多笔直而坐 修习敛息"
  },
  {
    "start": 150.347,
    "end": 154.591,
    "text": "他修习相安于微弱的呼吸中 修习屏气"
  },
  {
    "start": 154.591,
    "end": 156.713,
    "text": "他的修习从呼吸开始"
  },
  {
    "start": 156.713,
    "end": 160.015,
    "text": "继而修习平定心跳 避免心跳"
  },
  {
    "start": 160.015,
    "end": 162.61,
    "text": "直至心跳减缓乃至停止"
  },
  {
    "start": 162.858,
    "end": 164.789,
    "text": "跟随一位沙门长老"
  },
  {
    "start": 164.789,
    "end": 169.133,
    "text": "悉达多遵从沙门戒律 修习克己及禅定"
  },
  {
    "start": 169.133,
    "end": 171.547,
    "text": "一只苍鹭飞越竹林时"
  },
  {
    "start": 171.547,
    "end": 175.842,
    "text": "他将灵魂嵌入苍鹭之躯 他化为苍鹭"
  },
  {
    "start": 175.842,
    "end": 180.391,
    "text": "飞越森林和山峦 吞食鲜肉 忍苍鹭之饥"
  },
  {
    "start": 180.391,
    "end": 183.748,
    "text": "啼苍鹭之哀鸣 死苍鹭之死"
  },
  {
    "start": 183.748,
    "end": 186.846,
    "text": "一匹死去的胡狼横卧沙滩时"
  },
  {
    "start": 186.846,
    "end": 189.945,
    "text": "他的灵魂钻进胡狼的尸身"
  },
  {
    "start": 189.945,
    "end": 194.188,
    "text": "他变成胡狼 尸体膨胀、发臭、腐烂"
  },
  {
    "start": 194.188,
    "end": 197.183,
    "text": "被鬣狗撕碎 被兀鹰啄食"
  },
  {
    "start": 197.183,
    "end": 199.679,
    "text": "成为一具骨架 化为灰"
  },
  {
    "start": 199.679,
    "end": 201.185,
    "text": "飞散在旷野中"
  },
  {
    "start": 201.185,
    "end": 203.945,
    "text": "悉达多的灵魂重新返回时"
  },
  {
    "start": 203.945,
    "end": 207.208,
    "text": "已历经死亡、腐朽和尘化"
  },
  {
    "start": 207.208,
    "end": 211.147,
    "text": "已品尝轮回阴暗的醉意 他好似猎人"
  },
  {
    "start": 211.147,
    "end": 214.622,
    "text": "在新的渴望中瞄准摆脱轮回的出口"
  },
  {
    "start": 214.622,
    "end": 218.985,
    "text": "缘起的终结之处 无忧而永恒的开端"
  },
  {
    "start": 218.985,
    "end": 221.808,
    "text": "他扼杀感官 毁灭记忆"
  },
  {
    "start": 221.808,
    "end": 223.861,
    "text": "他从“我”中溜走"
  },
  {
    "start": 223.861,
    "end": 228.776,
    "text": "融入陌生的万物中 他是动物 是尸身"
  },
  {
    "start": 228.776,
    "end": 232.915,
    "text": "是石 是木 是水 但他总是重新出定"
  },
  {
    "start": 232.915,
    "end": 236.501,
    "text": "在阳光下或月光中重归于“我”"
  },
  {
    "start": 236.501,
    "end": 240.343,
    "text": "在轮回中打转 重新觉察到渴望"
  },
  {
    "start": 240.343,
    "end": 241.879,
    "text": "他压制渴望"
  },
  {
    "start": 241.879,
    "end": 243.728,
    "text": "又收获新的渴望"
  },
  {
    "start": 243.976,
    "end": 246.51,
    "text": "悉达多从沙门处学到很多"
  },
  {
    "start": 246.51,
    "end": 250.425,
    "text": "他学会诸多克己之方法 他通过受苦"
  },
  {
    "start": 250.425,
    "end": 257.83,
    "text": "志愿受苦和战胜疼痛、饥饿、焦渴和疲惫走向克己 他通过禅定"
  },
  {
    "start": 257.83,
    "end": 261.704,
    "text": "通过在一切表象前心神凝定走向克己"
  },
  {
    "start": 261.704,
    "end": 263.883,
    "text": "他学会诸多修炼之道"
  },
  {
    "start": 263.883,
    "end": 266.789,
    "text": "他曾千百次摆脱“我”"
  },
  {
    "start": 266.789,
    "end": 270.001,
    "text": "他曾整时整日停驻在无“我”中"
  },
  {
    "start": 270.001,
    "end": 272.525,
    "text": "这些修行均从“我”出发"
  },
  {
    "start": 272.525,
    "end": 275.508,
    "text": "终点却总是回归于“我”"
  },
  {
    "start": 275.508,
    "end": 278.728,
    "text": "尽管悉达多千百次弃绝“我”"
  },
  {
    "start": 278.728,
    "end": 282.445,
    "text": "逗留在虚无中 化为动物、石头"
  },
  {
    "start": 282.445,
    "end": 284.427,
    "text": "回归却不可避免"
  },
  {
    "start": 284.427,
    "end": 287.103,
    "text": "重归于“我”无法摆脱"
  },
  {
    "start": 287.103,
    "end": 291.652,
    "text": "在阳光中、月华下 在遮荫处和雨中"
  },
  {
    "start": 291.652,
    "end": 294.061,
    "text": "他重新成为“我”"
  },
  {
    "start": 294.061,
    "end": 298.16,
    "text": "成为悉达多 重新忍受轮回赋予的折磨"
  },
  {
    "start": 298.408,
    "end": 302.294,
    "text": "乔文达 他的影子 和他生活在一起"
  },
  {
    "start": 302.294,
    "end": 305.317,
    "text": "也走了同样的路 付出同样的艰辛"
  },
  {
    "start": 305.317,
    "end": 309.052,
    "text": "他们在修习和献祭时鲜有交流 偶尔"
  },
  {
    "start": 309.052,
    "end": 312.786,
    "text": "两人得以同去村落为自己和师父们乞食"
  },
  {
    "start": 313.034,
    "end": 314.962,
    "text": "你怎么看 乔文达"
  },
  {
    "start": 314.962,
    "end": 317.66,
    "text": "在一次乞食途中 悉达多问"
  },
  {
    "start": 317.66,
    "end": 319.588,
    "text": "你认为我们有进步吗"
  },
  {
    "start": 319.588,
    "end": 321.242,
    "text": "我们实现了目标吗"
  },
  {
    "start": 321.49,
    "end": 324.057,
    "text": "乔文达答： 我们学了不少"
  },
  {
    "start": 324.057,
    "end": 327.694,
    "text": "我们依然在学 你将成为伟大的沙门"
  },
  {
    "start": 327.694,
    "end": 328.549,
    "text": "悉达多"
  },
  {
    "start": 328.549,
    "end": 332.239,
    "text": "沙门长老常常赞叹 你学什么都快"
  },
  {
    "start": 332.239,
    "end": 335.468,
    "text": "你将成为圣人 哦 悉达多"
  },
  {
    "start": 335.716,
    "end": 339.652,
    "text": "悉达多道： 我并不这么看 我的朋友"
  },
  {
    "start": 339.652,
    "end": 343.15,
    "text": "至今我在沙门处学到的东西 乔文达"
  },
  {
    "start": 343.15,
    "end": 345.948,
    "text": "我本可以更快更便捷地学到"
  },
  {
    "start": 345.948,
    "end": 349.444,
    "text": "在花街柳巷的酒馆里 我的朋友"
  },
  {
    "start": 349.444,
    "end": 351.309,
    "text": "在脚夫和赌徒处"
  },
  {
    "start": 351.309,
    "end": 352.563,
    "text": "我都能学到"
  },
  {
    "start": 352.811,
    "end": 356.425,
    "text": "乔文达道： 悉达多你是在和我说笑"
  },
  {
    "start": 356.425,
    "end": 360.265,
    "text": "你怎么可能在那些贫乏者中学会禅定"
  },
  {
    "start": 360.265,
    "end": 364.404,
    "text": "学会屏息敛气 学会忍受饥饿和痛苦"
  },
  {
    "start": 364.652,
    "end": 366.024,
    "text": "悉达多轻声道"
  },
  {
    "start": 366.024,
    "end": 368.997,
    "text": "仿佛自言自语： 禅定是什么"
  },
  {
    "start": 368.997,
    "end": 372.427,
    "text": "什么是脱离肉体 斋戒是什么"
  },
  {
    "start": 372.427,
    "end": 376.574,
    "text": "什么是屏息敛气 那不过是逃避‘我’"
  },
  {
    "start": 376.574,
    "end": 379.801,
    "text": "是暂时从‘我’的折磨中逃出来"
  },
  {
    "start": 379.801,
    "end": 383.311,
    "text": "是对生命的虚无和痛苦的暂时麻醉"
  },
  {
    "start": 383.311,
    "end": 384.95,
    "text": "这种逃避、麻醉"
  },
  {
    "start": 384.95,
    "end": 388.695,
    "text": "即便是驱牛者也能在客栈中找到"
  },
  {
    "start": 388.695,
    "end": 390.953,
    "text": "他只消喝上几杯米酒或"
  },
  {
    "start": 390.953,
    "end": 396.374,
    "text": "发酵的椰子奶就能忘掉自己他将感受不到生活的痛苦"
  },
  {
    "start": 396.374,
    "end": 400.518,
    "text": "他被暂时麻醉 在米酒的杯盏间昏沉入睡"
  },
  {
    "start": 400.518,
    "end": 404.338,
    "text": "他同样能获得悉达多和乔文达通过长久"
  },
  {
    "start": 404.338,
    "end": 406.81,
    "text": "修习才获得的弃绝肉体与"
  },
  {
    "start": 406.81,
    "end": 409.282,
    "text": "停留在无‘我’中的感受"
  },
  {
    "start": 409.282,
    "end": 411.431,
    "text": "就是这样 乔文达"
  },
  {
    "start": 411.679,
    "end": 415.397,
    "text": "乔文达道： 你这样说 哦 朋友"
  },
  {
    "start": 415.397,
    "end": 418.896,
    "text": "你当然知道 悉达多不是驱牛车夫"
  },
  {
    "start": 418.896,
    "end": 420.208,
    "text": "沙门也不是酒鬼"
  },
  {
    "start": 420.208,
    "end": 421.97,
    "text": "酗酒者可以被麻醉"
  },
  {
    "start": 421.97,
    "end": 425.052,
    "text": "他可以获得短暂的逃避和休憩"
  },
  {
    "start": 425.052,
    "end": 429.009,
    "text": "但当他从幻觉中醒来时会发现一切依旧"
  },
  {
    "start": 429.009,
    "end": 432.501,
    "text": "他没有成为智者 没有积累知识"
  },
  {
    "start": 432.501,
    "end": 434.61,
    "text": "也没有进入更高的境界"
  },
  {
    "start": 434.858,
    "end": 437.598,
    "text": "悉达多含笑道： 我不知道"
  },
  {
    "start": 437.598,
    "end": 441.022,
    "text": "我从不是酒鬼 但是我 悉达多"
  },
  {
    "start": 441.022,
    "end": 444.691,
    "text": "在修习和禅定中只收获短暂的麻醉"
  },
  {
    "start": 444.691,
    "end": 447.871,
    "text": "我仍似一个在子宫内的婴孩"
  },
  {
    "start": 447.871,
    "end": 452.127,
    "text": "距离开悟、解脱十分遥远 这我知道"
  },
  {
    "start": 452.127,
    "end": 454.63,
    "text": "乔文达 这我知道"
  },
  {
    "start": 454.878,
    "end": 459.083,
    "text": "另一次 悉达多和乔文达一同走出森林"
  },
  {
    "start": 459.083,
    "end": 461.652,
    "text": "去村落为兄长和师父乞食"
  },
  {
    "start": 461.652,
    "end": 464.765,
    "text": "悉达多开口道： 那么 乔文达"
  },
  {
    "start": 464.765,
    "end": 468.292,
    "text": "我们走对了路吗 我们离知识近了吗"
  },
  {
    "start": 468.292,
    "end": 469.537,
    "text": "离解脱近了吗"
  },
  {
    "start": 469.537,
    "end": 472.019,
    "text": "抑或我们不过是在原地打转——"
  },
  {
    "start": 472.019,
    "end": 474.501,
    "text": "我们原本不是要摆脱轮回吗"
  },
  {
    "start": 474.749,
    "end": 478.363,
    "text": "乔文达道： 我们学了很多 悉达多"
  },
  {
    "start": 478.363,
    "end": 481.34,
    "text": "许多还需修习 我们没有打转"
  },
  {
    "start": 481.34,
    "end": 482.403,
    "text": "我们在攀登"
  },
  {
    "start": 482.403,
    "end": 483.64,
    "text": "打转如同陀螺"
  },
  {
    "start": 483.64,
    "end": 486.322,
    "text": "我们却已升了几级台阶"
  },
  {
    "start": 486.57,
    "end": 489.656,
    "text": "悉达多问： 你认为我们景仰的师父"
  },
  {
    "start": 489.656,
    "end": 492.164,
    "text": "那位沙门长老多大年纪"
  },
  {
    "start": 492.412,
    "end": 494.921,
    "text": "乔文达答：“我猜他六十岁 ”"
  },
  {
    "start": 495.169,
    "end": 497.666,
    "text": "悉达多道： 他已六十岁"
  },
  {
    "start": 497.666,
    "end": 501.071,
    "text": "依然没有证悟涅槃 他将七十岁"
  },
  {
    "start": 501.071,
    "end": 502.888,
    "text": "八十岁 你和我"
  },
  {
    "start": 502.888,
    "end": 504.862,
    "text": "我们也同样会变老"
  },
  {
    "start": 504.862,
    "end": 507.824,
    "text": "也将继续修习、斋戒、冥想"
  },
  {
    "start": 507.824,
    "end": 511.527,
    "text": "但我们不会证悟涅槃 他不会"
  },
  {
    "start": 511.527,
    "end": 515.737,
    "text": "我们也不会 哦 乔文达 我想"
  },
  {
    "start": 515.737,
    "end": 518.957,
    "text": "可能所有沙门都无法证悟涅槃"
  },
  {
    "start": 518.957,
    "end": 521.186,
    "text": "我们只寻得安慰、麻醉"
  },
  {
    "start": 521.186,
    "end": 523.762,
    "text": "我们只学了些迷惑自己的把戏"
  },
  {
    "start": 523.762,
    "end": 527.13,
    "text": "我们根本没有找到那条道中之道"
  },
  {
    "start": 527.378,
    "end": 529.822,
    "text": "“别这么说 ”乔文达道"
  },
  {
    "start": 529.822,
    "end": 532.266,
    "text": "不要耸人听闻 悉达多"
  },
  {
    "start": 532.266,
    "end": 535.117,
    "text": "这众多热忱、勤奋、圣洁的智者"
  },
  {
    "start": 535.117,
    "end": 538.206,
    "text": "婆罗门 众多严谨可敬的沙门"
  },
  {
    "start": 538.206,
    "end": 539.751,
    "text": "众多孜孜以求者"
  },
  {
    "start": 539.751,
    "end": 543.061,
    "text": "难道都寻不到那道中之道吗"
  },
  {
    "start": 543.309,
    "end": 546.455,
    "text": "悉达多的声音饱含悲痛和嘲讽"
  },
  {
    "start": 546.455,
    "end": 550.328,
    "text": "他饱含悲痛和嘲讽地轻声道： 不久"
  },
  {
    "start": 550.328,
    "end": 551.538,
    "text": "乔文达"
  },
  {
    "start": 551.538,
    "end": 554.018,
    "text": "你的朋友将离开这条与"
  },
  {
    "start": 554.018,
    "end": 560.962,
    "text": "你并肩走过的沙门之路我忍受焦渴 哦 乔文达 在这条路上"
  },
  {
    "start": 560.962,
    "end": 563.972,
    "text": "我的焦渴没有获得丝毫缓解"
  },
  {
    "start": 563.972,
    "end": 568.736,
    "text": "我一直渴慕知识 充满疑惑 年复一年"
  },
  {
    "start": 568.736,
    "end": 570.241,
    "text": "我求教婆罗门"
  },
  {
    "start": 570.241,
    "end": 573.39,
    "text": "求教神圣的吠陀 年复一年"
  },
  {
    "start": 573.39,
    "end": 577.751,
    "text": "我求教虔诚的沙门 年复一年 或许"
  },
  {
    "start": 577.751,
    "end": 578.235,
    "text": "乔文达"
  },
  {
    "start": 578.235,
    "end": 582.186,
    "text": "或许我去求教犀鸟或黑猩猩也同样受益"
  },
  {
    "start": 582.186,
    "end": 584.975,
    "text": "同样获得才智 同样奏效"
  },
  {
    "start": 584.975,
    "end": 587.299,
    "text": "长久以来我耗费时间"
  },
  {
    "start": 587.299,
    "end": 591.673,
    "text": "现在仍未停止耗费 只为了获悉 哦"
  },
  {
    "start": 591.673,
    "end": 595.318,
    "text": "乔文达 人无法学会任何东西 我想"
  },
  {
    "start": 595.318,
    "end": 597.19,
    "text": "万物中根本没有我们"
  },
  {
    "start": 597.19,
    "end": 602.388,
    "text": "称之为‘修习’的东西哦 我的朋友 只有一种知识"
  },
  {
    "start": 602.388,
    "end": 603.428,
    "text": "它无处不在"
  },
  {
    "start": 603.428,
    "end": 607.464,
    "text": "它就是阿特曼 它存在于‘我’中"
  },
  {
    "start": 607.464,
    "end": 610.997,
    "text": "存在于‘你’中 存在于一切中"
  },
  {
    "start": 610.997,
    "end": 613.731,
    "text": "因此我开始相信：这种知识最"
  },
  {
    "start": 613.731,
    "end": 617.096,
    "text": "恼人的敌人莫过于求知欲和修习"
  },
  {
    "start": 617.344,
    "end": 620.871,
    "text": "乔文达停步 举起双手道： 悉达多"
  },
  {
    "start": 620.871,
    "end": 623.983,
    "text": "不要说这些话吓唬你的朋友 的确"
  },
  {
    "start": 623.983,
    "end": 626.709,
    "text": "你的言论让我恐惧 想想看"
  },
  {
    "start": 626.709,
    "end": 630.274,
    "text": "如果如你所云 根本不存在‘修习’"
  },
  {
    "start": 630.274,
    "end": 631.532,
    "text": "那祈祷的神圣"
  },
  {
    "start": 631.532,
    "end": 633.601,
    "text": "婆罗门种姓的荣耀和"
  },
  {
    "start": 633.601,
    "end": 637.511,
    "text": "沙门的虔敬将被置于何地哦 悉达多"
  },
  {
    "start": 637.511,
    "end": 640.054,
    "text": "这世间一切圣洁宝贵和令人"
  },
  {
    "start": 640.054,
    "end": 643.02,
    "text": "崇敬的东西又都成了什么哪"
  },
  {
    "start": 643.268,
    "end": 647.607,
    "text": "说罢 乔文达喃喃诵念奥义书中的诗行"
  },
  {
    "start": 647.855,
    "end": 650.944,
    "text": "以深思之精神 纯粹之精神"
  },
  {
    "start": 651.192,
    "end": 653.236,
    "text": "沉浸于阿特曼中之人"
  },
  {
    "start": 653.484,
    "end": 655.988,
    "text": "胸中之极乐难以言表"
  },
  {
    "start": 656.236,
    "end": 657.717,
    "text": "悉达多沉默不语"
  },
  {
    "start": 657.717,
    "end": 660.045,
    "text": "他久久思索着乔文达的话"
  },
  {
    "start": 660.045,
    "end": 662.585,
    "text": "一字一句地思索他的话"
  },
  {
    "start": 662.833,
    "end": 666.609,
    "text": "悉达多垂首伫立 是的 他想"
  },
  {
    "start": 666.609,
    "end": 670.133,
    "text": "还剩下什么 什么能彰显神圣"
  },
  {
    "start": 670.133,
    "end": 671.392,
    "text": "什么能留下来"
  },
  {
    "start": 671.392,
    "end": 674.526,
    "text": "什么能经受考验 他摇了摇头"
  },
  {
    "start": 674.774,
    "end": 675.249,
    "text": "彼时"
  },
  {
    "start": 675.249,
    "end": 677.386,
    "text": "两位青年已于沙门处"
  },
  {
    "start": 677.386,
    "end": 682.848,
    "text": "生活并苦修了几近三年他们从多方获悉一则传闻"
  },
  {
    "start": 682.848,
    "end": 686.708,
    "text": "一则流言：一个叫乔达摩的人现世了"
  },
  {
    "start": 686.708,
    "end": 690.568,
    "text": "他是世尊佛陀 他已战胜尘世疾苦"
  },
  {
    "start": 690.568,
    "end": 692.257,
    "text": "止息转生之轮"
  },
  {
    "start": 692.257,
    "end": 696.272,
    "text": "他传经授业 弟子众多 他云游四海"
  },
  {
    "start": 696.272,
    "end": 698.056,
    "text": "没有财产 没有家室"
  },
  {
    "start": 698.056,
    "end": 702.261,
    "text": "他是一位明贤智慧、身披僧衣的苦行者"
  },
  {
    "start": 702.261,
    "end": 703.745,
    "text": "一位得道之人"
  },
  {
    "start": 703.745,
    "end": 707.455,
    "text": "婆罗门和君侯们都顶礼膜拜他"
  },
  {
    "start": 707.455,
    "end": 709.309,
    "text": "皈依为他的弟子"
  },
  {
    "start": 709.557,
    "end": 711.81,
    "text": "传闻和流言沸沸扬扬"
  },
  {
    "start": 711.81,
    "end": 715.815,
    "text": "城中婆罗门、林中沙门无不谈论此事"
  },
  {
    "start": 715.815,
    "end": 717.066,
    "text": "乔达摩"
  },
  {
    "start": 717.066,
    "end": 720.677,
    "text": "佛陀的名字不断回响在青年耳畔"
  },
  {
    "start": 720.677,
    "end": 724.545,
    "text": "有善言有恶语 有赞誉也有诽谤"
  },
  {
    "start": 724.793,
    "end": 728.93,
    "text": "正如瘟疫肆虐时必定传言四起：有个人"
  },
  {
    "start": 728.93,
    "end": 730.633,
    "text": "一位圣贤、先知"
  },
  {
    "start": 730.633,
    "end": 734.282,
    "text": "他的言辞和气息就能治愈病患"
  },
  {
    "start": 734.282,
    "end": 738.831,
    "text": "传言传遍全国 人人谈论 有人深信"
  },
  {
    "start": 738.831,
    "end": 739.841,
    "text": "有人怀疑"
  },
  {
    "start": 739.841,
    "end": 743.631,
    "text": "而有人已去追随圣贤和救星的足迹"
  },
  {
    "start": 743.631,
    "end": 745.394,
    "text": "乔达摩 佛陀"
  },
  {
    "start": 745.394,
    "end": 749.423,
    "text": "释迦宗族智者的传说就这样传遍全国"
  },
  {
    "start": 749.423,
    "end": 753.201,
    "text": "信众说：他智慧绝伦 记得前世"
  },
  {
    "start": 753.201,
    "end": 756.89,
    "text": "他证悟了涅槃 摆脱了轮回之苦"
  },
  {
    "start": 756.89,
    "end": 760.58,
    "text": "无需再浸没于万物浊流 传说精彩"
  },
  {
    "start": 760.58,
    "end": 764.264,
    "text": "闻所未闻：他行神迹 降妖孽"
  },
  {
    "start": 764.264,
    "end": 765.844,
    "text": "他和诸神交谈"
  },
  {
    "start": 765.844,
    "end": 769.3,
    "text": "而他的敌对者和怀疑者则说：这位"
  },
  {
    "start": 769.3,
    "end": 774.138,
    "text": "乔达摩不过是位自命不凡的骗术士他奢靡度日"
  },
  {
    "start": 774.138,
    "end": 776.71,
    "text": "蔑视献祭 不学无术"
  },
  {
    "start": 776.71,
    "end": 780.312,
    "text": "他绝非潜心修行、清心寡欲之人"
  },
  {
    "start": 780.56,
    "end": 784.293,
    "text": "关于佛陀的传说华美而散发魔力"
  },
  {
    "start": 784.293,
    "end": 789.359,
    "text": "世界病入膏肓 生命不堪重负——可是看"
  },
  {
    "start": 789.359,
    "end": 793.691,
    "text": "这里涌出一眼清泉 此处回响天人召唤"
  },
  {
    "start": 793.691,
    "end": 797.783,
    "text": "满是抚慰 令人振奋 满是高贵的承诺"
  },
  {
    "start": 797.783,
    "end": 800.495,
    "text": "有关佛陀的传说无所不在"
  },
  {
    "start": 800.495,
    "end": 804.439,
    "text": "国中青年热衷此事 他们充满渴望"
  },
  {
    "start": 804.439,
    "end": 805.672,
    "text": "怀抱期盼"
  },
  {
    "start": 805.672,
    "end": 808.334,
    "text": "朝圣者和外乡人也在城邑和"
  },
  {
    "start": 808.334,
    "end": 810.996,
    "text": "村落受到婆罗门后裔的款待"
  },
  {
    "start": 810.996,
    "end": 813.86,
    "text": "只要他们带来世尊释迦摩尼的消息"
  },
  {
    "start": 814.108,
    "end": 816.566,
    "text": "传闻也传入林中沙门耳中"
  },
  {
    "start": 816.566,
    "end": 819.024,
    "text": "传入悉达多和乔文达耳中"
  },
  {
    "start": 819.024,
    "end": 822.152,
    "text": "传闻像零星小雨 缓慢滴落"
  },
  {
    "start": 822.152,
    "end": 824.614,
    "text": "每滴都带着巨大的希望"
  },
  {
    "start": 824.614,
    "end": 826.829,
    "text": "每滴都令人难以置信"
  },
  {
    "start": 826.829,
    "end": 829.536,
    "text": "沙门们很少谈及此事"
  },
  {
    "start": 829.536,
    "end": 832.489,
    "text": "因为沙门长老对此人全无好感"
  },
  {
    "start": 832.489,
    "end": 835.896,
    "text": "他听说这位所谓佛陀曾是一名沙门"
  },
  {
    "start": 835.896,
    "end": 837.485,
    "text": "生活在林中"
  },
  {
    "start": 837.485,
    "end": 845.649,
    "text": "之后又回到奢靡无度和寻欢作乐的尘俗中为此他根本不把这位乔达摩放在眼里"
  },
  {
    "start": 845.897,
    "end": 848.092,
    "text": "“哦 悉达多 ”一日"
  },
  {
    "start": 848.092,
    "end": 851.201,
    "text": "乔文达对他的朋友说  今天我去村落"
  },
  {
    "start": 851.201,
    "end": 853.77,
    "text": "一位婆罗门邀我去他的宅邸"
  },
  {
    "start": 853.77,
    "end": 856.338,
    "text": "在他的宅邸里我遇见一位刚"
  },
  {
    "start": 856.338,
    "end": 859.12,
    "text": "从摩揭陀回来的婆罗门后裔"
  },
  {
    "start": 859.12,
    "end": 863.375,
    "text": "此人亲眼见过佛陀 亲耳听过佛陀宣法"
  },
  {
    "start": 863.375,
    "end": 866.92,
    "text": "真的 我胸中的痛苦让我不得透气"
  },
  {
    "start": 866.92,
    "end": 870.864,
    "text": "我暗自想：难道我 难道我们俩"
  },
  {
    "start": 870.864,
    "end": 872.179,
    "text": "悉达多和我"
  },
  {
    "start": 872.179,
    "end": 875.216,
    "text": "不该去亲身经历、亲耳听闻"
  },
  {
    "start": 875.216,
    "end": 880.278,
    "text": "这位修得圆满的世尊宣法吗你说 我的朋友"
  },
  {
    "start": 880.278,
    "end": 882.025,
    "text": "难道我们不该去亲耳"
  },
  {
    "start": 882.025,
    "end": 883.967,
    "text": "聆听佛陀的法义吗"
  },
  {
    "start": 884.215,
    "end": 887.591,
    "text": "悉达多道： 一直以来 乔文达"
  },
  {
    "start": 887.591,
    "end": 890.968,
    "text": "我都认为 乔文达会留在沙门中"
  },
  {
    "start": 890.968,
    "end": 892.094,
    "text": "我一直相信"
  },
  {
    "start": 892.094,
    "end": 895.084,
    "text": "他的目标是活到六十岁、七十岁"
  },
  {
    "start": 895.084,
    "end": 897.006,
    "text": "不断从事那些沙门们"
  },
  {
    "start": 897.006,
    "end": 899.783,
    "text": "用来装点门面的修习和技艺"
  },
  {
    "start": 899.783,
    "end": 902.927,
    "text": "可是你看 我对乔文达了解甚少"
  },
  {
    "start": 902.927,
    "end": 906.49,
    "text": "我对他的心思还没看透 原来你也想"
  },
  {
    "start": 906.49,
    "end": 907.957,
    "text": "我最忠诚的朋友"
  },
  {
    "start": 907.957,
    "end": 911.291,
    "text": "走一条新路 去聆听佛陀宣法"
  },
  {
    "start": 911.539,
    "end": 914.315,
    "text": "乔文达道： 你依旧喜欢嘲讽"
  },
  {
    "start": 914.315,
    "end": 916.663,
    "text": "你尽管嘲讽我 悉达多"
  },
  {
    "start": 916.663,
    "end": 919.396,
    "text": "难道你心中没有萌生去聆听"
  },
  {
    "start": 919.396,
    "end": 924.407,
    "text": "这位觉者宣法的渴望和欲念吗你不是曾和我说过"
  },
  {
    "start": 924.407,
    "end": 926.866,
    "text": "你不会在沙门之路上久留吗"
  },
  {
    "start": 927.114,
    "end": 929.977,
    "text": "悉达多以他特有的方式笑了"
  },
  {
    "start": 929.977,
    "end": 934.033,
    "text": "他的笑声里一半是悲痛 一半是嘲讽"
  },
  {
    "start": 934.033,
    "end": 935.703,
    "text": "他道： 很好"
  },
  {
    "start": 935.703,
    "end": 939.472,
    "text": "乔文达 你说得很好 你记得也没错"
  },
  {
    "start": 939.472,
    "end": 943.197,
    "text": "但愿你还记得从我这里听到的其他话"
  },
  {
    "start": 943.197,
    "end": 946.922,
    "text": "：我已对法义和修习感到怀疑和厌倦"
  },
  {
    "start": 946.922,
    "end": 950.513,
    "text": "我不再信仰圣贤的言辞 但是好吧"
  },
  {
    "start": 950.513,
    "end": 951.186,
    "text": "亲爱的"
  },
  {
    "start": 951.186,
    "end": 955.451,
    "text": "我打算去聆听那人的法义——尽管我坚信"
  },
  {
    "start": 955.451,
    "end": 959.015,
    "text": "我们已品尝过这法义中最好的果实"
  },
  {
    "start": 959.263,
    "end": 962.423,
    "text": "乔文达道： 你的决定让我欢喜"
  },
  {
    "start": 962.423,
    "end": 964.907,
    "text": "但是你说 这怎么可能"
  },
  {
    "start": 964.907,
    "end": 967.654,
    "text": "我们怎么可能还没聆听乔达摩宣法"
  },
  {
    "start": 967.654,
    "end": 970.036,
    "text": "就品尝了它最好的果实"
  },
  {
    "start": 970.284,
    "end": 973.495,
    "text": "悉达多道： 让我们享用这果实"
  },
  {
    "start": 973.495,
    "end": 976.248,
    "text": "并继续期待 哦 乔文达"
  },
  {
    "start": 976.248,
    "end": 980.016,
    "text": "无论他是否还有其他更好的赐予我们"
  },
  {
    "start": 980.016,
    "end": 984.492,
    "text": "现在 我们就该因着这果实而感谢乔达摩"
  },
  {
    "start": 984.492,
    "end": 988.173,
    "text": "是他召唤我们离开沙门 哦 朋友"
  },
  {
    "start": 988.173,
    "end": 989.906,
    "text": "我们静心期待吧"
  },
  {
    "start": 990.154,
    "end": 993.541,
    "text": "当天 悉达多便告知沙门长老"
  },
  {
    "start": 993.541,
    "end": 994.993,
    "text": "他们决定离开"
  },
  {
    "start": 994.993,
    "end": 999.348,
    "text": "他的礼貌和谦逊符合后辈和弟子的规矩"
  },
  {
    "start": 999.348,
    "end": 1001.446,
    "text": "可沙门长老却因为两位"
  },
  {
    "start": 1001.446,
    "end": 1006.272,
    "text": "青年要离开而大发雷霆他高声叫嚷 甚至破口大骂"
  },
  {
    "start": 1006.52,
    "end": 1009.779,
    "text": "乔文达惊恐异常 陷入窘境"
  },
  {
    "start": 1009.779,
    "end": 1013.549,
    "text": "悉达多却凑到乔文达耳边低语道： 现在"
  },
  {
    "start": 1013.549,
    "end": 1015.644,
    "text": "我要向沙门长老展示我"
  },
  {
    "start": 1015.644,
    "end": 1017.948,
    "text": "在他那里学到的绝技"
  },
  {
    "start": 1018.196,
    "end": 1021.065,
    "text": "他一边凑到沙门长老跟前站定"
  },
  {
    "start": 1021.065,
    "end": 1021.948,
    "text": "屏气凝神"
  },
  {
    "start": 1021.948,
    "end": 1025.48,
    "text": "一边目不转睛地注视长老的双眼"
  },
  {
    "start": 1025.48,
    "end": 1029.101,
    "text": "他要施以法术 让他无法发声"
  },
  {
    "start": 1029.101,
    "end": 1032.98,
    "text": "丧失意志 屈服于他并听命于他"
  },
  {
    "start": 1032.98,
    "end": 1035.049,
    "text": "老沙门真的沉默了"
  },
  {
    "start": 1035.049,
    "end": 1038.974,
    "text": "他呆若木鸡 意志瘫痪 双臂下垂"
  },
  {
    "start": 1038.974,
    "end": 1041.513,
    "text": "在悉达多的法术下无能为力"
  },
  {
    "start": 1041.513,
    "end": 1044.796,
    "text": "悉达多的思想强占了老沙门的思想"
  },
  {
    "start": 1044.796,
    "end": 1047.423,
    "text": "他不得不执行悉达多的指令"
  },
  {
    "start": 1047.423,
    "end": 1049.392,
    "text": "但见他频频鞠躬"
  },
  {
    "start": 1049.392,
    "end": 1053.841,
    "text": "以祈神的姿态结巴着祝福他们旅途平安"
  },
  {
    "start": 1053.841,
    "end": 1057.766,
    "text": "两位青年也鞠躬致谢 回以祝福"
  },
  {
    "start": 1057.766,
    "end": 1059.336,
    "text": "启程离去了"
  },
  {
    "start": 1059.584,
    "end": 1062.786,
    "text": "途中 乔文达道： 哦 悉达多"
  },
  {
    "start": 1062.786,
    "end": 1064.587,
    "text": "你在沙门那里学到的"
  },
  {
    "start": 1064.587,
    "end": 1066.388,
    "text": "东西比我知道的还要多"
  },
  {
    "start": 1066.388,
    "end": 1069.688,
    "text": "向一位沙门长老施展法术并非易事"
  },
  {
    "start": 1069.688,
    "end": 1071.888,
    "text": "可以说非常难 真的"
  },
  {
    "start": 1071.888,
    "end": 1074.307,
    "text": "如果你再留在那里一阵"
  },
  {
    "start": 1074.307,
    "end": 1076.942,
    "text": "你很快就能学会在水面行走"
  },
  {
    "start": 1077.19,
    "end": 1079.874,
    "text": "在水面行走并不是我的追求"
  },
  {
    "start": 1079.874,
    "end": 1081.114,
    "text": "悉达多道"
  },
  {
    "start": 1081.114,
    "end": 1083.046,
    "text": "还是让那些沙门老朽为"
  },
  {
    "start": 1083.046,
    "end": 1084.978,
    "text": "这些把戏沾沾自喜吧"
  }
]