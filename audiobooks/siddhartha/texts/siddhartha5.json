[
  {
    "start": 0.0,
    "end": 2.729,
    "text": "第二部 第五章 迦摩罗"
  },
  {
    "start": 3.224,
    "end": 6.921,
    "text": "在路上 悉达多步步收获新知"
  },
  {
    "start": 6.921,
    "end": 10.619,
    "text": "世界已然变化 他的心为之陶醉"
  },
  {
    "start": 10.619,
    "end": 14.088,
    "text": "他看见太阳从密林覆盖的山峦间升起"
  },
  {
    "start": 14.088,
    "end": 16.473,
    "text": "又从远处的棕榈滩落下"
  },
  {
    "start": 16.473,
    "end": 19.361,
    "text": "他看见星罗棋布的幽蓝夜空中"
  },
  {
    "start": 19.361,
    "end": 22.027,
    "text": "畅游着一弯小船般的新月"
  },
  {
    "start": 22.027,
    "end": 26.543,
    "text": "他看见森林、群星、动物、云朵、"
  },
  {
    "start": 26.543,
    "end": 31.661,
    "text": "彩虹、岩石、野草、花团、小溪与河流"
  },
  {
    "start": 31.661,
    "end": 34.623,
    "text": "清晨的灌木丛中闪耀的露珠"
  },
  {
    "start": 34.623,
    "end": 38.325,
    "text": "远山微蓝苍白 鸟儿和蜜蜂歌唱"
  },
  {
    "start": 38.325,
    "end": 41.04,
    "text": "微风吹过麦田窸窸窣窣"
  },
  {
    "start": 41.04,
    "end": 45.468,
    "text": "这千姿百态姹紫嫣红的一切历来如此"
  },
  {
    "start": 45.468,
    "end": 49.897,
    "text": "日月相推 河流奔涌 蜜蜂嗡嗡"
  },
  {
    "start": 49.897,
    "end": 51.004,
    "text": "亘古不变"
  },
  {
    "start": 51.004,
    "end": 53.301,
    "text": "但在从前的悉达多眼中"
  },
  {
    "start": 53.301,
    "end": 56.975,
    "text": "它们不过是魅惑的、稍纵即逝的雾霭"
  },
  {
    "start": 56.975,
    "end": 58.583,
    "text": "以怀疑熟视"
  },
  {
    "start": 58.583,
    "end": 62.398,
    "text": "这一切注定被思想洞悉 一无是处"
  },
  {
    "start": 62.398,
    "end": 64.306,
    "text": "因为它们并非本质"
  },
  {
    "start": 64.306,
    "end": 67.167,
    "text": "本质位于可见世界的彼岸"
  },
  {
    "start": 67.167,
    "end": 71.72,
    "text": "可现在 他获得自由的双眼流连于尘世"
  },
  {
    "start": 71.72,
    "end": 75.008,
    "text": "他看见且清晰地辨明可见世界"
  },
  {
    "start": 75.008,
    "end": 77.031,
    "text": "他不再问询本质"
  },
  {
    "start": 77.031,
    "end": 80.521,
    "text": "瞄准彼岸 他在世间寻找故乡"
  },
  {
    "start": 80.521,
    "end": 82.515,
    "text": "如若人能毫无希求"
  },
  {
    "start": 82.515,
    "end": 85.755,
    "text": "质朴而天真无邪地看待世界"
  },
  {
    "start": 85.755,
    "end": 89.531,
    "text": "世界何其隽美 月亮和星辰美"
  },
  {
    "start": 89.531,
    "end": 91.149,
    "text": "小溪与河岸美"
  },
  {
    "start": 91.149,
    "end": 94.654,
    "text": "森林、岩石、山羊和金龟子"
  },
  {
    "start": 94.654,
    "end": 99.017,
    "text": "花朵和蝴蝶都很美 当人单纯、觉醒"
  },
  {
    "start": 99.017,
    "end": 101.582,
    "text": "不疑专注地穿行于人间"
  },
  {
    "start": 101.582,
    "end": 104.148,
    "text": "世界何其隽美又妩媚"
  },
  {
    "start": 104.148,
    "end": 106.848,
    "text": "别样的烈日在头顶燃烧"
  },
  {
    "start": 106.848,
    "end": 111.168,
    "text": "浓荫下别样凉爽宜人 小溪和雨水"
  },
  {
    "start": 111.168,
    "end": 114.408,
    "text": "南瓜和香蕉别样甘甜味美"
  },
  {
    "start": 114.408,
    "end": 117.059,
    "text": "白日很短 黑夜很短"
  },
  {
    "start": 117.059,
    "end": 119.445,
    "text": "时辰飞逝如海面之帆"
  },
  {
    "start": 119.445,
    "end": 122.097,
    "text": "帆船满载珍宝和欢悦"
  },
  {
    "start": 122.097,
    "end": 126.141,
    "text": "悉达多看见一只猿猴跳跃在森林之穹窿"
  },
  {
    "start": 126.141,
    "end": 130.186,
    "text": "枝丫之高端 发出粗野而贪婪的啼声"
  },
  {
    "start": 130.186,
    "end": 138.1,
    "text": "悉达多看见一只公羊追逐母羊并与其交欢他看见一条梭鱼在芦苇湖中捕猎晚餐"
  },
  {
    "start": 138.1,
    "end": 140.304,
    "text": "小鱼们吓得心惊肉跳"
  },
  {
    "start": 140.304,
    "end": 143.979,
    "text": "颤栗着如同闪电般成群跃出水面"
  },
  {
    "start": 143.979,
    "end": 146.272,
    "text": "而急迫又迅猛的猎手则"
  },
  {
    "start": 146.272,
    "end": 149.023,
    "text": "狂热有力地搅动翻滚的漩涡"
  },
  {
    "start": 149.271,
    "end": 151.682,
    "text": "所有这自古有之的一切"
  },
  {
    "start": 151.682,
    "end": 155.539,
    "text": "悉达多一直熟视无睹 他从不在场"
  },
  {
    "start": 155.539,
    "end": 157.95,
    "text": "而现在 他归属其中"
  },
  {
    "start": 157.95,
    "end": 160.659,
    "text": "流光魅影在他眼中闪耀"
  },
  {
    "start": 160.659,
    "end": 163.639,
    "text": "星辰月亮在他心中运行"
  },
  {
    "start": 163.887,
    "end": 164.6,
    "text": "在路上"
  },
  {
    "start": 164.6,
    "end": 166.978,
    "text": "悉达多也忆起他在祗树"
  },
  {
    "start": 166.978,
    "end": 173.161,
    "text": "给孤独园中经历的一切他曾在那里聆听佛陀神圣的法义"
  },
  {
    "start": 173.161,
    "end": 176.368,
    "text": "同乔文达告别 与世尊交谈"
  },
  {
    "start": 176.368,
    "end": 180.562,
    "text": "他记起他曾对世尊佛陀说过的字字句句"
  },
  {
    "start": 180.562,
    "end": 182.535,
    "text": "他惊讶地意识到"
  },
  {
    "start": 182.535,
    "end": 186.029,
    "text": "自己所言的“珍宝” 当时无从体会"
  },
  {
    "start": 186.029,
    "end": 189.344,
    "text": "他曾对乔达摩说：佛陀的法义"
  },
  {
    "start": 189.344,
    "end": 192.913,
    "text": "或许并非其最宝贵最神秘的东西"
  },
  {
    "start": 192.913,
    "end": 196.154,
    "text": "佛陀的彻悟纪事才是无法言说、不可"
  },
  {
    "start": 196.154,
    "end": 197.774,
    "text": "传授的珍宝——这"
  },
  {
    "start": 197.774,
    "end": 200.002,
    "text": "恰恰是他现在要去经验的"
  },
  {
    "start": 200.002,
    "end": 203.494,
    "text": "他现在才刚刚开始去经验的 自然"
  },
  {
    "start": 203.494,
    "end": 206.331,
    "text": "他历来便知他的自我即阿特曼"
  },
  {
    "start": 206.331,
    "end": 209.038,
    "text": "自我如大梵般永恒存在"
  },
  {
    "start": 209.038,
    "end": 214.181,
    "text": "然而因他始终试图以思想之网去捕捉自我"
  },
  {
    "start": 214.181,
    "end": 218.606,
    "text": "而使得自我从未被真正发现 自然"
  },
  {
    "start": 218.606,
    "end": 222.755,
    "text": "肉体并非自我 感官游戏并非自我"
  },
  {
    "start": 222.755,
    "end": 225.59,
    "text": "如此看来思想也并非自我"
  },
  {
    "start": 225.59,
    "end": 228.684,
    "text": "才智并非自我 归纳结论"
  },
  {
    "start": 228.684,
    "end": 231.416,
    "text": "由旧思想编织新思想的可"
  },
  {
    "start": 231.416,
    "end": 237.873,
    "text": "修习之智慧和技艺并非自我不 这一思想境界乃是尘世的"
  },
  {
    "start": 237.873,
    "end": 245.652,
    "text": "如果一个人扼杀了感官意义上的偶然之我却喂养思想意义上博学多能的偶然之我"
  },
  {
    "start": 245.652,
    "end": 248.97,
    "text": "他是不会寻得自我的 两者"
  },
  {
    "start": 248.97,
    "end": 252.288,
    "text": "思想和感官 均为美的事物"
  },
  {
    "start": 252.288,
    "end": 255.096,
    "text": "两者背后均隐藏终极意义"
  },
  {
    "start": 255.096,
    "end": 258.312,
    "text": "两者都值得倾听 值得参与"
  },
  {
    "start": 258.312,
    "end": 261.28,
    "text": "两者均不容蔑视亦不必高估"
  },
  {
    "start": 261.28,
    "end": 265.184,
    "text": "自两者中均可听到内在的秘密之声"
  },
  {
    "start": 265.184,
    "end": 268.047,
    "text": "除非内在声音命令他行动"
  },
  {
    "start": 268.047,
    "end": 270.389,
    "text": "悉达多别无所求"
  },
  {
    "start": 270.389,
    "end": 272.757,
    "text": "除非听凭内在声音的倡导"
  },
  {
    "start": 272.757,
    "end": 274.264,
    "text": "他绝不停下步履"
  },
  {
    "start": 274.264,
    "end": 277.708,
    "text": "为何乔达摩在那个时辰中的时辰"
  },
  {
    "start": 277.708,
    "end": 283.907,
    "text": "那个他正觉成道的伟大时刻坐于菩提树下因为他听见一个声音"
  },
  {
    "start": 283.907,
    "end": 292.556,
    "text": "一个他内心的声音吩咐他在这棵树下歇息他并非凭苦行、献祭、洗礼和祈祷悟道"
  },
  {
    "start": 292.556,
    "end": 296.654,
    "text": "也不是凭斋戒悟道 不是在睡梦中悟道"
  },
  {
    "start": 296.654,
    "end": 298.475,
    "text": "他听凭了这个声音"
  },
  {
    "start": 298.475,
    "end": 300.484,
    "text": "如此听凭内心的召唤"
  },
  {
    "start": 300.484,
    "end": 306.065,
    "text": "而非听凭外在的命令是善的除了时刻等待这声音的召唤"
  },
  {
    "start": 306.065,
    "end": 308.134,
    "text": "再没什么行为是必要的"
  },
  {
    "start": 308.382,
    "end": 308.807,
    "text": "夜里"
  },
  {
    "start": 308.807,
    "end": 312.002,
    "text": "悉达多在河边摆渡人的茅屋里过夜"
  },
  {
    "start": 312.002,
    "end": 313.706,
    "text": "他做了一个梦"
  },
  {
    "start": 313.706,
    "end": 317.372,
    "text": "他梦见着黄色僧衣的乔文达站在他身边"
  },
  {
    "start": 317.372,
    "end": 319.745,
    "text": "乔文达看起来十分忧伤"
  },
  {
    "start": 319.745,
    "end": 322.767,
    "text": "他忧伤地问： 你为何离开我"
  },
  {
    "start": 322.767,
    "end": 325.092,
    "text": "悉达多拥抱了乔文达"
  },
  {
    "start": 325.092,
    "end": 328.579,
    "text": "并试图把他贴入胸口亲吻这时"
  },
  {
    "start": 328.579,
    "end": 332.621,
    "text": "乔文达不见了 取而代之的是一个女人"
  },
  {
    "start": 332.621,
    "end": 336.663,
    "text": "一对丰满的乳房从女人的衣襟中袒露出来"
  },
  {
    "start": 336.663,
    "end": 339.112,
    "text": "悉达多在她怀里吸吮乳汁"
  },
  {
    "start": 339.112,
    "end": 341.561,
    "text": "这对乳房的乳汁香甜浓郁"
  },
  {
    "start": 341.561,
    "end": 344.232,
    "text": "它是男人和女人的味道"
  },
  {
    "start": 344.232,
    "end": 348.331,
    "text": "阳光和森林的味道 动物和花朵的味道"
  },
  {
    "start": 348.331,
    "end": 351.747,
    "text": "它是每种果实 每种欲望的味道"
  },
  {
    "start": 351.747,
    "end": 352.886,
    "text": "它让人销魂"
  },
  {
    "start": 352.886,
    "end": 356.802,
    "text": "让人陶醉昏厥——当悉达多醒来时"
  },
  {
    "start": 356.802,
    "end": 361.5,
    "text": "苍白的河水在茅屋的门扉处闪烁着微光"
  },
  {
    "start": 361.5,
    "end": 365.994,
    "text": "森林里响起枭鹰凄厉的啼叫 深邃而嘹亮"
  },
  {
    "start": 366.242,
    "end": 370.48,
    "text": "天色渐白 悉达多请求船夫渡他过岸"
  },
  {
    "start": 370.48,
    "end": 373.721,
    "text": "船夫撑起竹筏载悉达多过河时"
  },
  {
    "start": 373.721,
    "end": 376.45,
    "text": "宽阔的河面上升起一轮红日"
  },
  {
    "start": 376.698,
    "end": 379.642,
    "text": "“这是一条美丽的河 ”悉达多道"
  },
  {
    "start": 379.89,
    "end": 382.032,
    "text": "“是的 ”船夫道"
  },
  {
    "start": 382.032,
    "end": 386.316,
    "text": "一条十分美丽的河 我爱它胜过一切"
  },
  {
    "start": 386.316,
    "end": 387.744,
    "text": "我时常聆听它"
  },
  {
    "start": 387.744,
    "end": 389.46,
    "text": "时常注视它的眼睛"
  },
  {
    "start": 389.46,
    "end": 391.391,
    "text": "我总能跟它学到许多"
  },
  {
    "start": 391.391,
    "end": 394.823,
    "text": "一条河可以教会人许多东西"
  },
  {
    "start": 395.071,
    "end": 397.424,
    "text": "我感谢你 善良的人"
  },
  {
    "start": 397.424,
    "end": 399.778,
    "text": "悉达多边说边登上河岸"
  },
  {
    "start": 399.778,
    "end": 403.2,
    "text": "我没有礼物送给你 亲爱的船夫"
  },
  {
    "start": 403.2,
    "end": 404.823,
    "text": "我也无法支付船钱"
  },
  {
    "start": 404.823,
    "end": 408.475,
    "text": "我是个无家可归的人 一个婆罗门之子"
  },
  {
    "start": 408.475,
    "end": 409.894,
    "text": "一个沙门"
  },
  {
    "start": 410.142,
    "end": 412.041,
    "text": "“我知道 ”船夫道"
  },
  {
    "start": 412.041,
    "end": 415.268,
    "text": "我并未期待你的报酬 也不要礼物"
  },
  {
    "start": 415.268,
    "end": 417.166,
    "text": "你下次再送我礼物"
  },
  {
    "start": 417.414,
    "end": 420.688,
    "text": "“你相信我会再来吗 ”悉达多好奇地问"
  },
  {
    "start": 420.936,
    "end": 421.681,
    "text": "准会"
  },
  {
    "start": 421.681,
    "end": 425.901,
    "text": "这也是我跟河水学到的：一切都会重来"
  },
  {
    "start": 425.901,
    "end": 430.12,
    "text": "你也是 沙门 你会再来 祝福你"
  },
  {
    "start": 430.12,
    "end": 432.637,
    "text": "你的友谊就是对我的犒赏"
  },
  {
    "start": 432.637,
    "end": 435.84,
    "text": "愿你在祭奉诸神时想到我"
  },
  {
    "start": 436.087,
    "end": 437.768,
    "text": "他们微笑着道别"
  },
  {
    "start": 437.768,
    "end": 441.61,
    "text": "悉达多为船夫的友谊和友善感到欣慰"
  },
  {
    "start": 441.61,
    "end": 444.252,
    "text": "他就像乔文达一样"
  },
  {
    "start": 444.252,
    "end": 445.479,
    "text": "他微笑着想"
  },
  {
    "start": 445.479,
    "end": 448.344,
    "text": "我在路上遇到的人都像乔文达"
  },
  {
    "start": 448.344,
    "end": 450.186,
    "text": "他们都心怀感激"
  },
  {
    "start": 450.186,
    "end": 453.858,
    "text": "尽管他们都有资格获得他人的感激"
  },
  {
    "start": 453.858,
    "end": 458.02,
    "text": "他们都谦卑、善意、恭顺 思虑甚少"
  },
  {
    "start": 458.02,
    "end": 460.214,
    "text": "他们都有一颗赤子之心"
  },
  {
    "start": 460.462,
    "end": 463.861,
    "text": "正午时分 悉达多经过一个村舍"
  },
  {
    "start": 463.861,
    "end": 467.488,
    "text": "巷子里的孩子们正在茅屋前追逐嬉闹"
  },
  {
    "start": 467.488,
    "end": 469.301,
    "text": "玩南瓜子和蚌壳"
  },
  {
    "start": 469.301,
    "end": 473.055,
    "text": "他们看见陌生沙门便羞怯着四散开去"
  },
  {
    "start": 473.055,
    "end": 475.87,
    "text": "村舍尽头蜿蜒着一条小溪"
  },
  {
    "start": 475.87,
    "end": 479.327,
    "text": "一位年轻妇人正跪在溪边洗衣"
  },
  {
    "start": 479.327,
    "end": 484.114,
    "text": "悉达多上前问好时 妇人抬头嫣然一笑"
  },
  {
    "start": 484.114,
    "end": 487.336,
    "text": "悉达多见她眉眼盈盈处泛着秋波"
  },
  {
    "start": 487.336,
    "end": 490.788,
    "text": "他以途中惯用的方式向妇人问安"
  },
  {
    "start": 490.788,
    "end": 493.11,
    "text": "并询问距离大城的路程"
  },
  {
    "start": 493.11,
    "end": 494.967,
    "text": "这时她起身走向他"
  },
  {
    "start": 494.967,
    "end": 496.824,
    "text": "年轻的面庞上一副"
  },
  {
    "start": 496.824,
    "end": 499.842,
    "text": "湿润的嘴唇闪着妩媚的光"
  },
  {
    "start": 499.842,
    "end": 502.476,
    "text": "她娇羞地问他可否用过饭"
  },
  {
    "start": 502.476,
    "end": 506.546,
    "text": "问他沙门是否真的在夜晚单独睡在林中"
  },
  {
    "start": 506.546,
    "end": 508.701,
    "text": "不能和女人同寝"
  },
  {
    "start": 508.701,
    "end": 509.425,
    "text": "说着"
  },
  {
    "start": 509.425,
    "end": 512.151,
    "text": "她用左脚尖抚摩他的右脚并"
  },
  {
    "start": 512.151,
    "end": 515.104,
    "text": "做出《爱经》中称为“爬树”"
  },
  {
    "start": 515.104,
    "end": 517.986,
    "text": "的动作——这是女人在挑逗"
  },
  {
    "start": 517.986,
    "end": 520.868,
    "text": "男人共赴云雨时所做的动作"
  },
  {
    "start": 520.868,
    "end": 524.274,
    "text": "悉达多顿感热血沸腾 此刻"
  },
  {
    "start": 524.274,
    "end": 528.203,
    "text": "梦境再次袭来 他朝妇人俯下身去"
  },
  {
    "start": 528.203,
    "end": 532.082,
    "text": "亲吻她乳房上褐色的乳头 抬起头时"
  },
  {
    "start": 532.082,
    "end": 534.592,
    "text": "他看见妇人焦渴地微笑着"
  },
  {
    "start": 534.592,
    "end": 537.636,
    "text": "满是企盼的双眼细若游丝"
  },
  {
    "start": 537.884,
    "end": 541.727,
    "text": "悉达多感到自己的渴望和涌动的性欲"
  },
  {
    "start": 541.727,
    "end": 543.89,
    "text": "他至今尚未碰过女人"
  },
  {
    "start": 543.89,
    "end": 547.013,
    "text": "在准备伸手去握住妇人时"
  },
  {
    "start": 547.013,
    "end": 549.814,
    "text": "他迟疑片刻 就在这一刻"
  },
  {
    "start": 549.814,
    "end": 553.782,
    "text": "他听见内心颤抖的声音说“不” 顿时"
  },
  {
    "start": 553.782,
    "end": 557.032,
    "text": "年轻妇人微笑的脸失去了全部魅力"
  },
  {
    "start": 557.032,
    "end": 558.766,
    "text": "她在他眼中不过是"
  },
  {
    "start": 558.766,
    "end": 561.366,
    "text": "一只目光迷离的发情母兽"
  },
  {
    "start": 561.366,
    "end": 563.873,
    "text": "他亲切地抚摸了她的脸颊"
  },
  {
    "start": 563.873,
    "end": 566.836,
    "text": "随后移步离开这位失望的妇人"
  },
  {
    "start": 566.836,
    "end": 568.66,
    "text": "健步踏入竹林"
  },
  {
    "start": 568.908,
    "end": 573.205,
    "text": "黄昏时分 他已临近大城 心情愉悦"
  },
  {
    "start": 573.205,
    "end": 575.353,
    "text": "他渴望生活在世人中"
  },
  {
    "start": 575.353,
    "end": 577.502,
    "text": "他已在林中待了太久"
  },
  {
    "start": 577.502,
    "end": 580.27,
    "text": "那天夜晚在船夫的茅屋里留宿"
  },
  {
    "start": 580.27,
    "end": 583.676,
    "text": "正是许久以来他第一次在室内过夜"
  },
  {
    "start": 583.924,
    "end": 584.665,
    "text": "城郊处"
  },
  {
    "start": 584.665,
    "end": 588.621,
    "text": "这位漫步者在一座美丽的围着篱笆的"
  },
  {
    "start": 588.621,
    "end": 592.823,
    "text": "林苑外遇见一队手托篮篓的男女仆从"
  },
  {
    "start": 592.823,
    "end": 594.653,
    "text": "一部由四人高抬、"
  },
  {
    "start": 594.653,
    "end": 599.457,
    "text": "装饰华美的轿子位于中间色彩缤纷的遮阳篷下"
  },
  {
    "start": 599.457,
    "end": 602.222,
    "text": "一个女人坐在大红的坐垫上"
  },
  {
    "start": 602.222,
    "end": 604.065,
    "text": "她是林苑的女主人"
  },
  {
    "start": 604.065,
    "end": 607.981,
    "text": "悉达多在这香艳的林苑入口处站定"
  },
  {
    "start": 607.981,
    "end": 609.334,
    "text": "注目这一行人"
  },
  {
    "start": 609.334,
    "end": 612.491,
    "text": "他看见男仆、女佣、篮篓和轿子"
  },
  {
    "start": 612.491,
    "end": 614.745,
    "text": "他看见轿中的女人"
  },
  {
    "start": 614.745,
    "end": 617.722,
    "text": "他看见她高高挽起的乌发云髻"
  },
  {
    "start": 617.722,
    "end": 620.699,
    "text": "下一张靓丽、娇柔、聪慧的脸"
  },
  {
    "start": 620.699,
    "end": 624.585,
    "text": "她美艳的红唇好似新鲜开裂的无花果"
  },
  {
    "start": 624.585,
    "end": 628.228,
    "text": "精心修饰的眉毛描成高挑的弧形"
  },
  {
    "start": 628.228,
    "end": 631.192,
    "text": "一双乌黑的明眸聪敏而机智"
  },
  {
    "start": 631.192,
    "end": 633.661,
    "text": "艳绿和金黄搭配的上衣"
  },
  {
    "start": 633.661,
    "end": 636.377,
    "text": "中露出光洁修长的颈项"
  },
  {
    "start": 636.377,
    "end": 640.712,
    "text": "娴雅的手指纤纤柔荑 手腕上戴着宽金镯"
  },
  {
    "start": 640.96,
    "end": 644.377,
    "text": "悉达多见她如此美丽 心中欢喜"
  },
  {
    "start": 644.377,
    "end": 646.884,
    "text": "轿子临近时 他深鞠一躬"
  },
  {
    "start": 646.884,
    "end": 650.342,
    "text": "接着抬头注视那张靓丽妩媚的脸"
  },
  {
    "start": 650.342,
    "end": 654.048,
    "text": "他凝视她高挑眉毛下聪慧的双眼"
  },
  {
    "start": 654.048,
    "end": 657.404,
    "text": "并嗅到一缕从未闻过的沁人香气"
  },
  {
    "start": 657.404,
    "end": 659.802,
    "text": "这位美人微笑颔首后"
  },
  {
    "start": 659.802,
    "end": 663.736,
    "text": "在仆从的簇拥下转瞬消失在林苑中"
  },
  {
    "start": 663.984,
    "end": 666.701,
    "text": "“我尚未入城 ”悉达多想"
  },
  {
    "start": 666.701,
    "end": 670.464,
    "text": "“就天降此等吉兆 ”他感到一阵冲动"
  },
  {
    "start": 670.464,
    "end": 671.928,
    "text": "想即刻跟入林苑"
  },
  {
    "start": 671.928,
    "end": 675.295,
    "text": "但转念又想起男女仆从们曾在"
  },
  {
    "start": 675.295,
    "end": 678.922,
    "text": "门口轻视、怀疑而无礼地打量他"
  },
  {
    "start": 679.17,
    "end": 681.659,
    "text": "“我还是个沙门 ”他想"
  },
  {
    "start": 681.659,
    "end": 683.94,
    "text": "依然还是苦行者和乞丐"
  },
  {
    "start": 683.94,
    "end": 686.429,
    "text": "我这样的人不该在此逗留"
  },
  {
    "start": 686.429,
    "end": 689.753,
    "text": "更不该踏入林苑  他笑了起来"
  },
  {
    "start": 690.001,
    "end": 692.485,
    "text": "这时 来了一位路人"
  },
  {
    "start": 692.485,
    "end": 694.722,
    "text": "悉达多向他打听这座"
  },
  {
    "start": 694.722,
    "end": 698.2,
    "text": "林苑以及那个女人的名字原来"
  },
  {
    "start": 698.2,
    "end": 701.19,
    "text": "林苑的女主人迦摩罗是城中名妓"
  },
  {
    "start": 701.19,
    "end": 705.034,
    "text": "除了这林苑外 她在城里还有一座宅邸"
  },
  {
    "start": 705.282,
    "end": 708.586,
    "text": "之后他就怀揣着一个目标进了城"
  },
  {
    "start": 708.834,
    "end": 712.161,
    "text": "为了这个目标 悉达多踏遍城邑"
  },
  {
    "start": 712.161,
    "end": 713.048,
    "text": "走街串巷"
  },
  {
    "start": 713.048,
    "end": 715.86,
    "text": "累了便安静地伫立在广场"
  },
  {
    "start": 715.86,
    "end": 720.462,
    "text": "或坐在河边的石阶上歇息临近傍晚时分"
  },
  {
    "start": 720.462,
    "end": 723.102,
    "text": "他结识了一位理发店伙计"
  },
  {
    "start": 723.102,
    "end": 726.222,
    "text": "他先见他在拱门下阴凉处劳作"
  },
  {
    "start": 726.222,
    "end": 729.101,
    "text": "又见他去毗湿奴庙祈祷"
  },
  {
    "start": 729.101,
    "end": 731.405,
    "text": "悉达多为他讲述了毗湿"
  },
  {
    "start": 731.405,
    "end": 734.63,
    "text": "奴和拉克什米女神的故事当晚"
  },
  {
    "start": 734.63,
    "end": 738.57,
    "text": "悉达多在岸边的船里过夜并于次日一早"
  },
  {
    "start": 738.57,
    "end": 742.509,
    "text": "在其他客人还没到来前光顾了理发店"
  },
  {
    "start": 742.509,
    "end": 745.11,
    "text": "他让那位伙计为他刮了胡须"
  },
  {
    "start": 745.11,
    "end": 748.577,
    "text": "剪了头发并敷了上好的头油 之后"
  },
  {
    "start": 748.577,
    "end": 750.094,
    "text": "他去河里沐浴"
  },
  {
    "start": 750.341,
    "end": 752.584,
    "text": "当美丽的迦摩罗于午后"
  },
  {
    "start": 752.584,
    "end": 756.846,
    "text": "再次乘轿子回到林苑时悉达多正站在门口"
  },
  {
    "start": 756.846,
    "end": 758.976,
    "text": "他向迦摩罗鞠躬致意"
  },
  {
    "start": 758.976,
    "end": 763.71,
    "text": "并得到这位名妓的回敬他向队尾的仆从示意"
  },
  {
    "start": 763.71,
    "end": 766.187,
    "text": "请求仆从向林苑女主人禀告"
  },
  {
    "start": 766.187,
    "end": 768.87,
    "text": "有位青年婆罗门渴望与她交谈"
  },
  {
    "start": 768.87,
    "end": 771.554,
    "text": "过了一会儿 仆从回来了"
  },
  {
    "start": 771.554,
    "end": 774.216,
    "text": "他吩咐正在等待的悉达多"
  },
  {
    "start": 774.216,
    "end": 780.508,
    "text": "跟随他默默进了一座亭台亭台里 迦摩罗正斜倚在卧榻上"
  },
  {
    "start": 780.508,
    "end": 782.777,
    "text": "她随即差遣仆从退下"
  },
  {
    "start": 783.025,
    "end": 786.212,
    "text": "你不就是昨天站在外面问候我的人吗"
  },
  {
    "start": 786.212,
    "end": 787.524,
    "text": "迦摩罗问道"
  },
  {
    "start": 787.772,
    "end": 791.741,
    "text": "悉达多答  是的 我昨天就见到了你"
  },
  {
    "start": 791.741,
    "end": 792.786,
    "text": "问候了你"
  },
  {
    "start": 793.034,
    "end": 793.997,
    "text": "迦摩罗又问"
  },
  {
    "start": 793.997,
    "end": 796.309,
    "text": "但是昨天你不是留着胡须"
  },
  {
    "start": 796.309,
    "end": 798.813,
    "text": "长发上还布满灰尘吗"
  },
  {
    "start": 799.061,
    "end": 801.901,
    "text": "悉达多道  你看得仔细"
  },
  {
    "start": 801.901,
    "end": 805.925,
    "text": "一切都尽收眼底 你见到的人是悉达多"
  },
  {
    "start": 805.925,
    "end": 809.758,
    "text": "为成为沙门而告别故乡的婆罗门之子"
  },
  {
    "start": 809.758,
    "end": 812.154,
    "text": "迄今做沙门已三年有余"
  },
  {
    "start": 812.154,
    "end": 815.269,
    "text": "但现在我已告别沙门之路"
  },
  {
    "start": 815.269,
    "end": 817.459,
    "text": "进了这座城 而你"
  },
  {
    "start": 817.459,
    "end": 821.352,
    "text": "是我入城之前见到的第一个人 哦"
  },
  {
    "start": 821.352,
    "end": 824.758,
    "text": "迦摩罗 我来 是为告诉你这个"
  },
  {
    "start": 824.758,
    "end": 827.162,
    "text": "你是让悉达多并未低垂"
  },
  {
    "start": 827.162,
    "end": 833.412,
    "text": "眼帘而与之交谈的第一个女人今后 如若我遇见漂亮女人"
  },
  {
    "start": 833.412,
    "end": 835.461,
    "text": "也不会再垂下眼帘"
  },
  {
    "start": 835.709,
    "end": 836.926,
    "text": "迦摩罗微笑着"
  },
  {
    "start": 836.926,
    "end": 839.563,
    "text": "她一边玩弄手中的孔雀翎摇扇"
  },
  {
    "start": 839.563,
    "end": 843.213,
    "text": "一边问道： 悉达多只是为了说这个"
  },
  {
    "start": 843.213,
    "end": 844.367,
    "text": "才来见我吗"
  },
  {
    "start": 844.615,
    "end": 847.485,
    "text": "悉达多答  是为了说这个"
  },
  {
    "start": 847.485,
    "end": 850.355,
    "text": "也为感谢你的美貌 迦摩罗"
  },
  {
    "start": 850.355,
    "end": 851.679,
    "text": "如若不冒犯你"
  },
  {
    "start": 851.679,
    "end": 854.277,
    "text": "我想请求你做我的朋友和老师"
  },
  {
    "start": 854.277,
    "end": 858.073,
    "text": "因为对你所熟稔的艺术 我一无所知"
  },
  {
    "start": 858.321,
    "end": 859.985,
    "text": "迦摩罗大笑起来"
  },
  {
    "start": 860.233,
    "end": 863.852,
    "text": "从来没有林中沙门来拜我为师 朋友"
  },
  {
    "start": 863.852,
    "end": 866.76,
    "text": "也从来没有围着破旧遮羞布"
  },
  {
    "start": 866.76,
    "end": 872.091,
    "text": "、留着长发的沙门来过我这里许多青年来拜访我"
  },
  {
    "start": 872.091,
    "end": 874.21,
    "text": "其中不乏婆罗门之子"
  },
  {
    "start": 874.21,
    "end": 879.388,
    "text": "他们可是个个穿华丽的衣裳、考究的鞋子头发飘香"
  },
  {
    "start": 879.388,
    "end": 881.036,
    "text": "腰缠万贯"
  },
  {
    "start": 881.036,
    "end": 883.269,
    "text": "沙门 那些青年都是"
  },
  {
    "start": 883.269,
    "end": 885.28,
    "text": "置备停当才来见我"
  },
  {
    "start": 885.528,
    "end": 888.546,
    "text": "悉达多道： 我已开始向你学习"
  },
  {
    "start": 888.546,
    "end": 891.565,
    "text": "昨天已经开始 我已刮掉胡须"
  },
  {
    "start": 891.565,
    "end": 893.722,
    "text": "打理头发 抹了发油"
  },
  {
    "start": 893.722,
    "end": 897.461,
    "text": "我缺少得不多 你这仙姿佚貌的女人"
  },
  {
    "start": 897.461,
    "end": 899.927,
    "text": "我缺的不过是华美的衣裳"
  },
  {
    "start": 899.927,
    "end": 903.515,
    "text": "、昂贵的鞋子和饱满的钱袋你知道"
  },
  {
    "start": 903.515,
    "end": 905.761,
    "text": "悉达多曾致力于许多比"
  },
  {
    "start": 905.761,
    "end": 912.274,
    "text": "这区区小事难得多的事业且已完满 而我昨日下定决心要做的事"
  },
  {
    "start": 912.274,
    "end": 916.181,
    "text": "又怎能无法达成——我要成为你的朋友"
  },
  {
    "start": 916.181,
    "end": 919.859,
    "text": "同你学习欢爱之事 你将很快知道"
  },
  {
    "start": 919.859,
    "end": 920.778,
    "text": "迦摩罗"
  },
  {
    "start": 920.778,
    "end": 924.252,
    "text": "我曾学过比你教的学问更复杂的学问"
  },
  {
    "start": 924.252,
    "end": 926.857,
    "text": "那么 悉达多已抹了发油"
  },
  {
    "start": 926.857,
    "end": 929.235,
    "text": "却仅仅因为没有华美的衣服"
  },
  {
    "start": 929.235,
    "end": 931.811,
    "text": "没有名贵的鞋子 没有钱财"
  },
  {
    "start": 931.811,
    "end": 933.991,
    "text": "就无法让你满意吗"
  },
  {
    "start": 934.239,
    "end": 937.494,
    "text": "迦摩罗笑道： 是的 尊敬的人"
  },
  {
    "start": 937.494,
    "end": 940.748,
    "text": "你不能让我满意 你必须有衣服"
  },
  {
    "start": 940.748,
    "end": 941.833,
    "text": "华美的衣服"
  },
  {
    "start": 941.833,
    "end": 944.594,
    "text": "你必须有鞋子 名贵的鞋子"
  },
  {
    "start": 944.594,
    "end": 946.294,
    "text": "你不仅要腰缠万贯"
  },
  {
    "start": 946.294,
    "end": 949.692,
    "text": "还要为迦摩罗备上礼物 明白了吗"
  },
  {
    "start": 949.692,
    "end": 952.566,
    "text": "林中的沙门 这些你记住了吗"
  },
  {
    "start": 952.814,
    "end": 956.201,
    "text": "“我完全记住了 ”悉达多大声道"
  },
  {
    "start": 956.201,
    "end": 958.317,
    "text": "从如此美艳的嘴唇里"
  },
  {
    "start": 958.317,
    "end": 960.433,
    "text": "说出的话我怎能不记住"
  },
  {
    "start": 960.433,
    "end": 963.912,
    "text": "你的嘴唇仿似新鲜开裂的无花果"
  },
  {
    "start": 963.912,
    "end": 968.135,
    "text": "迦摩罗 而我的嘴唇也同样又红又嫩"
  },
  {
    "start": 968.135,
    "end": 969.377,
    "text": "你将验证"
  },
  {
    "start": 969.377,
    "end": 972.16,
    "text": "它们是多么般配——但请告诉我"
  },
  {
    "start": 972.16,
    "end": 973.552,
    "text": "美丽的迦摩罗"
  },
  {
    "start": 973.552,
    "end": 975.608,
    "text": "你真的不畏惧一个要向你"
  },
  {
    "start": 975.608,
    "end": 977.851,
    "text": "学习欢爱的林中沙门吗"
  },
  {
    "start": 978.099,
    "end": 981.711,
    "text": "迦摩罗反问： 我为何要畏惧一个沙门"
  },
  {
    "start": 981.711,
    "end": 984.048,
    "text": "一个林中来的愚笨的沙门"
  },
  {
    "start": 984.048,
    "end": 986.173,
    "text": "一个从胡狼群中来"
  },
  {
    "start": 986.173,
    "end": 989.307,
    "text": "又根本不知女人为何物的沙门呢"
  },
  {
    "start": 989.555,
    "end": 993.119,
    "text": "悉达多道  哦 沙门是强壮的"
  },
  {
    "start": 993.119,
    "end": 996.238,
    "text": "他无所畏惧 他恐怕会强迫你"
  },
  {
    "start": 996.238,
    "end": 997.129,
    "text": "美丽的女人"
  },
  {
    "start": 997.129,
    "end": 1000.108,
    "text": "他恐怕会强夺你 给你带来痛苦"
  },
  {
    "start": 1000.356,
    "end": 1004.405,
    "text": "迦摩罗回应  不 沙门 我不怕"
  },
  {
    "start": 1004.405,
    "end": 1005.98,
    "text": "难道一个沙门或"
  },
  {
    "start": 1005.98,
    "end": 1008.23,
    "text": "婆罗门会害怕有人来强夺他"
  },
  {
    "start": 1008.23,
    "end": 1010.534,
    "text": "侵吞他渊博的学识、他"
  },
  {
    "start": 1010.534,
    "end": 1016.294,
    "text": "的虔诚和他深奥的思想吗不会 因为这些只属于他自己"
  },
  {
    "start": 1016.294,
    "end": 1019.837,
    "text": "他只会把这些奉献给他想给的人"
  },
  {
    "start": 1019.837,
    "end": 1023.128,
    "text": "迦摩罗亦如此 欢爱亦如此"
  },
  {
    "start": 1023.128,
    "end": 1025.786,
    "text": "迦摩罗的嘴唇固然美艳嫣红"
  },
  {
    "start": 1025.786,
    "end": 1029.772,
    "text": "但你若试图违背迦摩罗的意愿去强吻它"
  },
  {
    "start": 1029.772,
    "end": 1032.053,
    "text": "便不会得到一丝甜蜜"
  },
  {
    "start": 1032.053,
    "end": 1035.348,
    "text": "尽管那嘴唇深知如何赋予甜蜜"
  },
  {
    "start": 1035.348,
    "end": 1037.376,
    "text": "勤学的悉达多"
  },
  {
    "start": 1037.376,
    "end": 1041.382,
    "text": "你要明白：情爱可以乞得 可以购买"
  },
  {
    "start": 1041.382,
    "end": 1044.446,
    "text": "可以受馈 也可在陋巷觅得"
  },
  {
    "start": 1044.446,
    "end": 1046.095,
    "text": "却唯独不能强夺"
  },
  {
    "start": 1046.095,
    "end": 1049.13,
    "text": "你想出了一个错误的主意 哦"
  },
  {
    "start": 1049.13,
    "end": 1051.081,
    "text": "如果一个如你般俊美"
  },
  {
    "start": 1051.081,
    "end": 1053.249,
    "text": "的青年有如此想法的话"
  },
  {
    "start": 1053.249,
    "end": 1055.048,
    "text": "就实在太遗憾了"
  },
  {
    "start": 1055.296,
    "end": 1059.553,
    "text": "悉达多微笑着鞠躬致意： 那的确遗憾"
  },
  {
    "start": 1059.553,
    "end": 1064.31,
    "text": "迦摩罗 你说得极对 那将极为遗憾 不"
  },
  {
    "start": 1064.31,
    "end": 1067.746,
    "text": "我不愿放弃你芳唇间任何一滴甜蜜"
  },
  {
    "start": 1067.746,
    "end": 1069.807,
    "text": "你也不该放弃我的吻"
  },
  {
    "start": 1069.807,
    "end": 1072.784,
    "text": "此事已定：悉达多会再来"
  },
  {
    "start": 1072.784,
    "end": 1076.587,
    "text": "当他拥有了他缺少的华服、鞋子和钱财"
  },
  {
    "start": 1076.587,
    "end": 1077.259,
    "text": "但是"
  },
  {
    "start": 1077.259,
    "end": 1078.475,
    "text": "甜美的迦摩罗"
  },
  {
    "start": 1078.475,
    "end": 1081.313,
    "text": "你可愿再给我一些指示"
  },
  {
    "start": 1081.56,
    "end": 1085.61,
    "text": "迦摩罗道  一些指示 为什么不哪"
  },
  {
    "start": 1085.61,
    "end": 1088.535,
    "text": "谁会不愿给一个从荒林狼群中来"
  },
  {
    "start": 1088.535,
    "end": 1091.249,
    "text": "又贫穷无知的沙门一些指示"
  },
  {
    "start": 1091.497,
    "end": 1092.853,
    "text": "亲爱的迦摩罗"
  },
  {
    "start": 1092.853,
    "end": 1094.792,
    "text": "请告诉我：我该去哪里"
  },
  {
    "start": 1094.792,
    "end": 1097.506,
    "text": "才能尽快寻得这三样东西"
  },
  {
    "start": 1097.754,
    "end": 1101.907,
    "text": "迦摩罗回答  朋友 许多人都想知道"
  },
  {
    "start": 1101.907,
    "end": 1104.093,
    "text": "你必须去做你会做的事情"
  },
  {
    "start": 1104.093,
    "end": 1106.648,
    "text": "以赚得钱财、鞋子和衣裳"
  },
  {
    "start": 1106.648,
    "end": 1109.436,
    "text": "否则一个穷人是不会有钱的"
  },
  {
    "start": 1109.436,
    "end": 1111.527,
    "text": "你会什么呢"
  },
  {
    "start": 1111.775,
    "end": 1115.29,
    "text": "悉达多答  我会思考 我会等待"
  },
  {
    "start": 1115.29,
    "end": 1116.324,
    "text": "我会斋戒"
  },
  {
    "start": 1116.572,
    "end": 1118.491,
    "text": "迦摩罗问“没别的了吗 ”"
  },
  {
    "start": 1118.739,
    "end": 1121.254,
    "text": "悉达多回答  没有了"
  },
  {
    "start": 1121.254,
    "end": 1123.312,
    "text": "不过 我还会作诗"
  },
  {
    "start": 1123.312,
    "end": 1126.513,
    "text": "你愿意为我的诗赐我一吻吗"
  },
  {
    "start": 1126.761,
    "end": 1130.076,
    "text": "迦摩罗道 如果你的诗讨我欢心的话"
  },
  {
    "start": 1130.076,
    "end": 1133.185,
    "text": "我愿意 你的诗叫什么名字"
  },
  {
    "start": 1133.433,
    "end": 1136.102,
    "text": "悉达多深思片刻 吟诵道"
  },
  {
    "start": 1136.35,
    "end": 1139.809,
    "text": "多茵的林苑里摇曳着婀娜的迦摩罗"
  },
  {
    "start": 1140.057,
    "end": 1143.631,
    "text": "林苑的门扉处伫立着麦褐色的沙门"
  },
  {
    "start": 1143.879,
    "end": 1145.883,
    "text": "当他惊见莲花盛放"
  },
  {
    "start": 1146.131,
    "end": 1148.235,
    "text": "不禁俯身扪心示敬"
  },
  {
    "start": 1148.483,
    "end": 1149.622,
    "text": "又怎奈"
  },
  {
    "start": 1149.87,
    "end": 1151.814,
    "text": "迦摩罗含笑回眸"
  },
  {
    "start": 1152.062,
    "end": 1154.631,
    "text": "啊 青年暗自思量"
  },
  {
    "start": 1154.879,
    "end": 1157.608,
    "text": "献祭诸神固情深义重"
  },
  {
    "start": 1157.856,
    "end": 1159.295,
    "text": "却哪比"
  },
  {
    "start": 1159.543,
    "end": 1162.602,
    "text": "献身美丽的迦摩罗情意绵绵"
  },
  {
    "start": 1162.85,
    "end": 1164.973,
    "text": "迦摩罗听罢热烈鼓掌"
  },
  {
    "start": 1164.973,
    "end": 1167.804,
    "text": "金镯亦在手腕上叮叮作响"
  },
  {
    "start": 1168.052,
    "end": 1171.279,
    "text": "你的诗很美 麦褐色的沙门"
  },
  {
    "start": 1171.279,
    "end": 1173.815,
    "text": "当真 为了这首诗赐你"
  },
  {
    "start": 1173.815,
    "end": 1176.121,
    "text": "一吻我并不失去丝毫"
  },
  {
    "start": 1176.369,
    "end": 1179.268,
    "text": "说着她用眼神示意他走上前来"
  },
  {
    "start": 1179.268,
    "end": 1181.498,
    "text": "他将脸俯在她的脸上"
  },
  {
    "start": 1181.498,
    "end": 1183.887,
    "text": "又将嘴唇印在她那宛如"
  },
  {
    "start": 1183.887,
    "end": 1189.862,
    "text": "新鲜开裂的无花果般的朱唇上长久地 他亲吻着迦摩罗"
  },
  {
    "start": 1189.862,
    "end": 1193.569,
    "text": "让他深深惊叹的是她在如何引导他"
  },
  {
    "start": 1193.569,
    "end": 1198.266,
    "text": "她在怎样聪慧地降服他 推却他 魅惑他"
  },
  {
    "start": 1198.266,
    "end": 1200.577,
    "text": "在第一个绵长的亲吻后"
  },
  {
    "start": 1200.577,
    "end": 1204.044,
    "text": "一连串奇巧而纯熟的亲吻接踵而至"
  },
  {
    "start": 1204.044,
    "end": 1207.28,
    "text": "每一个吻都有别于另一个吻"
  },
  {
    "start": 1207.28,
    "end": 1210.462,
    "text": "他站起身来喘着粗气 这一刻"
  },
  {
    "start": 1210.462,
    "end": 1213.189,
    "text": "他如同一个眼界大开的孩子"
  },
  {
    "start": 1213.189,
    "end": 1216.743,
    "text": "为眼前丰富而博大精深的学识惊叹"
  },
  {
    "start": 1216.991,
    "end": 1220.813,
    "text": "“你的诗非常优美 ”迦摩罗大声道"
  },
  {
    "start": 1220.813,
    "end": 1224.86,
    "text": "若我是富人 我会为此付你金币 但是"
  },
  {
    "start": 1224.86,
    "end": 1228.279,
    "text": "靠作诗赚取你所需钱财恐怕并非易事"
  },
  {
    "start": 1228.279,
    "end": 1230.629,
    "text": "如果想成为迦摩罗的朋友"
  },
  {
    "start": 1230.629,
    "end": 1232.979,
    "text": "你需要很多钱财"
  },
  {
    "start": 1233.227,
    "end": 1236.015,
    "text": "你真的 很会亲吻 迦摩罗"
  },
  {
    "start": 1236.015,
    "end": 1237.316,
    "text": "悉达多结巴着道"
  },
  {
    "start": 1237.564,
    "end": 1239.56,
    "text": "是的 我很擅长"
  },
  {
    "start": 1239.56,
    "end": 1241.999,
    "text": "所以我才不缺衣裳、鞋子"
  },
  {
    "start": 1241.999,
    "end": 1245.103,
    "text": "不缺手镯和这一切华美的东西"
  },
  {
    "start": 1245.103,
    "end": 1246.497,
    "text": "可是你擅长什么"
  },
  {
    "start": 1246.497,
    "end": 1248.089,
    "text": "除了思考、斋戒和"
  },
  {
    "start": 1248.089,
    "end": 1250.477,
    "text": "作诗你再不会别的了"
  },
  {
    "start": 1250.725,
    "end": 1253.514,
    "text": "“我会唱圣歌 ”悉达多道"
  },
  {
    "start": 1253.514,
    "end": 1256.517,
    "text": "但我不再吟唱 我会念咒语"
  },
  {
    "start": 1256.517,
    "end": 1257.804,
    "text": "但我不再念诵"
  },
  {
    "start": 1257.804,
    "end": 1259.213,
    "text": "我也学过写字——"
  },
  {
    "start": 1259.461,
    "end": 1263.344,
    "text": "“等一下 ”迦摩罗打断他 “你识字"
  },
  {
    "start": 1263.344,
    "end": 1264.365,
    "text": "也会写字"
  },
  {
    "start": 1264.613,
    "end": 1268.012,
    "text": "悉达多答 “我当然会 不少人会 ”"
  },
  {
    "start": 1268.26,
    "end": 1271.65,
    "text": "迦摩罗道  大多数人都不会"
  },
  {
    "start": 1271.65,
    "end": 1275.282,
    "text": "连我也不会 好极了 你识字"
  },
  {
    "start": 1275.282,
    "end": 1277.219,
    "text": "还会写字 这太好了"
  },
  {
    "start": 1277.219,
    "end": 1279.158,
    "text": "念咒语也是用得着的"
  },
  {
    "start": 1279.406,
    "end": 1281.708,
    "text": "这时 女仆匆忙进来"
  },
  {
    "start": 1281.708,
    "end": 1284.93,
    "text": "在女主人耳畔低语着禀报了什么"
  },
  {
    "start": 1285.178,
    "end": 1288.832,
    "text": "“我有客人 ”迦摩罗道 “赶快离开"
  },
  {
    "start": 1288.832,
    "end": 1290.177,
    "text": "悉达多 记住"
  },
  {
    "start": 1290.177,
    "end": 1292.292,
    "text": "不要让任何人看见你在这里"
  },
  {
    "start": 1292.292,
    "end": 1293.902,
    "text": "明天我再见你"
  },
  {
    "start": 1294.149,
    "end": 1296.347,
    "text": "说着她命仆从送给这位"
  },
  {
    "start": 1296.347,
    "end": 1302.719,
    "text": "虔诚的婆罗门一件白色上衣接着 悉达多糊里糊涂地被仆人带走"
  },
  {
    "start": 1302.719,
    "end": 1306.924,
    "text": "穿过花园蜿蜒的小径 仆人赠送了上衣"
  },
  {
    "start": 1306.924,
    "end": 1308.793,
    "text": "将他带到灌木丛处"
  },
  {
    "start": 1308.793,
    "end": 1312.047,
    "text": "催促他赶快不留踪迹地离开林苑"
  },
  {
    "start": 1312.295,
    "end": 1313.651,
    "text": "他满意地照办"
  },
  {
    "start": 1313.651,
    "end": 1316.591,
    "text": "这位林中之人轻快地翻过丛莽"
  },
  {
    "start": 1316.591,
    "end": 1320.209,
    "text": "溜出林苑 他心满意足地进了城"
  },
  {
    "start": 1320.209,
    "end": 1322.255,
    "text": "腋下夹着叠好的上衣"
  },
  {
    "start": 1322.255,
    "end": 1326.348,
    "text": "在一家旅人歇息的客栈前 他停下脚步"
  },
  {
    "start": 1326.348,
    "end": 1328.993,
    "text": "默默乞食并默默收下一块饭团"
  },
  {
    "start": 1328.993,
    "end": 1331.028,
    "text": "“或许明天 ”他想"
  },
  {
    "start": 1331.028,
    "end": 1333.877,
    "text": "“我将不再向任何人乞食 ”"
  },
  {
    "start": 1334.125,
    "end": 1338.509,
    "text": "一股自豪感油然而生 他已不再是沙门"
  },
  {
    "start": 1338.509,
    "end": 1342.894,
    "text": "无需再去乞食 他将手中饭团扔给一条狗"
  },
  {
    "start": 1342.894,
    "end": 1344.573,
    "text": "自己并未进食"
  },
  {
    "start": 1344.821,
    "end": 1347.875,
    "text": "“尘世生活其实简单 ”悉达多想"
  },
  {
    "start": 1347.875,
    "end": 1350.93,
    "text": "没什么难的 难的是做辛劳的沙门"
  },
  {
    "start": 1350.93,
    "end": 1355.157,
    "text": "到头来只收获绝望 现在一切易如反掌"
  },
  {
    "start": 1355.157,
    "end": 1359.384,
    "text": "就像迦摩罗的接吻课 我需要衣裳和金钱"
  },
  {
    "start": 1359.384,
    "end": 1362.891,
    "text": "别无其他 实现这些又小又近的目标"
  },
  {
    "start": 1362.891,
    "end": 1364.953,
    "text": "不会让人寝食难安"
  },
  {
    "start": 1365.201,
    "end": 1372.17,
    "text": "他早就打听好迦摩罗位于城中宅邸的位置第二天便登门造访"
  },
  {
    "start": 1372.418,
    "end": 1375.879,
    "text": "“一切都很顺利 ”迦摩罗迎向他"
  },
  {
    "start": 1375.879,
    "end": 1378.043,
    "text": "迦摩施瓦弥正在等你"
  },
  {
    "start": 1378.043,
    "end": 1380.422,
    "text": "他是城中最富庶的商人"
  },
  {
    "start": 1380.422,
    "end": 1383.754,
    "text": "如果你讨他欢心 便可替他做事"
  },
  {
    "start": 1383.754,
    "end": 1386.642,
    "text": "放机灵点儿 麦褐色的沙门"
  },
  {
    "start": 1386.642,
    "end": 1388.641,
    "text": "我托人向他引荐了你"
  },
  {
    "start": 1388.641,
    "end": 1391.801,
    "text": "你要对他客气些 他很有权势"
  },
  {
    "start": 1391.801,
    "end": 1393.833,
    "text": "但你也不必过分谦卑"
  },
  {
    "start": 1393.833,
    "end": 1396.315,
    "text": "我不希望你做他的仆从"
  },
  {
    "start": 1396.315,
    "end": 1398.241,
    "text": "你得和他平起平坐"
  },
  {
    "start": 1398.241,
    "end": 1400.407,
    "text": "否则我不会对你满意"
  },
  {
    "start": 1400.407,
    "end": 1404.739,
    "text": "迦摩施瓦弥年事渐高 如果你取悦他"
  },
  {
    "start": 1404.739,
    "end": 1407.068,
    "text": "他会将许多事托付于你"
  },
  {
    "start": 1407.316,
    "end": 1409.163,
    "text": "悉达多笑着感谢她"
  },
  {
    "start": 1409.163,
    "end": 1412.625,
    "text": "迦摩罗知道悉达多已两天未进食"
  },
  {
    "start": 1412.625,
    "end": 1416.289,
    "text": "便吩咐仆从取来面包和水果款待他"
  },
  {
    "start": 1416.537,
    "end": 1419.247,
    "text": "“你真幸运 ”告别时她道"
  },
  {
    "start": 1419.247,
    "end": 1422.791,
    "text": "一扇扇门为你打开 这是怎么回事"
  },
  {
    "start": 1422.791,
    "end": 1424.666,
    "text": "难道你施了法术"
  },
  {
    "start": 1424.914,
    "end": 1428.026,
    "text": "悉达多道： 昨天我已告诉你"
  },
  {
    "start": 1428.026,
    "end": 1430.42,
    "text": "我会思考、等待、斋戒"
  },
  {
    "start": 1430.42,
    "end": 1432.814,
    "text": "你却认为这些没用"
  },
  {
    "start": 1432.814,
    "end": 1437.355,
    "text": "其实它们很有用 迦摩罗 你会看到的"
  },
  {
    "start": 1437.355,
    "end": 1438.073,
    "text": "你将看到"
  },
  {
    "start": 1438.073,
    "end": 1440.512,
    "text": "林中愚笨的沙门将学会并"
  },
  {
    "start": 1440.512,
    "end": 1446.277,
    "text": "做出许多旁人不会的漂亮事情前天我还是蓬头垢面的乞丐"
  },
  {
    "start": 1446.277,
    "end": 1449.338,
    "text": "昨天我就亲吻了迦摩罗 而很快"
  },
  {
    "start": 1449.338,
    "end": 1450.97,
    "text": "我会成为一名商人"
  },
  {
    "start": 1450.97,
    "end": 1454.236,
    "text": "拥有财富和一切你看重的东西"
  },
  {
    "start": 1454.484,
    "end": 1456.698,
    "text": "“好吧 ”她表示赞同"
  },
  {
    "start": 1456.698,
    "end": 1458.913,
    "text": "但如果没有我又会怎样"
  },
  {
    "start": 1458.913,
    "end": 1461.933,
    "text": "如果我不帮助你 又会怎样"
  },
  {
    "start": 1462.181,
    "end": 1463.671,
    "text": "亲爱的迦摩罗"
  },
  {
    "start": 1463.671,
    "end": 1465.8,
    "text": "悉达多说着挺直腰身"
  },
  {
    "start": 1465.8,
    "end": 1469.42,
    "text": "来到你的林苑是我迈出的第一步"
  },
  {
    "start": 1469.42,
    "end": 1476.144,
    "text": "我决心跟你这个美丽的女人学习爱的艺术那一刻 我下定决心并知道"
  },
  {
    "start": 1476.144,
    "end": 1479.19,
    "text": "我必定会实现愿望 我也知道"
  },
  {
    "start": 1479.19,
    "end": 1482.018,
    "text": "你会帮助我 当我站在林苑外"
  },
  {
    "start": 1482.018,
    "end": 1484.202,
    "text": "第一眼见到你时我就知道"
  },
  {
    "start": 1484.45,
    "end": 1486.309,
    "text": "“如果我不愿意呢 ”"
  },
  {
    "start": 1486.557,
    "end": 1489.92,
    "text": "你会愿意的 你看 迦摩罗"
  },
  {
    "start": 1489.92,
    "end": 1492.386,
    "text": "如果你将一粒石子投入水中"
  },
  {
    "start": 1492.386,
    "end": 1495.401,
    "text": "石子会沿着最短的路径沉入水底"
  },
  {
    "start": 1495.401,
    "end": 1498.416,
    "text": "恰如悉达多有了目标并下定决心"
  },
  {
    "start": 1498.416,
    "end": 1500.57,
    "text": "悉达多什么都不做"
  },
  {
    "start": 1500.57,
    "end": 1502.961,
    "text": "他等待、思考、斋戒"
  },
  {
    "start": 1502.961,
    "end": 1505.883,
    "text": "他穿行于尘世万物间正如"
  },
  {
    "start": 1505.883,
    "end": 1510.664,
    "text": "石子飞入水底——不必费力无需挣扎"
  },
  {
    "start": 1510.664,
    "end": 1514.66,
    "text": "他自会被指引 他任凭自己沉落"
  },
  {
    "start": 1514.66,
    "end": 1516.258,
    "text": "目标会指引他"
  },
  {
    "start": 1516.258,
    "end": 1518.158,
    "text": "因为他禁止任何干扰"
  },
  {
    "start": 1518.158,
    "end": 1523.222,
    "text": "目标的事情进入他的灵魂这是悉达多做沙门时学到的"
  },
  {
    "start": 1523.222,
    "end": 1525.15,
    "text": "愚人们称其为魔法"
  },
  {
    "start": 1525.15,
    "end": 1528.523,
    "text": "愚人以为此乃魔鬼所为 其实"
  },
  {
    "start": 1528.523,
    "end": 1531.896,
    "text": "魔鬼无所作为 魔鬼并不存在"
  },
  {
    "start": 1531.896,
    "end": 1533.723,
    "text": "每个人都能施展法术"
  },
  {
    "start": 1533.723,
    "end": 1535.549,
    "text": "每个人都能实现目标"
  },
  {
    "start": 1535.549,
    "end": 1538.796,
    "text": "如果他会思考、等待、斋戒"
  },
  {
    "start": 1539.043,
    "end": 1542.193,
    "text": "迦摩罗倾听着 她爱他的声音"
  },
  {
    "start": 1542.193,
    "end": 1543.317,
    "text": "爱他的目光"
  },
  {
    "start": 1543.565,
    "end": 1547.682,
    "text": "“或许是的 ”她轻声道 “如你所说"
  },
  {
    "start": 1547.682,
    "end": 1551.365,
    "text": "朋友 也或许因为悉达多是个俊美的男子"
  },
  {
    "start": 1551.365,
    "end": 1554.874,
    "text": "女人们喜爱他的目光 他才好运连连"
  },
  {
    "start": 1555.122,
    "end": 1558.39,
    "text": "悉达多和她吻别  但愿如此"
  },
  {
    "start": 1558.39,
    "end": 1562.126,
    "text": "我的老师 愿我的目光永远让你欢喜"
  },
  {
    "start": 1562.126,
    "end": 1565.36,
    "text": "愿我的好运一直因你而降临"
  }
]