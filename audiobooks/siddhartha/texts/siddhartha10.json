[
  {
    "start": 0.0,
    "end": 1.689,
    "text": "第10章 儿子"
  },
  {
    "start": 1.937,
    "end": 6.059,
    "text": "孩子哭着 瑟缩着出席了母亲的葬礼"
  },
  {
    "start": 6.059,
    "end": 10.181,
    "text": "又阴郁着 怯生生地听悉达多唤他儿子"
  },
  {
    "start": 10.181,
    "end": 12.932,
    "text": "欢迎他留在瓦稣迪瓦的茅舍"
  },
  {
    "start": 12.932,
    "end": 16.372,
    "text": "他面色苍白 整日坐在母亲坟旁"
  },
  {
    "start": 16.372,
    "end": 18.665,
    "text": "不吃不喝 目光呆滞"
  },
  {
    "start": 18.665,
    "end": 21.549,
    "text": "心扉紧锁着抗拒命运"
  },
  {
    "start": 21.797,
    "end": 26.008,
    "text": "悉达多疼惜他 由着他 尊重他的悲伤"
  },
  {
    "start": 26.008,
    "end": 28.446,
    "text": "悉达多理解 儿子跟他不熟"
  },
  {
    "start": 28.446,
    "end": 31.989,
    "text": "不能像爱父亲那样爱他 渐渐地"
  },
  {
    "start": 31.989,
    "end": 36.005,
    "text": "他发觉这个十一岁的孩子已被母亲宠坏"
  },
  {
    "start": 36.005,
    "end": 38.441,
    "text": "他在富有的环境中长大"
  },
  {
    "start": 38.441,
    "end": 41.608,
    "text": "习惯了美食、软床、使唤仆从"
  },
  {
    "start": 41.608,
    "end": 43.314,
    "text": "悉达多明白"
  },
  {
    "start": 43.314,
    "end": 45.969,
    "text": "一个悲伤又骄恣的孩子不会"
  },
  {
    "start": 45.969,
    "end": 51.723,
    "text": "突然甘心待在陌生贫穷的地方他不强迫他 而是为他做事"
  },
  {
    "start": 51.723,
    "end": 53.294,
    "text": "把最好的留给他"
  },
  {
    "start": 53.294,
    "end": 57.332,
    "text": "他希望善意的忍耐能慢慢赢得孩子的心"
  },
  {
    "start": 57.58,
    "end": 61.514,
    "text": "孩子来时 他曾说自己富足而幸福"
  },
  {
    "start": 61.514,
    "end": 65.939,
    "text": "日子一天天过去 孩子却仍旧自负而心硬"
  },
  {
    "start": 65.939,
    "end": 70.099,
    "text": "对他冷漠疏远 不愿劳作 冒犯长辈"
  },
  {
    "start": 70.099,
    "end": 74.028,
    "text": "偷摘瓦稣迪瓦的果子 悉达多开始意识到"
  },
  {
    "start": 74.028,
    "end": 76.515,
    "text": "孩子带来的不是幸福安宁"
  },
  {
    "start": 76.515,
    "end": 79.454,
    "text": "而是痛苦忧虑 可是他爱他"
  },
  {
    "start": 79.454,
    "end": 82.167,
    "text": "宁愿忍受爱的痛苦和忧虑"
  },
  {
    "start": 82.167,
    "end": 85.601,
    "text": "也不愿接受没有他的幸福和快乐"
  },
  {
    "start": 85.849,
    "end": 87.78,
    "text": "小悉达多住进茅舍后"
  },
  {
    "start": 87.78,
    "end": 89.496,
    "text": "两位老人就分了工"
  },
  {
    "start": 89.496,
    "end": 92.713,
    "text": "瓦稣迪瓦独自承担渡口的工作"
  },
  {
    "start": 92.713,
    "end": 96.947,
    "text": "悉达多则和儿子忙于茅舍和田间活计"
  },
  {
    "start": 97.195,
    "end": 98.212,
    "text": "几个月来"
  },
  {
    "start": 98.212,
    "end": 101.518,
    "text": "悉达多一直期待儿子能理解他"
  },
  {
    "start": 101.518,
    "end": 106.094,
    "text": "接受他的爱 甚至对他的爱有所回应"
  },
  {
    "start": 106.094,
    "end": 110.482,
    "text": "几个月来 瓦稣迪瓦也默默观望 期待"
  },
  {
    "start": 110.482,
    "end": 113.484,
    "text": "一天 小悉达多又折磨父亲"
  },
  {
    "start": 113.484,
    "end": 114.638,
    "text": "对他任性不逊"
  },
  {
    "start": 114.638,
    "end": 117.227,
    "text": "还打碎两个饭碗 当晚"
  },
  {
    "start": 117.227,
    "end": 120.992,
    "text": "瓦稣迪瓦把朋友叫到一边 同他交谈"
  },
  {
    "start": 121.24,
    "end": 124.994,
    "text": "“原谅我 ”他道 “出于善意"
  },
  {
    "start": 124.994,
    "end": 128.747,
    "text": "我得和你谈谈 我看到你折磨自己"
  },
  {
    "start": 128.747,
    "end": 130.389,
    "text": "你很苦恼 亲爱的"
  },
  {
    "start": 130.389,
    "end": 133.622,
    "text": "你的儿子让你担忧 我也担忧他"
  },
  {
    "start": 133.622,
    "end": 137.501,
    "text": "这只小鸟在另一个巢穴过惯了另一种生活"
  },
  {
    "start": 137.501,
    "end": 138.579,
    "text": "他不像你"
  },
  {
    "start": 138.579,
    "end": 142.609,
    "text": "出于憎恶和厌倦逃离城邑和富裕的生活"
  },
  {
    "start": 142.609,
    "end": 146.402,
    "text": "他是违背意愿 不得不放弃那一切"
  },
  {
    "start": 146.402,
    "end": 147.588,
    "text": "我问河水"
  },
  {
    "start": 147.588,
    "end": 151.37,
    "text": "哦 朋友 我多次求问河水"
  },
  {
    "start": 151.37,
    "end": 155.422,
    "text": "可河水只报以嘲笑 它笑我 也笑你"
  },
  {
    "start": 155.422,
    "end": 159.885,
    "text": "它颤抖着嘲笑我们的愚蠢 水归于水"
  },
  {
    "start": 159.885,
    "end": 161.986,
    "text": "年轻人归于年轻人"
  },
  {
    "start": 161.986,
    "end": 164.652,
    "text": "你儿子待在一个让他不快的地方"
  },
  {
    "start": 164.652,
    "end": 167.89,
    "text": "你也问河水 听取河水的意见吧"
  },
  {
    "start": 168.138,
    "end": 171.455,
    "text": "悉达多苦闷地望着他可亲的脸"
  },
  {
    "start": 171.455,
    "end": 175.282,
    "text": "这张脸上细密的皱纹间驻满喜乐"
  },
  {
    "start": 175.53,
    "end": 179.534,
    "text": "悉达多羞愧地轻声道  我怎能和他分开"
  },
  {
    "start": 179.782,
    "end": 182.896,
    "text": "亲爱的 给我些时间 你看"
  },
  {
    "start": 182.896,
    "end": 186.234,
    "text": "我正努力以爱和善意的忍耐争取他"
  },
  {
    "start": 186.234,
    "end": 187.346,
    "text": "赢得他的心"
  },
  {
    "start": 187.594,
    "end": 191.488,
    "text": "河水也将跟他交谈 他也是奉召而来"
  },
  {
    "start": 191.736,
    "end": 195.462,
    "text": "瓦稣迪瓦的笑容愈加温和  是的"
  },
  {
    "start": 195.462,
    "end": 199.421,
    "text": "他也奉召而来 他也来自永恒的生命"
  },
  {
    "start": 199.421,
    "end": 200.585,
    "text": "可是你和我"
  },
  {
    "start": 200.585,
    "end": 204.622,
    "text": "我们知道他为何奉召而来 走什么路"
  },
  {
    "start": 204.622,
    "end": 208.659,
    "text": "做什么事 受什么苦 他受的苦不会少"
  },
  {
    "start": 208.659,
    "end": 212.847,
    "text": "心硬又傲慢的人会受很多苦 会迷路"
  },
  {
    "start": 212.847,
    "end": 216.788,
    "text": "会做错事 会担许多罪孽 我亲爱的"
  },
  {
    "start": 216.788,
    "end": 220.552,
    "text": "告诉我：你不教育你的儿子 不强迫他"
  },
  {
    "start": 220.552,
    "end": 222.852,
    "text": "不打他 不责罚他吗"
  },
  {
    "start": 223.1,
    "end": 225.789,
    "text": "“不 瓦稣迪瓦 这些我不做 ”"
  },
  {
    "start": 226.037,
    "end": 230.049,
    "text": "我知道 你不强迫他 不打他"
  },
  {
    "start": 230.049,
    "end": 233.81,
    "text": "不控制他 因为你知道柔胜于刚"
  },
  {
    "start": 233.81,
    "end": 235.816,
    "text": "水胜于石 爱胜于暴"
  },
  {
    "start": 235.816,
    "end": 237.809,
    "text": "很好 我赞赏你"
  },
  {
    "start": 237.809,
    "end": 240.549,
    "text": "可你不强迫不责罚的主张"
  },
  {
    "start": 240.549,
    "end": 242.541,
    "text": "难道不是一种过失"
  },
  {
    "start": 242.541,
    "end": 245.53,
    "text": "难道你没有用爱束缚他"
  },
  {
    "start": 245.53,
    "end": 249.388,
    "text": "没有每天用善和忍 令他羞愧为难"
  },
  {
    "start": 249.388,
    "end": 253.004,
    "text": "你难道没有强迫这自大放肆的孩子"
  },
  {
    "start": 253.004,
    "end": 256.823,
    "text": "同两个视米为佳肴的老家伙住在茅舍里"
  },
  {
    "start": 256.823,
    "end": 259.968,
    "text": "老人的思想可不会与孩子相同"
  },
  {
    "start": 259.968,
    "end": 261.765,
    "text": "他们心境苍老平静"
  },
  {
    "start": 261.765,
    "end": 263.786,
    "text": "连步态都跟孩子不同"
  },
  {
    "start": 263.786,
    "end": 268.278,
    "text": "难道这一切不是对孩子的强迫和惩罚"
  },
  {
    "start": 268.525,
    "end": 270.188,
    "text": "悉达多错愕地垂下头"
  },
  {
    "start": 270.188,
    "end": 272.96,
    "text": "轻声问：“你说我该怎么办 ”"
  },
  {
    "start": 273.207,
    "end": 275.969,
    "text": "瓦稣迪瓦道： 送他回城里"
  },
  {
    "start": 275.969,
    "end": 279.881,
    "text": "回他母亲的宅邸 把他交给宅中仆从"
  },
  {
    "start": 279.881,
    "end": 281.722,
    "text": "如果那里已无人"
  },
  {
    "start": 281.722,
    "end": 285.404,
    "text": "就带他去找个老师 不是为学知识"
  },
  {
    "start": 285.404,
    "end": 289.316,
    "text": "而是为让他回到孩子中 回到他的世界"
  },
  {
    "start": 289.316,
    "end": 291.325,
    "text": "这些你难道没想过"
  },
  {
    "start": 291.573,
    "end": 295.309,
    "text": "“你看透了我的心 ”悉达多凄然道"
  },
  {
    "start": 295.309,
    "end": 297.947,
    "text": "我常有此想法 可是你看"
  },
  {
    "start": 297.947,
    "end": 305.496,
    "text": "我怎能把这个心硬的孩子送到那个世界去难道他不会放肆地沉迷于享乐和权力"
  },
  {
    "start": 305.496,
    "end": 307.643,
    "text": "不会重复他父亲的过失"
  },
  {
    "start": 307.643,
    "end": 310.65,
    "text": "不会完全迷失于轮回之中"
  },
  {
    "start": 310.898,
    "end": 312.298,
    "text": "船夫绽放笑容"
  },
  {
    "start": 312.298,
    "end": 316.032,
    "text": "他温柔地抚摩悉达多的臂膀： 朋友"
  },
  {
    "start": 316.032,
    "end": 319.532,
    "text": "去问河水吧 你听 它在发笑"
  },
  {
    "start": 319.532,
    "end": 322.153,
    "text": "你果真相信 你的蠢行"
  },
  {
    "start": 322.153,
    "end": 323.82,
    "text": "能免除他的蠢行"
  },
  {
    "start": 323.82,
    "end": 327.156,
    "text": "难道你通过教育、祈祷和劝诫"
  },
  {
    "start": 327.156,
    "end": 330.156,
    "text": "能保他免于轮回 亲爱的"
  },
  {
    "start": 330.156,
    "end": 332.905,
    "text": "你曾对我讲过引人深思的"
  },
  {
    "start": 332.905,
    "end": 335.655,
    "text": "婆罗门之子悉达多的故事"
  },
  {
    "start": 335.655,
    "end": 337.502,
    "text": "难道你完全忘记了"
  },
  {
    "start": 337.502,
    "end": 339.579,
    "text": "是谁保护沙门悉达多"
  },
  {
    "start": 339.579,
    "end": 343.964,
    "text": "免于罪孽、贪婪和愚昧是他父亲的虔诚"
  },
  {
    "start": 343.964,
    "end": 348.281,
    "text": "老师的规劝 还是他自己的学识和求索"
  },
  {
    "start": 348.281,
    "end": 352.358,
    "text": "人独自行过生命 蒙受玷污 承担罪过"
  },
  {
    "start": 352.358,
    "end": 354.846,
    "text": "痛饮苦酒 寻觅出路"
  },
  {
    "start": 354.846,
    "end": 358.577,
    "text": "难道有人曾被父亲或老师一路庇护"
  },
  {
    "start": 358.577,
    "end": 359.572,
    "text": "亲爱的"
  },
  {
    "start": 359.572,
    "end": 362.17,
    "text": "你相信有人能避开这道路"
  },
  {
    "start": 362.17,
    "end": 365.476,
    "text": "或许小悉达多能 因为你爱他"
  },
  {
    "start": 365.476,
    "end": 368.546,
    "text": "你愿意保他免于苦难和失望"
  },
  {
    "start": 368.546,
    "end": 370.659,
    "text": "但是就算你替他舍命十次"
  },
  {
    "start": 370.659,
    "end": 374.115,
    "text": "恐怕也不能扭转他命运的一丝一毫"
  },
  {
    "start": 374.363,
    "end": 376.986,
    "text": "瓦稣迪瓦从未说过这么多话"
  },
  {
    "start": 376.986,
    "end": 380.702,
    "text": "悉达多诚挚道谢后 忧虑着步入茅舍"
  },
  {
    "start": 380.702,
    "end": 382.232,
    "text": "久久无法入睡"
  },
  {
    "start": 382.232,
    "end": 386.467,
    "text": "瓦稣迪瓦的话他明白 且都曾思量过"
  },
  {
    "start": 386.467,
    "end": 389.457,
    "text": "但那只是认知 他无法行动"
  },
  {
    "start": 389.457,
    "end": 393.514,
    "text": "因为比认知更强烈的是他对孩子的爱"
  },
  {
    "start": 393.514,
    "end": 397.317,
    "text": "他的柔情 他对失去孩子的恐惧"
  },
  {
    "start": 397.317,
    "end": 399.346,
    "text": "他何曾如此迷失"
  },
  {
    "start": 399.346,
    "end": 401.457,
    "text": "何曾如此盲目、痛苦"
  },
  {
    "start": 401.457,
    "end": 405.21,
    "text": "何曾如此绝望又幸福地爱过一个人"
  },
  {
    "start": 405.458,
    "end": 408.356,
    "text": "悉达多无法接受朋友的忠告"
  },
  {
    "start": 408.356,
    "end": 412.22,
    "text": "他无法送走儿子 他任由他命令他"
  },
  {
    "start": 412.22,
    "end": 414.877,
    "text": "轻视他 他沉默 等待"
  },
  {
    "start": 414.877,
    "end": 416.99,
    "text": "每日在内心默默发动"
  },
  {
    "start": 416.99,
    "end": 423.566,
    "text": "善意和忍耐的无声之战瓦稣迪瓦也宽容体谅地沉默着 等待着"
  },
  {
    "start": 423.566,
    "end": 426.675,
    "text": "在隐忍方面 他俩都堪称大师"
  },
  {
    "start": 426.923,
    "end": 427.353,
    "text": "一次"
  },
  {
    "start": 427.353,
    "end": 431.007,
    "text": "悉达多在孩子脸上看见迦摩罗的影子"
  },
  {
    "start": 431.007,
    "end": 433.641,
    "text": "他不禁突然记起年轻时迦摩"
  },
  {
    "start": 433.641,
    "end": 438.691,
    "text": "罗曾对他说过：“你不会爱”他赞同她的话 那时"
  },
  {
    "start": 438.691,
    "end": 440.582,
    "text": "他把自己比作孤星"
  },
  {
    "start": 440.582,
    "end": 443.182,
    "text": "把孩童般的世人比作落叶"
  },
  {
    "start": 443.182,
    "end": 447.2,
    "text": "尽管他在她的话中听到责备 的确"
  },
  {
    "start": 447.2,
    "end": 449.737,
    "text": "他从未忘形地热恋一个人"
  },
  {
    "start": 449.737,
    "end": 452.965,
    "text": "从未全然忘我地去为了爱做蠢事"
  },
  {
    "start": 452.965,
    "end": 454.579,
    "text": "他从未爱过"
  },
  {
    "start": 454.579,
    "end": 460.273,
    "text": "他认为这是他与孩童般的世人的根本区别可是自从儿子出现"
  },
  {
    "start": 460.273,
    "end": 464.71,
    "text": "他悉达多却成了完全的世人 苦恋着"
  },
  {
    "start": 464.71,
    "end": 469.407,
    "text": "在爱中迷失 因为爱 而成为愚人 而今"
  },
  {
    "start": 469.407,
    "end": 471.606,
    "text": "他感受到生命中这迟"
  },
  {
    "start": 471.606,
    "end": 478.691,
    "text": "来的强烈而奇异的激情遭苦难 受折磨 却充满喜悦 获得新生"
  },
  {
    "start": 478.691,
    "end": 480.03,
    "text": "变得富足"
  },
  {
    "start": 480.278,
    "end": 483.979,
    "text": "他切实感到 对儿子盲目的爱"
  },
  {
    "start": 483.979,
    "end": 486.622,
    "text": "是一种极为人性的激情"
  },
  {
    "start": 486.622,
    "end": 490.322,
    "text": "它或许就是轮回 是浑沌之泉"
  },
  {
    "start": 490.322,
    "end": 493.249,
    "text": "黑暗之水 同时他也感到"
  },
  {
    "start": 493.249,
    "end": 496.662,
    "text": "爱并非毫无价值 它源自天性"
  },
  {
    "start": 496.662,
    "end": 497.882,
    "text": "是一种必需"
  },
  {
    "start": 497.882,
    "end": 502.936,
    "text": "爱的欲望该得到哺育 痛苦该去品尝"
  },
  {
    "start": 502.936,
    "end": 504.721,
    "text": "蠢行该去实践"
  },
  {
    "start": 504.968,
    "end": 507.37,
    "text": "儿子最近让他做尽蠢事"
  },
  {
    "start": 507.37,
    "end": 509.051,
    "text": "他让他低三下四"
  },
  {
    "start": 509.051,
    "end": 512.413,
    "text": "他的放肆让他每日受尽屈辱"
  },
  {
    "start": 512.413,
    "end": 514.79,
    "text": "这个父亲既不会取悦儿子"
  },
  {
    "start": 514.79,
    "end": 516.519,
    "text": "也无法让儿子敬畏"
  },
  {
    "start": 516.519,
    "end": 519.977,
    "text": "他是个善良、仁慈而温和的好人"
  },
  {
    "start": 519.977,
    "end": 521.398,
    "text": "或许还很虔诚"
  },
  {
    "start": 521.398,
    "end": 523.529,
    "text": "是个圣人——可这些"
  },
  {
    "start": 523.529,
    "end": 528.976,
    "text": "德性不能赢得孩子的心这位父亲让儿子感到无聊"
  },
  {
    "start": 528.976,
    "end": 531.605,
    "text": "他把他困在这破败的茅舍里"
  },
  {
    "start": 531.605,
    "end": 535.55,
    "text": "让他感到烦闷 他对他的无礼报以微笑"
  },
  {
    "start": 535.55,
    "end": 537.706,
    "text": "对他的辱骂报以友善"
  },
  {
    "start": 537.706,
    "end": 539.862,
    "text": "对他的恶毒报以宽容"
  },
  {
    "start": 539.862,
    "end": 544.174,
    "text": "这难道不是这个老伪君子可恶的诡计"
  },
  {
    "start": 544.174,
    "end": 547.053,
    "text": "他宁愿他恐吓他 虐待他"
  },
  {
    "start": 547.301,
    "end": 549.846,
    "text": "这天 小悉达多爆发了"
  },
  {
    "start": 549.846,
    "end": 553.549,
    "text": "他公然反对父亲 父亲派他去捡柴"
  },
  {
    "start": 553.549,
    "end": 555.4,
    "text": "他却不肯踏出茅舍"
  },
  {
    "start": 555.4,
    "end": 558.897,
    "text": "他傲慢恼怒地站着 用力踏地"
  },
  {
    "start": 558.897,
    "end": 562.894,
    "text": "紧攥拳头 仇视而轻蔑地朝父亲吼叫"
  },
  {
    "start": 563.142,
    "end": 566.563,
    "text": "“你自己去捡柴吧 ”他大发雷霆"
  },
  {
    "start": 566.563,
    "end": 570.412,
    "text": "我不是你的奴仆 我知道你不会打我"
  },
  {
    "start": 570.412,
    "end": 571.481,
    "text": "你根本不敢"
  },
  {
    "start": 571.481,
    "end": 575.496,
    "text": "我知道你要用你的虔诚和宽容来惩罚我"
  },
  {
    "start": 575.496,
    "end": 576.204,
    "text": "羞辱我"
  },
  {
    "start": 576.204,
    "end": 580.455,
    "text": "你希望我像你一样虔敬、温顺、明智"
  },
  {
    "start": 580.455,
    "end": 584.11,
    "text": "可是我 你听着 我要让你痛苦"
  },
  {
    "start": 584.11,
    "end": 587.308,
    "text": "我宁愿做扒手、杀人犯、下地狱"
  },
  {
    "start": 587.308,
    "end": 589.364,
    "text": "也不愿做你 我恨你"
  },
  {
    "start": 589.364,
    "end": 590.658,
    "text": "你不是我父亲"
  },
  {
    "start": 590.658,
    "end": 594.108,
    "text": "哪怕你做过我母亲十次的姘夫"
  },
  {
    "start": 594.356,
    "end": 598.85,
    "text": "他愤怒又悲伤 粗野又恶毒地咒骂父亲"
  },
  {
    "start": 598.85,
    "end": 601.845,
    "text": "之后夺门而去 深夜才回来"
  },
  {
    "start": 602.093,
    "end": 604.458,
    "text": "次日一早 他不见了"
  },
  {
    "start": 604.458,
    "end": 607.059,
    "text": "随之无踪的还有小船和盛"
  },
  {
    "start": 607.059,
    "end": 610.132,
    "text": "放船钱的树皮编织的双色篮篓"
  },
  {
    "start": 610.132,
    "end": 612.19,
    "text": "里面有些铜板和银币"
  },
  {
    "start": 612.19,
    "end": 616.306,
    "text": "悉达多发现小船泊在对岸 孩子已逃走"
  },
  {
    "start": 616.554,
    "end": 619.448,
    "text": "“我得去追他 ”悉达多道"
  },
  {
    "start": 619.448,
    "end": 623.008,
    "text": "尽管他因孩子昨天的辱骂悲痛得发抖"
  },
  {
    "start": 623.008,
    "end": 626.148,
    "text": "一个孩子根本无法独自穿过森林"
  },
  {
    "start": 626.148,
    "end": 628.241,
    "text": "他会丧命 瓦稣迪瓦"
  },
  {
    "start": 628.241,
    "end": 630.753,
    "text": "我们得扎个竹筏过河"
  },
  {
    "start": 631.0,
    "end": 634.286,
    "text": "“我们扎个竹筏吧 ”瓦稣迪瓦道"
  },
  {
    "start": 634.286,
    "end": 637.778,
    "text": "也好把孩子带走的船取回 可是他"
  },
  {
    "start": 637.778,
    "end": 638.805,
    "text": "你该放他走"
  },
  {
    "start": 638.805,
    "end": 642.862,
    "text": "朋友 他不再是孩子了 他会保护自己"
  },
  {
    "start": 642.862,
    "end": 646.705,
    "text": "他要回城里 他做得对 别忘了这点"
  },
  {
    "start": 646.705,
    "end": 646.919,
    "text": "他做的"
  },
  {
    "start": 646.919,
    "end": 650.652,
    "text": "正是你耽搁的事 他设法走自己的路"
  },
  {
    "start": 650.652,
    "end": 651.969,
    "text": "啊 悉达多"
  },
  {
    "start": 651.969,
    "end": 655.483,
    "text": "我看见你在承受被人付之一笑的痛苦"
  },
  {
    "start": 655.483,
    "end": 658.482,
    "text": "不久 你也会嘲笑自己的痛苦"
  },
  {
    "start": 658.482,
    "end": 660.196,
    "text": "悉达多并未作答"
  },
  {
    "start": 660.196,
    "end": 662.767,
    "text": "他已拿起斧子开始扎竹筏"
  },
  {
    "start": 662.767,
    "end": 665.81,
    "text": "瓦稣迪瓦帮他用草绳捆扎竹筏"
  },
  {
    "start": 665.81,
    "end": 667.683,
    "text": "之后他们划向对岸"
  },
  {
    "start": 667.683,
    "end": 670.961,
    "text": "筏子被河水远远地冲向下游"
  },
  {
    "start": 670.961,
    "end": 674.275,
    "text": "他们奋力逆流而进 终于抵达对岸"
  },
  {
    "start": 674.523,
    "end": 677.222,
    "text": "“你为何带着斧子 ”悉达多问"
  },
  {
    "start": 677.47,
    "end": 679.929,
    "text": "我们的船桨可能已经丢失"
  },
  {
    "start": 679.929,
    "end": 681.364,
    "text": "瓦稣迪瓦答"
  },
  {
    "start": 681.612,
    "end": 685.055,
    "text": "悉达多清楚朋友的想法 他想"
  },
  {
    "start": 685.055,
    "end": 688.498,
    "text": "孩子为报复 为阻止他们追赶"
  },
  {
    "start": 688.498,
    "end": 690.711,
    "text": "会将船桨扔掉或损坏"
  },
  {
    "start": 690.711,
    "end": 693.161,
    "text": "果然 船里没有船桨"
  },
  {
    "start": 693.161,
    "end": 696.835,
    "text": "瓦稣迪瓦指着船底 微笑望着朋友"
  },
  {
    "start": 696.835,
    "end": 700.323,
    "text": "似乎在说： 难道你没看出他的意思"
  },
  {
    "start": 700.323,
    "end": 703.157,
    "text": "难道你没看出他不愿被人跟随"
  },
  {
    "start": 703.157,
    "end": 705.119,
    "text": "可他并未说出"
  },
  {
    "start": 705.119,
    "end": 707.388,
    "text": "他开始动手制作新船桨"
  },
  {
    "start": 707.388,
    "end": 711.471,
    "text": "悉达多则同他道别 去寻找逃跑的孩子"
  },
  {
    "start": 711.471,
    "end": 713.513,
    "text": "瓦稣迪瓦没有阻拦"
  },
  {
    "start": 713.761,
    "end": 716.051,
    "text": "悉达多在林中走了很久"
  },
  {
    "start": 716.051,
    "end": 718.342,
    "text": "他意识到寻找毫无意义"
  },
  {
    "start": 718.342,
    "end": 722.235,
    "text": "儿子要么早已走出森林 抵达城里"
  },
  {
    "start": 722.235,
    "end": 725.96,
    "text": "要么还在路上 但他若见有人跟踪"
  },
  {
    "start": 725.96,
    "end": 728.754,
    "text": "定会躲藏起来 他继续思考"
  },
  {
    "start": 728.754,
    "end": 732.581,
    "text": "发觉自己并不为儿子担心 他心里清楚"
  },
  {
    "start": 732.581,
    "end": 736.408,
    "text": "儿子既不会丧命 也不会在林里发生意外"
  },
  {
    "start": 736.408,
    "end": 740.494,
    "text": "可他却不能停下脚步 不是为救孩子"
  },
  {
    "start": 740.494,
    "end": 743.377,
    "text": "只为盼着或许还能见上一面"
  },
  {
    "start": 743.377,
    "end": 745.461,
    "text": "他就这样一直走到城里"
  },
  {
    "start": 745.709,
    "end": 747.722,
    "text": "在临近城里的大路上"
  },
  {
    "start": 747.722,
    "end": 749.958,
    "text": "他驻足于那座曾经属于"
  },
  {
    "start": 749.958,
    "end": 753.759,
    "text": "迦摩罗的漂亮花园门口就是在这里"
  },
  {
    "start": 753.759,
    "end": 757.972,
    "text": "他第一次见到轿中的迦摩罗 记忆重现"
  },
  {
    "start": 757.972,
    "end": 761.951,
    "text": "他仿佛看见一位年轻沙门 胡须蓬乱"
  },
  {
    "start": 761.951,
    "end": 762.888,
    "text": "赤身露体"
  },
  {
    "start": 762.888,
    "end": 766.509,
    "text": "头上布满灰尘 悉达多长久驻足"
  },
  {
    "start": 766.509,
    "end": 769.647,
    "text": "透过敞开的门 他朝花园望去"
  },
  {
    "start": 769.647,
    "end": 773.471,
    "text": "见穿僧衣的僧人们在苍翠的树下走动"
  },
  {
    "start": 773.719,
    "end": 775.853,
    "text": "他伫立着 沉思着"
  },
  {
    "start": 775.853,
    "end": 779.173,
    "text": "过去的生活似一幅画卷展现眼前"
  },
  {
    "start": 779.173,
    "end": 782.493,
    "text": "他伫立良久 望着往来的僧人"
  },
  {
    "start": 782.493,
    "end": 784.771,
    "text": "就像望着年轻的自己和"
  },
  {
    "start": 784.771,
    "end": 791.377,
    "text": "迦摩罗漫步于苍翠的树下他清晰地看见他如何受到迦摩罗的款待"
  },
  {
    "start": 791.377,
    "end": 793.569,
    "text": "如何得到她的第一个吻"
  },
  {
    "start": 793.569,
    "end": 797.516,
    "text": "如何自负而轻蔑地回顾他的婆罗门岁月"
  },
  {
    "start": 797.516,
    "end": 801.114,
    "text": "自豪又充满渴望地开始世俗生活"
  },
  {
    "start": 801.114,
    "end": 803.17,
    "text": "他看到迦摩施瓦弥"
  },
  {
    "start": 803.17,
    "end": 807.025,
    "text": "看到仆人、盛宴、赌徒、乐师"
  },
  {
    "start": 807.025,
    "end": 811.415,
    "text": "看到笼中的知更鸟 他似乎坠入轮回"
  },
  {
    "start": 811.415,
    "end": 815.804,
    "text": "再次经历一切 再次衰老、疲惫、恶心"
  },
  {
    "start": 815.804,
    "end": 817.217,
    "text": "再次渴望解脱"
  },
  {
    "start": 817.217,
    "end": 820.513,
    "text": "再次靠神圣的“唵”得到治愈"
  },
  {
    "start": 820.761,
    "end": 824.836,
    "text": "在花园门口长久伫立后 悉达多意识到"
  },
  {
    "start": 824.836,
    "end": 828.91,
    "text": "他进城的渴望是愚蠢的 他不能帮助儿子"
  },
  {
    "start": 828.91,
    "end": 832.745,
    "text": "也不该牵绊他 他深爱着逃走的孩子"
  },
  {
    "start": 832.745,
    "end": 834.549,
    "text": "他的爱像一道伤口"
  },
  {
    "start": 834.549,
    "end": 838.73,
    "text": "他感到伤口的存在不该只为在心中溃烂"
  },
  {
    "start": 838.73,
    "end": 840.943,
    "text": "它应该风化、发光"
  },
  {
    "start": 841.191,
    "end": 844.018,
    "text": "可眼下这伤口尚未风化发光"
  },
  {
    "start": 844.018,
    "end": 847.55,
    "text": "它让他感到忧伤 在这块伤口上"
  },
  {
    "start": 847.55,
    "end": 850.843,
    "text": "去追寻儿子的渴念已消失无踪"
  },
  {
    "start": 850.843,
    "end": 854.894,
    "text": "徒留虚空一片 他忧伤地席地坐下"
  },
  {
    "start": 854.894,
    "end": 858.226,
    "text": "感到内心的一些东西正在死去"
  },
  {
    "start": 858.226,
    "end": 863.096,
    "text": "他感到虚无 看不到快乐 也没有目标"
  },
  {
    "start": 863.096,
    "end": 864.634,
    "text": "他坐下 禅定"
  },
  {
    "start": 864.634,
    "end": 865.146,
    "text": "等待"
  },
  {
    "start": 865.146,
    "end": 868.99,
    "text": "他跟河水学会了等待、忍耐、倾听"
  },
  {
    "start": 868.99,
    "end": 871.553,
    "text": "他坐在尘土中倾听"
  },
  {
    "start": 871.553,
    "end": 874.497,
    "text": "倾听自己疲惫又哀伤的心跳"
  },
  {
    "start": 874.497,
    "end": 878.423,
    "text": "等待某种声音 他倾听了个把钟头"
  },
  {
    "start": 878.423,
    "end": 880.877,
    "text": "再也看不见任何景象"
  },
  {
    "start": 880.877,
    "end": 885.899,
    "text": "听凭自己沉沦 陷入空无 看不到前路"
  },
  {
    "start": 885.899,
    "end": 889.336,
    "text": "当伤口灼痛时 他就无声默诵唵"
  },
  {
    "start": 889.336,
    "end": 891.529,
    "text": "让自己被“唵”充满"
  },
  {
    "start": 891.529,
    "end": 894.452,
    "text": "花园里的僧人见他坐了许久"
  },
  {
    "start": 894.452,
    "end": 897.62,
    "text": "花白的头发上已满是尘土"
  },
  {
    "start": 897.62,
    "end": 901.845,
    "text": "一位僧人过来 在他面前放下两只芭蕉"
  },
  {
    "start": 901.845,
    "end": 903.019,
    "text": "他并未看见"
  },
  {
    "start": 903.267,
    "end": 907.954,
    "text": "恍惚中 一只抚摩他肩头的手将他唤醒"
  },
  {
    "start": 907.954,
    "end": 911.859,
    "text": "他马上认出这种温柔又忠贞的抚慰"
  },
  {
    "start": 911.859,
    "end": 913.161,
    "text": "回过神来"
  },
  {
    "start": 913.161,
    "end": 916.517,
    "text": "他起身 向追来的瓦稣迪瓦问好"
  },
  {
    "start": 916.517,
    "end": 918.979,
    "text": "他望着瓦稣迪瓦可亲的脸"
  },
  {
    "start": 918.979,
    "end": 921.44,
    "text": "细密的皱纹间洋溢的笑"
  },
  {
    "start": 921.44,
    "end": 925.232,
    "text": "望着他明亮的双眼 也跟着微笑起来"
  },
  {
    "start": 925.232,
    "end": 928.356,
    "text": "他看见了面前的芭蕉 拾起来"
  },
  {
    "start": 928.356,
    "end": 929.694,
    "text": "递给船夫一只"
  },
  {
    "start": 929.694,
    "end": 931.811,
    "text": "自己吃一只 之后"
  },
  {
    "start": 931.811,
    "end": 934.869,
    "text": "他跟随瓦稣迪瓦默默穿过森林"
  },
  {
    "start": 934.869,
    "end": 938.868,
    "text": "回到渡口 他们都不提今天发生的事"
  },
  {
    "start": 938.868,
    "end": 942.32,
    "text": "不提孩子的名字 不提他的逃走"
  },
  {
    "start": 942.32,
    "end": 943.931,
    "text": "谁也不触碰伤口"
  },
  {
    "start": 943.931,
    "end": 946.922,
    "text": "悉达多回到茅舍后躺在床上"
  },
  {
    "start": 946.922,
    "end": 949.608,
    "text": "瓦稣迪瓦走来递给他一碗椰汁"
  },
  {
    "start": 949.608,
    "end": 951.261,
    "text": "发现他已经睡着"
  }
]