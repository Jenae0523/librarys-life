[
  {
    "start": 0.0,
    "end": 2.254,
    "text": "第9章 船夫"
  },
  {
    "start": 2.501,
    "end": 5.372,
    "text": "我要留在河边 悉达多想"
  },
  {
    "start": 5.372,
    "end": 8.721,
    "text": "这条河是我当年步入俗世的起点"
  },
  {
    "start": 8.721,
    "end": 11.831,
    "text": "一位友善的船夫曾渡我过河"
  },
  {
    "start": 11.831,
    "end": 14.895,
    "text": "我要去找他 离开他的茅舍后"
  },
  {
    "start": 14.895,
    "end": 18.334,
    "text": "我走向如今业已衰亡的生活——但愿"
  },
  {
    "start": 18.334,
    "end": 21.774,
    "text": "我当下的路和新生活也从他那里起步"
  },
  {
    "start": 22.022,
    "end": 24.569,
    "text": "他温柔地凝视湍急的河水"
  },
  {
    "start": 24.569,
    "end": 26.653,
    "text": "凝视它清澈的碧波和"
  },
  {
    "start": 26.653,
    "end": 29.201,
    "text": "它秘密绘制的晶莹波纹"
  },
  {
    "start": 29.201,
    "end": 31.884,
    "text": "他看见水深处闪耀着珠光"
  },
  {
    "start": 31.884,
    "end": 35.299,
    "text": "平静的气泡嬉戏在如镜的水面上"
  },
  {
    "start": 35.299,
    "end": 37.495,
    "text": "蓝天倒映在水里"
  },
  {
    "start": 37.495,
    "end": 40.288,
    "text": "河水以绿色、白色、透明"
  },
  {
    "start": 40.288,
    "end": 46.129,
    "text": "和湛蓝的万千双眼回视他他多爱这条河 多感激它"
  },
  {
    "start": 46.129,
    "end": 48.132,
    "text": "这条河多令他心醉"
  },
  {
    "start": 48.132,
    "end": 55.393,
    "text": "他听见心中重新苏醒的声音说：爱这条河留在它身边 求教它"
  },
  {
    "start": 55.393,
    "end": 60.214,
    "text": "哦是的 他愿跟随它 倾听它 他知道"
  },
  {
    "start": 60.214,
    "end": 62.143,
    "text": "获悉这条河的秘密"
  },
  {
    "start": 62.143,
    "end": 64.312,
    "text": "就能获悉许多别的秘密"
  },
  {
    "start": 64.312,
    "end": 65.761,
    "text": "所有秘密"
  },
  {
    "start": 66.009,
    "end": 66.486,
    "text": "今天"
  },
  {
    "start": 66.486,
    "end": 68.392,
    "text": "他从河水的秘密中"
  },
  {
    "start": 68.392,
    "end": 75.063,
    "text": "获悉一个撼动灵魂的秘密他看见河水不懈奔流 却总在此处"
  },
  {
    "start": 75.063,
    "end": 78.991,
    "text": "永远是这条河 却时刻更新 哦"
  },
  {
    "start": 78.991,
    "end": 82.427,
    "text": "这谁能领悟 谁又能懂得 他不能"
  },
  {
    "start": 82.427,
    "end": 85.837,
    "text": "他只感到河水激起他遥远的记忆"
  },
  {
    "start": 85.837,
    "end": 87.541,
    "text": "激起神的声音"
  },
  {
    "start": 87.789,
    "end": 91.486,
    "text": "悉达多起身 忍受无以复加的饥饿"
  },
  {
    "start": 91.486,
    "end": 93.103,
    "text": "继续沿河岸踱步"
  },
  {
    "start": 93.103,
    "end": 97.078,
    "text": "他倾听淙淙的水声和体内饥饿的欢叫"
  },
  {
    "start": 97.325,
    "end": 98.576,
    "text": "他来到渡口"
  },
  {
    "start": 98.576,
    "end": 101.577,
    "text": "当年的那条船依旧泊在原处"
  },
  {
    "start": 101.577,
    "end": 105.079,
    "text": "曾摆渡年轻沙门的船夫站在船旁"
  },
  {
    "start": 105.079,
    "end": 106.829,
    "text": "他已苍老"
  },
  {
    "start": 106.829,
    "end": 109.019,
    "text": "但悉达多立刻认出了他"
  },
  {
    "start": 109.266,
    "end": 112.051,
    "text": "“你可愿渡我过河 ”他问"
  },
  {
    "start": 112.298,
    "end": 118.853,
    "text": "船夫惊讶地望着这位独自踱步的华贵之人继而扶他上船 撑船离岸"
  },
  {
    "start": 119.1,
    "end": 122.464,
    "text": "“你选择了一种美好的生活 ”客人道"
  },
  {
    "start": 122.464,
    "end": 123.025,
    "text": "每天"
  },
  {
    "start": 123.025,
    "end": 125.541,
    "text": "生活在岸边 行驶在河面"
  },
  {
    "start": 125.541,
    "end": 127.219,
    "text": "一定十分美好"
  },
  {
    "start": 127.467,
    "end": 131.736,
    "text": "船夫摇橹微笑道： 的确美好 先生"
  },
  {
    "start": 131.736,
    "end": 132.741,
    "text": "如你所云"
  },
  {
    "start": 132.741,
    "end": 134.594,
    "text": "难道不是每种生活、"
  },
  {
    "start": 134.594,
    "end": 136.86,
    "text": "每种劳作都很美好"
  },
  {
    "start": 137.108,
    "end": 139.437,
    "text": "“或许 可我羡慕你的生活 ”"
  },
  {
    "start": 139.685,
    "end": 142.144,
    "text": "啊 你很快会失去兴趣"
  },
  {
    "start": 142.144,
    "end": 145.219,
    "text": "这种生活不适合穿着体面之人"
  },
  {
    "start": 145.467,
    "end": 147.634,
    "text": "悉达多笑道： 今天"
  },
  {
    "start": 147.634,
    "end": 150.764,
    "text": "我已因着装惹人猜疑 船夫"
  },
  {
    "start": 150.764,
    "end": 154.136,
    "text": "你可愿接受我这身累赘的衣服"
  },
  {
    "start": 154.136,
    "end": 156.495,
    "text": "你知道 我没钱支付船费"
  },
  {
    "start": 156.743,
    "end": 158.987,
    "text": "“先生玩笑了 ”船夫笑道"
  },
  {
    "start": 159.235,
    "end": 162.515,
    "text": "我没开玩笑 朋友 你看"
  },
  {
    "start": 162.515,
    "end": 166.264,
    "text": "你曾不计报酬地渡我过河 今天亦如此"
  },
  {
    "start": 166.264,
    "end": 168.283,
    "text": "还是请收下我的衣服"
  },
  {
    "start": 168.531,
    "end": 171.64,
    "text": "“难道先生要不穿衣服继续赶路 ”"
  },
  {
    "start": 171.888,
    "end": 175.575,
    "text": "啊 我倒希望最好不再赶路 船夫"
  },
  {
    "start": 175.575,
    "end": 177.418,
    "text": "你要是给我条旧围裙"
  },
  {
    "start": 177.418,
    "end": 179.467,
    "text": "收我做你的帮手就好了"
  },
  {
    "start": 179.467,
    "end": 182.866,
    "text": "最好做你的学徒 我要先学会撑船"
  },
  {
    "start": 183.114,
    "end": 186.123,
    "text": "船夫狐疑地长久凝视陌生人"
  },
  {
    "start": 186.371,
    "end": 190.887,
    "text": "“我认出你了 ” 终于 他开口道"
  },
  {
    "start": 190.887,
    "end": 194.69,
    "text": "很久以前 二十多年前 我曾渡你过河"
  },
  {
    "start": 194.69,
    "end": 196.383,
    "text": "你在我的茅舍过夜"
  },
  {
    "start": 196.383,
    "end": 198.288,
    "text": "我们曾像好友般道别"
  },
  {
    "start": 198.288,
    "end": 199.981,
    "text": "你那时不是沙门吗"
  },
  {
    "start": 199.981,
    "end": 202.944,
    "text": "我已记不得你的名字"
  },
  {
    "start": 203.192,
    "end": 205.877,
    "text": "我叫悉达多 你初次见我时"
  },
  {
    "start": 205.877,
    "end": 207.411,
    "text": "我的确是沙门"
  },
  {
    "start": 207.659,
    "end": 211.435,
    "text": "悉达多 欢迎你 我叫瓦稣迪瓦"
  },
  {
    "start": 211.435,
    "end": 214.1,
    "text": "我希望你今天仍是我的客人"
  },
  {
    "start": 214.1,
    "end": 215.433,
    "text": "住在我的茅舍"
  },
  {
    "start": 215.433,
    "end": 217.298,
    "text": "跟我讲讲你从哪里来"
  },
  {
    "start": 217.298,
    "end": 219.992,
    "text": "为何你的华服成了累赘"
  },
  {
    "start": 220.24,
    "end": 224.378,
    "text": "他们抵达河中央 瓦稣迪瓦凝视船头"
  },
  {
    "start": 224.378,
    "end": 228.517,
    "text": "沉静地以有力的双臂摇橹 逆流而行"
  },
  {
    "start": 228.517,
    "end": 229.734,
    "text": "悉达多坐着"
  },
  {
    "start": 229.734,
    "end": 233.698,
    "text": "望向他 记起沙门岁月的最后一日"
  },
  {
    "start": 233.698,
    "end": 236.423,
    "text": "他心中曾对船夫升腾敬意"
  },
  {
    "start": 236.423,
    "end": 239.595,
    "text": "他感激地接受了瓦稣迪瓦的邀请"
  },
  {
    "start": 239.595,
    "end": 242.994,
    "text": "靠岸后 他帮船夫将船拴在桩上"
  },
  {
    "start": 242.994,
    "end": 244.807,
    "text": "随船夫步入茅舍"
  },
  {
    "start": 244.807,
    "end": 248.907,
    "text": "船夫端来面包和水 悉达多欢快地吃着"
  },
  {
    "start": 248.907,
    "end": 250.046,
    "text": "也吃了芒果"
  },
  {
    "start": 250.294,
    "end": 253.993,
    "text": "黄昏时 他们坐在岸边一根残株上"
  },
  {
    "start": 253.993,
    "end": 257.923,
    "text": "悉达多向船夫述说起自己的来历和生活"
  },
  {
    "start": 257.923,
    "end": 262.532,
    "text": "述说那些历历在目的绝望时刻 直至夜深"
  },
  {
    "start": 262.78,
    "end": 264.939,
    "text": "瓦稣迪瓦专注地倾听"
  },
  {
    "start": 264.939,
    "end": 268.776,
    "text": "悉达多的出身和童年 苦学与探求"
  },
  {
    "start": 268.776,
    "end": 270.214,
    "text": "欢乐与困顿"
  },
  {
    "start": 270.214,
    "end": 272.596,
    "text": "船夫最大的美德是倾听"
  },
  {
    "start": 272.596,
    "end": 276.883,
    "text": "：他乃少数擅长倾听之人即便默不作声"
  },
  {
    "start": 276.883,
    "end": 279.761,
    "text": "讲述者也能感知他在安静"
  },
  {
    "start": 279.761,
    "end": 286.563,
    "text": "、坦诚、满怀期待地倾听他既不褒扬亦不挑剔 只是倾听"
  },
  {
    "start": 286.563,
    "end": 287.827,
    "text": "悉达多清楚"
  },
  {
    "start": 287.827,
    "end": 291.114,
    "text": "能向这样一位倾听者倾诉自己"
  },
  {
    "start": 291.114,
    "end": 294.907,
    "text": "的生活、渴望与烦忧是何等幸运"
  },
  {
    "start": 295.155,
    "end": 298.281,
    "text": "最后 悉达多讲到河边的树"
  },
  {
    "start": 298.281,
    "end": 300.927,
    "text": "自己的沉沦 神圣的唵"
  },
  {
    "start": 300.927,
    "end": 304.294,
    "text": "讲到他如何在酣眠后爱上这条河"
  },
  {
    "start": 304.294,
    "end": 308.473,
    "text": "这时 船夫闭起双眼 加倍专注地倾听"
  },
  {
    "start": 308.721,
    "end": 310.36,
    "text": "二人长久缄默后"
  },
  {
    "start": 310.36,
    "end": 313.17,
    "text": "瓦稣迪瓦道： 正如我所料"
  },
  {
    "start": 313.17,
    "end": 316.215,
    "text": "河水向你诉说 与你对话"
  },
  {
    "start": 316.215,
    "end": 319.116,
    "text": "它也是你的朋友 这好极了"
  },
  {
    "start": 319.116,
    "end": 322.688,
    "text": "留在这里吧 悉达多 我的朋友"
  },
  {
    "start": 322.688,
    "end": 323.804,
    "text": "我曾有过妻子"
  },
  {
    "start": 323.804,
    "end": 327.727,
    "text": "她的床仍在我的旁边 但她已过世多年"
  },
  {
    "start": 327.727,
    "end": 330.778,
    "text": "我独自生活 你和我一起生活吧"
  },
  {
    "start": 330.778,
    "end": 333.557,
    "text": "吃住对我们来说甚为充裕"
  },
  {
    "start": 333.805,
    "end": 336.488,
    "text": "“我感谢你 ”悉达多道"
  },
  {
    "start": 336.488,
    "end": 340.065,
    "text": "我感谢你并接受你的邀请 此外"
  },
  {
    "start": 340.065,
    "end": 340.959,
    "text": "瓦稣迪瓦"
  },
  {
    "start": 340.959,
    "end": 343.75,
    "text": "我还要感谢你专心听我倾诉"
  },
  {
    "start": 343.75,
    "end": 345.611,
    "text": "懂得倾听之人极少"
  },
  {
    "start": 345.611,
    "end": 349.798,
    "text": "而像你这样懂得倾听的人我尚未见过"
  },
  {
    "start": 349.798,
    "end": 351.367,
    "text": "我需向你求教"
  },
  {
    "start": 351.615,
    "end": 354.578,
    "text": "“你自会学到 ”瓦稣迪瓦道"
  },
  {
    "start": 354.578,
    "end": 357.964,
    "text": "却不是跟我 我跟河水学会倾听"
  },
  {
    "start": 357.964,
    "end": 359.234,
    "text": "你也该跟它学"
  },
  {
    "start": 359.234,
    "end": 363.653,
    "text": "河水无所不知 求教河水你可学会一切"
  },
  {
    "start": 363.653,
    "end": 366.353,
    "text": "你瞧 你已学会足履实地"
  },
  {
    "start": 366.353,
    "end": 369.041,
    "text": "学会沉寂并向深处探寻"
  },
  {
    "start": 369.041,
    "end": 373.342,
    "text": "富有而高贵的悉达多要成为摆渡人"
  },
  {
    "start": 373.342,
    "end": 376.447,
    "text": "博学的婆罗门悉达多要成为船夫"
  },
  {
    "start": 376.447,
    "end": 377.999,
    "text": "这也是河水所示"
  },
  {
    "start": 377.999,
    "end": 381.546,
    "text": "你还会跟河水学会别的东西"
  },
  {
    "start": 381.794,
    "end": 385.206,
    "text": "沉吟片刻后 悉达多道： 别的指什么"
  },
  {
    "start": 385.206,
    "end": 386.343,
    "text": "瓦稣迪瓦"
  },
  {
    "start": 386.591,
    "end": 390.067,
    "text": "瓦稣迪瓦起身 “不早了 ”他道"
  },
  {
    "start": 390.067,
    "end": 391.089,
    "text": "该休息了"
  },
  {
    "start": 391.089,
    "end": 394.155,
    "text": "我无法告诉你‘别的’指什么 哦"
  },
  {
    "start": 394.155,
    "end": 398.398,
    "text": "朋友 你自会学到 或许你已学会"
  },
  {
    "start": 398.398,
    "end": 402.891,
    "text": "你看 我不是导师 不擅言辞和思考"
  },
  {
    "start": 402.891,
    "end": 403.639,
    "text": "我只懂倾听"
  },
  {
    "start": 403.639,
    "end": 406.635,
    "text": "保持驯良 其他我均未学到"
  },
  {
    "start": 406.635,
    "end": 410.321,
    "text": "若我能言善道 或许我会成为智者"
  },
  {
    "start": 410.321,
    "end": 411.934,
    "text": "但我只是个船夫"
  },
  {
    "start": 411.934,
    "end": 413.99,
    "text": "我的任务是渡人过河"
  },
  {
    "start": 413.99,
    "end": 415.817,
    "text": "我渡过千万人过河"
  },
  {
    "start": 415.817,
    "end": 419.473,
    "text": "他们将我的河视作旅途中的障碍"
  },
  {
    "start": 419.473,
    "end": 421.143,
    "text": "他们出门赚钱、"
  },
  {
    "start": 421.143,
    "end": 426.632,
    "text": "做生意、出席婚礼或去进香而这条河挡了他们的路"
  },
  {
    "start": 426.632,
    "end": 429.292,
    "text": "船夫要帮他们迅速渡过障碍"
  },
  {
    "start": 429.292,
    "end": 432.84,
    "text": "对于这些人中为数不多的四五人来说"
  },
  {
    "start": 432.84,
    "end": 434.836,
    "text": "河水却并非障碍"
  },
  {
    "start": 434.836,
    "end": 437.385,
    "text": "他们凝神听水 同我一样"
  },
  {
    "start": 437.385,
    "end": 440.998,
    "text": "河水在他们心中圣化 我们该休息了"
  },
  {
    "start": 440.998,
    "end": 442.06,
    "text": "悉达多"
  },
  {
    "start": 442.308,
    "end": 445.249,
    "text": "悉达多留在船夫处学习摇橹"
  },
  {
    "start": 445.249,
    "end": 446.475,
    "text": "若渡口无事"
  },
  {
    "start": 446.475,
    "end": 451.377,
    "text": "他便跟随瓦稣迪瓦去稻田耕作 去捡木头"
  },
  {
    "start": 451.377,
    "end": 455.694,
    "text": "摘芭蕉 他学制船桨 学补船和编篓"
  },
  {
    "start": 455.694,
    "end": 459.051,
    "text": "无论学什么都兴致盎然 时日如飞"
  },
  {
    "start": 459.051,
    "end": 462.564,
    "text": "他跟河水比跟瓦稣迪瓦学到的更多"
  },
  {
    "start": 462.564,
    "end": 465.375,
    "text": "他永不停歇地向河水求教"
  },
  {
    "start": 465.375,
    "end": 468.579,
    "text": "首要的是学会抛弃激情和期盼"
  },
  {
    "start": 468.579,
    "end": 471.536,
    "text": "不论断、无成见地以寂静的"
  },
  {
    "start": 471.536,
    "end": 474.739,
    "text": "心、侍奉和敞开的灵去倾听"
  },
  {
    "start": 474.987,
    "end": 477.901,
    "text": "他愉快地生活在瓦稣迪瓦身边"
  },
  {
    "start": 477.901,
    "end": 479.694,
    "text": "瓦稣迪瓦不喜多言"
  },
  {
    "start": 479.694,
    "end": 483.281,
    "text": "悉达多很少能激起他交谈的兴致"
  },
  {
    "start": 483.281,
    "end": 486.64,
    "text": "他们只是偶尔交流几句深思熟虑的话"
  },
  {
    "start": 486.888,
    "end": 490.414,
    "text": "“你 ”一天 悉达多问瓦稣迪瓦"
  },
  {
    "start": 490.414,
    "end": 492.696,
    "text": "你也跟河水悟出 时间"
  },
  {
    "start": 492.696,
    "end": 494.977,
    "text": "并不存在 这一秘密吗"
  },
  {
    "start": 495.225,
    "end": 497.739,
    "text": "瓦稣迪瓦现出明朗的微笑"
  },
  {
    "start": 497.987,
    "end": 501.073,
    "text": "“是的 悉达多 ”他道"
  },
  {
    "start": 501.073,
    "end": 503.921,
    "text": "你的意思是 河水无处不在"
  },
  {
    "start": 503.921,
    "end": 507.353,
    "text": "无论在源头、河口、瀑布、船埠"
  },
  {
    "start": 507.353,
    "end": 511.03,
    "text": "还是在湍流中、大海里、山涧中"
  },
  {
    "start": 511.03,
    "end": 513.065,
    "text": "对于河水来说只有当下"
  },
  {
    "start": 513.065,
    "end": 514.693,
    "text": "既没有过去的影子"
  },
  {
    "start": 514.693,
    "end": 517.134,
    "text": "也没有未来的影子"
  },
  {
    "start": 517.382,
    "end": 519.577,
    "text": "“是的 ”悉达多道"
  },
  {
    "start": 519.577,
    "end": 521.772,
    "text": "我领悟到这个道理后"
  },
  {
    "start": 521.772,
    "end": 525.941,
    "text": "认出我的生活也是一条河 这条河用幻象"
  },
  {
    "start": 525.941,
    "end": 526.92,
    "text": "而非现实"
  },
  {
    "start": 526.92,
    "end": 528.878,
    "text": "隔开少年悉达多、"
  },
  {
    "start": 528.878,
    "end": 534.505,
    "text": "成年悉达多和老年悉达多悉达多的前世并非过去"
  },
  {
    "start": 534.505,
    "end": 539.108,
    "text": "死亡和重归梵天亦并非未来 没有过去"
  },
  {
    "start": 539.108,
    "end": 543.2,
    "text": "没有未来 一切都是本质和当下"
  },
  {
    "start": 543.447,
    "end": 545.346,
    "text": "悉达多醉心地讲着"
  },
  {
    "start": 545.346,
    "end": 548.431,
    "text": "这番领悟让他深感幸福 哦"
  },
  {
    "start": 548.431,
    "end": 551.042,
    "text": "难道不是时间令人痛苦"
  },
  {
    "start": 551.042,
    "end": 554.369,
    "text": "难道不是时间折磨人 令人恐惧"
  },
  {
    "start": 554.369,
    "end": 557.031,
    "text": "人一旦战胜时间 放逐时间"
  },
  {
    "start": 557.031,
    "end": 560.547,
    "text": "一切世上的苦难与仇恨不就被战胜"
  },
  {
    "start": 560.547,
    "end": 563.36,
    "text": "被放逐了 他醉心地讲着"
  },
  {
    "start": 563.36,
    "end": 566.231,
    "text": "瓦稣迪瓦则微笑着点头赞许"
  },
  {
    "start": 566.231,
    "end": 570.539,
    "text": "他轻抚悉达多的肩膀 接着去继续劳作"
  },
  {
    "start": 570.787,
    "end": 574.278,
    "text": "又一次 正值雨季 河水暴涨"
  },
  {
    "start": 574.278,
    "end": 577.537,
    "text": "水势凶猛 悉达多问： 朋友"
  },
  {
    "start": 577.537,
    "end": 579.166,
    "text": "河水可有许多声音"
  },
  {
    "start": 579.166,
    "end": 583.012,
    "text": "王的声音、卒的声音、牡牛的声音、"
  },
  {
    "start": 583.012,
    "end": 585.176,
    "text": "夜莺的声音、孕育者"
  },
  {
    "start": 585.176,
    "end": 587.58,
    "text": "的声音、叹息者的声音"
  },
  {
    "start": 587.58,
    "end": 589.479,
    "text": "成千上万的声音"
  },
  {
    "start": 589.727,
    "end": 592.185,
    "text": "“正是 ”瓦稣迪瓦点头道"
  },
  {
    "start": 592.185,
    "end": 595.021,
    "text": "“一切受造者的声音皆在其中 ”"
  },
  {
    "start": 595.269,
    "end": 598.332,
    "text": "“你可知道 ”悉达多继续道"
  },
  {
    "start": 598.332,
    "end": 601.175,
    "text": "当万千声音同时响彻耳畔时"
  },
  {
    "start": 601.175,
    "end": 603.363,
    "text": "它所说的那个字"
  },
  {
    "start": 603.611,
    "end": 606.064,
    "text": "瓦稣迪瓦幸福地微笑着"
  },
  {
    "start": 606.064,
    "end": 610.725,
    "text": "俯身靠近悉达多 在他耳畔说出神圣的唵"
  },
  {
    "start": 610.725,
    "end": 612.844,
    "text": "这也正是悉达多听到的"
  },
  {
    "start": 613.092,
    "end": 616.657,
    "text": "悉达多和瓦稣迪瓦的笑容越来越像"
  },
  {
    "start": 616.657,
    "end": 619.509,
    "text": "他们天真无邪 白发婆娑"
  },
  {
    "start": 619.509,
    "end": 621.886,
    "text": "脸上绽放同样的神采"
  },
  {
    "start": 621.886,
    "end": 625.696,
    "text": "幸福的光华在他们细密的皱纹间盛开"
  },
  {
    "start": 625.696,
    "end": 628.078,
    "text": "许多旅人见到这对船夫"
  },
  {
    "start": 628.078,
    "end": 630.935,
    "text": "以为他们是兄弟 夜晚"
  },
  {
    "start": 630.935,
    "end": 634.28,
    "text": "他们常沉默地坐在岸边残株上听水"
  },
  {
    "start": 634.28,
    "end": 637.178,
    "text": "对他们来说 这不仅是水声"
  },
  {
    "start": 637.178,
    "end": 638.739,
    "text": "也是生命之声"
  },
  {
    "start": 638.739,
    "end": 641.346,
    "text": "存在之声 永恒之声"
  },
  {
    "start": 641.346,
    "end": 646.038,
    "text": "他们常在倾听时心系一处 想到某次对话"
  },
  {
    "start": 646.038,
    "end": 649.699,
    "text": "某位他们关注的船客的容貌与命运"
  },
  {
    "start": 649.699,
    "end": 653.604,
    "text": "想到死与童年 当河水诉说美好时"
  },
  {
    "start": 653.604,
    "end": 655.312,
    "text": "他们默契相视"
  },
  {
    "start": 655.312,
    "end": 658.942,
    "text": "为同样的疑问得到同样的答复而欣喜"
  },
  {
    "start": 659.189,
    "end": 665.938,
    "text": "一些船客意识到这条船和两位船夫的非凡时常 有船客凝望船夫"
  },
  {
    "start": 665.938,
    "end": 669.431,
    "text": "接着开始述说自己的生活和烦恼"
  },
  {
    "start": 669.431,
    "end": 673.423,
    "text": "坦白自己的过失 寻求告慰 时常"
  },
  {
    "start": 673.423,
    "end": 676.238,
    "text": "也有船客为听水而请求留宿"
  },
  {
    "start": 676.238,
    "end": 678.584,
    "text": "也有好奇者听说河边住"
  },
  {
    "start": 678.584,
    "end": 682.572,
    "text": "着两位智者、法师和圣人前来求教"
  },
  {
    "start": 682.572,
    "end": 685.819,
    "text": "他们提出问题 却从未得到答案"
  },
  {
    "start": 685.819,
    "end": 688.201,
    "text": "他们没有见到法师和智者"
  },
  {
    "start": 688.201,
    "end": 695.545,
    "text": "只是见到两位缄默迟钝、有些特别的老人于是他们嘲笑那些轻信的愚蠢之人"
  },
  {
    "start": 695.545,
    "end": 697.629,
    "text": "散布荒谬的谣言"
  },
  {
    "start": 697.877,
    "end": 701.271,
    "text": "一年年过去 没人再谈起两位船夫"
  },
  {
    "start": 701.519,
    "end": 704.136,
    "text": "那时 一队朝圣的僧人"
  },
  {
    "start": 704.136,
    "end": 707.467,
    "text": "佛陀乔达摩的弟子急迫请求渡河"
  },
  {
    "start": 707.467,
    "end": 710.798,
    "text": "两位船夫从他们的交谈中获悉"
  },
  {
    "start": 710.798,
    "end": 714.503,
    "text": "世尊佛陀病至危笃 肉身将灭"
  },
  {
    "start": 714.503,
    "end": 719.002,
    "text": "即将进入涅槃 不久 众僧团纷至沓来"
  },
  {
    "start": 719.002,
    "end": 721.139,
    "text": "僧侣和徒众都在谈论"
  },
  {
    "start": 721.139,
    "end": 726.361,
    "text": "乔达摩和他濒临的圆寂如同出征或赶往国王加冕"
  },
  {
    "start": 726.361,
    "end": 729.544,
    "text": "四方如蚁般的人群犹如受施"
  },
  {
    "start": 729.544,
    "end": 736.175,
    "text": "魔法般拥向佛陀静待灭度之处拥向即将发生的非凡大事"
  },
  {
    "start": 736.175,
    "end": 738.011,
    "text": "一位自创世以来最"
  },
  {
    "start": 738.011,
    "end": 740.534,
    "text": "伟大的世尊即将步入永恒"
  },
  {
    "start": 740.782,
    "end": 741.265,
    "text": "此刻"
  },
  {
    "start": 741.265,
    "end": 743.435,
    "text": "悉达多怀念这位警示"
  },
  {
    "start": 743.435,
    "end": 747.776,
    "text": "并唤醒世人的伟大导师他曾听他宣法"
  },
  {
    "start": 747.776,
    "end": 750.727,
    "text": "曾满怀敬意地凝视他的圣容"
  },
  {
    "start": 750.727,
    "end": 753.677,
    "text": "悉达多心怀爱意地思念佛陀"
  },
  {
    "start": 753.677,
    "end": 756.135,
    "text": "回忆他的完满之路"
  },
  {
    "start": 756.135,
    "end": 759.129,
    "text": "不禁微笑着记起年少时他对"
  },
  {
    "start": 759.129,
    "end": 765.864,
    "text": "佛陀讲过的那番老成又傲慢的话尽管他并未接受佛陀的法义"
  },
  {
    "start": 765.864,
    "end": 769.802,
    "text": "但他早已知道 他无法与乔达摩分离"
  },
  {
    "start": 769.802,
    "end": 772.119,
    "text": "不 一位真正的求道者"
  },
  {
    "start": 772.119,
    "end": 780.958,
    "text": "真正渴求正觉成悟之人不会接受任何法义但得道之人却认可任何法义、道路和目标"
  },
  {
    "start": 780.958,
    "end": 784.122,
    "text": "没有什么能将他和其他万千"
  },
  {
    "start": 784.122,
    "end": 787.287,
    "text": "驻永恒、通神冥的圣贤隔绝"
  },
  {
    "start": 787.535,
    "end": 790.623,
    "text": "这天 在去朝觐佛陀的徒众中"
  },
  {
    "start": 790.623,
    "end": 794.594,
    "text": "走来从前最美的名妓 衣着质朴的迦摩罗"
  },
  {
    "start": 794.594,
    "end": 797.093,
    "text": "她早已结束过去的生活"
  },
  {
    "start": 797.093,
    "end": 800.843,
    "text": "将花园赠予乔达摩僧团并皈依佛陀"
  },
  {
    "start": 800.843,
    "end": 804.093,
    "text": "成为朝圣者的施主和成员"
  },
  {
    "start": 804.093,
    "end": 805.805,
    "text": "她听说乔达摩病危"
  },
  {
    "start": 805.805,
    "end": 809.015,
    "text": "就带着儿子小悉达多步行前往朝觐"
  },
  {
    "start": 809.015,
    "end": 810.727,
    "text": "他们抵达河畔"
  },
  {
    "start": 810.727,
    "end": 814.513,
    "text": "小悉达多不时喊累 他哭着要回家"
  },
  {
    "start": 814.513,
    "end": 816.17,
    "text": "要休息 要吃"
  },
  {
    "start": 816.17,
    "end": 819.956,
    "text": "迦摩罗只好随他频繁停步 孩子任性"
  },
  {
    "start": 819.956,
    "end": 824.405,
    "text": "母亲不得不喂他吃 安抚他 呵斥他"
  },
  {
    "start": 824.405,
    "end": 827.123,
    "text": "孩子不理解母亲为何带他"
  },
  {
    "start": 827.123,
    "end": 829.595,
    "text": "踏上辛苦忧伤的朝拜之路"
  },
  {
    "start": 829.595,
    "end": 833.741,
    "text": "去往陌生地 见一位陌生而垂死的圣人"
  },
  {
    "start": 833.741,
    "end": 836.274,
    "text": "他死了和小孩有什么关系"
  },
  {
    "start": 836.522,
    "end": 840.002,
    "text": "两位朝圣者行近瓦稣迪瓦的渡船时"
  },
  {
    "start": 840.002,
    "end": 842.321,
    "text": "小悉达多再次要求停步"
  },
  {
    "start": 842.321,
    "end": 844.641,
    "text": "迦摩罗也感到疲倦"
  },
  {
    "start": 844.641,
    "end": 848.699,
    "text": "便给孩子香蕉充饥 自己席地闭目歇息"
  },
  {
    "start": 848.699,
    "end": 851.63,
    "text": "突然 她发出一声痛楚的惨叫"
  },
  {
    "start": 851.63,
    "end": 855.408,
    "text": "受惊的孩子忙望向她 见她脸色煞白"
  },
  {
    "start": 855.408,
    "end": 857.852,
    "text": "从她裙下溜出一条小黑蛇"
  },
  {
    "start": 857.852,
    "end": 860.074,
    "text": "迦摩罗被这条蛇咬伤"
  },
  {
    "start": 860.322,
    "end": 863.335,
    "text": "母子俩疾步前行 寻求帮助"
  },
  {
    "start": 863.335,
    "end": 867.506,
    "text": "临近渡口时 迦摩罗瘫倒在地 无法动弹"
  },
  {
    "start": 867.506,
    "end": 870.299,
    "text": "孩子一边抱住母亲、亲吻母亲"
  },
  {
    "start": 870.299,
    "end": 874.165,
    "text": "一边凄厉地呼叫 迦摩罗也吃力地求救"
  },
  {
    "start": 874.165,
    "end": 877.906,
    "text": "直到声音传至渡船旁的瓦稣迪瓦耳中"
  },
  {
    "start": 877.906,
    "end": 881.413,
    "text": "他迅速赶来 将迦摩罗抱到船里"
  },
  {
    "start": 881.413,
    "end": 883.049,
    "text": "孩子紧随其后"
  },
  {
    "start": 883.049,
    "end": 885.224,
    "text": "很快 他们进了茅舍"
  },
  {
    "start": 885.224,
    "end": 888.486,
    "text": "悉达多正在炉边生火 他抬起头"
  },
  {
    "start": 888.486,
    "end": 890.009,
    "text": "先见到孩子的脸"
  },
  {
    "start": 890.009,
    "end": 893.852,
    "text": "这张脸让他惊讶地记起已经淡忘的往事"
  },
  {
    "start": 893.852,
    "end": 896.113,
    "text": "接着 他看见迦摩罗"
  },
  {
    "start": 896.113,
    "end": 899.084,
    "text": "尽管她晕厥地躺在船夫的臂弯中"
  },
  {
    "start": 899.084,
    "end": 902.692,
    "text": "悉达多还是马上认出她 他立即明白"
  },
  {
    "start": 902.692,
    "end": 908.336,
    "text": "这个有着和他相同面孔的孩子是他的儿子他心潮起伏"
  },
  {
    "start": 908.584,
    "end": 910.934,
    "text": "他们清洗了迦摩罗的伤口"
  },
  {
    "start": 910.934,
    "end": 914.353,
    "text": "她的伤口已经发黑 身体开始肿胀"
  },
  {
    "start": 914.353,
    "end": 916.063,
    "text": "他们喂她服了药"
  },
  {
    "start": 916.063,
    "end": 920.265,
    "text": "好叫她恢复神志 她躺在悉达多的床上"
  },
  {
    "start": 920.265,
    "end": 924.467,
    "text": "曾经深爱她的悉达多守在一旁 如梦似幻"
  },
  {
    "start": 924.467,
    "end": 927.938,
    "text": "她含笑回望昔日的恋人 渐渐地"
  },
  {
    "start": 927.938,
    "end": 931.41,
    "text": "她清醒过来 想起自己被蛇咬伤"
  },
  {
    "start": 931.41,
    "end": 933.261,
    "text": "便惶恐地呼叫孩子"
  },
  {
    "start": 933.509,
    "end": 936.503,
    "text": "“别担心 他在你身边 ”悉达多道"
  },
  {
    "start": 936.751,
    "end": 938.763,
    "text": "迦摩罗望着他的双眼"
  },
  {
    "start": 938.763,
    "end": 943.012,
    "text": "蛇毒令她吐字艰难  亲爱的 你老了"
  },
  {
    "start": 943.012,
    "end": 945.025,
    "text": "”她说 “头发白了"
  },
  {
    "start": 945.025,
    "end": 947.876,
    "text": "但你仍是当年那个赤裸身体"
  },
  {
    "start": 947.876,
    "end": 951.439,
    "text": "双足布满灰尘 来我花园的沙门"
  },
  {
    "start": 951.439,
    "end": 953.9,
    "text": "你比当年离开我和迦摩"
  },
  {
    "start": 953.9,
    "end": 960.298,
    "text": "施瓦弥时更像那个沙门悉达多 你又有了沙门的眼睛 啊"
  },
  {
    "start": 960.298,
    "end": 963.242,
    "text": "我也老了 老了——你可认出我"
  },
  {
    "start": 963.49,
    "end": 966.61,
    "text": "悉达多含笑道： 我一眼就认出你"
  },
  {
    "start": 966.61,
    "end": 968.689,
    "text": "迦摩罗 亲爱的"
  },
  {
    "start": 968.937,
    "end": 972.302,
    "text": "迦摩罗指着孩子： 你可也认得他"
  },
  {
    "start": 972.302,
    "end": 974.321,
    "text": "他是你的儿子"
  },
  {
    "start": 974.569,
    "end": 978.775,
    "text": "她目光迷离 闭起双眼 孩子哭起来"
  },
  {
    "start": 978.775,
    "end": 982.046,
    "text": "悉达多把他抱到膝头 任他哭"
  },
  {
    "start": 982.046,
    "end": 983.448,
    "text": "又抚摩他的头发"
  },
  {
    "start": 983.448,
    "end": 984.959,
    "text": "他望着孩子的脸"
  },
  {
    "start": 984.959,
    "end": 987.979,
    "text": "想起自己儿时学过的婆罗门祷文"
  },
  {
    "start": 987.979,
    "end": 990.137,
    "text": "开始慢声吟唱起来"
  },
  {
    "start": 990.137,
    "end": 993.052,
    "text": "祷词从往昔和童年涌向他"
  },
  {
    "start": 993.052,
    "end": 995.967,
    "text": "孩子在吟唱声中平静下来"
  },
  {
    "start": 995.967,
    "end": 999.146,
    "text": "他抽泣两声便沉沉睡去"
  },
  {
    "start": 999.146,
    "end": 1002.399,
    "text": "悉达多把他放在瓦稣迪瓦的床上"
  },
  {
    "start": 1002.399,
    "end": 1006.58,
    "text": "瓦稣迪瓦正在炉边烧饭 悉达多瞥向他"
  },
  {
    "start": 1006.58,
    "end": 1008.14,
    "text": "他以微笑作答"
  },
  {
    "start": 1008.387,
    "end": 1011.157,
    "text": "“她快死了 ”悉达多轻声道"
  },
  {
    "start": 1011.404,
    "end": 1012.852,
    "text": "瓦稣迪瓦点头"
  },
  {
    "start": 1012.852,
    "end": 1016.954,
    "text": "炉灶里的火焰闪耀在他慈祥的面孔上"
  },
  {
    "start": 1017.201,
    "end": 1020.414,
    "text": "这时 迦摩罗再次恢复神志"
  },
  {
    "start": 1020.414,
    "end": 1022.886,
    "text": "她的脸因痛楚而扭曲着"
  },
  {
    "start": 1022.886,
    "end": 1025.058,
    "text": "悉达多在她的嘴唇和"
  },
  {
    "start": 1025.058,
    "end": 1030.37,
    "text": "苍白的双颊上读出这痛楚他安静而专注地守候她"
  },
  {
    "start": 1030.37,
    "end": 1034.244,
    "text": "沉浸在她的痛楚中 迦摩罗有所察觉"
  },
  {
    "start": 1034.244,
    "end": 1036.524,
    "text": "她用目光寻找他的眼睛"
  },
  {
    "start": 1036.772,
    "end": 1039.6,
    "text": "她看见他 说道： 我看到"
  },
  {
    "start": 1039.6,
    "end": 1042.428,
    "text": "你的眼睛变了 不同于从前"
  },
  {
    "start": 1042.428,
    "end": 1044.386,
    "text": "可我是怎么认出你的"
  },
  {
    "start": 1044.386,
    "end": 1046.76,
    "text": "你是悉达多 却又不是"
  },
  {
    "start": 1047.008,
    "end": 1050.632,
    "text": "悉达多不语 他安静地望着她的眼睛"
  },
  {
    "start": 1050.88,
    "end": 1053.465,
    "text": "“你实现目标了吗 ”迦摩罗问"
  },
  {
    "start": 1053.465,
    "end": 1055.534,
    "text": "“找到你的安宁了吗 ”"
  },
  {
    "start": 1055.782,
    "end": 1058.746,
    "text": "悉达多笑了 手抚在她的手上"
  },
  {
    "start": 1058.994,
    "end": 1062.747,
    "text": "“我懂 ”迦摩罗道 “我懂得"
  },
  {
    "start": 1062.747,
    "end": 1065.093,
    "text": "我也会找到我的安宁"
  },
  {
    "start": 1065.341,
    "end": 1067.875,
    "text": "“你已经找到了 ”悉达多轻声道"
  },
  {
    "start": 1068.123,
    "end": 1070.039,
    "text": "迦摩罗看着悉达多"
  },
  {
    "start": 1070.039,
    "end": 1073.153,
    "text": "她想起自己本是去朝觐乔达摩"
  },
  {
    "start": 1073.153,
    "end": 1076.027,
    "text": "去亲眼目睹佛陀的圣容"
  },
  {
    "start": 1076.027,
    "end": 1079.406,
    "text": "吸纳他的平和 却和悉达多重逢"
  },
  {
    "start": 1079.406,
    "end": 1082.559,
    "text": "这样也好 和见到佛陀同样好"
  },
  {
    "start": 1082.559,
    "end": 1084.136,
    "text": "她想把这告诉他"
  },
  {
    "start": 1084.136,
    "end": 1087.924,
    "text": "可舌头却不听使唤 她默默望着他"
  },
  {
    "start": 1087.924,
    "end": 1091.95,
    "text": "他从她眼中看出她的生命之光即将熄灭"
  },
  {
    "start": 1091.95,
    "end": 1095.74,
    "text": "当最后的痛苦在她眼中萦回又破碎"
  },
  {
    "start": 1095.74,
    "end": 1098.772,
    "text": "当最后的战栗惊掠她的身躯"
  },
  {
    "start": 1098.772,
    "end": 1101.299,
    "text": "他合上了她的眼睑"
  },
  {
    "start": 1101.547,
    "end": 1104.717,
    "text": "他呆坐着 凝视她长眠的脸"
  },
  {
    "start": 1104.717,
    "end": 1108.131,
    "text": "她衰老、疲惫 不再丰满的嘴唇"
  },
  {
    "start": 1108.131,
    "end": 1110.279,
    "text": "想起早年自己曾把它"
  },
  {
    "start": 1110.279,
    "end": 1117.2,
    "text": "比作新鲜开裂的无花果他呆坐着 凝视她苍白的脸 倦怠的皱纹"
  },
  {
    "start": 1117.2,
    "end": 1120.176,
    "text": "仿佛凝视自己苍白倦怠的脸"
  },
  {
    "start": 1120.176,
    "end": 1124.641,
    "text": "他看见他们年轻时的容颜 鲜红的嘴唇"
  },
  {
    "start": 1124.641,
    "end": 1126.129,
    "text": "炙热的双眼"
  },
  {
    "start": 1126.129,
    "end": 1130.284,
    "text": "两种情境交织着充满他 成为永恒"
  },
  {
    "start": 1130.284,
    "end": 1134.18,
    "text": "他比以往更深刻地体会到生命不灭"
  },
  {
    "start": 1134.18,
    "end": 1135.738,
    "text": "刹那即永恒"
  },
  {
    "start": 1135.986,
    "end": 1139.272,
    "text": "他起身 瓦稣迪瓦已备好米饭"
  },
  {
    "start": 1139.272,
    "end": 1140.68,
    "text": "可悉达多没吃"
  },
  {
    "start": 1140.68,
    "end": 1143.73,
    "text": "两位老人坐在羊圈的草堆上"
  },
  {
    "start": 1143.73,
    "end": 1147.933,
    "text": "瓦稣迪瓦躺下睡熟 悉达多则走出去"
  },
  {
    "start": 1147.933,
    "end": 1151.889,
    "text": "坐在深夜的屋舍前 他倾听河水奔涌"
  },
  {
    "start": 1151.889,
    "end": 1155.884,
    "text": "沉浸在往事中 被一生的时光触摸"
  },
  {
    "start": 1155.884,
    "end": 1159.878,
    "text": "簇拥 时而他站起来 走到茅舍门口"
  },
  {
    "start": 1159.878,
    "end": 1161.857,
    "text": "看一眼熟睡的孩子"
  },
  {
    "start": 1162.105,
    "end": 1164.476,
    "text": "清晨的太阳尚未彻底升起"
  },
  {
    "start": 1164.476,
    "end": 1168.139,
    "text": "瓦稣迪瓦便走出羊圈 来到朋友身边"
  },
  {
    "start": 1168.387,
    "end": 1170.372,
    "text": "“你没睡 ”他道"
  },
  {
    "start": 1170.619,
    "end": 1174.508,
    "text": "我没睡 瓦稣迪瓦 我在这听水"
  },
  {
    "start": 1174.508,
    "end": 1175.881,
    "text": "河水讲了许多"
  },
  {
    "start": 1175.881,
    "end": 1179.084,
    "text": "它有益又统一的思想充满我"
  },
  {
    "start": 1179.331,
    "end": 1181.639,
    "text": "你经受了痛苦 悉达多"
  },
  {
    "start": 1181.639,
    "end": 1184.33,
    "text": "可我并未发现你心头的悲伤"
  },
  {
    "start": 1184.578,
    "end": 1187.782,
    "text": "没有 亲爱的 我为何悲伤"
  },
  {
    "start": 1187.782,
    "end": 1191.626,
    "text": "我富足、幸福 如今我更为富足、幸福"
  },
  {
    "start": 1191.626,
    "end": 1192.907,
    "text": "我有了儿子"
  },
  {
    "start": 1193.155,
    "end": 1195.92,
    "text": "我欢迎你的儿子 悉达多"
  },
  {
    "start": 1195.92,
    "end": 1198.685,
    "text": "我们该去劳作了 事情很多"
  },
  {
    "start": 1198.685,
    "end": 1201.45,
    "text": "迦摩罗死在我过世妻子的床上"
  },
  {
    "start": 1201.45,
    "end": 1203.617,
    "text": "我们也该在焚化我妻子的"
  },
  {
    "start": 1203.617,
    "end": 1206.179,
    "text": "山丘上为迦摩罗架起柴堆"
  },
  {
    "start": 1206.426,
    "end": 1209.786,
    "text": "孩子仍在熟睡 他们架起了柴堆"
  }
]