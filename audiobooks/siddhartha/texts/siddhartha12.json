[
  {
    "start": 0.0,
    "end": 2.029,
    "text": "第十二章 乔文达"
  },
  {
    "start": 2.277,
    "end": 4.695,
    "text": "乔文达曾和其他僧侣一道"
  },
  {
    "start": 4.695,
    "end": 8.432,
    "text": "在名妓迦摩罗赠予乔达摩弟子的林苑内"
  },
  {
    "start": 8.432,
    "end": 10.631,
    "text": "度过一段休憩时光"
  },
  {
    "start": 10.631,
    "end": 13.197,
    "text": "他听说距此一天路途的河畔"
  },
  {
    "start": 13.197,
    "end": 17.26,
    "text": "住着位船夫 他是一位圣贤 离开林苑后"
  },
  {
    "start": 17.26,
    "end": 19.848,
    "text": "乔文达选择前往渡口方向"
  },
  {
    "start": 19.848,
    "end": 23.849,
    "text": "期盼见到船夫 尽管他一生遵循僧规"
  },
  {
    "start": 23.849,
    "end": 27.042,
    "text": "因高龄谦逊受到青年僧人的敬重"
  },
  {
    "start": 27.042,
    "end": 30.008,
    "text": "但他的不安与探求尚未止息"
  },
  {
    "start": 30.256,
    "end": 33.978,
    "text": "抵达河畔后 他请求老人渡他过河"
  },
  {
    "start": 33.978,
    "end": 36.538,
    "text": "下船时 他道： 船夫"
  },
  {
    "start": 36.538,
    "end": 39.33,
    "text": "你对僧人和朝圣者十分友善"
  },
  {
    "start": 39.33,
    "end": 42.959,
    "text": "你渡许多人过河 你可是位求道者"
  },
  {
    "start": 43.207,
    "end": 46.011,
    "text": "悉达多苍老的双眼饱含笑意"
  },
  {
    "start": 46.011,
    "end": 49.282,
    "text": "他道： 可敬的人 你已年迈"
  },
  {
    "start": 49.282,
    "end": 52.086,
    "text": "仍穿着乔达摩弟子的僧服"
  },
  {
    "start": 52.086,
    "end": 54.075,
    "text": "你自认是位求道者吗"
  },
  {
    "start": 54.323,
    "end": 57.326,
    "text": "“我确实已老迈 ”乔文达道"
  },
  {
    "start": 57.326,
    "end": 61.187,
    "text": "但我尚未停止探求 永远不会停止探求"
  },
  {
    "start": 61.187,
    "end": 64.391,
    "text": "这看来是我的使命 你也曾探求"
  },
  {
    "start": 64.391,
    "end": 67.381,
    "text": "尊敬的人 你可愿说与我听"
  },
  {
    "start": 67.629,
    "end": 69.743,
    "text": "悉达多道： 可敬的人"
  },
  {
    "start": 69.743,
    "end": 72.914,
    "text": "我该对你说什么 说你探求过多"
  },
  {
    "start": 72.914,
    "end": 75.873,
    "text": "还是说你的探求并无所获"
  },
  {
    "start": 76.121,
    "end": 77.905,
    "text": "“怎么 ”乔文达问"
  },
  {
    "start": 78.153,
    "end": 81.077,
    "text": "“一个探求之人 ”悉达多道"
  },
  {
    "start": 81.077,
    "end": 84.837,
    "text": "往往只关注探求的事物 他一无所获"
  },
  {
    "start": 84.837,
    "end": 85.672,
    "text": "一无所纳"
  },
  {
    "start": 85.672,
    "end": 89.422,
    "text": "因为他一心想着探求 被目的左右"
  },
  {
    "start": 89.422,
    "end": 91.531,
    "text": "探求意味着拥有目标"
  },
  {
    "start": 91.531,
    "end": 95.681,
    "text": "而发现则意味自由、敞开、全无目的"
  },
  {
    "start": 95.681,
    "end": 99.83,
    "text": "可敬的人 你或许确实是位探索者"
  },
  {
    "start": 99.83,
    "end": 101.975,
    "text": "但你却因努力追求目标"
  },
  {
    "start": 101.975,
    "end": 104.549,
    "text": "而错过了些眼前事物"
  },
  {
    "start": 104.797,
    "end": 108.282,
    "text": "“我尚未完全明白 ”乔文达请求道"
  },
  {
    "start": 108.282,
    "end": 109.716,
    "text": "“此话怎讲 ”"
  },
  {
    "start": 109.964,
    "end": 113.489,
    "text": "悉达多道： 多年前 可敬的人"
  },
  {
    "start": 113.489,
    "end": 117.014,
    "text": "你到过河畔 遇见一位酣睡之人"
  },
  {
    "start": 117.014,
    "end": 118.893,
    "text": "你守候他安眠 哦"
  },
  {
    "start": 118.893,
    "end": 121.152,
    "text": "乔文达 你却并未认出他"
  },
  {
    "start": 121.4,
    "end": 124.509,
    "text": "“你是悉达多 ”他惊诧地问"
  },
  {
    "start": 124.509,
    "end": 128.283,
    "text": "这次我又未认出你 我衷心问候你"
  },
  {
    "start": 128.283,
    "end": 128.949,
    "text": "悉达多"
  },
  {
    "start": 128.949,
    "end": 131.989,
    "text": "又见到你我由衷高兴 你变化很大"
  },
  {
    "start": 131.989,
    "end": 134.649,
    "text": "朋友 ——你又成为了船夫"
  },
  {
    "start": 134.896,
    "end": 138.852,
    "text": "悉达多亲切地笑道： 是的 乔文达"
  },
  {
    "start": 138.852,
    "end": 143.041,
    "text": "我是船夫 有些人不断变化 着各式衣装"
  },
  {
    "start": 143.041,
    "end": 147.866,
    "text": "我亦如此 亲爱的 欢迎你 乔文达"
  },
  {
    "start": 147.866,
    "end": 150.66,
    "text": "今晚你在我的茅舍留宿吧"
  },
  {
    "start": 150.908,
    "end": 152.695,
    "text": "乔文达在茅舍留宿"
  },
  {
    "start": 152.695,
    "end": 155.152,
    "text": "睡在瓦稣迪瓦从前的床上"
  },
  {
    "start": 155.152,
    "end": 158.727,
    "text": "他向年轻时的好友提出诸多问题"
  },
  {
    "start": 158.727,
    "end": 161.861,
    "text": "而悉达多则向他讲述自己的生活"
  },
  {
    "start": 162.109,
    "end": 165.377,
    "text": "次日清晨 继续赶路的时辰已到"
  },
  {
    "start": 165.377,
    "end": 169.299,
    "text": "乔文达不无犹豫 他道： 在上路之前"
  },
  {
    "start": 169.299,
    "end": 169.953,
    "text": "悉达多"
  },
  {
    "start": 169.953,
    "end": 171.933,
    "text": "请允许我再提一个问题"
  },
  {
    "start": 171.933,
    "end": 173.517,
    "text": "你可有自己的学说"
  },
  {
    "start": 173.517,
    "end": 177.477,
    "text": "可有指引、帮助你生活的信仰或学问"
  },
  {
    "start": 177.725,
    "end": 181.505,
    "text": "悉达多回答： 你知道 亲爱的"
  },
  {
    "start": 181.505,
    "end": 185.538,
    "text": "年轻时我们和苦行僧一同生活在林中"
  },
  {
    "start": 185.538,
    "end": 186.294,
    "text": "那时"
  },
  {
    "start": 186.294,
    "end": 189.968,
    "text": "我就怀疑、背离了种种学说和老师"
  },
  {
    "start": 189.968,
    "end": 193.398,
    "text": "现在我依然如此 可打那以后"
  },
  {
    "start": 193.398,
    "end": 195.603,
    "text": "我却有过多位老师"
  },
  {
    "start": 195.603,
    "end": 196.474,
    "text": "很长时间"
  },
  {
    "start": 196.474,
    "end": 199.306,
    "text": "一位美艳的名妓做过我的老师"
  },
  {
    "start": 199.306,
    "end": 202.792,
    "text": "还有一位富商 几个赌徒 一次"
  },
  {
    "start": 202.792,
    "end": 206.016,
    "text": "一位僧人在朝圣路上见我睡在林中"
  },
  {
    "start": 206.016,
    "end": 209.241,
    "text": "停下来守候我 他也是我的老师"
  },
  {
    "start": 209.241,
    "end": 210.531,
    "text": "我向他学习"
  },
  {
    "start": 210.531,
    "end": 213.572,
    "text": "感激他 但我所学最多的"
  },
  {
    "start": 213.572,
    "end": 216.359,
    "text": "是跟随这条河和我的前辈"
  },
  {
    "start": 216.359,
    "end": 220.16,
    "text": "船夫瓦稣迪瓦 他是位质朴的人"
  },
  {
    "start": 220.16,
    "end": 221.081,
    "text": "并非哲人"
  },
  {
    "start": 221.081,
    "end": 224.073,
    "text": "但他对命运的深解有如乔达摩"
  },
  {
    "start": 224.073,
    "end": 226.604,
    "text": "他是完人 圣人"
  },
  {
    "start": 226.852,
    "end": 229.852,
    "text": "乔文达道： 哦 悉达多"
  },
  {
    "start": 229.852,
    "end": 233.851,
    "text": "你和从前一样喜欢说笑 我相信你"
  },
  {
    "start": 233.851,
    "end": 236.601,
    "text": "知道你并未追随任何老师"
  },
  {
    "start": 236.601,
    "end": 239.383,
    "text": "但你自己 即便没有学说"
  },
  {
    "start": 239.383,
    "end": 241.701,
    "text": "也该有某些你特有的、"
  },
  {
    "start": 241.701,
    "end": 244.25,
    "text": "扶持你生活的思想和认知"
  },
  {
    "start": 244.25,
    "end": 247.279,
    "text": "如果你愿意讲讲 我会由衷高兴"
  },
  {
    "start": 247.527,
    "end": 250.877,
    "text": "悉达多道： 我有过思考 对"
  },
  {
    "start": 250.877,
    "end": 255.185,
    "text": "也有过认知 有时 一个时辰或一日"
  },
  {
    "start": 255.185,
    "end": 256.381,
    "text": "我被认知充满"
  },
  {
    "start": 256.381,
    "end": 258.879,
    "text": "如同人们在心中感知生命"
  },
  {
    "start": 258.879,
    "end": 262.058,
    "text": "有些认知很难与你分享 你看"
  },
  {
    "start": 262.058,
    "end": 263.42,
    "text": "我的乔文达"
  },
  {
    "start": 263.42,
    "end": 266.699,
    "text": "这就是我的认知：智慧无法言传"
  },
  {
    "start": 266.699,
    "end": 270.915,
    "text": "智者试图传授智慧 总像痴人说梦"
  },
  {
    "start": 271.162,
    "end": 273.701,
    "text": "“你在说笑 ”乔文达问"
  },
  {
    "start": 273.949,
    "end": 277.865,
    "text": "我并未说笑 我说的是我的认知"
  },
  {
    "start": 277.865,
    "end": 281.29,
    "text": "知识可以分享 智慧无法分享"
  },
  {
    "start": 281.29,
    "end": 282.759,
    "text": "它可以被发现"
  },
  {
    "start": 282.759,
    "end": 287.679,
    "text": "被体验 智慧令人安详 智慧创造奇迹"
  },
  {
    "start": 287.679,
    "end": 290.786,
    "text": "但人们无法言说和传授智慧"
  },
  {
    "start": 290.786,
    "end": 292.858,
    "text": "这是我年轻时发现"
  },
  {
    "start": 292.858,
    "end": 296.67,
    "text": "并离开老师们的原因 我有一个想法"
  },
  {
    "start": 296.67,
    "end": 300.482,
    "text": "乔文达 你又会以为是我的玩笑或痴愚"
  },
  {
    "start": 300.482,
    "end": 305.336,
    "text": "但它是我最好的考量：真的反面同样真实也就是说"
  },
  {
    "start": 305.336,
    "end": 308.866,
    "text": "只有片面的真才得以以言辞彰显"
  },
  {
    "start": 308.866,
    "end": 312.707,
    "text": "可以思想和言说的一切都是片面的"
  },
  {
    "start": 312.707,
    "end": 316.805,
    "text": "是局部 都缺乏整体、完满、统一"
  },
  {
    "start": 316.805,
    "end": 320.362,
    "text": "世尊乔达摩在宣法和谈论世界时"
  },
  {
    "start": 320.362,
    "end": 323.157,
    "text": "不得不将世界分为轮回和"
  },
  {
    "start": 323.157,
    "end": 326.714,
    "text": "涅槃、幻象和真相、苦与救赎"
  },
  {
    "start": 326.714,
    "end": 328.68,
    "text": "宣法之人别无他途"
  },
  {
    "start": 328.68,
    "end": 335.808,
    "text": "而我们周围和内在的世界却从未沦于片面尚无一人 尚无一事"
  },
  {
    "start": 335.808,
    "end": 338.19,
    "text": "完全轮回或彻底涅槃"
  },
  {
    "start": 338.19,
    "end": 341.63,
    "text": "尚无一人绝对神圣或绝对罪孽"
  },
  {
    "start": 341.63,
    "end": 343.482,
    "text": "之所以如此"
  },
  {
    "start": 343.482,
    "end": 345.934,
    "text": "是因为我们受制于幻象"
  },
  {
    "start": 345.934,
    "end": 350.349,
    "text": "相信时间真实存在 时间并不真实存在"
  },
  {
    "start": 350.349,
    "end": 352.801,
    "text": "乔文达 我时有感悟"
  },
  {
    "start": 352.801,
    "end": 355.108,
    "text": "而如果时间并非实在"
  },
  {
    "start": 355.108,
    "end": 358.183,
    "text": "世界与永恒、苦难与极乐、"
  },
  {
    "start": 358.183,
    "end": 361.77,
    "text": "善与恶的界限亦皆为幻象"
  },
  {
    "start": 362.018,
    "end": 364.282,
    "text": "“怎么 ”乔文达谨慎问道"
  },
  {
    "start": 364.53,
    "end": 369.072,
    "text": "听好 亲爱的 你听好 罪人"
  },
  {
    "start": 369.072,
    "end": 371.743,
    "text": "我是罪人 你是罪人"
  },
  {
    "start": 371.743,
    "end": 374.949,
    "text": "但罪人终将成为梵天 证悟涅槃"
  },
  {
    "start": 374.949,
    "end": 379.855,
    "text": "得以成佛 只是 这‘终将’乃为幻象"
  },
  {
    "start": 379.855,
    "end": 383.728,
    "text": "仅是譬喻 罪人并未走在成佛之路上"
  },
  {
    "start": 383.728,
    "end": 386.63,
    "text": "他并未处于发展中——尽管"
  },
  {
    "start": 386.63,
    "end": 392.432,
    "text": "我们的思维认为其处于发展中无法具备其他想象 不"
  },
  {
    "start": 392.432,
    "end": 393.617,
    "text": "在罪人身上"
  },
  {
    "start": 393.617,
    "end": 396.697,
    "text": "现在和今天的他即是未来的佛"
  },
  {
    "start": 396.697,
    "end": 399.067,
    "text": "他的未来已然存在"
  },
  {
    "start": 399.067,
    "end": 402.436,
    "text": "你须将罪人、你自己和一切人"
  },
  {
    "start": 402.436,
    "end": 406.584,
    "text": "尊为将成之佛、可能之佛、隐匿之佛"
  },
  {
    "start": 406.584,
    "end": 409.176,
    "text": "乔文达 我的朋友"
  },
  {
    "start": 409.176,
    "end": 410.841,
    "text": "世界并非不圆满"
  },
  {
    "start": 410.841,
    "end": 415.122,
    "text": "世界并非徐缓地行进在通向圆满之路：不"
  },
  {
    "start": 415.122,
    "end": 418.215,
    "text": "世间的每一瞬间皆为圆满"
  },
  {
    "start": 418.215,
    "end": 420.498,
    "text": "一切罪孽都承载宽赦"
  },
  {
    "start": 420.498,
    "end": 423.288,
    "text": "所有孩童身上都栖息老人"
  },
  {
    "start": 423.288,
    "end": 426.839,
    "text": "所有新生儿身上都栖息亡者"
  },
  {
    "start": 426.839,
    "end": 430.141,
    "text": "所有将死之人都孕育永恒的生命"
  },
  {
    "start": 430.141,
    "end": 432.5,
    "text": "没人能看清他者的道路"
  },
  {
    "start": 432.5,
    "end": 436.038,
    "text": "强盗和赌徒的路或许通向佛陀"
  },
  {
    "start": 436.038,
    "end": 438.605,
    "text": "婆罗门的路或许通往强盗"
  },
  {
    "start": 438.605,
    "end": 440.705,
    "text": "在最深的禅定中存在"
  },
  {
    "start": 440.705,
    "end": 443.272,
    "text": "这种可能：时间被终结"
  },
  {
    "start": 443.272,
    "end": 447.442,
    "text": "人视过往、当下和未来的生活为同时"
  },
  {
    "start": 447.442,
    "end": 451.352,
    "text": "这时 一切皆为善、圆满和梵天"
  },
  {
    "start": 451.352,
    "end": 453.176,
    "text": "因此在我看来"
  },
  {
    "start": 453.176,
    "end": 456.973,
    "text": "世间存在的一切皆好 在我看来"
  },
  {
    "start": 456.973,
    "end": 461.53,
    "text": "死如同生 罪孽犹如神圣 聪明等同愚蠢"
  },
  {
    "start": 461.53,
    "end": 463.12,
    "text": "一切皆有定数"
  },
  {
    "start": 463.12,
    "end": 467.359,
    "text": "一切只需我的赞赏、顺从和爱的默许"
  },
  {
    "start": 467.359,
    "end": 471.069,
    "text": "这样于我有益 只会促进我"
  },
  {
    "start": 471.069,
    "end": 475.647,
    "text": "从不伤害我 我听便灵魂与肉体的安排"
  },
  {
    "start": 475.647,
    "end": 479.207,
    "text": "去经历罪孽 追逐肉欲和财富"
  },
  {
    "start": 479.207,
    "end": 480.478,
    "text": "去贪慕虚荣"
  },
  {
    "start": 480.478,
    "end": 484.793,
    "text": "以陷入最羞耻的绝望 以学会放弃挣扎"
  },
  {
    "start": 484.793,
    "end": 486.231,
    "text": "学会热爱世界"
  },
  {
    "start": 486.231,
    "end": 489.827,
    "text": "我不再将这个世界与我所期待的"
  },
  {
    "start": 489.827,
    "end": 491.863,
    "text": "塑造的圆满世界比照"
  },
  {
    "start": 491.863,
    "end": 495.708,
    "text": "而是接受这个世界 爱它 属于它"
  },
  {
    "start": 495.708,
    "end": 497.291,
    "text": "——哦 乔文达"
  },
  {
    "start": 497.291,
    "end": 499.785,
    "text": "这就是我的一些思考和感悟"
  },
  {
    "start": 500.033,
    "end": 503.385,
    "text": "悉达多弯腰 拾起地上的一块石头"
  },
  {
    "start": 503.385,
    "end": 504.432,
    "text": "在手中掂量"
  },
  {
    "start": 504.68,
    "end": 509.051,
    "text": "“这个 ”他摆弄着 “是一块石头"
  },
  {
    "start": 509.051,
    "end": 513.664,
    "text": "一段时间后 它或许成为土 生出植物"
  },
  {
    "start": 513.664,
    "end": 514.149,
    "text": "变成动物"
  },
  {
    "start": 514.149,
    "end": 518.588,
    "text": "变成人 过去我会说 它不过是块石头"
  },
  {
    "start": 518.588,
    "end": 520.924,
    "text": "毫无价值 属于幻象世界"
  },
  {
    "start": 520.924,
    "end": 524.166,
    "text": "或许它在进化轮回中变成人或鬼"
  },
  {
    "start": 524.166,
    "end": 527.871,
    "text": "那么我赋予它价值 过去我这么想"
  },
  {
    "start": 527.871,
    "end": 529.493,
    "text": "但今天我却想"
  },
  {
    "start": 529.493,
    "end": 534.32,
    "text": "这块石头就是石头 它也是动物 是神"
  },
  {
    "start": 534.32,
    "end": 534.828,
    "text": "是佛"
  },
  {
    "start": 534.828,
    "end": 539.402,
    "text": "我不会因它终将变为这个或那个而敬爱它"
  },
  {
    "start": 539.402,
    "end": 543.28,
    "text": "而会因为它一直是石头——正因为它是"
  },
  {
    "start": 543.28,
    "end": 545.333,
    "text": "石头——今天和现在"
  },
  {
    "start": 545.333,
    "end": 548.071,
    "text": "出现在我面前的石头而爱它"
  },
  {
    "start": 548.071,
    "end": 551.887,
    "text": "看到它每条纹理中 每道沟渠中"
  },
  {
    "start": 551.887,
    "end": 554.686,
    "text": "黄色、灰色中 坚硬中"
  },
  {
    "start": 554.686,
    "end": 557.23,
    "text": "我敲击它发出的声音中"
  },
  {
    "start": 557.23,
    "end": 565.494,
    "text": "它表面的干燥和潮湿中存在的意义和价值有些石头如油如皂 有些像叶似沙"
  },
  {
    "start": 565.494,
    "end": 567.365,
    "text": "每块石头都不同"
  },
  {
    "start": 567.365,
    "end": 570.572,
    "text": "都以其特有的方式念诵着唵"
  },
  {
    "start": 570.572,
    "end": 574.313,
    "text": "每块石头都是梵天 但同时"
  },
  {
    "start": 574.313,
    "end": 577.931,
    "text": "它又确实是石头 油腻 光滑"
  },
  {
    "start": 577.931,
    "end": 581.067,
    "text": "恰恰是这些让我欢喜 感到惊奇"
  },
  {
    "start": 581.067,
    "end": 584.362,
    "text": "产生崇敬——但我不想继续言说"
  },
  {
    "start": 584.362,
    "end": 587.893,
    "text": "对于隐匿的意义来说 言语无益"
  },
  {
    "start": 587.893,
    "end": 590.011,
    "text": "它总在言说中歪曲"
  },
  {
    "start": 590.011,
    "end": 592.095,
    "text": "变异 变蠢"
  },
  {
    "start": 592.343,
    "end": 596.073,
    "text": "是 即便这一点也极好 令我欢喜"
  },
  {
    "start": 596.073,
    "end": 598.048,
    "text": "一个人的宝藏与智慧"
  },
  {
    "start": 598.048,
    "end": 600.022,
    "text": "在他人听来却是愚痴"
  },
  {
    "start": 600.022,
    "end": 601.621,
    "text": "连这我也认同"
  },
  {
    "start": 601.869,
    "end": 603.548,
    "text": "乔文达默不作声"
  },
  {
    "start": 603.796,
    "end": 607.351,
    "text": "“你为何与我说一块石头 ”他停顿后"
  },
  {
    "start": 607.351,
    "end": 608.14,
    "text": "迟疑地问"
  },
  {
    "start": 608.388,
    "end": 611.466,
    "text": "并无意图 或许我想说"
  },
  {
    "start": 611.466,
    "end": 613.261,
    "text": "我爱石头、河水"
  },
  {
    "start": 613.261,
    "end": 617.107,
    "text": "爱所有我们可见并可以求教之物"
  },
  {
    "start": 617.107,
    "end": 619.674,
    "text": "我爱一块石头 乔文达"
  },
  {
    "start": 619.674,
    "end": 623.175,
    "text": "爱一棵树或一块树皮 这些是物"
  },
  {
    "start": 623.175,
    "end": 625.741,
    "text": "可爱之物 但我不爱言辞"
  },
  {
    "start": 625.741,
    "end": 629.16,
    "text": "学说于我毫无价值 它们没有力"
  },
  {
    "start": 629.16,
    "end": 632.578,
    "text": "没有柔 没有颜色 没有棱角"
  },
  {
    "start": 632.578,
    "end": 633.946,
    "text": "没有气味和味道"
  },
  {
    "start": 633.946,
    "end": 636.793,
    "text": "作为言辞 它一无所有"
  },
  {
    "start": 636.793,
    "end": 640.159,
    "text": "或许正是言辞阻碍你获得安宁"
  },
  {
    "start": 640.159,
    "end": 642.23,
    "text": "因为救赎与美德"
  },
  {
    "start": 642.23,
    "end": 646.499,
    "text": "轮回与涅槃也只是言辞 世上并无涅槃"
  },
  {
    "start": 646.499,
    "end": 648.634,
    "text": "涅槃只是个言辞"
  },
  {
    "start": 648.882,
    "end": 651.936,
    "text": "乔文达道： 涅槃不只是言辞"
  },
  {
    "start": 651.936,
    "end": 654.286,
    "text": "朋友 它是思想"
  },
  {
    "start": 654.534,
    "end": 658.094,
    "text": "悉达多继续道： 它是思想 或许"
  },
  {
    "start": 658.094,
    "end": 658.762,
    "text": "亲爱的"
  },
  {
    "start": 658.762,
    "end": 662.323,
    "text": "我必须承认我并不区分思想和言辞"
  },
  {
    "start": 662.323,
    "end": 666.443,
    "text": "坦率地说 较于思想 我更看重‘物’"
  },
  {
    "start": 666.443,
    "end": 669.479,
    "text": "正如曾在这条船上的前辈和师长"
  },
  {
    "start": 669.479,
    "end": 670.347,
    "text": "那位圣人"
  },
  {
    "start": 670.347,
    "end": 673.264,
    "text": "多年来 他除了信奉河水"
  },
  {
    "start": 673.264,
    "end": 677.397,
    "text": "并无其他信仰 他发觉河水与他交流"
  },
  {
    "start": 677.397,
    "end": 678.856,
    "text": "于是学习河水"
  },
  {
    "start": 678.856,
    "end": 683.095,
    "text": "向它讨教 河水是他的神 多年来"
  },
  {
    "start": 683.095,
    "end": 686.22,
    "text": "他并不知道每阵风、每片云"
  },
  {
    "start": 686.22,
    "end": 692.729,
    "text": "、每只鸟、每条虫都同样神圣它们所知甚多 亦可赐教"
  },
  {
    "start": 692.729,
    "end": 694.577,
    "text": "正如可敬的河水"
  },
  {
    "start": 694.577,
    "end": 698.8,
    "text": "但这位圣人在步入林中时已了悟一切"
  },
  {
    "start": 698.8,
    "end": 701.703,
    "text": "他比你我了悟得更多"
  },
  {
    "start": 701.703,
    "end": 704.228,
    "text": "他没有教义 没有书籍"
  },
  {
    "start": 704.228,
    "end": 706.752,
    "text": "他只信奉河水的启迪"
  },
  {
    "start": 707.0,
    "end": 708.928,
    "text": "乔文达道： 可是"
  },
  {
    "start": 708.928,
    "end": 712.544,
    "text": "你所说之‘物’是真实、实在的吗"
  },
  {
    "start": 712.544,
    "end": 714.954,
    "text": "它不是玛雅的幻象"
  },
  {
    "start": 714.954,
    "end": 718.078,
    "text": "不是图景和假象 你的石头、树"
  },
  {
    "start": 718.078,
    "end": 720.993,
    "text": "你的河——它们是真实的吗"
  },
  {
    "start": 721.241,
    "end": 723.682,
    "text": "悉达多道： 我并不为"
  },
  {
    "start": 723.682,
    "end": 729.54,
    "text": "‘物’是否虚幻而忧虑连我也可能只是个幻象 因此"
  },
  {
    "start": 729.54,
    "end": 731.533,
    "text": "我同‘物’并无区别"
  },
  {
    "start": 731.533,
    "end": 733.968,
    "text": "我因此觉得它们值得热爱"
  },
  {
    "start": 733.968,
    "end": 736.624,
    "text": "和敬重——我们并无区别"
  },
  {
    "start": 736.624,
    "end": 738.243,
    "text": "我因此热爱它们"
  },
  {
    "start": 738.243,
    "end": 741.711,
    "text": "你一定笑话我这种说法 乔文达"
  },
  {
    "start": 741.711,
    "end": 744.949,
    "text": "对于我来说 爱乃头等要务"
  },
  {
    "start": 744.949,
    "end": 748.265,
    "text": "审视世界、解释世界或藐视世界"
  },
  {
    "start": 748.265,
    "end": 751.819,
    "text": "或许是思想家的事 我唯一的事"
  },
  {
    "start": 751.819,
    "end": 753.478,
    "text": "是爱这个世界"
  },
  {
    "start": 753.478,
    "end": 757.091,
    "text": "不藐视世界 不憎恶世界和自己"
  },
  {
    "start": 757.091,
    "end": 757.813,
    "text": "怀抱爱"
  },
  {
    "start": 757.813,
    "end": 760.222,
    "text": "惊叹和敬畏地注视一切"
  },
  {
    "start": 760.222,
    "end": 762.872,
    "text": "存在之物和我自己"
  },
  {
    "start": 763.12,
    "end": 765.756,
    "text": "“我理解 ”乔文达道"
  },
  {
    "start": 765.756,
    "end": 768.393,
    "text": "但世尊视之为虚妄之相"
  },
  {
    "start": 768.393,
    "end": 771.989,
    "text": "他宣讲良善、仁慈、同情、宽容"
  },
  {
    "start": 771.989,
    "end": 772.925,
    "text": "而不是爱"
  },
  {
    "start": 772.925,
    "end": 776.903,
    "text": "他禁止我们的心桎梏于尘世之爱"
  },
  {
    "start": 777.151,
    "end": 779.515,
    "text": "“我知道 ”悉达多道"
  },
  {
    "start": 779.515,
    "end": 783.6,
    "text": "他的笑容熠熠发光  我知道 乔文达"
  },
  {
    "start": 783.6,
    "end": 783.815,
    "text": "你看"
  },
  {
    "start": 783.815,
    "end": 786.963,
    "text": "我们陷入见解分歧、言辞之争"
  },
  {
    "start": 786.963,
    "end": 788.174,
    "text": "我无法否认"
  },
  {
    "start": 788.174,
    "end": 792.049,
    "text": "我的爱之言辞悖于乔达摩的法义"
  },
  {
    "start": 792.049,
    "end": 795.697,
    "text": "为此我十分怀疑言辞 因为我知道"
  },
  {
    "start": 795.697,
    "end": 798.661,
    "text": "这种悖论只是幻象 我知道"
  },
  {
    "start": 798.661,
    "end": 800.713,
    "text": "我同乔达摩信念一致"
  },
  {
    "start": 800.713,
    "end": 802.547,
    "text": "他怎会不了解爱"
  },
  {
    "start": 802.547,
    "end": 805.428,
    "text": "他熟稔人性的无常、空幻"
  },
  {
    "start": 805.428,
    "end": 810.667,
    "text": "却依然深爱并倾尽一生去助佑、教导世人"
  },
  {
    "start": 810.667,
    "end": 814.643,
    "text": "在我看来 在这位伟大的导师心中"
  },
  {
    "start": 814.643,
    "end": 816.632,
    "text": "爱事物胜于爱言辞"
  },
  {
    "start": 816.632,
    "end": 820.111,
    "text": "他的作为和生命重于他的法义"
  },
  {
    "start": 820.111,
    "end": 821.791,
    "text": "他的仪态重于言论"
  },
  {
    "start": 821.791,
    "end": 827.88,
    "text": "我认为他的伟大不在他的法义中、思想中而在他的生命中"
  },
  {
    "start": 828.128,
    "end": 832.562,
    "text": "两位老人久久沉默后 乔文达鞠躬道别"
  },
  {
    "start": 832.562,
    "end": 835.517,
    "text": "他道： 我感谢你 悉达多"
  },
  {
    "start": 835.517,
    "end": 837.607,
    "text": "感谢你说出你的想法"
  },
  {
    "start": 837.607,
    "end": 840.161,
    "text": "一些奇特的想法我不能"
  },
  {
    "start": 840.161,
    "end": 843.951,
    "text": "马上领悟 顺其自然 我感谢你"
  },
  {
    "start": 843.951,
    "end": 845.135,
    "text": "祝你平安"
  },
  {
    "start": 845.383,
    "end": 853.087,
    "text": "可他心中暗自思量的是：悉达多是位怪人他所言甚为古怪 他的学说显得疯狂"
  },
  {
    "start": 853.087,
    "end": 857.247,
    "text": "世尊的精辟法义则明了、简洁、易懂"
  },
  {
    "start": 857.247,
    "end": 860.887,
    "text": "不含任何古怪疯狂或荒谬的内容"
  },
  {
    "start": 860.887,
    "end": 863.226,
    "text": "但悉达多的手脚"
  },
  {
    "start": 863.226,
    "end": 865.03,
    "text": "他的双眼、额头"
  },
  {
    "start": 865.03,
    "end": 872.501,
    "text": "他的微笑、问候和姿态却不同于他的思想自世尊佛陀步入涅槃"
  },
  {
    "start": 872.501,
    "end": 875.689,
    "text": "悉达多是唯一一位我见过的圣人"
  },
  {
    "start": 875.689,
    "end": 879.561,
    "text": "他让我感受到他的神圣 他学说古怪"
  },
  {
    "start": 879.561,
    "end": 880.7,
    "text": "言辞疯狂"
  },
  {
    "start": 880.7,
    "end": 882.265,
    "text": "但自从佛陀圆寂"
  },
  {
    "start": 882.265,
    "end": 885.173,
    "text": "我尚未在他人身上见到如悉达"
  },
  {
    "start": 885.173,
    "end": 888.529,
    "text": "多般的目光、手足、皮肤、头发"
  },
  {
    "start": 888.529,
    "end": 890.83,
    "text": "他周身释放的纯洁、"
  },
  {
    "start": 890.83,
    "end": 893.643,
    "text": "安宁、光明、祥和与神圣"
  },
  {
    "start": 893.891,
    "end": 897.18,
    "text": "乔文达思量着 内心十分矛盾"
  },
  {
    "start": 897.18,
    "end": 900.0,
    "text": "爱驱使他再次向悉达多鞠躬"
  },
  {
    "start": 900.0,
    "end": 903.564,
    "text": "向这位平静端坐之人深深致敬"
  },
  {
    "start": 903.812,
    "end": 907.42,
    "text": "“悉达多 ”他道 “我们老了"
  },
  {
    "start": 907.42,
    "end": 909.901,
    "text": "恐怕再难相见 亲爱的"
  },
  {
    "start": 909.901,
    "end": 911.706,
    "text": "我认为你已寻得安宁"
  },
  {
    "start": 911.706,
    "end": 914.462,
    "text": "而我尚未收获 敬爱的人"
  },
  {
    "start": 914.462,
    "end": 918.596,
    "text": "为我再讲几句我能领悟的话 送我上路"
  },
  {
    "start": 918.596,
    "end": 919.285,
    "text": "悉达多"
  },
  {
    "start": 919.285,
    "end": 922.769,
    "text": "我的路时常艰难 时常昏暗"
  },
  {
    "start": 923.017,
    "end": 924.5,
    "text": "悉达多默默地"
  },
  {
    "start": 924.5,
    "end": 927.218,
    "text": "以惯常的平静微笑望向他"
  },
  {
    "start": 927.218,
    "end": 931.666,
    "text": "乔文达注视他的脸 带着畏惧与渴望"
  },
  {
    "start": 931.666,
    "end": 933.484,
    "text": "他眼中写满痛楚"
  },
  {
    "start": 933.484,
    "end": 937.12,
    "text": "写满永恒的探求和永恒的失落"
  },
  {
    "start": 937.368,
    "end": 939.922,
    "text": "悉达多看在眼里 微笑着"
  },
  {
    "start": 940.17,
    "end": 944.576,
    "text": "“弯下腰 ”他轻声道 “过来弯下腰"
  },
  {
    "start": 944.576,
    "end": 948.519,
    "text": "再近些 近些 吻我的额头 乔文达"
  },
  {
    "start": 948.767,
    "end": 950.357,
    "text": "乔文达十分惊讶"
  },
  {
    "start": 950.357,
    "end": 954.217,
    "text": "但爱和一种预感驱使他遵照悉达多的话"
  },
  {
    "start": 954.217,
    "end": 957.396,
    "text": "弯腰凑近他 亲吻他的额头"
  },
  {
    "start": 957.396,
    "end": 959.734,
    "text": "这时 奇迹发生了"
  },
  {
    "start": 959.734,
    "end": 963.37,
    "text": "在他仍思量悉达多古怪的言辞时"
  },
  {
    "start": 963.37,
    "end": 966.197,
    "text": "在他徒劳地试图抛却时间、"
  },
  {
    "start": 966.197,
    "end": 969.024,
    "text": "想象涅槃与轮回是为一体时"
  },
  {
    "start": 969.024,
    "end": 971.87,
    "text": "在他对悉达多言辞的蔑视和"
  },
  {
    "start": 971.87,
    "end": 976.138,
    "text": "对他强烈的爱与敬重对峙时发生了奇迹"
  },
  {
    "start": 976.386,
    "end": 978.572,
    "text": "他不再看见悉达多的脸"
  },
  {
    "start": 978.572,
    "end": 981.849,
    "text": "他看见许多旁人的脸 长长一队"
  },
  {
    "start": 981.849,
    "end": 984.69,
    "text": "他看见一条奔腾的面孔之河"
  },
  {
    "start": 984.69,
    "end": 987.584,
    "text": "成百上千张脸生成、寂灭"
  },
  {
    "start": 987.584,
    "end": 989.688,
    "text": "又同时存在、展现"
  },
  {
    "start": 989.688,
    "end": 993.634,
    "text": "这些脸持续地改变着、更新着"
  },
  {
    "start": 993.634,
    "end": 997.573,
    "text": "却又都是悉达多的脸 他看见鱼的脸"
  },
  {
    "start": 997.573,
    "end": 1001.048,
    "text": "一条将死的鲤鱼不断张开痛苦的嘴"
  },
  {
    "start": 1001.048,
    "end": 1009.013,
    "text": "鱼眼泛白——他看见新生婴儿的脸抽搐着红润 满是褶皱——他看见凶手的脸"
  },
  {
    "start": 1009.013,
    "end": 1012.272,
    "text": "看见他将匕首刺入另一人体内——他"
  },
  {
    "start": 1012.272,
    "end": 1015.532,
    "text": "看见同一秒内凶手被捆绑着跪倒在地"
  },
  {
    "start": 1015.532,
    "end": 1017.583,
    "text": "刽子手一刀砍下他的"
  },
  {
    "start": 1017.583,
    "end": 1021.686,
    "text": "头颅——他看见赤裸的男女以各种体位"
  },
  {
    "start": 1021.686,
    "end": 1024.129,
    "text": "爱恨交织着行云雨之事"
  },
  {
    "start": 1024.129,
    "end": 1030.97,
    "text": "——他看见横陈的尸首无声 冰冷 空乏——他看见动物的头"
  },
  {
    "start": 1030.97,
    "end": 1034.658,
    "text": "猪头 鳄鱼头 象头 牛头"
  },
  {
    "start": 1034.658,
    "end": 1037.854,
    "text": "鸟头——他看见诸神 克利须那神"
  },
  {
    "start": 1037.854,
    "end": 1041.335,
    "text": "阿格尼神——他看见千万人和"
  },
  {
    "start": 1041.335,
    "end": 1047.763,
    "text": "他们的脸以万千方式交织一处他们互助 相爱 相恨"
  },
  {
    "start": 1047.763,
    "end": 1051.987,
    "text": "他们寂灭 重生 他们满是死意"
  },
  {
    "start": 1051.987,
    "end": 1055.42,
    "text": "满是对无常强烈而痛苦的信奉"
  },
  {
    "start": 1055.42,
    "end": 1057.532,
    "text": "可他们无一人死灭"
  },
  {
    "start": 1057.532,
    "end": 1061.023,
    "text": "只是变化 新生 重获新脸"
  },
  {
    "start": 1061.023,
    "end": 1064.264,
    "text": "并无时间位于这张脸和过去的"
  },
  {
    "start": 1064.264,
    "end": 1067.256,
    "text": "脸之间——所有形象和脸静止"
  },
  {
    "start": 1067.256,
    "end": 1071.875,
    "text": "流动 自我孕育 漂游 彼此融合"
  },
  {
    "start": 1071.875,
    "end": 1074.441,
    "text": "这一切之上持久回旋着"
  },
  {
    "start": 1074.441,
    "end": 1076.75,
    "text": "稀薄的、不实又实在之物"
  },
  {
    "start": 1076.75,
    "end": 1078.411,
    "text": "有如薄冰或玻璃"
  },
  {
    "start": 1078.411,
    "end": 1080.784,
    "text": "有如透明的皮肤或薄纱"
  },
  {
    "start": 1080.784,
    "end": 1083.869,
    "text": "有如一种水的形式与面具"
  },
  {
    "start": 1083.869,
    "end": 1085.946,
    "text": "这面具是悉达多的脸"
  },
  {
    "start": 1085.946,
    "end": 1088.715,
    "text": "是乔文达亲吻他额头的瞬间"
  },
  {
    "start": 1088.715,
    "end": 1092.868,
    "text": "他微笑的脸 乔文达看见面具的微笑"
  },
  {
    "start": 1092.868,
    "end": 1096.993,
    "text": "这微笑同时覆盖千万新生与死亡"
  },
  {
    "start": 1096.993,
    "end": 1101.706,
    "text": "这微笑安详、纯洁、微妙 或慈悲"
  },
  {
    "start": 1101.706,
    "end": 1104.357,
    "text": "或嘲弄 充满智慧"
  },
  {
    "start": 1104.357,
    "end": 1106.504,
    "text": "和乔达摩的微笑一致"
  },
  {
    "start": 1106.504,
    "end": 1109.604,
    "text": "就像他千百次以敬畏之心亲眼"
  },
  {
    "start": 1109.604,
    "end": 1113.182,
    "text": "所见的佛陀乔达摩的千百种微笑"
  },
  {
    "start": 1113.182,
    "end": 1116.026,
    "text": "乔文达知道 这是圆成者之笑"
  },
  {
    "start": 1116.274,
    "end": 1118.795,
    "text": "乔文达不知时间是否存在"
  },
  {
    "start": 1118.795,
    "end": 1122.005,
    "text": "不知这情境持续了一秒还是百年"
  },
  {
    "start": 1122.005,
    "end": 1124.298,
    "text": "不知是否有悉达多"
  },
  {
    "start": 1124.298,
    "end": 1127.9,
    "text": "有乔达摩 是否有“我”和“你”"
  },
  {
    "start": 1127.9,
    "end": 1130.601,
    "text": "乔文达的心似乎被神箭射中"
  },
  {
    "start": 1130.601,
    "end": 1132.177,
    "text": "伤口却流着蜜"
  },
  {
    "start": 1132.177,
    "end": 1134.93,
    "text": "他陶醉着 释放着喜悦"
  },
  {
    "start": 1134.93,
    "end": 1137.433,
    "text": "他伫立片刻后俯身望向"
  },
  {
    "start": 1137.433,
    "end": 1140.186,
    "text": "刚刚亲吻过的悉达多的脸"
  },
  {
    "start": 1140.186,
    "end": 1143.752,
    "text": "望向悉达多刚刚呈现了一切形象"
  },
  {
    "start": 1143.752,
    "end": 1147.573,
    "text": "一切将成者、存在者和过往者的脸"
  },
  {
    "start": 1147.573,
    "end": 1149.865,
    "text": "这张脸并未改变"
  },
  {
    "start": 1149.865,
    "end": 1152.424,
    "text": "万千幻象从表面退去后"
  },
  {
    "start": 1152.424,
    "end": 1157.287,
    "text": "他的微笑平静、轻柔 或慈悲 或嘲讽"
  },
  {
    "start": 1157.287,
    "end": 1159.079,
    "text": "正如佛陀的微笑"
  },
  {
    "start": 1159.327,
    "end": 1160.961,
    "text": "乔文达深深鞠躬"
  },
  {
    "start": 1160.961,
    "end": 1164.696,
    "text": "泪水在不知不觉中流满他苍老的脸"
  },
  {
    "start": 1164.696,
    "end": 1166.895,
    "text": "如同火焰点燃他心中"
  },
  {
    "start": 1166.895,
    "end": 1174.225,
    "text": "最深的爱和最谦卑的敬意他深深地鞠躬到地 向端坐的悉达多致意"
  },
  {
    "start": 1174.225,
    "end": 1182.344,
    "text": "悉达多的微笑让他忆起一生中爱过的一切忆起一生中宝贵和神圣的一切"
  }
]