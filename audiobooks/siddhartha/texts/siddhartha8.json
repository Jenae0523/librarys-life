[
  {
    "start": 0.0,
    "end": 1.999,
    "text": "第八章 在河边"
  },
  {
    "start": 1.999,
    "end": 6.585,
    "text": "悉达多远离城邑 步入林中 他只清楚"
  },
  {
    "start": 6.585,
    "end": 10.448,
    "text": "他不会再回去 多年的生活已一去不返"
  },
  {
    "start": 10.448,
    "end": 14.607,
    "text": "他尝够这生活的滋味 到了恶心的地步"
  },
  {
    "start": 14.607,
    "end": 18.767,
    "text": "他梦中的知更鸟死了 他心中的鸟也死了"
  },
  {
    "start": 18.767,
    "end": 20.92,
    "text": "他深困于轮回的牢笼"
  },
  {
    "start": 20.92,
    "end": 23.074,
    "text": "似一块吸饱水的海绵"
  },
  {
    "start": 23.074,
    "end": 27.621,
    "text": "他尝够厌恶和死亡的味道 他浑身腻烦"
  },
  {
    "start": 27.621,
    "end": 30.36,
    "text": "浑身痛苦 浑身充满死意"
  },
  {
    "start": 30.36,
    "end": 34.47,
    "text": "世上再没什么能诱惑他 愉悦他 安抚他"
  },
  {
    "start": 34.47,
    "end": 39.026,
    "text": "他只盼忘掉自己 得到安宁 甚至死去"
  },
  {
    "start": 39.026,
    "end": 41.904,
    "text": "只求闪电击毙他 虎狼吞噬他"
  },
  {
    "start": 41.904,
    "end": 46.238,
    "text": "只求一杯毒酒麻醉他 让他遗忘、沉睡"
  },
  {
    "start": 46.238,
    "end": 50.573,
    "text": "永不醒来 这世上还有哪种秽迹他没习染"
  },
  {
    "start": 50.573,
    "end": 53.694,
    "text": "还有什么罪孽和蠢行他没触及"
  },
  {
    "start": 53.694,
    "end": 57.536,
    "text": "还有哪一隅灵魂的荒蛮之地他没驻足"
  },
  {
    "start": 57.536,
    "end": 59.217,
    "text": "他岂能再活"
  },
  {
    "start": 59.217,
    "end": 64.033,
    "text": "再呼吸 再感觉饥饿 再吃 再睡"
  },
  {
    "start": 64.033,
    "end": 65.638,
    "text": "再和女人同笫"
  },
  {
    "start": 65.638,
    "end": 68.581,
    "text": "这轮回不是耗尽和桎梏了他"
  },
  {
    "start": 68.581,
    "end": 71.391,
    "text": "悉达多抵达河畔 年轻时"
  },
  {
    "start": 71.391,
    "end": 73.966,
    "text": "他从乔达摩的舍卫城中来"
  },
  {
    "start": 73.966,
    "end": 76.775,
    "text": "有位船夫曾在此渡他过岸"
  },
  {
    "start": 76.775,
    "end": 78.263,
    "text": "他疑虑着驻足"
  },
  {
    "start": 78.263,
    "end": 81.734,
    "text": "被疲倦和饥饿折磨：为何继续走"
  },
  {
    "start": 81.734,
    "end": 84.709,
    "text": "去哪里 有何目标 不"
  },
  {
    "start": 84.709,
    "end": 88.964,
    "text": "除了深切悲痛地盼着抛却极度荒芜的梦"
  },
  {
    "start": 88.964,
    "end": 93.468,
    "text": "倾吐陈腐的酒 终结可怜又可耻的生活"
  },
  {
    "start": 93.468,
    "end": 94.967,
    "text": "他没有别的目标"
  },
  {
    "start": 94.967,
    "end": 98.49,
    "text": "河畔一株椰子树的枝干伸向河面"
  },
  {
    "start": 98.49,
    "end": 103.02,
    "text": "悉达多倚着树 抱住枝干 俯视碧波"
  },
  {
    "start": 103.02,
    "end": 104.027,
    "text": "河水湍急"
  },
  {
    "start": 104.027,
    "end": 108.621,
    "text": "他俯视着 心中升腾强烈的愿望：撒手"
  },
  {
    "start": 108.621,
    "end": 113.215,
    "text": "坠入河中 河水映出他灵魂骇人的空虚"
  },
  {
    "start": 113.215,
    "end": 113.471,
    "text": "是"
  },
  {
    "start": 113.471,
    "end": 116.828,
    "text": "他已走到尽头 除了毁掉自我"
  },
  {
    "start": 116.828,
    "end": 118.747,
    "text": "将失败的生活粉碎"
  },
  {
    "start": 118.747,
    "end": 122.585,
    "text": "抛到狂笑的诸神脚下 他别无他途"
  },
  {
    "start": 122.585,
    "end": 126.417,
    "text": "这不正是他期盼的呕吐的狂澜：去死"
  },
  {
    "start": 126.417,
    "end": 130.249,
    "text": "粉碎他憎恶的肉体 让它被鱼吃掉"
  },
  {
    "start": 130.249,
    "end": 133.414,
    "text": "这发疯、堕落而腐朽的肉体"
  },
  {
    "start": 133.414,
    "end": 137.899,
    "text": "这凋敝尽耗的灵魂 这条悉达多的狗"
  },
  {
    "start": 137.899,
    "end": 140.273,
    "text": "愿它被鱼或鳄撕咬"
  },
  {
    "start": 140.273,
    "end": 142.087,
    "text": "愿它被恶魔扯碎"
  },
  {
    "start": 142.087,
    "end": 145.281,
    "text": "他神色扭曲地瞪着河水中倒映的脸"
  },
  {
    "start": 145.281,
    "end": 149.326,
    "text": "呕吐起来 他虚弱地松开抱住枝干的双臂"
  },
  {
    "start": 149.326,
    "end": 154.249,
    "text": "轻微旋转身躯 好垂直入水 好沉溺"
  },
  {
    "start": 154.249,
    "end": 157.805,
    "text": "他紧闭双眼 跌下去 迎接死亡"
  },
  {
    "start": 157.805,
    "end": 160.685,
    "text": "这时 自灵魂荒芜的一隅"
  },
  {
    "start": 160.685,
    "end": 164.284,
    "text": "自往昔颓废的生活中传来一个声音"
  },
  {
    "start": 164.284,
    "end": 166.204,
    "text": "这声音是一个字"
  },
  {
    "start": 166.204,
    "end": 169.133,
    "text": "一个音节 是神圣的唵"
  },
  {
    "start": 169.133,
    "end": 173.15,
    "text": "是婆罗门祷辞中起始与收束的古老之音"
  },
  {
    "start": 173.15,
    "end": 175.986,
    "text": "它常意味“圆满”“完成”"
  },
  {
    "start": 175.986,
    "end": 178.112,
    "text": "他喃喃脱口而出"
  },
  {
    "start": 178.112,
    "end": 181.258,
    "text": "就在“唵”字之音擦过耳畔的瞬间"
  },
  {
    "start": 181.258,
    "end": 183.355,
    "text": "他长眠的魂魄猛然复苏"
  },
  {
    "start": 183.355,
    "end": 185.662,
    "text": "他辨认出自己的蠢行"
  },
  {
    "start": 185.662,
    "end": 187.447,
    "text": "悉达多深感惊恐"
  },
  {
    "start": 187.447,
    "end": 191.529,
    "text": "这正是他的境况：绝望 步入歧途"
  },
  {
    "start": 191.529,
    "end": 194.081,
    "text": "抛弃智识 甚至求死"
  },
  {
    "start": 194.081,
    "end": 196.766,
    "text": "这幼稚的求死之心不断滋生"
  },
  {
    "start": 196.766,
    "end": 199.9,
    "text": "乃至行将摆脱肉体 求得安宁"
  },
  {
    "start": 199.9,
    "end": 202.829,
    "text": "唵字迫入意志的强烈远胜"
  },
  {
    "start": 202.829,
    "end": 205.759,
    "text": "于近来悔恨和死意的折磨"
  },
  {
    "start": 205.759,
    "end": 208.089,
    "text": "这一刻促成他在不幸"
  },
  {
    "start": 208.089,
    "end": 210.678,
    "text": "中、在癫狂中认清自己"
  },
  {
    "start": 210.678,
    "end": 214.06,
    "text": "他又认识了阿特曼 不灭的生命"
  },
  {
    "start": 214.06,
    "end": 216.992,
    "text": "认识了一切他遗忘的神圣事物"
  },
  {
    "start": 216.992,
    "end": 220.01,
    "text": "可这只是刹那 是一道闪电"
  },
  {
    "start": 220.01,
    "end": 222.332,
    "text": "悉达多跌落在椰子树下"
  },
  {
    "start": 222.332,
    "end": 225.351,
    "text": "他疲倦地仰面朝天 念着唵"
  },
  {
    "start": 225.351,
    "end": 228.05,
    "text": "头枕树根沉沉睡去"
  },
  {
    "start": 228.05,
    "end": 230.791,
    "text": "他许久没如此无梦地酣睡过"
  },
  {
    "start": 230.791,
    "end": 233.761,
    "text": "多时后醒来 仿佛过了十年"
  },
  {
    "start": 233.761,
    "end": 236.274,
    "text": "他听见河水温柔地涌动"
  },
  {
    "start": 236.274,
    "end": 240.094,
    "text": "不知身在何处 不知谁引领他前来"
  },
  {
    "start": 240.094,
    "end": 241.049,
    "text": "睁开双眼"
  },
  {
    "start": 241.049,
    "end": 245.108,
    "text": "他惊讶地望着头顶的大树和苍天回想"
  },
  {
    "start": 245.108,
    "end": 249.834,
    "text": "可往事蒙着面纱 默然立于无限的远方"
  },
  {
    "start": 249.834,
    "end": 251.147,
    "text": "他想了许久"
  },
  {
    "start": 251.147,
    "end": 253.464,
    "text": "只记起他放弃了过去的"
  },
  {
    "start": 253.464,
    "end": 257.866,
    "text": "生活——在恢复意识的最初往日有如前世"
  },
  {
    "start": 257.866,
    "end": 260.73,
    "text": "或当下之“我”的早产——他"
  },
  {
    "start": 260.73,
    "end": 265.355,
    "text": "记起他迫切要丢弃浑身的烦腻与愁闷甚至赴死"
  },
  {
    "start": 265.355,
    "end": 268.114,
    "text": "他记起他在河边的椰子树下"
  },
  {
    "start": 268.114,
    "end": 273.63,
    "text": "在神圣的“唵”字脱口而出时复活、苏醒环顾世界"
  },
  {
    "start": 273.63,
    "end": 276.172,
    "text": "他轻吟令他沉睡的唵音"
  },
  {
    "start": 276.172,
    "end": 280.241,
    "text": "睡眠于他不过是一声深意又专注的唵"
  },
  {
    "start": 280.241,
    "end": 282.784,
    "text": "一次“唵”的思考"
  },
  {
    "start": 282.784,
    "end": 288.423,
    "text": "一次隐匿又全然抵达的唵——那无名之地圆满之地"
  },
  {
    "start": 288.423,
    "end": 290.221,
    "text": "多么畅快的酣睡"
  },
  {
    "start": 290.221,
    "end": 293.817,
    "text": "没有哪次睡眠让他如此焕发神采"
  },
  {
    "start": 293.817,
    "end": 296.642,
    "text": "重获新生 恢复青春"
  },
  {
    "start": 296.642,
    "end": 298.156,
    "text": "或许他真的死了"
  },
  {
    "start": 298.156,
    "end": 301.832,
    "text": "又从一具新的躯壳中再生 并非如此"
  },
  {
    "start": 301.832,
    "end": 305.076,
    "text": "他认得自己 他认得自己的手脚"
  },
  {
    "start": 305.076,
    "end": 308.572,
    "text": "认得此处 认得他胸中的“我”"
  },
  {
    "start": 308.572,
    "end": 312.768,
    "text": "执拗怪异的悉达多 可这悉达多已变形"
  },
  {
    "start": 312.768,
    "end": 313.7,
    "text": "脱胎换骨"
  },
  {
    "start": 313.7,
    "end": 317.444,
    "text": "他奇异地睡去又清醒 愉快又好奇"
  },
  {
    "start": 317.444,
    "end": 318.624,
    "text": "悉达多起身"
  },
  {
    "start": 318.624,
    "end": 322.635,
    "text": "见对面坐着一位穿黄色僧衣的陌生和尚"
  },
  {
    "start": 322.635,
    "end": 324.758,
    "text": "他仿佛正在禅定"
  },
  {
    "start": 324.758,
    "end": 326.902,
    "text": "悉达多打量起这位既"
  },
  {
    "start": 326.902,
    "end": 333.572,
    "text": "无头发又无胡须的僧人很快 他认出他是自己青年时代的朋友"
  },
  {
    "start": 333.572,
    "end": 336.51,
    "text": "皈依佛陀的乔文达 同样"
  },
  {
    "start": 336.51,
    "end": 340.672,
    "text": "乔文达也老了 可他神色依旧：热切"
  },
  {
    "start": 340.672,
    "end": 341.896,
    "text": "忠贞 审慎"
  },
  {
    "start": 341.896,
    "end": 345.293,
    "text": "乔文达这时有所觉察 睁开双眼"
  },
  {
    "start": 345.293,
    "end": 348.236,
    "text": "他见悉达多已醒 十分高兴"
  },
  {
    "start": 348.236,
    "end": 350.5,
    "text": "他仿佛一直在等他醒来"
  },
  {
    "start": 350.5,
    "end": 352.759,
    "text": "尽管他并未认出悉达多"
  },
  {
    "start": 352.759,
    "end": 355.078,
    "text": "“我睡着了 ”悉达多道"
  },
  {
    "start": 355.078,
    "end": 356.624,
    "text": "“你怎会在此 ”"
  },
  {
    "start": 356.624,
    "end": 359.238,
    "text": "“你睡着了 ”乔文达道"
  },
  {
    "start": 359.238,
    "end": 362.724,
    "text": "睡在蛇和野兽时常出没的地方不好"
  },
  {
    "start": 362.724,
    "end": 363.378,
    "text": "先生"
  },
  {
    "start": 363.378,
    "end": 367.294,
    "text": "我是世尊乔达摩、佛陀释迦摩尼的弟子"
  },
  {
    "start": 367.294,
    "end": 368.907,
    "text": "我们僧人去朝圣"
  },
  {
    "start": 368.907,
    "end": 371.902,
    "text": "见你躺在这危险之处酣睡"
  },
  {
    "start": 371.902,
    "end": 376.07,
    "text": "先生 我试图唤醒你 你却睡得深沉"
  },
  {
    "start": 376.07,
    "end": 379.313,
    "text": "我留下守候你 可我并不称职"
  },
  {
    "start": 379.313,
    "end": 380.471,
    "text": "我好像睡着了"
  },
  {
    "start": 380.471,
    "end": 383.83,
    "text": "疲惫战胜了我 尽管我本想守候你"
  },
  {
    "start": 383.83,
    "end": 386.14,
    "text": "现在你醒了 我该走了"
  },
  {
    "start": 386.14,
    "end": 388.03,
    "text": "去追赶我的弟兄"
  },
  {
    "start": 388.03,
    "end": 390.277,
    "text": "悉达多道  我感谢你"
  },
  {
    "start": 390.277,
    "end": 392.32,
    "text": "沙门 感谢你守候我"
  },
  {
    "start": 392.32,
    "end": 395.589,
    "text": "你们佛陀弟子良善 那么你走吧"
  },
  {
    "start": 395.589,
    "end": 398.025,
    "text": "乔文达施礼道： 我走了"
  },
  {
    "start": 398.025,
    "end": 400.903,
    "text": "先生 愿你安康 再会"
  },
  {
    "start": 400.903,
    "end": 403.827,
    "text": "“再会 乔文达 ”悉达多道"
  },
  {
    "start": 403.827,
    "end": 405.176,
    "text": "僧人驻足"
  },
  {
    "start": 405.176,
    "end": 406.107,
    "text": "允许的话"
  },
  {
    "start": 406.107,
    "end": 409.27,
    "text": "先生 请问你怎会知道我的名字"
  },
  {
    "start": 409.27,
    "end": 410.494,
    "text": "悉达多笑了"
  },
  {
    "start": 410.494,
    "end": 414.782,
    "text": "我认得你 乔文达 在你父亲的屋舍"
  },
  {
    "start": 414.782,
    "end": 417.038,
    "text": "在婆罗门学园 在祭祀中"
  },
  {
    "start": 417.038,
    "end": 419.058,
    "text": "在我们追随沙门的路上"
  },
  {
    "start": 419.058,
    "end": 422.692,
    "text": "在祗树给孤独园你皈依世尊的时刻"
  },
  {
    "start": 422.692,
    "end": 425.745,
    "text": "“你是悉达多 ”乔文达叫道"
  },
  {
    "start": 425.745,
    "end": 428.143,
    "text": "我认出你 我不明白"
  },
  {
    "start": 428.143,
    "end": 430.977,
    "text": "我为何没立即认出你 悉达多"
  },
  {
    "start": 430.977,
    "end": 433.276,
    "text": "与你重逢我十分高兴"
  },
  {
    "start": 433.276,
    "end": 436.951,
    "text": "悉达多道  与你重逢我也十分高兴"
  },
  {
    "start": 436.951,
    "end": 439.545,
    "text": "我要再次感谢你刚才的守候"
  },
  {
    "start": 439.545,
    "end": 441.275,
    "text": "尽管我无需守候"
  },
  {
    "start": 441.275,
    "end": 443.169,
    "text": "你去哪里 我的朋友"
  },
  {
    "start": 443.169,
    "end": 446.363,
    "text": "乔文达回答  我没有目的地"
  },
  {
    "start": 446.363,
    "end": 450.47,
    "text": "我们僧人总在路上 生活规律 宣法"
  },
  {
    "start": 450.47,
    "end": 451.383,
    "text": "祈食 赶路"
  },
  {
    "start": 451.383,
    "end": 454.576,
    "text": "雨季后 我们从一处赶往另一处"
  },
  {
    "start": 454.576,
    "end": 458.407,
    "text": "一贯如此 你呢 悉达多 你去何处"
  },
  {
    "start": 458.407,
    "end": 460.637,
    "text": "悉达多道： 我亦如此"
  },
  {
    "start": 460.637,
    "end": 462.866,
    "text": "朋友 我没有目的地"
  },
  {
    "start": 462.866,
    "end": 465.096,
    "text": "我在求道的路上"
  },
  {
    "start": 465.096,
    "end": 469.063,
    "text": "乔文达道： 你说你去求道 我相信你"
  },
  {
    "start": 469.063,
    "end": 471.266,
    "text": "但请原谅我 悉达多"
  },
  {
    "start": 471.266,
    "end": 473.47,
    "text": "你看上去不像求道之人"
  },
  {
    "start": 473.47,
    "end": 477.129,
    "text": "你穿着富人的衣裳和鞋子 你头发飘香"
  },
  {
    "start": 477.129,
    "end": 479.974,
    "text": "这不像求道者 也不是沙门"
  },
  {
    "start": 479.974,
    "end": 483.205,
    "text": "悉达多回答  是 亲爱的"
  },
  {
    "start": 483.205,
    "end": 487.128,
    "text": "你看得仔细 你锐利的双眼看穿一切"
  },
  {
    "start": 487.128,
    "end": 488.743,
    "text": "我并未说我是沙门"
  },
  {
    "start": 488.743,
    "end": 492.157,
    "text": "我说我去求道 正是 我去求道"
  },
  {
    "start": 492.157,
    "end": 495.078,
    "text": "乔文达疑惑地问  你去求道"
  },
  {
    "start": 495.078,
    "end": 497.164,
    "text": "但鲜有求道者如此打扮"
  },
  {
    "start": 497.164,
    "end": 499.667,
    "text": "我朝圣多年从未见过"
  },
  {
    "start": 499.667,
    "end": 504.036,
    "text": "悉达多回答  我相信你 我的乔文达"
  },
  {
    "start": 504.036,
    "end": 507.486,
    "text": "可是今天 你遇见如此打扮的求道者"
  },
  {
    "start": 507.486,
    "end": 510.375,
    "text": "穿这样的鞋、衣裳 你记得"
  },
  {
    "start": 510.375,
    "end": 512.153,
    "text": "亲爱的：世相无常"
  },
  {
    "start": 512.153,
    "end": 515.71,
    "text": "我们的装扮、发式和身体最为无常"
  },
  {
    "start": 515.71,
    "end": 518.53,
    "text": "你看得不错 我穿富人的衣服"
  },
  {
    "start": 518.53,
    "end": 519.739,
    "text": "因为我曾富有"
  },
  {
    "start": 519.739,
    "end": 521.626,
    "text": "我的发式荒淫俗气"
  },
  {
    "start": 521.626,
    "end": 524.458,
    "text": "因为我曾荒淫俗气"
  },
  {
    "start": 524.458,
    "end": 527.187,
    "text": "乔文达问  可现在 悉达多"
  },
  {
    "start": 527.187,
    "end": 528.642,
    "text": "现在你是什么人"
  },
  {
    "start": 528.642,
    "end": 531.181,
    "text": "悉达多答  我不知道"
  },
  {
    "start": 531.181,
    "end": 534.413,
    "text": "我知道得不比你多 我在路上"
  },
  {
    "start": 534.413,
    "end": 536.721,
    "text": "我曾是富人 现在不是"
  },
  {
    "start": 536.721,
    "end": 539.455,
    "text": "而明天我是什么人 我不知道"
  },
  {
    "start": 539.455,
    "end": 542.779,
    "text": "乔文达继续追问 “你失去了财富吗 ”"
  },
  {
    "start": 542.779,
    "end": 545.639,
    "text": "悉达多道  我失去了财富"
  },
  {
    "start": 545.639,
    "end": 548.499,
    "text": "或财富失去了我 它已不在"
  },
  {
    "start": 548.499,
    "end": 550.698,
    "text": "世相之轮飞转 乔文达"
  },
  {
    "start": 550.698,
    "end": 552.839,
    "text": "婆罗门悉达多在哪里"
  },
  {
    "start": 552.839,
    "end": 554.741,
    "text": "沙门悉达多在哪里"
  },
  {
    "start": 554.741,
    "end": 559.497,
    "text": "富有的悉达多在哪里 无常之物更迭迅速"
  },
  {
    "start": 559.497,
    "end": 561.407,
    "text": "乔文达 这你晓得"
  },
  {
    "start": 561.407,
    "end": 569.266,
    "text": "乔文达疑惑地长久注视他青年时代的朋友他向他致意 如同向一位贵人致意"
  },
  {
    "start": 569.266,
    "end": 571.135,
    "text": "接着继续赶路"
  },
  {
    "start": 571.135,
    "end": 573.935,
    "text": "悉达多微笑着目送他的背影"
  },
  {
    "start": 573.935,
    "end": 576.969,
    "text": "他依然爱乔文达的忠贞审慎"
  },
  {
    "start": 576.969,
    "end": 580.191,
    "text": "这醒后被“唵”充满的神圣时刻"
  },
  {
    "start": 580.191,
    "end": 584.103,
    "text": "他怎能不爱 这睡眠和“唵”的魔术"
  },
  {
    "start": 584.103,
    "end": 588.095,
    "text": "让他喜悦地爱上他所见的一切 此刻"
  },
  {
    "start": 588.095,
    "end": 591.148,
    "text": "他也见到曾经病入膏肓的自己"
  },
  {
    "start": 591.148,
    "end": 593.027,
    "text": "他曾不爱任何人"
  },
  {
    "start": 593.027,
    "end": 594.576,
    "text": "也不爱任何事"
  },
  {
    "start": 594.576,
    "end": 598.141,
    "text": "微笑着 悉达多目送远去的僧人"
  },
  {
    "start": 598.141,
    "end": 601.469,
    "text": "睡眠令他强健 但饥饿折磨他"
  },
  {
    "start": 601.469,
    "end": 602.895,
    "text": "他已两天未食"
  },
  {
    "start": 602.895,
    "end": 605.847,
    "text": "而他抵抗饥饿的能力已丧失许久"
  },
  {
    "start": 605.847,
    "end": 609.854,
    "text": "他伤感又幸福地回忆起他曾跟迦摩罗夸耀"
  },
  {
    "start": 609.854,
    "end": 612.367,
    "text": "他懂三种高贵又制胜的"
  },
  {
    "start": 612.367,
    "end": 619.403,
    "text": "艺术：斋戒、等待、思考这是他的宝 他的力 他不变的支撑"
  },
  {
    "start": 619.403,
    "end": 621.748,
    "text": "他用他勤奋艰辛的全部"
  },
  {
    "start": 621.748,
    "end": 626.672,
    "text": "青年岁月修习这三门艺术如今他却遗弃了它们"
  },
  {
    "start": 626.672,
    "end": 629.232,
    "text": "不再斋戒、等待、思考"
  },
  {
    "start": 629.232,
    "end": 631.792,
    "text": "为了肉体、享乐和财富"
  },
  {
    "start": 631.792,
    "end": 636.657,
    "text": "这些无常之物、卑劣之物他交付了它们"
  },
  {
    "start": 636.657,
    "end": 639.635,
    "text": "他陷入古怪的现实 看来"
  },
  {
    "start": 639.635,
    "end": 641.621,
    "text": "他已真正成为世人"
  },
  {
    "start": 641.621,
    "end": 644.614,
    "text": "悉达多艰难地思考自己的处境"
  },
  {
    "start": 644.614,
    "end": 648.99,
    "text": "尽管他全无思考的兴致 却依旧强行思考"
  },
  {
    "start": 648.99,
    "end": 652.896,
    "text": "那么 他想：无常之物已远离我"
  },
  {
    "start": 652.896,
    "end": 657.324,
    "text": "像儿时一样 我又一无所有 一无所能"
  },
  {
    "start": 657.324,
    "end": 661.198,
    "text": "无力又无知地站在阳光下 多么奇异"
  },
  {
    "start": 661.198,
    "end": 664.34,
    "text": "在青春逝去、两鬓斑白、"
  },
  {
    "start": 664.34,
    "end": 671.767,
    "text": "体力渐衰的时候一切从儿时开始他笑了 我的命运真奇特"
  },
  {
    "start": 671.767,
    "end": 672.767,
    "text": "不断堕落"
  },
  {
    "start": 672.767,
    "end": 676.516,
    "text": "直到空洞、赤裸、愚蠢地立于世间"
  },
  {
    "start": 676.516,
    "end": 680.766,
    "text": "可他并不伤感 不 他甚至想大笑"
  },
  {
    "start": 680.766,
    "end": 684.573,
    "text": "笑古怪愚蠢的世界  你竟走了下坡路"
  },
  {
    "start": 684.573,
    "end": 686.9,
    "text": "他笑着自语 瞥向河面"
  },
  {
    "start": 686.9,
    "end": 689.84,
    "text": "河水也欢歌着一路不断下行"
  },
  {
    "start": 689.84,
    "end": 692.29,
    "text": "他愉快亲切地望着河水"
  },
  {
    "start": 692.29,
    "end": 695.719,
    "text": "这不是那条他想溺亡的河吗"
  },
  {
    "start": 695.719,
    "end": 700.088,
    "text": "是前世 百年前 还是一场梦"
  },
  {
    "start": 700.088,
    "end": 704.35,
    "text": "他想 我的人生之路确实古怪曲折"
  },
  {
    "start": 704.35,
    "end": 708.612,
    "text": "少年时 我只知神明和献祭 青年时"
  },
  {
    "start": 708.612,
    "end": 713.091,
    "text": "我只知苦修、思考和禅定 我渴求梵天"
  },
  {
    "start": 713.091,
    "end": 716.076,
    "text": "崇拜永恒的阿特曼 壮年时"
  },
  {
    "start": 716.076,
    "end": 720.264,
    "text": "我追随忏悔者生活在林中 漠视肉体"
  },
  {
    "start": 720.264,
    "end": 722.48,
    "text": "忍受酷暑严寒和饥饿"
  },
  {
    "start": 722.48,
    "end": 724.516,
    "text": "之后我又奇迹般地与"
  },
  {
    "start": 724.516,
    "end": 727.005,
    "text": "佛陀和他至高的法义相遇"
  },
  {
    "start": 727.005,
    "end": 728.996,
    "text": "关乎圆一世界的真理"
  },
  {
    "start": 728.996,
    "end": 734.969,
    "text": "如血液般在我体内奔涌但我又不得不告别佛陀及其伟大学说"
  },
  {
    "start": 734.969,
    "end": 737.091,
    "text": "我跟迦摩罗学《爱经》"
  },
  {
    "start": 737.091,
    "end": 740.7,
    "text": "跟迦摩施瓦弥学做生意 赚钱又输钱"
  },
  {
    "start": 740.7,
    "end": 742.398,
    "text": "我学会养尊处优"
  },
  {
    "start": 742.398,
    "end": 747.274,
    "text": "满足肉体 我失去精神家园 荒疏思想"
  },
  {
    "start": 747.274,
    "end": 751.637,
    "text": "忘记圆一 不是吗 在这漫长曲折的路上"
  },
  {
    "start": 751.637,
    "end": 753.459,
    "text": "一个男人成了孩子"
  },
  {
    "start": 753.459,
    "end": 755.508,
    "text": "一位思考者成了世人"
  },
  {
    "start": 755.508,
    "end": 758.241,
    "text": "然而这条路又十分美好"
  },
  {
    "start": 758.241,
    "end": 761.01,
    "text": "然而我胸中之鸣鸟尚未死去"
  },
  {
    "start": 761.01,
    "end": 764.471,
    "text": "这是怎样的路 为重新成为孩子"
  },
  {
    "start": 764.471,
    "end": 765.855,
    "text": "为从头再来"
  },
  {
    "start": 765.855,
    "end": 768.652,
    "text": "我必须变蠢、习恶、犯错"
  },
  {
    "start": 768.652,
    "end": 771.703,
    "text": "必须经历厌恶、失望、痛苦"
  },
  {
    "start": 771.703,
    "end": 775.009,
    "text": "可我的心赞许我走这条路"
  },
  {
    "start": 775.009,
    "end": 778.776,
    "text": "我的眼睛为此欢笑 为收获恩宠"
  },
  {
    "start": 778.776,
    "end": 783.296,
    "text": "重新听见唵 为再次酣睡 适时醒来"
  },
  {
    "start": 783.296,
    "end": 784.803,
    "text": "我必须走投无路"
  },
  {
    "start": 784.803,
    "end": 788.442,
    "text": "堕入深渊 直至动了愚蠢的轻生之念"
  },
  {
    "start": 788.442,
    "end": 791.011,
    "text": "为了重新找到内在的阿特曼"
  },
  {
    "start": 791.011,
    "end": 792.937,
    "text": "我必须先成为愚人"
  },
  {
    "start": 792.937,
    "end": 795.729,
    "text": "为了再活 我必须犯罪"
  },
  {
    "start": 795.729,
    "end": 800.296,
    "text": "这条路还会引我去向何方 它如此古怪"
  },
  {
    "start": 800.296,
    "end": 801.311,
    "text": "泥泞不堪"
  },
  {
    "start": 801.311,
    "end": 805.235,
    "text": "或许是个旋回 它自便吧 我愿随它走"
  },
  {
    "start": 805.235,
    "end": 807.5,
    "text": "他感到胸中沸腾着喜悦"
  },
  {
    "start": 807.5,
    "end": 810.789,
    "text": "可这喜悦从何而来 他扪心自问"
  },
  {
    "start": 810.789,
    "end": 812.762,
    "text": "难道是酣眠抚慰了我"
  },
  {
    "start": 812.762,
    "end": 815.394,
    "text": "还是来自“我”口中的唵"
  },
  {
    "start": 815.394,
    "end": 819.357,
    "text": "或者因为我彻底摆脱过去 获得自由"
  },
  {
    "start": 819.357,
    "end": 823.088,
    "text": "像孩子般站在蓝天下 哦 摆脱羁绊"
  },
  {
    "start": 823.088,
    "end": 827.287,
    "text": "自由自在真好 呼吸这洁净的空气真好"
  },
  {
    "start": 827.287,
    "end": 829.988,
    "text": "而我出逃的地方却处处是"
  },
  {
    "start": 829.988,
    "end": 833.181,
    "text": "香膏、香料、酒精和慵懒之气"
  },
  {
    "start": 833.181,
    "end": 836.816,
    "text": "我痛恨那富人、贪婪者和赌徒的世界"
  },
  {
    "start": 836.816,
    "end": 840.905,
    "text": "痛恨在那可怕世界里生活多年的悉达多"
  },
  {
    "start": 840.905,
    "end": 843.369,
    "text": "痛恨那自我放弃、自我"
  },
  {
    "start": 843.369,
    "end": 848.789,
    "text": "毒害、自我折磨的悉达多又老又恶的悉达多 不"
  },
  {
    "start": 848.789,
    "end": 852.132,
    "text": "我不会再重蹈覆辙 我做得不错"
  },
  {
    "start": 852.132,
    "end": 855.698,
    "text": "我必须赞美自己 我终结了自我憎恨"
  },
  {
    "start": 855.698,
    "end": 859.728,
    "text": "终结了可恶荒谬的生活 我赞美你"
  },
  {
    "start": 859.728,
    "end": 863.757,
    "text": "悉达多 愚蠢多年后又能思想和行动"
  },
  {
    "start": 863.757,
    "end": 867.876,
    "text": "又能听见心中鸣鸟的欢歌 又能跟随它"
  },
  {
    "start": 867.876,
    "end": 869.569,
    "text": "他快活地赞美自己"
  },
  {
    "start": 869.569,
    "end": 872.32,
    "text": "好奇地听着腹中饥饿的叫声"
  },
  {
    "start": 872.32,
    "end": 874.524,
    "text": "他庆幸他最近品尝了"
  },
  {
    "start": 874.524,
    "end": 880.644,
    "text": "痛苦、绝望和死亡的味道假如他仍住在绵软温柔的地狱"
  },
  {
    "start": 880.644,
    "end": 884.659,
    "text": "待在迦摩施瓦弥的世界里赢钱、输钱"
  },
  {
    "start": 884.659,
    "end": 887.169,
    "text": "饱食终日 灵魂焦渴"
  },
  {
    "start": 887.169,
    "end": 890.488,
    "text": "那绝望赴死的一刻就不会到来"
  },
  {
    "start": 890.488,
    "end": 894.574,
    "text": "而绝望并未毁灭他 他心中的鸣鸟"
  },
  {
    "start": 894.574,
    "end": 896.873,
    "text": "快乐之源依然活着"
  },
  {
    "start": 896.873,
    "end": 899.534,
    "text": "他感到快乐并为此欢笑"
  },
  {
    "start": 899.534,
    "end": 902.727,
    "text": "白发映衬的脸庞绽放神采"
  },
  {
    "start": 902.727,
    "end": 906.303,
    "text": "他想： 亲口品尝尘世的一切很好"
  },
  {
    "start": 906.303,
    "end": 908.448,
    "text": "尽管孩提时我已知道"
  },
  {
    "start": 908.448,
    "end": 911.071,
    "text": "淫乐和财富不属于善"
  },
  {
    "start": 911.071,
    "end": 915.692,
    "text": "我熟知已久 却刚刚经历 不仅用思想"
  },
  {
    "start": 915.692,
    "end": 915.935,
    "text": "还用"
  },
  {
    "start": 915.935,
    "end": 918.153,
    "text": "眼睛、心灵和肉体经历"
  },
  {
    "start": 918.153,
    "end": 920.594,
    "text": "我庆幸我经历了它"
  },
  {
    "start": 920.594,
    "end": 924.571,
    "text": "他久久深思自己的转变 鸟儿鸣叫着"
  },
  {
    "start": 924.571,
    "end": 926.209,
    "text": "像唱着他的欢歌"
  },
  {
    "start": 926.209,
    "end": 929.718,
    "text": "难道不是这只鸟已在他心中死去"
  },
  {
    "start": 929.718,
    "end": 932.601,
    "text": "难道他没感觉到它的死 不"
  },
  {
    "start": 932.601,
    "end": 934.153,
    "text": "是一些别的死了"
  },
  {
    "start": 934.153,
    "end": 938.367,
    "text": "一些早就渴望死掉的东西死了 那死去的"
  },
  {
    "start": 938.367,
    "end": 942.091,
    "text": "不是他在狂热的忏悔年代要扼杀的我吗"
  },
  {
    "start": 942.091,
    "end": 945.376,
    "text": "难道不是他渺小不安又骄傲的我"
  },
  {
    "start": 945.376,
    "end": 949.26,
    "text": "他一直与之对抗又总是败下阵来的我"
  },
  {
    "start": 949.26,
    "end": 951.445,
    "text": "总是死掉又复活的我"
  },
  {
    "start": 951.445,
    "end": 954.6,
    "text": "禁止欢乐却捕获恐惧的我"
  },
  {
    "start": 954.6,
    "end": 957.203,
    "text": "难道不是今天 在林中"
  },
  {
    "start": 957.203,
    "end": 960.043,
    "text": "在这条可爱的河里寻死的我"
  },
  {
    "start": 960.043,
    "end": 963.829,
    "text": "难道不是因为这死 他才像个孩子"
  },
  {
    "start": 963.829,
    "end": 967.663,
    "text": "充满信任 毫无畏惧又满怀喜悦"
  },
  {
    "start": 967.663,
    "end": 969.556,
    "text": "现在悉达多也明白"
  },
  {
    "start": 969.556,
    "end": 972.631,
    "text": "为何他作为婆罗门和忏悔者时"
  },
  {
    "start": 972.631,
    "end": 975.232,
    "text": "曾徒然地与自我苦斗"
  },
  {
    "start": 975.232,
    "end": 977.453,
    "text": "是太多知识阻碍了他"
  },
  {
    "start": 977.453,
    "end": 981.648,
    "text": "太多神圣诗篇、祭祀礼仪 太多苦修"
  },
  {
    "start": 981.648,
    "end": 983.622,
    "text": "太多作为与挣扎"
  },
  {
    "start": 983.622,
    "end": 988.375,
    "text": "他曾骄傲、聪敏、热切 总是先行一步"
  },
  {
    "start": 988.375,
    "end": 993.128,
    "text": "总是无所不知 充满智慧 神圣贤明"
  },
  {
    "start": 993.128,
    "end": 993.921,
    "text": "他的自我"
  },
  {
    "start": 993.921,
    "end": 996.095,
    "text": "在他的圣徒气质中、"
  },
  {
    "start": 996.095,
    "end": 998.995,
    "text": "傲慢中、精神性中隐藏起来"
  },
  {
    "start": 998.995,
    "end": 1007.399,
    "text": "在他自以为用斋戒和忏悔能扼杀“我”时“我”却盘踞生长着 于是他终于清楚"
  },
  {
    "start": 1007.399,
    "end": 1010.647,
    "text": "任何学问也不能让他获得救赎"
  },
  {
    "start": 1010.647,
    "end": 1013.395,
    "text": "他该听从内心的秘密之音"
  },
  {
    "start": 1013.395,
    "end": 1016.393,
    "text": "为此他不得不步入尘世"
  },
  {
    "start": 1016.393,
    "end": 1020.204,
    "text": "迷失在欲望和权力、女人和金钱中"
  },
  {
    "start": 1020.204,
    "end": 1023.762,
    "text": "成为商人、赌徒、酒鬼和财迷"
  },
  {
    "start": 1023.762,
    "end": 1026.74,
    "text": "直至圣徒和沙门在他心中死去"
  },
  {
    "start": 1026.74,
    "end": 1029.489,
    "text": "他不得不继续那不堪的岁月"
  },
  {
    "start": 1029.489,
    "end": 1031.551,
    "text": "承受厌恶、空虚"
  },
  {
    "start": 1031.551,
    "end": 1034.219,
    "text": "承受沉闷而毫无意义的生活"
  },
  {
    "start": 1034.219,
    "end": 1037.11,
    "text": "直至他最终陷入苦涩的绝望"
  },
  {
    "start": 1037.11,
    "end": 1040.862,
    "text": "直至荒淫且利欲熏心的悉达多死去"
  },
  {
    "start": 1040.862,
    "end": 1045.364,
    "text": "他死了 一个新的悉达多从睡眠中苏醒"
  },
  {
    "start": 1045.364,
    "end": 1049.364,
    "text": "这个新生的悉达多也将衰老 死去"
  },
  {
    "start": 1049.364,
    "end": 1053.613,
    "text": "悉达多将消逝 一切有形之物都将消逝"
  },
  {
    "start": 1053.613,
    "end": 1057.623,
    "text": "可今天他还年轻 还是个孩子 今天"
  },
  {
    "start": 1057.623,
    "end": 1059.627,
    "text": "他是快乐崭新的悉达多"
  },
  {
    "start": 1059.627,
    "end": 1062.838,
    "text": "他思索着、微笑着倾听饥肠辘辘"
  },
  {
    "start": 1062.838,
    "end": 1066.967,
    "text": "感激地倾听蜜蜂嗡嗡 愉快地望向水波"
  },
  {
    "start": 1066.967,
    "end": 1069.545,
    "text": "他从未对一条河如此着迷"
  },
  {
    "start": 1069.545,
    "end": 1073.06,
    "text": "从未发觉河流的奔涌如此悦耳有力"
  },
  {
    "start": 1073.06,
    "end": 1074.701,
    "text": "他似乎觉得"
  },
  {
    "start": 1074.701,
    "end": 1077.809,
    "text": "河水要告诉他一些特别的事情"
  },
  {
    "start": 1077.809,
    "end": 1081.396,
    "text": "一些他从未领悟、尚待领悟的事情"
  },
  {
    "start": 1081.396,
    "end": 1083.07,
    "text": "在这条河中"
  },
  {
    "start": 1083.07,
    "end": 1085.15,
    "text": "他曾想自溺 而今"
  },
  {
    "start": 1085.15,
    "end": 1088.849,
    "text": "那衰老疲惫而绝望的悉达多已经溺亡"
  },
  {
    "start": 1088.849,
    "end": 1091.624,
    "text": "新的悉达多却深爱着湍流"
  },
  {
    "start": 1091.624,
    "end": 1093.353,
    "text": "他决定留在河边"
  }
]