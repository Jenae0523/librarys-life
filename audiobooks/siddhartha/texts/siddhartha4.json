[
  {
    "start": 0.0,
    "end": 1.8940000000000001,
    "text": "第四章 觉醒"
  },
  {
    "start": 2.141,
    "end": 5.563,
    "text": "当悉达多离开觉者佛陀栖居的祗园"
  },
  {
    "start": 5.563,
    "end": 8.301,
    "text": "离开乔文达停留的祗园时"
  },
  {
    "start": 8.301,
    "end": 10.934,
    "text": "他意识到他将自己过去的"
  },
  {
    "start": 10.934,
    "end": 15.005,
    "text": "生活也抛在了身后的祗园他踯躅独行"
  },
  {
    "start": 15.005,
    "end": 18.973,
    "text": "沉吟于充斥内心的情感中 他沉吟着"
  },
  {
    "start": 18.973,
    "end": 21.774,
    "text": "仿佛探入情感深潭之最底端"
  },
  {
    "start": 21.774,
    "end": 25.475,
    "text": "直探及缘由的栖身之所 在他看来"
  },
  {
    "start": 25.475,
    "end": 29.638,
    "text": "认识缘由乃是一种深思 通过这样的深思"
  },
  {
    "start": 29.638,
    "end": 33.068,
    "text": "情感升华为认知 变得牢靠"
  },
  {
    "start": 33.068,
    "end": 35.707,
    "text": "它盘踞内心 熠熠生辉"
  },
  {
    "start": 35.955,
    "end": 38.306,
    "text": "悉达多深思着踯躅独行"
  },
  {
    "start": 38.306,
    "end": 42.538,
    "text": "他确信自己已不再年少 他已成为男人"
  },
  {
    "start": 42.538,
    "end": 43.479,
    "text": "他确信"
  },
  {
    "start": 43.479,
    "end": 46.397,
    "text": "他已如蛇褪去老皮般告别往昔"
  },
  {
    "start": 46.397,
    "end": 50.213,
    "text": "一些一直伴随他 曾经属于他的东西"
  },
  {
    "start": 50.213,
    "end": 54.045,
    "text": "诸如拜师求教的夙愿已不复存在"
  },
  {
    "start": 54.045,
    "end": 58.697,
    "text": "他的最后一位恩师是神圣的世尊佛陀"
  },
  {
    "start": 58.697,
    "end": 62.761,
    "text": "但佛陀的法义也无法挽留他 折服他"
  },
  {
    "start": 63.009,
    "end": 65.123,
    "text": "这位漫步的思考者自问"
  },
  {
    "start": 65.123,
    "end": 70.618,
    "text": "： 你原先打算从法义里从师父处学到什么 你学了很多"
  },
  {
    "start": 70.618,
    "end": 73.149,
    "text": "却无法真正学到的又是什么"
  },
  {
    "start": 73.149,
    "end": 76.312,
    "text": "”他最终发现：“答案是‘我’"
  },
  {
    "start": 76.312,
    "end": 80.122,
    "text": "我要学的即是‘我’的意义及本质"
  },
  {
    "start": 80.122,
    "end": 84.44,
    "text": "‘我’ 是我要摆脱、要制胜的东西"
  },
  {
    "start": 84.44,
    "end": 85.456,
    "text": "‘我’"
  },
  {
    "start": 85.456,
    "end": 89.079,
    "text": "却是我无法制胜 只能欺罔、逃遁"
  },
  {
    "start": 89.079,
    "end": 91.569,
    "text": "只能隐藏的东西 当真"
  },
  {
    "start": 91.569,
    "end": 93.38,
    "text": "世上再没什么别的"
  },
  {
    "start": 93.38,
    "end": 97.888,
    "text": "像我的‘我’这样让我费解 是‘我’"
  },
  {
    "start": 97.888,
    "end": 101.894,
    "text": "这个谜 让我活着 让我有别于他人"
  },
  {
    "start": 101.894,
    "end": 104.663,
    "text": "让我成为悉达多 在世上"
  },
  {
    "start": 104.663,
    "end": 107.662,
    "text": "我最一无所知的莫过于‘我’"
  },
  {
    "start": 107.662,
    "end": 109.739,
    "text": "莫过于悉达多"
  },
  {
    "start": 109.986,
    "end": 113.866,
    "text": "这位漫步者被这种思绪捕获 他驻足"
  },
  {
    "start": 113.866,
    "end": 117.185,
    "text": "旋即又从这种思绪跃至另一种新"
  },
  {
    "start": 117.185,
    "end": 121.69,
    "text": "的思绪中： 我对自己一无所知一直以来"
  },
  {
    "start": 121.69,
    "end": 125.874,
    "text": "悉达多于我极为陌生 只因我害怕自己"
  },
  {
    "start": 125.874,
    "end": 129.594,
    "text": "逃避自己 我寻找阿特曼 寻找大梵"
  },
  {
    "start": 129.594,
    "end": 132.981,
    "text": "我曾渴望的是‘我’被肢解、蜕变"
  },
  {
    "start": 132.981,
    "end": 136.142,
    "text": "以便在陌生的内在发现万物核心"
  },
  {
    "start": 136.142,
    "end": 137.723,
    "text": "发现阿特曼"
  },
  {
    "start": 137.723,
    "end": 140.848,
    "text": "发现生命 发现神性的终极之物"
  },
  {
    "start": 140.848,
    "end": 144.182,
    "text": "可在这条路上 我却迷失了自己"
  },
  {
    "start": 144.43,
    "end": 147.508,
    "text": "悉达多睁大双眼 望向四周"
  },
  {
    "start": 147.508,
    "end": 150.824,
    "text": "一抹微笑不禁在他脸上荡溢开来"
  },
  {
    "start": 150.824,
    "end": 153.727,
    "text": "一种从大梦中彻底苏醒的"
  },
  {
    "start": 153.727,
    "end": 158.478,
    "text": "感觉贯穿他的周身直至脚趾他迈开双腿"
  },
  {
    "start": 158.478,
    "end": 160.837,
    "text": "如同一个完全清楚去向"
  },
  {
    "start": 160.837,
    "end": 163.432,
    "text": "和使命的男人般疾步前行"
  },
  {
    "start": 163.68,
    "end": 167.15,
    "text": "“哦 ”他深吸了口气 释然道"
  },
  {
    "start": 167.15,
    "end": 169.319,
    "text": "我不会再让悉达多溜走"
  },
  {
    "start": 169.319,
    "end": 171.432,
    "text": "不会再让阿特曼和尘世"
  },
  {
    "start": 171.432,
    "end": 174.178,
    "text": "疾苦成为我思想和生命的中心"
  },
  {
    "start": 174.178,
    "end": 175.866,
    "text": "我再也不会为寻找"
  },
  {
    "start": 175.866,
    "end": 179.242,
    "text": "废墟后的秘密而扼杀自己肢解自己"
  },
  {
    "start": 179.242,
    "end": 182.745,
    "text": "无论是《瑜伽吠陀》《阿达婆吠陀》"
  },
  {
    "start": 182.745,
    "end": 185.809,
    "text": "还是其他任何教义我都不再修习"
  },
  {
    "start": 185.809,
    "end": 187.341,
    "text": "我不再苦修"
  },
  {
    "start": 187.341,
    "end": 190.275,
    "text": "我要拜自己为师 我要认识自己"
  },
  {
    "start": 190.275,
    "end": 192.23,
    "text": "认识神秘的悉达多"
  },
  {
    "start": 192.478,
    "end": 195.937,
    "text": "他环视四周 宛如与世界初逢"
  },
  {
    "start": 195.937,
    "end": 200.383,
    "text": "世界是美的 绚烂的 世界是奇异的"
  },
  {
    "start": 200.383,
    "end": 200.877,
    "text": "神秘的"
  },
  {
    "start": 200.877,
    "end": 205.857,
    "text": "这儿是湛蓝 这儿是灿黄 那儿是艳绿"
  },
  {
    "start": 205.857,
    "end": 209.526,
    "text": "高天河流飘逸 森林山峦高耸"
  },
  {
    "start": 209.526,
    "end": 210.836,
    "text": "一切都是美的"
  },
  {
    "start": 210.836,
    "end": 213.203,
    "text": "一切都充满秘密和魔力"
  },
  {
    "start": 213.203,
    "end": 216.043,
    "text": "而置身其中的他 悉达多"
  },
  {
    "start": 216.043,
    "end": 219.356,
    "text": "这个苏醒之人 正走向他自己"
  },
  {
    "start": 219.356,
    "end": 222.484,
    "text": "这初次映入悉达多眼帘的一切"
  },
  {
    "start": 222.484,
    "end": 225.613,
    "text": "这灿黄和湛蓝 河流和森林"
  },
  {
    "start": 225.613,
    "end": 228.02,
    "text": "都不再是摩罗的法术"
  },
  {
    "start": 228.02,
    "end": 229.135,
    "text": "玛雅的面纱"
  },
  {
    "start": 229.135,
    "end": 232.703,
    "text": "不再是深思的、寻求圆一的婆罗门所"
  },
  {
    "start": 232.703,
    "end": 236.494,
    "text": "蔑视的现象世界中愚蠢而偶然的纷繁"
  },
  {
    "start": 236.494,
    "end": 239.478,
    "text": "蓝就是蓝 河水就是河水"
  },
  {
    "start": 239.478,
    "end": 242.96,
    "text": "在悉达多看来 如果在湛蓝中"
  },
  {
    "start": 242.96,
    "end": 246.193,
    "text": "在河流中 潜居着独一的神性"
  },
  {
    "start": 246.193,
    "end": 248.819,
    "text": "那这恰是神性的形式和意义"
  },
  {
    "start": 248.819,
    "end": 251.445,
    "text": "它就在这儿的灿黄、湛蓝中"
  },
  {
    "start": 251.445,
    "end": 254.072,
    "text": "在那儿的天空、森林中"
  },
  {
    "start": 254.072,
    "end": 255.297,
    "text": "在悉达多中"
  },
  {
    "start": 255.297,
    "end": 258.726,
    "text": "意义和本质绝非隐藏在事物背后"
  },
  {
    "start": 258.726,
    "end": 263.136,
    "text": "它们就在事物当中 在一切事物当中"
  },
  {
    "start": 263.384,
    "end": 265.544,
    "text": "我曾多么麻木和迟钝"
  },
  {
    "start": 265.544,
    "end": 267.489,
    "text": "这位疾步之人心想"
  },
  {
    "start": 267.489,
    "end": 271.378,
    "text": "如果一个人要在一本书中探寻意义"
  },
  {
    "start": 271.378,
    "end": 275.041,
    "text": "他便会逐字逐句去阅读它 研习它"
  },
  {
    "start": 275.041,
    "end": 278.932,
    "text": "爱它 他不会忽视每一个词、每一个字"
  },
  {
    "start": 278.932,
    "end": 280.609,
    "text": "把它们看作表象"
  },
  {
    "start": 280.609,
    "end": 284.681,
    "text": "看作偶然和毫无价值的皮毛 可我哪"
  },
  {
    "start": 284.681,
    "end": 286.87,
    "text": "我这个有意研读世界之"
  },
  {
    "start": 286.87,
    "end": 291.905,
    "text": "书、自我存在之书的人却预先爱上一个臆想的意义"
  },
  {
    "start": 291.905,
    "end": 293.826,
    "text": "我忽视了书中的语词"
  },
  {
    "start": 293.826,
    "end": 296.174,
    "text": "我把现象世界看作虚妄"
  },
  {
    "start": 296.174,
    "end": 299.171,
    "text": "我视眼目所见、唇齿所尝的仅"
  },
  {
    "start": 299.171,
    "end": 304.243,
    "text": "为没有价值而表面的偶然之物不 这些都已过去"
  },
  {
    "start": 304.243,
    "end": 306.926,
    "text": "我已苏生 我切实已苏生"
  },
  {
    "start": 306.926,
    "end": 309.162,
    "text": "今天即是我的生日"
  },
  {
    "start": 309.41,
    "end": 312.999,
    "text": "悉达多思索着 却突然停下脚步"
  },
  {
    "start": 312.999,
    "end": 315.869,
    "text": "仿佛有一条长蛇横卧于前路"
  },
  {
    "start": 316.117,
    "end": 317.769,
    "text": "他突然清楚：他"
  },
  {
    "start": 317.769,
    "end": 320.6,
    "text": "一个已切实苏醒和初生之人"
  },
  {
    "start": 320.6,
    "end": 324.846,
    "text": "必须彻底从头开始生活 在这个清晨"
  },
  {
    "start": 324.846,
    "end": 327.206,
    "text": "在他离开祗树给孤独园"
  },
  {
    "start": 327.206,
    "end": 331.217,
    "text": "离开世尊佛陀的清晨 他已完全觉醒"
  },
  {
    "start": 331.217,
    "end": 333.341,
    "text": "他已走上自我之路"
  },
  {
    "start": 333.341,
    "end": 337.557,
    "text": "于他而言 经过多年苦修后回归故里"
  },
  {
    "start": 337.557,
    "end": 341.278,
    "text": "回到父亲身边似乎是自然而理应的"
  },
  {
    "start": 341.278,
    "end": 343.015,
    "text": "可现在 此刻"
  },
  {
    "start": 343.015,
    "end": 345.199,
    "text": "他停下脚步的这一刻"
  },
  {
    "start": 345.199,
    "end": 349.084,
    "text": "仿佛有一条长蛇横卧于前路的一刻"
  },
  {
    "start": 349.084,
    "end": 356.864,
    "text": "他清楚地意识到： 我已不再是过去的我不再是苦行僧、沙门 不再是婆罗门"
  },
  {
    "start": 356.864,
    "end": 357.753,
    "text": "我回家"
  },
  {
    "start": 357.753,
    "end": 361.751,
    "text": "回父亲那里去做什么 修习 献祭"
  },
  {
    "start": 361.751,
    "end": 362.457,
    "text": "还是禅定"
  },
  {
    "start": 362.457,
    "end": 363.601,
    "text": "这些都已过去"
  },
  {
    "start": 363.601,
    "end": 366.271,
    "text": "这些已不属于我的前路"
  },
  {
    "start": 366.519,
    "end": 368.156,
    "text": "悉达多纹丝未动"
  },
  {
    "start": 368.156,
    "end": 371.196,
    "text": "彻骨的冰冷瞬间袭击他的心脏"
  },
  {
    "start": 371.196,
    "end": 374.703,
    "text": "他感到这颗心脏像一只小动物"
  },
  {
    "start": 374.703,
    "end": 378.296,
    "text": "一只鸟或一只兔子般在胸中颤抖"
  },
  {
    "start": 378.296,
    "end": 380.862,
    "text": "他如此孤独 多年来"
  },
  {
    "start": 380.862,
    "end": 384.885,
    "text": "他并未像现在这样意识到自己无家可归"
  },
  {
    "start": 384.885,
    "end": 387.961,
    "text": "从前 即便在最深的禅定中"
  },
  {
    "start": 387.961,
    "end": 390.091,
    "text": "他仍是父亲的儿子"
  },
  {
    "start": 390.091,
    "end": 394.038,
    "text": "高贵的婆罗门 一个修行之人 如今"
  },
  {
    "start": 394.038,
    "end": 397.765,
    "text": "他只是苏醒的悉达多 再不是别的什么人"
  },
  {
    "start": 397.765,
    "end": 400.825,
    "text": "他深吸口气 打了个寒颤"
  },
  {
    "start": 400.825,
    "end": 404.905,
    "text": "没人像他这般孤独 贵族属于贵族"
  },
  {
    "start": 404.905,
    "end": 406.944,
    "text": "手艺人属于手艺人"
  },
  {
    "start": 406.944,
    "end": 411.061,
    "text": "他们说同样的话 容身一处 分享生活"
  },
  {
    "start": 411.061,
    "end": 413.228,
    "text": "婆罗门要同婆罗门在一起"
  },
  {
    "start": 413.228,
    "end": 415.792,
    "text": "苦行者要在沙门中立足"
  },
  {
    "start": 415.792,
    "end": 419.894,
    "text": "即便归隐山林的隐士也不是独自一人"
  },
  {
    "start": 419.894,
    "end": 423.228,
    "text": "他们也有同道人 有归属"
  },
  {
    "start": 423.228,
    "end": 425.014,
    "text": "乔文达已皈依佛门"
  },
  {
    "start": 425.014,
    "end": 427.025,
    "text": "万千僧人是他的弟兄"
  },
  {
    "start": 427.025,
    "end": 430.822,
    "text": "他们着同样的僧服 信共同的信仰"
  },
  {
    "start": 430.822,
    "end": 434.62,
    "text": "说相同的话 可是他 悉达多"
  },
  {
    "start": 434.62,
    "end": 438.671,
    "text": "他属于哪里 和谁分享生活 说谁的话"
  },
  {
    "start": 438.919,
    "end": 442.116,
    "text": "此刻 世界隐匿于他的周围"
  },
  {
    "start": 442.116,
    "end": 445.804,
    "text": "他孤单伫立如同天际孤星 此刻"
  },
  {
    "start": 445.804,
    "end": 448.018,
    "text": "悉达多比从前更自我"
  },
  {
    "start": 448.018,
    "end": 452.231,
    "text": "更坚实 他从寒冷和沮丧中一跃而出"
  },
  {
    "start": 452.231,
    "end": 455.454,
    "text": "他感到：这是苏醒的最后颤栗"
  },
  {
    "start": 455.454,
    "end": 457.437,
    "text": "分娩的最后痉挛"
  },
  {
    "start": 457.437,
    "end": 460.281,
    "text": "他重新迈开步子 疾步前行"
  },
  {
    "start": 460.281,
    "end": 463.781,
    "text": "他再也不回家 再也不回父亲那里"
  },
  {
    "start": 463.781,
    "end": 464.656,
    "text": "再不回去"
  }
]