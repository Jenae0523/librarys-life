[
  {
    "start": 0.0,
    "end": 1.944,
    "text": "第三章 乔达摩"
  },
  {
    "start": 2.192,
    "end": 4.133,
    "text": "舍卫城中的每个孩子"
  },
  {
    "start": 4.133,
    "end": 6.291,
    "text": "都知晓世尊佛陀的大名"
  },
  {
    "start": 6.291,
    "end": 9.12,
    "text": "家家户户都预备着布施默默"
  },
  {
    "start": 9.12,
    "end": 12.185,
    "text": "乞食、手托钵盂的乔达摩弟子"
  },
  {
    "start": 12.185,
    "end": 15.963,
    "text": "乔达摩最爱栖身城外的祗树给孤独园"
  },
  {
    "start": 15.963,
    "end": 18.325,
    "text": "该园由一位富庶的商人"
  },
  {
    "start": 18.325,
    "end": 21.159,
    "text": "也是世尊忠诚的追随者"
  },
  {
    "start": 21.159,
    "end": 22.503,
    "text": "给孤独敬献"
  },
  {
    "start": 22.751,
    "end": 25.463,
    "text": "两位朝拜乔达摩的青年沙门"
  },
  {
    "start": 25.463,
    "end": 29.305,
    "text": "一路探询到达此地 他们入了舍卫城"
  },
  {
    "start": 29.305,
    "end": 32.422,
    "text": "便即刻在第一间屋舍外站立乞食"
  },
  {
    "start": 32.422,
    "end": 33.535,
    "text": "受到款待后"
  },
  {
    "start": 33.535,
    "end": 36.874,
    "text": "悉达多问那位施舍斋饭的妇人"
  },
  {
    "start": 37.122,
    "end": 38.664,
    "text": "仁慈的女施主"
  },
  {
    "start": 38.664,
    "end": 41.528,
    "text": "我们很想知道世尊佛陀的下落"
  },
  {
    "start": 41.528,
    "end": 43.951,
    "text": "我们是林中来的沙门"
  },
  {
    "start": 43.951,
    "end": 45.675,
    "text": "希望见到这位觉者"
  },
  {
    "start": 45.675,
    "end": 48.26,
    "text": "希望聆听他亲口宣法"
  },
  {
    "start": 48.508,
    "end": 51.027,
    "text": "妇人道： 林中来的沙门"
  },
  {
    "start": 51.027,
    "end": 54.462,
    "text": "你们到了此处 就是来对了地方"
  },
  {
    "start": 54.462,
    "end": 62.701,
    "text": "世尊居住在给孤独长者的祗树给孤独园中你们可以在祗园过夜 那里有足够的空间"
  },
  {
    "start": 62.701,
    "end": 66.73,
    "text": "供纷至沓来聆听法义的朝圣者留宿"
  },
  {
    "start": 66.978,
    "end": 68.532,
    "text": "乔文达喜出望外"
  },
  {
    "start": 68.532,
    "end": 70.973,
    "text": "他欢叫道： 这可是大好"
  },
  {
    "start": 70.973,
    "end": 75.412,
    "text": "我们抵达了目的地 我们的路途已至终点"
  },
  {
    "start": 75.412,
    "end": 78.649,
    "text": "请告诉我们 这位朝圣者的母亲"
  },
  {
    "start": 78.649,
    "end": 81.239,
    "text": "您是否认识他 那位佛陀"
  },
  {
    "start": 81.239,
    "end": 83.181,
    "text": "可否亲眼见过他"
  },
  {
    "start": 83.429,
    "end": 86.639,
    "text": "妇人道： 我曾多次见过佛陀"
  },
  {
    "start": 86.639,
    "end": 90.343,
    "text": "我多次见他行游街市 沉默寡言"
  },
  {
    "start": 90.343,
    "end": 91.578,
    "text": "身披僧衣"
  },
  {
    "start": 91.578,
    "end": 95.18,
    "text": "他缄默地驻足于屋舍前 以手承钵"
  },
  {
    "start": 95.18,
    "end": 98.332,
    "text": "并托着盛满斋食的钵盂离去"
  },
  {
    "start": 98.58,
    "end": 101.843,
    "text": "乔文达听得入迷 还想继续提问"
  },
  {
    "start": 101.843,
    "end": 104.019,
    "text": "听更多关于佛陀的轶事"
  },
  {
    "start": 104.019,
    "end": 106.629,
    "text": "但悉达多催促他继续赶路"
  },
  {
    "start": 106.629,
    "end": 108.46,
    "text": "于是他们致谢后上路"
  },
  {
    "start": 108.46,
    "end": 110.493,
    "text": "几乎不用再询问方向"
  },
  {
    "start": 110.493,
    "end": 113.112,
    "text": "在赶往祗园的路上有众多"
  },
  {
    "start": 113.112,
    "end": 117.397,
    "text": "乔达摩僧团的徒众和朝圣者夜晚抵达后"
  },
  {
    "start": 117.397,
    "end": 121.836,
    "text": "仍有众多僧俗陆续到来 一些人叫嚷着"
  },
  {
    "start": 121.836,
    "end": 125.042,
    "text": "请求分得留宿之处 两位沙门"
  },
  {
    "start": 125.042,
    "end": 130.113,
    "text": "习惯荒林丛莽生活 很快无声落定栖息"
  },
  {
    "start": 130.113,
    "end": 131.241,
    "text": "直至天明"
  },
  {
    "start": 131.489,
    "end": 134.473,
    "text": "日出时分 他们惊讶地发现"
  },
  {
    "start": 134.473,
    "end": 137.458,
    "text": "在此过夜的徒众和好奇者众多"
  },
  {
    "start": 137.458,
    "end": 141.355,
    "text": "着僧衣的僧侣穿梭于壮丽的祗园各处"
  },
  {
    "start": 141.355,
    "end": 145.495,
    "text": "他们三五成群 或坐于树下深入禅定"
  },
  {
    "start": 145.495,
    "end": 146.957,
    "text": "或谈经论道"
  },
  {
    "start": 146.957,
    "end": 150.392,
    "text": "绿树成荫的院落宛如一座城池"
  },
  {
    "start": 150.392,
    "end": 152.77,
    "text": "挤满熙来攘往的人们"
  },
  {
    "start": 152.77,
    "end": 156.206,
    "text": "多数僧侣正手托钵盂外出"
  },
  {
    "start": 156.206,
    "end": 160.084,
    "text": "他们要进城为每日唯一的一餐乞食"
  },
  {
    "start": 160.084,
    "end": 163.445,
    "text": "觉者佛陀也在清晨外出乞食"
  },
  {
    "start": 163.693,
    "end": 166.906,
    "text": "悉达多见到他 仿似神灵指点"
  },
  {
    "start": 166.906,
    "end": 168.284,
    "text": "他即刻认出他"
  },
  {
    "start": 168.284,
    "end": 171.727,
    "text": "他看见那位质朴无华的着僧衣者"
  },
  {
    "start": 171.727,
    "end": 174.801,
    "text": "手持钵盂 静默前行"
  },
  {
    "start": 175.049,
    "end": 178.123,
    "text": "“看 ”悉达多轻声对乔文达道"
  },
  {
    "start": 178.123,
    "end": 179.968,
    "text": "“此人就是佛陀 ”"
  },
  {
    "start": 180.216,
    "end": 188.015,
    "text": "乔文达目不转睛地看着这位着僧衣的僧人他看上去和其他僧人别无二致 旋即"
  },
  {
    "start": 188.015,
    "end": 191.687,
    "text": "乔文达也认出了他：此人便是佛陀"
  },
  {
    "start": 191.687,
    "end": 194.624,
    "text": "于是他们跟随他 打量他"
  },
  {
    "start": 194.872,
    "end": 197.82,
    "text": "佛陀缄默前行 陷于沉思"
  },
  {
    "start": 197.82,
    "end": 200.277,
    "text": "他宁静的面庞无悲无喜"
  },
  {
    "start": 200.277,
    "end": 203.716,
    "text": "又仿佛从内心绽放轻柔的微笑"
  },
  {
    "start": 203.716,
    "end": 208.02,
    "text": "佛陀安详肃静地前行 带着隐约的微笑"
  },
  {
    "start": 208.02,
    "end": 212.085,
    "text": "宛如一个健康的孩童 他严格依照规范"
  },
  {
    "start": 212.085,
    "end": 214.842,
    "text": "同他的徒众着一致的僧衣"
  },
  {
    "start": 214.842,
    "end": 218.35,
    "text": "迈同样的步履 只是他的面庞"
  },
  {
    "start": 218.35,
    "end": 221.859,
    "text": "他的步态 他安然低垂的眼帘"
  },
  {
    "start": 221.859,
    "end": 223.671,
    "text": "宁和垂下的手臂"
  },
  {
    "start": 223.671,
    "end": 227.553,
    "text": "乃至他手上的每根指头都流露和平"
  },
  {
    "start": 227.553,
    "end": 231.953,
    "text": "彰显完善 他无欲满足 无所模仿"
  },
  {
    "start": 231.953,
    "end": 234.158,
    "text": "在恒久不变的平静中"
  },
  {
    "start": 234.158,
    "end": 236.363,
    "text": "在永不凋零的光芒中"
  },
  {
    "start": 236.363,
    "end": 241.017,
    "text": "在不容进犯的和平中 他柔和地呼吸着"
  },
  {
    "start": 241.265,
    "end": 244.042,
    "text": "乔达摩就这样穿过城邑乞食"
  },
  {
    "start": 244.042,
    "end": 247.744,
    "text": "两位沙门从他完满的安详中认出他"
  },
  {
    "start": 247.744,
    "end": 250.49,
    "text": "从他寂静的仪态中认出他"
  },
  {
    "start": 250.49,
    "end": 252.487,
    "text": "从他的全无所慕、"
  },
  {
    "start": 252.487,
    "end": 257.478,
    "text": "浑然天成、无所烦劳中认出他在他的周身"
  },
  {
    "start": 257.478,
    "end": 259.903,
    "text": "唯独充盈光明与和平"
  },
  {
    "start": 260.15,
    "end": 263.456,
    "text": "今天 我们将聆听至尊亲口宣法"
  },
  {
    "start": 263.456,
    "end": 264.49,
    "text": "乔文达道"
  },
  {
    "start": 264.737,
    "end": 268.677,
    "text": "悉达多没有作答 他对法义全无好奇"
  },
  {
    "start": 268.677,
    "end": 271.458,
    "text": "他不相信法义能带给他新知"
  },
  {
    "start": 271.458,
    "end": 273.312,
    "text": "他和乔文达一样"
  },
  {
    "start": 273.312,
    "end": 281.976,
    "text": "已经一再从多方渠道获取佛陀法义的宗旨他仅仅专心致志地观察乔达摩的头部"
  },
  {
    "start": 281.976,
    "end": 286.14,
    "text": "他的肩膀 双足 他垂下的双手"
  },
  {
    "start": 286.14,
    "end": 290.564,
    "text": "他看上去仿佛每个指关节处都写满法义"
  },
  {
    "start": 290.564,
    "end": 291.605,
    "text": "都在言说"
  },
  {
    "start": 291.605,
    "end": 296.152,
    "text": "在吐纳 在散发真理的光辉 这个人"
  },
  {
    "start": 296.152,
    "end": 299.689,
    "text": "佛陀 周身上下乃至手指都是真的"
  },
  {
    "start": 299.689,
    "end": 301.247,
    "text": "这个人是神圣的"
  },
  {
    "start": 301.247,
    "end": 304.141,
    "text": "悉达多从未如此敬重过一个人"
  },
  {
    "start": 304.141,
    "end": 306.813,
    "text": "从未如此爱慕过一个人"
  },
  {
    "start": 307.061,
    "end": 310.064,
    "text": "两人默默跟随佛陀进城又返回"
  },
  {
    "start": 310.064,
    "end": 311.912,
    "text": "他们决定当天禁食"
  },
  {
    "start": 311.912,
    "end": 314.915,
    "text": "他们看见乔达摩还至本处"
  },
  {
    "start": 314.915,
    "end": 319.059,
    "text": "看见他走入弟子中用饭——他所食之少"
  },
  {
    "start": 319.059,
    "end": 321.261,
    "text": "连鸟儿都无法果腹——"
  },
  {
    "start": 321.261,
    "end": 323.903,
    "text": "看见他步入芒果树的阴影中"
  },
  {
    "start": 324.151,
    "end": 326.725,
    "text": "夜幕降临 酷热消歇"
  },
  {
    "start": 326.725,
    "end": 329.299,
    "text": "祗园中的人们活跃起来"
  },
  {
    "start": 329.299,
    "end": 333.16,
    "text": "聚集在一处聆听佛陀宣法 这时"
  },
  {
    "start": 333.16,
    "end": 337.379,
    "text": "他们听见佛陀的声音 那声音美满"
  },
  {
    "start": 337.379,
    "end": 340.543,
    "text": "安宁 平和 他论苦谛"
  },
  {
    "start": 340.543,
    "end": 343.179,
    "text": "苦之缘起及其灭往何处去"
  },
  {
    "start": 343.179,
    "end": 347.907,
    "text": "他平静的论述安详清晰 苦乃人生实相"
  },
  {
    "start": 347.907,
    "end": 350.533,
    "text": "但离苦之道业已被发觉"
  },
  {
    "start": 350.533,
    "end": 353.442,
    "text": "跟随佛陀即可脱离苦海"
  },
  {
    "start": 353.69,
    "end": 356.877,
    "text": "世尊以柔和坚定的声音论四圣谛"
  },
  {
    "start": 356.877,
    "end": 360.974,
    "text": "讲八正道 他耐心地以惯常的方式讲经"
  },
  {
    "start": 360.974,
    "end": 362.339,
    "text": "举证 温故"
  },
  {
    "start": 362.339,
    "end": 366.721,
    "text": "他的声音明亮而安静地盘旋在听者上空"
  },
  {
    "start": 366.721,
    "end": 368.783,
    "text": "如光影 如星辰"
  },
  {
    "start": 369.031,
    "end": 371.23,
    "text": "讲经结束时已是深夜"
  },
  {
    "start": 371.23,
    "end": 375.384,
    "text": "一些朝圣者走上前去 请求皈依佛陀"
  },
  {
    "start": 375.384,
    "end": 376.605,
    "text": "加入僧团"
  },
  {
    "start": 376.605,
    "end": 378.249,
    "text": "乔达摩接纳了他们"
  },
  {
    "start": 378.249,
    "end": 380.509,
    "text": "他道： 你们都妥善地"
  },
  {
    "start": 380.509,
    "end": 383.298,
    "text": "聆听了法义 来步入乐园"
  },
  {
    "start": 383.298,
    "end": 385.389,
    "text": "断灭一切苦难吧"
  },
  {
    "start": 385.636,
    "end": 386.067,
    "text": "看哪"
  },
  {
    "start": 386.067,
    "end": 388.648,
    "text": "腼腆的乔文达也上前一步道"
  },
  {
    "start": 388.648,
    "end": 391.661,
    "text": "： 我也愿皈依您及您的法义"
  },
  {
    "start": 391.661,
    "end": 394.27,
    "text": "他祈求加入僧众并被接纳"
  },
  {
    "start": 394.517,
    "end": 396.896,
    "text": "随后 佛陀返回安寝"
  },
  {
    "start": 396.896,
    "end": 402.842,
    "text": "乔文达走向悉达多热忱地说道： 悉达多我无权责备你"
  },
  {
    "start": 402.842,
    "end": 405.768,
    "text": "我们两人都聆听了世尊宣法"
  },
  {
    "start": 405.768,
    "end": 407.474,
    "text": "我们都认同法义"
  },
  {
    "start": 407.474,
    "end": 411.376,
    "text": "乔文达听后已皈依佛陀 可是你"
  },
  {
    "start": 411.376,
    "end": 414.716,
    "text": "我敬爱的人 难道不想步解脱之路"
  },
  {
    "start": 414.716,
    "end": 417.43,
    "text": "你还在犹豫 还在等待吗"
  },
  {
    "start": 417.678,
    "end": 420.851,
    "text": "悉达多听到乔文达的话如梦方醒"
  },
  {
    "start": 420.851,
    "end": 423.797,
    "text": "他久久地凝视着乔文达的脸"
  },
  {
    "start": 423.797,
    "end": 427.374,
    "text": "之后绝无戏言地轻声道： 乔文达"
  },
  {
    "start": 427.374,
    "end": 430.236,
    "text": "我的朋友 你已迈出步子"
  },
  {
    "start": 430.236,
    "end": 432.621,
    "text": "你选择了这条路 哦"
  },
  {
    "start": 432.621,
    "end": 435.485,
    "text": "乔文达……你一直是我的朋友"
  },
  {
    "start": 435.485,
    "end": 439.45,
    "text": "一直紧随我 我时常问：会有那么一天"
  },
  {
    "start": 439.45,
    "end": 441.687,
    "text": "乔文达听凭自己的心声"
  },
  {
    "start": 441.687,
    "end": 444.147,
    "text": "独自迈步前行吗 你看"
  },
  {
    "start": 444.147,
    "end": 447.949,
    "text": "你现在成了男子汉 选择了自己的路"
  },
  {
    "start": 447.949,
    "end": 451.207,
    "text": "愿你始终跟随他 哦 我的朋友"
  },
  {
    "start": 451.207,
    "end": 452.633,
    "text": "愿你寻得解脱"
  },
  {
    "start": 452.881,
    "end": 455.876,
    "text": "乔文达没有完全领悟悉达多的话"
  },
  {
    "start": 455.876,
    "end": 459.94,
    "text": "他急切地重复他的问题： 说吧 我求你"
  },
  {
    "start": 459.94,
    "end": 462.685,
    "text": "我亲爱的悉达多 告诉我"
  },
  {
    "start": 462.685,
    "end": 464.744,
    "text": "我们别无他途 所以"
  },
  {
    "start": 464.744,
    "end": 467.414,
    "text": "你 我渴慕知识的朋友"
  },
  {
    "start": 467.414,
    "end": 469.598,
    "text": "你也会皈依佛陀"
  },
  {
    "start": 469.846,
    "end": 472.187,
    "text": "悉达多将手放在乔文达的"
  },
  {
    "start": 472.187,
    "end": 476.23,
    "text": "肩头： 你并未理会我的祝愿哦 乔文达"
  },
  {
    "start": 476.23,
    "end": 479.511,
    "text": "我再说一次：愿你将这条路走到底"
  },
  {
    "start": 479.511,
    "end": 481.479,
    "text": "愿你寻得解脱"
  },
  {
    "start": 481.727,
    "end": 483.53,
    "text": "乔文达顷刻间明白"
  },
  {
    "start": 483.53,
    "end": 487.136,
    "text": "他的朋友即将离开他 他哭了起来"
  },
  {
    "start": 487.384,
    "end": 489.408,
    "text": "“悉达多 ”他悲戚道"
  },
  {
    "start": 489.656,
    "end": 492.942,
    "text": "悉达多亲切地对他说： 别忘了"
  },
  {
    "start": 492.942,
    "end": 495.993,
    "text": "乔文达 你已是佛陀的沙门"
  },
  {
    "start": 495.993,
    "end": 498.34,
    "text": "你弃绝了故乡和双亲"
  },
  {
    "start": 498.34,
    "end": 502.531,
    "text": "弃绝了出身和财产 弃绝了自己的意志"
  },
  {
    "start": 502.531,
    "end": 505.79,
    "text": "弃绝了友谊 这是法义的要求"
  },
  {
    "start": 505.79,
    "end": 506.954,
    "text": "佛陀的意志"
  },
  {
    "start": 506.954,
    "end": 511.219,
    "text": "也是你的心愿 明天 哦 乔文达"
  },
  {
    "start": 511.219,
    "end": 512.403,
    "text": "我将离开你"
  },
  {
    "start": 512.651,
    "end": 515.016,
    "text": "两人长久地在林中漫步"
  },
  {
    "start": 515.016,
    "end": 517.38,
    "text": "安寝后仍久久无法入眠"
  },
  {
    "start": 517.38,
    "end": 520.691,
    "text": "乔文达不断地追问他的朋友"
  },
  {
    "start": 520.691,
    "end": 522.016,
    "text": "他想听他解释"
  },
  {
    "start": 522.016,
    "end": 524.666,
    "text": "他为何不容身乔达摩之法义"
  },
  {
    "start": 524.666,
    "end": 528.2,
    "text": "他在他的法义中发现了什么瑕疵"
  },
  {
    "start": 528.2,
    "end": 535.244,
    "text": "而悉达多却总是驳回追问： 不要再问了乔文达 佛陀的法义非常之好"
  },
  {
    "start": 535.244,
    "end": 537.208,
    "text": "我怎么可能发现瑕疵"
  },
  {
    "start": 537.456,
    "end": 538.419,
    "text": "复日清晨"
  },
  {
    "start": 538.419,
    "end": 541.067,
    "text": "一位年长的佛陀弟子召集"
  },
  {
    "start": 541.067,
    "end": 545.4,
    "text": "祗园中刚刚皈依佛陀的僧众分发僧衣"
  },
  {
    "start": 545.4,
    "end": 549.455,
    "text": "指示他们初步法理及僧团戒律 这时"
  },
  {
    "start": 549.455,
    "end": 551.124,
    "text": "乔文达出离僧团"
  },
  {
    "start": 551.124,
    "end": 554.464,
    "text": "再次拥抱了他青年时代的朋友"
  },
  {
    "start": 554.464,
    "end": 557.373,
    "text": "之后便加入了新皈依者的行列"
  },
  {
    "start": 557.621,
    "end": 560.265,
    "text": "悉达多则沉思步入林中"
  },
  {
    "start": 560.513,
    "end": 564.115,
    "text": "在路上 他遇见了世尊乔达摩"
  },
  {
    "start": 564.115,
    "end": 566.431,
    "text": "他恭敬地向世尊问安"
  },
  {
    "start": 566.431,
    "end": 569.262,
    "text": "因见世尊目光慈蔼安详"
  },
  {
    "start": 569.262,
    "end": 573.851,
    "text": "这位青年便鼓起勇气 请求同世尊交谈"
  },
  {
    "start": 573.851,
    "end": 575.381,
    "text": "世尊默默首肯"
  },
  {
    "start": 575.629,
    "end": 579.357,
    "text": "悉达多道： 昨天 哦 世尊"
  },
  {
    "start": 579.357,
    "end": 581.843,
    "text": "我有幸聆听您奇异的法义"
  },
  {
    "start": 581.843,
    "end": 585.286,
    "text": "我和我的朋友远道而来听您宣法"
  },
  {
    "start": 585.286,
    "end": 589.467,
    "text": "我的朋友将留在此处 他已皈依于您"
  },
  {
    "start": 589.467,
    "end": 591.961,
    "text": "我却要继续我的求道之路"
  },
  {
    "start": 592.209,
    "end": 595.238,
    "text": "“随你的心意 ”世尊谦逊地说"
  },
  {
    "start": 595.486,
    "end": 597.68,
    "text": "我的话可能太过放肆"
  },
  {
    "start": 597.68,
    "end": 599.217,
    "text": "悉达多继续道"
  },
  {
    "start": 599.217,
    "end": 603.605,
    "text": "但如若我不坦率地将我的思想奉告世尊"
  },
  {
    "start": 603.605,
    "end": 606.136,
    "text": "我便无法离去 世尊佛陀"
  },
  {
    "start": 606.136,
    "end": 608.034,
    "text": "您可否再留一步"
  },
  {
    "start": 608.282,
    "end": 610.296,
    "text": "佛陀默默首肯"
  },
  {
    "start": 610.544,
    "end": 612.989,
    "text": "悉达多道： 世尊佛陀"
  },
  {
    "start": 612.989,
    "end": 616.656,
    "text": "您的法义令我钦佩 它清晰无瑕"
  },
  {
    "start": 616.656,
    "end": 617.878,
    "text": "证据确凿"
  },
  {
    "start": 617.878,
    "end": 621.534,
    "text": "您将世界以一条充满因果的永恒的链"
  },
  {
    "start": 621.534,
    "end": 624.276,
    "text": "一条从未有过任何瑕疵的链"
  },
  {
    "start": 624.276,
    "end": 626.332,
    "text": "展现在世人面前"
  },
  {
    "start": 626.332,
    "end": 628.244,
    "text": "世界从未如此清晰"
  },
  {
    "start": 628.244,
    "end": 631.59,
    "text": "从未如此不可辩驳地被呈示出来"
  },
  {
    "start": 631.59,
    "end": 634.696,
    "text": "婆罗门如若聆听您的法义"
  },
  {
    "start": 634.696,
    "end": 637.321,
    "text": "看到这个完满融通的世界"
  },
  {
    "start": 637.321,
    "end": 640.185,
    "text": "这个无瑕、清澈如水晶、不"
  },
  {
    "start": 640.185,
    "end": 643.526,
    "text": "依赖偶然、不决于诸神的世界"
  },
  {
    "start": 643.526,
    "end": 647.217,
    "text": "必定心潮澎湃 无论世界是善是恶"
  },
  {
    "start": 647.217,
    "end": 649.293,
    "text": "无论生命自身是苦是"
  },
  {
    "start": 649.293,
    "end": 651.6,
    "text": "乐——这或许悬而未决"
  },
  {
    "start": 651.6,
    "end": 655.443,
    "text": "也并非最为本质——但是世界的统一"
  },
  {
    "start": 655.443,
    "end": 657.605,
    "text": "所有事件的休戚相关"
  },
  {
    "start": 657.605,
    "end": 660.969,
    "text": "大小事物席卷于同一潮流中"
  },
  {
    "start": 660.969,
    "end": 662.713,
    "text": "起源于同一起源"
  },
  {
    "start": 662.713,
    "end": 665.702,
    "text": "遵循同一生成及灭亡的律法"
  },
  {
    "start": 665.702,
    "end": 669.938,
    "text": "已从您完满的宣讲中得到阐明 哦"
  },
  {
    "start": 669.938,
    "end": 674.512,
    "text": "功德圆满的佛陀 只是 在您的法义中"
  },
  {
    "start": 674.512,
    "end": 676.679,
    "text": "在统一、逻辑完善的"
  },
  {
    "start": 676.679,
    "end": 679.327,
    "text": "万物中却存在一个断裂之处"
  },
  {
    "start": 679.327,
    "end": 682.698,
    "text": "这一小小的缝隙让这个统一的"
  },
  {
    "start": 682.698,
    "end": 689.181,
    "text": "世界呈现出些许陌生、些许新奇呈现出些许迥异于从前"
  },
  {
    "start": 689.181,
    "end": 691.325,
    "text": "且无法被证实的东西"
  },
  {
    "start": 691.325,
    "end": 697.041,
    "text": "：那就是您的超世拔俗获得解脱的法义 这个小漏洞"
  },
  {
    "start": 697.041,
    "end": 698.47,
    "text": "这个小断裂"
  },
  {
    "start": 698.47,
    "end": 701.594,
    "text": "让永恒统一的世界法则变得破碎"
  },
  {
    "start": 701.594,
    "end": 702.486,
    "text": "失去效力"
  },
  {
    "start": 702.486,
    "end": 706.279,
    "text": "但愿您能宽恕我所提出的异议"
  },
  {
    "start": 706.527,
    "end": 709.516,
    "text": "乔达摩安静地听着 纹丝未动"
  },
  {
    "start": 709.516,
    "end": 713.163,
    "text": "这位功德圆满的觉者以慈蔼、谦和"
  },
  {
    "start": 713.163,
    "end": 718.755,
    "text": "而清晰的声音道： 你聆听了法义哦 婆罗门之子"
  },
  {
    "start": 718.755,
    "end": 721.031,
    "text": "难得你深深地思索法义"
  },
  {
    "start": 721.031,
    "end": 725.126,
    "text": "你在法义中发现了一个漏洞 一个缺口"
  },
  {
    "start": 725.126,
    "end": 727.629,
    "text": "愿你能继续深入地思考"
  },
  {
    "start": 727.629,
    "end": 729.555,
    "text": "但是你这勤勉之人"
  },
  {
    "start": 729.555,
    "end": 732.443,
    "text": "要警惕多谋善断及口舌之辩"
  },
  {
    "start": 732.443,
    "end": 736.053,
    "text": "无论辩辞美或丑 聪慧或愚蠢"
  },
  {
    "start": 736.053,
    "end": 739.184,
    "text": "总有人赞许 有人鄙夷"
  },
  {
    "start": 739.184,
    "end": 743.452,
    "text": "你从我处所听之法义并非我之辩辞"
  },
  {
    "start": 743.452,
    "end": 747.872,
    "text": "它的宗旨并非为求知好学之人阐释世界"
  },
  {
    "start": 747.872,
    "end": 752.292,
    "text": "它另有他图 它的宗旨乃是济拔苦难"
  },
  {
    "start": 752.292,
    "end": 755.581,
    "text": "这就是乔达摩的法义 别无其他"
  },
  {
    "start": 755.829,
    "end": 759.701,
    "text": "哦 世尊佛陀 但愿您不怪罪我"
  },
  {
    "start": 759.701,
    "end": 763.801,
    "text": "”青年人道 “我并非为争辩与您交谈"
  },
  {
    "start": 763.801,
    "end": 764.713,
    "text": "您所言极是"
  },
  {
    "start": 764.713,
    "end": 766.264,
    "text": "辩辞微不足道"
  },
  {
    "start": 766.264,
    "end": 770.402,
    "text": "请容我再说：我未曾有刹那怀疑过您"
  },
  {
    "start": 770.402,
    "end": 774.022,
    "text": "未曾有刹那怀疑过您是佛陀"
  },
  {
    "start": 774.022,
    "end": 775.537,
    "text": "您已功德圆满"
  },
  {
    "start": 775.537,
    "end": 778.061,
    "text": "您已抵达无数婆罗门及"
  },
  {
    "start": 778.061,
    "end": 782.606,
    "text": "婆罗门之子求索之巅峰您已超拔死亡"
  },
  {
    "start": 782.606,
    "end": 787.914,
    "text": "您通过探索 求道 通过深观 禅修"
  },
  {
    "start": 787.914,
    "end": 792.105,
    "text": "通过认知 彻悟而非通过法义修成正果"
  },
  {
    "start": 792.105,
    "end": 795.789,
    "text": "——这就是我的想法 哦 世尊"
  },
  {
    "start": 795.789,
    "end": 799.704,
    "text": "没人能通过法义得到解脱 哦 世尊佛陀"
  },
  {
    "start": 799.704,
    "end": 802.676,
    "text": "您从未以言辞或法义宣讲您"
  },
  {
    "start": 802.676,
    "end": 809.363,
    "text": "在证觉成道之际所发生的事世尊佛陀的法义多教人诸善奉行"
  },
  {
    "start": 809.363,
    "end": 810.322,
    "text": "诸恶莫作"
  },
  {
    "start": 810.322,
    "end": 817.997,
    "text": "在明晰又可敬的法义中不包含世尊的历程那个您独自超越众生的秘密"
  },
  {
    "start": 817.997,
    "end": 821.571,
    "text": "这就是我在聆听法义时思考和认识的"
  },
  {
    "start": 821.571,
    "end": 824.33,
    "text": "这就是我为何要继续我的求道"
  },
  {
    "start": 824.33,
    "end": 827.3,
    "text": "之路——并非去寻找更好的法义"
  },
  {
    "start": 827.3,
    "end": 829.537,
    "text": "我知道它并不存在——"
  },
  {
    "start": 829.537,
    "end": 835.799,
    "text": "而是为摆脱所有圣贤及法义独自去实现我的目标 或者去幻灭"
  },
  {
    "start": 835.799,
    "end": 839.753,
    "text": "我将常常怀想今天 哦 世尊佛陀"
  },
  {
    "start": 839.753,
    "end": 841.148,
    "text": "我将怀想此刻"
  },
  {
    "start": 841.148,
    "end": 844.403,
    "text": "这个我亲眼见到圣人的时刻"
  },
  {
    "start": 844.651,
    "end": 846.879,
    "text": "佛陀安静地低垂眼帘"
  },
  {
    "start": 846.879,
    "end": 851.086,
    "text": "他那玄妙莫测的面庞散溢着彻底的安宁"
  },
  {
    "start": 851.086,
    "end": 853.065,
    "text": "愿你的思索"
  },
  {
    "start": 853.065,
    "end": 856.877,
    "text": "”至尊悠然道 “愿你的思索无误"
  },
  {
    "start": 856.877,
    "end": 858.306,
    "text": "愿你实现目标"
  },
  {
    "start": 858.306,
    "end": 861.88,
    "text": "但请告诉我：你可见到我的僧团"
  },
  {
    "start": 861.88,
    "end": 864.88,
    "text": "那些皈依法义的我的众多弟兄"
  },
  {
    "start": 864.88,
    "end": 869.265,
    "text": "你是否认为 陌生的沙门 你是否认为"
  },
  {
    "start": 869.265,
    "end": 870.189,
    "text": "放弃法义"
  },
  {
    "start": 870.189,
    "end": 872.054,
    "text": "回到极尽声色的世俗"
  },
  {
    "start": 872.054,
    "end": 874.333,
    "text": "生活对他们更有益处"
  },
  {
    "start": 874.581,
    "end": 876.78,
    "text": "这样的念头我从未有过"
  },
  {
    "start": 876.78,
    "end": 878.38,
    "text": "悉达多高声道"
  },
  {
    "start": 878.628,
    "end": 882.018,
    "text": "愿他们遵循法义 实现宏愿"
  },
  {
    "start": 882.018,
    "end": 884.439,
    "text": "我无权论断他人的生活"
  },
  {
    "start": 884.439,
    "end": 888.072,
    "text": "唯独对自己的生活必须做出判断"
  },
  {
    "start": 888.072,
    "end": 890.794,
    "text": "我必须选择 必须放弃"
  },
  {
    "start": 890.794,
    "end": 895.496,
    "text": "我们沙门寻求弃绝于‘我’ 哦 世尊"
  },
  {
    "start": 895.496,
    "end": 897.476,
    "text": "假如我皈依于您 哦"
  },
  {
    "start": 897.476,
    "end": 897.942,
    "text": "世尊"
  },
  {
    "start": 897.942,
    "end": 900.271,
    "text": "我担忧我的‘我’只是"
  },
  {
    "start": 900.271,
    "end": 905.395,
    "text": "表面地、虚假地获得安宁得到解脱 而事实上"
  },
  {
    "start": 905.395,
    "end": 909.357,
    "text": "我的‘我’却仍在生存、壮大 因为"
  },
  {
    "start": 909.357,
    "end": 913.319,
    "text": "我会将法义 我的后来者 我对您的爱"
  },
  {
    "start": 913.319,
    "end": 915.383,
    "text": "以及僧团当作我"
  },
  {
    "start": 915.631,
    "end": 920.025,
    "text": "乔达摩似笑非笑 他的明澈安如磐石"
  },
  {
    "start": 920.025,
    "end": 922.82,
    "text": "他善意地凝视这位陌生人且"
  },
  {
    "start": 922.82,
    "end": 925.614,
    "text": "以一种隐微的神情同他道别"
  },
  {
    "start": 925.862,
    "end": 929.958,
    "text": "“你很聪明 哦 沙门 ”世尊道"
  },
  {
    "start": 929.958,
    "end": 932.688,
    "text": "你能言善道 我的朋友"
  },
  {
    "start": 932.688,
    "end": 934.736,
    "text": "要提防不要太过聪明"
  },
  {
    "start": 934.984,
    "end": 936.331,
    "text": "佛陀缓步离去"
  },
  {
    "start": 936.331,
    "end": 938.575,
    "text": "他的目光和神秘的微笑"
  },
  {
    "start": 938.575,
    "end": 941.493,
    "text": "永远镌刻在悉达多的记忆中"
  },
  {
    "start": 941.493,
    "end": 944.7,
    "text": "这般目光和微笑我从未见过"
  },
  {
    "start": 944.7,
    "end": 949.387,
    "text": "如此行走、端坐之人我从未见过  他想"
  },
  {
    "start": 949.387,
    "end": 952.74,
    "text": "惟愿我也有这般目光及微笑"
  },
  {
    "start": 952.74,
    "end": 954.804,
    "text": "能如此行走及端坐"
  },
  {
    "start": 954.804,
    "end": 959.446,
    "text": "如此自由、神圣、隐晦 又如此坦率"
  },
  {
    "start": 959.446,
    "end": 961.797,
    "text": "如孩童 又饱含秘密"
  },
  {
    "start": 961.797,
    "end": 964.619,
    "text": "只有潜入自己最深处的人才"
  },
  {
    "start": 964.619,
    "end": 968.145,
    "text": "能有这般诚挚的目光和步伐无疑"
  },
  {
    "start": 968.145,
    "end": 971.225,
    "text": "我也将潜入自己之最深处探寻"
  },
  {
    "start": 971.472,
    "end": 974.365,
    "text": "“我见到一个人 ”悉达多想"
  },
  {
    "start": 974.365,
    "end": 976.638,
    "text": "一个唯一令我垂青之人"
  },
  {
    "start": 976.638,
    "end": 978.912,
    "text": "他人断不会再令我垂青"
  },
  {
    "start": 978.912,
    "end": 982.288,
    "text": "再无他人 也再无法义能吸引我"
  },
  {
    "start": 982.288,
    "end": 986.116,
    "text": "因为连这人的法义也并未令我屈臣"
  },
  {
    "start": 986.364,
    "end": 989.258,
    "text": "“佛陀劫掠了我 ”悉达多想"
  },
  {
    "start": 989.258,
    "end": 992.359,
    "text": "他劫掠了我 但他馈赠得更多"
  },
  {
    "start": 992.359,
    "end": 994.013,
    "text": "他夺走了我的朋友"
  },
  {
    "start": 994.013,
    "end": 997.699,
    "text": "那曾经信奉我 如今信奉他的朋友"
  },
  {
    "start": 997.699,
    "end": 999.542,
    "text": "那曾经是我的影子"
  },
  {
    "start": 999.542,
    "end": 1002.537,
    "text": "如今是乔达摩的影子的朋友"
  },
  {
    "start": 1002.537,
    "end": 1005.51,
    "text": "而他所馈赠的 则是悉达多"
  },
  {
    "start": 1005.51,
    "end": 1007.111,
    "text": "是我的自我"
  }
]