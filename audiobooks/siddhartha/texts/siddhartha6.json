[
  {
    "start": 0.0,
    "end": 2.294,
    "text": "第六章 尘世间"
  },
  {
    "start": 2.542,
    "end": 6.486,
    "text": "悉达多来到商人迦摩施瓦弥富丽的宅邸"
  },
  {
    "start": 6.486,
    "end": 9.271,
    "text": "仆人引他踏过昂贵的地毯"
  },
  {
    "start": 9.271,
    "end": 12.085,
    "text": "到一间居室内等待宅邸主人"
  },
  {
    "start": 12.333,
    "end": 16.051,
    "text": "迦摩施瓦弥步入室内 他敏捷矫健"
  },
  {
    "start": 16.051,
    "end": 19.305,
    "text": "华发萧萧 一双眼睛精明谨慎"
  },
  {
    "start": 19.305,
    "end": 20.932,
    "text": "嘴唇流露出贪欲"
  },
  {
    "start": 20.932,
    "end": 23.366,
    "text": "主客二人友好地互致问候"
  },
  {
    "start": 23.614,
    "end": 26.481,
    "text": "“有人告诉我 ”商人开口道"
  },
  {
    "start": 26.481,
    "end": 28.53,
    "text": "你是位博学的婆罗门"
  },
  {
    "start": 28.53,
    "end": 30.783,
    "text": "却要在商人处寻个职务"
  },
  {
    "start": 30.783,
    "end": 33.422,
    "text": "你这位婆罗门可是陷入困境"
  },
  {
    "start": 33.67,
    "end": 37.826,
    "text": "“不 ”悉达多道 “我并未陷入困境"
  },
  {
    "start": 37.826,
    "end": 40.014,
    "text": "也从未陷入困境 你知道"
  },
  {
    "start": 40.014,
    "end": 42.383,
    "text": "我在林中做了多年沙门"
  },
  {
    "start": 42.631,
    "end": 45.531,
    "text": "商人道  既然你从沙门中来"
  },
  {
    "start": 45.531,
    "end": 47.187,
    "text": "又怎能不陷入困境"
  },
  {
    "start": 47.187,
    "end": 49.88,
    "text": "沙门不是都一无所有吗"
  },
  {
    "start": 50.128,
    "end": 52.829,
    "text": "“我没有财产 ”悉达多道"
  },
  {
    "start": 52.829,
    "end": 56.36,
    "text": "如果你指这一点 我的确一无所有"
  },
  {
    "start": 56.36,
    "end": 58.022,
    "text": "但我志愿成为沙门"
  },
  {
    "start": 58.022,
    "end": 59.971,
    "text": "所以我并未陷入困境"
  },
  {
    "start": 60.219,
    "end": 62.766,
    "text": "商人问  既然你一无所有"
  },
  {
    "start": 62.766,
    "end": 64.333,
    "text": "你靠什么生活"
  },
  {
    "start": 64.581,
    "end": 67.216,
    "text": "悉达多答  我从未想过"
  },
  {
    "start": 67.216,
    "end": 70.51,
    "text": "先生 三年有余 我一无所有"
  },
  {
    "start": 70.51,
    "end": 72.925,
    "text": "却从未想过靠什么生活"
  },
  {
    "start": 73.173,
    "end": 76.582,
    "text": "商人道 “看来你靠他人钱财为生 ”"
  },
  {
    "start": 76.83,
    "end": 78.925,
    "text": "悉达多道  看来是"
  },
  {
    "start": 78.925,
    "end": 81.439,
    "text": "商人也靠他人钱财为生"
  },
  {
    "start": 81.687,
    "end": 83.863,
    "text": "商人回应  说得好"
  },
  {
    "start": 83.863,
    "end": 86.257,
    "text": "但商人却不白拿他人钱财"
  },
  {
    "start": 86.257,
    "end": 88.216,
    "text": "他以货物交易"
  },
  {
    "start": 88.464,
    "end": 92.732,
    "text": "悉达多道  世事看似如此 各有索取"
  },
  {
    "start": 92.732,
    "end": 94.978,
    "text": "各有付出 这是生活"
  },
  {
    "start": 95.226,
    "end": 98.787,
    "text": "商人问  恕我直言：如果你一无所有"
  },
  {
    "start": 98.787,
    "end": 100.37,
    "text": "你能付出什么"
  },
  {
    "start": 100.618,
    "end": 104.169,
    "text": "悉达多答  人人都付出他拥有的"
  },
  {
    "start": 104.169,
    "end": 107.276,
    "text": "武士付出力气 商人付出货物"
  },
  {
    "start": 107.276,
    "end": 108.607,
    "text": "教师付出学问"
  },
  {
    "start": 108.607,
    "end": 112.081,
    "text": "农民付出稻谷 渔民付出鱼蟹"
  },
  {
    "start": 112.329,
    "end": 114.445,
    "text": "商人追问  非常对"
  },
  {
    "start": 114.445,
    "end": 118.255,
    "text": "只是 你付出什么 你究竟学过什么"
  },
  {
    "start": 118.255,
    "end": 119.313,
    "text": "又会什么"
  },
  {
    "start": 119.561,
    "end": 122.991,
    "text": "悉达多道  我会思考 我会等待"
  },
  {
    "start": 122.991,
    "end": 124.0,
    "text": "我会斋戒"
  },
  {
    "start": 124.248,
    "end": 126.142,
    "text": "商人问 “就这些吗 ”"
  },
  {
    "start": 126.39,
    "end": 129.334,
    "text": "悉达多答 “我想 就是这些 ”"
  },
  {
    "start": 129.582,
    "end": 132.644,
    "text": "商人表示不屑  这些有何用处"
  },
  {
    "start": 132.644,
    "end": 135.501,
    "text": "比如斋戒——斋戒有何益处"
  },
  {
    "start": 135.749,
    "end": 139.52,
    "text": "悉达多从容地说  斋戒极好 先生"
  },
  {
    "start": 139.52,
    "end": 142.453,
    "text": "对于没有食物的人 斋戒最为明智"
  },
  {
    "start": 142.453,
    "end": 144.613,
    "text": "假如悉达多没学过斋戒"
  },
  {
    "start": 144.613,
    "end": 148.502,
    "text": "他今天就必须寻找活计 不论在你这里"
  },
  {
    "start": 148.502,
    "end": 149.582,
    "text": "还是别处"
  },
  {
    "start": 149.582,
    "end": 152.681,
    "text": "饥饿迫使他行动 而事实上"
  },
  {
    "start": 152.681,
    "end": 156.496,
    "text": "悉达多能安静地等待 他从不焦急"
  },
  {
    "start": 156.496,
    "end": 157.926,
    "text": "从不陷于窘迫"
  },
  {
    "start": 157.926,
    "end": 160.382,
    "text": "即便长时间被饥饿围困"
  },
  {
    "start": 160.382,
    "end": 164.067,
    "text": "他仍能藐视饥饿 因此 先生"
  },
  {
    "start": 164.067,
    "end": 165.54,
    "text": "斋戒极好"
  },
  {
    "start": 165.788,
    "end": 167.858,
    "text": "商人道  你说得对"
  },
  {
    "start": 167.858,
    "end": 169.927,
    "text": "沙门 请稍等片刻"
  },
  {
    "start": 170.175,
    "end": 170.598,
    "text": "说着"
  },
  {
    "start": 170.598,
    "end": 173.764,
    "text": "迦摩施瓦弥走出去并带回一份案卷"
  },
  {
    "start": 173.764,
    "end": 177.774,
    "text": "“你能否读一下 ”他将案卷递给客人"
  },
  {
    "start": 178.022,
    "end": 181.798,
    "text": "悉达多接过案卷 见它是一份买卖契约"
  },
  {
    "start": 181.798,
    "end": 183.476,
    "text": "便朗读起其中内容"
  },
  {
    "start": 183.724,
    "end": 186.138,
    "text": "“好极了 ”迦摩施瓦弥道"
  },
  {
    "start": 186.138,
    "end": 188.923,
    "text": "“你可愿在纸上为我写些什么 ”"
  },
  {
    "start": 189.171,
    "end": 192.319,
    "text": "说着 他将纸笔递给悉达多"
  },
  {
    "start": 192.319,
    "end": 195.225,
    "text": "悉达多写罢后将纸交还与他"
  },
  {
    "start": 195.473,
    "end": 198.647,
    "text": "迦摩施瓦弥读道： 书写虽好"
  },
  {
    "start": 198.647,
    "end": 202.797,
    "text": "思考更佳 聪敏虽好 忍耐更佳"
  },
  {
    "start": 203.045,
    "end": 206.206,
    "text": "“你写得精彩 ”商人夸赞道"
  },
  {
    "start": 206.206,
    "end": 210.269,
    "text": "我们还要就许多事情进一步商谈 今天"
  },
  {
    "start": 210.269,
    "end": 211.917,
    "text": "我先邀你做我的客人"
  },
  {
    "start": 211.917,
    "end": 213.749,
    "text": "安顿于我的宅邸"
  },
  {
    "start": 213.996,
    "end": 216.65,
    "text": "悉达多感谢并接受了邀请"
  },
  {
    "start": 216.65,
    "end": 218.58,
    "text": "在商人的宅邸住下"
  },
  {
    "start": 218.58,
    "end": 221.716,
    "text": "仆人为他奉上衣裳和鞋子"
  },
  {
    "start": 221.716,
    "end": 223.914,
    "text": "并服侍他每日沐浴"
  },
  {
    "start": 223.914,
    "end": 226.937,
    "text": "宅邸内每日两餐丰足味美"
  },
  {
    "start": 226.937,
    "end": 231.335,
    "text": "但悉达多只食一餐 且既不食荤"
  },
  {
    "start": 231.335,
    "end": 235.538,
    "text": "亦不饮酒 迦摩施瓦弥常谈论他的生意"
  },
  {
    "start": 235.538,
    "end": 238.574,
    "text": "向悉达多介绍他的货品、货栈"
  },
  {
    "start": 238.574,
    "end": 240.648,
    "text": "指导悉达多清算账目"
  },
  {
    "start": 240.648,
    "end": 244.106,
    "text": "悉达多学会许多新知 他听得多"
  },
  {
    "start": 244.106,
    "end": 247.103,
    "text": "说得少 他牢记迦摩罗的话"
  },
  {
    "start": 247.103,
    "end": 249.577,
    "text": "在商人面前从未奴颜婢膝"
  },
  {
    "start": 249.577,
    "end": 252.052,
    "text": "这迫使商人与他平起平坐"
  },
  {
    "start": 252.052,
    "end": 254.302,
    "text": "甚至对他高看一眼"
  },
  {
    "start": 254.302,
    "end": 258.664,
    "text": "迦摩施瓦弥严谨地经营生意 饱含激情"
  },
  {
    "start": 258.664,
    "end": 263.026,
    "text": "悉达多则视一切如游戏 他努力学习规则"
  },
  {
    "start": 263.026,
    "end": 265.36,
    "text": "内容他并不记挂于心"
  },
  {
    "start": 265.608,
    "end": 267.344,
    "text": "在宅邸中住了不久"
  },
  {
    "start": 267.344,
    "end": 270.816,
    "text": "悉达多便开始分担迦摩施瓦弥的生意"
  },
  {
    "start": 270.816,
    "end": 273.637,
    "text": "每日 他也在约定的时辰"
  },
  {
    "start": 273.637,
    "end": 276.138,
    "text": "登门拜访美丽的迦摩罗"
  },
  {
    "start": 276.138,
    "end": 280.391,
    "text": "他身穿华美的衣裳 足蹬精致的鞋子"
  },
  {
    "start": 280.391,
    "end": 281.141,
    "text": "很快"
  },
  {
    "start": 281.141,
    "end": 283.534,
    "text": "他也在造访时携带礼物"
  },
  {
    "start": 283.534,
    "end": 285.927,
    "text": "迦摩罗娇艳聪慧的嘴唇"
  },
  {
    "start": 285.927,
    "end": 289.755,
    "text": "温柔细腻的双手教会他许多学问"
  },
  {
    "start": 289.755,
    "end": 293.687,
    "text": "在欢爱的路上 悉达多仍蹒跚学步"
  },
  {
    "start": 293.687,
    "end": 297.864,
    "text": "他时常冒失 求索无厌地跌入情欲深渊"
  },
  {
    "start": 297.864,
    "end": 299.632,
    "text": "而迦摩罗则教会他"
  },
  {
    "start": 299.632,
    "end": 301.621,
    "text": "不付出情欲就难收获"
  },
  {
    "start": 301.621,
    "end": 306.483,
    "text": "情欲这一《爱经》的根本每种姿势 每个动作"
  },
  {
    "start": 306.483,
    "end": 308.798,
    "text": "每次抚摸 每次对视"
  },
  {
    "start": 308.798,
    "end": 312.733,
    "text": "身体的每个角落都隐藏秘密 这些秘密"
  },
  {
    "start": 312.733,
    "end": 315.772,
    "text": "为懂得唤醒它的人预备了幸福"
  },
  {
    "start": 315.772,
    "end": 319.982,
    "text": "她教导他 爱侣在交欢后不得倏忽分离"
  },
  {
    "start": 319.982,
    "end": 323.547,
    "text": "彼此仍要相互赞叹、抚慰 这样"
  },
  {
    "start": 323.547,
    "end": 326.161,
    "text": "双方才不会因过度性满足"
  },
  {
    "start": 326.161,
    "end": 328.301,
    "text": "而产生厌倦、落寞"
  },
  {
    "start": 328.301,
    "end": 331.522,
    "text": "产生辱弄或被辱弄的不快感受"
  },
  {
    "start": 331.522,
    "end": 334.001,
    "text": "在美丽聪慧的艺术家处"
  },
  {
    "start": 334.001,
    "end": 336.975,
    "text": "悉达多度过了绝妙时光"
  },
  {
    "start": 336.975,
    "end": 339.728,
    "text": "他成为她的学生、情人、朋友"
  },
  {
    "start": 339.728,
    "end": 341.634,
    "text": "对于现在的悉达多"
  },
  {
    "start": 341.634,
    "end": 345.417,
    "text": "生活的意义和价值是能和迦摩罗在一起"
  },
  {
    "start": 345.417,
    "end": 348.088,
    "text": "而绝非迦摩施瓦弥的生意"
  },
  {
    "start": 348.336,
    "end": 352.475,
    "text": "商人委托悉达多书写重要的信件和契约"
  },
  {
    "start": 352.475,
    "end": 356.371,
    "text": "他也习惯在紧要事务上同悉达多商议"
  },
  {
    "start": 356.371,
    "end": 357.345,
    "text": "很快"
  },
  {
    "start": 357.345,
    "end": 359.653,
    "text": "他发现悉达多对稻谷、"
  },
  {
    "start": 359.653,
    "end": 365.194,
    "text": "棉布、船务和买卖并不在行他的运气是 和商人相比"
  },
  {
    "start": 365.194,
    "end": 367.575,
    "text": "他的冷静沉着更胜一筹"
  },
  {
    "start": 367.575,
    "end": 371.862,
    "text": "和陌生人打交道时 他懂得倾听的艺术"
  },
  {
    "start": 371.862,
    "end": 373.053,
    "text": "善解人意"
  },
  {
    "start": 373.053,
    "end": 374.11,
    "text": "这位婆罗门"
  },
  {
    "start": 374.11,
    "end": 376.048,
    "text": "迦摩施瓦弥曾对朋友说"
  },
  {
    "start": 376.048,
    "end": 377.457,
    "text": "不是真正的商人"
  },
  {
    "start": 377.457,
    "end": 379.747,
    "text": "也不会成为真正的商人"
  },
  {
    "start": 379.747,
    "end": 382.795,
    "text": "在生意上 他从未投入热情"
  },
  {
    "start": 382.795,
    "end": 387.015,
    "text": "但是他掌握那些无为而治的成功者的秘密"
  },
  {
    "start": 387.015,
    "end": 388.891,
    "text": "或许他福星高照"
  },
  {
    "start": 388.891,
    "end": 390.704,
    "text": "或许他会施展法术"
  },
  {
    "start": 390.704,
    "end": 393.424,
    "text": "或许他从沙门处学到了什么"
  },
  {
    "start": 393.424,
    "end": 397.73,
    "text": "他似乎总在生意上游戏 从不全情投入"
  },
  {
    "start": 397.73,
    "end": 399.816,
    "text": "生意从来也无法牵制他"
  },
  {
    "start": 399.816,
    "end": 403.569,
    "text": "他从不担心失败 从不为损失烦忧"
  },
  {
    "start": 403.817,
    "end": 406.051,
    "text": "这位朋友建议商人： 你"
  },
  {
    "start": 406.051,
    "end": 411.331,
    "text": "可将一部分生意交与他替你打理三分之一的盈利归他所有"
  },
  {
    "start": 411.331,
    "end": 415.712,
    "text": "反之 他也须承担同等损失 如此一来"
  },
  {
    "start": 415.712,
    "end": 417.325,
    "text": "他必会用心些"
  },
  {
    "start": 417.573,
    "end": 420.41,
    "text": "迦摩施瓦弥采纳了这个建议"
  },
  {
    "start": 420.41,
    "end": 423.719,
    "text": "悉达多则安之若素 如有盈余"
  },
  {
    "start": 423.719,
    "end": 426.082,
    "text": "他便取他该得的那份"
  },
  {
    "start": 426.082,
    "end": 428.815,
    "text": "如果亏损 他会笑着说： 哎"
  },
  {
    "start": 428.815,
    "end": 431.156,
    "text": "你看 多么糟糕的交易"
  },
  {
    "start": 431.404,
    "end": 434.864,
    "text": "他显然对生意心不在焉 一次"
  },
  {
    "start": 434.864,
    "end": 438.818,
    "text": "他去村落收购大批稻谷 当他抵达时"
  },
  {
    "start": 438.818,
    "end": 443.04,
    "text": "稻谷已全部卖给其他商人 尽管如此"
  },
  {
    "start": 443.04,
    "end": 447.262,
    "text": "悉达多仍在村落逗留数日 他宴请农民"
  },
  {
    "start": 447.262,
    "end": 449.444,
    "text": "送给农民的孩子铜币"
  },
  {
    "start": 449.444,
    "end": 453.322,
    "text": "参加一次结婚庆典 随后满意而归"
  },
  {
    "start": 453.322,
    "end": 456.373,
    "text": "迦摩施瓦弥责备他没有及时赶回"
  },
  {
    "start": 456.373,
    "end": 458.117,
    "text": "损失了时间和钱财"
  },
  {
    "start": 458.117,
    "end": 460.951,
    "text": "悉达多答道： 不要责备"
  },
  {
    "start": 460.951,
    "end": 464.465,
    "text": "亲爱的朋友 责备向来于事无补"
  },
  {
    "start": 464.465,
    "end": 466.573,
    "text": "蒙受的损失由我承担"
  },
  {
    "start": 466.573,
    "end": 469.15,
    "text": "我对这次旅行非常满意"
  },
  {
    "start": 469.15,
    "end": 470.755,
    "text": "我认识了许多人"
  },
  {
    "start": 470.755,
    "end": 473.277,
    "text": "一位婆罗门成了我的朋友"
  },
  {
    "start": 473.277,
    "end": 475.799,
    "text": "孩子们在我膝上玩耍"
  },
  {
    "start": 475.799,
    "end": 477.978,
    "text": "农民带我参观他们的田地"
  },
  {
    "start": 477.978,
    "end": 480.553,
    "text": "没人把我当作一位商人"
  },
  {
    "start": 480.801,
    "end": 481.814,
    "text": "做得漂亮"
  },
  {
    "start": 481.814,
    "end": 484.244,
    "text": "迦摩施瓦弥不情愿地喊道"
  },
  {
    "start": 484.244,
    "end": 487.89,
    "text": "但事实上你是个商人 我必须得说"
  },
  {
    "start": 487.89,
    "end": 490.384,
    "text": "难道你的旅行只是为了赏玩"
  },
  {
    "start": 490.632,
    "end": 493.125,
    "text": "“确实 ”悉达多笑道"
  },
  {
    "start": 493.125,
    "end": 496.526,
    "text": "我确实为赏玩而去 否则为何"
  },
  {
    "start": 496.526,
    "end": 499.246,
    "text": "我见到许多人 欣赏了风景"
  },
  {
    "start": 499.246,
    "end": 503.672,
    "text": "收获了友谊和信任 结交了朋友 你看"
  },
  {
    "start": 503.672,
    "end": 507.165,
    "text": "亲爱的 如果我是你迦摩施瓦弥"
  },
  {
    "start": 507.165,
    "end": 508.33,
    "text": "见到生意落空"
  },
  {
    "start": 508.33,
    "end": 512.192,
    "text": "定是气恼地速速返回 可事实上"
  },
  {
    "start": 512.192,
    "end": 515.024,
    "text": "时间和金钱已经蒙受损失"
  },
  {
    "start": 515.024,
    "end": 518.114,
    "text": "而我享受了几天美妙时光"
  },
  {
    "start": 518.114,
    "end": 520.717,
    "text": "学到了知识 心情愉快"
  },
  {
    "start": 520.717,
    "end": 522.847,
    "text": "我和他人均未因我的"
  },
  {
    "start": 522.847,
    "end": 525.213,
    "text": "气恼和草率而受到伤害"
  },
  {
    "start": 525.213,
    "end": 527.122,
    "text": "如果今后我再去那里"
  },
  {
    "start": 527.122,
    "end": 531.152,
    "text": "或许去收购下季收成 或许因为其他生意"
  },
  {
    "start": 531.152,
    "end": 534.687,
    "text": "那里友好的人们必将由于我这次没有"
  },
  {
    "start": 534.687,
    "end": 539.326,
    "text": "表现得急躁和闷闷不乐而热情地款待我释怀吧"
  },
  {
    "start": 539.326,
    "end": 542.443,
    "text": "朋友 不要因责备而伤害自己"
  },
  {
    "start": 542.443,
    "end": 544.001,
    "text": "如果有那么一天"
  },
  {
    "start": 544.001,
    "end": 546.895,
    "text": "你看到悉达多为你带来损失"
  },
  {
    "start": 546.895,
    "end": 550.247,
    "text": "你只消说一声 悉达多便自行离去"
  },
  {
    "start": 550.247,
    "end": 553.39,
    "text": "在那之前 我们还是善待彼此"
  },
  {
    "start": 553.638,
    "end": 557.046,
    "text": "商人也曾徒劳地尝试让悉达多相信"
  },
  {
    "start": 557.046,
    "end": 559.091,
    "text": "他靠迦摩施瓦弥为生"
  },
  {
    "start": 559.091,
    "end": 562.272,
    "text": "但悉达多认为他靠自己为生"
  },
  {
    "start": 562.272,
    "end": 565.837,
    "text": "确切地说 他们两人均靠他人为生"
  },
  {
    "start": 565.837,
    "end": 566.951,
    "text": "靠众人为生"
  },
  {
    "start": 566.951,
    "end": 570.516,
    "text": "悉达多从不过问迦摩施瓦弥的烦恼"
  },
  {
    "start": 570.516,
    "end": 572.552,
    "text": "而后者则烦恼颇多"
  },
  {
    "start": 572.552,
    "end": 575.352,
    "text": "他担心一笔生意行将失败"
  },
  {
    "start": 575.352,
    "end": 579.425,
    "text": "货物蒙受损失 借贷人无力偿还"
  },
  {
    "start": 579.425,
    "end": 580.333,
    "text": "无论如何"
  },
  {
    "start": 580.333,
    "end": 583.964,
    "text": "迦摩施瓦弥始终无法向悉达多证明"
  },
  {
    "start": 583.964,
    "end": 586.042,
    "text": "抱怨、急躁、平添"
  },
  {
    "start": 586.042,
    "end": 592.538,
    "text": "皱纹或辗转反侧有何益处一次 迦摩施瓦弥提醒悉达多"
  },
  {
    "start": 592.538,
    "end": 596.049,
    "text": "他的一切知识都是从迦摩施瓦弥处学来"
  },
  {
    "start": 596.049,
    "end": 598.115,
    "text": "悉达多反驳道： 最好"
  },
  {
    "start": 598.115,
    "end": 600.387,
    "text": "不要和我开这样的玩笑"
  },
  {
    "start": 600.387,
    "end": 603.219,
    "text": "我从你那里学到一篓鱼的售价"
  },
  {
    "start": 603.219,
    "end": 607.141,
    "text": "借贷他人获得多少利息 这是你的学问"
  },
  {
    "start": 607.141,
    "end": 609.48,
    "text": "我和你从未学过如何思考"
  },
  {
    "start": 609.48,
    "end": 611.181,
    "text": "尊贵的迦摩施瓦弥"
  },
  {
    "start": 611.181,
    "end": 614.37,
    "text": "你最好向我学习如何思考"
  },
  {
    "start": 614.618,
    "end": 618.579,
    "text": "悉达多的确无心生意 做生意的益处"
  },
  {
    "start": 618.579,
    "end": 622.307,
    "text": "无非是令他有足够的钱财交与迦摩罗"
  },
  {
    "start": 622.307,
    "end": 625.743,
    "text": "尽管他获得的远超出他所需要的"
  },
  {
    "start": 625.743,
    "end": 627.706,
    "text": "他只是对曾经如同"
  },
  {
    "start": 627.706,
    "end": 630.651,
    "text": "月亮般遥远而陌生的世人"
  },
  {
    "start": 630.651,
    "end": 633.462,
    "text": "他们的生意、手艺、忧烦"
  },
  {
    "start": 633.462,
    "end": 637.805,
    "text": "他们的娱乐和蠢行感到既同情又好奇"
  },
  {
    "start": 637.805,
    "end": 640.669,
    "text": "虽然他能轻而易举地和他们攀谈"
  },
  {
    "start": 640.669,
    "end": 643.124,
    "text": "与他们相处 向他们学习"
  },
  {
    "start": 643.124,
    "end": 644.965,
    "text": "但他深刻地认识到"
  },
  {
    "start": 644.965,
    "end": 647.198,
    "text": "将他同世人区分开来的"
  },
  {
    "start": 647.198,
    "end": 648.984,
    "text": "是他做沙门的经历"
  },
  {
    "start": 648.984,
    "end": 653.004,
    "text": "他看见世人以孩童或动物的方式生活"
  },
  {
    "start": 653.004,
    "end": 655.167,
    "text": "这让他既爱慕又蔑视"
  },
  {
    "start": 655.167,
    "end": 657.331,
    "text": "他看见他们为一些在"
  },
  {
    "start": 657.331,
    "end": 660.938,
    "text": "他看来毫无价值的东西为了钱"
  },
  {
    "start": 660.938,
    "end": 663.085,
    "text": "为了微不足道的欲望"
  },
  {
    "start": 663.085,
    "end": 666.902,
    "text": "为了可怜的尊严而操劳、受苦、衰老"
  },
  {
    "start": 666.902,
    "end": 670.242,
    "text": "他看见他们彼此责骂、羞辱"
  },
  {
    "start": 670.242,
    "end": 672.112,
    "text": "看见他们为那些令"
  },
  {
    "start": 672.112,
    "end": 678.426,
    "text": "沙门付之一哂的痛苦恸哭为那些令沙门不屑一顾的贫乏苦恼"
  },
  {
    "start": 678.674,
    "end": 680.736,
    "text": "他接纳人们带来的一切"
  },
  {
    "start": 680.736,
    "end": 682.799,
    "text": "他欢迎兜售亚麻的商人"
  },
  {
    "start": 682.799,
    "end": 685.068,
    "text": "欢迎来向他借贷的人"
  },
  {
    "start": 685.068,
    "end": 686.987,
    "text": "也愿意长久地倾听"
  },
  {
    "start": 686.987,
    "end": 689.627,
    "text": "乞丐讲述自己潦倒的生活"
  },
  {
    "start": 689.627,
    "end": 691.769,
    "text": "尽管他们的生活远不及"
  },
  {
    "start": 691.769,
    "end": 696.481,
    "text": "任何一位沙门的生活贫穷他对待富庶的外国商人"
  },
  {
    "start": 696.481,
    "end": 698.788,
    "text": "和对待替他刮脸的仆人"
  },
  {
    "start": 698.788,
    "end": 701.095,
    "text": "对待他故意被骗去几个"
  },
  {
    "start": 701.095,
    "end": 704.325,
    "text": "铜板的街头香蕉小贩别无二致"
  },
  {
    "start": 704.325,
    "end": 706.914,
    "text": "如果迦摩施瓦弥来找他抱怨"
  },
  {
    "start": 706.914,
    "end": 708.856,
    "text": "或因一桩生意指责他"
  },
  {
    "start": 708.856,
    "end": 712.524,
    "text": "他也会好奇地耐心倾听 表示惊讶"
  },
  {
    "start": 712.524,
    "end": 715.486,
    "text": "试图理解 对他做适度的让步"
  },
  {
    "start": 715.486,
    "end": 719.083,
    "text": "接着离开他 去约见下一位需要他的人"
  },
  {
    "start": 719.083,
    "end": 723.267,
    "text": "许多人来找他做生意 许多人想蒙骗他"
  },
  {
    "start": 723.267,
    "end": 725.126,
    "text": "许多人试图探听他"
  },
  {
    "start": 725.126,
    "end": 727.682,
    "text": "许多人想博得他的同情"
  },
  {
    "start": 727.682,
    "end": 731.718,
    "text": "许多人想得到他的建议 他给出建议"
  },
  {
    "start": 731.718,
    "end": 735.991,
    "text": "表示同情 慷慨解囊 他甚至故意被欺骗"
  },
  {
    "start": 735.991,
    "end": 737.735,
    "text": "就像当年他热衷于"
  },
  {
    "start": 737.735,
    "end": 744.056,
    "text": "侍奉诸神和做沙门时一样他全神贯注 激情饱满地和众人游戏着"
  },
  {
    "start": 744.303,
    "end": 744.806,
    "text": "时常"
  },
  {
    "start": 744.806,
    "end": 747.316,
    "text": "他感到内心深处有一个"
  },
  {
    "start": 747.316,
    "end": 753.592,
    "text": "垂微的声音在轻声提醒轻声抱怨 轻到几乎无从捕捉"
  },
  {
    "start": 753.592,
    "end": 755.23,
    "text": "他开始在某些时刻"
  },
  {
    "start": 755.23,
    "end": 760.962,
    "text": "意识到自己正过着荒谬的生活所有这些他做的事情无非是游戏"
  },
  {
    "start": 760.962,
    "end": 764.498,
    "text": "这游戏令他快活 偶尔让他愉悦"
  },
  {
    "start": 764.498,
    "end": 768.506,
    "text": "但是真实的生活却擦身而过 无法触及"
  },
  {
    "start": 768.506,
    "end": 770.308,
    "text": "如同一个人在玩球"
  },
  {
    "start": 770.308,
    "end": 773.461,
    "text": "他同他的生意以及周围的人玩耍"
  },
  {
    "start": 773.461,
    "end": 777.29,
    "text": "他冷眼旁观 寻得开心 而他的心"
  },
  {
    "start": 777.29,
    "end": 781.545,
    "text": "他存在的源泉却不在 那眼泉十分遥远"
  },
  {
    "start": 781.545,
    "end": 785.801,
    "text": "渐渐消失在视线之外 与他的生活无关"
  },
  {
    "start": 785.801,
    "end": 786.274,
    "text": "几次"
  },
  {
    "start": 786.274,
    "end": 789.361,
    "text": "他为他意识到的这一切感到惊恐"
  },
  {
    "start": 789.361,
    "end": 792.008,
    "text": "他希望自己也能满腔热情"
  },
  {
    "start": 792.008,
    "end": 796.061,
    "text": "全心全意地参与到孩子气的日常行为中"
  },
  {
    "start": 796.061,
    "end": 799.637,
    "text": "真正地去生活、去劳作、去享乐"
  },
  {
    "start": 799.637,
    "end": 801.606,
    "text": "而不只是一位旁观者"
  },
  {
    "start": 801.854,
    "end": 804.464,
    "text": "他一直拜访美丽的迦摩罗"
  },
  {
    "start": 804.464,
    "end": 808.973,
    "text": "学爱情的艺术 做情欲的礼拜 在性爱中"
  },
  {
    "start": 808.973,
    "end": 813.121,
    "text": "付出和索取比在任何别处都更加水乳"
  },
  {
    "start": 813.121,
    "end": 818.047,
    "text": "交融 他跟她闲谈 向她学习 给她建议"
  },
  {
    "start": 818.047,
    "end": 819.609,
    "text": "也接受她的忠告"
  },
  {
    "start": 819.609,
    "end": 821.617,
    "text": "迦摩罗对他的了解更"
  },
  {
    "start": 821.617,
    "end": 826.301,
    "text": "胜于当年乔文达对他的了解她跟他更加相像"
  },
  {
    "start": 826.549,
    "end": 830.03,
    "text": "有一次 他对她说： 你就像我"
  },
  {
    "start": 830.03,
    "end": 833.51,
    "text": "你跟大多数人不同 你是迦摩罗"
  },
  {
    "start": 833.51,
    "end": 834.438,
    "text": "不是别人"
  },
  {
    "start": 834.438,
    "end": 837.983,
    "text": "你随时可抵达内心安静庇护的一隅"
  },
  {
    "start": 837.983,
    "end": 840.346,
    "text": "如同回家 我亦如此"
  },
  {
    "start": 840.346,
    "end": 843.417,
    "text": "只有少数人才有这样的内心"
  },
  {
    "start": 843.417,
    "end": 845.471,
    "text": "尽管人人都可习得"
  },
  {
    "start": 845.719,
    "end": 848.503,
    "text": "“不是所有人都聪明 ”迦摩罗道"
  },
  {
    "start": 848.751,
    "end": 852.808,
    "text": "“不 ”悉达多道 “聪明并非关键"
  },
  {
    "start": 852.808,
    "end": 854.61,
    "text": "迦摩施瓦弥聪明如我"
  },
  {
    "start": 854.61,
    "end": 858.2,
    "text": "但他心中没有这安静庇护的一隅"
  },
  {
    "start": 858.2,
    "end": 862.302,
    "text": "其他人内心虽有 但才智却如孩童"
  },
  {
    "start": 862.302,
    "end": 864.609,
    "text": "大多数人 迦摩罗"
  },
  {
    "start": 864.609,
    "end": 868.888,
    "text": "仿佛一片落叶 在空中翻滚、飘摇"
  },
  {
    "start": 868.888,
    "end": 873.434,
    "text": "最后踉跄着归于尘土 有的人 极少数"
  },
  {
    "start": 873.434,
    "end": 877.55,
    "text": "如同天际之星 沿着固定的轨迹运行"
  },
  {
    "start": 877.55,
    "end": 881.908,
    "text": "没有风能动摇他 他内心自有律法和轨道"
  },
  {
    "start": 881.908,
    "end": 884.302,
    "text": "在我认识的沙门和贤士中"
  },
  {
    "start": 884.302,
    "end": 885.826,
    "text": "有一位即是如此"
  },
  {
    "start": 885.826,
    "end": 888.22,
    "text": "他是一位功德圆满的觉者"
  },
  {
    "start": 888.22,
    "end": 890.397,
    "text": "我永远不会忘记"
  },
  {
    "start": 890.397,
    "end": 893.306,
    "text": "他就是乔达摩 世尊佛陀"
  },
  {
    "start": 893.306,
    "end": 894.76,
    "text": "那位宣法之人"
  },
  {
    "start": 894.76,
    "end": 899.366,
    "text": "每天有上千徒众听他宣法 追随他的脚步"
  },
  {
    "start": 899.366,
    "end": 901.423,
    "text": "但这些徒众却如同落叶"
  },
  {
    "start": 901.423,
    "end": 904.51,
    "text": "内心没有自己的教义和律法"
  },
  {
    "start": 904.758,
    "end": 907.834,
    "text": "迦摩罗含笑注视他  你又提起他"
  },
  {
    "start": 907.834,
    "end": 908.411,
    "text": "她道"
  },
  {
    "start": 908.411,
    "end": 911.487,
    "text": "“你的思想又如同一位沙门了 ”"
  },
  {
    "start": 911.735,
    "end": 914.274,
    "text": "悉达多沉默不语 接着"
  },
  {
    "start": 914.274,
    "end": 916.814,
    "text": "他们以迦摩罗熟悉的三十"
  },
  {
    "start": 916.814,
    "end": 919.584,
    "text": "种或四十种不同的体位做爱"
  },
  {
    "start": 919.584,
    "end": 923.784,
    "text": "她的身躯像豹子 像猎人的弓弦般柔韧"
  },
  {
    "start": 923.784,
    "end": 927.518,
    "text": "跟她鱼水相欢之人 必获得诸多快感"
  },
  {
    "start": 927.518,
    "end": 932.08,
    "text": "洞悉许多秘密 她和悉达多长久地做爱"
  },
  {
    "start": 932.08,
    "end": 936.642,
    "text": "她引诱他 再推辞他 强逼他 再顺从他"
  },
  {
    "start": 936.642,
    "end": 938.594,
    "text": "为他高超的技巧雀跃"
  },
  {
    "start": 938.594,
    "end": 940.329,
    "text": "直至他被完全征服"
  },
  {
    "start": 940.329,
    "end": 942.931,
    "text": "精疲力竭地躺在她身边"
  },
  {
    "start": 943.179,
    "end": 945.474,
    "text": "名妓迦摩罗伏在他身上"
  },
  {
    "start": 945.474,
    "end": 947.768,
    "text": "久久地凝视悉达多的脸"
  },
  {
    "start": 947.768,
    "end": 950.063,
    "text": "凝视他疲惫的双睛"
  },
  {
    "start": 950.311,
    "end": 953.451,
    "text": "“你是我见过的 ”她思索着"
  },
  {
    "start": 953.451,
    "end": 956.816,
    "text": "最好的情人 你比别人更强壮"
  },
  {
    "start": 956.816,
    "end": 958.835,
    "text": "更柔韧 更欲望强烈"
  },
  {
    "start": 958.835,
    "end": 963.305,
    "text": "你出色地学会我的艺术 悉达多 日后"
  },
  {
    "start": 963.305,
    "end": 967.304,
    "text": "待我年纪大些 我要有一个你的孩子"
  },
  {
    "start": 967.304,
    "end": 967.539,
    "text": "然而"
  },
  {
    "start": 967.539,
    "end": 971.437,
    "text": "亲爱的 你依然是个沙门 你并不爱我"
  },
  {
    "start": 971.437,
    "end": 974.103,
    "text": "也不爱任何人 难道不是吗"
  },
  {
    "start": 974.351,
    "end": 977.232,
    "text": "“或许是 ”悉达多疲惫地说"
  },
  {
    "start": 977.232,
    "end": 978.26,
    "text": "我就像你"
  },
  {
    "start": 978.26,
    "end": 980.55,
    "text": "你也谁都不爱——否则"
  },
  {
    "start": 980.55,
    "end": 986.044,
    "text": "你怎会将爱当作艺术经营像你我这类人大概都不会爱"
  },
  {
    "start": 986.044,
    "end": 988.166,
    "text": "如孩童般的世人才会爱"
  },
  {
    "start": 988.166,
    "end": 990.288,
    "text": "这是他们的秘密"
  }
]