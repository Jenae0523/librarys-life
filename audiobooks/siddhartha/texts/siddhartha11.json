[
  {
    "start": 0.0,
    "end": 2.004,
    "text": "第11章 唵"
  },
  {
    "start": 2.251,
    "end": 4.123,
    "text": "伤口仍久久灼痛"
  },
  {
    "start": 4.123,
    "end": 8.936,
    "text": "悉达多见到携儿带女的船客总不免羡慕"
  },
  {
    "start": 8.936,
    "end": 10.825,
    "text": "哀怨： 为何我不"
  },
  {
    "start": 10.825,
    "end": 16.02,
    "text": "拥有这万千人拥有的幸福即便恶人、窃贼、强盗"
  },
  {
    "start": 16.02,
    "end": 18.749,
    "text": "也有爱他们、他们爱的孩子"
  },
  {
    "start": 18.749,
    "end": 20.113,
    "text": "为何独我没有"
  },
  {
    "start": 20.113,
    "end": 24.434,
    "text": "他就这样简单地、毫无理智地哀怨着"
  },
  {
    "start": 24.434,
    "end": 26.288,
    "text": "和世人一模一样"
  },
  {
    "start": 26.536,
    "end": 30.411,
    "text": "如今 他待人比从前少了聪明、傲慢"
  },
  {
    "start": 30.411,
    "end": 33.375,
    "text": "多了亲切、好奇、关心 如今"
  },
  {
    "start": 33.375,
    "end": 36.719,
    "text": "他见到那些常客——孩童般的世人"
  },
  {
    "start": 36.719,
    "end": 38.503,
    "text": "商人、兵士、妇人"
  },
  {
    "start": 38.503,
    "end": 41.624,
    "text": "不再感到陌生：他理解他们"
  },
  {
    "start": 41.624,
    "end": 45.198,
    "text": "理解并同情他们不是由思想和理智"
  },
  {
    "start": 45.198,
    "end": 48.295,
    "text": "而是由冲动和欲望掌管的生活"
  },
  {
    "start": 48.295,
    "end": 49.963,
    "text": "他感同身受"
  },
  {
    "start": 49.963,
    "end": 51.809,
    "text": "尽管他已近乎完人"
  },
  {
    "start": 51.809,
    "end": 55.962,
    "text": "只承受着最后的伤痛 却视世人如兄弟"
  },
  {
    "start": 55.962,
    "end": 59.834,
    "text": "他不再嘲笑他们的虚荣、欲望和荒谬"
  },
  {
    "start": 59.834,
    "end": 63.221,
    "text": "反而通晓他们 爱戴敬重他们"
  },
  {
    "start": 63.221,
    "end": 65.383,
    "text": "母亲对孩子盲目的爱"
  },
  {
    "start": 65.383,
    "end": 68.505,
    "text": "父亲痴愚盲目地为独子骄傲"
  },
  {
    "start": 68.505,
    "end": 72.608,
    "text": "卖弄风情的年轻女人盲目狂野地追求珠宝"
  },
  {
    "start": 72.608,
    "end": 74.66,
    "text": "和男人猎艳的目光—"
  },
  {
    "start": 74.66,
    "end": 76.939,
    "text": "—对现在的悉达多来说"
  },
  {
    "start": 76.939,
    "end": 79.713,
    "text": "所有这些本能、简单、愚蠢"
  },
  {
    "start": 79.713,
    "end": 82.95,
    "text": "却极为强烈鲜活的欲望不再幼稚"
  },
  {
    "start": 82.95,
    "end": 85.723,
    "text": "他看到人们为欲望而活"
  },
  {
    "start": 85.723,
    "end": 88.931,
    "text": "因欲望不断创造、出行、征战"
  },
  {
    "start": 88.931,
    "end": 91.398,
    "text": "不断受难 他爱他们"
  },
  {
    "start": 91.398,
    "end": 94.104,
    "text": "他在他们的每种激情、每"
  },
  {
    "start": 94.104,
    "end": 99.762,
    "text": "种作为中看到生命、生机看到坚不可摧之物和梵天"
  },
  {
    "start": 99.762,
    "end": 103.072,
    "text": "他在他们盲目的忠诚、盲目的"
  },
  {
    "start": 103.072,
    "end": 106.891,
    "text": "强悍和坚韧中看到可爱和可敬之处"
  },
  {
    "start": 106.891,
    "end": 110.595,
    "text": "世人和学者、思想者相比应有尽有"
  },
  {
    "start": 110.595,
    "end": 114.3,
    "text": "除了唯一微不足道的东西：自觉"
  },
  {
    "start": 114.3,
    "end": 117.42,
    "text": "对生命整体的自觉思考 时常"
  },
  {
    "start": 117.42,
    "end": 120.764,
    "text": "悉达多甚至怀疑自觉的价值被高估"
  },
  {
    "start": 120.764,
    "end": 123.524,
    "text": "或许它只是思想者的天真"
  },
  {
    "start": 123.524,
    "end": 127.538,
    "text": "思想者只是思想的孩童般的世人而已"
  },
  {
    "start": 127.538,
    "end": 129.043,
    "text": "其他方面"
  },
  {
    "start": 129.043,
    "end": 131.96,
    "text": "世人和智者不仅不相上下"
  },
  {
    "start": 131.96,
    "end": 134.613,
    "text": "反而时常考虑得更深远"
  },
  {
    "start": 134.613,
    "end": 139.387,
    "text": "就如同动物在必要时强劲决绝的作为"
  },
  {
    "start": 139.387,
    "end": 141.081,
    "text": "往往胜于人类"
  },
  {
    "start": 141.329,
    "end": 145.087,
    "text": "一种认知逐渐在悉达多头脑中壮大"
  },
  {
    "start": 145.087,
    "end": 149.848,
    "text": "成熟 究竟什么是智慧 什么是他的目标"
  },
  {
    "start": 149.848,
    "end": 152.512,
    "text": "不过是在生命中的每个瞬间"
  },
  {
    "start": 152.512,
    "end": 154.287,
    "text": "能圆融统一地思考"
  },
  {
    "start": 154.287,
    "end": 158.282,
    "text": "能感受并融入这种统一的灵魂的准备"
  },
  {
    "start": 158.282,
    "end": 161.439,
    "text": "一种能力 一种秘密的艺术"
  },
  {
    "start": 161.439,
    "end": 164.596,
    "text": "这种认知在悉达多头脑中繁盛"
  },
  {
    "start": 164.596,
    "end": 167.377,
    "text": "又反映在瓦稣迪瓦苍老的"
  },
  {
    "start": 167.377,
    "end": 173.19,
    "text": "童颜上：和谐、喜悦、统一对永恒圆融世界的学识"
  },
  {
    "start": 173.438,
    "end": 175.216,
    "text": "可伤口依然灼痛"
  },
  {
    "start": 175.216,
    "end": 177.755,
    "text": "悉达多苦苦思念着儿子"
  },
  {
    "start": 177.755,
    "end": 181.817,
    "text": "他耽于爱和柔情 任凭痛苦吞噬"
  },
  {
    "start": 181.817,
    "end": 186.896,
    "text": "体验一切爱的痴愚 这火焰无法自行熄灭"
  },
  {
    "start": 187.144,
    "end": 190.051,
    "text": "这天 伤口又灼痛得厉害"
  },
  {
    "start": 190.051,
    "end": 194.169,
    "text": "悉达多被渴望折磨 他毅然渡河登岸"
  },
  {
    "start": 194.169,
    "end": 195.138,
    "text": "进城寻子"
  },
  {
    "start": 195.138,
    "end": 197.962,
    "text": "正值旱季的河水轻柔涌动"
  },
  {
    "start": 197.962,
    "end": 202.583,
    "text": "水声却有些奇特：它在笑 它的确在笑"
  },
  {
    "start": 202.583,
    "end": 205.626,
    "text": "它清脆响亮地嘲笑着老船夫"
  },
  {
    "start": 205.626,
    "end": 209.937,
    "text": "悉达多停下脚步 俯身贴近水面倾听"
  },
  {
    "start": 209.937,
    "end": 213.565,
    "text": "他看见平静的水面上倒映出他的脸"
  },
  {
    "start": 213.565,
    "end": 216.952,
    "text": "这张脸似乎让他记起遗忘的往事"
  },
  {
    "start": 216.952,
    "end": 218.646,
    "text": "他沉思片刻"
  },
  {
    "start": 218.646,
    "end": 221.225,
    "text": "继而发觉这张脸跟一张他"
  },
  {
    "start": 221.225,
    "end": 226.385,
    "text": "熟悉、热爱又敬畏的脸十分相似那是他父亲的脸"
  },
  {
    "start": 226.385,
    "end": 228.114,
    "text": "那个婆罗门的脸"
  },
  {
    "start": 228.362,
    "end": 230.547,
    "text": "他记起年轻时曾如何"
  },
  {
    "start": 230.547,
    "end": 236.376,
    "text": "迫使父亲答应他出门苦修如何同父亲告别 如何离家"
  },
  {
    "start": 236.376,
    "end": 237.939,
    "text": "之后又再未回去"
  },
  {
    "start": 237.939,
    "end": 240.171,
    "text": "难道父亲不是为他受苦"
  },
  {
    "start": 240.171,
    "end": 242.85,
    "text": "如同他现在为儿子受苦"
  },
  {
    "start": 242.85,
    "end": 245.65,
    "text": "难道父亲不是再没见到儿子"
  },
  {
    "start": 245.65,
    "end": 247.517,
    "text": "早已孤零零地死去"
  },
  {
    "start": 247.517,
    "end": 251.484,
    "text": "这难道不是一幕奇异又荒谬的谐剧"
  },
  {
    "start": 251.484,
    "end": 253.618,
    "text": "不是一场宿命的轮回吗"
  },
  {
    "start": 253.866,
    "end": 257.638,
    "text": "河水笑着 是的 正是如此"
  },
  {
    "start": 257.638,
    "end": 259.524,
    "text": "一切未受尽的苦"
  },
  {
    "start": 259.524,
    "end": 264.105,
    "text": "未获得的救赎都会重来 苦难从未改变"
  },
  {
    "start": 264.105,
    "end": 267.506,
    "text": "悉达多重新登船 返回茅舍"
  },
  {
    "start": 267.506,
    "end": 271.431,
    "text": "他想着父亲、儿子 内心挣扎着"
  },
  {
    "start": 271.431,
    "end": 274.309,
    "text": "几近绝望 他被河水嘲笑"
  },
  {
    "start": 274.309,
    "end": 278.175,
    "text": "也想跟随河水大声嘲笑自己和整个世界"
  },
  {
    "start": 278.175,
    "end": 280.449,
    "text": "啊 这伤口尚未风化"
  },
  {
    "start": 280.449,
    "end": 282.723,
    "text": "他的心仍在抗拒命运"
  },
  {
    "start": 282.723,
    "end": 286.31,
    "text": "他的苦难仍未绽放喜悦和胜利的光华"
  },
  {
    "start": 286.31,
    "end": 289.672,
    "text": "可他却感受到希望 回到茅舍后"
  },
  {
    "start": 289.672,
    "end": 292.226,
    "text": "他迫切要向瓦稣迪瓦倾诉"
  },
  {
    "start": 292.226,
    "end": 295.011,
    "text": "向这位倾听大师敞开心扉"
  },
  {
    "start": 295.259,
    "end": 298.713,
    "text": "瓦稣迪瓦正坐在茅舍里编一只篮篓"
  },
  {
    "start": 298.713,
    "end": 302.397,
    "text": "他的视力开始衰退 臂力大不如前"
  },
  {
    "start": 302.397,
    "end": 304.008,
    "text": "已经不再渡船"
  },
  {
    "start": 304.008,
    "end": 307.517,
    "text": "只是他脸上的善意和喜乐未曾改变"
  },
  {
    "start": 307.765,
    "end": 309.749,
    "text": "悉达多坐在老人身边"
  },
  {
    "start": 309.749,
    "end": 312.173,
    "text": "慢慢说起他从未说过的事"
  },
  {
    "start": 312.173,
    "end": 316.139,
    "text": "说他上次进城寻子后内心留下的伤口"
  },
  {
    "start": 316.139,
    "end": 318.674,
    "text": "说他羡慕那些幸福的父亲"
  },
  {
    "start": 318.674,
    "end": 320.749,
    "text": "说他对这愚念的认识"
  },
  {
    "start": 320.749,
    "end": 323.284,
    "text": "说他内心徒劳的挣扎"
  },
  {
    "start": 323.284,
    "end": 325.208,
    "text": "他坦白最狼狈的事"
  },
  {
    "start": 325.208,
    "end": 327.374,
    "text": "无所顾忌地暴露伤口"
  },
  {
    "start": 327.374,
    "end": 330.261,
    "text": "他说他今天如何被灼痛击败"
  },
  {
    "start": 330.261,
    "end": 332.668,
    "text": "孩子气地逃过河"
  },
  {
    "start": 332.668,
    "end": 336.197,
    "text": "非进城不可 河水又如何嘲笑他"
  },
  {
    "start": 336.445,
    "end": 340.327,
    "text": "他说了许久 瓦稣迪瓦安静地倾听"
  },
  {
    "start": 340.327,
    "end": 342.512,
    "text": "悉达多感到瓦稣迪瓦"
  },
  {
    "start": 342.512,
    "end": 345.424,
    "text": "此刻的倾听比以往更加有力"
  },
  {
    "start": 345.424,
    "end": 349.288,
    "text": "他将痛苦、惶恐、隐秘的希望传递给他"
  },
  {
    "start": 349.288,
    "end": 353.608,
    "text": "又被他传递回来 向这位倾听者袒露伤口"
  },
  {
    "start": 353.608,
    "end": 355.314,
    "text": "如同在河中沐浴"
  },
  {
    "start": 355.314,
    "end": 357.751,
    "text": "伤口冷却后与河水合一"
  },
  {
    "start": 357.751,
    "end": 361.407,
    "text": "在不断的述说、坦白和忏悔中"
  },
  {
    "start": 361.407,
    "end": 363.033,
    "text": "悉达多愈加感到"
  },
  {
    "start": 363.033,
    "end": 367.216,
    "text": "倾听者不再是瓦稣迪瓦 不再是一个人"
  },
  {
    "start": 367.216,
    "end": 371.123,
    "text": "这位不动声色的倾听者接纳他的忏悔"
  },
  {
    "start": 371.123,
    "end": 375.031,
    "text": "如同树木接纳雨水 他是神的化身"
  },
  {
    "start": 375.031,
    "end": 376.74,
    "text": "是永恒的化身"
  },
  {
    "start": 376.74,
    "end": 378.835,
    "text": "悉达多不再舔舐伤口"
  },
  {
    "start": 378.835,
    "end": 382.095,
    "text": "对瓦稣迪瓦认知的改变占据了他"
  },
  {
    "start": 382.095,
    "end": 385.354,
    "text": "他认知得愈深 愈不再诧异"
  },
  {
    "start": 385.354,
    "end": 389.371,
    "text": "愈看得清楚 一切都自然 有序"
  },
  {
    "start": 389.371,
    "end": 393.638,
    "text": "瓦稣迪瓦一直如此 只是不为他所知"
  },
  {
    "start": 393.638,
    "end": 394.893,
    "text": "即便是他自己"
  },
  {
    "start": 394.893,
    "end": 396.63,
    "text": "也几乎未曾改变"
  },
  {
    "start": 396.63,
    "end": 399.11,
    "text": "他感到他看待瓦稣迪瓦"
  },
  {
    "start": 399.11,
    "end": 402.831,
    "text": "如同世人看待诸神 这不会长久"
  },
  {
    "start": 402.831,
    "end": 404.567,
    "text": "他一边述说"
  },
  {
    "start": 404.567,
    "end": 407.311,
    "text": "一边在心中与瓦稣迪瓦告别"
  },
  {
    "start": 407.559,
    "end": 408.718,
    "text": "悉达多讲罢"
  },
  {
    "start": 408.718,
    "end": 412.888,
    "text": "瓦稣迪瓦亲切地默默望向他 双目恍惚"
  },
  {
    "start": 412.888,
    "end": 414.822,
    "text": "无声的爱和喜悦、"
  },
  {
    "start": 414.822,
    "end": 421.587,
    "text": "理解和明了闪耀在他周身他拉起悉达多的手 走向岸边 坐下"
  },
  {
    "start": 421.587,
    "end": 424.447,
    "text": "他们一起微笑着望向河水"
  },
  {
    "start": 424.694,
    "end": 427.552,
    "text": "“你听见了河水的笑声 ”"
  },
  {
    "start": 427.552,
    "end": 431.509,
    "text": "瓦稣迪瓦道  但你尚未听见全部声音"
  },
  {
    "start": 431.509,
    "end": 432.609,
    "text": "我们倾听吧"
  },
  {
    "start": 432.609,
    "end": 434.118,
    "text": "你会听到更多"
  },
  {
    "start": 434.366,
    "end": 436.875,
    "text": "他们倾听河水温柔的合唱"
  },
  {
    "start": 436.875,
    "end": 438.7,
    "text": "悉达多凝视水面"
  },
  {
    "start": 438.7,
    "end": 441.689,
    "text": "望见流动的水上浮现出许多画面"
  },
  {
    "start": 441.689,
    "end": 444.679,
    "text": "：他看见孤单的父亲哀念着儿子"
  },
  {
    "start": 444.679,
    "end": 448.678,
    "text": "孤单的自己囚禁在对远方儿子的思念中"
  },
  {
    "start": 448.678,
    "end": 451.504,
    "text": "他看见孤单年少的儿子贪婪"
  },
  {
    "start": 451.504,
    "end": 457.392,
    "text": "地疾进在炽烈的欲望之路上每个人都奔向目标 被折磨"
  },
  {
    "start": 457.392,
    "end": 460.669,
    "text": "受苦难 河水痛苦地歌唱着"
  },
  {
    "start": 460.669,
    "end": 464.703,
    "text": "充满渴望地歌唱着 不断涌向目标"
  },
  {
    "start": 464.703,
    "end": 465.711,
    "text": "如泣如诉"
  },
  {
    "start": 465.959,
    "end": 467.139,
    "text": "你可听见"
  },
  {
    "start": 467.139,
    "end": 471.623,
    "text": "瓦稣迪瓦以目光无言相问 悉达多点头"
  },
  {
    "start": 471.871,
    "end": 474.42,
    "text": "“再听 ”瓦稣迪瓦轻声道"
  },
  {
    "start": 474.668,
    "end": 476.974,
    "text": "悉达多加倍专注于倾听"
  },
  {
    "start": 476.974,
    "end": 479.972,
    "text": "父亲、自己和儿子的形象交汇"
  },
  {
    "start": 479.972,
    "end": 483.432,
    "text": "还有迦摩罗、乔文达、其他人"
  },
  {
    "start": 483.432,
    "end": 486.508,
    "text": "他们的形象交汇并融入河水"
  },
  {
    "start": 486.508,
    "end": 490.865,
    "text": "热切而痛苦地奔向目标 河水咏唱着"
  },
  {
    "start": 490.865,
    "end": 492.146,
    "text": "满载渴望"
  },
  {
    "start": 492.146,
    "end": 495.658,
    "text": "满载燃烧的苦痛和无法满足的欲望"
  },
  {
    "start": 495.658,
    "end": 499.17,
    "text": "奔向目标 悉达多看见由他自己"
  },
  {
    "start": 499.17,
    "end": 501.337,
    "text": "他热爱的、认识的人"
  },
  {
    "start": 501.337,
    "end": 505.671,
    "text": "由所有人组成的河水奔涌着 浪花翻滚"
  },
  {
    "start": 505.671,
    "end": 508.079,
    "text": "痛苦地奔向多个目标"
  },
  {
    "start": 508.079,
    "end": 511.411,
    "text": "奔向瀑布、湖泊、湍流、大海"
  },
  {
    "start": 511.411,
    "end": 516.025,
    "text": "抵达目标 又奔向新的目标 水蒸腾"
  },
  {
    "start": 516.025,
    "end": 517.563,
    "text": "升空 化作雨"
  },
  {
    "start": 517.563,
    "end": 521.749,
    "text": "从天而降 又变成泉水、小溪、河流"
  },
  {
    "start": 521.749,
    "end": 524.211,
    "text": "再次融汇 再次奔涌"
  },
  {
    "start": 524.211,
    "end": 526.672,
    "text": "然而渴求之音有所改变"
  },
  {
    "start": 526.672,
    "end": 530.724,
    "text": "依旧呼啸 依旧满载痛苦和寻觅"
  },
  {
    "start": 530.724,
    "end": 535.586,
    "text": "其他声音 喜与悲、善与恶、笑与哀之声"
  },
  {
    "start": 535.586,
    "end": 538.581,
    "text": "成千上万种声音却加入进来"
  },
  {
    "start": 538.828,
    "end": 542.779,
    "text": "悉达多侧耳倾听 他沉潜于倾听中"
  },
  {
    "start": 542.779,
    "end": 545.248,
    "text": "彻底空无 完全吸纳"
  },
  {
    "start": 545.248,
    "end": 548.458,
    "text": "他感到他已完成了倾听的修行"
  },
  {
    "start": 548.458,
    "end": 551.927,
    "text": "过去 他常听到河水的万千之音"
  },
  {
    "start": 551.927,
    "end": 553.547,
    "text": "今天却耳目一新"
  },
  {
    "start": 553.547,
    "end": 556.362,
    "text": "他不再分辨欢笑与哭泣"
  },
  {
    "start": 556.362,
    "end": 564.526,
    "text": "之声、天真与雄浑之声这些声音是为一体 智者的笑 怒者的喊"
  },
  {
    "start": 564.526,
    "end": 568.275,
    "text": "渴慕者的哀诉 垂死者的呻吟"
  },
  {
    "start": 568.275,
    "end": 570.685,
    "text": "纠缠交织着合为一体"
  },
  {
    "start": 570.685,
    "end": 575.438,
    "text": "所有声音、目标、渴望、痛苦、欲念"
  },
  {
    "start": 575.438,
    "end": 579.894,
    "text": "所有善与恶合为一体 构成世界"
  },
  {
    "start": 579.894,
    "end": 581.974,
    "text": "构成事件之河"
  },
  {
    "start": 581.974,
    "end": 583.248,
    "text": "生命之音乐"
  },
  {
    "start": 583.248,
    "end": 586.306,
    "text": "当他专注于河水咆哮的交响"
  },
  {
    "start": 586.306,
    "end": 589.618,
    "text": "当他不再听到哀 听到笑"
  },
  {
    "start": 589.618,
    "end": 592.821,
    "text": "当他的灵魂不再执念于一种声音"
  },
  {
    "start": 592.821,
    "end": 596.253,
    "text": "自我不再被占据 而是倾听一切"
  },
  {
    "start": 596.253,
    "end": 598.312,
    "text": "倾听整体和统一时"
  },
  {
    "start": 598.312,
    "end": 601.733,
    "text": "这伟大的交响 凝成了一个字"
  },
  {
    "start": 601.733,
    "end": 604.176,
    "text": "这个字是唵 意为圆满"
  },
  {
    "start": 604.424,
    "end": 605.511,
    "text": "你可听见"
  },
  {
    "start": 605.511,
    "end": 608.773,
    "text": "瓦稣迪瓦的目光再次无声相问"
  },
  {
    "start": 609.021,
    "end": 611.687,
    "text": "他的皱纹被灿烂的笑点亮"
  },
  {
    "start": 611.687,
    "end": 614.837,
    "text": "就像唵盘旋在河水的交响之上"
  },
  {
    "start": 614.837,
    "end": 617.26,
    "text": "他的笑容充满光明"
  },
  {
    "start": 617.26,
    "end": 619.433,
    "text": "他亲切地瞥向悉达多"
  },
  {
    "start": 619.433,
    "end": 621.848,
    "text": "悉达多的笑容同样耀眼"
  },
  {
    "start": 621.848,
    "end": 625.469,
    "text": "他的伤口已绽放 痛苦已风化"
  },
  {
    "start": 625.469,
    "end": 627.813,
    "text": "他的自我融入统一之中"
  },
  {
    "start": 628.061,
    "end": 631.45,
    "text": "此刻 悉达多不再与命运搏斗"
  },
  {
    "start": 631.45,
    "end": 635.564,
    "text": "不再与意志作对 他的痛苦已然止息"
  },
  {
    "start": 635.564,
    "end": 637.5,
    "text": "他的脸上盛放喜悦"
  },
  {
    "start": 637.5,
    "end": 641.239,
    "text": "他认知了完满 赞同事件之河"
  },
  {
    "start": 641.239,
    "end": 646.313,
    "text": "赞同生活的奔流 满是同情 满是喜悦"
  },
  {
    "start": 646.313,
    "end": 647.114,
    "text": "顺流而行"
  },
  {
    "start": 647.114,
    "end": 648.558,
    "text": "融入统一"
  },
  {
    "start": 648.806,
    "end": 652.445,
    "text": "瓦稣迪瓦起身 注视悉达多的眼睛"
  },
  {
    "start": 652.445,
    "end": 655.401,
    "text": "看到他眼中闪耀着认知的欢乐"
  },
  {
    "start": 655.401,
    "end": 657.221,
    "text": "他轻抚他的肩膀"
  },
  {
    "start": 657.221,
    "end": 664.51,
    "text": "谨慎而温柔地说道： 我在等候这一时刻亲爱的 现在它终于来临 让我走吧"
  },
  {
    "start": 664.51,
    "end": 668.802,
    "text": "我已等候良久 我已做了太久的船夫"
  },
  {
    "start": 668.802,
    "end": 673.346,
    "text": "现在已结束 祝福你 茅屋 河水"
  },
  {
    "start": 673.346,
    "end": 673.599,
    "text": "祝福你"
  },
  {
    "start": 673.599,
    "end": 674.498,
    "text": "悉达多"
  },
  {
    "start": 674.746,
    "end": 677.485,
    "text": "悉达多向辞行者深深鞠躬"
  },
  {
    "start": 677.733,
    "end": 680.146,
    "text": "“我早已知道 ”他轻声道"
  },
  {
    "start": 680.146,
    "end": 681.632,
    "text": "“你要去林中 ”"
  },
  {
    "start": 681.88,
    "end": 684.772,
    "text": "我要去林中 去融入统一"
  },
  {
    "start": 684.772,
    "end": 686.774,
    "text": "瓦稣迪瓦光芒四射"
  },
  {
    "start": 687.022,
    "end": 696.351,
    "text": "悉达多怀着深深的喜悦与诚挚目送他远去他步伐平和 浑身满是华彩 满是光明"
  }
]