[
  {
    "start": 0.0,
    "end": 3.399,
    "text": "第一部 第一章 婆罗门之子"
  },
  {
    "start": 3.646,
    "end": 6.67,
    "text": "悉达多 俊美的婆罗门之子"
  },
  {
    "start": 6.67,
    "end": 9.693,
    "text": "年轻的鹰隼 在屋舍阴凉处"
  },
  {
    "start": 9.693,
    "end": 11.786,
    "text": "在河岸船旁的阳光中"
  },
  {
    "start": 11.786,
    "end": 15.054,
    "text": "在婆罗双林和无花果树的浓荫下"
  },
  {
    "start": 15.054,
    "end": 16.221,
    "text": "与他的好友"
  },
  {
    "start": 16.221,
    "end": 20.19,
    "text": "同为婆罗门之子的乔文达一道长大"
  },
  {
    "start": 20.19,
    "end": 23.752,
    "text": "他浅亮的臂膀 在河边沐浴时"
  },
  {
    "start": 23.752,
    "end": 28.077,
    "text": "在神圣的洗礼和祭祀中 被阳光晒黑"
  },
  {
    "start": 28.077,
    "end": 29.604,
    "text": "芒果林的树影"
  },
  {
    "start": 29.604,
    "end": 33.131,
    "text": "在孩童嬉戏间 在母亲的歌声里"
  },
  {
    "start": 33.131,
    "end": 35.247,
    "text": "在智慧父亲的教诲中"
  },
  {
    "start": 35.247,
    "end": 37.598,
    "text": "在至高无上的牲礼上"
  },
  {
    "start": 37.598,
    "end": 39.377,
    "text": "潜入他的黑眸"
  },
  {
    "start": 39.625,
    "end": 42.299,
    "text": "悉达多早已加入智者的交谈"
  },
  {
    "start": 42.299,
    "end": 44.751,
    "text": "他和乔文达一道修习辩论"
  },
  {
    "start": 44.751,
    "end": 48.094,
    "text": "修习参禅的艺术及冥想的功夫"
  },
  {
    "start": 48.094,
    "end": 50.368,
    "text": "他已学会无声地念诵“om”"
  },
  {
    "start": 50.616,
    "end": 52.187,
    "text": "这一辞中之辞"
  },
  {
    "start": 52.187,
    "end": 56.638,
    "text": "无声地、聚精会神地在呼吸间吐纳这辞"
  },
  {
    "start": 56.638,
    "end": 57.685,
    "text": "这时"
  },
  {
    "start": 57.685,
    "end": 60.811,
    "text": "清明的心灵之光闪耀在他的前额"
  },
  {
    "start": 60.811,
    "end": 63.936,
    "text": "他已学会体认内在不朽的阿特曼"
  },
  {
    "start": 63.936,
    "end": 65.499,
    "text": "同宇宙合一"
  },
  {
    "start": 65.747,
    "end": 68.164,
    "text": "欢喜涌上他父亲的心头"
  },
  {
    "start": 68.164,
    "end": 71.064,
    "text": "这个善悟而渴慕知识的儿子"
  },
  {
    "start": 71.064,
    "end": 74.206,
    "text": "将成长为伟大的贤士和僧侣"
  },
  {
    "start": 74.206,
    "end": 76.515,
    "text": "成长为婆罗门中的王"
  },
  {
    "start": 76.763,
    "end": 79.422,
    "text": "母亲看见儿子落座、起身"
  },
  {
    "start": 79.67,
    "end": 80.799,
    "text": "看见悉达多"
  },
  {
    "start": 80.799,
    "end": 83.735,
    "text": "她强壮英俊、四肢修长的儿子"
  },
  {
    "start": 83.735,
    "end": 86.444,
    "text": "以完美的礼仪向她问安"
  },
  {
    "start": 86.444,
    "end": 88.613,
    "text": "幸福便在胸中跃动"
  },
  {
    "start": 88.861,
    "end": 91.803,
    "text": "年轻的婆罗门女儿们看见悉"
  },
  {
    "start": 91.803,
    "end": 97.44,
    "text": "达多以王者之姿走过城中街巷额头清朗 背影颀长"
  },
  {
    "start": 97.44,
    "end": 100.319,
    "text": "心中不免泛起爱情的涟漪"
  },
  {
    "start": 100.567,
    "end": 103.048,
    "text": "而最爱他的人是乔文达"
  },
  {
    "start": 103.048,
    "end": 106.522,
    "text": "他爱悉达多的目光和仁慈的嗓音"
  },
  {
    "start": 106.522,
    "end": 108.506,
    "text": "他爱他的步态"
  },
  {
    "start": 108.506,
    "end": 110.475,
    "text": "他行动时的优雅完美"
  },
  {
    "start": 110.475,
    "end": 114.63,
    "text": "他爱悉达多的一切言行 但更爱他的精神"
  },
  {
    "start": 114.63,
    "end": 116.565,
    "text": "他崇高激昂的思想、"
  },
  {
    "start": 116.565,
    "end": 119.145,
    "text": "强大的意志和高贵的使命感"
  },
  {
    "start": 119.145,
    "end": 121.102,
    "text": "乔文达知道：悉达多"
  },
  {
    "start": 121.102,
    "end": 126.324,
    "text": "不会成为卑劣的婆罗门腐败的祭司 贪婪施咒的商贩"
  },
  {
    "start": 126.324,
    "end": 128.195,
    "text": "虚荣空洞的辩术士"
  },
  {
    "start": 128.195,
    "end": 131.237,
    "text": "他也不会成为邪恶奸诈的僧侣"
  },
  {
    "start": 131.237,
    "end": 134.513,
    "text": "信众中善良愚蠢的羔羊 不"
  },
  {
    "start": 134.513,
    "end": 138.03,
    "text": "即便是他乔文达也不愿成为那样的人"
  },
  {
    "start": 138.03,
    "end": 141.548,
    "text": "他不想做千万庸碌的婆罗门中的一员"
  },
  {
    "start": 141.548,
    "end": 143.087,
    "text": "他要追随他"
  },
  {
    "start": 143.087,
    "end": 147.051,
    "text": "为人拥戴而神圣的悉达多 他要追随他"
  },
  {
    "start": 147.051,
    "end": 150.796,
    "text": "当悉达多成了神 抵达无量光明的世界"
  },
  {
    "start": 150.796,
    "end": 153.725,
    "text": "他仍要做他的朋友 他的随从"
  },
  {
    "start": 153.725,
    "end": 156.655,
    "text": "他的仆人 他的侍卫 他的影子"
  },
  {
    "start": 156.903,
    "end": 158.911,
    "text": "所有人都热爱悉达多"
  },
  {
    "start": 158.911,
    "end": 160.919,
    "text": "悉达多令所有人喜悦"
  },
  {
    "start": 160.919,
    "end": 163.597,
    "text": "所有人都对他兴致勃勃"
  },
  {
    "start": 163.845,
    "end": 167.642,
    "text": "可是他 悉达多 却无法让自己喜悦"
  },
  {
    "start": 167.642,
    "end": 169.329,
    "text": "无法让自己略有兴致"
  },
  {
    "start": 169.329,
    "end": 173.103,
    "text": "他在无花果园的玫瑰小径上漫步"
  },
  {
    "start": 173.103,
    "end": 175.529,
    "text": "在幽蓝的树影下静思"
  },
  {
    "start": 175.529,
    "end": 179.033,
    "text": "在救赎池中每日洁净身体"
  },
  {
    "start": 179.033,
    "end": 181.751,
    "text": "在芒果林浓荫匝地处献祭"
  },
  {
    "start": 181.751,
    "end": 184.716,
    "text": "他优雅完美的举止讨人欢心"
  },
  {
    "start": 184.716,
    "end": 186.692,
    "text": "令人赏心悦目"
  },
  {
    "start": 186.692,
    "end": 190.802,
    "text": "可他心中却并无喜悦 梦境侵袭他"
  },
  {
    "start": 190.802,
    "end": 195.426,
    "text": "无尽的思绪从河流中涌出 在繁星中闪耀"
  },
  {
    "start": 195.426,
    "end": 197.511,
    "text": "自太阳的光辉中洒落"
  },
  {
    "start": 197.511,
    "end": 199.364,
    "text": "当祭祀的烟火升腾"
  },
  {
    "start": 199.364,
    "end": 202.375,
    "text": "《梨俱吠陀》的诗句弥漫"
  },
  {
    "start": 202.375,
    "end": 205.887,
    "text": "当年长的婆罗门和智者的教诲不绝于耳"
  },
  {
    "start": 205.887,
    "end": 208.159,
    "text": "悉达多的灵魂悸动不安"
  },
  {
    "start": 208.407,
    "end": 211.636,
    "text": "悉达多心中的怅然一日胜过一日"
  },
  {
    "start": 211.636,
    "end": 215.326,
    "text": "他开始感到 父亲的爱 母亲的爱"
  },
  {
    "start": 215.326,
    "end": 217.234,
    "text": "他的朋友乔文达的爱"
  },
  {
    "start": 217.234,
    "end": 220.626,
    "text": "都不会一直带给他幸福、安宁和满足"
  },
  {
    "start": 220.626,
    "end": 222.11,
    "text": "他开始感到"
  },
  {
    "start": 222.11,
    "end": 224.768,
    "text": "他可敬的父亲和其他智慧的"
  },
  {
    "start": 224.768,
    "end": 230.304,
    "text": "婆罗门已将他们大部分思想传授给他而他依旧灵魂不安"
  },
  {
    "start": 230.304,
    "end": 231.373,
    "text": "心灵不宁"
  },
  {
    "start": 231.373,
    "end": 235.113,
    "text": "他充满渴望的精神容器仍未盛满"
  },
  {
    "start": 235.113,
    "end": 240.188,
    "text": "洗礼虽善 但那只是水 不能洗涤罪孽"
  },
  {
    "start": 240.188,
    "end": 244.079,
    "text": "满足焦渴的灵魂 抚慰畏惧的心灵"
  },
  {
    "start": 244.079,
    "end": 246.511,
    "text": "向诸神献祭和祈祷固然"
  },
  {
    "start": 246.511,
    "end": 248.943,
    "text": "好——但这即是一切吗"
  },
  {
    "start": 248.943,
    "end": 252.705,
    "text": "献祭能带来幸福吗 诸神又当如何"
  },
  {
    "start": 252.705,
    "end": 256.467,
    "text": "创世的 果真是生主 而不是阿特曼"
  },
  {
    "start": 256.467,
    "end": 259.032,
    "text": "那唯一的、孤独的阿特曼"
  },
  {
    "start": 259.032,
    "end": 262.995,
    "text": "诸神不是形同你我 他们被创造出来"
  },
  {
    "start": 262.995,
    "end": 264.861,
    "text": "同样受限于光阴"
  },
  {
    "start": 264.861,
    "end": 268.142,
    "text": "同样命运无常 终有一死"
  },
  {
    "start": 268.142,
    "end": 270.055,
    "text": "那么向诸神献祭"
  },
  {
    "start": 270.055,
    "end": 274.43,
    "text": "是善和对的、明智和高尚的作为吗"
  },
  {
    "start": 274.43,
    "end": 277.844,
    "text": "除了阿特曼 还有谁值得去献祭"
  },
  {
    "start": 277.844,
    "end": 281.714,
    "text": "去尊崇 可阿特曼在哪里 去哪里找它"
  },
  {
    "start": 281.714,
    "end": 283.343,
    "text": "何处是它的居所"
  },
  {
    "start": 283.343,
    "end": 285.904,
    "text": "它永恒的心房在何处跳动"
  },
  {
    "start": 285.904,
    "end": 289.163,
    "text": "难道不是在内在的“我”中"
  },
  {
    "start": 289.163,
    "end": 292.836,
    "text": "在每个人坚不可摧的内心深处跳动吗"
  },
  {
    "start": 292.836,
    "end": 295.362,
    "text": "然而这“我” 这深处"
  },
  {
    "start": 295.362,
    "end": 297.887,
    "text": "这最终的阿特曼在哪里"
  },
  {
    "start": 297.887,
    "end": 301.723,
    "text": "它不是筋骨和肉体 不是思想和知觉"
  },
  {
    "start": 301.723,
    "end": 304.881,
    "text": "如智者们教诲的那样 它在哪里"
  },
  {
    "start": 304.881,
    "end": 309.032,
    "text": "哪里另有一条迫近“我” 迫近内在"
  },
  {
    "start": 309.032,
    "end": 313.426,
    "text": "迫近阿特曼的路 一条更值得寻找的路"
  },
  {
    "start": 313.426,
    "end": 313.67,
    "text": "啊"
  },
  {
    "start": 313.67,
    "end": 317.25,
    "text": "没人能指明这条路 没人认得它"
  },
  {
    "start": 317.25,
    "end": 319.874,
    "text": "不论父亲、老师还是智者"
  },
  {
    "start": 319.874,
    "end": 323.283,
    "text": "即便在颂神祭歌中也无从寻得"
  },
  {
    "start": 323.283,
    "end": 327.077,
    "text": "哪怕婆罗门及其神圣之书包罗万象："
  },
  {
    "start": 327.077,
    "end": 329.211,
    "text": "创世、语言的起源、"
  },
  {
    "start": 329.211,
    "end": 331.583,
    "text": "饮食、呼吸、感官秩序"
  },
  {
    "start": 331.583,
    "end": 335.232,
    "text": "诸神的作为——它确实极为渊博——但"
  },
  {
    "start": 335.232,
    "end": 338.882,
    "text": "它如果不知晓那最重要的、唯一的东西"
  },
  {
    "start": 338.882,
    "end": 342.046,
    "text": "了解上述这一切又有何意义"
  },
  {
    "start": 342.294,
    "end": 345.658,
    "text": "的确 神圣之书中许多精彩的篇章"
  },
  {
    "start": 345.658,
    "end": 349.023,
    "text": "特别是《娑摩吠陀》奥义书中的诗句"
  },
  {
    "start": 349.023,
    "end": 351.924,
    "text": "曾论及这种最深处的终极之物"
  },
  {
    "start": 351.924,
    "end": 355.273,
    "text": "它写道：“彼之灵魂即整个宇宙”"
  },
  {
    "start": 355.273,
    "end": 356.612,
    "text": "它还写道"
  },
  {
    "start": 356.612,
    "end": 359.374,
    "text": "人在酣眠时便进入内心深处"
  },
  {
    "start": 359.374,
    "end": 363.286,
    "text": "住在阿特曼中 这些富有魔力的诗句"
  },
  {
    "start": 363.286,
    "end": 365.65,
    "text": "集世代圣贤思想之大成"
  },
  {
    "start": 365.65,
    "end": 367.304,
    "text": "蕴含惊人的智慧"
  },
  {
    "start": 367.304,
    "end": 370.85,
    "text": "如蜜蜂采集的蜂蜜般纯粹 不"
  },
  {
    "start": 370.85,
    "end": 373.831,
    "text": "这些由无数智慧的婆罗门传承"
  },
  {
    "start": 373.831,
    "end": 379.104,
    "text": "者搜集保存下来的智识不容忽视然而那些不仅领悟"
  },
  {
    "start": 379.104,
    "end": 382.017,
    "text": "还践行这深奥知识的婆罗门"
  },
  {
    "start": 382.017,
    "end": 384.931,
    "text": "僧侣、圣贤和忏悔者在哪里"
  },
  {
    "start": 384.931,
    "end": 386.873,
    "text": "那些熟谙之人"
  },
  {
    "start": 386.873,
    "end": 390.462,
    "text": "那些不仅在酣眠中 也在清醒时"
  },
  {
    "start": 390.462,
    "end": 392.137,
    "text": "在实在的现实里"
  },
  {
    "start": 392.137,
    "end": 399.436,
    "text": "在言语和行动中住在阿特曼中的人在哪里悉达多认识许多可敬的婆罗门"
  },
  {
    "start": 399.436,
    "end": 403.316,
    "text": "首先是他的父亲 他纯粹、博学"
  },
  {
    "start": 403.316,
    "end": 404.35,
    "text": "德高望重"
  },
  {
    "start": 404.35,
    "end": 409.005,
    "text": "他举止沉静高雅、生活质朴、言语练达"
  },
  {
    "start": 409.005,
    "end": 411.411,
    "text": "头脑中充满高贵的思想"
  },
  {
    "start": 411.411,
    "end": 417.665,
    "text": "——但如此渊博的父亲就能拥有内心永恒的幸福和平静吗"
  },
  {
    "start": 417.665,
    "end": 421.002,
    "text": "他不也同样是位渴望者、探索者"
  },
  {
    "start": 421.002,
    "end": 425.055,
    "text": "他同样要不断去圣泉边痛饮 去献祭"
  },
  {
    "start": 425.055,
    "end": 426.009,
    "text": "去阅读"
  },
  {
    "start": 426.009,
    "end": 428.273,
    "text": "去同其他婆罗门探讨"
  },
  {
    "start": 428.273,
    "end": 432.551,
    "text": "为何这位无可指摘的人要每日洗涤罪孽"
  },
  {
    "start": 432.551,
    "end": 435.823,
    "text": "每日忙于清洁 每日更新"
  },
  {
    "start": 435.823,
    "end": 438.107,
    "text": "难道阿特曼没在他心中"
  },
  {
    "start": 438.107,
    "end": 441.991,
    "text": "成为他的心之源泉吗 人必须找到它"
  },
  {
    "start": 441.991,
    "end": 444.047,
    "text": "内在“我”之源泉"
  },
  {
    "start": 444.047,
    "end": 446.324,
    "text": "必须拥有自己的阿特曼"
  },
  {
    "start": 446.324,
    "end": 450.651,
    "text": "其他一切都只是寻觅、走弯路和误入歧途"
  },
  {
    "start": 450.899,
    "end": 454.521,
    "text": "这就是悉达多的想法 也是他的渴望"
  },
  {
    "start": 454.521,
    "end": 455.373,
    "text": "他的痛苦"
  },
  {
    "start": 455.621,
    "end": 456.063,
    "text": "时常"
  },
  {
    "start": 456.063,
    "end": 460.26,
    "text": "他默诵《歌者奥义书》中的句子： 诚然"
  },
  {
    "start": 460.26,
    "end": 462.93,
    "text": "梵即真理——顿悟真理"
  },
  {
    "start": 462.93,
    "end": 469.339,
    "text": "之人日日前往天国世界 时常 他感到天国近在咫尺"
  },
  {
    "start": 469.339,
    "end": 471.154,
    "text": "又无法完全够及"
  },
  {
    "start": 471.154,
    "end": 473.748,
    "text": "他终极的焦渴从未平复"
  },
  {
    "start": 473.748,
    "end": 477.898,
    "text": "在所有教诲过他的圣贤和智者中"
  },
  {
    "start": 477.898,
    "end": 480.697,
    "text": "也没有一人完全抵达过天国"
  },
  {
    "start": 480.697,
    "end": 483.262,
    "text": "完全消除过永恒的焦渴"
  },
  {
    "start": 483.988,
    "end": 487.178,
    "text": "悉达多对他的朋友道  乔文达"
  },
  {
    "start": 487.178,
    "end": 490.155,
    "text": "亲爱的 跟我一起去榕树下吧"
  },
  {
    "start": 490.155,
    "end": 492.282,
    "text": "我们该潜心冥想了"
  },
  {
    "start": 492.53,
    "end": 496.308,
    "text": "他们走到榕树下打坐 这边是悉达多"
  },
  {
    "start": 496.308,
    "end": 498.309,
    "text": "二十步之外是乔文达"
  },
  {
    "start": 498.309,
    "end": 501.192,
    "text": "悉达多做好念诵“唵”的准备后"
  },
  {
    "start": 501.192,
    "end": 502.633,
    "text": "便喃喃反复道"
  },
  {
    "start": 502.881,
    "end": 504.84,
    "text": "唵为弓 灵为箭"
  },
  {
    "start": 505.088,
    "end": 506.737,
    "text": "梵乃箭之靶"
  },
  {
    "start": 506.985,
    "end": 508.654,
    "text": "当不懈地射中它"
  },
  {
    "start": 508.902,
    "end": 512.793,
    "text": "惯常打坐时间结束后 乔文达起身"
  },
  {
    "start": 512.793,
    "end": 516.441,
    "text": "夜幕降临 晚间沐浴的时辰到了"
  },
  {
    "start": 516.441,
    "end": 518.386,
    "text": "乔文达呼唤悉达多"
  },
  {
    "start": 518.386,
    "end": 522.666,
    "text": "悉达多并未应答 他仍沉浸在冥想中"
  },
  {
    "start": 522.666,
    "end": 526.945,
    "text": "眼睛凝视着遥远的目标 舌尖轻抵齿间"
  },
  {
    "start": 526.945,
    "end": 531.819,
    "text": "似乎静止了呼吸 他坐着 潜神冥思着"
  },
  {
    "start": 531.819,
    "end": 533.614,
    "text": "灵魂之剑直指大梵"
  },
  {
    "start": 533.862,
    "end": 538.015,
    "text": "那时 三位沙门经过悉达多所在的城邑"
  },
  {
    "start": 538.015,
    "end": 541.936,
    "text": "他们是去朝圣的苦行者 不老也不年轻"
  },
  {
    "start": 541.936,
    "end": 543.315,
    "text": "憔悴、消瘦"
  },
  {
    "start": 543.315,
    "end": 547.452,
    "text": "几乎全裸的身躯被阳光暴晒得焦黑"
  },
  {
    "start": 547.452,
    "end": 550.485,
    "text": "尘埃和血迹布满肩头"
  },
  {
    "start": 550.485,
    "end": 553.299,
    "text": "他们是人类王国的异乡人"
  },
  {
    "start": 553.299,
    "end": 556.88,
    "text": "骨瘦如柴的胡狼 孤独、绝尘"
  },
  {
    "start": 556.88,
    "end": 558.414,
    "text": "与世界为敌"
  },
  {
    "start": 558.414,
    "end": 562.642,
    "text": "一种由无声的激情、不惜一切去献身、"
  },
  {
    "start": 562.642,
    "end": 565.128,
    "text": "无情的肉体灭绝构成的"
  },
  {
    "start": 565.128,
    "end": 567.863,
    "text": "灼热气息回旋在他们周身"
  },
  {
    "start": 568.111,
    "end": 570.134,
    "text": "晚上 冥想时间后"
  },
  {
    "start": 570.134,
    "end": 573.281,
    "text": "悉达多对乔文达道： 明日一早"
  },
  {
    "start": 573.281,
    "end": 574.405,
    "text": "我的朋友"
  },
  {
    "start": 574.405,
    "end": 576.452,
    "text": "悉达多将加入沙门的行列"
  },
  {
    "start": 576.452,
    "end": 578.5,
    "text": "他将成为一名沙门"
  },
  {
    "start": 578.747,
    "end": 581.007,
    "text": "乔文达听后脸色顿白"
  },
  {
    "start": 581.007,
    "end": 585.024,
    "text": "他从朋友不动声色的容颜上读出决绝"
  },
  {
    "start": 585.024,
    "end": 588.037,
    "text": "他的决心已似开弓之箭"
  },
  {
    "start": 588.037,
    "end": 590.421,
    "text": "乔文达意识到：时候到了"
  },
  {
    "start": 590.421,
    "end": 592.588,
    "text": "悉达多要去走自己的路"
  },
  {
    "start": 592.588,
    "end": 596.056,
    "text": "他的命运即将萌发 不仅是他的"
  },
  {
    "start": 596.056,
    "end": 599.372,
    "text": "也是他乔文达的命运 此时"
  },
  {
    "start": 599.372,
    "end": 603.71,
    "text": "他的脸色如同干枯的芭蕉壳 越发苍白"
  },
  {
    "start": 603.958,
    "end": 606.605,
    "text": "“哦 悉达多 ”他喊道"
  },
  {
    "start": 606.605,
    "end": 608.846,
    "text": "“你父亲会允许吗 ”"
  },
  {
    "start": 608.846,
    "end": 610.272,
    "text": "悉达多望向乔文达"
  },
  {
    "start": 610.272,
    "end": 613.537,
    "text": "觉醒的眼光迅捷如箭般看穿乔"
  },
  {
    "start": 613.537,
    "end": 617.306,
    "text": "文达的心思、他的恐惧和他的默许"
  },
  {
    "start": 617.554,
    "end": 620.662,
    "text": "“哦 乔文达 ”他轻声道"
  },
  {
    "start": 620.662,
    "end": 623.992,
    "text": "我们不必浪费口舌 明日破晓"
  },
  {
    "start": 623.992,
    "end": 625.768,
    "text": "我即开始沙门的生活"
  },
  {
    "start": 625.768,
    "end": 627.202,
    "text": "无需再谈论了"
  },
  {
    "start": 627.45,
    "end": 629.298,
    "text": "悉达多走进屋舍时"
  },
  {
    "start": 629.298,
    "end": 632.302,
    "text": "父亲正坐在树皮编织的席子上"
  },
  {
    "start": 632.302,
    "end": 634.844,
    "text": "悉达多站在父亲身后"
  },
  {
    "start": 634.844,
    "end": 638.618,
    "text": "直至父亲有所察觉  是你吗 悉达多"
  },
  {
    "start": 638.618,
    "end": 641.002,
    "text": "”这位婆罗门道 “说吧"
  },
  {
    "start": 641.002,
    "end": 642.393,
    "text": "你为何事而来"
  },
  {
    "start": 642.641,
    "end": 646.763,
    "text": "“您允许的话 我的父亲 ”悉达多道"
  },
  {
    "start": 646.763,
    "end": 648.932,
    "text": "我来 是为跟您说"
  },
  {
    "start": 648.932,
    "end": 650.885,
    "text": "我恳请明天离开您的家"
  },
  {
    "start": 650.885,
    "end": 652.502,
    "text": "加入苦行者的行列"
  },
  {
    "start": 652.502,
    "end": 654.321,
    "text": "我渴望成为一名沙门"
  },
  {
    "start": 654.321,
    "end": 656.544,
    "text": "希望您不会阻挠"
  },
  {
    "start": 656.792,
    "end": 661.029,
    "text": "婆罗门沉默良久 星星攀上窗际时"
  },
  {
    "start": 661.029,
    "end": 662.883,
    "text": "屋内仍寂静无声"
  },
  {
    "start": 662.883,
    "end": 666.591,
    "text": "儿子交叉双臂纹丝不动地站着"
  },
  {
    "start": 666.591,
    "end": 669.716,
    "text": "一言不发 父亲也纹丝不动"
  },
  {
    "start": 669.716,
    "end": 672.12,
    "text": "一言不发地坐在席子上"
  },
  {
    "start": 672.12,
    "end": 675.245,
    "text": "唯有星斗在空中挪移 这时"
  },
  {
    "start": 675.245,
    "end": 677.257,
    "text": "父亲道： 婆罗门是"
  },
  {
    "start": 677.257,
    "end": 683.069,
    "text": "不该有激烈和恼怒的言辞的但我心中确有不快 从你口中"
  },
  {
    "start": 683.069,
    "end": 684.998,
    "text": "我不想再听到这一请求"
  },
  {
    "start": 685.246,
    "end": 687.897,
    "text": "婆罗门说毕 缓慢起身"
  },
  {
    "start": 687.897,
    "end": 691.27,
    "text": "悉达多依旧交叉双臂 纹丝未动"
  },
  {
    "start": 691.518,
    "end": 693.677,
    "text": "“你还在等什么 ”父亲问"
  },
  {
    "start": 693.925,
    "end": 696.099,
    "text": "“这您知道 ”悉达多答"
  },
  {
    "start": 696.347,
    "end": 698.352,
    "text": "父亲气愤地走出房间"
  },
  {
    "start": 698.352,
    "end": 701.471,
    "text": "气愤地走去他的床铺躺下身来"
  },
  {
    "start": 701.719,
    "end": 704.808,
    "text": "一小时后 无眠的婆罗门起身"
  },
  {
    "start": 704.808,
    "end": 709.0,
    "text": "他来回踱步 继而走出房间 透过窗子"
  },
  {
    "start": 709.0,
    "end": 710.323,
    "text": "他看见双臂交叉"
  },
  {
    "start": 710.323,
    "end": 713.761,
    "text": "纹丝未动 依旧伫立着的悉达多"
  },
  {
    "start": 713.761,
    "end": 717.886,
    "text": "他浅色的衣衫发着微光 父亲心生不安"
  },
  {
    "start": 717.886,
    "end": 719.032,
    "text": "又踱回房间"
  },
  {
    "start": 719.28,
    "end": 723.421,
    "text": "又一小时后 无眠的婆罗门再次起身"
  },
  {
    "start": 723.421,
    "end": 726.588,
    "text": "他来回踱步 继而走出房间"
  },
  {
    "start": 726.588,
    "end": 728.049,
    "text": "月亮当空高悬"
  },
  {
    "start": 728.049,
    "end": 732.037,
    "text": "透过窗子 他看见依旧伫立的悉达多"
  },
  {
    "start": 732.037,
    "end": 734.383,
    "text": "双臂交叉 纹丝未动"
  },
  {
    "start": 734.383,
    "end": 736.728,
    "text": "月华照亮他裸露的脚踝"
  },
  {
    "start": 736.728,
    "end": 739.753,
    "text": "父亲心生忧虑 又踱回房间"
  },
  {
    "start": 740.0,
    "end": 744.187,
    "text": "一小时后 两小时后 他不断起身"
  },
  {
    "start": 744.187,
    "end": 748.373,
    "text": "透过窗子 他瞭望月光中 星光中"
  },
  {
    "start": 748.373,
    "end": 749.605,
    "text": "黑暗中的悉达多"
  },
  {
    "start": 749.605,
    "end": 751.848,
    "text": "他默默地一次次起身"
  },
  {
    "start": 751.848,
    "end": 755.337,
    "text": "望向窗外纹丝不动伫立着的儿子"
  },
  {
    "start": 755.337,
    "end": 758.079,
    "text": "心中充满恼怒和不安"
  },
  {
    "start": 758.079,
    "end": 759.873,
    "text": "恐惧和痛苦"
  },
  {
    "start": 760.121,
    "end": 763.738,
    "text": "破晓前的最后一小时 他走出房间"
  },
  {
    "start": 763.738,
    "end": 767.13,
    "text": "看见伫立于眼前的少年高大而陌生"
  },
  {
    "start": 767.378,
    "end": 770.422,
    "text": "“悉达多 ”他道 “你还在等什么 ”"
  },
  {
    "start": 770.67,
    "end": 771.764,
    "text": "“您知道 ”"
  },
  {
    "start": 772.012,
    "end": 775.503,
    "text": "你打算一直这样站着等待 直至天明"
  },
  {
    "start": 775.503,
    "end": 777.831,
    "text": "直至正午 直至夜晚吗"
  },
  {
    "start": 778.079,
    "end": 779.498,
    "text": "“我会站着等待 ”"
  },
  {
    "start": 779.746,
    "end": 781.93,
    "text": "“你会疲惫的 悉达多 ”"
  },
  {
    "start": 782.178,
    "end": 783.567,
    "text": "“我会疲惫 ”"
  },
  {
    "start": 783.815,
    "end": 785.989,
    "text": "“你会睡着的 悉达多 ”"
  },
  {
    "start": 786.237,
    "end": 787.466,
    "text": "“我不会睡着 ”"
  },
  {
    "start": 787.714,
    "end": 789.668,
    "text": "“你会死去的 悉达多 ”"
  },
  {
    "start": 789.916,
    "end": 791.2,
    "text": "“我会死去 ”"
  },
  {
    "start": 791.448,
    "end": 792.572,
    "text": "你宁愿死去"
  },
  {
    "start": 792.572,
    "end": 795.007,
    "text": "也不愿服从你的父亲吗"
  },
  {
    "start": 795.255,
    "end": 797.759,
    "text": "“悉达多一向服从他的父亲 ”"
  },
  {
    "start": 798.007,
    "end": 800.181,
    "text": "“那你会放弃你的打算吗 ”"
  },
  {
    "start": 800.429,
    "end": 803.133,
    "text": "“悉达多会做他父亲要求的事情 ”"
  },
  {
    "start": 803.381,
    "end": 805.485,
    "text": "第一缕晨光照进屋舍"
  },
  {
    "start": 805.485,
    "end": 808.992,
    "text": "婆罗门看见悉达多的双膝轻微颤栗"
  },
  {
    "start": 808.992,
    "end": 811.33,
    "text": "但他的脸没有颤栗"
  },
  {
    "start": 811.33,
    "end": 815.1,
    "text": "他的目光专注于远方 父亲意识到"
  },
  {
    "start": 815.1,
    "end": 819.107,
    "text": "悉达多已不在他身边 他已离开家乡"
  },
  {
    "start": 819.107,
    "end": 819.814,
    "text": "离开他"
  },
  {
    "start": 820.062,
    "end": 822.516,
    "text": "父亲抚摩悉达多的肩膀"
  },
  {
    "start": 822.764,
    "end": 825.824,
    "text": "你即将步入林中成为一名沙门"
  },
  {
    "start": 825.824,
    "end": 828.228,
    "text": "”他道 “如果在林中"
  },
  {
    "start": 828.228,
    "end": 830.633,
    "text": "你寻得至高无上的幸福"
  },
  {
    "start": 830.633,
    "end": 834.752,
    "text": "就回来教我修习 如果你只收获幻灭"
  },
  {
    "start": 834.752,
    "end": 838.872,
    "text": "那也回来 我们再一道祭奉诸神 现在"
  },
  {
    "start": 838.872,
    "end": 842.481,
    "text": "去和你的母亲吻别 告诉她你的去向"
  },
  {
    "start": 842.481,
    "end": 845.453,
    "text": "至于我 清晨沐浴的时辰已到"
  },
  {
    "start": 845.453,
    "end": 847.151,
    "text": "我要去河边了"
  },
  {
    "start": 847.399,
    "end": 851.409,
    "text": "他把手从儿子肩头抽回 走出门去"
  },
  {
    "start": 851.409,
    "end": 855.169,
    "text": "悉达多试图移步时身体打了个踉跄"
  },
  {
    "start": 855.169,
    "end": 856.673,
    "text": "他控制身体"
  },
  {
    "start": 856.673,
    "end": 859.33,
    "text": "向父亲鞠躬后 走向母亲"
  },
  {
    "start": 859.33,
    "end": 861.102,
    "text": "去做父亲吩咐的事"
  },
  {
    "start": 861.35,
    "end": 862.302,
    "text": "破晓时分"
  },
  {
    "start": 862.302,
    "end": 864.445,
    "text": "当悉达多拖着僵硬的"
  },
  {
    "start": 864.445,
    "end": 870.634,
    "text": "双腿离开尚在沉睡的城邑一个蹲伏的身影从房舍间跃出"
  },
  {
    "start": 870.634,
    "end": 874.413,
    "text": "他也要加入朝圣者的行列——他是乔文达"
  },
  {
    "start": 874.661,
    "end": 877.13,
    "text": "“你来了 ”悉达多含笑道"
  },
  {
    "start": 877.378,
    "end": 879.367,
    "text": "“我来了 ”乔文达道"
  }
