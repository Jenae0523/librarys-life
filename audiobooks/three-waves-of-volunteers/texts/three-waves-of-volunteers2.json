[
  {
    "start": 0.0,
    "end": 2.102,
    "text": "第一部 志愿者"
  },
  {
    "start": 2.808,
    "end": 6.299,
    "text": "第一章 发现三波段的过程"
  },
  {
    "start": 7.711,
    "end": 11.173,
    "text": "我在催眠领域的研究带领我踏上了"
  },
  {
    "start": 11.173,
    "end": 13.251,
    "text": "难以想象的旅程 我"
  },
  {
    "start": 13.251,
    "end": 15.559,
    "text": "不仅穿越时空探索历史"
  },
  {
    "start": 15.559,
    "end": 18.832,
    "text": "也窥视了未来的可能性 刚"
  },
  {
    "start": 18.832,
    "end": 22.378,
    "text": "开始透过前世疗法进行探究时"
  },
  {
    "start": 22.378,
    "end": 26.572,
    "text": "我没想过自己会发现人们在地球以外的"
  },
  {
    "start": 26.572,
    "end": 30.767,
    "text": "生活记忆 毕竟地球是我们所知的一切"
  },
  {
    "start": 30.767,
    "end": 33.385,
    "text": "我的信念体系在过去40"
  },
  {
    "start": 33.385,
    "end": 37.908,
    "text": "年间不断的延伸、扩大 随着工作的进展"
  },
  {
    "start": 37.908,
    "end": 42.126,
    "text": "我得到有关地球生命初始的大量讯息"
  },
  {
    "start": 42.126,
    "end": 46.344,
    "text": "我被告知现在是出现这些知识的时候了"
  },
  {
    "start": 46.344,
    "end": 50.432,
    "text": "我们正进入一个新的世界 一个新的次元"
  },
  {
    "start": 50.432,
    "end": 52.476,
    "text": "在那里 这些资料"
  },
  {
    "start": 52.476,
    "end": 54.746,
    "text": "的价值将被领会和运用"
  },
  {
    "start": 55.452,
    "end": 58.086,
    "text": "我工作的时候听过许多"
  },
  {
    "start": 58.086,
    "end": 60.959,
    "text": "比如一切都是由能量组成"
  },
  {
    "start": 60.959,
    "end": 64.551,
    "text": "形体和形式 视频率与振动而定"
  },
  {
    "start": 64.551,
    "end": 68.431,
    "text": "能量不死 它只是改变的说法 我"
  },
  {
    "start": 68.431,
    "end": 72.569,
    "text": "被告知地球正在改变它的震动和频率"
  },
  {
    "start": 72.569,
    "end": 75.072,
    "text": "并准备要升入新的次元"
  },
  {
    "start": 75.778,
    "end": 79.491,
    "text": "我们的周遭一直都有无数的次元"
  },
  {
    "start": 79.491,
    "end": 83.451,
    "text": "我们看不到是因为当它们的振动加快"
  },
  {
    "start": 83.451,
    "end": 87.559,
    "text": "便超越了人类的视力范围 对我们而言"
  },
  {
    "start": 87.559,
    "end": 89.612,
    "text": "他们就如隐形 人类"
  },
  {
    "start": 89.612,
    "end": 92.122,
    "text": "现在正要转移到新的次元"
  },
  {
    "start": 92.122,
    "end": 95.538,
    "text": "而这个过程很快就要到达顶点"
  },
  {
    "start": 95.538,
    "end": 99.197,
    "text": "所以能多了解次元的转换至关重要"
  },
  {
    "start": 99.903,
    "end": 104.035,
    "text": "地球是一所供我们学习课程的学校 但它"
  },
  {
    "start": 104.035,
    "end": 106.1,
    "text": "不是唯一的一所 你"
  },
  {
    "start": 106.1,
    "end": 108.396,
    "text": "曾经在别的星球居住过"
  },
  {
    "start": 108.396,
    "end": 111.303,
    "text": "曾经在别的次元中生活 你"
  },
  {
    "start": 111.303,
    "end": 114.936,
    "text": "做过许许多多你甚至无法想像的事"
  },
  {
    "start": 114.936,
    "end": 118.93,
    "text": "过去几年和我合作的许多个案 都曾经"
  },
  {
    "start": 118.93,
    "end": 121.279,
    "text": "回溯到自己是光体而且"
  },
  {
    "start": 121.279,
    "end": 123.863,
    "text": "活在一种至福状态的时候"
  },
  {
    "start": 123.863,
    "end": 127.406,
    "text": "他们原本没有理由要进入地球的密度和"
  },
  {
    "start": 127.406,
    "end": 129.281,
    "text": "负面 他们是志愿在"
  },
  {
    "start": 129.281,
    "end": 131.782,
    "text": "这个时候来协助人类和地球"
  },
  {
    "start": 131.782,
    "end": 135.084,
    "text": "我认为我遇到的这些新来地球者的"
  },
  {
    "start": 135.084,
    "end": 139.048,
    "text": "灵魂有三批 他们之所以在这个时候前来"
  },
  {
    "start": 139.048,
    "end": 142.17,
    "text": "是因为绝大多数在这里累世"
  },
  {
    "start": 142.17,
    "end": 145.813,
    "text": "生活的人已深入业力而没有进步"
  },
  {
    "start": 145.813,
    "end": 149.116,
    "text": "他们已经看不见自己活在地球的目的"
  },
  {
    "start": 149.822,
    "end": 152.045,
    "text": "在我工作的早期和早期"
  },
  {
    "start": 152.045,
    "end": 154.268,
    "text": "的著作里 我曾经以为"
  },
  {
    "start": 154.268,
    "end": 157.719,
    "text": "一个人要在这一世重新体验自己在"
  },
  {
    "start": 157.719,
    "end": 161.399,
    "text": "地球的第一次生命 根本是天方夜谭"
  },
  {
    "start": 161.399,
    "end": 163.714,
    "text": "我当时以为生命会是"
  },
  {
    "start": 163.714,
    "end": 167.314,
    "text": "渐进式的过程：再变成人类之前"
  },
  {
    "start": 167.314,
    "end": 169.732,
    "text": "灵魂必须先经历各种"
  },
  {
    "start": 169.732,
    "end": 172.419,
    "text": "生命形式：空气、岩石"
  },
  {
    "start": 172.419,
    "end": 177.064,
    "text": "土壤、植物、动物、大自然精灵、"
  },
  {
    "start": 177.064,
    "end": 179.231,
    "text": "最后才是人类"
  },
  {
    "start": 179.231,
    "end": 183.136,
    "text": "我以为当灵魂决定准备要尝试人类"
  },
  {
    "start": 183.136,
    "end": 187.301,
    "text": "生命时 它会先出生在一个原始社会"
  },
  {
    "start": 187.301,
    "end": 189.252,
    "text": "以便能慢慢适应"
  },
  {
    "start": 189.958,
    "end": 193.706,
    "text": "在我的想法中 灵魂不可能突然就"
  },
  {
    "start": 193.706,
    "end": 197.453,
    "text": "落入满是混乱能量的繁忙现代社会"
  },
  {
    "start": 197.453,
    "end": 201.019,
    "text": "这绝对会令一个新近演化的灵魂"
  },
  {
    "start": 201.019,
    "end": 204.585,
    "text": "难以招架 但后来在1986年"
  },
  {
    "start": 204.585,
    "end": 208.518,
    "text": "我写了一本名叫《地球守护者》的书"
  },
  {
    "start": 208.518,
    "end": 210.832,
    "text": "描述一个温和的灵魂"
  },
  {
    "start": 210.832,
    "end": 214.546,
    "text": "体验他在地球的第一次生命 他的"
  },
  {
    "start": 214.546,
    "end": 220.489,
    "text": "前世都在别的星球和次元 然而 在我们最初的疗程"
  },
  {
    "start": 220.489,
    "end": 223.977,
    "text": "他却描述了几段显然是在地球上"
  },
  {
    "start": 223.977,
    "end": 227.715,
    "text": "的前世 我纳闷这究竟是怎么回事"
  },
  {
    "start": 228.421,
    "end": 232.385,
    "text": "这些转世若非真就是假 但接着 „"
  },
  {
    "start": 232.385,
    "end": 236.598,
    "text": "他们‟给我【印记】的理论来解释此事"
  },
  {
    "start": 237.303,
    "end": 241.121,
    "text": "在地球上经历过无数前世的人 会"
  },
  {
    "start": 241.121,
    "end": 245.702,
    "text": "把这些人世经验储存在潜意识的记忆库里"
  },
  {
    "start": 245.702,
    "end": 249.019,
    "text": "意识察觉不到 但这些埋藏的"
  },
  {
    "start": 249.019,
    "end": 252.336,
    "text": "记忆却具有不可或缺的重要性"
  },
  {
    "start": 252.336,
    "end": 256.824,
    "text": "他们能帮助个体度过生命的困境 缺少了"
  },
  {
    "start": 256.824,
    "end": 259.317,
    "text": "某些类型的背景 人们"
  },
  {
    "start": 259.317,
    "end": 262.06,
    "text": "会不知道如何运作或应答"
  },
  {
    "start": 262.06,
    "end": 265.889,
    "text": "新生儿来到这个世界 在被父母和社会"
  },
  {
    "start": 265.889,
    "end": 268.142,
    "text": "教导之前 照理说应该"
  },
  {
    "start": 268.142,
    "end": 270.62,
    "text": "没有任何可供参考的架构"
  },
  {
    "start": 270.62,
    "end": 274.507,
    "text": "然而 这与事实相差甚远 所谓的"
  },
  {
    "start": 274.507,
    "end": 278.652,
    "text": "【婴儿】 实际上是非常古老的灵魂"
  },
  {
    "start": 278.652,
    "end": 282.51,
    "text": "他们早已有过数百次进入这复杂情境"
  },
  {
    "start": 282.51,
    "end": 285.233,
    "text": "我们称为【人生】的旅程"
  },
  {
    "start": 285.233,
    "end": 287.922,
    "text": "这因此给了他们作为人类的"
  },
  {
    "start": 287.922,
    "end": 290.835,
    "text": "生活参考 （在下意识层面）"
  },
  {
    "start": 291.541,
    "end": 294.698,
    "text": "但是 新来到地球的灵魂并没有"
  },
  {
    "start": 294.698,
    "end": 298.081,
    "text": "这个背景 他们会完全迷失 于是"
  },
  {
    "start": 298.081,
    "end": 300.321,
    "text": "灵界发展出一个精巧的"
  },
  {
    "start": 300.321,
    "end": 302.786,
    "text": "概念 既所谓的【印记】"
  },
  {
    "start": 303.492,
    "end": 308.026,
    "text": "当灵魂还在灵界 （还是精神体）时"
  },
  {
    "start": 308.026,
    "end": 312.56,
    "text": "他会看到他下一世即将进入的生命类型"
  },
  {
    "start": 312.56,
    "end": 316.97,
    "text": "然后计划自己希望能够完成和实现的事"
  },
  {
    "start": 316.97,
    "end": 319.42,
    "text": "他也与其他的灵魂约定"
  },
  {
    "start": 319.42,
    "end": 321.87,
    "text": "去解决任何存续的业力"
  },
  {
    "start": 321.87,
    "end": 324.026,
    "text": "如果灵魂没有可以依靠的"
  },
  {
    "start": 324.026,
    "end": 326.769,
    "text": "地球经验 他们会被带到图书馆"
  },
  {
    "start": 326.769,
    "end": 331.187,
    "text": "我有很多、很多的个案用同样的方式描述"
  },
  {
    "start": 331.187,
    "end": 333.396,
    "text": "过这座图书馆 那里"
  },
  {
    "start": 333.396,
    "end": 335.85,
    "text": "是收藏所有知识的地方"
  },
  {
    "start": 335.85,
    "end": 338.922,
    "text": "包括所有已知和未知的一切"
  },
  {
    "start": 339.628,
    "end": 342.84,
    "text": "馆内也有阿卡西记录 也就是"
  },
  {
    "start": 342.84,
    "end": 346.299,
    "text": "自创造以来的每一个生命的记载"
  },
  {
    "start": 346.299,
    "end": 348.566,
    "text": "透过与图书馆员的许多"
  },
  {
    "start": 348.566,
    "end": 351.515,
    "text": "讨论 并在图书馆员的建议下"
  },
  {
    "start": 351.515,
    "end": 355.712,
    "text": "灵魂选出他想印记在灵魂模式上的"
  },
  {
    "start": 355.712,
    "end": 359.91,
    "text": "人世经验 个案把印记比拟为影片"
  },
  {
    "start": 359.91,
    "end": 362.443,
    "text": "或是覆盖在图表/地图上"
  },
  {
    "start": 362.443,
    "end": 365.666,
    "text": "那种记载了重要讯息的半透明纸"
  },
  {
    "start": 365.666,
    "end": 369.891,
    "text": "这个过程很像是去图书馆做研究 为了"
  },
  {
    "start": 369.891,
    "end": 374.116,
    "text": "找到正确资讯而抽出无数的卷宗或书籍"
  },
  {
    "start": 374.116,
    "end": 376.92,
    "text": "所选取的印记于是就变成"
  },
  {
    "start": 376.92,
    "end": 379.725,
    "text": "新到地球灵魂的基本记忆"
  },
  {
    "start": 380.43,
    "end": 385.261,
    "text": "我曾问过 在为个案催眠时 要如何才能"
  },
  {
    "start": 385.261,
    "end": 387.944,
    "text": "分辨回溯时出现的记忆"
  },
  {
    "start": 387.944,
    "end": 390.627,
    "text": "是【真的】 还是只是"
  },
  {
    "start": 390.627,
    "end": 393.809,
    "text": "【印记】 我被告知 我无法"
  },
  {
    "start": 393.809,
    "end": 397.235,
    "text": "分辨其中差异 因为不只是记忆"
  },
  {
    "start": 397.235,
    "end": 400.955,
    "text": "情绪和建构起的那段生命的所有"
  },
  {
    "start": 400.955,
    "end": 404.941,
    "text": "一切 也都会被印记下来 他们说"
  },
  {
    "start": 404.941,
    "end": 409.004,
    "text": "这只是作为灵魂的参考 所以没什么关系"
  },
  {
    "start": 409.004,
    "end": 410.81,
    "text": "由于许多名人的"
  },
  {
    "start": 410.81,
    "end": 413.293,
    "text": "生命都曾经被使用为印记"
  },
  {
    "start": 413.293,
    "end": 415.325,
    "text": "这个也提供了那些因为"
  },
  {
    "start": 415.325,
    "end": 417.56,
    "text": "许多人宣称他们是同一位"
  },
  {
    "start": 417.56,
    "end": 420.429,
    "text": "重要人士而认为轮回并不"
  },
  {
    "start": 420.429,
    "end": 423.559,
    "text": "存在的怀疑主义者一个解释"
  },
  {
    "start": 423.559,
    "end": 426.54,
    "text": "印记的说法回答了这个争论 我也"
  },
  {
    "start": 426.54,
    "end": 429.521,
    "text": "问他们： 既然可以印记一段生命"
  },
  {
    "start": 429.521,
    "end": 433.236,
    "text": "而不是真正有过实际体验 这是否"
  },
  {
    "start": 433.236,
    "end": 437.446,
    "text": "代表轮回并不存在  他们说并非如此"
  },
  {
    "start": 437.446,
    "end": 440.616,
    "text": "毕竟要有灵魂真的经历过那些"
  },
  {
    "start": 440.616,
    "end": 444.517,
    "text": "生命 才会有资料和记忆放到记录里"
  },
  {
    "start": 445.223,
    "end": 449.418,
    "text": "这个说法十分合理 也确实是个能让纯净"
  },
  {
    "start": 449.418,
    "end": 451.516,
    "text": "无邪的灵魂适应一个"
  },
  {
    "start": 451.516,
    "end": 454.079,
    "text": "陌生又混乱的世界的方法"
  },
  {
    "start": 454.079,
    "end": 458.358,
    "text": "没有做这些准备就来到地球会非常辛苦"
  },
  {
    "start": 458.358,
    "end": 460.735,
    "text": "温和的灵魂将无以为据"
  },
  {
    "start": 460.735,
    "end": 463.112,
    "text": "他们会完全无法应对"
  },
  {
    "start": 463.112,
    "end": 466.972,
    "text": "在我接触《地球守护者》的年轻男子菲尔"
  },
  {
    "start": 466.972,
    "end": 470.832,
    "text": "之后 我开始经常地遇到这些新来的灵魂"
  },
  {
    "start": 470.832,
    "end": 474.164,
    "text": "这些案例收录在《回旋宇宙》系列"
  },
  {
    "start": 474.164,
    "end": 477.718,
    "text": "换句话说 我以前以为很罕见的事"
  },
  {
    "start": 477.718,
    "end": 481.198,
    "text": "现在变得比较平常了 这些记忆"
  },
  {
    "start": 481.198,
    "end": 484.927,
    "text": "一直都隐藏在个案前世的印记后头"
  },
  {
    "start": 484.927,
    "end": 489.632,
    "text": "其他催眠师和调查者发掘到的都是印记"
  },
  {
    "start": 489.632,
    "end": 493.466,
    "text": "由于灵魂是为了这一世的某个目的而选择"
  },
  {
    "start": 493.466,
    "end": 495.597,
    "text": "了特定的印记 【表面"
  },
  {
    "start": 495.597,
    "end": 497.94,
    "text": "】的前世会解答一些问题"
  },
  {
    "start": 497.94,
    "end": 502.012,
    "text": "但却不是最重要的 而具有无限智慧的"
  },
  {
    "start": 502.012,
    "end": 506.083,
    "text": "潜意识 只会提供个案能够应用的资讯"
  },
  {
    "start": 506.083,
    "end": 509.143,
    "text": "这个在催眠师方面也是一样"
  },
  {
    "start": 509.143,
    "end": 512.674,
    "text": "如果催眠师才刚开始探索未知领域"
  },
  {
    "start": 512.674,
    "end": 516.492,
    "text": "他们将不会得到复杂难懂的答案 我是在"
  },
  {
    "start": 516.492,
    "end": 517.977,
    "text": "准备好延伸我的"
  },
  {
    "start": 517.977,
    "end": 520.522,
    "text": "好奇心后 才得到这些资料"
  },
  {
    "start": 521.228,
    "end": 525.605,
    "text": "直到最近 我仍以为这些纯净无邪的【"
  },
  {
    "start": 525.605,
    "end": 528.181,
    "text": "地球新鲜人】很稀有"
  },
  {
    "start": 528.181,
    "end": 530.756,
    "text": "但现在他们却变得常见"
  },
  {
    "start": 530.756,
    "end": 534.661,
    "text": "潜意识甚至不再大费周章的掩饰 有很"
  },
  {
    "start": 534.661,
    "end": 538.795,
    "text": "多次 不论我尝试了多少催眠技巧的变化"
  },
  {
    "start": 538.795,
    "end": 542.641,
    "text": "个案连一个前世都找不到 然后当我"
  },
  {
    "start": 542.641,
    "end": 546.727,
    "text": "联系潜意识以弄清状况时 我总是会问"
  },
  {
    "start": 546.727,
    "end": 550.389,
    "text": "为什么我们什么也没发现 他有时会说："
  },
  {
    "start": 550.389,
    "end": 552.423,
    "text": "可以给他看些东西"
  },
  {
    "start": 552.423,
    "end": 554.457,
    "text": "我们可以给他看些东西"
  },
  {
    "start": 554.457,
    "end": 557.389,
    "text": "不过那些都只是【印记】  然后"
  },
  {
    "start": 557.389,
    "end": 560.516,
    "text": "他接着会告诉个案他们是从哪里来的"
  },
  {
    "start": 560.516,
    "end": 562.708,
    "text": "以及他们此时在地球"
  },
  {
    "start": 562.708,
    "end": 565.143,
    "text": "行星的目的 潜意识说"
  },
  {
    "start": 565.143,
    "end": 569.761,
    "text": "曾经有几个灵魂在进入婴儿身体前拒绝【"
  },
  {
    "start": 569.761,
    "end": 572.07,
    "text": "印记】 结果造成了"
  },
  {
    "start": 572.07,
    "end": 575.149,
    "text": "没有计划或目的的混乱人生"
  },
  {
    "start": 575.149,
    "end": 579.236,
    "text": "因此 看来【他们】是真的知道自己在做"
  },
  {
    "start": 579.236,
    "end": 581.28,
    "text": "什么 不了解或无法"
  },
  {
    "start": 581.28,
    "end": 583.551,
    "text": "领悟的是我们 是人类"
  },
  {
    "start": 584.257,
    "end": 588.456,
    "text": "为了彻底了解我即将提出的理论还有"
  },
  {
    "start": 588.456,
    "end": 592.656,
    "text": "遗失的片段 我们必须要先回到原点"
  },
  {
    "start": 592.656,
    "end": 595.216,
    "text": "回到人类被【播种】的时候"
  },
  {
    "start": 596.628,
    "end": 598.774,
    "text": "地球生命的起源"
  },
  {
    "start": 600.186,
    "end": 603.922,
    "text": "要了解为何这些三波段志愿者选择在"
  },
  {
    "start": 603.922,
    "end": 607.892,
    "text": "这个时候来到地球 我们必须回到最初"
  },
  {
    "start": 607.892,
    "end": 610.61,
    "text": "回到我们的世界开始有生命的"
  },
  {
    "start": 610.61,
    "end": 613.746,
    "text": "时候 我知道这个资料很有争议性"
  },
  {
    "start": 613.746,
    "end": 618.293,
    "text": "但当同样的资料在数千次的回溯催眠中"
  },
  {
    "start": 618.293,
    "end": 620.967,
    "text": "一次又一次地出现 我"
  },
  {
    "start": 620.967,
    "end": 623.641,
    "text": "认为我们不能置若罔闻"
  },
  {
    "start": 624.347,
    "end": 629.2,
    "text": "万古以前 地球上没有生命 只有很多座"
  },
  {
    "start": 629.2,
    "end": 634.053,
    "text": "火山 大气中充满了氨 为了让生命出现"
  },
  {
    "start": 634.053,
    "end": 637.632,
    "text": "地球必须被改变 我从研究中学到"
  },
  {
    "start": 637.632,
    "end": 640.613,
    "text": "有一些议会负责制定宇宙"
  },
  {
    "start": 640.613,
    "end": 643.594,
    "text": "间创造生命的规则和规章"
  },
  {
    "start": 644.3,
    "end": 647.219,
    "text": "有些监督太阳系的议会 监督"
  },
  {
    "start": 647.219,
    "end": 650.813,
    "text": "银河系的议会 还有监督宇宙的议会"
  },
  {
    "start": 650.813,
    "end": 655.224,
    "text": "这是个非常井然有序的体系 这些较高阶"
  },
  {
    "start": 655.224,
    "end": 657.675,
    "text": "的存在体在宇宙间寻找"
  },
  {
    "start": 657.675,
    "end": 660.126,
    "text": "合适的生命居住的星球"
  },
  {
    "start": 660.126,
    "end": 663.857,
    "text": "他们说 对一个星球而言 可支撑"
  },
  {
    "start": 663.857,
    "end": 668.085,
    "text": "生命的状态还是那个星球史上重大时刻"
  },
  {
    "start": 668.085,
    "end": 672.353,
    "text": "星球在这时候会得到他的生命许可证"
  },
  {
    "start": 673.059,
    "end": 677.485,
    "text": "然后 不同群的外星人或更高的存在体"
  },
  {
    "start": 677.485,
    "end": 679.943,
    "text": "会衔命前往哪个星球"
  },
  {
    "start": 679.943,
    "end": 682.402,
    "text": "执行让生命开始的任务"
  },
  {
    "start": 682.402,
    "end": 686.665,
    "text": "这些存在体被称为古代人或者是古人"
  },
  {
    "start": 686.665,
    "end": 691.195,
    "text": "他们从时间的初始便在执行这些任务"
  },
  {
    "start": 691.195,
    "end": 695.388,
    "text": "不过神并没有因此置身事外 他跟这些"
  },
  {
    "start": 695.388,
    "end": 697.855,
    "text": "密切相关 这些存在体"
  },
  {
    "start": 697.855,
    "end": 700.569,
    "text": "首先带来单细胞的有机体"
  },
  {
    "start": 700.569,
    "end": 703.719,
    "text": "再让他们分裂和形成多细胞"
  },
  {
    "start": 703.719,
    "end": 707.395,
    "text": "有机体 但会形成哪一种有机体"
  },
  {
    "start": 707.395,
    "end": 710.365,
    "text": "则由每个星球的状况决定"
  },
  {
    "start": 711.07,
    "end": 714.494,
    "text": "在对一个星球播种之后 他们在漫长"
  },
  {
    "start": 714.494,
    "end": 718.132,
    "text": "的时间中 会不时的回来检视那些细胞"
  },
  {
    "start": 718.132,
    "end": 720.932,
    "text": "他们常发现细胞没有存活"
  },
  {
    "start": 720.932,
    "end": 724.497,
    "text": "下来 地球又恢复为无生命状态"
  },
  {
    "start": 724.497,
    "end": 727.205,
    "text": "这些存在体曾经对我说："
  },
  {
    "start": 727.205,
    "end": 730.815,
    "text": "你不晓得生命有多么脆弱  因此"
  },
  {
    "start": 730.815,
    "end": 734.834,
    "text": "他们花了些时间在地球上播种 并不时地"
  },
  {
    "start": 734.834,
    "end": 736.844,
    "text": "回来检查 过了一段"
  },
  {
    "start": 736.844,
    "end": 739.523,
    "text": "时期 地球上开始出现植物"
  },
  {
    "start": 739.523,
    "end": 743.508,
    "text": "因为在有动物之前必须先有植物 随着"
  },
  {
    "start": 743.508,
    "end": 745.149,
    "text": "生命开始发展"
  },
  {
    "start": 745.149,
    "end": 747.962,
    "text": "古代人频频回来检视和关切"
  },
  {
    "start": 747.962,
    "end": 751.728,
    "text": "他们创造出海洋 净化了空气"
  },
  {
    "start": 751.728,
    "end": 755.763,
    "text": "好让各种生命形式都能演化 终于"
  },
  {
    "start": 755.763,
    "end": 760.161,
    "text": "较高阶的存在体开始创造有智慧的生命"
  },
  {
    "start": 760.161,
    "end": 762.36,
    "text": "这是每个星球的过程"
  },
  {
    "start": 762.36,
    "end": 764.804,
    "text": "这是生命形成的方式"
  },
  {
    "start": 765.51,
    "end": 768.645,
    "text": "我在我的书里把这些存在体 称为【"
  },
  {
    "start": 768.645,
    "end": 772.172,
    "text": "花园的守护者】 因为我们就是这座花园"
  },
  {
    "start": 772.172,
    "end": 776.318,
    "text": "我们是他们的孩子 为了创造出有智慧的"
  },
  {
    "start": 776.318,
    "end": 778.39,
    "text": "生物 他们必须使用"
  },
  {
    "start": 778.39,
    "end": 780.693,
    "text": "一种脑容量够大的动物"
  },
  {
    "start": 780.693,
    "end": 785.005,
    "text": "具有学习能力 还有可以发展出工具"
  },
  {
    "start": 785.005,
    "end": 789.317,
    "text": "的双手 这是为何他们选择了类人猿"
  },
  {
    "start": 789.317,
    "end": 793.925,
    "text": "一些人对此有异议 但事实上我们和"
  },
  {
    "start": 793.925,
    "end": 796.805,
    "text": "类人猿的基因有98%"
  },
  {
    "start": 796.805,
    "end": 800.261,
    "text": "相同 你可以输血给类人猿"
  },
  {
    "start": 800.261,
    "end": 803.942,
    "text": "他会活下来 我们和他们的基因就是"
  },
  {
    "start": 803.942,
    "end": 807.853,
    "text": "这么的相近 既是如此 要创造出人类"
  },
  {
    "start": 807.853,
    "end": 810.956,
    "text": "人有必要操纵基因并混入来自"
  },
  {
    "start": 810.956,
    "end": 814.775,
    "text": "宇宙各地的其他细胞与基因 他们说"
  },
  {
    "start": 814.775,
    "end": 818.06,
    "text": "我们永远也找不到缺少或遗漏的连接"
  },
  {
    "start": 818.06,
    "end": 821.345,
    "text": "根本就不存在 我们的演化三级跳"
  },
  {
    "start": 821.345,
    "end": 823.569,
    "text": "这并不是随机发生的事"
  },
  {
    "start": 824.275,
    "end": 828.214,
    "text": "随着时间的推移 每当需要给人类某样"
  },
  {
    "start": 828.214,
    "end": 830.531,
    "text": "东西的时候 这些存在"
  },
  {
    "start": 830.531,
    "end": 833.08,
    "text": "体会过来和人类一起生活"
  },
  {
    "start": 833.08,
    "end": 835.886,
    "text": "提供人类所需 世上每一个"
  },
  {
    "start": 835.886,
    "end": 839.392,
    "text": "文化都有【带文化来的人】的传说"
  },
  {
    "start": 839.392,
    "end": 843.757,
    "text": "印第安人有玉米女人教他们如何栽种的"
  },
  {
    "start": 843.757,
    "end": 846.324,
    "text": "故事 传说中也有教导"
  },
  {
    "start": 846.324,
    "end": 849.404,
    "text": "人类关于火和如何发展农业"
  },
  {
    "start": 849.404,
    "end": 854.137,
    "text": "在世界各地这些传说里 那些存在体若不"
  },
  {
    "start": 854.137,
    "end": 858.87,
    "text": "是从天而降 就是跨海而来 他们是老师"
  },
  {
    "start": 858.87,
    "end": 862.863,
    "text": "而且想活多久就能活多久 他们是"
  },
  {
    "start": 862.863,
    "end": 867.387,
    "text": "传说中降临凡尘的神和女神 即使现在"
  },
  {
    "start": 867.387,
    "end": 870.917,
    "text": "这样的事仍然发生 只是他们不会"
  },
  {
    "start": 870.917,
    "end": 874.683,
    "text": "引人注意 所以无法在我们之中生活"
  },
  {
    "start": 874.683,
    "end": 878.667,
    "text": "因此当他们想提供人类新概念已加速"
  },
  {
    "start": 878.667,
    "end": 880.659,
    "text": "进化时候 他们现"
  },
  {
    "start": 880.659,
    "end": 883.398,
    "text": "在把那些想法放在大气里"
  },
  {
    "start": 883.398,
    "end": 887.969,
    "text": "凡是接收到的就是创造或发明者 只要"
  },
  {
    "start": 887.969,
    "end": 890.658,
    "text": "事情是跟着时间表走"
  },
  {
    "start": 890.658,
    "end": 893.346,
    "text": "他们并不在乎是谁发明"
  },
  {
    "start": 893.346,
    "end": 897.432,
    "text": "我们都知道不同的人在同一个时间努力"
  },
  {
    "start": 897.432,
    "end": 901.759,
    "text": "同样的发明或创新 自由能源就是个例子"
  },
  {
    "start": 901.759,
    "end": 904.993,
    "text": "我在前往世界各地时 就听说"
  },
  {
    "start": 904.993,
    "end": 908.477,
    "text": "现在有许多人都在研发自由能源"
  },
  {
    "start": 910.595,
    "end": 912.392,
    "text": "失落的伊甸园"
  },
  {
    "start": 913.803,
    "end": 918.179,
    "text": "当有智慧的生物在地球上被创造出来"
  },
  {
    "start": 918.179,
    "end": 919.981,
    "text": "议会决定给我们"
  },
  {
    "start": 919.981,
    "end": 923.584,
    "text": "自由意志 看看我们会如何使用"
  },
  {
    "start": 923.584,
    "end": 927.107,
    "text": "并不是每个星球都有自由意志 《星际"
  },
  {
    "start": 927.107,
    "end": 928.972,
    "text": "争霸战》里的不干预"
  },
  {
    "start": 928.972,
    "end": 931.045,
    "text": "指令是非常非常真实的"
  },
  {
    "start": 931.045,
    "end": 933.782,
    "text": "议会的指令有一部份就是"
  },
  {
    "start": 933.782,
    "end": 937.266,
    "text": "不能干预具有智慧的物种的发展"
  },
  {
    "start": 937.266,
    "end": 940.539,
    "text": "他们可以透过教导和给予我们知识"
  },
  {
    "start": 940.539,
    "end": 944.031,
    "text": "来提供协助 但不能干预 我问他们"
  },
  {
    "start": 944.031,
    "end": 947.538,
    "text": "当他们把演化下一步所需的东西带给我们"
  },
  {
    "start": 947.538,
    "end": 949.292,
    "text": "的时候 难道不算是"
  },
  {
    "start": 949.292,
    "end": 951.435,
    "text": "干预吗 他们说： 不算"
  },
  {
    "start": 951.435,
    "end": 954.131,
    "text": "这是我们给人类的礼物 为的"
  },
  {
    "start": 954.131,
    "end": 957.034,
    "text": "是帮助你们在下一个阶段的发展"
  },
  {
    "start": 957.034,
    "end": 960.193,
    "text": "你们要怎么使用是你们的自由意志"
  },
  {
    "start": 960.193,
    "end": 963.352,
    "text": "我们有很多次在收下他们的礼物后"
  },
  {
    "start": 963.352,
    "end": 967.038,
    "text": "非如他们所愿地把礼物用在负面或是"
  },
  {
    "start": 967.038,
    "end": 969.572,
    "text": "破坏性的用途 我说："
  },
  {
    "start": 969.572,
    "end": 972.336,
    "text": "难道你们不能回来告诉人类"
  },
  {
    "start": 972.336,
    "end": 975.352,
    "text": "他们并没有正确使用吗  他们"
  },
  {
    "start": 975.352,
    "end": 978.369,
    "text": "说： 不行 那样就会是干预了"
  },
  {
    "start": 979.074,
    "end": 981.705,
    "text": "我们把东西给你们 你要怎么"
  },
  {
    "start": 981.705,
    "end": 984.942,
    "text": "用是你们的自由意志 我们只能旁观"
  },
  {
    "start": 984.942,
    "end": 987.253,
    "text": "对着人类的复杂惊异地"
  },
  {
    "start": 987.253,
    "end": 990.027,
    "text": "摇头 但我们不能插手干预"
  },
  {
    "start": 990.027,
    "end": 993.053,
    "text": "这条规则的唯一例外就是如果"
  },
  {
    "start": 993.053,
    "end": 996.294,
    "text": "我们的发展到了会摧毁世界的地步"
  },
  {
    "start": 996.294,
    "end": 1000.511,
    "text": "由于这会在银河系间造成长远的影响"
  },
  {
    "start": 1000.511,
    "end": 1004.727,
    "text": "干扰到太多星球和甚至其他次元的生命"
  },
  {
    "start": 1004.727,
    "end": 1008.013,
    "text": "因此他们不能坐视不管 你会想"
  },
  {
    "start": 1008.013,
    "end": 1010.467,
    "text": "一个被刻意孤立在我们这个"
  },
  {
    "start": 1010.467,
    "end": 1013.944,
    "text": "太阳系的小星球怎么会有这么大的影响"
  },
  {
    "start": 1013.944,
    "end": 1019.318,
    "text": "但他们说结果会十分深远且具有毁灭性"
  },
  {
    "start": 1020.024,
    "end": 1023.595,
    "text": "人类原来该是完美的物种 永远"
  },
  {
    "start": 1023.595,
    "end": 1027.932,
    "text": "不会生病 而且可以想活多久就活多久"
  },
  {
    "start": 1027.932,
    "end": 1032.132,
    "text": "地球原本是要像座伊甸园 一个完美的"
  },
  {
    "start": 1032.132,
    "end": 1034.602,
    "text": "地方 然而 意料外的"
  },
  {
    "start": 1034.602,
    "end": 1037.319,
    "text": "事发生并改变了整个计划"
  },
  {
    "start": 1038.025,
    "end": 1041.674,
    "text": "就在生命正开始要美好发展的时候"
  },
  {
    "start": 1041.674,
    "end": 1045.778,
    "text": "一颗流星撞击地球 带来造成疾病的细菌"
  },
  {
    "start": 1045.778,
    "end": 1049.538,
    "text": "这是疾病第一次出现在地球上 事情"
  },
  {
    "start": 1049.538,
    "end": 1051.418,
    "text": "发生时 监督地球"
  },
  {
    "start": 1051.418,
    "end": 1054.003,
    "text": "演化的存在体回去问议会"
  },
  {
    "start": 1054.003,
    "end": 1057.011,
    "text": "他们完美的实验被破坏了 该"
  },
  {
    "start": 1057.011,
    "end": 1060.25,
    "text": "如何是好 大家感到无比的哀伤"
  },
  {
    "start": 1060.25,
    "end": 1063.925,
    "text": "是要摧毁一切然后重新开始"
  },
  {
    "start": 1063.925,
    "end": 1068.447,
    "text": "还是容许生命继续发展 议会决定"
  },
  {
    "start": 1068.447,
    "end": 1072.524,
    "text": "既然已经投入这么多的时间和精力 不如"
  },
  {
    "start": 1072.524,
    "end": 1074.335,
    "text": "让生命继续演化"
  },
  {
    "start": 1074.335,
    "end": 1076.826,
    "text": "即使他们知道 因为疾病"
  },
  {
    "start": 1076.826,
    "end": 1079.444,
    "text": "地球上的生命永远不会像"
  },
  {
    "start": 1079.444,
    "end": 1082.062,
    "text": "最初所规划得那么完美了"
  },
  {
    "start": 1082.768,
    "end": 1085.621,
    "text": "这些较高阶的存在体持续"
  },
  {
    "start": 1085.621,
    "end": 1088.474,
    "text": "从远距外观察我们的演化"
  },
  {
    "start": 1088.474,
    "end": 1091.855,
    "text": "但1945年发生的事引起他们高"
  },
  {
    "start": 1091.855,
    "end": 1095.687,
    "text": "关注——第二次世界大战结束前的原爆"
  },
  {
    "start": 1095.687,
    "end": 1098.905,
    "text": "人类在当时的演化还不到该有原子"
  },
  {
    "start": 1098.905,
    "end": 1102.768,
    "text": "力量的阶段 他们知道我们会无法控制它"
  },
  {
    "start": 1102.768,
    "end": 1104.642,
    "text": "我们会把它用来破坏"
  },
  {
    "start": 1105.348,
    "end": 1109.526,
    "text": "当原子能要进入地球发展的时间表 原意"
  },
  {
    "start": 1109.526,
    "end": 1113.703,
    "text": "是要人类使用在好的方面 能够因此受益"
  },
  {
    "start": 1114.409,
    "end": 1117.038,
    "text": "我说我们有负面的氛围 也"
  },
  {
    "start": 1117.038,
    "end": 1119.887,
    "text": "无法发挥它本该有的伟大益处"
  },
  {
    "start": 1119.887,
    "end": 1124.221,
    "text": "我们毕竟才刚走出可怕的第二次世界大战"
  },
  {
    "start": 1124.221,
    "end": 1127.607,
    "text": "所以他们知道我们绝对无法控制像"
  },
  {
    "start": 1127.607,
    "end": 1131.669,
    "text": "原子能这样强大的东西 这是人类的天性"
  },
  {
    "start": 1131.669,
    "end": 1135.853,
    "text": "因此他们十分担心这会导致毁灭"
  },
  {
    "start": 1136.558,
    "end": 1140.146,
    "text": "在原子弹发展的期间 科学家对自己在"
  },
  {
    "start": 1140.146,
    "end": 1141.835,
    "text": "实验什么其实不是"
  },
  {
    "start": 1141.835,
    "end": 1144.367,
    "text": "很了解 它是个未知的元素"
  },
  {
    "start": 1144.367,
    "end": 1147.679,
    "text": "科学家曾被他们告知要想得到"
  },
  {
    "start": 1147.679,
    "end": 1150.991,
    "text": "这会点燃大气中所有氢原子"
  },
  {
    "start": 1150.991,
    "end": 1154.741,
    "text": "并引起足以摧毁世界的大爆炸"
  },
  {
    "start": 1154.741,
    "end": 1158.758,
    "text": "然而 科学家们没有理会这个忠告"
  },
  {
    "start": 1158.758,
    "end": 1162.639,
    "text": "反而在好奇心的带引下 继续进行实验"
  },
  {
    "start": 1163.345,
    "end": 1165.916,
    "text": "我在《魂忆广岛》里描述"
  },
  {
    "start": 1165.916,
    "end": 1168.487,
    "text": "了这一切 为了写那本书"
  },
  {
    "start": 1168.487,
    "end": 1172.391,
    "text": "我投入了数年的时间研究原子弹的发展"
  },
  {
    "start": 1172.391,
    "end": 1174.343,
    "text": "在大战结束后 他们"
  },
  {
    "start": 1174.343,
    "end": 1176.513,
    "text": "的忧虑是有充分理由的"
  },
  {
    "start": 1176.513,
    "end": 1179.63,
    "text": "人类并不晓得自己在玩什么 那"
  },
  {
    "start": 1179.63,
    "end": 1183.194,
    "text": "真是一段极其危险又动荡不安的时期"
  },
  {
    "start": 1183.9,
    "end": 1188.768,
    "text": "也就是在这段时间 1940年代末和1950"
  },
  {
    "start": 1188.768,
    "end": 1192.708,
    "text": "年代初 幽浮目击事件开始为众人所知"
  },
  {
    "start": 1192.708,
    "end": 1196.241,
    "text": "较高阶存在体因为不能干预人类的"
  },
  {
    "start": 1196.241,
    "end": 1200.48,
    "text": "自由意志 所以回去问议会现在该怎么办"
  },
  {
    "start": 1200.48,
    "end": 1203.988,
    "text": "议会就在那个时候想出了我认为的"
  },
  {
    "start": 1203.988,
    "end": 1208.197,
    "text": "绝妙计划 他们说： 我们不能从外干预"
  },
  {
    "start": 1208.197,
    "end": 1211.818,
    "text": "但如果我们是由内提供协助呢  当你"
  },
  {
    "start": 1211.818,
    "end": 1215.651,
    "text": "要求志愿者到地球协助就不能算是干预了"
  },
  {
    "start": 1215.651,
    "end": 1218.587,
    "text": "这就是为什么他们对全宇宙"
  },
  {
    "start": 1218.587,
    "end": 1221.768,
    "text": "呼唤 召募灵魂前来帮助地球"
  },
  {
    "start": 1222.474,
    "end": 1226.727,
    "text": "地球上的人已经深陷在轮回 他们在"
  },
  {
    "start": 1226.727,
    "end": 1230.98,
    "text": "业力的轮转中 上百、上千次地转世"
  },
  {
    "start": 1230.98,
    "end": 1234.435,
    "text": "一再回来卻犯下同样的错误"
  },
  {
    "start": 1234.435,
    "end": 1238.155,
    "text": "人类应该要进化的 但我们没有"
  },
  {
    "start": 1238.155,
    "end": 1242.55,
    "text": "这是耶稣和其他伟大先知来到地球的主要"
  },
  {
    "start": 1242.55,
    "end": 1244.992,
    "text": "原因：教世人如何脱离"
  },
  {
    "start": 1244.992,
    "end": 1247.677,
    "text": "业力之轮 帮助人类进化"
  },
  {
    "start": 1247.677,
    "end": 1251.12,
    "text": "然而 我们仍一次次犯下同样的错误"
  },
  {
    "start": 1251.12,
    "end": 1254.778,
    "text": "——创造出战争和这么多的暴力 所以"
  },
  {
    "start": 1254.778,
    "end": 1258.413,
    "text": "人类势必无法拯救地球 当他们连自己"
  },
  {
    "start": 1258.413,
    "end": 1262.048,
    "text": "都帮不了的时候 又怎么能帮助地球呢"
  },
  {
    "start": 1262.048,
    "end": 1265.309,
    "text": "这需要没有困在业力轮转 且"
  },
  {
    "start": 1265.309,
    "end": 1269.072,
    "text": "从未来过地球的纯净灵魂才办得到"
  },
  {
    "start": 1269.778,
    "end": 1273.222,
    "text": "过去五年 我在工作时遇到"
  },
  {
    "start": 1273.222,
    "end": 1276.953,
    "text": "越来越多直接来自于神的灵魂"
  },
  {
    "start": 1276.953,
    "end": 1280.643,
    "text": "他们以前从未有过任何类型的身体"
  },
  {
    "start": 1280.643,
    "end": 1283.843,
    "text": "也有的个案在回溯时回到自己"
  },
  {
    "start": 1283.843,
    "end": 1287.29,
    "text": "住在太空船或是其他星球的时候"
  },
  {
    "start": 1287.29,
    "end": 1290.616,
    "text": "他们看到自己在其他的次元 身为光"
  },
  {
    "start": 1290.616,
    "end": 1294.15,
    "text": "体而且不需要肉体 来到地球的志愿者"
  },
  {
    "start": 1294.15,
    "end": 1297.922,
    "text": "他们的灵魂会覆盖一层套或遮盖"
  },
  {
    "start": 1297.922,
    "end": 1301.964,
    "text": "物 以免累积业障 一但累积了业"
  },
  {
    "start": 1301.964,
    "end": 1306.111,
    "text": "他们就必须一再轮回转世 现在"
  },
  {
    "start": 1306.111,
    "end": 1310.534,
    "text": "全世界各地有成千上万这样的新灵魂"
  },
  {
    "start": 1310.534,
    "end": 1313.269,
    "text": "所以较高阶的存在体已经说"
  },
  {
    "start": 1313.269,
    "end": 1316.214,
    "text": "他们不必担心我们把地球给毁了"
  },
  {
    "start": 1316.214,
    "end": 1319.516,
    "text": "他们说我们终于造成决定性的"
  },
  {
    "start": 1319.516,
    "end": 1322.819,
    "text": "影响 我们将能拯救这个世界"
  },
  {
    "start": 1323.525,
    "end": 1327.286,
    "text": "直接来自于源头或神的灵魂最是"
  },
  {
    "start": 1327.286,
    "end": 1331.316,
    "text": "纯净无邪 我曾要求知道神是什么"
  },
  {
    "start": 1331.316,
    "end": 1334.663,
    "text": "他们说我们拥有的对神的概念"
  },
  {
    "start": 1334.663,
    "end": 1338.488,
    "text": "不过是真正的它的一丝细小线索罢了"
  },
  {
    "start": 1338.488,
    "end": 1342.643,
    "text": "我们连要开始把它概念化都还差得很远"
  },
  {
    "start": 1342.643,
    "end": 1344.489,
    "text": "他们全都用同样的"
  },
  {
    "start": 1344.489,
    "end": 1347.028,
    "text": "方式描述神：它不是男人"
  },
  {
    "start": 1347.028,
    "end": 1351.861,
    "text": "若真要说是男是女 也会是个女人 因为"
  },
  {
    "start": 1351.861,
    "end": 1356.694,
    "text": "女人才是创造的力量 但神既非男也非女"
  },
  {
    "start": 1356.694,
    "end": 1360.034,
    "text": "它是所有能量的巨大源头"
  },
  {
    "start": 1360.034,
    "end": 1363.93,
    "text": "他们描述神是无边无际的火或光"
  },
  {
    "start": 1363.93,
    "end": 1368.097,
    "text": "有些人称神为伟大的中心太阳 一个"
  },
  {
    "start": 1368.097,
    "end": 1370.18,
    "text": "巨大的能量源头"
  },
  {
    "start": 1370.18,
    "end": 1373.045,
    "text": "然而充满了爱 全然的爱"
  },
  {
    "start": 1373.045,
    "end": 1376.725,
    "text": "一位个案在描述【源头】时"
  },
  {
    "start": 1376.725,
    "end": 1380.405,
    "text": "说它是【太阳的心 神的心】"
  },
  {
    "start": 1381.111,
    "end": 1385.254,
    "text": "当直接来自于神的纯净存在体在催眠中"
  },
  {
    "start": 1385.254,
    "end": 1389.641,
    "text": "回到源头 他们会不想离开 那里是我们"
  },
  {
    "start": 1389.641,
    "end": 1392.076,
    "text": "是所有生命的开始"
  },
  {
    "start": 1392.076,
    "end": 1395.593,
    "text": "所有人在【源头】时本是一体"
  },
  {
    "start": 1396.298,
    "end": 1400.985,
    "text": "直接来自于神的灵魂说 在那里没有分离"
  },
  {
    "start": 1400.985,
    "end": 1405.673,
    "text": "都是一体 我曾问： 既然你这么爱它"
  },
  {
    "start": 1405.673,
    "end": 1408.485,
    "text": "为什么要离开  他们全都给我同样"
  },
  {
    "start": 1408.485,
    "end": 1411.298,
    "text": "的回答： 我听到了召唤 地球有难"
  },
  {
    "start": 1411.298,
    "end": 1415.061,
    "text": "谁要前往协助  连那些外星人说的"
  },
  {
    "start": 1415.061,
    "end": 1419.058,
    "text": "都是同样的话 只不过在进入肉体之后"
  },
  {
    "start": 1419.058,
    "end": 1422.949,
    "text": "他们和我们所有人一样 记忆都被消除了"
  },
  {
    "start": 1422.949,
    "end": 1424.895,
    "text": "我问： 如果我们"
  },
  {
    "start": 1424.895,
    "end": 1427.272,
    "text": "记得自己为什么来到地球"
  },
  {
    "start": 1427.272,
    "end": 1430.58,
    "text": "事情不是会比较好办吗  他们说"
  },
  {
    "start": 1430.58,
    "end": 1434.108,
    "text": "你若是知道答案 那就不是考验了"
  },
  {
    "start": 1434.814,
    "end": 1438.677,
    "text": "三波段所以 分成三个波段来到地球的"
  },
  {
    "start": 1438.677,
    "end": 1442.541,
    "text": "灵魂有双重目的：一是改变地球的能量"
  },
  {
    "start": 1442.541,
    "end": 1446.875,
    "text": "以避免发生大灾难 二是提升人类的能量"
  },
  {
    "start": 1446.875,
    "end": 1449.043,
    "text": "好让我们能与地球"
  },
  {
    "start": 1449.043,
    "end": 1451.451,
    "text": "一起提升至下一个次元"
  },
  {
    "start": 1451.451,
    "end": 1455.163,
    "text": "在进行成百上千个催眠疗程的期间"
  },
  {
    "start": 1455.163,
    "end": 1459.124,
    "text": "我开始估计三波段灵魂的大约年纪"
  },
  {
    "start": 1459.124,
    "end": 1462.99,
    "text": "由于他们都对自己这世的生命有同样"
  },
  {
    "start": 1462.99,
    "end": 1467.099,
    "text": "的说法 在催眠时也都回到同样的情况"
  },
  {
    "start": 1467.099,
    "end": 1469.426,
    "text": "因此我粗略地依据他们"
  },
  {
    "start": 1469.426,
    "end": 1471.753,
    "text": "现在的年龄将他们分类"
  },
  {
    "start": 1472.459,
    "end": 1476.611,
    "text": "第一波段的灵魂现在大约四十多岁到六十"
  },
  {
    "start": 1476.611,
    "end": 1478.687,
    "text": "出头（生于1940"
  },
  {
    "start": 1478.687,
    "end": 1481.224,
    "text": "年代末原子弹爆炸之后）"
  },
  {
    "start": 1481.224,
    "end": 1484.239,
    "text": "他们是最难适应地球的一批"
  },
  {
    "start": 1484.239,
    "end": 1487.717,
    "text": "他们不喜欢这个世界的暴力和丑陋"
  },
  {
    "start": 1487.717,
    "end": 1489.66,
    "text": "他们很想回家】——"
  },
  {
    "start": 1489.66,
    "end": 1492.25,
    "text": "即使他们的意识并不知道【"
  },
  {
    "start": 1492.25,
    "end": 1495.273,
    "text": "家】在哪里 情绪令他们不安"
  },
  {
    "start": 1495.273,
    "end": 1498.826,
    "text": "甚至会瘫痪他们 使他们不知所措"
  },
  {
    "start": 1498.826,
    "end": 1502.616,
    "text": "尤其是愤怒和仇恨之类的强烈情绪"
  },
  {
    "start": 1502.616,
    "end": 1506.824,
    "text": "置身在表达这些强烈情绪的人身边 他们"
  },
  {
    "start": 1506.824,
    "end": 1509.161,
    "text": "会无法应付 这些情绪"
  },
  {
    "start": 1509.161,
    "end": 1511.733,
    "text": "对他们造成戏剧性的影响"
  },
  {
    "start": 1511.733,
    "end": 1514.24,
    "text": "就好像情绪对他们来说很"
  },
  {
    "start": 1514.24,
    "end": 1516.975,
    "text": "陌生 他们习惯于平静和爱"
  },
  {
    "start": 1516.975,
    "end": 1520.126,
    "text": "因为那是他们在自己的来处所"
  },
  {
    "start": 1520.126,
    "end": 1524.49,
    "text": "体验到的 所以面对其他情绪时很不习惯"
  },
  {
    "start": 1524.49,
    "end": 1528.5,
    "text": "即使这些人过着很好的生活 有充满爱"
  },
  {
    "start": 1528.5,
    "end": 1532.747,
    "text": "的家庭和一份好工作 许多人仍试图自杀"
  },
  {
    "start": 1533.453,
    "end": 1537.051,
    "text": "表面上看来没有合乎逻辑的理由 但"
  },
  {
    "start": 1537.051,
    "end": 1541.099,
    "text": "他们就是如此不开心 他们不想待在这里"
  },
  {
    "start": 1541.805,
    "end": 1545.755,
    "text": "第二波段的灵魂现在大约是年近三十"
  },
  {
    "start": 1545.755,
    "end": 1549.704,
    "text": "和三十多岁 他们普遍说来不太起眼"
  },
  {
    "start": 1549.704,
    "end": 1552.615,
    "text": "人生过得也没有那么辛苦"
  },
  {
    "start": 1552.615,
    "end": 1556.254,
    "text": "他们一般专注在帮助他人 不造业"
  },
  {
    "start": 1556.254,
    "end": 1559.721,
    "text": "他们被描述为天线、信标"
  },
  {
    "start": 1559.721,
    "end": 1563.504,
    "text": "、灯塔、发电机、能量管道"
  },
  {
    "start": 1563.504,
    "end": 1566.989,
    "text": "他们带着能够影响他人的独特能量来到"
  },
  {
    "start": 1566.989,
    "end": 1570.679,
    "text": "地球 他们什么都不用做 只要待在这里"
  },
  {
    "start": 1570.679,
    "end": 1574.604,
    "text": "便能对其他人有很大影响 我被告知"
  },
  {
    "start": 1574.604,
    "end": 1576.451,
    "text": "他们只要走过一个"
  },
  {
    "start": 1576.451,
    "end": 1578.991,
    "text": "拥挤的购物商场或杂货店"
  },
  {
    "start": 1578.991,
    "end": 1582.661,
    "text": "能量就能影响到和他们有接触的"
  },
  {
    "start": 1582.661,
    "end": 1586.593,
    "text": "人 他们的能量是如此强大 当然"
  },
  {
    "start": 1586.593,
    "end": 1590.318,
    "text": "他们自己对此并没有意识 矛盾之处"
  },
  {
    "start": 1590.318,
    "end": 1592.413,
    "text": "在于 他们虽然该用"
  },
  {
    "start": 1592.413,
    "end": 1594.741,
    "text": "自己的能量去影响别人"
  },
  {
    "start": 1594.741,
    "end": 1598.313,
    "text": "但他们在人群里并不是很自在 有"
  },
  {
    "start": 1598.313,
    "end": 1602.599,
    "text": "很多人因此隐居在家 避免与他人打交道"
  },
  {
    "start": 1602.599,
    "end": 1604.692,
    "text": "甚至在家工作"
  },
  {
    "start": 1605.398,
    "end": 1609.058,
    "text": "他们也因此没有实现他们的生命目的"
  },
  {
    "start": 1609.058,
    "end": 1612.947,
    "text": "许多第一和第二波的灵魂不想有小孩"
  },
  {
    "start": 1612.947,
    "end": 1617.635,
    "text": "他们无意识中了解有小孩会产生业 而"
  },
  {
    "start": 1617.635,
    "end": 1622.324,
    "text": "他们不想要有任何事物将自己绑在地球"
  },
  {
    "start": 1622.324,
    "end": 1626.565,
    "text": "他们只想做好工作 然后离开这里 除非"
  },
  {
    "start": 1626.565,
    "end": 1628.921,
    "text": "幸运地找到同一类人"
  },
  {
    "start": 1628.921,
    "end": 1631.277,
    "text": "否则他们大多保持单身"
  },
  {
    "start": 1631.983,
    "end": 1635.258,
    "text": "第三波段的是新小孩 其中"
  },
  {
    "start": 1635.258,
    "end": 1638.805,
    "text": "有许多人现在正值青少年阶段"
  },
  {
    "start": 1638.805,
    "end": 1641.787,
    "text": "他们带着所有必需的知识来到"
  },
  {
    "start": 1641.787,
    "end": 1645.228,
    "text": "地球 这些都在他们的下意识层面"
  },
  {
    "start": 1645.228,
    "end": 1648.352,
    "text": "为了适应新的振动和频率 地球"
  },
  {
    "start": 1648.352,
    "end": 1651.475,
    "text": "上每个人的DNA现在正在改变"
  },
  {
    "start": 1651.475,
    "end": 1655.173,
    "text": "但这些新小孩的基因已经是不同的 被"
  },
  {
    "start": 1655.173,
    "end": 1657.566,
    "text": "调整了 他们已做好前行"
  },
  {
    "start": 1657.566,
    "end": 1659.958,
    "text": "的准备 不会有什么困难"
  },
  {
    "start": 1659.958,
    "end": 1664.112,
    "text": "当然 许多这样的孩子在校都被误解"
  },
  {
    "start": 1664.112,
    "end": 1666.799,
    "text": "令人难过的是必须用药"
  },
  {
    "start": 1666.799,
    "end": 1669.487,
    "text": "一份最近的医疗报告声称"
  },
  {
    "start": 1669.487,
    "end": 1673.53,
    "text": "有一亿个小孩被错误诊断为过动儿"
  },
  {
    "start": 1673.53,
    "end": 1677.573,
    "text": "并因此服用了利他能和其它药物"
  },
  {
    "start": 1677.573,
    "end": 1681.407,
    "text": "这些孩子并没有问题 他们只是更先进"
  },
  {
    "start": 1681.407,
    "end": 1683.111,
    "text": "而且在不同的频率"
  },
  {
    "start": 1683.111,
    "end": 1685.454,
    "text": "运作 因为他们太聪明了"
  },
  {
    "start": 1685.454,
    "end": 1689.107,
    "text": "在学校很容易就觉得无聊 我被告知"
  },
  {
    "start": 1689.107,
    "end": 1692.761,
    "text": "他们需要挑战才能维持对事物的兴趣"
  },
  {
    "start": 1692.761,
    "end": 1697.125,
    "text": "这群孩子被称为【世界的希望】 其中"
  },
  {
    "start": 1697.125,
    "end": 1701.489,
    "text": "有些只有九或十岁 卻已经从大学毕业"
  },
  {
    "start": 1701.489,
    "end": 1704.242,
    "text": "而令人赞叹的是 他们正以"
  },
  {
    "start": 1704.242,
    "end": 1707.225,
    "text": "帮助世界孩童为宗旨成立组织"
  },
  {
    "start": 1707.931,
    "end": 1710.565,
    "text": "有一次 我问【他们】"
  },
  {
    "start": 1710.565,
    "end": 1714.395,
    "text": "为什么第一波的人最辛苦 他们回答"
  },
  {
    "start": 1714.395,
    "end": 1716.882,
    "text": "必须有人担任先锋、"
  },
  {
    "start": 1716.882,
    "end": 1719.921,
    "text": "拓荒者 那个指路的人"
  },
  {
    "start": 1719.921,
    "end": 1722.803,
    "text": "这些人会开创出对后继者"
  },
  {
    "start": 1722.803,
    "end": 1725.684,
    "text": "相对而言较为平坦的道路"
  },
  {
    "start": 1726.39,
    "end": 1730.345,
    "text": "过去几年（2008年到2010年）"
  },
  {
    "start": 1730.345,
    "end": 1732.323,
    "text": "我上过几次拥有广大"
  },
  {
    "start": 1732.323,
    "end": 1734.52,
    "text": "听众的电台节目的访问"
  },
  {
    "start": 1734.52,
    "end": 1737.761,
    "text": "并在和其他广受欢迎的网络节目"
  },
  {
    "start": 1737.761,
    "end": 1741.001,
    "text": "露脸 在对全世界播放的网站上"
  },
  {
    "start": 1741.001,
    "end": 1745.002,
    "text": "我也有自己的电台节目快六年了 每回上"
  },
  {
    "start": 1745.002,
    "end": 1747.003,
    "text": "过这些节目 我收到"
  },
  {
    "start": 1747.003,
    "end": 1749.225,
    "text": "的电子信件和邮件之多"
  },
  {
    "start": 1749.225,
    "end": 1752.538,
    "text": "令人难以置信 每一次在电台接受"
  },
  {
    "start": 1752.538,
    "end": 1756.071,
    "text": "访问后 我的办公室都会被邮件淹没"
  },
  {
    "start": 1756.071,
    "end": 1760.067,
    "text": "我的著作现在也被翻译成二十多种语言"
  },
  {
    "start": 1760.772,
    "end": 1764.567,
    "text": "信件来自世界各地 而且内容都是一样"
  },
  {
    "start": 1764.567,
    "end": 1768.361,
    "text": "的 他们很感谢有这么资讯 来信者说"
  },
  {
    "start": 1768.361,
    "end": 1771.32,
    "text": "他们原以为自己是世上唯一有"
  },
  {
    "start": 1771.32,
    "end": 1774.733,
    "text": "那种不想待在这里的感觉、不了解"
  },
  {
    "start": 1774.733,
    "end": 1777.966,
    "text": "这世界的暴力、想要回【家】、"
  },
  {
    "start": 1777.966,
    "end": 1780.967,
    "text": "认真考虑自杀以求离开的人"
  },
  {
    "start": 1780.967,
    "end": 1783.722,
    "text": "我的资料给了他们极大的帮助"
  },
  {
    "start": 1783.722,
    "end": 1787.535,
    "text": "他们因此知道自己没有疯 也不孤独"
  },
  {
    "start": 1787.535,
    "end": 1790.884,
    "text": "他们是志愿来到地球 帮助"
  },
  {
    "start": 1790.884,
    "end": 1794.512,
    "text": "地球度过危机的许多灵魂之一"
  },
  {
    "start": 1794.512,
    "end": 1797.855,
    "text": "他们只是没有准备好因而这里对"
  },
  {
    "start": 1797.855,
    "end": 1801.197,
    "text": "他们温和的灵魂所造成一定影响"
  },
  {
    "start": 1801.903,
    "end": 1804.782,
    "text": "从这些信件来看 在1940"
  },
  {
    "start": 1804.782,
    "end": 1808.104,
    "text": "年代末和50年代初的第一波之前"
  },
  {
    "start": 1808.104,
    "end": 1809.926,
    "text": "可能已有少数灵魂"
  },
  {
    "start": 1809.926,
    "end": 1812.432,
    "text": "来到地球 他们在信上说"
  },
  {
    "start": 1812.432,
    "end": 1815.666,
    "text": "他们的年纪较大（生于1930年代"
  },
  {
    "start": 1815.666,
    "end": 1819.103,
    "text": "和40年代） 但有第一波的所有表现"
  },
  {
    "start": 1819.103,
    "end": 1823.81,
    "text": "是有可能在1940年代末的第一波"
  },
  {
    "start": 1823.81,
    "end": 1829.105,
    "text": "之前 有些灵魂被派作先锋 我一向相信"
  },
  {
    "start": 1829.105,
    "end": 1833.181,
    "text": "在战争或是死了许多人的大灾难之后"
  },
  {
    "start": 1833.181,
    "end": 1835.235,
    "text": "婴儿出生率的提高是"
  },
  {
    "start": 1835.235,
    "end": 1838.202,
    "text": "大自然更替和调整人口的方式"
  },
  {
    "start": 1838.908,
    "end": 1842.337,
    "text": "但现在另一个理论也能解释战后的"
  },
  {
    "start": 1842.337,
    "end": 1846.453,
    "text": "婴儿潮 那就是其中有很多是【志愿者】"
  },
  {
    "start": 1847.159,
    "end": 1850.342,
    "text": "那些信说的都是同一件事 他们"
  },
  {
    "start": 1850.342,
    "end": 1853.752,
    "text": "非常感谢有这样一个说得通的解释"
  },
  {
    "start": 1853.752,
    "end": 1857.354,
    "text": "甚至有一次在我演说之后 他们走上"
  },
  {
    "start": 1857.354,
    "end": 1861.18,
    "text": "前来 哭着说： 谢谢你 我终于懂了"
  },
  {
    "start": 1861.18,
    "end": 1864.411,
    "text": "虽然他们依然不喜欢地球的暴力"
  },
  {
    "start": 1864.411,
    "end": 1867.858,
    "text": "和振动 现在既已明白自己身负使命"
  },
  {
    "start": 1867.858,
    "end": 1871.003,
    "text": "便决心留在这里完成 他们"
  },
  {
    "start": 1871.003,
    "end": 1874.149,
    "text": "的人生也因此变得大不相同"
  },
  {
    "start": 1874.855,
    "end": 1878.941,
    "text": "我想引用一封2010年的来信 是在"
  },
  {
    "start": 1878.941,
    "end": 1883.267,
    "text": "我上过电视台节目后收到的多封来信之一"
  },
  {
    "start": 1883.267,
    "end": 1886.927,
    "text": "信里写道： 我想向你道谢 谢谢你"
  },
  {
    "start": 1886.927,
    "end": 1890.816,
    "text": "谈到了【三波段】 我生于1961年"
  },
  {
    "start": 1890.816,
    "end": 1894.766,
    "text": "我相信自己是第一波的人 我弟弟小我"
  },
  {
    "start": 1894.766,
    "end": 1897.321,
    "text": "很多岁 生于1980年"
  },
  {
    "start": 1897.321,
    "end": 1899.877,
    "text": "我相信他是第二波的人"
  },
  {
    "start": 1899.877,
    "end": 1903.432,
    "text": "我们讨论这件事很多次了 并且一致"
  },
  {
    "start": 1903.432,
    "end": 1905.21,
    "text": "认为我们事实上是"
  },
  {
    "start": 1905.21,
    "end": 1907.654,
    "text": "外星人 而不是来自地球"
  },
  {
    "start": 1907.654,
    "end": 1911.687,
    "text": "我曾经经验过投生地球前对三波段"
  },
  {
    "start": 1911.687,
    "end": 1916.258,
    "text": "计划会议的极致幻想 非常详尽和有趣"
  },
  {
    "start": 1916.258,
    "end": 1920.112,
    "text": "你可能有兴趣知道 这个计划事实上"
  },
  {
    "start": 1920.112,
    "end": 1924.448,
    "text": "不是第一次进行 只是前一次以失败告终"
  },
  {
    "start": 1924.448,
    "end": 1927.446,
    "text": "原因是志愿者的人数不够多 【"
  },
  {
    "start": 1927.446,
    "end": 1930.444,
    "text": "我们】就是那时决定要打开闸门"
  },
  {
    "start": 1930.444,
    "end": 1934.116,
    "text": "尽可能聚集多一点的高等灵魂 然后【"
  },
  {
    "start": 1934.116,
    "end": 1936.06,
    "text": "暗中布局】 这次"
  },
  {
    "start": 1936.06,
    "end": 1938.221,
    "text": "我想 计划生效了"
  }
]