[
  {
    "start": 0.0,
    "end": 2.287,
    "text": "第六章 台风之眼"
  },
  {
    "start": 2.993,
    "end": 6.945,
    "text": "我是抹大拉的玛利亚 我们是同道之人"
  },
  {
    "start": 6.945,
    "end": 11.13,
    "text": "我与你们同呼吸共命运 是你们的姐妹"
  },
  {
    "start": 11.836,
    "end": 15.697,
    "text": "在这一纷乱的时期 我衷心地问候你们"
  },
  {
    "start": 16.403,
    "end": 20.157,
    "text": "目前  你们正在经历翻天覆地的变化"
  },
  {
    "start": 20.157,
    "end": 23.059,
    "text": "各种各样的问题以及隐含"
  },
  {
    "start": 23.059,
    "end": 26.488,
    "text": "其中的黑暗面向纷纷浮出水面"
  },
  {
    "start": 26.488,
    "end": 29.835,
    "text": "我邀请你们与我一起进入混乱与"
  },
  {
    "start": 29.835,
    "end": 33.899,
    "text": "危机——或许你正身处其中——的中心"
  },
  {
    "start": 33.899,
    "end": 36.39,
    "text": "进入这一充满寂静的中心"
  },
  {
    "start": 36.39,
    "end": 39.108,
    "text": "让我们一起走进台风之眼"
  },
  {
    "start": 39.108,
    "end": 44.828,
    "text": "这里是混乱中绝对安宁与寂静的一处地方"
  },
  {
    "start": 45.534,
    "end": 50.041,
    "text": "身处台风之眼时 虽然活在世间 却不"
  },
  {
    "start": 50.041,
    "end": 54.813,
    "text": "会被周遭社会的狂风卷入其中 所谓狂风"
  },
  {
    "start": 54.813,
    "end": 58.334,
    "text": "指的是那些混乱的情绪能量 如果你"
  },
  {
    "start": 58.334,
    "end": 62.294,
    "text": "没有呵护好自己 对他人的能量极度敞开"
  },
  {
    "start": 62.294,
    "end": 65.808,
    "text": "或者过度帮助他人的时候 就有"
  },
  {
    "start": 65.808,
    "end": 70.074,
    "text": "可能被这些混乱的情绪能量吞没 目前"
  },
  {
    "start": 70.074,
    "end": 74.41,
    "text": "地球实相中四处皆是纷乱不安的能量"
  },
  {
    "start": 74.41,
    "end": 76.961,
    "text": "这是因为人类整体正在"
  },
  {
    "start": 76.961,
    "end": 79.512,
    "text": "经历一个大蜕变的过程"
  },
  {
    "start": 79.512,
    "end": 82.597,
    "text": "除此以外 你们也都处于自己的"
  },
  {
    "start": 82.597,
    "end": 86.122,
    "text": "个人转变过程中 你们是人类的先锋"
  },
  {
    "start": 86.122,
    "end": 88.823,
    "text": "已经有一只脚踏入了一个"
  },
  {
    "start": 88.823,
    "end": 91.523,
    "text": "全新的意识实相 也因此"
  },
  {
    "start": 91.523,
    "end": 94.733,
    "text": "你们更需要不断地回归自己的"
  },
  {
    "start": 94.733,
    "end": 98.436,
    "text": "寂静中心 回到台风之眼 在那里"
  },
  {
    "start": 98.436,
    "end": 101.194,
    "text": "你们能够“存在”与“静观”"
  },
  {
    "start": 101.194,
    "end": 103.36,
    "text": "不会淹没在这一过渡时期"
  },
  {
    "start": 103.36,
    "end": 105.921,
    "text": "所唤起的强烈的情绪能量中"
  },
  {
    "start": 106.627,
    "end": 109.308,
    "text": "在台风之眼 你会找到"
  },
  {
    "start": 109.308,
    "end": 112.525,
    "text": "通往另一个意识实相的门户"
  },
  {
    "start": 112.525,
    "end": 117.597,
    "text": "并由此进入慈悲、寂静与智慧的能量流"
  },
  {
    "start": 117.597,
    "end": 120.133,
    "text": "仿佛远离了日常生活"
  },
  {
    "start": 120.133,
    "end": 122.951,
    "text": "中的忙碌、喧嚣与杂乱"
  },
  {
    "start": 122.951,
    "end": 127.248,
    "text": "不过这只是“仿佛” 因为你其实并未"
  },
  {
    "start": 127.248,
    "end": 129.524,
    "text": "脱离生活 而是带着"
  },
  {
    "start": 129.524,
    "end": 132.304,
    "text": "另一种意识觉知活在其中"
  },
  {
    "start": 132.304,
    "end": 136.537,
    "text": "你以全新的目光看待周遭的一切 不再"
  },
  {
    "start": 136.537,
    "end": 138.528,
    "text": "评判 心怀理解"
  },
  {
    "start": 138.528,
    "end": 142.014,
    "text": "与此同时与它们保持一定的距离"
  },
  {
    "start": 142.014,
    "end": 146.377,
    "text": "当你觉察到他人或自己的情绪波动时 也"
  },
  {
    "start": 146.377,
    "end": 148.559,
    "text": "不再立刻跃身其中"
  },
  {
    "start": 148.559,
    "end": 151.226,
    "text": "试图去照顾、解救或指挥"
  },
  {
    "start": 151.226,
    "end": 155.128,
    "text": "你在生生世世中所积累的智慧使你"
  },
  {
    "start": 155.128,
    "end": 159.03,
    "text": "能够与之保持距离 不再陷入其中"
  },
  {
    "start": 159.03,
    "end": 163.143,
    "text": "目前这一时期正需要你所积累的智慧"
  },
  {
    "start": 163.849,
    "end": 168.066,
    "text": "回忆一下你过去战胜恐惧、黑暗及负面"
  },
  {
    "start": 168.066,
    "end": 170.298,
    "text": "能量的那些时刻 将"
  },
  {
    "start": 170.298,
    "end": 173.274,
    "text": "这些时刻的能量汇聚在一起"
  },
  {
    "start": 173.274,
    "end": 176.704,
    "text": "感受一下你那业已成熟的内在"
  },
  {
    "start": 176.704,
    "end": 180.661,
    "text": "力量 进行深度的腹式呼吸 放松"
  },
  {
    "start": 180.661,
    "end": 184.59,
    "text": "感受你内在那古老的智慧正在汩汩"
  },
  {
    "start": 184.59,
    "end": 188.519,
    "text": "涌动 感受自己那成熟的灵魂能量"
  },
  {
    "start": 188.519,
    "end": 192.247,
    "text": "当你感到痛苦、忧伤或焦虑不安"
  },
  {
    "start": 192.247,
    "end": 195.975,
    "text": "感到旧有的情绪能量正在冲击你时"
  },
  {
    "start": 195.975,
    "end": 200.008,
    "text": "它们有可能在你忘记自己真正是谁的"
  },
  {
    "start": 200.008,
    "end": 202.781,
    "text": "情况下将你吞没 请呼唤"
  },
  {
    "start": 202.781,
    "end": 205.554,
    "text": "自己那成熟、睿智的灵魂"
  },
  {
    "start": 205.554,
    "end": 209.882,
    "text": "接纳这些情绪能量 继续留在台风之眼"
  },
  {
    "start": 209.882,
    "end": 212.77,
    "text": "以历尽沧桑、阅历深广的"
  },
  {
    "start": 212.77,
    "end": 216.183,
    "text": "老妇人的睿智目光看待这一切"
  },
  {
    "start": 216.889,
    "end": 220.011,
    "text": "我并不是随口提起“老妇人”这一"
  },
  {
    "start": 220.011,
    "end": 223.341,
    "text": "形象的 在这一危机重重的过渡时期"
  },
  {
    "start": 223.341,
    "end": 228.265,
    "text": "女性能量恰恰能够牵起你的手 将你带出"
  },
  {
    "start": 228.265,
    "end": 231.0,
    "text": "混乱 成熟的女性能量"
  },
  {
    "start": 231.0,
    "end": 234.009,
    "text": "既富于弹性又具有流动性"
  },
  {
    "start": 234.009,
    "end": 237.245,
    "text": "不会紧抓 死板僵硬的模式不"
  },
  {
    "start": 237.245,
    "end": 240.482,
    "text": "放 也不会与既有体系做斗争"
  },
  {
    "start": 240.482,
    "end": 244.667,
    "text": "女性能量不仅充满了理解与温柔 还"
  },
  {
    "start": 244.667,
    "end": 249.375,
    "text": "具有敢于臣服且毅然不再回头的强大力量"
  },
  {
    "start": 249.375,
    "end": 253.276,
    "text": "这一时期要求人们彻底、决然地放下"
  },
  {
    "start": 253.276,
    "end": 256.23,
    "text": "请不要再将自己的能量聚焦"
  },
  {
    "start": 256.23,
    "end": 259.184,
    "text": "于对抗旧世界或者拯救他人"
  },
  {
    "start": 259.184,
    "end": 262.069,
    "text": "要带着冷静的臣服与寂静"
  },
  {
    "start": 262.069,
    "end": 264.954,
    "text": "的内在觉知专注于新世界"
  },
  {
    "start": 264.954,
    "end": 268.505,
    "text": "你之内这位睿智的女性已经见过、"
  },
  {
    "start": 268.505,
    "end": 272.529,
    "text": "经历过一切 已回到了自己的内在核心"
  },
  {
    "start": 272.529,
    "end": 274.809,
    "text": "她在那里找到了宁静与"
  },
  {
    "start": 274.809,
    "end": 277.772,
    "text": "自由的空间 并借此走入社会"
  },
  {
    "start": 277.772,
    "end": 281.026,
    "text": "如果你于内在找到了这位睿智的"
  },
  {
    "start": 281.026,
    "end": 284.745,
    "text": "女性 也就找到了通往新地球的门户"
  },
  {
    "start": 285.451,
    "end": 288.795,
    "text": "你之内那位睿智的女性深知照顾"
  },
  {
    "start": 288.795,
    "end": 292.378,
    "text": "好自己与照顾好他人同样“灵性”"
  },
  {
    "start": 292.378,
    "end": 295.033,
    "text": "她的“施”与“受”是平衡"
  },
  {
    "start": 295.033,
    "end": 297.91,
    "text": "的 请让自己置身于适合自己"
  },
  {
    "start": 297.91,
    "end": 301.81,
    "text": "与自己相谐的能量、情形与环境之中"
  },
  {
    "start": 301.81,
    "end": 305.71,
    "text": "敢于接受、认真接纳与对待真正的自己"
  },
  {
    "start": 305.71,
    "end": 308.637,
    "text": "敢于闪耀自己的内在智慧"
  },
  {
    "start": 308.637,
    "end": 311.83,
    "text": "且不因此而感到内疚或羞惭"
  },
  {
    "start": 311.83,
    "end": 315.87,
    "text": "不要再一次一次告诫自己必须或应该做"
  },
  {
    "start": 315.87,
    "end": 318.008,
    "text": "什么 让那些旧有的"
  },
  {
    "start": 318.008,
    "end": 320.384,
    "text": "规则与戒条随风而去吧"
  },
  {
    "start": 321.09,
    "end": 324.672,
    "text": "女性能量正是借由 温柔地与新"
  },
  {
    "start": 324.672,
    "end": 328.767,
    "text": "能量同行 而彻底地放下旧有能量的"
  },
  {
    "start": 329.472,
    "end": 333.314,
    "text": "在向新的意识实相过渡的过程中"
  },
  {
    "start": 333.314,
    "end": 337.155,
    "text": "男性能量也扮演着至关重要的角色"
  },
  {
    "start": 337.155,
    "end": 340.348,
    "text": "其起作用的领域在于“辨别”与"
  },
  {
    "start": 340.348,
    "end": 343.769,
    "text": "“界定” 女性能量是联结的能量"
  },
  {
    "start": 343.769,
    "end": 347.418,
    "text": "男性能量则是设定界限的能量 在这一"
  },
  {
    "start": 347.418,
    "end": 349.35,
    "text": "时期 “辨别”与“"
  },
  {
    "start": 349.35,
    "end": 351.496,
    "text": "界定 的能力极其重要"
  },
  {
    "start": 351.496,
    "end": 354.474,
    "text": "这并不是说以富于进攻性"
  },
  {
    "start": 354.474,
    "end": 357.451,
    "text": "或竞争性的形式对待他人"
  },
  {
    "start": 357.451,
    "end": 361.497,
    "text": "而是指明确、有意识地表明自己的立场与"
  },
  {
    "start": 361.497,
    "end": 363.519,
    "text": "界限 为了找到通往"
  },
  {
    "start": 363.519,
    "end": 365.991,
    "text": "基于心灵的新意识的门户"
  },
  {
    "start": 365.991,
    "end": 368.423,
    "text": "你必须能够坚决明确地对"
  },
  {
    "start": 368.423,
    "end": 371.298,
    "text": "那些可能将你拽回旧能量——"
  },
  {
    "start": 371.298,
    "end": 373.646,
    "text": "充满恐惧或抗争的旧有"
  },
  {
    "start": 373.646,
    "end": 376.463,
    "text": "能量——的人或事说“不”"
  },
  {
    "start": 377.169,
    "end": 381.309,
    "text": "现在请观想一下 想象一位智慧的男性"
  },
  {
    "start": 381.309,
    "end": 383.744,
    "text": "长者出现在你的面前"
  },
  {
    "start": 383.744,
    "end": 386.179,
    "text": "你看到了什么 魔术师"
  },
  {
    "start": 386.179,
    "end": 389.507,
    "text": "印第安人还是佛陀 看一看"
  },
  {
    "start": 389.507,
    "end": 393.388,
    "text": "自发出现在你面前的是何种形象"
  },
  {
    "start": 393.388,
    "end": 398.009,
    "text": "看一看他所散发出的坚定能量 他忠于"
  },
  {
    "start": 398.009,
    "end": 400.727,
    "text": "自己心中的真相 敢于"
  },
  {
    "start": 400.727,
    "end": 403.989,
    "text": "特立独行 他是一位领导者"
  },
  {
    "start": 403.989,
    "end": 407.946,
    "text": "而不是跟随者 与此同时 他浑身上下"
  },
  {
    "start": 407.946,
    "end": 410.04,
    "text": "充满了宁静 目光中"
  },
  {
    "start": 410.04,
    "end": 412.368,
    "text": "没有一丝一毫的攻击性"
  },
  {
    "start": 412.368,
    "end": 415.187,
    "text": "这就是没有“小我” 的自我觉知"
  },
  {
    "start": 415.892,
    "end": 419.952,
    "text": "这两位智慧的长者 男性与女性 都在"
  },
  {
    "start": 419.952,
    "end": 424.012,
    "text": "你之内 无论你的肉身是男性还是女性"
  },
  {
    "start": 424.012,
    "end": 427.268,
    "text": "这两个智慧之源都对你敞开"
  },
  {
    "start": 427.974,
    "end": 432.866,
    "text": "轮回于地球的生生世世中 你既做过男性"
  },
  {
    "start": 432.866,
    "end": 435.04,
    "text": "也做过女性 请"
  },
  {
    "start": 435.04,
    "end": 438.03,
    "text": "感受一下你那丰富的过去"
  },
  {
    "start": 438.03,
    "end": 442.77,
    "text": "因着你从多次轮回经历中提炼出的智慧"
  },
  {
    "start": 442.77,
    "end": 447.788,
    "text": "你已经足够成熟 完全能够跨入新地球"
  },
  {
    "start": 447.788,
    "end": 452.002,
    "text": "放下那些来自过去的包袱吧 我邀请"
  },
  {
    "start": 452.002,
    "end": 456.742,
    "text": "你们与我一起观想 一起去新实相中旅行"
  },
  {
    "start": 456.742,
    "end": 459.014,
    "text": "体验一下新实相的能量"
  },
  {
    "start": 459.014,
    "end": 463.104,
    "text": "在自己体内流动的感受 就在此时此刻"
  },
  {
    "start": 463.104,
    "end": 467.044,
    "text": "请将意识缓缓地沉入腹部 在那里"
  },
  {
    "start": 467.044,
    "end": 471.247,
    "text": "找到一个宁静之点 一个开放的空间"
  },
  {
    "start": 471.247,
    "end": 475.384,
    "text": "每一次吸气与呼气 你的呼吸都会"
  },
  {
    "start": 475.384,
    "end": 479.797,
    "text": "轻触这个地方 有时 你会思绪飘动"
  },
  {
    "start": 479.797,
    "end": 483.3,
    "text": "脑中飞满了各种各样的念头 这些"
  },
  {
    "start": 483.3,
    "end": 487.504,
    "text": "念头会消耗你的能量 干扰你 使你分心"
  },
  {
    "start": 487.504,
    "end": 492.602,
    "text": "将你带离腹部的寂静之处 请安住于台风"
  },
  {
    "start": 492.602,
    "end": 495.151,
    "text": "之眼 纵使思绪之流"
  },
  {
    "start": 495.151,
    "end": 497.983,
    "text": "狂舞 你照样如如不动"
  },
  {
    "start": 497.983,
    "end": 501.968,
    "text": "安住于自己的中心 安住于腹部"
  },
  {
    "start": 502.674,
    "end": 505.991,
    "text": "你无须与自己的想法抗争 原因"
  },
  {
    "start": 505.991,
    "end": 509.308,
    "text": "之一是 你借助想法来对抗想法"
  },
  {
    "start": 509.308,
    "end": 512.81,
    "text": "并因此陷入一个没有休止的过程"
  },
  {
    "start": 512.81,
    "end": 516.562,
    "text": "一个简单的办法是：改变关注点"
  },
  {
    "start": 516.562,
    "end": 520.621,
    "text": "“关注”本身并不是念头 而是一个"
  },
  {
    "start": 520.621,
    "end": 522.904,
    "text": "空间 用“关注”来"
  },
  {
    "start": 522.904,
    "end": 525.44,
    "text": "滋育内在的安宁与寂静"
  },
  {
    "start": 525.44,
    "end": 529.145,
    "text": "就能够加强它们 你所滋育的 都"
  },
  {
    "start": 529.145,
    "end": 533.097,
    "text": "会成长 如果你能够享受内在的寂静"
  },
  {
    "start": 533.097,
    "end": 537.269,
    "text": "念头的风暴就会逐渐减弱 你们中的"
  },
  {
    "start": 537.269,
    "end": 539.876,
    "text": "许多人都无法享受寂静"
  },
  {
    "start": 539.876,
    "end": 542.484,
    "text": "反而会觉得无所适从"
  },
  {
    "start": 542.484,
    "end": 546.299,
    "text": "仿佛受到了威胁 你们已经习惯了高速"
  },
  {
    "start": 546.299,
    "end": 548.094,
    "text": "旋转、思绪纷飞的"
  },
  {
    "start": 548.094,
    "end": 550.563,
    "text": "大脑 如果突然不再忙碌"
  },
  {
    "start": 550.563,
    "end": 555.337,
    "text": "就会感到空虚 仿佛坠入了黑洞 然后"
  },
  {
    "start": 555.337,
    "end": 557.725,
    "text": "你很可能会轻而易举"
  },
  {
    "start": 557.725,
    "end": 560.377,
    "text": "地回到忙碌的大脑模式"
  },
  {
    "start": 560.377,
    "end": 563.659,
    "text": "只有当你敢于面对并跨入这一"
  },
  {
    "start": 563.659,
    "end": 566.941,
    "text": "空 的境地 敢于去探索体验空"
  },
  {
    "start": 566.941,
    "end": 570.324,
    "text": "才会从大脑的束缚中解脱出来"
  },
  {
    "start": 571.03,
    "end": 573.969,
    "text": "对于正站在新地球门槛前的你"
  },
  {
    "start": 573.969,
    "end": 577.134,
    "text": "来说 “寂静”具有疗愈的能量"
  },
  {
    "start": 577.134,
    "end": 581.91,
    "text": "能够带给你安宁与解脱感 你渴望内在"
  },
  {
    "start": 581.91,
    "end": 586.968,
    "text": "的宁静 这一渴望正展示了你的界定能力"
  },
  {
    "start": 586.968,
    "end": 590.863,
    "text": "你对这个世界的忙碌与纷乱说“不”"
  },
  {
    "start": 590.863,
    "end": 594.758,
    "text": "并体验到自己对于走入内在的深度渴望"
  },
  {
    "start": 594.758,
    "end": 598.686,
    "text": "如果你跟随这一愿望 回归内在的"
  },
  {
    "start": 598.686,
    "end": 602.875,
    "text": "寂静与智慧 就会将新地球带得更近"
  },
  {
    "start": 602.875,
    "end": 607.08,
    "text": "这并不仅仅是为了你自己 也是为了他人"
  },
  {
    "start": 607.08,
    "end": 611.284,
    "text": "借由顺“安宁、寂静与智慧”之流而行"
  },
  {
    "start": 611.284,
    "end": 614.431,
    "text": "你也会将新地球的能量散射给"
  },
  {
    "start": 614.431,
    "end": 617.821,
    "text": "他人 你无须为此刻意付出努力"
  },
  {
    "start": 617.821,
    "end": 621.868,
    "text": "而是自然而然地为他人提供这一能量"
  },
  {
    "start": 621.868,
    "end": 624.249,
    "text": "你们中的许多人都习惯"
  },
  {
    "start": 624.249,
    "end": 626.868,
    "text": "性地为身受磨难的人担忧"
  },
  {
    "start": 626.868,
    "end": 630.952,
    "text": "比如你的亲密伴侣、家人或者那些身处"
  },
  {
    "start": 630.952,
    "end": 635.035,
    "text": "困境急需帮助的人 而且常常过度付出"
  },
  {
    "start": 635.035,
    "end": 639.556,
    "text": "我的意思是 这消耗了你过多的能量 你"
  },
  {
    "start": 639.556,
    "end": 641.817,
    "text": "因此感到精疲力竭"
  },
  {
    "start": 641.817,
    "end": 644.328,
    "text": "大失所望甚至备感绝望"
  },
  {
    "start": 644.328,
    "end": 647.877,
    "text": "而往往 对方根本无法接受或者"
  },
  {
    "start": 647.877,
    "end": 651.427,
    "text": "只能在很小程度上接受你的给予"
  },
  {
    "start": 651.427,
    "end": 654.169,
    "text": "因为你试图将新的意识觉知"
  },
  {
    "start": 654.169,
    "end": 657.14,
    "text": "带给那些（尚）未准备好的人"
  },
  {
    "start": 657.845,
    "end": 662.103,
    "text": "这一给予方式——亦即消耗并最终耗尽你"
  },
  {
    "start": 662.103,
    "end": 663.996,
    "text": "的能量的方式——"
  },
  {
    "start": 663.996,
    "end": 666.598,
    "text": "并不属于新地球 事实上"
  },
  {
    "start": 666.598,
    "end": 669.472,
    "text": "这是旧有的给予方式 你为了"
  },
  {
    "start": 669.472,
    "end": 673.01,
    "text": "帮助他人而脱离自己的“寂静之处”"
  },
  {
    "start": 673.01,
    "end": 677.288,
    "text": "牺牲与地球的联结以及内在的宁静"
  },
  {
    "start": 677.994,
    "end": 681.988,
    "text": "新的给予方式与此截然不同 你透过"
  },
  {
    "start": 681.988,
    "end": 686.218,
    "text": "存在”或者说“陪伴”来给予 如此这般"
  },
  {
    "start": 686.218,
    "end": 690.538,
    "text": "“忠于他人”与“忠于自己”之间的对立"
  },
  {
    "start": 690.538,
    "end": 694.859,
    "text": "性也如冰雪般融化 借由在台风之眼运作"
  },
  {
    "start": 694.859,
    "end": 698.576,
    "text": "你会成为他人活生生的榜样 向"
  },
  {
    "start": 698.576,
    "end": 702.558,
    "text": "他人展现出内在宁静与智慧的能量"
  },
  {
    "start": 702.558,
    "end": 705.055,
    "text": "至于是否接受你带来的"
  },
  {
    "start": 705.055,
    "end": 707.552,
    "text": "火花则由他们自己决定"
  },
  {
    "start": 708.258,
    "end": 712.115,
    "text": "有时 这给人一种印象 仿佛你不再"
  },
  {
    "start": 712.115,
    "end": 716.214,
    "text": "帮助他人 从某种意义上讲也确实如此"
  },
  {
    "start": 716.214,
    "end": 719.074,
    "text": "你不再为对方负责 不再替"
  },
  {
    "start": 719.074,
    "end": 722.172,
    "text": "他们承受情绪上的负担 然而"
  },
  {
    "start": 722.172,
    "end": 726.223,
    "text": "有效地帮助一个人绝不意味着背负起对方"
  },
  {
    "start": 726.223,
    "end": 728.249,
    "text": "的负担 真正的帮助"
  },
  {
    "start": 728.249,
    "end": 730.5,
    "text": "一个人指的是 唤醒他"
  },
  {
    "start": 730.5,
    "end": 733.958,
    "text": "使其看到自身之光 认知自身的"
  },
  {
    "start": 733.958,
    "end": 738.157,
    "text": "力量  就是说 你时时轻推对方一把"
  },
  {
    "start": 738.157,
    "end": 740.9,
    "text": "这是一种充满爱的鼓励"
  },
  {
    "start": 740.9,
    "end": 744.391,
    "text": "同时也明确地展示了你的独立性"
  },
  {
    "start": 745.097,
    "end": 747.289,
    "text": "“必须帮助他人”或者"
  },
  {
    "start": 747.289,
    "end": 749.482,
    "text": "“必须如何对待他人”"
  },
  {
    "start": 749.482,
    "end": 752.429,
    "text": "诸如此类的感觉与想法是获得"
  },
  {
    "start": 752.429,
    "end": 755.376,
    "text": "内在平静的最大的绊脚石之一"
  },
  {
    "start": 755.376,
    "end": 759.382,
    "text": "你们告诫甚至教会自己必须随时支持或"
  },
  {
    "start": 759.382,
    "end": 761.974,
    "text": "帮助他人 如果回到台风"
  },
  {
    "start": 761.974,
    "end": 764.565,
    "text": "之眼的话 便会感到内疚"
  },
  {
    "start": 764.565,
    "end": 767.347,
    "text": "羁绊你进入台风之眼的最大"
  },
  {
    "start": 767.347,
    "end": 770.823,
    "text": "障碍既非“需要考虑的事情太多”"
  },
  {
    "start": 770.823,
    "end": 771.347,
    "text": "亦非"
  },
  {
    "start": 771.347,
    "end": 774.228,
    "text": "“整日忙得不可开交”"
  },
  {
    "start": 774.228,
    "end": 778.158,
    "text": "而是你不允许自己走入台风之眼"
  },
  {
    "start": 778.158,
    "end": 782.217,
    "text": "你们内心深处蛰伏着一种无价值感 它"
  },
  {
    "start": 782.217,
    "end": 784.367,
    "text": "一直喋喋不休地告诉"
  },
  {
    "start": 784.367,
    "end": 786.755,
    "text": "你 不许违背各种准则"
  },
  {
    "start": 786.755,
    "end": 789.476,
    "text": "不许与众不同 必须要做"
  },
  {
    "start": 789.476,
    "end": 792.939,
    "text": "一个可爱、友善与乐于助人的人"
  },
  {
    "start": 792.939,
    "end": 796.232,
    "text": "必须要不断改变自己以适应社会"
  },
  {
    "start": 796.232,
    "end": 800.622,
    "text": "也因此 你不断地压抑自己“激进”的一面"
  },
  {
    "start": 800.622,
    "end": 802.184,
    "text": "这才是你的问题"
  },
  {
    "start": 802.889,
    "end": 806.865,
    "text": "从出生的那一刻起 你就渴望宁静"
  },
  {
    "start": 806.865,
    "end": 810.841,
    "text": "渴望展示自身的智慧 这是你的天性"
  },
  {
    "start": 810.841,
    "end": 815.273,
    "text": "是你在灵魂层面上早已具备的特质"
  },
  {
    "start": 815.273,
    "end": 818.32,
    "text": "呱呱坠地之时 你就已经"
  },
  {
    "start": 818.32,
    "end": 821.644,
    "text": "成熟 就希望能够走入内在"
  },
  {
    "start": 821.644,
    "end": 825.974,
    "text": "作为一个成熟的灵魂 你已不再着迷于"
  },
  {
    "start": 825.974,
    "end": 828.777,
    "text": "外在世界 你之所以因为"
  },
  {
    "start": 828.777,
    "end": 831.579,
    "text": "过度付出而无法走入内在"
  },
  {
    "start": 831.579,
    "end": 835.874,
    "text": "是因为你没有认识到 我已经很好 如我"
  },
  {
    "start": 835.874,
    "end": 838.26,
    "text": "所是的样子  你试着"
  },
  {
    "start": 838.26,
    "end": 840.885,
    "text": "隐藏自己与众不同的一面"
  },
  {
    "start": 840.885,
    "end": 843.259,
    "text": "将其看作需要严格保守"
  },
  {
    "start": 843.259,
    "end": 845.634,
    "text": "的秘密 不仅是这一世"
  },
  {
    "start": 845.634,
    "end": 849.68,
    "text": "你在若干前世之中也曾经体验到因"
  },
  {
    "start": 849.68,
    "end": 854.537,
    "text": "与众不同而付出的巨大代价 在这一方面"
  },
  {
    "start": 854.537,
    "end": 858.531,
    "text": "你曾经深刻地体验过受拒的感觉 并"
  },
  {
    "start": 858.531,
    "end": 860.528,
    "text": "决定再也不让世人"
  },
  {
    "start": 860.528,
    "end": 863.275,
    "text": "看到自己的不同 也因此"
  },
  {
    "start": 863.275,
    "end": 866.286,
    "text": "你那些敏感、充满同理心的"
  },
  {
    "start": 866.286,
    "end": 872.058,
    "text": "面向逐渐超过了那些激进、创新与针锋相对的面向"
  },
  {
    "start": 872.058,
    "end": 874.178,
    "text": "你不断地压抑自己"
  },
  {
    "start": 874.178,
    "end": 876.534,
    "text": "使自己变得渺小 此外"
  },
  {
    "start": 876.534,
    "end": 880.734,
    "text": "敏感与充满同理心等面向很容易获得外在"
  },
  {
    "start": 880.734,
    "end": 884.933,
    "text": "世界的首肯 因此 你逐渐陷入这一境地"
  },
  {
    "start": 884.933,
    "end": 889.764,
    "text": "开始过度给予 甚至因此失衡 不仅如此"
  },
  {
    "start": 889.764,
    "end": 894.596,
    "text": "你甚至认为依循内心愿望而行 是禁忌"
  },
  {
    "start": 894.596,
    "end": 896.662,
    "text": "绝对不可以付诸实践"
  },
  {
    "start": 896.662,
    "end": 898.958,
    "text": "展现于日常生活之中"
  },
  {
    "start": 899.664,
    "end": 904.155,
    "text": "如今 对于光之工作者而言 至关重要的"
  },
  {
    "start": 904.155,
    "end": 906.401,
    "text": "是认识到自身的失衡"
  },
  {
    "start": 906.401,
    "end": 908.896,
    "text": "并珍惜自己的内在天性"
  },
  {
    "start": 908.896,
    "end": 911.995,
    "text": "要承认并遵从自己内心深处的"
  },
  {
    "start": 911.995,
    "end": 915.809,
    "text": "归家渴望 你们的“家”就在地球上"
  },
  {
    "start": 915.809,
    "end": 920.273,
    "text": "而不在天堂或者某一遥远的次元 借由"
  },
  {
    "start": 920.273,
    "end": 922.899,
    "text": "真正地回归自己 沉入"
  },
  {
    "start": 922.899,
    "end": 926.05,
    "text": "腹部的中心 获得内在宁静"
  },
  {
    "start": 926.05,
    "end": 930.25,
    "text": "你就能够回归家园 台风之眼就是你在"
  },
  {
    "start": 930.25,
    "end": 934.698,
    "text": "地球实相的“家” 你在这里为自己充电"
  },
  {
    "start": 934.698,
    "end": 936.996,
    "text": "忆起自己的真实本性"
  },
  {
    "start": 936.996,
    "end": 939.524,
    "text": "透过不断地进入台风之眼"
  },
  {
    "start": 939.524,
    "end": 942.201,
    "text": "你会自然而然地获得关于"
  },
  {
    "start": 942.201,
    "end": 945.123,
    "text": "自己人生之路的灵感与启迪"
  },
  {
    "start": 945.123,
    "end": 949.233,
    "text": "新地球是你能够完全展示自己的地方"
  },
  {
    "start": 949.233,
    "end": 953.343,
    "text": "正是借由拥抱自己之“与众不同”"
  },
  {
    "start": 953.343,
    "end": 957.005,
    "text": "你将新地球带近自己 也带近他人"
  }
]