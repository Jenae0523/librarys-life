[
  {
    "start": 0.0,
    "end": 3.188,
    "text": "第二章 面对自己的黑暗面"
  },
  {
    "start": 3.894,
    "end": 5.711,
    "text": "我是约书亚 曾是"
  },
  {
    "start": 5.711,
    "end": 8.209,
    "text": "地球上基督意识的承载者"
  },
  {
    "start": 8.915,
    "end": 12.965,
    "text": "我将基督能量带到你们中间 正在"
  },
  {
    "start": 12.965,
    "end": 17.285,
    "text": "阅读这些文字的你深受其触动 如今"
  },
  {
    "start": 17.285,
    "end": 21.549,
    "text": "你与他人一起共同承载着基督能量"
  },
  {
    "start": 22.255,
    "end": 25.263,
    "text": "那么 基督能量是什么样的能量"
  },
  {
    "start": 25.263,
    "end": 28.486,
    "text": "它能为这个世界带来何种不同呢"
  },
  {
    "start": 29.898,
    "end": 33.963,
    "text": "基督能量的出发点是人与人之间的平等"
  },
  {
    "start": 33.963,
    "end": 38.267,
    "text": "与手足之情 一旦这一能量在你心中觉醒"
  },
  {
    "start": 38.267,
    "end": 41.978,
    "text": "你会将他人看作某一整体的一部分"
  },
  {
    "start": 41.978,
    "end": 46.154,
    "text": "真切地意识到人们之间的一体性与平等性"
  },
  {
    "start": 46.154,
    "end": 50.288,
    "text": "能够认知与体验这一点 对你来说"
  },
  {
    "start": 50.288,
    "end": 54.973,
    "text": "意义深重 你的意识会获得极大的扩展"
  },
  {
    "start": 54.973,
    "end": 57.511,
    "text": "能够穿透各种表面上的"
  },
  {
    "start": 57.511,
    "end": 60.511,
    "text": "差异  在他人眼中看到自己"
  },
  {
    "start": 60.511,
    "end": 63.654,
    "text": "你不再评判他人的行为、"
  },
  {
    "start": 63.654,
    "end": 69.081,
    "text": "言语与外表 而是与其本质核心建立联结"
  },
  {
    "start": 69.081,
    "end": 73.078,
    "text": "你们的本质核心本就是彼此相连的"
  },
  {
    "start": 73.078,
    "end": 77.074,
    "text": "借由从自己的核心来观察对方的核心"
  },
  {
    "start": 77.074,
    "end": 82.159,
    "text": "你会将二者同时激活 创造出灵魂层面上"
  },
  {
    "start": 82.159,
    "end": 87.244,
    "text": "的联结 心与心的联结 这就是基督意识"
  },
  {
    "start": 87.95,
    "end": 90.659,
    "text": "基督意识已经进入地球"
  },
  {
    "start": 90.659,
    "end": 93.911,
    "text": "实相 我只是其承载者之一"
  },
  {
    "start": 93.911,
    "end": 98.07,
    "text": "没有任何一个人能够完全承负起基督"
  },
  {
    "start": 98.07,
    "end": 102.23,
    "text": "能量 它远大于我 这是一束意识流"
  },
  {
    "start": 102.23,
    "end": 105.612,
    "text": "向所有想要且能够承载它的人"
  },
  {
    "start": 105.612,
    "end": 108.995,
    "text": "散发着光芒 这是一个能量场"
  },
  {
    "start": 108.995,
    "end": 112.805,
    "text": "由众多开放之心组成的能量场 随着"
  },
  {
    "start": 112.805,
    "end": 116.852,
    "text": "每个人心灵的觉醒 随着你心灵的觉醒"
  },
  {
    "start": 116.852,
    "end": 120.696,
    "text": "这个能量场在地球上的强度与广度都"
  },
  {
    "start": 120.696,
    "end": 124.781,
    "text": "会增加 当你逐渐扩展自己的意识觉知"
  },
  {
    "start": 124.781,
    "end": 128.981,
    "text": "放下各种评判 体验到人们之间的一"
  },
  {
    "start": 128.981,
    "end": 131.344,
    "text": "体性时 这一能量场"
  },
  {
    "start": 131.344,
    "end": 133.969,
    "text": "也会因此而增强 然而"
  },
  {
    "start": 133.969,
    "end": 136.651,
    "text": "放下评判 扩展意识"
  },
  {
    "start": 136.651,
    "end": 139.333,
    "text": "这往往并不会自行发生"
  },
  {
    "start": 140.039,
    "end": 144.412,
    "text": "作为人 你甚至很少意识到自己心中充满"
  },
  {
    "start": 144.412,
    "end": 148.784,
    "text": "评判且处于“分离”的状态 人类社会中"
  },
  {
    "start": 148.784,
    "end": 151.284,
    "text": "一个人的身份往往取决于"
  },
  {
    "start": 151.284,
    "end": 157.418,
    "text": "与他人之间的“差异” 你的地球人格常常以“比别人特殊"
  },
  {
    "start": 157.418,
    "end": 160.736,
    "text": "比他人优异 作为获得认可的"
  },
  {
    "start": 160.736,
    "end": 164.819,
    "text": "标准 而为了真正获得心灵上的觉醒"
  },
  {
    "start": 164.819,
    "end": 167.737,
    "text": "一个人往往需要经历一场危机"
  },
  {
    "start": 167.737,
    "end": 171.698,
    "text": "才能颠覆性地改变自己的思维与行为方式"
  },
  {
    "start": 171.698,
    "end": 175.788,
    "text": "我们可以将此类危机称为 “灵魂暗夜”"
  },
  {
    "start": 176.494,
    "end": 180.394,
    "text": "对他人敞开心灵的程度取决于你对"
  },
  {
    "start": 180.394,
    "end": 184.815,
    "text": "自己有多大的爱心 只有先对自己敞开"
  },
  {
    "start": 184.815,
    "end": 189.045,
    "text": "你才能以一颗开放之心接纳他人"
  },
  {
    "start": 189.045,
    "end": 193.839,
    "text": "对于许多人而言 他们对自己紧闭心扉"
  },
  {
    "start": 193.839,
    "end": 197.811,
    "text": "自身的一部分躲在紧锁的铁笼之内"
  },
  {
    "start": 197.811,
    "end": 202.477,
    "text": "社会习俗、评定善恶的规则以及深度"
  },
  {
    "start": 202.477,
    "end": 207.143,
    "text": "的无价值感则是构成这一铁笼的栏杆"
  },
  {
    "start": 207.143,
    "end": 210.022,
    "text": "这是全体人类所继承的集体"
  },
  {
    "start": 210.022,
    "end": 212.9,
    "text": "遗产 无论其童年幸福与否"
  },
  {
    "start": 212.9,
    "end": 216.538,
    "text": "社会上关于“人类之罪恶”的顽固思想"
  },
  {
    "start": 216.538,
    "end": 218.463,
    "text": "总会对每个正在成长"
  },
  {
    "start": 218.463,
    "end": 220.603,
    "text": "的孩童带来一定的影响"
  },
  {
    "start": 220.603,
    "end": 223.858,
    "text": "这些影响并不仅仅来自他们的生长"
  },
  {
    "start": 223.858,
    "end": 227.113,
    "text": "环境 这也是一个自内而外的过程"
  },
  {
    "start": 227.113,
    "end": 231.833,
    "text": "该灵魂的前世记忆也会在某种程度上影响"
  },
  {
    "start": 231.833,
    "end": 234.194,
    "text": "这一孩童 对于基督"
  },
  {
    "start": 234.194,
    "end": 237.078,
    "text": "意识在地球上的觉醒来说"
  },
  {
    "start": 237.078,
    "end": 240.099,
    "text": "隐藏在你们所有人内在深处的"
  },
  {
    "start": 240.099,
    "end": 243.121,
    "text": "“无价值感”是其最大的阻碍"
  },
  {
    "start": 243.121,
    "end": 245.977,
    "text": "灵魂暗夜则使这些旧有意识"
  },
  {
    "start": 245.977,
    "end": 251.691,
    "text": "的锁链浮出水面 也因此 打破这些锁链才成为可能"
  },
  {
    "start": 252.397,
    "end": 255.118,
    "text": "生活中出现危机时 你会"
  },
  {
    "start": 255.118,
    "end": 258.581,
    "text": "面对内在某些激烈、痛苦的情绪"
  },
  {
    "start": 258.581,
    "end": 262.147,
    "text": "恐惧、愤怒、绝望或忧伤"
  },
  {
    "start": 262.147,
    "end": 266.038,
    "text": "可能会将你掌控 使你失衡"
  },
  {
    "start": 266.038,
    "end": 269.999,
    "text": "你内在是否具备接纳这些情绪的基础呢"
  },
  {
    "start": 269.999,
    "end": 273.96,
    "text": "大多数情况下 你并不具备这一基础"
  },
  {
    "start": 273.96,
    "end": 277.733,
    "text": "并因此真正地陷入危机 你坠入深渊"
  },
  {
    "start": 277.733,
    "end": 279.73,
    "text": "感觉自己无依无靠"
  },
  {
    "start": 279.73,
    "end": 281.949,
    "text": "连一根救命稻草都没有"
  },
  {
    "start": 281.949,
    "end": 284.515,
    "text": "你在深刻的痛苦情绪中"
  },
  {
    "start": 284.515,
    "end": 287.337,
    "text": "挣扎 心中充满了无力感"
  },
  {
    "start": 287.337,
    "end": 290.169,
    "text": "没有任何人和事物能够助你"
  },
  {
    "start": 290.169,
    "end": 293.237,
    "text": "打破这一“自由落体”的状态"
  },
  {
    "start": 293.237,
    "end": 297.546,
    "text": "“无价值感”也会于此时浮出水面"
  },
  {
    "start": 297.546,
    "end": 302.143,
    "text": "它是你缺乏基础的根本原因 这时"
  },
  {
    "start": 302.143,
    "end": 305.646,
    "text": "你也就抵达了黑暗的中心 来到夜色"
  },
  {
    "start": 305.646,
    "end": 309.15,
    "text": "最深处 你几乎无法接受外在的帮助"
  },
  {
    "start": 309.15,
    "end": 310.902,
    "text": "因为你不能接受任何"
  },
  {
    "start": 310.902,
    "end": 312.849,
    "text": "东西 你觉得自己不配"
  },
  {
    "start": 313.555,
    "end": 317.231,
    "text": "建立“自尊自重”的基础 无条件接纳"
  },
  {
    "start": 317.231,
    "end": 319.177,
    "text": "本然的自己 这一切"
  },
  {
    "start": 319.177,
    "end": 321.339,
    "text": "都必须由你自己来完成"
  },
  {
    "start": 321.339,
    "end": 326.098,
    "text": "无人能够替你做这件事 如果你在这方面"
  },
  {
    "start": 326.098,
    "end": 328.477,
    "text": "依赖他人 比如你的"
  },
  {
    "start": 328.477,
    "end": 331.385,
    "text": "父母、朋友、老师或上师"
  },
  {
    "start": 331.385,
    "end": 334.271,
    "text": "这一基础就会如沙中筑塔"
  },
  {
    "start": 334.271,
    "end": 336.196,
    "text": "脆弱不堪 只有你"
  },
  {
    "start": 336.196,
    "end": 339.082,
    "text": "才能为自己打造这一基础"
  },
  {
    "start": 339.082,
    "end": 342.955,
    "text": "我希望能够帮助你迈出这一步 牵着"
  },
  {
    "start": 342.955,
    "end": 347.071,
    "text": "你的手一起前行 不过 我不能逼迫你"
  },
  {
    "start": 347.071,
    "end": 348.454,
    "text": "只能邀请你"
  },
  {
    "start": 349.16,
    "end": 353.556,
    "text": "能够体验与拥抱自身价值的只有你自己"
  },
  {
    "start": 353.556,
    "end": 355.998,
    "text": "只要你以这种方式对待"
  },
  {
    "start": 355.998,
    "end": 358.685,
    "text": "自己 就与我建立了联结"
  },
  {
    "start": 358.685,
    "end": 363.681,
    "text": "与我所带来的能量——基督能量——建立"
  },
  {
    "start": 363.681,
    "end": 366.457,
    "text": "联结 基督能量远大于"
  },
  {
    "start": 366.457,
    "end": 369.511,
    "text": "我 它将你我都涵纳其中"
  },
  {
    "start": 369.511,
    "end": 373.876,
    "text": "基督能量就在你的内在空间的边缘 在"
  },
  {
    "start": 373.876,
    "end": 378.498,
    "text": "那里静静地等待你 它在你之空间的边界"
  },
  {
    "start": 378.498,
    "end": 381.87,
    "text": "在你受困于评判或恐惧的地方"
  },
  {
    "start": 381.87,
    "end": 385.502,
    "text": "等待你 召唤你 它让你看到"
  },
  {
    "start": 385.502,
    "end": 389.244,
    "text": "你完全可以扩展自己的空间 接纳"
  },
  {
    "start": 389.244,
    "end": 393.485,
    "text": "那些自己一直排斥的能量 允许其流入"
  },
  {
    "start": 393.485,
    "end": 397.065,
    "text": "基督能量就在你拒绝排斥、无法"
  },
  {
    "start": 397.065,
    "end": 401.412,
    "text": "接纳生命礼物的各个角落向你发出邀请"
  },
  {
    "start": 402.118,
    "end": 406.489,
    "text": "我是基督能量的信使 向你伸出邀请"
  },
  {
    "start": 406.489,
    "end": 411.133,
    "text": "之手 邀请你走出局限 请拉住我的手"
  },
  {
    "start": 411.839,
    "end": 415.986,
    "text": "想象你正与我一起在沙漠中行走"
  },
  {
    "start": 415.986,
    "end": 420.411,
    "text": "四周空旷无垠 你脚下是广袤的大地"
  },
  {
    "start": 420.411,
    "end": 425.402,
    "text": "头顶是辽阔的蓝天 感受一下大自然的"
  },
  {
    "start": 425.402,
    "end": 428.632,
    "text": "力量 经过长途跋涉 你"
  },
  {
    "start": 428.632,
    "end": 431.862,
    "text": "又累又渴 可是两手空空"
  },
  {
    "start": 431.862,
    "end": 436.628,
    "text": "放眼望去 一片荒芜的空旷 没有任何"
  },
  {
    "start": 436.628,
    "end": 439.151,
    "text": "饮品与食物 恐惧与"
  },
  {
    "start": 439.151,
    "end": 442.516,
    "text": "迷失涌上心头 你两眼茫茫"
  },
  {
    "start": 442.516,
    "end": 446.169,
    "text": "看不到任何明确的路径 你能看到我"
  },
  {
    "start": 446.169,
    "end": 449.822,
    "text": "吗 我也在那里 纵使你并未看到我"
  },
  {
    "start": 449.822,
    "end": 453.748,
    "text": "也请跟随心灵的指引 与我一起寻找"
  },
  {
    "start": 453.748,
    "end": 457.905,
    "text": "我想要带你去一个地方 随着时间的推移"
  },
  {
    "start": 457.905,
    "end": 462.652,
    "text": "夜幕降临 沙漠中漆黑寒冷 现在 请"
  },
  {
    "start": 462.652,
    "end": 467.679,
    "text": "找个地方坐下来 小憩一下 你又累又冷"
  },
  {
    "start": 467.679,
    "end": 472.231,
    "text": "精疲力竭 满眼含泪 你觉得自己已经"
  },
  {
    "start": 472.231,
    "end": 476.783,
    "text": "落入山穷水尽的地步 不知该如何是好"
  },
  {
    "start": 476.783,
    "end": 481.442,
    "text": "你已迷失道路 失去方向 请感受一下我"
  },
  {
    "start": 481.442,
    "end": 486.1,
    "text": "的存在 对我敞开心胸 我身边有一个人"
  },
  {
    "start": 486.1,
    "end": 489.312,
    "text": "他希望你能够看到他 就在这沙漠的"
  },
  {
    "start": 489.312,
    "end": 492.926,
    "text": "深处 这就是你的“阴影” 你的黑暗面"
  },
  {
    "start": 494.338,
    "end": 498.222,
    "text": "（译注：心理学家荣格将每个人都有的、"
  },
  {
    "start": 498.222,
    "end": 499.949,
    "text": "自己不想碰触的"
  },
  {
    "start": 499.949,
    "end": 502.538,
    "text": "黑暗面”称为“阴影” ）"
  },
  {
    "start": 503.95,
    "end": 508.02,
    "text": "你的黑暗面 是你承载恐惧与黑暗情绪"
  },
  {
    "start": 508.02,
    "end": 512.329,
    "text": "的那一部分 你的阴影希望能够获得解脱"
  },
  {
    "start": 512.329,
    "end": 516.476,
    "text": "希望得到你的关注与接纳 希望与你"
  },
  {
    "start": 516.476,
    "end": 520.623,
    "text": "同行 灵魂暗夜将你带向自己的阴影"
  },
  {
    "start": 520.623,
    "end": 524.801,
    "text": "带向你不断压制与抗拒的那一部分 直面"
  },
  {
    "start": 524.801,
    "end": 526.89,
    "text": "自己的阴影使你感到"
  },
  {
    "start": 526.89,
    "end": 529.675,
    "text": "害怕 感觉自己受到了威胁"
  },
  {
    "start": 529.675,
    "end": 533.838,
    "text": "因此我陪伴着你 陪伴在你的身边"
  },
  {
    "start": 534.544,
    "end": 539.3,
    "text": "请继续观想：漆黑的深夜 你独坐在漫漫"
  },
  {
    "start": 539.3,
    "end": 541.942,
    "text": "沙漠之中 感觉黑暗中"
  },
  {
    "start": 541.942,
    "end": 544.849,
    "text": "除你以外还有一个生命体"
  },
  {
    "start": 544.849,
    "end": 548.826,
    "text": "静静地感受其存在 不要害怕 我就"
  },
  {
    "start": 548.826,
    "end": 551.063,
    "text": "陪伴在你的身旁 请"
  },
  {
    "start": 551.063,
    "end": 553.548,
    "text": "这个生命体来到你面前"
  },
  {
    "start": 553.548,
    "end": 557.382,
    "text": "或许你最先看到其目光在黑暗中"
  },
  {
    "start": 557.382,
    "end": 562.038,
    "text": "闪烁 看入他或她的双眼 并提醒自己"
  },
  {
    "start": 562.038,
    "end": 566.568,
    "text": "这一生命体携带着你的痛苦与恐惧 他对"
  },
  {
    "start": 566.568,
    "end": 569.086,
    "text": "你的害怕远超过你对他"
  },
  {
    "start": 569.086,
    "end": 571.603,
    "text": "的害怕程度 长期以来"
  },
  {
    "start": 571.603,
    "end": 575.638,
    "text": "他一直被拒之门外 被迫生活在黑暗"
  },
  {
    "start": 575.638,
    "end": 580.177,
    "text": "之中 你的阴影很是羞怯 不敢轻易现身"
  },
  {
    "start": 580.177,
    "end": 584.382,
    "text": "你必须向其表示你的欢迎 请他走出来"
  },
  {
    "start": 584.382,
    "end": 586.718,
    "text": "走到你的面前 你能够"
  },
  {
    "start": 586.718,
    "end": 589.288,
    "text": "做到这一点 敞开心灵"
  },
  {
    "start": 589.288,
    "end": 593.923,
    "text": "轻声呼唤他 带着慈悲与怜悯之心呼唤"
  },
  {
    "start": 593.923,
    "end": 596.376,
    "text": "这个饱受痛苦、排斥"
  },
  {
    "start": 596.376,
    "end": 599.102,
    "text": "与寂寞之折磨的生命体"
  },
  {
    "start": 599.808,
    "end": 603.623,
    "text": "你的阴影正如一个长期脱离人群"
  },
  {
    "start": 603.623,
    "end": 607.438,
    "text": "、失去温暖与手足之情的流浪者"
  },
  {
    "start": 608.143,
    "end": 612.052,
    "text": "我就在你的身边 在寒冷的暗夜中升起"
  },
  {
    "start": 612.052,
    "end": 614.351,
    "text": "一簇篝火 让我们三人"
  },
  {
    "start": 614.351,
    "end": 617.109,
    "text": "一起围火而坐 握住我的手"
  },
  {
    "start": 617.109,
    "end": 620.685,
    "text": "并将另一只手伸给你的阴影 让"
  },
  {
    "start": 620.685,
    "end": 625.028,
    "text": "我们三个手牵手 围坐一圈 感受一下"
  },
  {
    "start": 625.028,
    "end": 628.85,
    "text": "看看你能否将自己的阴影带入我们之中"
  },
  {
    "start": 628.85,
    "end": 630.762,
    "text": "如果你对其表示欢迎"
  },
  {
    "start": 630.762,
    "end": 632.885,
    "text": "他会一步步地走近你"
  },
  {
    "start": 632.885,
    "end": 637.278,
    "text": "因为他渴望你的接纳 你的开放之心使"
  },
  {
    "start": 637.278,
    "end": 641.928,
    "text": "你们之间的融合成为可能 一旦你接纳他"
  },
  {
    "start": 641.928,
    "end": 645.862,
    "text": "接纳这一流浪者 这一无家可归之人"
  },
  {
    "start": 645.862,
    "end": 649.796,
    "text": "就会有神奇的事情发生：回归自己"
  },
  {
    "start": 649.796,
    "end": 651.791,
    "text": "回归自己的家园"
  },
  {
    "start": 652.497,
    "end": 655.961,
    "text": "让能量在我们三个之间流动 我"
  },
  {
    "start": 655.961,
    "end": 659.672,
    "text": "正陪伴着你 保护你 带给你慰藉"
  },
  {
    "start": 659.672,
    "end": 662.441,
    "text": "我在你们之间架起桥梁 我"
  },
  {
    "start": 662.441,
    "end": 667.517,
    "text": "并不是你外在世界的人、事或物 我就在你之内"
  },
  {
    "start": 667.517,
    "end": 671.522,
    "text": "让这一能量静静地在我们之间流动 使"
  },
  {
    "start": 671.522,
    "end": 673.407,
    "text": "我们融合在一起"
  },
  {
    "start": 673.407,
    "end": 676.0,
    "text": "一旦你与自己的阴影和解"
  },
  {
    "start": 676.0,
    "end": 679.716,
    "text": "就会变得完整 脚踏实地地生活在"
  },
  {
    "start": 679.716,
    "end": 683.928,
    "text": "地球实相中 以开放之心对待一切生命"
  },
  {
    "start": 683.928,
    "end": 688.094,
    "text": "你的心中会有爱自己的空间 而且你"
  },
  {
    "start": 688.094,
    "end": 692.26,
    "text": "能够与他人分享这一空间 基督能量"
  },
  {
    "start": 692.26,
    "end": 694.308,
    "text": "由此在地球上闪耀"
  }
]