[
  {
    "start": 0.0,
    "end": 3.807,
    "text": "-第十七章 光之工作者的助人之道."
  },
  {
    "start": 4.5120000000000005,
    "end": 7.666,
    "text": "我是约书亚 今天在这里问候你们"
  },
  {
    "start": 7.666,
    "end": 11.029,
    "text": "所有人 在我的心中 我们近在咫尺"
  },
  {
    "start": 11.029,
    "end": 13.424,
    "text": "我们深度地联结在一起"
  },
  {
    "start": 13.424,
    "end": 16.036,
    "text": "在某一层面上我们本是一体"
  },
  {
    "start": 16.036,
    "end": 18.975,
    "text": "一切万有——将我们联合"
  },
  {
    "start": 18.975,
    "end": 22.448,
    "text": "在一起的那个无法分割的意识"
  },
  {
    "start": 22.448,
    "end": 23.981,
    "text": "是一种自由、"
  },
  {
    "start": 23.981,
    "end": 26.792,
    "text": "创造、友善和喜悦的能量"
  },
  {
    "start": 26.792,
    "end": 30.114,
    "text": "它是你们真正的起源和家"
  },
  {
    "start": 30.114,
    "end": 34.112,
    "text": "你们现在彰显为肉身的形式 身处时空的"
  },
  {
    "start": 34.112,
    "end": 36.332,
    "text": "次元中 然而真正的你"
  },
  {
    "start": 36.332,
    "end": 38.775,
    "text": "远大于这个“肉身的你”"
  },
  {
    "start": 38.775,
    "end": 43.529,
    "text": "现在 请感受这一伟大、无限的意识——"
  },
  {
    "start": 43.529,
    "end": 48.283,
    "text": "你们是它的一部分 请感受你内在的神性"
  },
  {
    "start": 48.283,
    "end": 52.609,
    "text": "感受这一能量是如此的纯洁 上帝并非"
  },
  {
    "start": 52.609,
    "end": 54.899,
    "text": "高高在上地站在某一"
  },
  {
    "start": 54.899,
    "end": 57.953,
    "text": "等级制度的顶端低头俯视你"
  },
  {
    "start": 57.953,
    "end": 61.707,
    "text": "它是流经一切万物的能量之流："
  },
  {
    "start": 61.707,
    "end": 65.73,
    "text": "流经你们 流经地球上所有的生灵"
  },
  {
    "start": 65.73,
    "end": 69.589,
    "text": "甚至流经那些在你们的物质环境中"
  },
  {
    "start": 69.589,
    "end": 73.705,
    "text": "看似没有生命的物体 上帝无处不在"
  },
  {
    "start": 74.411,
    "end": 79.136,
    "text": "上帝并不受限于形相 它是纯洁、创造性"
  },
  {
    "start": 79.136,
    "end": 81.499,
    "text": "的意识 它与时空中"
  },
  {
    "start": 81.499,
    "end": 84.124,
    "text": "的物质形相联结在一起"
  },
  {
    "start": 84.124,
    "end": 87.945,
    "text": "从而以各种各样的形式体验生命"
  },
  {
    "start": 87.945,
    "end": 90.201,
    "text": "现在请感受身处这一"
  },
  {
    "start": 90.201,
    "end": 93.21,
    "text": "伟大神圣的能量之流中的你"
  },
  {
    "start": 93.21,
    "end": 95.668,
    "text": "浩瀚的意识海洋中一道"
  },
  {
    "start": 95.668,
    "end": 98.618,
    "text": "耀眼的光芒——它坚不可摧"
  },
  {
    "start": 98.618,
    "end": 103.581,
    "text": "为宇宙整体做出其独一无二的贡献 请"
  },
  {
    "start": 103.581,
    "end": 105.332,
    "text": "感受你内在那"
  },
  {
    "start": 105.332,
    "end": 109.128,
    "text": "坚不可摧的力量 它永远存在"
  },
  {
    "start": 109.128,
    "end": 112.827,
    "text": "从不会消失 你本是上帝的一部分"
  },
  {
    "start": 113.533,
    "end": 117.036,
    "text": "你们的意识充满了神圣的创造性"
  },
  {
    "start": 117.036,
    "end": 121.239,
    "text": "你们自己选择自己的人生之路和人生经历"
  },
  {
    "start": 121.239,
    "end": 124.787,
    "text": "尽管作为人类你可能觉得并非如此"
  },
  {
    "start": 124.787,
    "end": 128.334,
    "text": "你的内在深处却有着一个创造力"
  },
  {
    "start": 128.334,
    "end": 132.002,
    "text": "它设计、决定你在人生中的一些"
  },
  {
    "start": 132.002,
    "end": 135.931,
    "text": "关键事件并吸引你内心希望的经验"
  },
  {
    "start": 135.931,
    "end": 140.531,
    "text": "从而使你能够理解、成长和扩展 关键是"
  },
  {
    "start": 140.531,
    "end": 142.83,
    "text": "你们从未、也永远"
  },
  {
    "start": 142.83,
    "end": 145.641,
    "text": "不会是这个世界的受害者"
  },
  {
    "start": 145.641,
    "end": 149.116,
    "text": "在“真正的你”的核心 你从未"
  },
  {
    "start": 149.116,
    "end": 152.84,
    "text": "、也永远不会是无力或心力交瘁的"
  },
  {
    "start": 152.84,
    "end": 156.044,
    "text": "因为你那内在核心中的神性火花"
  },
  {
    "start": 156.044,
    "end": 159.706,
    "text": "全然接受“肉身的你”所遭遇的一切"
  },
  {
    "start": 159.706,
    "end": 164.396,
    "text": "它知道你能够从各种经历中成长和学习"
  },
  {
    "start": 164.396,
    "end": 169.362,
    "text": "你的意识也会因此变得更宽广、更慈悲"
  },
  {
    "start": 170.068,
    "end": 173.474,
    "text": "请拥抱这一内在的创造力 它将"
  },
  {
    "start": 173.474,
    "end": 176.88,
    "text": "你目前的经验吸引到你的生活中"
  },
  {
    "start": 176.88,
    "end": 181.042,
    "text": "请拥抱你的整个人生——即使它充满了"
  },
  {
    "start": 181.042,
    "end": 183.49,
    "text": "波折和动荡 你完全有"
  },
  {
    "start": 183.49,
    "end": 185.938,
    "text": "力量好好地度过这一生"
  },
  {
    "start": 185.938,
    "end": 188.271,
    "text": "你最伟大的成就就是："
  },
  {
    "start": 188.271,
    "end": 194.802,
    "text": "尽管寄居于肉身中——不得不应对地球生活的各种要求和挑战"
  },
  {
    "start": 194.802,
    "end": 197.502,
    "text": "却能够忆起自己的真正本质"
  },
  {
    "start": 197.502,
    "end": 200.203,
    "text": "借由忆起“真正的自己”"
  },
  {
    "start": 200.203,
    "end": 202.785,
    "text": "你就使那神性火花与"
  },
  {
    "start": 202.785,
    "end": 206.229,
    "text": "肉身的你建立起全然的联结"
  },
  {
    "start": 206.229,
    "end": 209.256,
    "text": "臣服于这一无限、充满创造性"
  },
  {
    "start": 209.256,
    "end": 212.517,
    "text": "的内在火花 就会改变你的生活"
  },
  {
    "start": 212.517,
    "end": 216.052,
    "text": "与此同时也会改变他人的生活"
  },
  {
    "start": 216.758,
    "end": 219.441,
    "text": "正在阅读这些文字的你们"
  },
  {
    "start": 219.441,
    "end": 222.572,
    "text": "以及感到被基督能量吸引的你们"
  },
  {
    "start": 222.572,
    "end": 226.95,
    "text": "渴望将内在之光闪耀于这个世界中"
  },
  {
    "start": 226.95,
    "end": 230.304,
    "text": "你们渴望彰显为一个光之工作者"
  },
  {
    "start": 230.304,
    "end": 232.699,
    "text": "——这意味着你感受到"
  },
  {
    "start": 232.699,
    "end": 235.574,
    "text": "内心的渴望 渴望传播光"
  },
  {
    "start": 235.574,
    "end": 239.751,
    "text": "渴望提高地球的集体意识 你的热情既"
  },
  {
    "start": 239.751,
    "end": 244.175,
    "text": "单纯又真实 它来自“真正的你”的核心"
  },
  {
    "start": 244.175,
    "end": 246.799,
    "text": "来自你的灵魂 你的内在"
  },
  {
    "start": 246.799,
    "end": 249.901,
    "text": "神性火花使你感受到这一渴望"
  },
  {
    "start": 249.901,
    "end": 251.534,
    "text": "因为分享喜悦、"
  },
  {
    "start": 251.534,
    "end": 254.8,
    "text": "光和慈悲正是上帝的本性愿望"
  },
  {
    "start": 254.8,
    "end": 258.999,
    "text": "每当你因表达真正的自己而感到幸福时"
  },
  {
    "start": 258.999,
    "end": 262.375,
    "text": "你就在感受上帝的幸福 因为在"
  },
  {
    "start": 262.375,
    "end": 265.75,
    "text": "心灵层面上 你与上帝本是一体"
  },
  {
    "start": 266.456,
    "end": 270.055,
    "text": "你们经常会问：光之工作真正意味着"
  },
  {
    "start": 270.055,
    "end": 271.854,
    "text": "什么 传播光或者"
  },
  {
    "start": 271.854,
    "end": 274.327,
    "text": "疗愈他人到底是什么意思"
  },
  {
    "start": 274.327,
    "end": 276.999,
    "text": "今天我要讨论的就是这个问题"
  },
  {
    "start": 277.705,
    "end": 280.384,
    "text": "首先 我们需要先仔细"
  },
  {
    "start": 280.384,
    "end": 284.403,
    "text": "看一看助人者与被助者之间的关系"
  },
  {
    "start": 284.403,
    "end": 287.151,
    "text": "我想指出一点：你们的"
  },
  {
    "start": 287.151,
    "end": 290.175,
    "text": "社会对于“健康与疾病”"
  },
  {
    "start": 290.175,
    "end": 292.468,
    "text": "或“健全与不健全”的"
  },
  {
    "start": 292.468,
    "end": 294.762,
    "text": "辨别存在着一定的问题"
  },
  {
    "start": 295.467,
    "end": 298.63,
    "text": "当你因病去看医生时 你是一个"
  },
  {
    "start": 298.63,
    "end": 302.004,
    "text": "需要治疗的病人  在你和他人眼中"
  },
  {
    "start": 302.004,
    "end": 306.011,
    "text": "医生拥有你所没有的知识 他们是专家"
  },
  {
    "start": 306.011,
    "end": 308.014,
    "text": "你很容易感到自己的"
  },
  {
    "start": 308.014,
    "end": 310.685,
    "text": "健康完全掌握在他们的手中"
  },
  {
    "start": 310.685,
    "end": 314.364,
    "text": "这同样适用于精神或情感上的“疾病”"
  },
  {
    "start": 315.07,
    "end": 317.571,
    "text": "当人们造访心理咨询师"
  },
  {
    "start": 317.571,
    "end": 320.071,
    "text": "、心理医生或灵疗者时"
  },
  {
    "start": 320.071,
    "end": 323.469,
    "text": "他们已在心中假设这些专家拥有"
  },
  {
    "start": 323.469,
    "end": 327.596,
    "text": "更高的智慧或技能来帮助他们解决问题"
  },
  {
    "start": 327.596,
    "end": 330.86,
    "text": "对“患者与医生”或“客户与咨询"
  },
  {
    "start": 330.86,
    "end": 334.341,
    "text": "师 之间关系的定义 在某种程度上"
  },
  {
    "start": 334.341,
    "end": 338.062,
    "text": "同时影响着参与双方的自我觉知"
  },
  {
    "start": 338.767,
    "end": 341.884,
    "text": "通过限定双方之间的关系——"
  },
  {
    "start": 341.884,
    "end": 345.479,
    "text": "其中一方比另一方更有知识和洞见"
  },
  {
    "start": 345.479,
    "end": 348.295,
    "text": "暗示了客户需要从心理师"
  },
  {
    "start": 348.295,
    "end": 351.111,
    "text": "、灵疗者或医生那里获得"
  },
  {
    "start": 351.111,
    "end": 353.194,
    "text": "一些他们自己所缺乏——"
  },
  {
    "start": 353.194,
    "end": 355.655,
    "text": "或者无法给予自己——的东西"
  },
  {
    "start": 355.655,
    "end": 360.325,
    "text": "心理师被假定为完整和健康的 他们为"
  },
  {
    "start": 360.325,
    "end": 363.072,
    "text": "患病或不健全的人提供"
  },
  {
    "start": 363.072,
    "end": 366.368,
    "text": "光和疗愈 从这一观点上看"
  },
  {
    "start": 366.368,
    "end": 369.912,
    "text": "心理师或灵疗者比患者更进步"
  },
  {
    "start": 369.912,
    "end": 374.216,
    "text": "他们拥有一些他人所缺乏的知识或能力"
  },
  {
    "start": 374.216,
    "end": 376.157,
    "text": "并以此帮助他人"
  },
  {
    "start": 376.863,
    "end": 382.239,
    "text": "从灵性角度上看 这一观点既虚妄又扭曲"
  },
  {
    "start": 382.239,
    "end": 387.615,
    "text": "它在出发点上便将你们引入歧途 然而"
  },
  {
    "start": 387.615,
    "end": 391.75,
    "text": "它却深深地渗入你们的社会 无论是在"
  },
  {
    "start": 391.75,
    "end": 394.183,
    "text": "身体还是精神健康领域"
  },
  {
    "start": 394.183,
    "end": 396.616,
    "text": "你可以稍微留心一下"
  },
  {
    "start": 396.616,
    "end": 398.603,
    "text": "你如何轻易地就觉得"
  },
  {
    "start": 398.603,
    "end": 401.253,
    "text": "自己比你所造访的专家渺小"
  },
  {
    "start": 401.253,
    "end": 404.867,
    "text": "无论你是为了获得医药还是灵性方面的"
  },
  {
    "start": 404.867,
    "end": 407.205,
    "text": "建议 你是有问题的人"
  },
  {
    "start": 407.205,
    "end": 409.544,
    "text": "他们拥有解决问题的方法"
  },
  {
    "start": 409.544,
    "end": 412.131,
    "text": "对于那些以助人为业的人"
  },
  {
    "start": 412.131,
    "end": 416.179,
    "text": "一个普遍的陷阱就是：他们将自己等同于"
  },
  {
    "start": 416.179,
    "end": 418.429,
    "text": "自己所扮演的助人角色"
  },
  {
    "start": 418.429,
    "end": 420.678,
    "text": "且无法放下这一角色"
  },
  {
    "start": 420.678,
    "end": 423.467,
    "text": "他们以这个角色来定义自己"
  },
  {
    "start": 423.467,
    "end": 426.257,
    "text": "这使得他们依赖于客户或病人"
  },
  {
    "start": 426.257,
    "end": 431.426,
    "text": "就像客户或病人依赖他们一样 那些客户"
  },
  {
    "start": 431.426,
    "end": 436.595,
    "text": "可能觉得需要有人帮助、治疗或疗愈他们"
  },
  {
    "start": 436.595,
    "end": 440.23,
    "text": "而这些助人者也同样需要这些客户"
  },
  {
    "start": 440.23,
    "end": 443.864,
    "text": "以维持他们助人者的形象：有知识"
  },
  {
    "start": 443.864,
    "end": 446.578,
    "text": "愿意与需要之人分享成就的"
  },
  {
    "start": 446.578,
    "end": 449.291,
    "text": "更伟大的人 在这种情况下"
  },
  {
    "start": 449.291,
    "end": 451.651,
    "text": "很容易产生以权力和"
  },
  {
    "start": 451.651,
    "end": 454.534,
    "text": "依赖为中心的不平衡关系"
  },
  {
    "start": 455.24,
    "end": 458.737,
    "text": "光之工作与此截然不同 为了"
  },
  {
    "start": 458.737,
    "end": 463.041,
    "text": "理解光之工作或灵性疗愈的真正内涵"
  },
  {
    "start": 463.041,
    "end": 466.737,
    "text": "你需要放下类似“心理师帮助客户”或"
  },
  {
    "start": 466.737,
    "end": 470.651,
    "text": "“医生治疗病人”的传统观念 需要放下"
  },
  {
    "start": 470.651,
    "end": 474.944,
    "text": "助人就是给予他人所需要的东西这一观念"
  },
  {
    "start": 474.944,
    "end": 477.09,
    "text": "“他人有所缺乏”"
  },
  {
    "start": 477.09,
    "end": 479.713,
    "text": "这个想法对疗愈有害无益"
  },
  {
    "start": 479.713,
    "end": 483.079,
    "text": "事实上 助人的唯一方式就是使"
  },
  {
    "start": 483.079,
    "end": 487.167,
    "text": "他人看到自身所拥有的疗愈力量和能力"
  },
  {
    "start": 487.167,
    "end": 491.583,
    "text": "好导师的标志是：他们使自己变得渺小"
  },
  {
    "start": 491.583,
    "end": 493.921,
    "text": "而不是伟大 真正的"
  },
  {
    "start": 493.921,
    "end": 497.038,
    "text": "导师邀请你唤回内在的力量"
  },
  {
    "start": 497.038,
    "end": 501.237,
    "text": "他们不会认为你是渺小的 需要他人且"
  },
  {
    "start": 501.237,
    "end": 503.707,
    "text": "无法独立 真正的导师"
  },
  {
    "start": 503.707,
    "end": 506.177,
    "text": "从不将自己粉饰成权威"
  },
  {
    "start": 506.177,
    "end": 510.108,
    "text": "这样做是愚蠢的 一个疗愈者的"
  },
  {
    "start": 510.108,
    "end": 514.881,
    "text": "真正礼物是：使他人觉知其内在的权威"
  },
  {
    "start": 514.881,
    "end": 518.351,
    "text": "并使他人认识到他们是神性的火花"
  },
  {
    "start": 518.351,
    "end": 521.821,
    "text": "拥有他们所需要的一切知识和智慧"
  },
  {
    "start": 522.527,
    "end": 525.215,
    "text": "真正的疗愈很简单 无需"
  },
  {
    "start": 525.215,
    "end": 528.146,
    "text": "任何复杂深奥的方法或知识"
  },
  {
    "start": 528.146,
    "end": 530.732,
    "text": "我这里所说的疗愈指的是"
  },
  {
    "start": 530.732,
    "end": 533.318,
    "text": "灵魂层面上的疗愈 当然"
  },
  {
    "start": 533.318,
    "end": 536.597,
    "text": "身体上的问题或许需要那些具有"
  },
  {
    "start": 536.597,
    "end": 540.813,
    "text": "专业知识和技能的医疗专家来参与 然而"
  },
  {
    "start": 540.813,
    "end": 544.665,
    "text": "对灵魂的疗愈是很简单的 如果"
  },
  {
    "start": 544.665,
    "end": 549.067,
    "text": "深入探寻身体或精神问题的本源核心"
  },
  {
    "start": 549.067,
    "end": 552.393,
    "text": "我们就会看到那些 感到无力又无助"
  },
  {
    "start": 552.393,
    "end": 555.718,
    "text": "认为自己毫无存在价值、不值得爱"
  },
  {
    "start": 555.718,
    "end": 558.141,
    "text": "孤独以及宿命 等信念"
  },
  {
    "start": 558.847,
    "end": 563.036,
    "text": "其根本原因在于：人们感到与他们的神圣"
  },
  {
    "start": 563.036,
    "end": 565.13,
    "text": "本质——他们所是的"
  },
  {
    "start": 565.13,
    "end": 567.69,
    "text": "神性火花——失去了联结"
  },
  {
    "start": 567.69,
    "end": 569.577,
    "text": "为他人提供疗愈就是"
  },
  {
    "start": 569.577,
    "end": 572.513,
    "text": "重新开启他们对“家”的回忆"
  },
  {
    "start": 572.513,
    "end": 574.618,
    "text": "帮助他们重新看到"
  },
  {
    "start": 574.618,
    "end": 577.513,
    "text": "自己的完美、坚强和纯洁"
  },
  {
    "start": 578.219,
    "end": 581.871,
    "text": "如何做到这一点呢 首先 并不存在"
  },
  {
    "start": 581.871,
    "end": 583.925,
    "text": "固定的方法或药物"
  },
  {
    "start": 583.925,
    "end": 586.208,
    "text": "这并非机械的治疗过程"
  },
  {
    "start": 586.208,
    "end": 590.238,
    "text": "而是一种可以以各种方式进行的能量"
  },
  {
    "start": 590.238,
    "end": 594.521,
    "text": "传输 后面我会详细讨论这一点 其次"
  },
  {
    "start": 594.521,
    "end": 598.664,
    "text": "只有对此持开放的态度 疗愈才会实现"
  },
  {
    "start": 599.37,
    "end": 602.112,
    "text": "你不能强迫他人接受疗愈"
  },
  {
    "start": 602.112,
    "end": 605.083,
    "text": "这得由他们自己决定 事实上"
  },
  {
    "start": 605.083,
    "end": 609.606,
    "text": "真正的疗愈是一种奇迹：新的意识在灵魂"
  },
  {
    "start": 609.606,
    "end": 612.119,
    "text": "中诞生 这是他人自己"
  },
  {
    "start": 612.119,
    "end": 614.884,
    "text": "的创造 无法预测与预定"
  },
  {
    "start": 614.884,
    "end": 617.017,
    "text": "每个人在一生中都会有"
  },
  {
    "start": 617.017,
    "end": 620.314,
    "text": "需要在光明与黑暗之间抉择 的时刻"
  },
  {
    "start": 620.314,
    "end": 623.443,
    "text": "黑暗意味着：屈服于自我评判"
  },
  {
    "start": 623.443,
    "end": 626.572,
    "text": "、自我怨恨、负面想法和恐惧"
  },
  {
    "start": 626.572,
    "end": 631.339,
    "text": "光明则意味着：对善良、宽恕、喜悦"
  },
  {
    "start": 631.339,
    "end": 636.403,
    "text": "和丰盛敞开心灵 它们都是神性的象征"
  },
  {
    "start": 636.403,
    "end": 640.245,
    "text": "做何选择由你自己全权决定 即使"
  },
  {
    "start": 640.245,
    "end": 644.856,
    "text": "宇宙中最美丽的天使正在召唤你放下过去"
  },
  {
    "start": 644.856,
    "end": 649.197,
    "text": "进入神的国度——这意味着与你所是"
  },
  {
    "start": 649.197,
    "end": 653.81,
    "text": "的神性火花合一 决定权却在你的手中"
  },
  {
    "start": 653.81,
    "end": 658.153,
    "text": "如果你依然深深地沉浸在对自己或他人的"
  },
  {
    "start": 658.153,
    "end": 660.566,
    "text": "负面想法之中 依然活"
  },
  {
    "start": 660.566,
    "end": 663.22,
    "text": "在恐惧和愤怒的奴役之下"
  },
  {
    "start": 663.22,
    "end": 666.683,
    "text": "你或许甚至不会注意到这一天使的"
  },
  {
    "start": 666.683,
    "end": 670.607,
    "text": "存在 事实上 疗愈天使一直在你身边"
  },
  {
    "start": 670.607,
    "end": 673.851,
    "text": "那是你的“高我”或“真我”——"
  },
  {
    "start": 673.851,
    "end": 678.824,
    "text": "你的神圣本性 它正试图帮你看到“你真正是谁”"
  },
  {
    "start": 678.824,
    "end": 682.14,
    "text": "有时 在你的人生中 你会遇到"
  },
  {
    "start": 682.14,
    "end": 685.455,
    "text": "一些暂时扮演疗愈天使角色的人"
  },
  {
    "start": 685.455,
    "end": 688.242,
    "text": "他们或许并未意识到这一点"
  },
  {
    "start": 688.242,
    "end": 691.243,
    "text": "但他们使你忆起“真正的自己”"
  },
  {
    "start": 691.243,
    "end": 695.162,
    "text": "因着他们聆听或交谈的方式  真我的"
  },
  {
    "start": 695.162,
    "end": 699.312,
    "text": "火花 忽然进入你的觉知 与他们相处后"
  },
  {
    "start": 699.312,
    "end": 703.135,
    "text": "你感受到无尽的喜悦 涌出无数"
  },
  {
    "start": 703.135,
    "end": 706.958,
    "text": "灵感 这或许会激励你去选择光"
  },
  {
    "start": 706.958,
    "end": 710.076,
    "text": "做出服务于你之“高我”的"
  },
  {
    "start": 710.076,
    "end": 713.973,
    "text": "决定 以及你真正的生命热忱和爱"
  },
  {
    "start": 713.973,
    "end": 717.258,
    "text": "这种天使的出现或许是一个提醒"
  },
  {
    "start": 717.258,
    "end": 720.762,
    "text": "抑或是你改变人生的关键 尽管如此"
  },
  {
    "start": 720.762,
    "end": 724.326,
    "text": "是否信任并因信念而行 却"
  },
  {
    "start": 724.326,
    "end": 728.781,
    "text": "由你决定 只有你才会使奇迹发生"
  },
  {
    "start": 729.487,
    "end": 733.952,
    "text": "或许你在生活中曾遭遇到过疗愈天使"
  },
  {
    "start": 733.952,
    "end": 737.205,
    "text": "也或许你曾经在不同情况下做过"
  },
  {
    "start": 737.205,
    "end": 740.923,
    "text": "他人的疗愈天使——即使你并未察觉"
  },
  {
    "start": 740.923,
    "end": 744.869,
    "text": "我想说的是：这就是光之工作的真正"
  },
  {
    "start": 744.869,
    "end": 749.308,
    "text": "含义 光之工作不是治疗或“修复”他人"
  },
  {
    "start": 749.308,
    "end": 752.425,
    "text": "不是解决他人的问题 也不是"
  },
  {
    "start": 752.425,
    "end": 756.262,
    "text": "教会他人某些技能、知识或道德规范"
  },
  {
    "start": 756.262,
    "end": 759.91,
    "text": "所有这些行为都是以 他人有一定的"
  },
  {
    "start": 759.91,
    "end": 763.558,
    "text": "不足 他人渺小无助 的假设为前提"
  },
  {
    "start": 763.558,
    "end": 767.648,
    "text": "灵性疗愈彻底颠覆了传统的疗愈观念"
  },
  {
    "start": 767.648,
    "end": 770.312,
    "text": "一个提供灵性疗愈的人所能"
  },
  {
    "start": 770.312,
    "end": 773.643,
    "text": "带给他人的其实是：看法上的改变"
  },
  {
    "start": 773.643,
    "end": 776.947,
    "text": "你需要关注的是他人的内在本质"
  },
  {
    "start": 776.947,
    "end": 780.25,
    "text": "以及他们的完整性和耀眼的美丽"
  },
  {
    "start": 780.25,
    "end": 784.226,
    "text": "而不是他们的困难、问题和无力感"
  },
  {
    "start": 784.226,
    "end": 788.202,
    "text": "一个灵性疗愈师所能给予他人的礼物"
  },
  {
    "start": 788.202,
    "end": 792.82,
    "text": "就是使他们看到真相 如果你能够将视线"
  },
  {
    "start": 792.82,
    "end": 795.386,
    "text": "越过他人的痛苦、愤怒"
  },
  {
    "start": 795.386,
    "end": 798.208,
    "text": "、恐惧及自我毁灭的行为"
  },
  {
    "start": 798.208,
    "end": 801.664,
    "text": "看到他们脸上的天使之光 你就会赋予"
  },
  {
    "start": 801.664,
    "end": 803.9,
    "text": "他们一件很珍贵的东西"
  },
  {
    "start": 803.9,
    "end": 806.136,
    "text": "通过看到他们的真实本质"
  },
  {
    "start": 806.136,
    "end": 810.827,
    "text": "你就是在温柔地呼唤它 使其浮出表面"
  },
  {
    "start": 810.827,
    "end": 813.813,
    "text": "洞察他人的真正力量和内在"
  },
  {
    "start": 813.813,
    "end": 817.545,
    "text": "之光——即使它们并未呈现于表面"
  },
  {
    "start": 817.545,
    "end": 821.027,
    "text": "就是以其“真正的名字”呼唤他人"
  },
  {
    "start": 821.027,
    "end": 824.432,
    "text": "而最具力量、最有震撼力的就是"
  },
  {
    "start": 824.432,
    "end": 828.081,
    "text": "：以其“真正的名字”呼唤一个人"
  },
  {
    "start": 828.787,
    "end": 831.352,
    "text": "当我以耶稣的身份在地球"
  },
  {
    "start": 831.352,
    "end": 834.15,
    "text": "上实施所谓的奇迹性疗愈时"
  },
  {
    "start": 834.15,
    "end": 839.051,
    "text": "我所做的只是与他人的神圣本质建立联结"
  },
  {
    "start": 839.051,
    "end": 841.773,
    "text": "通过注视和感受他人"
  },
  {
    "start": 841.773,
    "end": 844.768,
    "text": "内在的神圣火花而唤醒它"
  },
  {
    "start": 844.768,
    "end": 847.066,
    "text": "是他们自己的神圣本质"
  },
  {
    "start": 847.066,
    "end": 849.365,
    "text": "疗愈了他们 而不是我"
  },
  {
    "start": 849.365,
    "end": 854.213,
    "text": "我只是使他们忆起了真正的自己——这使"
  },
  {
    "start": 854.213,
    "end": 859.061,
    "text": "他们重新恢复了精神上甚至身体上的健康"
  },
  {
    "start": 859.061,
    "end": 863.251,
    "text": "此类晤面并非总有疗愈效果 因为能否"
  },
  {
    "start": 863.251,
    "end": 865.961,
    "text": "实现疗愈永远取决于一个"
  },
  {
    "start": 865.961,
    "end": 868.672,
    "text": "人对疗愈是否持开放态度"
  },
  {
    "start": 868.672,
    "end": 872.824,
    "text": "能否行奇迹取决于他们 当你们为他人"
  },
  {
    "start": 872.824,
    "end": 876.977,
    "text": "提供灵性疗愈时 也一定要记住这一点"
  },
  {
    "start": 877.683,
    "end": 881.367,
    "text": "所有的灵性疗愈都来自内在 作为"
  },
  {
    "start": 881.367,
    "end": 885.298,
    "text": "光之工作者的你 并不是在疗愈他人"
  },
  {
    "start": 885.298,
    "end": 889.568,
    "text": "而是创造一个开放、没有评判的空间"
  },
  {
    "start": 889.568,
    "end": 891.829,
    "text": "从而邀请他人以开放"
  },
  {
    "start": 891.829,
    "end": 894.34,
    "text": "、慈悲的态度看待自己"
  },
  {
    "start": 894.34,
    "end": 898.44,
    "text": "你与他人建立灵魂层面上的联结 并"
  },
  {
    "start": 898.44,
    "end": 903.051,
    "text": "展示给他们一个既充满信任又明晰的视野"
  },
  {
    "start": 903.051,
    "end": 906.424,
    "text": "而不是试图帮助他们解决外在的"
  },
  {
    "start": 906.424,
    "end": 910.278,
    "text": "问题 这就是光之工作者的助人之道"
  },
  {
    "start": 910.278,
    "end": 912.43,
    "text": "你试着帮助他人看到"
  },
  {
    "start": 912.43,
    "end": 915.06,
    "text": "自己的伟大 而不是渺小"
  },
  {
    "start": 915.06,
    "end": 917.939,
    "text": "在灵魂层面上帮助他人"
  },
  {
    "start": 917.939,
    "end": 920.817,
    "text": "意味着让他们看到自己"
  },
  {
    "start": 920.817,
    "end": 922.886,
    "text": "应负的责任——对他们"
  },
  {
    "start": 922.886,
    "end": 924.954,
    "text": "自己的人生应负的责任"
  },
  {
    "start": 924.954,
    "end": 929.125,
    "text": "因为你以充满爱且毫不评判的方式"
  },
  {
    "start": 929.125,
    "end": 933.574,
    "text": "提醒他们 他们不会把责任看成负担"
  },
  {
    "start": 933.574,
    "end": 936.849,
    "text": "反而感到被赋予权力和自由去"
  },
  {
    "start": 936.849,
    "end": 940.628,
    "text": "承担责任 借由相信他人的创造力"
  },
  {
    "start": 940.628,
    "end": 944.866,
    "text": "你就透过目光和言语将他们自己的坚强"
  },
  {
    "start": 944.866,
    "end": 949.353,
    "text": "反射给他们 关注他人内在的完整和无暇"
  },
  {
    "start": 949.353,
    "end": 951.019,
    "text": "就会强化它们"
  },
  {
    "start": 951.725,
    "end": 953.361,
    "text": "只有在真正相信的"
  },
  {
    "start": 953.361,
    "end": 955.814,
    "text": "情况下 你才能做到这一点"
  },
  {
    "start": 955.814,
    "end": 959.121,
    "text": "如果在某种程度上怀疑他人的自我"
  },
  {
    "start": 959.121,
    "end": 962.868,
    "text": "疗愈能力 你不但没有唤醒他们的力量"
  },
  {
    "start": 962.868,
    "end": 966.841,
    "text": "反而使他们确信自己确实是软弱的"
  },
  {
    "start": 966.841,
    "end": 971.062,
    "text": "当你完全相信他人拥有解决问题的能力"
  },
  {
    "start": 971.062,
    "end": 974.174,
    "text": "并放下“他们缺你不可”之类"
  },
  {
    "start": 974.174,
    "end": 977.525,
    "text": "的想法 你的疗愈力量就最强大"
  },
  {
    "start": 977.525,
    "end": 980.335,
    "text": "你们中的许多人觉得以"
  },
  {
    "start": 980.335,
    "end": 983.707,
    "text": "这种方式将责任归还给他人"
  },
  {
    "start": 983.707,
    "end": 986.014,
    "text": "就意味着放弃他们或者"
  },
  {
    "start": 986.014,
    "end": 988.553,
    "text": "告诉他们去独自解决问题"
  },
  {
    "start": 988.553,
    "end": 991.346,
    "text": "然而 解除依赖关系并不"
  },
  {
    "start": 991.346,
    "end": 995.409,
    "text": "意味着抽身而去 你依然陪伴着他们"
  },
  {
    "start": 995.409,
    "end": 999.337,
    "text": "带着对他们自身之坚强和内在力量的信任"
  },
  {
    "start": 999.337,
    "end": 1002.384,
    "text": "鼓励他们超越那些他们为自己"
  },
  {
    "start": 1002.384,
    "end": 1005.9,
    "text": "设定的限制并最大限度地彰显自己"
  },
  {
    "start": 1005.9,
    "end": 1009.524,
    "text": "至于他们是否且如何利用你所"
  },
  {
    "start": 1009.524,
    "end": 1013.983,
    "text": "提供的疗愈空间 则由他们自己决定"
  },
  {
    "start": 1014.689,
    "end": 1017.352,
    "text": "我知道你们中的许多人看到"
  },
  {
    "start": 1017.352,
    "end": 1023.343,
    "text": "他人——尤其是你们深爱的那些人——受苦而心中备感难过"
  },
  {
    "start": 1023.343,
    "end": 1027.31,
    "text": "停止“帮助他们”、放下、将精力"
  },
  {
    "start": 1027.31,
    "end": 1031.541,
    "text": "用于其他地方似乎是天方夜谭 然而"
  },
  {
    "start": 1031.541,
    "end": 1034.298,
    "text": "请仔细地思考一下 你这样"
  },
  {
    "start": 1034.298,
    "end": 1037.284,
    "text": "坚持下去是否真的在帮助他们"
  },
  {
    "start": 1037.284,
    "end": 1039.341,
    "text": "如果他们一直依赖于"
  },
  {
    "start": 1039.341,
    "end": 1041.626,
    "text": "你那友善和支持的能量"
  },
  {
    "start": 1041.626,
    "end": 1044.773,
    "text": "又如何肯面对他们对自己缺乏"
  },
  {
    "start": 1044.773,
    "end": 1048.647,
    "text": "友善和支持这一事实 在灵魂层面上"
  },
  {
    "start": 1048.647,
    "end": 1051.29,
    "text": "你或许更增强了他们的软弱"
  },
  {
    "start": 1051.29,
    "end": 1054.373,
    "text": "而不是唤醒他们真正的内在力量"
  },
  {
    "start": 1054.373,
    "end": 1057.313,
    "text": "这对你们双方都有负面的影响"
  },
  {
    "start": 1058.019,
    "end": 1062.167,
    "text": "作为光之工作者或灵性疗愈师 意味着"
  },
  {
    "start": 1062.167,
    "end": 1066.559,
    "text": "寻找彼此灵魂之间的联结 在灵魂层面上"
  },
  {
    "start": 1066.559,
    "end": 1071.768,
    "text": "一切存有都是平等的 没有人超前于他人"
  },
  {
    "start": 1071.768,
    "end": 1075.565,
    "text": "你们都是那神圣存有——你们称其为"
  },
  {
    "start": 1075.565,
    "end": 1079.598,
    "text": "上帝或神的神圣火花 从人类层面上看"
  },
  {
    "start": 1079.598,
    "end": 1084.119,
    "text": "仿佛一个人比另一人更有知识、更进化"
  },
  {
    "start": 1084.119,
    "end": 1088.906,
    "text": "或者更有智慧 然而 从灵魂的角度来看"
  },
  {
    "start": 1088.906,
    "end": 1092.164,
    "text": "这种评判显得迂腐 所有的"
  },
  {
    "start": 1092.164,
    "end": 1095.423,
    "text": "灵魂都在无尽的宇宙中旅行"
  },
  {
    "start": 1095.423,
    "end": 1098.81,
    "text": "都经历过各种不同的体验和成长周期"
  },
  {
    "start": 1098.81,
    "end": 1102.991,
    "text": "或许你目前正在帮助一个身处困境因而"
  },
  {
    "start": 1102.991,
    "end": 1105.205,
    "text": "情感严重失衡的人"
  },
  {
    "start": 1105.205,
    "end": 1108.156,
    "text": "此时此刻你是提供帮助的人"
  },
  {
    "start": 1108.156,
    "end": 1111.536,
    "text": "然而 当这位受苦之人重获"
  },
  {
    "start": 1111.536,
    "end": 1115.761,
    "text": "坚强之后 他或许会成为你的导师"
  },
  {
    "start": 1115.761,
    "end": 1120.97,
    "text": "展现出令你惊叹的深度智慧和慈悲"
  },
  {
    "start": 1121.676,
    "end": 1125.84,
    "text": "提供灵性疗愈或作为光之工作者"
  },
  {
    "start": 1125.84,
    "end": 1130.706,
    "text": "至关重要的一点是：始终记住你和他人在"
  },
  {
    "start": 1130.706,
    "end": 1133.409,
    "text": "灵魂层面上是平等的"
  },
  {
    "start": 1133.409,
    "end": 1136.383,
    "text": "一定要认知你自己的人性"
  },
  {
    "start": 1136.383,
    "end": 1141.303,
    "text": "并明了你和他人其实都在同一条船上"
  },
  {
    "start": 1141.303,
    "end": 1146.513,
    "text": "或许你为他人提供了一个光和慈悲的空间"
  },
  {
    "start": 1146.513,
    "end": 1149.312,
    "text": "但你并不因此而有别于他人"
  },
  {
    "start": 1149.312,
    "end": 1153.188,
    "text": "也不比他人更“高”或在他人之“上”"
  },
  {
    "start": 1153.188,
    "end": 1157.086,
    "text": "不要将自己等同于“光之工作者”这个"
  },
  {
    "start": 1157.086,
    "end": 1160.985,
    "text": "角色 如果你内心有着助人的强烈愿望"
  },
  {
    "start": 1160.985,
    "end": 1165.346,
    "text": "希望帮助他人发现自己真正的内在力量"
  },
  {
    "start": 1165.346,
    "end": 1169.708,
    "text": "就请跟从你的热忱 做自己喜欢的事"
  },
  {
    "start": 1169.708,
    "end": 1172.736,
    "text": "光之工作形式各异 当然不"
  },
  {
    "start": 1172.736,
    "end": 1176.268,
    "text": "局限于提供灵性咨询 一般来说"
  },
  {
    "start": 1176.268,
    "end": 1180.505,
    "text": "如果你所做的是自己真正想做的事 你"
  },
  {
    "start": 1180.505,
    "end": 1184.741,
    "text": "就会看到自己也在激励他人也和你一样"
  },
  {
    "start": 1184.741,
    "end": 1189.3,
    "text": "与你心中的神性火花合一 会自然而然地"
  },
  {
    "start": 1189.3,
    "end": 1191.833,
    "text": "将你引向适合你的工作"
  },
  {
    "start": 1191.833,
    "end": 1194.619,
    "text": "、（亲密）关系或居住地"
  },
  {
    "start": 1194.619,
    "end": 1198.319,
    "text": "跟从内心的声音生活真的很简单 它"
  },
  {
    "start": 1198.319,
    "end": 1200.168,
    "text": "就是与内心的渴望"
  },
  {
    "start": 1200.168,
    "end": 1202.712,
    "text": "以及真正的喜悦建立联结"
  },
  {
    "start": 1202.712,
    "end": 1206.865,
    "text": "并依心而行 做到这一点你就是光之"
  },
  {
    "start": 1206.865,
    "end": 1208.942,
    "text": "工作者 并不一定"
  },
  {
    "start": 1208.942,
    "end": 1211.797,
    "text": "是因为你在“帮助他人”"
  },
  {
    "start": 1211.797,
    "end": 1214.886,
    "text": "而是因为你为这个世界带来"
  },
  {
    "start": 1214.886,
    "end": 1217.974,
    "text": "你那独一无二的 灵魂之歌"
  },
  {
    "start": 1217.974,
    "end": 1221.828,
    "text": "它激励他人也相信自己并彰显"
  },
  {
    "start": 1221.828,
    "end": 1225.681,
    "text": "最美的自己 光 自然会闪耀"
  },
  {
    "start": 1225.681,
    "end": 1228.071,
    "text": "你无须刻意关注 如何在"
  },
  {
    "start": 1228.071,
    "end": 1230.678,
    "text": "这个世界上传播光 的问题"
  },
  {
    "start": 1230.678,
    "end": 1234.846,
    "text": "不要刻意执着于成为至善和有益的人"
  },
  {
    "start": 1234.846,
    "end": 1239.275,
    "text": "试着依循你那独特的神圣本性而生活"
  },
  {
    "start": 1239.275,
    "end": 1243.01,
    "text": "这个世界就会因此而变得更加美好"
  }
]