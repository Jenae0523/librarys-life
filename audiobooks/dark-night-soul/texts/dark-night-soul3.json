[
  {
    "start": 0.0,
    "end": 2.3609999999999998,
    "text": "第二章日记撷录"
  },
  {
    "start": 3.067,
    "end": 5.513,
    "text": "2009年7月1日"
  },
  {
    "start": 6.219,
    "end": 9.802,
    "text": "今天弗兰卡（我的一位疗愈师朋友）"
  },
  {
    "start": 9.802,
    "end": 13.609,
    "text": "为我做疗愈 之后 我看到如下的画面"
  },
  {
    "start": 13.609,
    "end": 17.551,
    "text": "伴随这些画面而来的 还有强烈的情绪"
  },
  {
    "start": 18.257,
    "end": 21.107,
    "text": "我看到出生前的我身处在光"
  },
  {
    "start": 21.107,
    "end": 23.957,
    "text": "与爱的氛围中 在某一时刻"
  },
  {
    "start": 23.957,
    "end": 27.99,
    "text": "（他们）做出我再次轮回地球的决定"
  },
  {
    "start": 27.99,
    "end": 32.023,
    "text": "一位指导灵陪伴在我的身边 他很亲切"
  },
  {
    "start": 32.023,
    "end": 36.461,
    "text": "名叫巴特赫罗梅斯 我称他为梅斯"
  },
  {
    "start": 36.461,
    "end": 41.195,
    "text": "他浑身上下散发着爱与智慧的能量"
  },
  {
    "start": 41.195,
    "end": 45.45,
    "text": "梅斯说我无法阻止这件事情的发生 因为"
  },
  {
    "start": 45.45,
    "end": 47.814,
    "text": "“此刻重返地球”是我"
  },
  {
    "start": 47.814,
    "end": 50.414,
    "text": "生命韵律的一个重要篇章"
  },
  {
    "start": 50.414,
    "end": 54.215,
    "text": "我需要在这一生中完成一些事情"
  },
  {
    "start": 54.215,
    "end": 58.27,
    "text": "需要去面对与消除旧有的忧伤与恐惧"
  },
  {
    "start": 58.27,
    "end": 61.678,
    "text": "而地球生活有助于我达成这一目标"
  },
  {
    "start": 61.678,
    "end": 65.314,
    "text": "他邀请我放下旧有的怀疑与不信任"
  },
  {
    "start": 65.314,
    "end": 67.366,
    "text": "重新学着相信在"
  },
  {
    "start": 67.366,
    "end": 70.882,
    "text": "物质世界生活的美丽与神奇"
  },
  {
    "start": 71.588,
    "end": 76.176,
    "text": "我对这一决定心怀抵触 这一决定来自"
  },
  {
    "start": 76.176,
    "end": 78.875,
    "text": "生命本身 来自宇宙"
  },
  {
    "start": 78.875,
    "end": 81.574,
    "text": "梅斯并未强迫我 不过"
  },
  {
    "start": 81.574,
    "end": 85.982,
    "text": "我知道自己必须遵从这一安排 一只温暖"
  },
  {
    "start": 85.982,
    "end": 88.431,
    "text": "的手轻轻地向前推了我"
  },
  {
    "start": 88.431,
    "end": 90.88,
    "text": "一下 而我则满心抗拒"
  },
  {
    "start": 90.88,
    "end": 94.109,
    "text": "畏缩不前 我不想轮回地球"
  },
  {
    "start": 94.815,
    "end": 99.058,
    "text": "为什么不想呢 因为我不想被地球"
  },
  {
    "start": 99.058,
    "end": 103.584,
    "text": "实相之帷幕遮蔽甚至禁锢 对我来说"
  },
  {
    "start": 103.584,
    "end": 107.836,
    "text": "地球实相充满了暴力、威胁、侵犯"
  },
  {
    "start": 107.836,
    "end": 112.372,
    "text": "、孤寂与凄凉 我想要继续享受自由"
  },
  {
    "start": 112.372,
    "end": 116.982,
    "text": "继续感受和谐的氛围 继续飘舞于幸福与"
  },
  {
    "start": 116.982,
    "end": 119.286,
    "text": "极乐之中 然而 有"
  },
  {
    "start": 119.286,
    "end": 121.847,
    "text": "一股力量将我吸向地球"
  },
  {
    "start": 121.847,
    "end": 126.62,
    "text": "我一路挣扎着 身不由己地渐渐接近地球"
  },
  {
    "start": 126.62,
    "end": 129.006,
    "text": "内在的某一部分对"
  },
  {
    "start": 129.006,
    "end": 131.923,
    "text": "前来引导我的光紧闭门扉"
  },
  {
    "start": 131.923,
    "end": 134.828,
    "text": "我的心中充满了愤怒与抵触"
  },
  {
    "start": 134.828,
    "end": 137.734,
    "text": "我不愿意 我就是不愿意"
  },
  {
    "start": 138.439,
    "end": 143.26,
    "text": "此外 我还看到 灵性次元中 几位女性"
  },
  {
    "start": 143.26,
    "end": 145.67,
    "text": "围成一圈 帮助我为"
  },
  {
    "start": 145.67,
    "end": 148.616,
    "text": "地球之行做准备 画面中"
  },
  {
    "start": 148.616,
    "end": 152.805,
    "text": "我是一个婴儿 天使般的她们抱着我"
  },
  {
    "start": 152.805,
    "end": 155.023,
    "text": "带给我温暖的爱 并"
  },
  {
    "start": 155.023,
    "end": 157.98,
    "text": "柔声告诉我她们对我的信任"
  },
  {
    "start": 157.98,
    "end": 162.469,
    "text": "婴儿的我 想要拥抱她们的爱与信任"
  },
  {
    "start": 162.469,
    "end": 167.222,
    "text": "然而 我的某一部分已经将自己隔绝起来"
  },
  {
    "start": 167.222,
    "end": 171.49,
    "text": "她生气地站在一旁 拒绝聆听 这一部分"
  },
  {
    "start": 171.49,
    "end": 173.861,
    "text": "的我不愿意轮回地球"
  },
  {
    "start": 173.861,
    "end": 176.231,
    "text": "她满心痛苦 愤怒不已"
  },
  {
    "start": 176.231,
    "end": 179.382,
    "text": "失望至极 她毫不掩饰自己"
  },
  {
    "start": 179.382,
    "end": 183.057,
    "text": "挖苦、批评的态度 她想要报复"
  },
  {
    "start": 183.057,
    "end": 188.119,
    "text": "并希望自己的决定能够获得认可 然而"
  },
  {
    "start": 188.119,
    "end": 190.651,
    "text": "她的身边冷冷清清"
  },
  {
    "start": 190.651,
    "end": 193.463,
    "text": "空无一人 她孤身只影"
  },
  {
    "start": 193.463,
    "end": 196.821,
    "text": "如同一间幽暗阴森、四壁皆空"
  },
  {
    "start": 196.821,
    "end": 200.437,
    "text": "的囚室——远甚于人世间的囚室"
  },
  {
    "start": 200.437,
    "end": 203.996,
    "text": "一旦你自己的精神将你禁锢起来"
  },
  {
    "start": 203.996,
    "end": 207.555,
    "text": "成为你的囚室时 你就会放弃生命"
  },
  {
    "start": 207.555,
    "end": 211.868,
    "text": "不再允许它带给你惊奇与美好 为你"
  },
  {
    "start": 211.868,
    "end": 216.72,
    "text": "展开全新的人生画卷 并助你与过去和解"
  },
  {
    "start": 217.426,
    "end": 220.409,
    "text": "就这样 我踏上轮回之旅时"
  },
  {
    "start": 220.409,
    "end": 223.392,
    "text": "已经把自己完全隔绝起来"
  },
  {
    "start": 223.392,
    "end": 227.859,
    "text": "将那几位想要疗愈我的女性挡在门外"
  },
  {
    "start": 227.859,
    "end": 230.749,
    "text": "沉入地球实相时 我感觉"
  },
  {
    "start": 230.749,
    "end": 233.639,
    "text": "自己如同一片凋零的秋叶"
  },
  {
    "start": 233.639,
    "end": 237.631,
    "text": "毫无生气地缓缓飘落 我根本不想来"
  },
  {
    "start": 237.631,
    "end": 239.744,
    "text": "进入属于我的胚胎时"
  },
  {
    "start": 239.744,
    "end": 242.092,
    "text": "那种感觉很是不舒服"
  },
  {
    "start": 242.092,
    "end": 246.377,
    "text": "就好像浑身上下都沾满了黏糊糊的沥青"
  },
  {
    "start": 246.377,
    "end": 250.357,
    "text": "我最后的一线希望——那自由的氛围——"
  },
  {
    "start": 250.357,
    "end": 252.347,
    "text": "居然也被夺走 我被"
  },
  {
    "start": 252.347,
    "end": 254.779,
    "text": "牢牢地囚禁在这一身体里"
  },
  {
    "start": 254.779,
    "end": 260.061,
    "text": "濒于窒息 石化 我感觉通体冰凉"
  },
  {
    "start": 260.061,
    "end": 265.342,
    "text": "寒冷刺骨 我不想石化 不想 可是"
  },
  {
    "start": 265.342,
    "end": 268.04,
    "text": "这恼人的一切还是发生了"
  },
  {
    "start": 268.04,
    "end": 270.982,
    "text": "：我变成了有血有肉的身体"
  },
  {
    "start": 270.982,
    "end": 275.516,
    "text": "我无助地在母亲的子宫内翻转、扭动"
  },
  {
    "start": 275.516,
    "end": 280.05,
    "text": "我实在不想来这里 更不想出生 然而"
  },
  {
    "start": 280.05,
    "end": 283.188,
    "text": "我那幼小的身体还是不断地"
  },
  {
    "start": 283.188,
    "end": 286.849,
    "text": "成长、发育 完全违背我的意志"
  },
  {
    "start": 286.849,
    "end": 290.787,
    "text": "它不断地长大……母亲的能量对于我"
  },
  {
    "start": 290.787,
    "end": 295.218,
    "text": "来说既陌生又疏远 我与它没有任何联结"
  },
  {
    "start": 295.218,
    "end": 299.5,
    "text": "我将外在世界拒之门外 觉得自己受了"
  },
  {
    "start": 299.5,
    "end": 304.034,
    "text": "伤害 愤怒不已 心中除了抗拒还是抗拒"
  },
  {
    "start": 304.034,
    "end": 308.142,
    "text": "冷漠将我笼罩 我拒绝人生对我的"
  },
  {
    "start": 308.142,
    "end": 312.799,
    "text": "呼唤 厚厚的迷雾将我与物质世界隔开"
  },
  {
    "start": 313.505,
    "end": 316.826,
    "text": "我出生的时刻到了 子宫内的运动"
  },
  {
    "start": 316.826,
    "end": 320.368,
    "text": "越来越剧烈 我惊慌不已 不知所措"
  },
  {
    "start": 320.368,
    "end": 323.786,
    "text": "不过就是不肯出生 我已经习惯了子"
  },
  {
    "start": 323.786,
    "end": 327.631,
    "text": "宫内的生活 虽然我在那里感到并不舒畅"
  },
  {
    "start": 327.631,
    "end": 330.738,
    "text": "但这毕竟给我了一些安全感"
  },
  {
    "start": 330.738,
    "end": 334.084,
    "text": "出生过程历时很久 我不肯顺从"
  },
  {
    "start": 334.084,
    "end": 337.804,
    "text": "因为我于内心深处彻底抵触地球上"
  },
  {
    "start": 337.804,
    "end": 341.773,
    "text": "的生活 这种抵触感推延了我的降临"
  },
  {
    "start": 341.773,
    "end": 346.329,
    "text": "当我终于呱呱落地之时 那强烈的日光使"
  },
  {
    "start": 346.329,
    "end": 348.86,
    "text": "我无法承受 与此同时"
  },
  {
    "start": 348.86,
    "end": 351.644,
    "text": "我也感受到母亲的情绪"
  },
  {
    "start": 351.644,
    "end": 355.227,
    "text": "感受到这一难产经历带给她的"
  },
  {
    "start": 355.227,
    "end": 359.637,
    "text": "恐惧与惊慌 我深感愧疚 我真自私"
  },
  {
    "start": 359.637,
    "end": 362.656,
    "text": "因为自己内在的抗拒而伤害了母亲"
  },
  {
    "start": 362.656,
    "end": 365.877,
    "text": "……我内在有着一种敏感的“东西”"
  },
  {
    "start": 365.877,
    "end": 369.227,
    "text": "它把这一切都印刻在我的记忆中"
  },
  {
    "start": 372.051,
    "end": 374.858,
    "text": "2009年7月3日至5"
  },
  {
    "start": 374.858,
    "end": 377.155,
    "text": "日与地球母亲的对话"
  },
  {
    "start": 377.861,
    "end": 380.858,
    "text": "我问 为什么我的胃这么不舒服"
  },
  {
    "start": 381.564,
    "end": 383.051,
    "text": "地球母亲"
  },
  {
    "start": 383.757,
    "end": 386.242,
    "text": "你制造胃酸是为了抗拒与"
  },
  {
    "start": 386.242,
    "end": 388.952,
    "text": "防卫 胃酸是一种防卫工具"
  },
  {
    "start": 388.952,
    "end": 392.413,
    "text": "你感觉外界刺激以排山倒海之势向你袭"
  },
  {
    "start": 392.413,
    "end": 396.078,
    "text": "来 而你无法很好地应对与整合这些刺激"
  },
  {
    "start": 396.078,
    "end": 399.644,
    "text": "胃酸在此扮演着起落杆的作用：将这些"
  },
  {
    "start": 399.644,
    "end": 401.532,
    "text": "外界刺激挡在外面"
  },
  {
    "start": 401.532,
    "end": 404.049,
    "text": "到此为止 不许再向前一步"
  },
  {
    "start": 404.681,
    "end": 407.911,
    "text": "就是说 我未能持守自己设定的"
  },
  {
    "start": 407.911,
    "end": 411.14,
    "text": "界限 因此胃酸帮我做到这一点"
  },
  {
    "start": 411.846,
    "end": 413.196,
    "text": "对 没错"
  },
  {
    "start": 413.828,
    "end": 417.959,
    "text": "保持自我 让一切外界刺激自来自去"
  },
  {
    "start": 417.959,
    "end": 419.902,
    "text": "不因它们而失衡"
  },
  {
    "start": 419.902,
    "end": 422.818,
    "text": "为什么这对我来说就这么难"
  },
  {
    "start": 423.524,
    "end": 425.858,
    "text": "你努力去满足他人的期望"
  },
  {
    "start": 425.858,
    "end": 428.193,
    "text": "想要获得他们的首肯与欣赏"
  },
  {
    "start": 428.193,
    "end": 431.386,
    "text": "你的内在有一个渴望得到认可的小"
  },
  {
    "start": 431.386,
    "end": 435.006,
    "text": "女孩 孩提时期 你决定以母亲为参照"
  },
  {
    "start": 435.006,
    "end": 437.635,
    "text": "因为她是在各个层面培养你的"
  },
  {
    "start": 437.635,
    "end": 440.872,
    "text": "那个人 从做出这一决定的那一刻起"
  },
  {
    "start": 440.872,
    "end": 443.817,
    "text": "你开始逐渐偏离自己的中心"
  },
  {
    "start": 443.817,
    "end": 447.216,
    "text": "而且 这一问题至今依然悬而未决"
  },
  {
    "start": 447.848,
    "end": 450.131,
    "text": "她对你的首肯重于一切"
  },
  {
    "start": 450.131,
    "end": 452.622,
    "text": "其他的一切都处于次要地位"
  },
  {
    "start": 452.622,
    "end": 455.148,
    "text": "你也将这一习惯带到了日后的"
  },
  {
    "start": 455.148,
    "end": 457.869,
    "text": "（亲密）关系中 因着这一倾向"
  },
  {
    "start": 457.869,
    "end": 461.496,
    "text": "你不断地将他人的评价置于自己的需求"
  },
  {
    "start": 461.496,
    "end": 463.63,
    "text": "之上  他或她对我的"
  },
  {
    "start": 463.63,
    "end": 466.19,
    "text": "看法如何 在他或她的眼中"
  },
  {
    "start": 466.19,
    "end": 469.974,
    "text": "我做得够好吗 ”远重于“我自己的看法"
  },
  {
    "start": 469.974,
    "end": 471.867,
    "text": "是什么 我想要什么"
  },
  {
    "start": 471.867,
    "end": 473.969,
    "text": "在你的咨询工作中"
  },
  {
    "start": 473.969,
    "end": 476.572,
    "text": "这一模式也一再地上演 你"
  },
  {
    "start": 476.572,
    "end": 479.608,
    "text": "为了获得他人的首肯而竭尽全力"
  },
  {
    "start": 479.608,
    "end": 481.834,
    "text": "很少自问： 这是我想要"
  },
  {
    "start": 481.834,
    "end": 484.261,
    "text": "的吗 这是否适宜于我"
  },
  {
    "start": 484.893,
    "end": 488.821,
    "text": "就是说 我内在有一种自动模式 我以"
  },
  {
    "start": 488.821,
    "end": 491.132,
    "text": "他人的看法为准则 将"
  },
  {
    "start": 491.132,
    "end": 493.443,
    "text": "他们看作评判我的法官"
  },
  {
    "start": 493.443,
    "end": 496.583,
    "text": "难道这是我为了逃避直面自己"
  },
  {
    "start": 496.583,
    "end": 499.966,
    "text": "的孤独或忧伤而采取的生存机制"
  },
  {
    "start": 500.671,
    "end": 504.807,
    "text": "确实可以这样说 当初 你带着对生命的"
  },
  {
    "start": 504.807,
    "end": 507.105,
    "text": "愤怒投胎 根本不愿意"
  },
  {
    "start": 507.105,
    "end": 509.403,
    "text": "在地球上生活 也因此"
  },
  {
    "start": 509.403,
    "end": 513.107,
    "text": "你对生命没有任何信任 而信任永远是"
  },
  {
    "start": 513.107,
    "end": 514.959,
    "text": "不偏离内在中心 的"
  },
  {
    "start": 514.959,
    "end": 517.016,
    "text": "基础 你出生的那一刻"
  },
  {
    "start": 517.016,
    "end": 520.707,
    "text": "强烈的外在刺激将你压倒 你没有建立起"
  },
  {
    "start": 520.707,
    "end": 522.553,
    "text": "信任的基础 以面对"
  },
  {
    "start": 522.553,
    "end": 524.603,
    "text": "之后出现的各种新刺激"
  },
  {
    "start": 524.603,
    "end": 528.074,
    "text": "对你来说 一切都是那么可怕 那么"
  },
  {
    "start": 528.074,
    "end": 531.979,
    "text": "令人厌恶 那么危险 由于缺乏内在基础"
  },
  {
    "start": 531.979,
    "end": 535.163,
    "text": "你紧抓貌似能够带给你一定安全感的"
  },
  {
    "start": 535.163,
    "end": 536.953,
    "text": "外在事物不放 这一"
  },
  {
    "start": 536.953,
    "end": 538.943,
    "text": "外在标尺便是你的母亲"
  },
  {
    "start": 539.574,
    "end": 542.618,
    "text": "你出生时便没有“中心” 或者说 你"
  },
  {
    "start": 542.618,
    "end": 545.661,
    "text": "并非“真正的自己” 因为你的一部分"
  },
  {
    "start": 545.661,
    "end": 548.735,
    "text": "本可以对生命说 “是” 并为你"
  },
  {
    "start": 548.735,
    "end": 552.219,
    "text": "世界观的形成打下坚实基础的那一部分"
  },
  {
    "start": 552.219,
    "end": 556.182,
    "text": "与生命隔绝开来 在这一生刚刚拉开序幕"
  },
  {
    "start": 556.182,
    "end": 560.145,
    "text": "之际 你的意识觉知便充满了恐惧与惊惶"
  },
  {
    "start": 560.145,
    "end": 563.356,
    "text": "你在黑暗中盲目地寻找一束能够让你"
  },
  {
    "start": 563.356,
    "end": 565.162,
    "text": "依赖与寄托的火炬"
  },
  {
    "start": 565.162,
    "end": 567.169,
    "text": "你于内在缺少这一火炬"
  },
  {
    "start": 567.169,
    "end": 570.879,
    "text": "因为你的灵魂之光并未真正地伴随你一起"
  },
  {
    "start": 570.879,
    "end": 572.939,
    "text": "踏上地球之旅 后来"
  },
  {
    "start": 572.939,
    "end": 575.0,
    "text": "你才找到了自己的灵魂"
  },
  {
    "start": 575.632,
    "end": 578.732,
    "text": "我的灵魂与我的地球人格"
  },
  {
    "start": 578.732,
    "end": 581.833,
    "text": "之间是否存在着某种分离"
  },
  {
    "start": 582.538,
    "end": 585.471,
    "text": "你无法有意识有觉知地感受自己"
  },
  {
    "start": 585.471,
    "end": 588.612,
    "text": "的灵魂 怨恨与失望将你屏蔽起来"
  },
  {
    "start": 588.612,
    "end": 591.941,
    "text": "只有纵身跃入物质实相才能打破这一"
  },
  {
    "start": 591.941,
    "end": 595.478,
    "text": "屏蔽 你无法在灵性次元中做到这一点"
  },
  {
    "start": 595.478,
    "end": 597.7,
    "text": "因为在那里你并不是透过"
  },
  {
    "start": 597.7,
    "end": 601.133,
    "text": "分离出来的人格（自我）生活 在那里"
  },
  {
    "start": 601.133,
    "end": 604.078,
    "text": "你与“一切万有”、与你的灵魂"
  },
  {
    "start": 604.078,
    "end": 607.654,
    "text": "有着更强的联结 然而 也正因为如此"
  },
  {
    "start": 607.654,
    "end": 610.796,
    "text": "你无法体验与解决积储起来的情绪"
  },
  {
    "start": 611.428,
    "end": 615.326,
    "text": "嗯 这我理解 我想更好地理解自己的"
  },
  {
    "start": 615.326,
    "end": 619.225,
    "text": "这个自动模式 为什么我遇到一个人时"
  },
  {
    "start": 619.225,
    "end": 623.129,
    "text": "总是立刻将自己置身于对方的情境 就"
  },
  {
    "start": 623.129,
    "end": 625.196,
    "text": "好像我内在有什么"
  },
  {
    "start": 625.196,
    "end": 627.493,
    "text": "东西 直接跃入了对方"
  },
  {
    "start": 627.493,
    "end": 631.464,
    "text": "这是同理心吗 反正我总是自动地用对方"
  },
  {
    "start": 631.464,
    "end": 633.67,
    "text": "的目光来看我自己 我"
  },
  {
    "start": 633.67,
    "end": 635.876,
    "text": "能够感受到对方的期待"
  },
  {
    "start": 635.876,
    "end": 639.254,
    "text": "与此同时 我则害怕自己无法满足"
  },
  {
    "start": 639.254,
    "end": 642.631,
    "text": "对方的期待 害怕自己做得不够好"
  },
  {
    "start": 642.631,
    "end": 647.172,
    "text": "未能完全感受对方的感受 与对方同在"
  },
  {
    "start": 647.172,
    "end": 649.19,
    "text": "明确设定界限乃至"
  },
  {
    "start": 649.19,
    "end": 651.965,
    "text": "双方之间可能会出现冲突"
  },
  {
    "start": 651.965,
    "end": 655.514,
    "text": "诸如此类的想法对我来说是根本无法"
  },
  {
    "start": 655.514,
    "end": 659.063,
    "text": "忍受的 因此 我与对方融合在一起"
  },
  {
    "start": 659.063,
    "end": 662.697,
    "text": "希望获得对方的好感 而同时又害怕"
  },
  {
    "start": 662.697,
    "end": 664.741,
    "text": "自己做不到这一点"
  },
  {
    "start": 664.741,
    "end": 667.012,
    "text": "这就是我的自动模式吗"
  },
  {
    "start": 667.718,
    "end": 670.748,
    "text": "这一自动模式是：你为了他人而"
  },
  {
    "start": 670.748,
    "end": 674.644,
    "text": "牺牲自己 对你来说 他人占据主导地位"
  },
  {
    "start": 674.644,
    "end": 677.827,
    "text": "他或她可以主宰你的感受与看法 你"
  },
  {
    "start": 677.827,
    "end": 681.01,
    "text": "则根据他或她的期望来不断调整自己"
  },
  {
    "start": 681.01,
    "end": 682.927,
    "text": "这就是你的模式：你"
  },
  {
    "start": 682.927,
    "end": 685.057,
    "text": "调整自己 以适应他人"
  },
  {
    "start": 685.689,
    "end": 688.42,
    "text": "这种调整与适应使我失去"
  },
  {
    "start": 688.42,
    "end": 691.4,
    "text": "了自己 偏离了自己的中心"
  },
  {
    "start": 692.105,
    "end": 695.447,
    "text": "对 而且关键问题是 这明明是"
  },
  {
    "start": 695.447,
    "end": 699.505,
    "text": "失去自我 你却认为这是好事 你认为"
  },
  {
    "start": 699.505,
    "end": 702.654,
    "text": "这样你就是一个善良、可爱的好"
  },
  {
    "start": 702.654,
    "end": 706.027,
    "text": "女孩 会因此而获得首肯 就是说"
  },
  {
    "start": 706.027,
    "end": 708.949,
    "text": "你脑中有一个谬论： 失去自我是"
  },
  {
    "start": 708.949,
    "end": 712.456,
    "text": "好事 是善行 这样做能够解决我的问题"
  },
  {
    "start": 712.456,
    "end": 715.089,
    "text": "”“失去自我”的诱人之处在于"
  },
  {
    "start": 715.089,
    "end": 717.911,
    "text": "你会感受到短暂的和谐 就是说"
  },
  {
    "start": 717.911,
    "end": 720.82,
    "text": "你感到自己是受欢迎的 因为你"
  },
  {
    "start": 720.82,
    "end": 724.353,
    "text": "获得了他人的认可 能够得到你的证实"
  },
  {
    "start": 724.353,
    "end": 727.309,
    "text": "知道你与他们同感同受 这对"
  },
  {
    "start": 727.309,
    "end": 730.492,
    "text": "许多人来说都是一种慰藉 因此"
  },
  {
    "start": 730.492,
    "end": 733.613,
    "text": "他们不会阻止你按照“牺牲自己”的"
  },
  {
    "start": 733.613,
    "end": 735.368,
    "text": "运作机制行事 他们"
  },
  {
    "start": 735.368,
    "end": 737.319,
    "text": "希望也喜欢和你在一起"
  },
  {
    "start": 737.95,
    "end": 742.128,
    "text": "什么时候一个人才能意识到 牺牲自己"
  },
  {
    "start": 742.128,
    "end": 746.551,
    "text": "并非善举 而是一个虚妄的运作机制呢"
  },
  {
    "start": 747.257,
    "end": 750.185,
    "text": "当你一直牺牲自己 直到因此而"
  },
  {
    "start": 750.185,
    "end": 753.322,
    "text": "深受其苦之时 就会意识到这一点"
  },
  {
    "start": 753.322,
    "end": 755.792,
    "text": "你可以长期对此执迷不悟"
  },
  {
    "start": 755.792,
    "end": 758.262,
    "text": "比如深陷某一亲密关系之中"
  },
  {
    "start": 758.262,
    "end": 761.865,
    "text": "但你内在毕竟有一些不肯自欺欺人的因素"
  },
  {
    "start": 761.865,
    "end": 764.88,
    "text": "你与R（一段持续了四年的爱情）的"
  },
  {
    "start": 764.88,
    "end": 766.577,
    "text": "关系就是一个很好的"
  },
  {
    "start": 766.577,
    "end": 768.462,
    "text": "例子 你因为爱上了M"
  },
  {
    "start": 768.462,
    "end": 771.784,
    "text": "而从与R的关系中清醒过来 对你"
  },
  {
    "start": 771.784,
    "end": 775.549,
    "text": "来说 这仿佛是“偶然”发生的 然而"
  },
  {
    "start": 775.549,
    "end": 777.613,
    "text": "这是你的灵魂的安排 是"
  },
  {
    "start": 777.613,
    "end": 779.678,
    "text": "你的灵魂为你吸引过来的"
  },
  {
    "start": 780.309,
    "end": 783.424,
    "text": "我还记得 离开R对我来说"
  },
  {
    "start": 783.424,
    "end": 786.799,
    "text": "是一个极其艰难的决定 那时"
  },
  {
    "start": 786.799,
    "end": 791.358,
    "text": "我在能量层面上与他紧紧地黏在一起 我"
  },
  {
    "start": 791.358,
    "end": 795.917,
    "text": "终于下定决心与他分手时 我们正在厨房"
  },
  {
    "start": 795.917,
    "end": 799.373,
    "text": "我第一次不再顺由他的能量 给"
  },
  {
    "start": 799.373,
    "end": 802.83,
    "text": "了他一个完全出乎他意料的回答"
  },
  {
    "start": 802.83,
    "end": 806.9,
    "text": "我大声清晰地说：“我决定离开你 ”"
  },
  {
    "start": 806.9,
    "end": 809.533,
    "text": "就在那一瞬间 一种能量"
  },
  {
    "start": 809.533,
    "end": 812.167,
    "text": "上的突变强烈地震撼了我"
  },
  {
    "start": 812.167,
    "end": 815.877,
    "text": "一个环绕着R的球形能量场忽然闪电"
  },
  {
    "start": 815.877,
    "end": 819.588,
    "text": "般地飞向我 我知道 这是我的能量"
  },
  {
    "start": 819.588,
    "end": 824.179,
    "text": "是我的共情以及对他的认同 是我为了"
  },
  {
    "start": 824.179,
    "end": 828.77,
    "text": "能够获取他的肯定而付出的一切 如今"
  },
  {
    "start": 828.77,
    "end": 832.89,
    "text": "这一能量又回到我的身体 忽然间 我"
  },
  {
    "start": 832.89,
    "end": 837.253,
    "text": "感觉自己变得异常坚强 浑身充满了力量"
  },
  {
    "start": 837.253,
    "end": 841.198,
    "text": "我好像刚刚从深度麻醉的状态中清醒过来"
  },
  {
    "start": 841.198,
    "end": 843.17,
    "text": "再次觉知到自己的"
  },
  {
    "start": 843.17,
    "end": 845.581,
    "text": "存在 不再害怕与他分手"
  },
  {
    "start": 845.581,
    "end": 848.156,
    "text": "那也是尘埃落定的一刻"
  },
  {
    "start": 848.156,
    "end": 850.988,
    "text": "我去意已决 离开了他"
  },
  {
    "start": 851.694,
    "end": 854.079,
    "text": "之后我还有过一次类似的"
  },
  {
    "start": 854.079,
    "end": 856.896,
    "text": "经历 不过程度比较轻 那次"
  },
  {
    "start": 856.896,
    "end": 860.705,
    "text": "我决定辞去自己所进行的义工工作 做"
  },
  {
    "start": 860.705,
    "end": 862.498,
    "text": "义工的那段时间"
  },
  {
    "start": 862.498,
    "end": 864.962,
    "text": "指导我的人对我横加干涉"
  },
  {
    "start": 864.962,
    "end": 869.063,
    "text": "态度极不友好 终于有一天 我公开对"
  },
  {
    "start": 869.063,
    "end": 871.475,
    "text": "她说： 我决定离开"
  },
  {
    "start": 871.475,
    "end": 874.128,
    "text": "此言一出 我如释重负"
  },
  {
    "start": 874.128,
    "end": 878.183,
    "text": "有一种特别轻松、终于获得解脱的感觉"
  },
  {
    "start": 878.889,
    "end": 882.431,
    "text": "是的 那一刻你体验到了坚定地立足于"
  },
  {
    "start": 882.431,
    "end": 884.514,
    "text": "自己中心的感受  我"
  },
  {
    "start": 884.514,
    "end": 886.805,
    "text": "认为 我觉得 我希望"
  },
  {
    "start": 886.805,
    "end": 890.182,
    "text": "不仅如此 你也采取了相应的行动"
  },
  {
    "start": 890.182,
    "end": 893.784,
    "text": "这对你具有一定的疗愈作用 有时"
  },
  {
    "start": 893.784,
    "end": 896.209,
    "text": "你需要长时间地否定自己"
  },
  {
    "start": 896.209,
    "end": 898.855,
    "text": "才能实现这一突破 也因此"
  },
  {
    "start": 898.855,
    "end": 902.271,
    "text": "这一自我否定阶段并不是毫无意义的 它"
  },
  {
    "start": 902.271,
    "end": 903.979,
    "text": "使你逐渐认识到 你"
  },
  {
    "start": 903.979,
    "end": 905.876,
    "text": "再也无法继续这样下去"
  },
  {
    "start": 905.876,
    "end": 908.599,
    "text": "这一自我觉知的时刻对你来说"
  },
  {
    "start": 908.599,
    "end": 911.95,
    "text": "弥足珍贵 这一突破会使你终身受益"
  },
  {
    "start": 911.95,
    "end": 914.42,
    "text": "与R分手对你的内在成长"
  },
  {
    "start": 914.42,
    "end": 917.339,
    "text": "起到了关键的作用 从此以后"
  },
  {
    "start": 917.339,
    "end": 920.875,
    "text": "你再也没有将专制、惯于掌控他人的人"
  },
  {
    "start": 920.875,
    "end": 922.746,
    "text": "吸引到自己身边 你"
  },
  {
    "start": 922.746,
    "end": 925.242,
    "text": "开始结识柔和、内向的伴侣"
  },
  {
    "start": 925.242,
    "end": 928.455,
    "text": "他们的性格使你能够更加坚定自己的"
  },
  {
    "start": 928.455,
    "end": 931.868,
    "text": "立场 而不是依附于一位性格强硬的人"
  },
  {
    "start": 931.868,
    "end": 934.16,
    "text": "并迷失在他的能量之中"
  },
  {
    "start": 934.792,
    "end": 937.674,
    "text": "我是不是在咨询工作中以及与"
  },
  {
    "start": 937.674,
    "end": 940.999,
    "text": "顾客的关系中也陷入了同样的陷阱"
  },
  {
    "start": 941.705,
    "end": 945.803,
    "text": "是的 在某种程度上 确实如此 你"
  },
  {
    "start": 945.803,
    "end": 950.158,
    "text": "过于牺牲自己 过于努力 你追求完美"
  },
  {
    "start": 950.158,
    "end": 953.023,
    "text": "也因此不必要地过度付出 你所"
  },
  {
    "start": 953.023,
    "end": 956.297,
    "text": "需要做的其实并不像你想象的那么多"
  },
  {
    "start": 956.297,
    "end": 959.581,
    "text": "你往往以为自己必须带给人们他们所"
  },
  {
    "start": 959.581,
    "end": 963.276,
    "text": "需要的答案 以帮助他们解决问题 然而"
  },
  {
    "start": 963.276,
    "end": 966.59,
    "text": "这并非他们真正的需要 他们真正需要"
  },
  {
    "start": 966.59,
    "end": 970.1,
    "text": "而且你也能够带给他们的是能量上的转化"
  },
  {
    "start": 970.1,
    "end": 973.992,
    "text": "恐惧转化为信任 不确定感转化为内在"
  },
  {
    "start": 973.992,
    "end": 977.884,
    "text": "觉知 自我否定转化为自我理解 然后"
  },
  {
    "start": 977.884,
    "end": 980.857,
    "text": "从这一新的空间 这一充满信任与"
  },
  {
    "start": 980.857,
    "end": 982.84,
    "text": "自我欣赏的空间 重新"
  },
  {
    "start": 982.84,
    "end": 985.021,
    "text": "看一看自己所面对的问题"
  },
  {
    "start": 985.021,
    "end": 987.693,
    "text": "自行找到解决问题的方法 你"
  },
  {
    "start": 987.693,
    "end": 990.571,
    "text": "为他们提供的是转化能量的机遇"
  },
  {
    "start": 990.571,
    "end": 993.052,
    "text": "而不是解决问题的具体方法"
  },
  {
    "start": 993.684,
    "end": 996.46,
    "text": "如果我有意识地去这样做的"
  },
  {
    "start": 996.46,
    "end": 999.467,
    "text": "话 我的胃部不适就会减轻吗"
  },
  {
    "start": 1000.173,
    "end": 1002.921,
    "text": "通过降低对自己的要求就可以"
  },
  {
    "start": 1003.627,
    "end": 1004.977,
    "text": "对 没错"
  },
  {
    "start": 1005.609,
    "end": 1007.471,
    "text": "真的就这么简单"
  },
  {
    "start": 1008.177,
    "end": 1011.714,
    "text": "对 因为这样做的话 你就不会流失"
  },
  {
    "start": 1011.714,
    "end": 1015.251,
    "text": "能量 当你试图去解决他人的问题时"
  },
  {
    "start": 1015.251,
    "end": 1018.525,
    "text": "你将重心移向他人 并在这一移动"
  },
  {
    "start": 1018.525,
    "end": 1020.708,
    "text": "过程中失去自我 这时"
  },
  {
    "start": 1020.708,
    "end": 1022.89,
    "text": "你往往倾尽一切努力"
  },
  {
    "start": 1022.89,
    "end": 1026.053,
    "text": "不仅运用自己的大脑帮他们思考 还"
  },
  {
    "start": 1026.053,
    "end": 1029.414,
    "text": "运用自己的第三眼来帮助他们确定方向"
  },
  {
    "start": 1029.414,
    "end": 1032.933,
    "text": "所有这一切尝试、努力与付出都导致了你"
  },
  {
    "start": 1032.933,
    "end": 1034.497,
    "text": "胃部——第三脉轮"
  },
  {
    "start": 1034.497,
    "end": 1036.648,
    "text": "所处的位置——的紧张感"
  },
  {
    "start": 1036.648,
    "end": 1039.167,
    "text": "然而 你需要做的根本不是为"
  },
  {
    "start": 1039.167,
    "end": 1041.88,
    "text": "他们解决问题 而是让他们看到"
  },
  {
    "start": 1041.88,
    "end": 1044.217,
    "text": "他们有能力自己解决问题"
  },
  {
    "start": 1044.848,
    "end": 1048.966,
    "text": "许多人都认为 我具有灵视力 能够看到"
  },
  {
    "start": 1048.966,
    "end": 1051.024,
    "text": "他们自己所看不到的"
  },
  {
    "start": 1051.024,
    "end": 1053.769,
    "text": "事情 我不是很喜欢这一点"
  },
  {
    "start": 1053.769,
    "end": 1056.918,
    "text": "就是说 我这个具有灵视力的人知道"
  },
  {
    "start": 1056.918,
    "end": 1060.461,
    "text": "他们所不知道的“客观事物” 这意味着"
  },
  {
    "start": 1060.461,
    "end": 1065.034,
    "text": "解决他们问题的方法来自外在 比如："
  },
  {
    "start": 1065.034,
    "end": 1067.321,
    "text": "我是否该辞职 是否"
  },
  {
    "start": 1067.321,
    "end": 1069.862,
    "text": "该结束这段关系  等"
  },
  {
    "start": 1069.862,
    "end": 1073.473,
    "text": "然而 真正的答案总是来自内在"
  },
  {
    "start": 1073.473,
    "end": 1077.084,
    "text": "我希望自己能够在这一层面上工作"
  },
  {
    "start": 1077.79,
    "end": 1081.512,
    "text": "确实如此 你必须解释给人们听 对他们"
  },
  {
    "start": 1081.512,
    "end": 1085.235,
    "text": "说明 你不会具体告诉他们是否该做某事"
  },
  {
    "start": 1085.235,
    "end": 1088.242,
    "text": "也不会具体地为他们指出人生之路"
  },
  {
    "start": 1088.874,
    "end": 1092.619,
    "text": "你会于内在层面上帮助他们 告诉他们该"
  },
  {
    "start": 1092.619,
    "end": 1094.491,
    "text": "如何面对恐惧与负面"
  },
  {
    "start": 1094.491,
    "end": 1096.987,
    "text": "能量 如何面对自身的情绪"
  },
  {
    "start": 1096.987,
    "end": 1100.587,
    "text": "如何脚踏实地地生活 如何设定界限"
  },
  {
    "start": 1100.587,
    "end": 1104.138,
    "text": "以及如何与自己的直觉和灵魂建立联结"
  },
  {
    "start": 1104.138,
    "end": 1107.898,
    "text": "等诸如此类的事情 这才是你的工作领域"
  },
  {
    "start": 1108.529,
    "end": 1111.898,
    "text": "嗯 是这样的 被看作 传达"
  },
  {
    "start": 1111.898,
    "end": 1115.785,
    "text": "神谕的人  我对此真是厌倦透顶"
  },
  {
    "start": 1116.491,
    "end": 1118.824,
    "text": "那好 现在好好地感受"
  },
  {
    "start": 1118.824,
    "end": 1121.157,
    "text": "一下 你对此厌倦透顶"
  },
  {
    "start": 1121.788,
    "end": 1123.723,
    "text": "我对此也很生气"
  },
  {
    "start": 1124.429,
    "end": 1125.332,
    "text": "为什么"
  },
  {
    "start": 1125.963,
    "end": 1129.837,
    "text": "我认为人们在我这里寻求答案是一种幼稚"
  },
  {
    "start": 1129.837,
    "end": 1131.773,
    "text": "的行为 与此同时"
  },
  {
    "start": 1131.773,
    "end": 1133.925,
    "text": "我又觉得自己能力有限"
  },
  {
    "start": 1133.925,
    "end": 1137.435,
    "text": "无法提供他们想要的答案 这时"
  },
  {
    "start": 1137.435,
    "end": 1140.946,
    "text": "我就会心生恐惧 害怕自己会失败"
  },
  {
    "start": 1140.946,
    "end": 1142.781,
    "text": "害怕人们说： 你才"
  },
  {
    "start": 1142.781,
    "end": 1145.024,
    "text": "不是真正的通灵者呢"
  },
  {
    "start": 1145.73,
    "end": 1148.07,
    "text": "你想当一个“真正的通灵者”吗"
  },
  {
    "start": 1148.701,
    "end": 1151.791,
    "text": "我不知道 我想要帮助人们"
  },
  {
    "start": 1151.791,
    "end": 1155.137,
    "text": "自内向外地解脱与觉醒 不过"
  },
  {
    "start": 1155.137,
    "end": 1158.641,
    "text": "我确实偶尔有利用自己的灵视力帮助过"
  },
  {
    "start": 1158.641,
    "end": 1162.144,
    "text": "他人（告诉他们在生活中具体怎样做）"
  },
  {
    "start": 1162.144,
    "end": 1166.303,
    "text": "他们很是高兴 我为他们的感激而满心"
  },
  {
    "start": 1166.303,
    "end": 1170.462,
    "text": "愉悦 难道这是我逐渐执着于此的原因"
  },
  {
    "start": 1170.462,
    "end": 1174.743,
    "text": "因此我不知不觉要求自己必须要做一个"
  },
  {
    "start": 1174.743,
    "end": 1177.009,
    "text": "优秀的通灵者 其实"
  },
  {
    "start": 1177.009,
    "end": 1179.527,
    "text": "我本来对此毫无兴趣"
  },
  {
    "start": 1179.527,
    "end": 1184.567,
    "text": "这一生中 我一直对哲学、心理学和灵性"
  },
  {
    "start": 1184.567,
    "end": 1186.807,
    "text": "思想深感兴趣 对"
  },
  {
    "start": 1186.807,
    "end": 1189.887,
    "text": "内在生活的规律性感兴趣"
  },
  {
    "start": 1189.887,
    "end": 1194.023,
    "text": "我与约书亚的合作与此有着很好的衔接"
  },
  {
    "start": 1194.729,
    "end": 1197.489,
    "text": "是的 这才是你真正想做的"
  },
  {
    "start": 1197.489,
    "end": 1200.25,
    "text": "是你进行自我实现的领域"
  },
  {
    "start": 1200.25,
    "end": 1203.689,
    "text": "你无须为了他人而扮演通灵者的角色"
  },
  {
    "start": 1203.689,
    "end": 1205.914,
    "text": "卸下这一责任负担吧 你"
  },
  {
    "start": 1205.914,
    "end": 1208.139,
    "text": "认为这是他人对你的期待"
  },
  {
    "start": 1208.139,
    "end": 1210.965,
    "text": "认为自己应该为他们充当这一"
  },
  {
    "start": 1210.965,
    "end": 1214.226,
    "text": "角色 尽管如此 你对此半心半意"
  },
  {
    "start": 1214.226,
    "end": 1217.84,
    "text": "因为你害怕自己没有这个能力 一方面"
  },
  {
    "start": 1217.84,
    "end": 1219.447,
    "text": "因着这一恐惧 你"
  },
  {
    "start": 1219.447,
    "end": 1221.655,
    "text": "觉得自己必须要竭尽全力"
  },
  {
    "start": 1221.655,
    "end": 1223.939,
    "text": "必须要更加努力地工作"
  },
  {
    "start": 1223.939,
    "end": 1227.468,
    "text": "另一方面 你又因此而感到气愤与烦恼"
  },
  {
    "start": 1227.468,
    "end": 1230.133,
    "text": "觉得人们向你提出此类问题"
  },
  {
    "start": 1230.133,
    "end": 1233.463,
    "text": "实在是愚蠢 然而 正是因为恐惧"
  },
  {
    "start": 1233.463,
    "end": 1236.823,
    "text": "人们才绝望地向你提出一个迫切的人生"
  },
  {
    "start": 1236.823,
    "end": 1238.8,
    "text": "问题： 我该如何做"
  },
  {
    "start": 1238.8,
    "end": 1240.974,
    "text": "也恰恰就在这种情况下"
  },
  {
    "start": 1240.974,
    "end": 1243.901,
    "text": "“立足于自己的中心”才是正道"
  },
  {
    "start": 1243.901,
    "end": 1247.413,
    "text": "不要任由他人透过第三脉轮将你拽离中心"
  },
  {
    "start": 1247.413,
    "end": 1250.186,
    "text": "不去满足对方希望得到某一具体"
  },
  {
    "start": 1250.186,
    "end": 1253.158,
    "text": "答案的迫切需要 这并非你的任务"
  },
  {
    "start": 1253.789,
    "end": 1258.098,
    "text": "当人们如此迫切与绝望地恳请我时 我"
  },
  {
    "start": 1258.098,
    "end": 1260.38,
    "text": "往往会有一种窒息、"
  },
  {
    "start": 1260.38,
    "end": 1262.914,
    "text": "僵硬或者说瘫痪的感觉"
  },
  {
    "start": 1262.914,
    "end": 1266.613,
    "text": "约书亚透过我来回答问题时 总是"
  },
  {
    "start": 1266.613,
    "end": 1270.311,
    "text": "专注于帮助人们创造能量上的转化"
  },
  {
    "start": 1270.311,
    "end": 1274.388,
    "text": "而不是给出具体的建议 一切都进行得"
  },
  {
    "start": 1274.388,
    "end": 1278.704,
    "text": "非常顺利 然而 我自己回答问题的时候"
  },
  {
    "start": 1278.704,
    "end": 1281.74,
    "text": "却总觉得自己没有这个能力 觉得"
  },
  {
    "start": 1281.74,
    "end": 1284.777,
    "text": "自己应该给出更具体的回答 因此"
  },
  {
    "start": 1284.777,
    "end": 1287.376,
    "text": "心中常常徘徊着一种"
  },
  {
    "start": 1287.376,
    "end": 1290.842,
    "text": "不确定感 唯恐令对方失望"
  },
  {
    "start": 1291.548,
    "end": 1295.233,
    "text": "这种恐惧与不确定感对你的第三脉轮造成"
  },
  {
    "start": 1295.233,
    "end": 1297.281,
    "text": "了一定的影响 约书亚"
  },
  {
    "start": 1297.281,
    "end": 1299.532,
    "text": "的回答帮助人们回归自己"
  },
  {
    "start": 1299.532,
    "end": 1302.91,
    "text": "而你则试图将他们揽入怀中 约书亚"
  },
  {
    "start": 1302.91,
    "end": 1306.498,
    "text": "的能量为你创造了能够立足中心的空间"
  },
  {
    "start": 1306.498,
    "end": 1309.449,
    "text": "而你内在那个满心恐惧的小孩却认为"
  },
  {
    "start": 1309.449,
    "end": 1312.769,
    "text": "自己不可以这样做： 我可不能如此强大"
  },
  {
    "start": 1312.769,
    "end": 1316.097,
    "text": "更不用说将所有这些能量都揽为己"
  },
  {
    "start": 1316.097,
    "end": 1319.646,
    "text": "有 不能这样 否则我会遭到惩罚的"
  },
  {
    "start": 1319.646,
    "end": 1322.628,
    "text": "”这就是你那内在小孩的想法 “"
  },
  {
    "start": 1322.628,
    "end": 1326.206,
    "text": "贬低自己 迎合他人 已经成了她的习惯"
  },
  {
    "start": 1326.838,
    "end": 1330.52,
    "text": "如果我想在工作上开创新局面 就必须"
  },
  {
    "start": 1330.52,
    "end": 1334.201,
    "text": "将这一内在小孩的能量进行转化 对吗"
  },
  {
    "start": 1334.201,
    "end": 1337.41,
    "text": "我必须敢于做一个坚强与独立的人"
  },
  {
    "start": 1338.116,
    "end": 1342.005,
    "text": "是的 这部分内在小孩的能量之所以存在"
  },
  {
    "start": 1342.005,
    "end": 1344.958,
    "text": "与你来地球轮回的方式有着密切的"
  },
  {
    "start": 1344.958,
    "end": 1348.5,
    "text": "关系：你带着满心的抗拒来到了这个世界"
  },
  {
    "start": 1349.132,
    "end": 1351.227,
    "text": "这一否定自己、努力去"
  },
  {
    "start": 1351.227,
    "end": 1353.532,
    "text": "获取他人认可的内在小孩"
  },
  {
    "start": 1353.532,
    "end": 1355.482,
    "text": "存在的根源在于：你"
  },
  {
    "start": 1355.482,
    "end": 1357.866,
    "text": "踏上轮回之旅时缺乏信任"
  },
  {
    "start": 1357.866,
    "end": 1361.325,
    "text": "如果你能够解决这一问题 建立起对地球"
  },
  {
    "start": 1361.325,
    "end": 1364.784,
    "text": "生活的信任 对当下的地球生活说“是”"
  },
  {
    "start": 1364.784,
    "end": 1368.195,
    "text": "就能够从中获得力量 你的内在小孩"
  },
  {
    "start": 1368.195,
    "end": 1371.819,
    "text": "会因此获得宁静 而你也变得更加坚定"
  },
  {
    "start": 1371.819,
    "end": 1374.402,
    "text": "无须再在他人身上苦苦寻找"
  },
  {
    "start": 1374.402,
    "end": 1377.632,
    "text": "温暖与安全感 你明白我的意思吗"
  },
  {
    "start": 1378.263,
    "end": 1380.884,
    "text": "嗯 谢谢你 而且"
  },
  {
    "start": 1380.884,
    "end": 1383.882,
    "text": "通过积极正向的方式（建立"
  },
  {
    "start": 1383.882,
    "end": 1387.38,
    "text": "信任）而不是负面的方式（比如"
  },
  {
    "start": 1387.38,
    "end": 1390.45,
    "text": "与恐惧做斗争或者纠正内在"
  },
  {
    "start": 1390.45,
    "end": 1393.776,
    "text": "小孩的心理）来解决这一问题"
  },
  {
    "start": 1393.776,
    "end": 1397.775,
    "text": "这个想法不错 那我如何才能建立信任呢"
  },
  {
    "start": 1398.48,
    "end": 1400.736,
    "text": "借由接纳当下的自己"
  },
  {
    "start": 1400.736,
    "end": 1402.991,
    "text": "你无须去刻意改变自己"
  },
  {
    "start": 1402.991,
    "end": 1406.153,
    "text": "我并不是说你必须用“这里很美很好”"
  },
  {
    "start": 1406.153,
    "end": 1409.501,
    "text": "等话语来说服自己放下对这个世界的抵触"
  },
  {
    "start": 1409.501,
    "end": 1411.777,
    "text": "所有形式的说服都是一种"
  },
  {
    "start": 1411.777,
    "end": 1414.259,
    "text": "抗争 要接纳自己的抵触感"
  },
  {
    "start": 1414.259,
    "end": 1418.008,
    "text": "以理解之心拥抱这一感受： 我很理解你"
  },
  {
    "start": 1418.008,
    "end": 1420.09,
    "text": "对地球生活的抵触感"
  },
  {
    "start": 1420.09,
    "end": 1422.173,
    "text": "我不会评判你 我爱你"
  },
  {
    "start": 1422.173,
    "end": 1423.617,
    "text": "全然地接纳你"
  },
  {
    "start": 1424.249,
    "end": 1427.566,
    "text": "嗯 我开始写这篇日记之前"
  },
  {
    "start": 1427.566,
    "end": 1430.883,
    "text": "已经试着这样做了 那一刻"
  },
  {
    "start": 1430.883,
    "end": 1434.542,
    "text": "我立刻感受到自己踏上轮回之旅"
  },
  {
    "start": 1434.542,
    "end": 1438.462,
    "text": "时那强烈的忧伤、孤独与愤愤不平"
  },
  {
    "start": 1438.462,
    "end": 1442.007,
    "text": "虽然当时我心中百感交集 却只说"
  },
  {
    "start": 1442.007,
    "end": 1445.788,
    "text": "了一句： 哦 我可爱美丽的小女孩"
  },
  {
    "start": 1445.788,
    "end": 1449.276,
    "text": "说话对象正是那个阴暗、固执的"
  },
  {
    "start": 1449.276,
    "end": 1452.997,
    "text": "存有——抗拒轮回的我 我泪流满面"
  },
  {
    "start": 1452.997,
    "end": 1456.79,
    "text": "并用内在之眼“看到”那个阴暗的"
  },
  {
    "start": 1456.79,
    "end": 1460.835,
    "text": "存有身上开始散射出明亮的绿松石光"
  },
  {
    "start": 1460.835,
    "end": 1464.977,
    "text": "她内在的某一部分似乎被触动 开始"
  },
  {
    "start": 1464.977,
    "end": 1467.307,
    "text": "渐渐消融 我在身体"
  },
  {
    "start": 1467.307,
    "end": 1469.896,
    "text": "层面上也感受到这一点"
  },
  {
    "start": 1469.896,
    "end": 1471.501,
    "text": "就在我的胃部"
  },
  {
    "start": 1472.207,
    "end": 1475.478,
    "text": "你开启了她内在的某一部分 嗯"
  },
  {
    "start": 1475.478,
    "end": 1478.968,
    "text": "这是好事 你已经解决了一部分问题"
  },
  {
    "start": 1478.968,
    "end": 1482.213,
    "text": "也完全能够解决剩下的问题 解决"
  },
  {
    "start": 1482.213,
    "end": 1485.676,
    "text": "方法就是：以一颗理解之心看待自己"
  },
  {
    "start": 1485.676,
    "end": 1488.407,
    "text": "“抗争”永远不是解决问题的方法"
  },
  {
    "start": 1489.039,
    "end": 1493.202,
    "text": "解决这一问题以及建基于其上的生存机制"
  },
  {
    "start": 1493.202,
    "end": 1495.515,
    "text": "——“自我牺牲”——"
  },
  {
    "start": 1495.515,
    "end": 1497.828,
    "text": "是一个循序渐进的过程"
  },
  {
    "start": 1497.828,
    "end": 1499.894,
    "text": "对吗 这期间我能"
  },
  {
    "start": 1499.894,
    "end": 1503.769,
    "text": "重新开始工作吗 我得休息多久呢"
  },
  {
    "start": 1504.475,
    "end": 1507.422,
    "text": "这尚是未知 要顺其自然"
  },
  {
    "start": 1507.422,
    "end": 1510.615,
    "text": "恢复之前 你是不需要工作的"
  },
  {
    "start": 1511.246,
    "end": 1515.604,
    "text": "最近这几年 每次举办工作坊 尤其是"
  },
  {
    "start": 1515.604,
    "end": 1519.961,
    "text": "大型集会之前 我总会感到恐惧与紧张"
  },
  {
    "start": 1519.961,
    "end": 1522.699,
    "text": "这种状况是否会减轻呢"
  },
  {
    "start": 1523.405,
    "end": 1526.891,
    "text": "会的 要有信心 这一阶段的经历"
  },
  {
    "start": 1526.891,
    "end": 1530.376,
    "text": "会使你于内在层面上学到很多东西"
  },
  {
    "start": 1533.125,
    "end": 1537.841,
    "text": "2009年7月8日今天我又感受到了与"
  },
  {
    "start": 1537.841,
    "end": 1542.556,
    "text": "约书亚的联结 前些日子 他是如此遥远"
  },
  {
    "start": 1543.262,
    "end": 1547.269,
    "text": "我害怕他的能量 他的能量是如此"
  },
  {
    "start": 1547.269,
    "end": 1551.809,
    "text": "强大且直指人心 而且我怕他会评判我"
  },
  {
    "start": 1551.809,
    "end": 1555.621,
    "text": "因为我为了自己的病症而沮丧忧郁"
  },
  {
    "start": 1555.621,
    "end": 1559.687,
    "text": "整日清泪涟涟 刚刚我出去散步时"
  },
  {
    "start": 1559.687,
    "end": 1563.854,
    "text": "忽然感到他就陪在我身边 像兄长一般"
  },
  {
    "start": 1563.854,
    "end": 1568.022,
    "text": "对我没有一丝一毫的评判 他对我说"
  },
  {
    "start": 1568.022,
    "end": 1572.375,
    "text": "他不会评判我 我可以有任何情绪"
  },
  {
    "start": 1572.375,
    "end": 1575.095,
    "text": "无论是恐惧、孤独还是"
  },
  {
    "start": 1575.095,
    "end": 1577.816,
    "text": "忧伤 他全然地接受我"
  },
  {
    "start": 1577.816,
    "end": 1581.104,
    "text": "如我所是的样子 接受这个驻于"
  },
  {
    "start": 1581.104,
    "end": 1584.393,
    "text": "人类肉身的我 这使我深受感动"
  },
  {
    "start": 1584.393,
    "end": 1587.047,
    "text": "他终于又回到我的身旁"
  },
  {
    "start": 1587.753,
    "end": 1591.223,
    "text": "我也“看到”了关于未来的一个画面"
  },
  {
    "start": 1591.223,
    "end": 1594.693,
    "text": "刚刚 我连续两次抽到塔罗牌“死神”"
  },
  {
    "start": 1594.693,
    "end": 1598.99,
    "text": "它意味着新事物的开端 约书亚的沉静与"
  },
  {
    "start": 1598.99,
    "end": 1601.138,
    "text": "自我觉知使我感到"
  },
  {
    "start": 1601.138,
    "end": 1604.003,
    "text": "我自己也要向这一方向发展"
  },
  {
    "start": 1604.003,
    "end": 1606.893,
    "text": "亦即 在我所进行的咨询"
  },
  {
    "start": 1606.893,
    "end": 1610.045,
    "text": "工作中保持沉静与自我觉知"
  },
  {
    "start": 1610.045,
    "end": 1613.299,
    "text": "并于内在专注于适宜自己、"
  },
  {
    "start": 1613.299,
    "end": 1617.365,
    "text": "自然流动的事情 放下其他的一切"
  },
  {
    "start": 1617.365,
    "end": 1621.852,
    "text": "心中不再充满烦恼、怀疑与喧噪 坚守"
  },
  {
    "start": 1621.852,
    "end": 1623.964,
    "text": "自己的中心 不再"
  },
  {
    "start": 1623.964,
    "end": 1626.867,
    "text": "执着于他人的反应与看法"
  },
  {
    "start": 1626.867,
    "end": 1630.338,
    "text": "真正地信任希望流经我的能量"
  },
  {
    "start": 1630.338,
    "end": 1632.569,
    "text": "而不是认为自己必须"
  },
  {
    "start": 1632.569,
    "end": 1635.048,
    "text": "去无中生有地创造它们"
  },
  {
    "start": 1635.048,
    "end": 1639.613,
    "text": "这也曾经是我的恐惧之一 我害怕自己"
  },
  {
    "start": 1639.613,
    "end": 1644.179,
    "text": "所传导的讯息其实都是源于自己的创造"
  },
  {
    "start": 1644.179,
    "end": 1647.92,
    "text": "因此我必须竭尽全力 做好"
  },
  {
    "start": 1647.92,
    "end": 1651.973,
    "text": "这一切 然而 事实并非如此"
  },
  {
    "start": 1651.973,
    "end": 1656.252,
    "text": "我进行个人传导或者举行工作坊时 总"
  },
  {
    "start": 1656.252,
    "end": 1660.782,
    "text": "有一个高于我的能量存有陪伴在我的左右"
  },
  {
    "start": 1660.782,
    "end": 1663.397,
    "text": "我能够随其而行 放下"
  },
  {
    "start": 1663.397,
    "end": 1666.273,
    "text": "所有的一切 而只是臣服"
  },
  {
    "start": 1666.979,
    "end": 1670.353,
    "text": "在上次（5月16日）的工作坊）"
  },
  {
    "start": 1670.353,
    "end": 1673.728,
    "text": "上 这一能量就非常强烈 传导时"
  },
  {
    "start": 1673.728,
    "end": 1677.489,
    "text": "我真切地感受到基督能量的承载"
  },
  {
    "start": 1677.489,
    "end": 1681.501,
    "text": "我臣服于它 不过 工作坊的前一周"
  },
  {
    "start": 1681.501,
    "end": 1686.111,
    "text": "我的心中却充满了恐惧 而且这一恐惧"
  },
  {
    "start": 1686.111,
    "end": 1688.551,
    "text": "异常强烈 工作坊后"
  },
  {
    "start": 1688.551,
    "end": 1691.263,
    "text": "再回顾这之前的感受"
  },
  {
    "start": 1691.263,
    "end": 1694.575,
    "text": "就好像经历过死亡恐惧一样"
  },
  {
    "start": 1695.28,
    "end": 1698.173,
    "text": "亲爱的约书亚 我为什么生病"
  },
  {
    "start": 1698.879,
    "end": 1701.524,
    "text": "你生病前很长一段时间 一直收到"
  },
  {
    "start": 1701.524,
    "end": 1703.464,
    "text": "各种各样的信号——透过"
  },
  {
    "start": 1703.464,
    "end": 1705.579,
    "text": "你的胃及情绪 它们提醒你"
  },
  {
    "start": 1705.579,
    "end": 1709.219,
    "text": "你的负荷已经超过了你的承受能力 你"
  },
  {
    "start": 1709.219,
    "end": 1711.574,
    "text": "无法再这样继续下去 你"
  },
  {
    "start": 1711.574,
    "end": 1713.929,
    "text": "心中充满压力 害怕失败"
  },
  {
    "start": 1713.929,
    "end": 1717.382,
    "text": "唯恐自己做得不够好 你已经被拽离自己"
  },
  {
    "start": 1717.382,
    "end": 1719.301,
    "text": "的中心 失去了与地球"
  },
  {
    "start": 1719.301,
    "end": 1721.219,
    "text": "的联结 第三脉轮失衡"
  },
  {
    "start": 1721.219,
    "end": 1725.058,
    "text": "这一脉轮（太阳神经丛）关乎你是否照顾"
  },
  {
    "start": 1725.058,
    "end": 1726.764,
    "text": "好自己 是否坚信"
  },
  {
    "start": 1726.764,
    "end": 1729.109,
    "text": "自己的力量与心中的真相"
  },
  {
    "start": 1729.109,
    "end": 1731.837,
    "text": "而且不会因为各种外在影响而变得"
  },
  {
    "start": 1731.837,
    "end": 1734.929,
    "text": "步履蹒跚 第三脉轮主管“个人力量”"
  },
  {
    "start": 1734.929,
    "end": 1738.33,
    "text": "当你传导超越人类次元的能量时"
  },
  {
    "start": 1738.33,
    "end": 1739.606,
    "text": "个人力量 是"
  },
  {
    "start": 1739.606,
    "end": 1742.369,
    "text": "不可或缺的 就是说 传导时"
  },
  {
    "start": 1742.369,
    "end": 1745.51,
    "text": "你必须坚定地立足大地 保持自我"
  },
  {
    "start": 1745.51,
    "end": 1748.859,
    "text": "作为传导的管道 你对此心怀忐忑"
  },
  {
    "start": 1748.859,
    "end": 1752.101,
    "text": "由此而生的恐惧希望能够得到你的"
  },
  {
    "start": 1752.101,
    "end": 1755.559,
    "text": "重视与疗愈 冰冻三尺 非一日之寒"
  },
  {
    "start": 1755.559,
    "end": 1758.599,
    "text": "你早已超过自己所能承受的界限"
  },
  {
    "start": 1758.599,
    "end": 1761.639,
    "text": "而这期间 恐惧一直在试图提醒你"
  },
  {
    "start": 1761.639,
    "end": 1765.055,
    "text": "希望能够获得你的关注 这也是你疾病染"
  },
  {
    "start": 1765.055,
    "end": 1766.952,
    "text": "身的原因 不过 事情"
  },
  {
    "start": 1766.952,
    "end": 1769.039,
    "text": "尚未达到积重难返的地步"
  },
  {
    "start": 1769.039,
    "end": 1770.899,
    "text": "现在你已学着为自己"
  },
  {
    "start": 1770.899,
    "end": 1773.379,
    "text": "留出时间 以重新回归自己"
  },
  {
    "start": 1773.979,
    "end": 1777.299,
    "text": "虽然疾病迫使你这样做 但你也"
  },
  {
    "start": 1777.299,
    "end": 1780.619,
    "text": "于内在感受到了这一必要 其实"
  },
  {
    "start": 1780.619,
    "end": 1783.206,
    "text": "几个月之前你便已感受到这"
  },
  {
    "start": 1783.206,
    "end": 1786.009,
    "text": "一点 不过你不肯承认与面对"
  },
  {
    "start": 1786.009,
    "end": 1788.819,
    "text": "你内心的感受完全被来自外界的"
  },
  {
    "start": 1788.819,
    "end": 1792.029,
    "text": "主意与想法淹没：不断地举办工作坊"
  },
  {
    "start": 1792.029,
    "end": 1794.3,
    "text": "安排各种各样的事情 而于"
  },
  {
    "start": 1794.3,
    "end": 1796.949,
    "text": "内心深处 你真正想要的是安宁"
  },
  {
    "start": 1796.949,
    "end": 1799.569,
    "text": "现在你得到了自己真正想要的"
  },
  {
    "start": 1800.169,
    "end": 1802.303,
    "text": "我以为“向往安宁”是"
  },
  {
    "start": 1802.303,
    "end": 1805.076,
    "text": "不好的 因为这是想逃离红尘"
  },
  {
    "start": 1805.782,
    "end": 1807.972,
    "text": "渴望安宁意味着渴望平衡"
  },
  {
    "start": 1807.972,
    "end": 1810.162,
    "text": "这是再自然不过的向往"
  },
  {
    "start": 1810.162,
    "end": 1813.412,
    "text": "你内心深处的真正向往绝不是逃离"
  },
  {
    "start": 1813.412,
    "end": 1816.662,
    "text": "红尘 恰恰相反 它是在向你展示"
  },
  {
    "start": 1816.662,
    "end": 1818.61,
    "text": "你的灵魂希望于哪些"
  },
  {
    "start": 1818.61,
    "end": 1820.992,
    "text": "面向彰显于这个物质实相"
  }
]