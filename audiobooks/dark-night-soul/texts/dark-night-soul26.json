[
  {
    "start": 0.0,
    "end": 2.842,
    "text": "第十五章  重获新生"
  },
  {
    "start": 3.548,
    "end": 5.336,
    "text": "我是约书亚 带着"
  },
  {
    "start": 5.336,
    "end": 7.795,
    "text": "喜悦与快乐来到你们身边"
  },
  {
    "start": 7.795,
    "end": 11.269,
    "text": "与你们分享已经超越地球实相的次元"
  },
  {
    "start": 11.269,
    "end": 14.961,
    "text": "——你们称之为“彼岸”的无忧与自由"
  },
  {
    "start": 14.961,
    "end": 17.835,
    "text": "“彼岸”就在此时此刻"
  },
  {
    "start": 17.835,
    "end": 21.232,
    "text": "就在你们的内在 也属于你们"
  },
  {
    "start": 21.232,
    "end": 24.128,
    "text": "身处我们这一次元的指导灵正是"
  },
  {
    "start": 24.128,
    "end": 27.644,
    "text": "你们之“高我”或者说“大我”的反射"
  },
  {
    "start": 27.644,
    "end": 31.881,
    "text": "那是你们不受限于肉身、物质实相、时间"
  },
  {
    "start": 31.881,
    "end": 36.117,
    "text": "与空间的那一部分 请回忆一下曾经的你"
  },
  {
    "start": 36.117,
    "end": 39.813,
    "text": "作为灵魂 你是多么的自由自在"
  },
  {
    "start": 39.813,
    "end": 44.247,
    "text": "可以随心所欲地去任何想去的地方 然而"
  },
  {
    "start": 44.247,
    "end": 49.258,
    "text": "在众多可能的选择之中 你选择了地球"
  },
  {
    "start": 49.258,
    "end": 54.269,
    "text": "决定来这里 以在这里尽情地体验与成长"
  },
  {
    "start": 54.269,
    "end": 57.465,
    "text": "分享自己独特的能量与品质"
  },
  {
    "start": 58.171,
    "end": 62.365,
    "text": "你们所有人都已经走过漫长的旅程"
  },
  {
    "start": 62.365,
    "end": 66.559,
    "text": "业已走过若干世纪 经历过生生世世"
  },
  {
    "start": 66.559,
    "end": 70.071,
    "text": "甚至不仅是轮回为人类 你们渴望"
  },
  {
    "start": 70.071,
    "end": 74.052,
    "text": "能够在“形相”的次元中体验 也因此"
  },
  {
    "start": 74.052,
    "end": 76.612,
    "text": "你们一次次地穿过幻相的"
  },
  {
    "start": 76.612,
    "end": 81.731,
    "text": "帷幕 放弃全然的自由 选择某一形相作为载体"
  },
  {
    "start": 81.731,
    "end": 84.307,
    "text": "这是你们有意识的选择 你们"
  },
  {
    "start": 84.307,
    "end": 87.081,
    "text": "选择了“局限” 所谓“局限”"
  },
  {
    "start": 87.081,
    "end": 91.052,
    "text": "我指的是人类的肉身以及在许多面向都"
  },
  {
    "start": 91.052,
    "end": 93.388,
    "text": "处于幻相与无明之中的"
  },
  {
    "start": 93.388,
    "end": 96.191,
    "text": "世界 你们选择了穿过帷幕"
  },
  {
    "start": 96.191,
    "end": 99.424,
    "text": "进入形相的次元 因为你们对"
  },
  {
    "start": 99.424,
    "end": 103.155,
    "text": "自己充满信心 你们曾经非常自信"
  },
  {
    "start": 103.155,
    "end": 107.753,
    "text": "带着坚强的信心来到地球 你们的灵魂知"
  },
  {
    "start": 107.753,
    "end": 109.796,
    "text": "道也感受到：我要"
  },
  {
    "start": 109.796,
    "end": 112.861,
    "text": "在这里 在地球上彰显自己"
  },
  {
    "start": 112.861,
    "end": 116.005,
    "text": "我要立足此地 忆起真正"
  },
  {
    "start": 116.005,
    "end": 119.149,
    "text": "的自己 并闪耀自身之光"
  },
  {
    "start": 119.855,
    "end": 123.08,
    "text": "你们知道这是一个艰难的历程"
  },
  {
    "start": 123.08,
    "end": 126.537,
    "text": "知道自己将会遇到重重阻碍 现在"
  },
  {
    "start": 126.537,
    "end": 130.484,
    "text": "请与当初的信心——尽管困难重重"
  },
  {
    "start": 130.484,
    "end": 135.221,
    "text": "也会成功的信心——建立联结 感受一下"
  },
  {
    "start": 135.221,
    "end": 138.113,
    "text": "在你下决心踏上地球之旅"
  },
  {
    "start": 138.113,
    "end": 141.267,
    "text": "时那更大的意识觉知的品质"
  },
  {
    "start": 141.973,
    "end": 145.439,
    "text": "你们是大师 你们于最深的本质"
  },
  {
    "start": 145.439,
    "end": 149.401,
    "text": "层面上自愿做出了来地球轮回的选择"
  },
  {
    "start": 149.401,
    "end": 153.48,
    "text": "这正展现了你们的大师品质 请感受一下"
  },
  {
    "start": 153.48,
    "end": 157.656,
    "text": "这一选择中所蕴含的力量与生命力正在"
  },
  {
    "start": 157.656,
    "end": 160.112,
    "text": "流经你的身体 就好像"
  },
  {
    "start": 160.112,
    "end": 162.814,
    "text": "你完全不受限于这一空间"
  },
  {
    "start": 162.814,
    "end": 166.984,
    "text": "不受限于你所寄居的物质形相 你是"
  },
  {
    "start": 166.984,
    "end": 169.329,
    "text": "宇宙本身的心跳 是"
  },
  {
    "start": 169.329,
    "end": 171.935,
    "text": "独立自主、自由自在的"
  },
  {
    "start": 171.935,
    "end": 175.046,
    "text": "不要被这个社会所呈现给你的"
  },
  {
    "start": 175.046,
    "end": 178.395,
    "text": "幻相主宰 不要受其局限与禁锢"
  },
  {
    "start": 178.395,
    "end": 182.583,
    "text": "你来这里是为了喜悦与自由地创造自己"
  },
  {
    "start": 182.583,
    "end": 185.047,
    "text": "想要体验的一切 周遭"
  },
  {
    "start": 185.047,
    "end": 188.004,
    "text": "社会的观点与看法并不重要"
  },
  {
    "start": 188.004,
    "end": 191.327,
    "text": "这关乎你 关乎你的灵魂之旅"
  },
  {
    "start": 192.032,
    "end": 194.691,
    "text": "这一灵魂之旅中 你其实会"
  },
  {
    "start": 194.691,
    "end": 197.349,
    "text": "经历两次出生 第一次出生"
  },
  {
    "start": 197.349,
    "end": 201.186,
    "text": "你以脆弱娇小的婴儿身体来到这个世界"
  },
  {
    "start": 201.186,
    "end": 205.193,
    "text": "受制于外在所有的影响因素：想要成长的"
  },
  {
    "start": 205.193,
    "end": 207.197,
    "text": "肉身、照顾你的父母"
  },
  {
    "start": 207.197,
    "end": 209.424,
    "text": "、你出生成长的国家等"
  },
  {
    "start": 209.424,
    "end": 211.15,
    "text": "在某种程度上"
  },
  {
    "start": 211.15,
    "end": 213.617,
    "text": "在幼小的你眼中 这些"
  },
  {
    "start": 213.617,
    "end": 218.058,
    "text": "外在因素自然而然地出现在你的生活中"
  },
  {
    "start": 218.058,
    "end": 221.77,
    "text": "它们不断地影响你 塑造你 你"
  },
  {
    "start": 221.77,
    "end": 225.482,
    "text": "的灵魂之光依然在你之内 然而"
  },
  {
    "start": 225.482,
    "end": 228.914,
    "text": "那些被你吸收、内化的外界影响"
  },
  {
    "start": 228.914,
    "end": 231.12,
    "text": "或多或少遮蔽了这一"
  },
  {
    "start": 231.12,
    "end": 233.572,
    "text": "光芒 这并不是偶然的"
  },
  {
    "start": 233.572,
    "end": 237.865,
    "text": "这是你在灵魂层面上有意识的抉择 因为"
  },
  {
    "start": 237.865,
    "end": 242.159,
    "text": "你打算日后对这些影响因素采取某种行动"
  },
  {
    "start": 242.159,
    "end": 244.817,
    "text": "你想要纳入这些外在影响"
  },
  {
    "start": 244.817,
    "end": 247.717,
    "text": "以便在日后切身体验它们"
  },
  {
    "start": 247.717,
    "end": 252.383,
    "text": "并做出自己的判断与权衡：哪些因素适合"
  },
  {
    "start": 252.383,
    "end": 254.717,
    "text": "我 哪些不适合 我"
  },
  {
    "start": 254.717,
    "end": 257.568,
    "text": "是谁 哪些本属于我自己"
  },
  {
    "start": 257.568,
    "end": 261.218,
    "text": "哪些来自外在 借由沉入其中 你"
  },
  {
    "start": 261.218,
    "end": 265.355,
    "text": "才能自内而外探索并转化这些影响因素"
  },
  {
    "start": 266.061,
    "end": 268.461,
    "text": "你们来这里并不仅仅是"
  },
  {
    "start": 268.461,
    "end": 271.581,
    "text": "为了体验 也是为了带来改变"
  },
  {
    "start": 271.581,
    "end": 275.759,
    "text": "为了带给地球充满爱、和谐与自由的新"
  },
  {
    "start": 275.759,
    "end": 277.972,
    "text": "意识 许多人都渴望"
  },
  {
    "start": 277.972,
    "end": 280.43,
    "text": "与需要这一全新的意识"
  },
  {
    "start": 280.43,
    "end": 285.319,
    "text": "如果每个人都能够于内心深处体验到自由"
  },
  {
    "start": 285.319,
    "end": 290.208,
    "text": "这个世界就不会有如此多的矛盾与冲突"
  },
  {
    "start": 290.208,
    "end": 294.425,
    "text": "如果你深刻地意识到自己的独立性与自身"
  },
  {
    "start": 294.425,
    "end": 296.299,
    "text": "的力量 就不会去"
  },
  {
    "start": 296.299,
    "end": 298.876,
    "text": "剥夺他人的独立性与力量"
  },
  {
    "start": 298.876,
    "end": 302.616,
    "text": "这正是你们想要带给地球的意识觉知"
  },
  {
    "start": 303.322,
    "end": 308.443,
    "text": "孩童的你渐渐长大 直到某一时刻 你"
  },
  {
    "start": 308.443,
    "end": 311.155,
    "text": "开始自问：我是谁"
  },
  {
    "start": 311.155,
    "end": 314.168,
    "text": "我的来源与本质是什么"
  },
  {
    "start": 314.168,
    "end": 318.338,
    "text": "哪些影响因素与我灵魂的愿望相一致"
  },
  {
    "start": 318.338,
    "end": 322.755,
    "text": "符合我的生命之流 哪些因素又并非如此"
  },
  {
    "start": 322.755,
    "end": 326.347,
    "text": "这拉开了你之“重生”过程的序幕"
  },
  {
    "start": 326.347,
    "end": 330.388,
    "text": "这是你第二次出生于地球 并非身体层面"
  },
  {
    "start": 330.388,
    "end": 334.605,
    "text": "而是灵魂层面上的诞生 随着你的不断"
  },
  {
    "start": 334.605,
    "end": 336.589,
    "text": "成长与长大 你的"
  },
  {
    "start": 336.589,
    "end": 339.318,
    "text": "灵魂也希望能够逐渐下沉"
  },
  {
    "start": 339.318,
    "end": 343.554,
    "text": "更深地沉入物质实相 当你变得成熟"
  },
  {
    "start": 343.554,
    "end": 345.797,
    "text": "个人能力日渐提高"
  },
  {
    "start": 345.797,
    "end": 348.538,
    "text": "能够独立地感受 我是谁"
  },
  {
    "start": 348.538,
    "end": 352.009,
    "text": "什么适合我 什么不适合我"
  },
  {
    "start": 352.009,
    "end": 355.747,
    "text": "时 就能够开启这一下沉的旅程"
  },
  {
    "start": 356.453,
    "end": 359.285,
    "text": "这“第二次出生”并不是一个"
  },
  {
    "start": 359.285,
    "end": 362.771,
    "text": "自然而然的过程 这是你的自愿选择"
  },
  {
    "start": 362.771,
    "end": 365.915,
    "text": "你的灵魂会不断地轻推你一下"
  },
  {
    "start": 365.915,
    "end": 369.059,
    "text": "鼓励你开始这一重生的过程"
  },
  {
    "start": 369.059,
    "end": 372.188,
    "text": "激励你不断地去探寻自己真正"
  },
  {
    "start": 372.188,
    "end": 375.317,
    "text": "是谁 又真正想要什么 不过"
  },
  {
    "start": 375.317,
    "end": 379.545,
    "text": "你也可以长时间地推迟这一过程 是的"
  },
  {
    "start": 379.545,
    "end": 381.894,
    "text": "你甚至可以在整整一生"
  },
  {
    "start": 381.894,
    "end": 384.478,
    "text": "中都拒绝聆听灵魂的声音"
  },
  {
    "start": 384.478,
    "end": 386.907,
    "text": "这无可厚非 或者说"
  },
  {
    "start": 386.907,
    "end": 390.064,
    "text": "我们并不想对此做出什么评判"
  },
  {
    "start": 390.769,
    "end": 395.144,
    "text": "然而 “认知真正的自己”是人们——更"
  },
  {
    "start": 395.144,
    "end": 399.518,
    "text": "确切地说是灵魂——一次次地轮回于地球"
  },
  {
    "start": 399.518,
    "end": 403.389,
    "text": "一次次地踏上这一探险之旅的原因"
  },
  {
    "start": 403.389,
    "end": 406.952,
    "text": "在充满幻相、恐惧与无明的"
  },
  {
    "start": 406.952,
    "end": 410.813,
    "text": "世界中找回自己的声音与心跳"
  },
  {
    "start": 410.813,
    "end": 414.21,
    "text": "这一挑战自始至终都摆在你的面前"
  },
  {
    "start": 414.916,
    "end": 418.092,
    "text": "此时此刻聆听我话语的所有人"
  },
  {
    "start": 418.092,
    "end": 421.268,
    "text": "都已经做出了“重生”的选择"
  },
  {
    "start": 421.268,
    "end": 424.672,
    "text": "这本身就是一个令人欣喜的事实"
  },
  {
    "start": 424.672,
    "end": 428.076,
    "text": "因为 一次次轮回如逝水而过"
  },
  {
    "start": 428.076,
    "end": 432.247,
    "text": "那时你们心中并没有这一强烈的“重生”"
  },
  {
    "start": 432.247,
    "end": 436.418,
    "text": "意愿 这也并不足以为怪 在这些人生中"
  },
  {
    "start": 436.418,
    "end": 440.502,
    "text": "你们被外界的影响因素淹没 也必须将"
  },
  {
    "start": 440.502,
    "end": 442.904,
    "text": "这些因素更深刻地内化"
  },
  {
    "start": 442.904,
    "end": 445.546,
    "text": "才能对灵魂说 “是”"
  },
  {
    "start": 445.546,
    "end": 448.906,
    "text": "在现实生活中真正地觉醒"
  },
  {
    "start": 449.612,
    "end": 452.808,
    "text": "你们目前所处的这一时期是一个"
  },
  {
    "start": 452.808,
    "end": 456.233,
    "text": "特殊的时期 许多人都在经历重生"
  },
  {
    "start": 456.233,
    "end": 460.201,
    "text": "这一新的能量正逐渐扎根于地球实相"
  },
  {
    "start": 460.201,
    "end": 464.417,
    "text": "这会对你的自我觉知产生深刻的影响"
  },
  {
    "start": 464.417,
    "end": 466.769,
    "text": "并唤醒激烈的内在过程"
  },
  {
    "start": 468.18,
    "end": 471.742,
    "text": "重获新生并非轻而易举之事"
  },
  {
    "start": 472.448,
    "end": 476.883,
    "text": "新生的是一种新的意识觉知 放下一切"
  },
  {
    "start": 476.883,
    "end": 481.317,
    "text": "既有的保障与安全感的意识觉知 首先"
  },
  {
    "start": 481.317,
    "end": 485.236,
    "text": "你发现自己曾经深信不疑的保障与"
  },
  {
    "start": 485.236,
    "end": 489.155,
    "text": "安全感其实都只是幻相 孩提时期"
  },
  {
    "start": 489.155,
    "end": 493.632,
    "text": "你从父母那里获得了各种各样的信念"
  },
  {
    "start": 493.632,
    "end": 498.109,
    "text": "比如该如何生活 言谈举止又该怎样等"
  },
  {
    "start": 498.109,
    "end": 502.247,
    "text": "这些教导貌似为你提供了一定的模式与"
  },
  {
    "start": 502.247,
    "end": 504.194,
    "text": "安全感 如果你的"
  },
  {
    "start": 504.194,
    "end": 507.358,
    "text": "所作所为符合这些教导与规则"
  },
  {
    "start": 507.358,
    "end": 510.759,
    "text": "就会得到表扬与肯定 孩童"
  },
  {
    "start": 510.759,
    "end": 514.16,
    "text": "的你会为此感到开心与心安"
  },
  {
    "start": 514.16,
    "end": 517.112,
    "text": "每个孩童都需要获得肯定与"
  },
  {
    "start": 517.112,
    "end": 521.292,
    "text": "安全感 希望自己是受欢迎的 也因此"
  },
  {
    "start": 521.292,
    "end": 525.443,
    "text": "一个孩童为了获得肯定而竭尽努力 这"
  },
  {
    "start": 525.443,
    "end": 527.641,
    "text": "并不是什么令人惊讶"
  },
  {
    "start": 527.641,
    "end": 530.082,
    "text": "、无法理解的事 不过"
  },
  {
    "start": 530.082,
    "end": 531.408,
    "text": "这一过程中"
  },
  {
    "start": 531.408,
    "end": 534.279,
    "text": "这个孩童也往往会失去自己"
  },
  {
    "start": 534.279,
    "end": 537.637,
    "text": "盲目遵从那些本与自己内在"
  },
  {
    "start": 537.637,
    "end": 540.994,
    "text": "感受相悖的外在信念与想法"
  },
  {
    "start": 540.994,
    "end": 544.124,
    "text": "这就是一个人的成长过程：先与"
  },
  {
    "start": 544.124,
    "end": 547.477,
    "text": "自己疏离 直到疏离到某种程度后"
  },
  {
    "start": 547.477,
    "end": 550.686,
    "text": "内在的某一能量开始站出来表示"
  },
  {
    "start": 550.686,
    "end": 554.353,
    "text": "抗议 这便是“第二次出生”的前奏"
  },
  {
    "start": 555.059,
    "end": 559.166,
    "text": "目前 你们所有人都正在经历这一过程"
  },
  {
    "start": 559.166,
    "end": 563.273,
    "text": "我们想对你们高声疾呼的是：请敬重自己"
  },
  {
    "start": 563.273,
    "end": 566.188,
    "text": "你们正在经历的是一个殊胜"
  },
  {
    "start": 566.188,
    "end": 569.103,
    "text": "的过程 不要过于关注结果"
  },
  {
    "start": 569.103,
    "end": 573.126,
    "text": "也不要紧盯着之后即将发生的事情"
  },
  {
    "start": 573.126,
    "end": 577.652,
    "text": "一心想着重生或者说破茧成蝶以后会如何"
  },
  {
    "start": 577.652,
    "end": 579.684,
    "text": "在当下这一时刻 这"
  },
  {
    "start": 579.684,
    "end": 584.427,
    "text": "一切并不重要 重要的是 先对自己心生敬重"
  },
  {
    "start": 584.427,
    "end": 588.036,
    "text": "敬重即将踏入重生之旅的你"
  },
  {
    "start": 588.742,
    "end": 592.868,
    "text": "要全然地活在当下 也许当下这一"
  },
  {
    "start": 592.868,
    "end": 597.819,
    "text": "时刻会有一些黑暗、沉重的情绪浮出水面"
  },
  {
    "start": 597.819,
    "end": 601.036,
    "text": "这些情绪一直备受压抑 它们"
  },
  {
    "start": 601.036,
    "end": 604.501,
    "text": "或许来自你的童年 也或许更早"
  },
  {
    "start": 604.501,
    "end": 609.038,
    "text": "是在若干前世中一直沉睡不醒的情绪"
  },
  {
    "start": 609.038,
    "end": 611.933,
    "text": "当你允许它们浮现并对自己"
  },
  {
    "start": 611.933,
    "end": 614.828,
    "text": "说 我不想再这样继续下去"
  },
  {
    "start": 614.828,
    "end": 618.559,
    "text": "我想在这个世界中做真正的自己 时"
  },
  {
    "start": 618.559,
    "end": 620.315,
    "text": "这些情绪就会纷纷"
  },
  {
    "start": 620.315,
    "end": 622.729,
    "text": "浮出 进入你的意识范围"
  },
  {
    "start": 623.435,
    "end": 626.844,
    "text": "这对你是一个极大的挑战 而且 你"
  },
  {
    "start": 626.844,
    "end": 628.549,
    "text": "必须自己承受这一"
  },
  {
    "start": 628.549,
    "end": 630.893,
    "text": "挑战 完完全全地一个人"
  },
  {
    "start": 630.893,
    "end": 634.738,
    "text": "这关乎你 关乎你与自己的联结与沟通"
  },
  {
    "start": 634.738,
    "end": 636.875,
    "text": "没有其他任何人能够替"
  },
  {
    "start": 636.875,
    "end": 639.225,
    "text": "你做这件事 迈出这一步"
  },
  {
    "start": 639.225,
    "end": 643.384,
    "text": "这是你自己独立与自由的选择 此外 这"
  },
  {
    "start": 643.384,
    "end": 647.543,
    "text": "也往往意味着你开始脱离自己的周遭环境"
  },
  {
    "start": 647.543,
    "end": 651.757,
    "text": "有可能 在重生过程中 某些人或者"
  },
  {
    "start": 651.757,
    "end": 656.234,
    "text": "情境依然继续存在于你的生活中 然而"
  },
  {
    "start": 656.234,
    "end": 660.802,
    "text": "更常见的则是 在朋友、（亲密）关系、"
  },
  {
    "start": 660.802,
    "end": 663.087,
    "text": "工作及居所等面向上"
  },
  {
    "start": 663.087,
    "end": 665.625,
    "text": "你会遭遇剧烈的改变"
  },
  {
    "start": 665.625,
    "end": 668.553,
    "text": "一些人和事物会从你的生活中"
  },
  {
    "start": 668.553,
    "end": 671.933,
    "text": "消失 当你决定“选择自己”之时"
  },
  {
    "start": 671.933,
    "end": 675.852,
    "text": "你生活中的一切就会发生变化"
  },
  {
    "start": 675.852,
    "end": 680.294,
    "text": "选择自己 首先意味着聆听自己 比如"
  },
  {
    "start": 680.294,
    "end": 684.709,
    "text": "我的感觉或直觉告诉我什么 我需要什么"
  },
  {
    "start": 684.709,
    "end": 687.162,
    "text": "我灵魂的愿望是什么"
  },
  {
    "start": 687.162,
    "end": 689.614,
    "text": "而不是我理应怎么做"
  },
  {
    "start": 689.614,
    "end": 693.149,
    "text": "切身地体察这一点需要勇气"
  },
  {
    "start": 693.855,
    "end": 697.225,
    "text": "尽管这是你自己的选择 但是"
  },
  {
    "start": 697.225,
    "end": 700.836,
    "text": "在这一探索之旅中你并非孑然一身"
  },
  {
    "start": 700.836,
    "end": 705.242,
    "text": "你的人生中充满了纵横交错的联结之流"
  },
  {
    "start": 705.242,
    "end": 709.907,
    "text": "横向之流将你与周遭的世界连接在一起"
  },
  {
    "start": 709.907,
    "end": 714.363,
    "text": "比如（亲密）关系、工作以及生活环境等"
  },
  {
    "start": 714.363,
    "end": 717.717,
    "text": "除了将你的地球人格与这个世界"
  },
  {
    "start": 717.717,
    "end": 720.114,
    "text": "连接起来的横向之流外"
  },
  {
    "start": 720.114,
    "end": 722.51,
    "text": "还存在着一个纵向轴"
  },
  {
    "start": 722.51,
    "end": 726.2,
    "text": "从身体层面来看 它始于海底轮"
  },
  {
    "start": 726.2,
    "end": 732.263,
    "text": "通往顶轮 或者说始于地球 通往宇宙 可以说"
  },
  {
    "start": 732.263,
    "end": 736.896,
    "text": "这是你的内在之轴 当你做出重生的选择"
  },
  {
    "start": 736.896,
    "end": 739.47,
    "text": "时 你就会或多或少地"
  },
  {
    "start": 739.47,
    "end": 742.044,
    "text": "将能量从横向轴中收回"
  },
  {
    "start": 742.044,
    "end": 745.927,
    "text": "最初你所关注的事情或环境失去了其"
  },
  {
    "start": 745.927,
    "end": 750.296,
    "text": "价值与意义 你将消耗于其中的能量收回"
  },
  {
    "start": 750.296,
    "end": 752.753,
    "text": "积聚在纵向轴上"
  },
  {
    "start": 752.753,
    "end": 756.13,
    "text": "内在的探寻之旅由此起航"
  },
  {
    "start": 756.836,
    "end": 758.903,
    "text": "在这一内在之旅中"
  },
  {
    "start": 758.903,
    "end": 763.126,
    "text": "你寻找自己与宇宙、与真我的联结——"
  },
  {
    "start": 763.126,
    "end": 767.349,
    "text": "或者说高我、灵魂以及任何其他的称呼"
  },
  {
    "start": 767.349,
    "end": 771.848,
    "text": "你的真我超越了你在此时此地的地球"
  },
  {
    "start": 771.848,
    "end": 776.91,
    "text": "人格 且远大于你的地球人格 与此同时"
  },
  {
    "start": 776.91,
    "end": 780.12,
    "text": "你也重新探索自己与地球之间的"
  },
  {
    "start": 780.12,
    "end": 783.329,
    "text": "联结：这里是否有属于我的空间"
  },
  {
    "start": 783.329,
    "end": 786.767,
    "text": "我可以在这里做本然的自己吗"
  },
  {
    "start": 786.767,
    "end": 790.205,
    "text": "带着我所有的犹疑、恐惧与情绪"
  },
  {
    "start": 790.911,
    "end": 793.695,
    "text": "我在地球上受欢迎吗 这是"
  },
  {
    "start": 793.695,
    "end": 797.175,
    "text": "徘徊在你们许多人心中的急切问题"
  },
  {
    "start": 797.881,
    "end": 801.236,
    "text": "现在 请认真地感受一下 地球"
  },
  {
    "start": 801.236,
    "end": 806.27,
    "text": "正对你大敞双臂 问候你： 是的 我欢迎你"
  },
  {
    "start": 806.27,
    "end": 809.434,
    "text": "纵然你心中有着各种各样的犹疑"
  },
  {
    "start": 809.434,
    "end": 812.598,
    "text": "、不肯定与恐惧 你是受欢迎的"
  },
  {
    "start": 812.598,
    "end": 816.926,
    "text": "请感受一下地球对你的承载与支持"
  },
  {
    "start": 816.926,
    "end": 819.218,
    "text": "地球是一个灵魂 是"
  },
  {
    "start": 819.218,
    "end": 821.764,
    "text": "精神存有 请感受一下"
  },
  {
    "start": 821.764,
    "end": 826.371,
    "text": "她的力量正经由你的双腿流入你的海底轮"
  },
  {
    "start": 827.077,
    "end": 831.589,
    "text": "此外 再同时感受一下自上而下环绕着"
  },
  {
    "start": 831.589,
    "end": 836.101,
    "text": "你的宇宙能量 你随时都能够获得帮助"
  },
  {
    "start": 836.101,
    "end": 840.326,
    "text": "你在彼岸的朋友——天使与指导灵——正"
  },
  {
    "start": 840.326,
    "end": 842.438,
    "text": "陪伴着你 自始至终"
  },
  {
    "start": 842.438,
    "end": 844.786,
    "text": "、从未间断地佑助着你"
  },
  {
    "start": 845.491,
    "end": 849.383,
    "text": "请感受一下 在这来自地球与宇宙的"
  },
  {
    "start": 849.383,
    "end": 851.573,
    "text": "能量中 你是安全的"
  },
  {
    "start": 851.573,
    "end": 854.005,
    "text": "在你踏上内在之旅时"
  },
  {
    "start": 854.005,
    "end": 856.395,
    "text": "它们会助你一臂之力 在"
  },
  {
    "start": 856.395,
    "end": 860.74,
    "text": "彼岸的我们为你们欢呼 你们都做得非常好"
  },
  {
    "start": 860.74,
    "end": 863.27,
    "text": "当你感到沮丧与忧闷之时"
  },
  {
    "start": 863.27,
    "end": 866.03,
    "text": "你以往从外界吸收的评判"
  },
  {
    "start": 866.03,
    "end": 870.129,
    "text": "那些伤害你、使你害怕的评判依然在"
  },
  {
    "start": 870.129,
    "end": 872.948,
    "text": "发挥作用 然而 如果你"
  },
  {
    "start": 872.948,
    "end": 875.766,
    "text": "真正地与纵向轴上的力量"
  },
  {
    "start": 875.766,
    "end": 879.097,
    "text": "与地球及宇宙的力量建立起联结"
  },
  {
    "start": 879.097,
    "end": 882.429,
    "text": "就会感觉到自己并非孤身一人"
  },
  {
    "start": 882.429,
    "end": 886.978,
    "text": "会感到自己是被佑助与承载的 有一股"
  },
  {
    "start": 886.978,
    "end": 889.921,
    "text": "能量之流贯穿你的人生"
  },
  {
    "start": 889.921,
    "end": 892.865,
    "text": "助你彰显自己灵魂的愿望"
  },
  {
    "start": 892.865,
    "end": 896.441,
    "text": "这一能量之流也会为你的横向轴——"
  },
  {
    "start": 896.441,
    "end": 900.242,
    "text": "你与外在世界的关系——赋予新的内涵"
  },
  {
    "start": 900.242,
    "end": 902.737,
    "text": "或许这一切并不如你所希望"
  },
  {
    "start": 902.737,
    "end": 905.232,
    "text": "的那样快速 然而 要知道"
  },
  {
    "start": 905.232,
    "end": 909.1,
    "text": "那些承载你的力量拥有自身的韵律"
  },
  {
    "start": 909.1,
    "end": 911.523,
    "text": "这一韵律与人类的愿望"
  },
  {
    "start": 911.523,
    "end": 914.672,
    "text": "之间往往存在着一定的相位差"
  },
  {
    "start": 915.378,
    "end": 917.643,
    "text": "要有耐心 一步步地"
  },
  {
    "start": 917.643,
    "end": 920.159,
    "text": "来 这并没有什么不好"
  },
  {
    "start": 920.865,
    "end": 925.533,
    "text": "你的心中有一股可以称其为直觉的能量流"
  },
  {
    "start": 925.533,
    "end": 928.127,
    "text": "自始至终 直觉一直"
  },
  {
    "start": 928.127,
    "end": 930.98,
    "text": "都在向你发出提示或信号"
  },
  {
    "start": 930.98,
    "end": 935.549,
    "text": "告诉你做什么对自己有益 又有哪些事情"
  },
  {
    "start": 935.549,
    "end": 937.833,
    "text": "不要去做 许多人都"
  },
  {
    "start": 937.833,
    "end": 940.626,
    "text": "觉得难以接近自己的直觉"
  },
  {
    "start": 940.626,
    "end": 944.006,
    "text": "因为周遭有那么多的噪音阻碍自己"
  },
  {
    "start": 944.006,
    "end": 947.611,
    "text": "这些噪音基本都是来自外界的评判"
  },
  {
    "start": 947.611,
    "end": 951.928,
    "text": "你将这些评判内化 纳入自己的世界观"
  },
  {
    "start": 951.928,
    "end": 956.245,
    "text": "这些评判往往压过甚至淹没你的直觉"
  },
  {
    "start": 956.245,
    "end": 960.24,
    "text": "为了放下这些评判 了解直觉带给自己的"
  },
  {
    "start": 960.24,
    "end": 962.459,
    "text": "讯息 至关重要的一点"
  },
  {
    "start": 962.459,
    "end": 964.9,
    "text": "是：敢于信任自己的情绪"
  },
  {
    "start": 964.9,
    "end": 967.314,
    "text": "这是因为 你的情绪——"
  },
  {
    "start": 967.314,
    "end": 973.241,
    "text": "即使它仿佛使你备受困扰——其实是想将你带回自己的直觉"
  },
  {
    "start": 973.241,
    "end": 977.223,
    "text": "那么 情绪与直觉之间又有什么关联呢"
  },
  {
    "start": 977.929,
    "end": 981.806,
    "text": "如果你长期压抑自己的直觉——心的"
  },
  {
    "start": 981.806,
    "end": 985.683,
    "text": "声音 就会出现各种各样的强烈情绪"
  },
  {
    "start": 985.683,
    "end": 989.455,
    "text": "比如愤怒、沮丧、忧伤、恐惧、"
  },
  {
    "start": 989.455,
    "end": 993.497,
    "text": "绝望与疏离感等 它们是如此明显"
  },
  {
    "start": 993.497,
    "end": 997.849,
    "text": "继续忽视它们几乎是不可能的事 情绪"
  },
  {
    "start": 997.849,
    "end": 1002.202,
    "text": "为你铺展通往内在的路 它们是指路牌"
  },
  {
    "start": 1002.202,
    "end": 1004.325,
    "text": "将你带向直觉最初以"
  },
  {
    "start": 1004.325,
    "end": 1007.155,
    "text": "柔和的形式展示给你的东西"
  },
  {
    "start": 1007.861,
    "end": 1010.924,
    "text": "要信任自己的情绪 尽管它们"
  },
  {
    "start": 1010.924,
    "end": 1013.987,
    "text": "有时使你感到难以承受 但是"
  },
  {
    "start": 1013.987,
    "end": 1018.342,
    "text": "它们之中蕴含着你之灵魂想要带给你的"
  },
  {
    "start": 1018.342,
    "end": 1020.647,
    "text": "讯息 如果你真的与"
  },
  {
    "start": 1020.647,
    "end": 1023.721,
    "text": "自己的情绪沟通 聆听它们"
  },
  {
    "start": 1023.721,
    "end": 1028.02,
    "text": "接纳它们 就会发现 你之内在 存在"
  },
  {
    "start": 1028.02,
    "end": 1032.318,
    "text": "着一些被压抑的东西 这是你并未听到"
  },
  {
    "start": 1032.318,
    "end": 1035.861,
    "text": "或者尚未充分彰显的内在渴望"
  },
  {
    "start": 1035.861,
    "end": 1040.162,
    "text": "真正又真实的内在渴望 透过情绪之痛"
  },
  {
    "start": 1040.162,
    "end": 1042.241,
    "text": "你会听到灵魂的声音"
  },
  {
    "start": 1042.947,
    "end": 1047.062,
    "text": "因此 为了找回通往直觉之路并最终"
  },
  {
    "start": 1047.062,
    "end": 1049.377,
    "text": "放下来自外在的影响"
  },
  {
    "start": 1049.377,
    "end": 1051.949,
    "text": "与评判 至关重要的是"
  },
  {
    "start": 1051.949,
    "end": 1055.368,
    "text": "聆听自己的情绪 看一看你"
  },
  {
    "start": 1055.368,
    "end": 1059.642,
    "text": "一天中最常感受到哪些情绪 往往"
  },
  {
    "start": 1059.642,
    "end": 1063.525,
    "text": "总有一个最为强烈的情绪影响你的"
  },
  {
    "start": 1063.525,
    "end": 1067.926,
    "text": "心情 借由有意识、毫不评判地接纳它"
  },
  {
    "start": 1067.926,
    "end": 1071.394,
    "text": "你就会重新找到通往直觉之路"
  },
  {
    "start": 1072.1,
    "end": 1076.289,
    "text": "现在 就在此时此刻 请选出最近"
  },
  {
    "start": 1076.289,
    "end": 1080.758,
    "text": "使你备受困扰的情绪 觉察这一情绪"
  },
  {
    "start": 1080.758,
    "end": 1085.197,
    "text": "它是愤怒、失望、忧伤还是绝望 欢迎"
  },
  {
    "start": 1085.197,
    "end": 1087.286,
    "text": "这一情绪：你能在"
  },
  {
    "start": 1087.286,
    "end": 1090.158,
    "text": "自己的身体中感受到它吗"
  },
  {
    "start": 1090.158,
    "end": 1093.762,
    "text": "它是否被困在你身体的某个部位 将"
  },
  {
    "start": 1093.762,
    "end": 1097.816,
    "text": "意识专注在这个部位 对其说 “是 ”"
  },
  {
    "start": 1097.816,
    "end": 1100.846,
    "text": "真诚、发自内心地说 “是 ”"
  },
  {
    "start": 1101.552,
    "end": 1105.176,
    "text": "如此这般 你就会加速“重生”的"
  },
  {
    "start": 1105.176,
    "end": 1109.04,
    "text": "内在进程 要全然地接纳自己的情绪"
  },
  {
    "start": 1109.04,
    "end": 1112.151,
    "text": "它的存在并没有什么不好 对它"
  },
  {
    "start": 1112.151,
    "end": 1115.483,
    "text": "说： 我接纳你 借由对你的接纳"
  },
  {
    "start": 1115.483,
    "end": 1119.071,
    "text": "我会明白你想要带给我的讯息"
  },
  {
    "start": 1119.071,
    "end": 1122.659,
    "text": "然后顺其自然 静观其变"
  },
  {
    "start": 1122.659,
    "end": 1126.804,
    "text": "看一看你能否感受到这一情绪带给你的"
  },
  {
    "start": 1126.804,
    "end": 1128.755,
    "text": "讯息 你可以想象"
  },
  {
    "start": 1128.755,
    "end": 1131.438,
    "text": "一个孩童出现在你的面前"
  },
  {
    "start": 1131.438,
    "end": 1135.679,
    "text": "对你高声大喊 聆听这一呼唤 告诉你的"
  },
  {
    "start": 1135.679,
    "end": 1138.035,
    "text": "内在小孩 他完全可以"
  },
  {
    "start": 1138.035,
    "end": 1140.391,
    "text": "自由地表达自己的想法"
  },
  {
    "start": 1140.391,
    "end": 1144.669,
    "text": "对其说 从现在开始你要好好地呵护他"
  },
  {
    "start": 1145.375,
    "end": 1148.981,
    "text": "从出生于地球的那一刻起 幼小的你"
  },
  {
    "start": 1148.981,
    "end": 1152.812,
    "text": "被交付给父母、周遭环境以及这个世界"
  },
  {
    "start": 1152.812,
    "end": 1157.097,
    "text": "在其影响与塑造下渐渐长大 现在"
  },
  {
    "start": 1157.097,
    "end": 1160.212,
    "text": "你以温柔、慈爱的方式将"
  },
  {
    "start": 1160.212,
    "end": 1163.892,
    "text": "自己的内在小孩接回自己心中"
  },
  {
    "start": 1163.892,
    "end": 1166.753,
    "text": "请告诉你的内在小孩： 我们"
  },
  {
    "start": 1166.753,
    "end": 1169.834,
    "text": "属于彼此 从现在起我要照顾你"
  },
  {
    "start": 1169.834,
    "end": 1174.078,
    "text": "你的内在小孩将你带回自己的心与直觉"
  },
  {
    "start": 1174.784,
    "end": 1177.795,
    "text": "情绪是回归心灵的必经之路"
  },
  {
    "start": 1177.795,
    "end": 1180.806,
    "text": "它们是内在旅程的起始点"
  },
  {
    "start": 1180.806,
    "end": 1183.243,
    "text": "如果你能够拥抱与接纳"
  },
  {
    "start": 1183.243,
    "end": 1186.166,
    "text": "自身那些沉重与黑暗的情绪"
  },
  {
    "start": 1186.166,
    "end": 1190.149,
    "text": "你重获新生的内在过程就会变得更加"
  },
  {
    "start": 1190.149,
    "end": 1194.629,
    "text": "轻松与快乐一些 也许这一过程极其激烈"
  },
  {
    "start": 1194.629,
    "end": 1197.902,
    "text": "甚至彻底颠覆了你 尽管"
  },
  {
    "start": 1197.902,
    "end": 1202.067,
    "text": "如此 你依然会从中感受到喜悦"
  },
  {
    "start": 1202.773,
    "end": 1204.816,
    "text": "如果你对那些使你备受"
  },
  {
    "start": 1204.816,
    "end": 1207.064,
    "text": "困扰的情绪说 “是 ”"
  },
  {
    "start": 1207.77,
    "end": 1211.011,
    "text": "接纳它们 它们就会与你合作"
  },
  {
    "start": 1211.011,
    "end": 1214.253,
    "text": "为你展示灵魂最初带给你的讯息"
  },
  {
    "start": 1214.253,
    "end": 1216.452,
    "text": "这会使你备感宁静与"
  },
  {
    "start": 1216.452,
    "end": 1223.294,
    "text": "放松 再没有任何事情比 不断地与自己抗争 违背心愿而行"
  },
  {
    "start": 1223.294,
    "end": 1227.503,
    "text": "不断地评判自己 更为沉重与艰难的了"
  },
  {
    "start": 1227.503,
    "end": 1232.125,
    "text": "我们衷心希望你们能够接纳本然的自己而"
  },
  {
    "start": 1232.125,
    "end": 1234.436,
    "text": "重获安宁与放松 也"
  },
  {
    "start": 1234.436,
    "end": 1237.261,
    "text": "因此 在本次传导的开始"
  },
  {
    "start": 1237.261,
    "end": 1240.814,
    "text": "我们就要带给你们无忧与喜悦的能量"
  },
  {
    "start": 1240.814,
    "end": 1244.591,
    "text": "请感受一下这一能量 就在此时此地"
  },
  {
    "start": 1244.591,
    "end": 1248.545,
    "text": "这一能量此时就在这间屋子里 或者渗透"
  },
  {
    "start": 1248.545,
    "end": 1250.742,
    "text": "你正在阅读的文字中"
  },
  {
    "start": 1250.742,
    "end": 1252.939,
    "text": "请接受你所需要的一切"
  },
  {
    "start": 1252.939,
    "end": 1256.783,
    "text": "这是宇宙 也是我们发自内心的赠予"
  }
]