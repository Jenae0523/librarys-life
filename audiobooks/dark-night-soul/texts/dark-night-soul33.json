[
  {
    "start": 0.0,
    "end": 2.025,
    "text": "遭受性侵的女子"
  },
  {
    "start": 2.731,
    "end": 5.817,
    "text": "在我接下来看到的前世中 我"
  },
  {
    "start": 5.817,
    "end": 9.14,
    "text": "显然生活在艰难困苦的平民世界"
  },
  {
    "start": 9.846,
    "end": 14.219,
    "text": "我最先看到一位女性 她大约25岁左右"
  },
  {
    "start": 14.219,
    "end": 16.406,
    "text": "蜷缩在一个黑暗、"
  },
  {
    "start": 16.406,
    "end": 19.078,
    "text": "肮脏的谷仓或马棚的角落"
  },
  {
    "start": 19.078,
    "end": 23.458,
    "text": "我身材苗条 不过很结实 皮肤白皙"
  },
  {
    "start": 23.458,
    "end": 25.777,
    "text": "棕色的短发 棕色的"
  },
  {
    "start": 25.777,
    "end": 28.869,
    "text": "眼睛 我于腹部感受到恐惧"
  },
  {
    "start": 28.869,
    "end": 32.79,
    "text": "门口出现了一个满身泥泞的人"
  },
  {
    "start": 33.496,
    "end": 38.407,
    "text": "透过泥泞 我看到一个男人的脸 他大约42"
  },
  {
    "start": 38.407,
    "end": 42.335,
    "text": "岁的样子 棕色的眼睛 虚伪的表情"
  },
  {
    "start": 42.335,
    "end": 46.407,
    "text": "满口黄牙 还散发着臭味 他心怀恶意"
  },
  {
    "start": 46.407,
    "end": 50.479,
    "text": "我也无法与他交流 因为他没有这个水平"
  },
  {
    "start": 50.479,
    "end": 53.641,
    "text": "我根本无法与他进行什么谈话"
  },
  {
    "start": 53.641,
    "end": 57.029,
    "text": "他好像是个监管 他来自社会底层"
  },
  {
    "start": 57.029,
    "end": 61.219,
    "text": "凭着狡诈向上爬到了村中一个还算有点小"
  },
  {
    "start": 61.219,
    "end": 63.547,
    "text": "权的职位 他性格粗鲁"
  },
  {
    "start": 63.547,
    "end": 66.107,
    "text": "心中充满了烦恼与愤懑"
  },
  {
    "start": 66.107,
    "end": 69.43,
    "text": "富于攻击性 我是他家的女佣"
  },
  {
    "start": 69.43,
    "end": 72.991,
    "text": "负责做家务 我也住在他家谷仓中"
  },
  {
    "start": 72.991,
    "end": 76.51,
    "text": "他很喜欢将我呼来喝去 使唤我"
  },
  {
    "start": 76.51,
    "end": 80.264,
    "text": "因为他看出我在某些方面对他很轻蔑"
  },
  {
    "start": 80.97,
    "end": 84.573,
    "text": "我比他进化程度高 不过这并不"
  },
  {
    "start": 84.573,
    "end": 88.949,
    "text": "是因为这一世 而是此前的一世 现在"
  },
  {
    "start": 88.949,
    "end": 91.716,
    "text": "我生活在一个妇女地位低下的"
  },
  {
    "start": 91.716,
    "end": 94.695,
    "text": "封建时代 我无法脱离这个家庭"
  },
  {
    "start": 95.401,
    "end": 97.805,
    "text": "我来自一个平民家庭"
  },
  {
    "start": 97.805,
    "end": 100.929,
    "text": "在家中我几乎得不到任何关注"
  },
  {
    "start": 100.929,
    "end": 104.914,
    "text": "我天生就拥有很高的灵性发展程度以及"
  },
  {
    "start": 104.914,
    "end": 108.898,
    "text": "随之而来的傲慢自大 在这位监管眼中"
  },
  {
    "start": 108.898,
    "end": 111.858,
    "text": "我这是骄傲 是对他的挑衅"
  },
  {
    "start": 112.564,
    "end": 116.164,
    "text": "他屡屡强奸我 我感到这很肮脏"
  },
  {
    "start": 116.164,
    "end": 118.563,
    "text": "发自内心地厌恶他 我"
  },
  {
    "start": 118.563,
    "end": 120.963,
    "text": "试着忘掉这一切 可是"
  },
  {
    "start": 120.963,
    "end": 124.546,
    "text": "却无法抹去内心深处的耻辱感"
  },
  {
    "start": 124.546,
    "end": 128.128,
    "text": "最初 我还比较稚嫩与脆弱"
  },
  {
    "start": 128.128,
    "end": 132.504,
    "text": "被奸污后总是感到极度的痛苦与悲伤 也"
  },
  {
    "start": 132.504,
    "end": 134.692,
    "text": "根本不理解这一行为"
  },
  {
    "start": 134.692,
    "end": 137.122,
    "text": "后来——之后的几年"
  },
  {
    "start": 137.122,
    "end": 141.395,
    "text": "我于内在变得麻木与扭曲 我对他的恨"
  },
  {
    "start": 141.395,
    "end": 143.657,
    "text": "越来越深 并试图在"
  },
  {
    "start": 143.657,
    "end": 146.17,
    "text": "心理上操控他 报复他"
  },
  {
    "start": 146.17,
    "end": 149.976,
    "text": "他的“自我”是他最大的弱点 我试着"
  },
  {
    "start": 149.976,
    "end": 151.99,
    "text": "影响与操纵他 通过"
  },
  {
    "start": 151.99,
    "end": 154.677,
    "text": "间接影响他在工作上的决定"
  },
  {
    "start": 154.677,
    "end": 158.201,
    "text": "我也在他家为自己争得了一些权力"
  },
  {
    "start": 158.907,
    "end": 163.343,
    "text": "我很寂寞 因为事实上我的生活中只有他"
  },
  {
    "start": 163.343,
    "end": 165.807,
    "text": "这一个人 随着时间的"
  },
  {
    "start": 165.807,
    "end": 168.271,
    "text": "流逝 随着年龄的增长"
  },
  {
    "start": 168.271,
    "end": 172.265,
    "text": "我开始希望能够从他那里获得一些爱"
  },
  {
    "start": 172.265,
    "end": 176.26,
    "text": "有时 我甚至坐在谷仓中等待他的到来"
  },
  {
    "start": 176.26,
    "end": 180.11,
    "text": "每次他来找我发泄肉欲 我都暗中希望"
  },
  {
    "start": 180.11,
    "end": 183.96,
    "text": "他能够在肉体接触时对我 对我这个人"
  },
  {
    "start": 183.96,
    "end": 186.048,
    "text": "流露出一丝感情"
  },
  {
    "start": 186.754,
    "end": 189.786,
    "text": "我们毕竟已经多年同住在一个"
  },
  {
    "start": 189.786,
    "end": 193.05,
    "text": "屋檐下 不过 他从未这样做过"
  },
  {
    "start": 193.05,
    "end": 196.888,
    "text": "他在干草堆上与我发生性行为 然后"
  },
  {
    "start": 196.888,
    "end": 200.727,
    "text": "站起身来 看都不看我一眼 就离开了"
  },
  {
    "start": 200.727,
    "end": 204.891,
    "text": "我继续躺在那里 满心的屈辱与失望"
  },
  {
    "start": 204.891,
    "end": 209.055,
    "text": "每一次 我都希望能够得到他的一些爱"
  },
  {
    "start": 209.055,
    "end": 213.25,
    "text": "哪怕只有一点点 因为我的内心是如此"
  },
  {
    "start": 213.25,
    "end": 215.471,
    "text": "寂寞 后来 我已经"
  },
  {
    "start": 215.471,
    "end": 218.432,
    "text": "不再痛恨我们之间的性行为"
  },
  {
    "start": 218.432,
    "end": 222.77,
    "text": "甚至开始暗自享受这一过程 这是一种"
  },
  {
    "start": 222.77,
    "end": 225.321,
    "text": "充满矛盾的享受 屈从"
  },
  {
    "start": 225.321,
    "end": 227.873,
    "text": "与权欲强烈地掺杂其中"
  },
  {
    "start": 227.873,
    "end": 232.348,
    "text": "性行为结束后 我才会感到强烈的耻辱"
  },
  {
    "start": 232.348,
    "end": 237.085,
    "text": "、肮脏与寂寞 我就像一头被捕猎的动物"
  },
  {
    "start": 237.085,
    "end": 241.564,
    "text": "心中备感孤寂 渴望能够得到一丝丝的爱"
  },
  {
    "start": 241.564,
    "end": 244.052,
    "text": "或者至少他能够将我"
  },
  {
    "start": 244.052,
    "end": 246.788,
    "text": "当人看 我一直没有生育"
  },
  {
    "start": 246.788,
    "end": 250.892,
    "text": "后来 他的夫人去世了 不过我还是"
  },
  {
    "start": 250.892,
    "end": 255.251,
    "text": "仆从身份 他死后 我依然住在他们家"
  },
  {
    "start": 255.251,
    "end": 258.2,
    "text": "更加寂寞孤单 可能 我又"
  },
  {
    "start": 258.2,
    "end": 261.64,
    "text": "继续给他业已成年的子女当仆人"
  },
  {
    "start": 262.346,
    "end": 266.821,
    "text": "我独自死在一间小屋中（它分为两部分"
  },
  {
    "start": 266.821,
    "end": 269.308,
    "text": "分别供做饭与起居之用"
  },
  {
    "start": 269.308,
    "end": 271.794,
    "text": "） 好像是心脏病突发"
  },
  {
    "start": 271.794,
    "end": 275.716,
    "text": "或者某种突然使我无法呼吸的病变"
  },
  {
    "start": 275.716,
    "end": 279.883,
    "text": "我看到自己依墙而坐 抽搐着慢慢倒下"
  },
  {
    "start": 279.883,
    "end": 284.293,
    "text": "那时我大约60岁出头的样子 寂寞又"
  },
  {
    "start": 284.293,
    "end": 286.887,
    "text": "麻木 我无需向任何人"
  },
  {
    "start": 286.887,
    "end": 289.741,
    "text": "告别 也没有人会想念我"
  },
  {
    "start": 289.741,
    "end": 293.399,
    "text": "我看到自己眼珠凸出 然后停止了"
  },
  {
    "start": 293.399,
    "end": 297.545,
    "text": "呼吸 我离开身体后 有天使来迎接我"
  },
  {
    "start": 297.545,
    "end": 301.45,
    "text": "可是我不肯接受他们温柔的爱与慰藉"
  },
  {
    "start": 301.45,
    "end": 305.584,
    "text": "我带着一颗僵硬与扭曲的心完成了这一世"
  },
  {
    "start": 305.584,
    "end": 309.373,
    "text": "浑身散发着晦暗与忧郁的能量 我"
  },
  {
    "start": 309.373,
    "end": 313.415,
    "text": "变得异常冷漠 心中不再有温暖与光"
  },
  {
    "start": 313.415,
    "end": 317.578,
    "text": "却充满了业已凝固与石化的愤怒 这"
  },
  {
    "start": 317.578,
    "end": 322.261,
    "text": "一世为我留下一个危险的遗产：这一生中"
  },
  {
    "start": 322.261,
    "end": 324.8,
    "text": "唯一让我略觉“快乐”的"
  },
  {
    "start": 324.8,
    "end": 328.031,
    "text": "只有掺杂着权力与掌控的性行为"
  },
  {
    "start": 328.031,
    "end": 332.232,
    "text": "我带着对性的扭曲观念结束了这一世"
  }
]