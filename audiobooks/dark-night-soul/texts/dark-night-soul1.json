[
  {
    "start": 0.0,
    "end": 1.6280000000000001,
    "text": "灵魂的暗夜"
  },
  {
    "start": 2.334,
    "end": 5.899,
    "text": "帕梅拉自述和约书亚的传导"
  },
  {
    "start": 6.605,
    "end": 9.384,
    "text": "2010年3月11日 我"
  },
  {
    "start": 9.384,
    "end": 12.395,
    "text": "在一辆救护车中被紧紧地捆着"
  },
  {
    "start": 12.395,
    "end": 16.357,
    "text": "救护车急速驶向一家医院的精神病科"
  },
  {
    "start": 16.357,
    "end": 18.454,
    "text": "透过车窗 蒂尔堡的"
  },
  {
    "start": 18.454,
    "end": 20.784,
    "text": "街道在我眼前快速闪过"
  },
  {
    "start": 20.784,
    "end": 23.624,
    "text": "这些街道上留下了我多年"
  },
  {
    "start": 23.624,
    "end": 30.852,
    "text": "的脚印 层层叠叠的脚印 生活的脚印 幸福的脚印 在这里"
  },
  {
    "start": 30.852,
    "end": 34.978,
    "text": "我有自己蒸蒸日上的咨询事业  在这里"
  },
  {
    "start": 34.978,
    "end": 38.929,
    "text": "我与我的人生伴侣还有我们美丽可爱的"
  },
  {
    "start": 38.929,
    "end": 42.88,
    "text": "女儿幸福、快乐地生活在一起 而现在"
  },
  {
    "start": 42.88,
    "end": 46.603,
    "text": "我感到自己已被人生无情地抛弃"
  },
  {
    "start": 46.603,
    "end": 50.327,
    "text": "永逐门外 我失去了与他人的联结"
  },
  {
    "start": 50.327,
    "end": 54.705,
    "text": "心中唯一的希望便是：让自己消失 只是"
  },
  {
    "start": 54.705,
    "end": 56.894,
    "text": "我不知道如何才能就"
  },
  {
    "start": 56.894,
    "end": 59.57,
    "text": "这么凭空消失 永不再回"
  },
  {
    "start": 60.275,
    "end": 64.545,
    "text": "我已跌入灵魂暗夜的最低谷 而这灵魂"
  },
  {
    "start": 64.545,
    "end": 66.805,
    "text": "暗夜并非始于这一天"
  },
  {
    "start": 66.805,
    "end": 69.317,
    "text": "早在2009年春天"
  },
  {
    "start": 69.317,
    "end": 73.56,
    "text": "夜幕便已降临 那时我胃部极度不适"
  },
  {
    "start": 73.56,
    "end": 78.068,
    "text": "恐惧阵阵袭来 渐渐地 我越陷越深"
  },
  {
    "start": 78.068,
    "end": 81.639,
    "text": "陷入恐惧与痛苦之中 并最终"
  },
  {
    "start": 81.639,
    "end": 85.758,
    "text": "患上抑郁症 甚至精神病 这期间"
  },
  {
    "start": 85.758,
    "end": 89.489,
    "text": "我经历了一些完全超越我知识范畴"
  },
  {
    "start": 89.489,
    "end": 93.468,
    "text": "的意识状态 真可谓是一次暗界之旅"
  },
  {
    "start": 94.174,
    "end": 98.286,
    "text": "不过 我恢复得倒是很快 快得令人惊讶"
  },
  {
    "start": 98.286,
    "end": 100.343,
    "text": "住院一个月后 我"
  },
  {
    "start": 100.343,
    "end": 102.627,
    "text": "从这可怕的噩梦中醒来"
  },
  {
    "start": 102.627,
    "end": 106.733,
    "text": "感觉自己又获重生 好像我必须先"
  },
  {
    "start": 106.733,
    "end": 110.838,
    "text": "跌至谷底 才能重新站起来 是的"
  },
  {
    "start": 110.838,
    "end": 112.622,
    "text": "正如这一英语俚语"
  },
  {
    "start": 112.622,
    "end": 115.0,
    "text": "hittingrock-"
  },
  {
    "start": 115.0,
    "end": 117.378,
    "text": "bottom 的精彩描述"
  },
  {
    "start": 117.378,
    "end": 120.778,
    "text": "跌至最深的谷底 无可再低"
  },
  {
    "start": 120.778,
    "end": 124.177,
    "text": "不过 我并没有枉此一行"
  },
  {
    "start": 124.177,
    "end": 127.192,
    "text": "我带着新的觉知以及对生命"
  },
  {
    "start": 127.192,
    "end": 130.206,
    "text": "更大的臣服从谷底走了出来"
  },
  {
    "start": 130.912,
    "end": 133.989,
    "text": "回顾这令人心悸的一年 我"
  },
  {
    "start": 133.989,
    "end": 140.144,
    "text": "认识到其中蕴含着灵性意义 当时 我对此一无所知"
  },
  {
    "start": 140.144,
    "end": 145.06,
    "text": "毫无觉察 我感到迷失、绝望 没有方向"
  },
  {
    "start": 145.06,
    "end": 147.791,
    "text": "不知该何去何从 这"
  },
  {
    "start": 147.791,
    "end": 150.522,
    "text": "本书如同一次探索之旅"
  },
  {
    "start": 150.522,
    "end": 153.834,
    "text": "探索我人生的意义 并试图"
  },
  {
    "start": 153.834,
    "end": 157.145,
    "text": "理解、诠释我所经历的一切"
  },
  {
    "start": 157.145,
    "end": 161.6,
    "text": "本书的第一部分是对我那灵魂暗夜的真实"
  },
  {
    "start": 161.6,
    "end": 166.055,
    "text": "写照 记述了我如何一路下跌、落至谷底"
  },
  {
    "start": 166.055,
    "end": 169.459,
    "text": "又如何挣扎着力图避免这一切"
  },
  {
    "start": 169.459,
    "end": 173.593,
    "text": "以及坠入谷底最终为我带来了哪些收获"
  },
  {
    "start": 173.593,
    "end": 175.906,
    "text": "书中摘录了许多我在"
  },
  {
    "start": 175.906,
    "end": 178.99,
    "text": "日记中记录下来的内在对话"
  },
  {
    "start": 178.99,
    "end": 182.136,
    "text": "与自己以及与我的指导灵"
  },
  {
    "start": 182.136,
    "end": 185.281,
    "text": "所进行的内在对话 此外"
  },
  {
    "start": 185.281,
    "end": 187.347,
    "text": "我身边的两个人——我的"
  },
  {
    "start": 187.347,
    "end": 190.541,
    "text": "先生格里特以及一位闺蜜——讲述了"
  },
  {
    "start": 190.541,
    "end": 193.186,
    "text": "他们在我的灵魂暗夜时分"
  },
  {
    "start": 193.186,
    "end": 197.034,
    "text": "体验到的困惑、无助以及获得的洞见"
  },
  {
    "start": 197.74,
    "end": 201.958,
    "text": "除了我自己的经历 第一部分还探讨了"
  },
  {
    "start": 201.958,
    "end": 204.44,
    "text": "精神病症在我身处灵魂"
  },
  {
    "start": 204.44,
    "end": 206.922,
    "text": "暗夜时分所扮演的角色"
  },
  {
    "start": 206.922,
    "end": 209.695,
    "text": "就个人情况而言 我对精神"
  },
  {
    "start": 209.695,
    "end": 212.699,
    "text": "病症常规治疗的看法并不负面"
  },
  {
    "start": 212.699,
    "end": 216.647,
    "text": "住院治疗以及医生所使用的药物对我的"
  },
  {
    "start": 216.647,
    "end": 218.97,
    "text": "恢复起到了至关重要的"
  },
  {
    "start": 218.97,
    "end": 221.525,
    "text": "作用 然而 我并不否认"
  },
  {
    "start": 221.525,
    "end": 225.042,
    "text": "精神病症的常规治疗方法确实有其"
  },
  {
    "start": 225.042,
    "end": 229.028,
    "text": "片面、纯理性的一面以及不必要的冷峻"
  },
  {
    "start": 229.028,
    "end": 232.738,
    "text": "真诚建议人们能够在灵性疗愈与"
  },
  {
    "start": 232.738,
    "end": 236.714,
    "text": "常规治疗之间筑起一座桥梁 此外"
  },
  {
    "start": 236.714,
    "end": 239.936,
    "text": "我在第一部分最后一章还讨论了"
  },
  {
    "start": 239.936,
    "end": 243.388,
    "text": "灵修领域中可能会出现的过度行为"
  },
  {
    "start": 243.388,
    "end": 245.629,
    "text": "诸如盲目信任通灵能力"
  },
  {
    "start": 245.629,
    "end": 248.093,
    "text": "以及过高估计女性能量等"
  },
  {
    "start": 248.093,
    "end": 250.276,
    "text": "此类行为坐实了社会"
  },
  {
    "start": 250.276,
    "end": 256.338,
    "text": "对现代灵性修习的偏见（例如模糊不清、虚无缥缈等）"
  },
  {
    "start": 256.338,
    "end": 261.151,
    "text": "甚至还可能会导致当事人心理失衡 成熟"
  },
  {
    "start": 261.151,
    "end": 265.964,
    "text": "、踏实的灵性修习不会使一个人与世隔绝"
  },
  {
    "start": 265.964,
    "end": 269.608,
    "text": "而会让他与地球实相建立坚实"
  },
  {
    "start": 269.608,
    "end": 273.253,
    "text": "的联结 双足稳稳地扎根大地"
  },
  {
    "start": 273.959,
    "end": 277.266,
    "text": "这本书的第二部分由一系列与"
  },
  {
    "start": 277.266,
    "end": 280.573,
    "text": "灵魂暗夜有关的传导讯息组成"
  },
  {
    "start": 280.573,
    "end": 284.117,
    "text": "传导讯息是借由内在沟通（心灵"
  },
  {
    "start": 284.117,
    "end": 287.661,
    "text": "感应）从指导灵那里获取的讯息"
  },
  {
    "start": 287.661,
    "end": 290.035,
    "text": "内在沟通的前提条件是"
  },
  {
    "start": 290.035,
    "end": 292.409,
    "text": "信息接收者（传导者）"
  },
  {
    "start": 292.409,
    "end": 295.451,
    "text": "对超越地球次元的指导灵所"
  },
  {
    "start": 295.451,
    "end": 298.492,
    "text": "具有的能量及智慧敞开自己"
  },
  {
    "start": 298.492,
    "end": 302.039,
    "text": "所谓“敞开”就是说：于内在放空"
  },
  {
    "start": 302.039,
    "end": 305.587,
    "text": "自己 放下自己的逻辑思维与评判"
  },
  {
    "start": 305.587,
    "end": 308.334,
    "text": "在敏感的接收状态下传导"
  },
  {
    "start": 308.334,
    "end": 311.831,
    "text": "指导灵带来的讯息 传导过程中"
  },
  {
    "start": 311.831,
    "end": 316.433,
    "text": "我总是处于一种宁静且深受启迪的状态"
  },
  {
    "start": 316.433,
    "end": 321.034,
    "text": "而且我自始至终都保持着自己的独立意识"
  },
  {
    "start": 321.034,
    "end": 324.125,
    "text": "觉知指导灵借由我说出的"
  },
  {
    "start": 324.125,
    "end": 328.059,
    "text": "每一个词 就是说 传导讯息时"
  },
  {
    "start": 328.059,
    "end": 331.169,
    "text": "我并未被指导灵“关闭”或“接管”"
  },
  {
    "start": 331.169,
    "end": 334.084,
    "text": "——这也并非我所愿 在我眼中"
  },
  {
    "start": 334.084,
    "end": 338.688,
    "text": "“通灵传导”是传导者与指导灵之间的"
  },
  {
    "start": 338.688,
    "end": 341.666,
    "text": "合作 传导者为超越地球"
  },
  {
    "start": 341.666,
    "end": 344.645,
    "text": "次元的智慧赋予地球形相"
  },
  {
    "start": 344.645,
    "end": 349.19,
    "text": "然而 即使传导者处于最深、最开放的"
  },
  {
    "start": 349.19,
    "end": 351.597,
    "text": "接收状态 这些讯息"
  },
  {
    "start": 351.597,
    "end": 354.805,
    "text": "也是被他转换成人类语言的"
  },
  {
    "start": 354.805,
    "end": 356.71,
    "text": "就是说 这总是一个"
  },
  {
    "start": 356.71,
    "end": 358.827,
    "text": "“转译”的过程 因此"
  },
  {
    "start": 358.827,
    "end": 362.847,
    "text": "我们必须注意的是：每一则传导讯息都"
  },
  {
    "start": 362.847,
    "end": 366.866,
    "text": "会受到传导者的心理与文化背景的影响"
  },
  {
    "start": 366.866,
    "end": 370.977,
    "text": "关于这一点 我已在此前出版的几本书"
  },
  {
    "start": 370.977,
    "end": 373.153,
    "text": "以及我的网站上有过"
  },
  {
    "start": 373.153,
    "end": 376.055,
    "text": "详细的讨论 此处不再赘述"
  },
  {
    "start": 376.761,
    "end": 379.932,
    "text": "我于2002年开始进行传导"
  },
  {
    "start": 379.932,
    "end": 383.348,
    "text": "那时 约书亚的能量不期而至"
  },
  {
    "start": 383.348,
    "end": 385.556,
    "text": "虽然我并未在宗教环境中"
  },
  {
    "start": 385.556,
    "end": 387.965,
    "text": "长大 然而 从孩提时代起"
  },
  {
    "start": 387.965,
    "end": 391.237,
    "text": "我就对早期的基督教精神感到"
  },
  {
    "start": 391.237,
    "end": 395.013,
    "text": "熟悉与亲切 尽管如此 那天晚上"
  },
  {
    "start": 395.013,
    "end": 398.559,
    "text": "当约书亚（他正是如此介绍自己的："
  },
  {
    "start": 398.559,
    "end": 400.553,
    "text": "约书亚·本·约瑟夫"
  },
  {
    "start": 400.553,
    "end": 402.77,
    "text": "）忽然出现于我的内在"
  },
  {
    "start": 402.77,
    "end": 406.853,
    "text": "说他想要我传导一些讯息时 我真是"
  },
  {
    "start": 406.853,
    "end": 410.937,
    "text": "大吃一惊 那时的我可谓是百感交集"
  },
  {
    "start": 410.937,
    "end": 414.341,
    "text": "感动、荣幸、害怕、怀疑"
  },
  {
    "start": 414.341,
    "end": 418.596,
    "text": "心中更是充满了惊奇与浓厚的兴趣"
  },
  {
    "start": 419.302,
    "end": 421.304,
    "text": "在我们最初的对话中"
  },
  {
    "start": 421.304,
    "end": 426.911,
    "text": "约书亚这样介绍自己：我曾生活在你们中间 被你们称为耶稣"
  },
  {
    "start": 426.911,
    "end": 430.614,
    "text": "然而 我不是教会传统中的耶稣"
  },
  {
    "start": 430.614,
    "end": 434.318,
    "text": "也不是宗教经典所描述的耶稣"
  },
  {
    "start": 434.318,
    "end": 438.109,
    "text": "我是约书亚·本·约瑟夫 也曾经是一个"
  },
  {
    "start": 438.109,
    "end": 440.215,
    "text": "具有血肉之躯的人 我"
  },
  {
    "start": 440.215,
    "end": 442.532,
    "text": "比你们提前触及基督意识"
  },
  {
    "start": 442.532,
    "end": 445.703,
    "text": "然而 这是在你们尚无法理解"
  },
  {
    "start": 445.703,
    "end": 448.874,
    "text": "与想象的力量的佑助下实现的"
  },
  {
    "start": 448.874,
    "end": 451.737,
    "text": "这是一个宇宙事件——我只是"
  },
  {
    "start": 451.737,
    "end": 454.6,
    "text": "志愿为此付出自己的一份力量"
  },
  {
    "start": 455.306,
    "end": 459.279,
    "text": "这并不容易 我未能成功地将上帝宏大"
  },
  {
    "start": 459.279,
    "end": 463.487,
    "text": "、无限的爱带给当时生活在地球上的人们"
  },
  {
    "start": 463.487,
    "end": 467.799,
    "text": "那时人们对此无法理解 我来得过早"
  },
  {
    "start": 467.799,
    "end": 472.366,
    "text": "这如同向鱼池中抛掷石头：池鱼纷纷游走"
  },
  {
    "start": 472.366,
    "end": 476.399,
    "text": "石头坠入池底 然而 水面"
  },
  {
    "start": 476.399,
    "end": 480.432,
    "text": "上的涟漪久久荡漾 可以说"
  },
  {
    "start": 480.432,
    "end": 483.462,
    "text": "我当初想带给地球的意识觉知就像"
  },
  {
    "start": 483.462,
    "end": 486.693,
    "text": "那块石头一样 继续在“水下”做工"
  },
  {
    "start": 486.693,
    "end": 490.064,
    "text": "而水面上则笼罩着“误解”的"
  },
  {
    "start": 490.064,
    "end": 493.694,
    "text": "雾霭 那些被我的能量触动的人"
  },
  {
    "start": 493.694,
    "end": 496.096,
    "text": "不知该如何将其融入"
  },
  {
    "start": 496.096,
    "end": 499.299,
    "text": "他们自己的精神与物质实相"
  },
  {
    "start": 500.005,
    "end": 504.652,
    "text": "使基督意识根植于地球 这需要漫长的"
  },
  {
    "start": 504.652,
    "end": 506.839,
    "text": "时间 不过 现在"
  },
  {
    "start": 506.839,
    "end": 510.12,
    "text": "时机已到 我再次回到这里"
  },
  {
    "start": 510.12,
    "end": 514.435,
    "text": "透过许多人说话 试图抵达每一个希望"
  },
  {
    "start": 514.435,
    "end": 516.72,
    "text": "聆听我、每一个能够"
  },
  {
    "start": 516.72,
    "end": 519.258,
    "text": "以寂静之心听懂我的人"
  },
  {
    "start": 519.258,
    "end": 521.36,
    "text": "我不说教 也不评判"
  },
  {
    "start": 521.36,
    "end": 523.694,
    "text": "我只是想让你们知道"
  },
  {
    "start": 523.694,
    "end": 526.019,
    "text": "你们所有人都拥有那"
  },
  {
    "start": 526.019,
    "end": 529.636,
    "text": "取之不尽、永不枯竭的爱之源泉"
  },
  {
    "start": 530.342,
    "end": 532.638,
    "text": "我是一个更伟大的觉知、"
  },
  {
    "start": 532.638,
    "end": 535.352,
    "text": "一个更伟大的生命体的一部分"
  },
  {
    "start": 535.352,
    "end": 536.075,
    "text": "我——"
  },
  {
    "start": 536.075,
    "end": 538.724,
    "text": "约书亚——是这一生命体"
  },
  {
    "start": 538.724,
    "end": 541.855,
    "text": "轮回于地球的那一部分能量"
  },
  {
    "start": 541.855,
    "end": 543.269,
    "text": "我不是很喜欢"
  },
  {
    "start": 543.269,
    "end": 546.095,
    "text": "“耶稣”这个称呼 因为它"
  },
  {
    "start": 546.095,
    "end": 549.392,
    "text": "总使人联想到教会对我的描述"
  },
  {
    "start": 549.392,
    "end": 553.858,
    "text": "而这一描述与真正的我相距甚远"
  },
  {
    "start": 553.858,
    "end": 557.107,
    "text": "教会为我树立的形象早已远远"
  },
  {
    "start": 557.107,
    "end": 561.107,
    "text": "偏离我当初想带给地球的讯息 因此"
  },
  {
    "start": 561.107,
    "end": 563.188,
    "text": "我希望你们能够放下"
  },
  {
    "start": 563.188,
    "end": 565.963,
    "text": "这一传统观念 重新认识我"
  },
  {
    "start": 566.669,
    "end": 570.356,
    "text": "我是约书亚 一个有血有肉的人 我是"
  },
  {
    "start": 570.356,
    "end": 572.308,
    "text": "你们的朋友与兄弟"
  },
  {
    "start": 572.308,
    "end": 574.91,
    "text": "了解人类生活的每一个面向"
  },
  {
    "start": 574.91,
    "end": 580.303,
    "text": "我于你们亦师亦友 不要怕我 像拥抱"
  },
  {
    "start": 580.303,
    "end": 585.695,
    "text": "家人那样拥抱我吧 我们本就是一家人"
  },
  {
    "start": 586.401,
    "end": 589.212,
    "text": "我所传导的约书亚讯息业已"
  },
  {
    "start": 589.212,
    "end": 592.726,
    "text": "编辑成册 目前已经出版了几本书"
  },
  {
    "start": 593.432,
    "end": 597.449,
    "text": "我欣喜地看到 这些讯息触动了许多人"
  },
  {
    "start": 597.449,
    "end": 601.703,
    "text": "这是我从未想到的 约书亚到来几年后"
  },
  {
    "start": 601.703,
    "end": 605.464,
    "text": "基督能量的两位女性承载者也来到我的"
  },
  {
    "start": 605.464,
    "end": 607.676,
    "text": "身边：圣母玛利亚与抹"
  },
  {
    "start": 607.676,
    "end": 610.109,
    "text": "大拉的玛利亚 从此以后"
  },
  {
    "start": 610.109,
    "end": 613.813,
    "text": "我也开始传导她们带来的讯息 本书的"
  },
  {
    "start": 613.813,
    "end": 615.774,
    "text": "第二部分收录了一些"
  },
  {
    "start": 615.774,
    "end": 618.171,
    "text": "来自这三个讯息源的讯息"
  },
  {
    "start": 618.171,
    "end": 620.834,
    "text": "它们都与“灵魂暗夜”这一"
  },
  {
    "start": 620.834,
    "end": 623.498,
    "text": "主题有着直接或间接的关系"
  },
  {
    "start": 623.498,
    "end": 628.359,
    "text": "目的是带给大家关于内在成长与觉知的"
  },
  {
    "start": 628.359,
    "end": 633.221,
    "text": "、清晰明了的爱的信息 值得一提的是"
  },
  {
    "start": 633.221,
    "end": 637.19,
    "text": "在阅读这些传导讯息的过程中 你所感"
  },
  {
    "start": 637.19,
    "end": 639.524,
    "text": "受到的能量氛围与文字"
  },
  {
    "start": 639.524,
    "end": 641.859,
    "text": "所带来的讯息同样重要"
  },
  {
    "start": 641.859,
    "end": 645.366,
    "text": "如果你因此而得到启迪、安慰与"
  },
  {
    "start": 645.366,
    "end": 649.374,
    "text": "鼓励 目的便已达到 借由这些讯息"
  },
  {
    "start": 649.374,
    "end": 653.848,
    "text": "你能够与自己的灵魂建立联结 在这一"
  },
  {
    "start": 653.848,
    "end": 658.322,
    "text": "智慧之源 你可以找到所有问题的答案"
  },
  {
    "start": 659.028,
    "end": 663.796,
    "text": "此处 我想衷心感谢一些人 他们不仅在"
  },
  {
    "start": 663.796,
    "end": 665.915,
    "text": "我的灵魂暗夜时分"
  },
  {
    "start": 665.915,
    "end": 668.829,
    "text": "给予了我无私的爱与支持"
  },
  {
    "start": 668.829,
    "end": 670.688,
    "text": "也在这本书的创作"
  },
  {
    "start": 670.688,
    "end": 673.244,
    "text": "过程中起到了重要的作用"
  },
  {
    "start": 673.949,
    "end": 676.613,
    "text": "首先 感谢我的人生伴侣"
  },
  {
    "start": 676.613,
    "end": 679.276,
    "text": "格里特和我们的女儿劳拉"
  },
  {
    "start": 679.276,
    "end": 681.609,
    "text": "你们对我那无条件的"
  },
  {
    "start": 681.609,
    "end": 684.461,
    "text": "忠诚与爱是我无限的福佑"
  },
  {
    "start": 684.461,
    "end": 688.531,
    "text": "与你们一起生活的每一天都是我快乐与"
  },
  {
    "start": 688.531,
    "end": 690.925,
    "text": "充实感的源泉 也正因"
  },
  {
    "start": 690.925,
    "end": 693.798,
    "text": "如此 我才能够写出这本书"
  },
  {
    "start": 693.798,
    "end": 696.409,
    "text": "感谢我的父母艾米丽塔·"
  },
  {
    "start": 696.409,
    "end": 699.02,
    "text": "克里柏与弗兰克·克里柏"
  },
  {
    "start": 699.02,
    "end": 702.79,
    "text": "谢谢你们一直以来那爱的支持与"
  },
  {
    "start": 702.79,
    "end": 707.369,
    "text": "默默的陪伴 此外 在我陷入黑暗之时"
  },
  {
    "start": 707.369,
    "end": 709.42,
    "text": "许多人都带着真挚的"
  },
  {
    "start": 709.42,
    "end": 712.154,
    "text": "友谊与鼓励陪伴在我的身边"
  },
  {
    "start": 712.154,
    "end": 715.045,
    "text": "在此特别感谢我亲爱的朋友"
  },
  {
    "start": 715.045,
    "end": 717.213,
    "text": "安娜玛丽、弗兰卡、"
  },
  {
    "start": 717.213,
    "end": 719.622,
    "text": "克里斯特尔和玛莉丝卡"
  },
  {
    "start": 719.622,
    "end": 723.863,
    "text": "你们那真诚的爱与关怀深深地感动了我"
  },
  {
    "start": 723.863,
    "end": 725.984,
    "text": "感谢艾琦精湛的翻译"
  },
  {
    "start": 725.984,
    "end": 728.34,
    "text": "水平和精心的翻译工作"
  },
  {
    "start": 728.34,
    "end": 732.29,
    "text": "感谢张德芬和郭宇给我的慷慨帮助 是"
  },
  {
    "start": 732.29,
    "end": 734.382,
    "text": "他们将约书亚的传导"
  },
  {
    "start": 734.382,
    "end": 736.705,
    "text": "系列介绍到中国 最后"
  },
  {
    "start": 736.705,
    "end": 741.022,
    "text": "诚挚地感谢工作坊的所有参与者 本书所"
  },
  {
    "start": 741.022,
    "end": 743.18,
    "text": "辑录的传导讯息都来"
  },
  {
    "start": 743.18,
    "end": 745.578,
    "text": "自我平日举办的工作坊"
  },
  {
    "start": 745.578,
    "end": 748.093,
    "text": "参与者的能量与意识"
  },
  {
    "start": 748.093,
    "end": 751.446,
    "text": "觉知在此起到了重要的作用"
  },
  {
    "start": 751.446,
    "end": 753.779,
    "text": "我们一次又一次地共同"
  },
  {
    "start": 753.779,
    "end": 756.812,
    "text": "创造了充满爱与慈悲的能量场"
  },
  {
    "start": 756.812,
    "end": 761.608,
    "text": "而这一能量场正是这本书萌芽的温床"
  }
]