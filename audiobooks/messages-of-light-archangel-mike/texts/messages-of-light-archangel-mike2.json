[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "打开你神圣之心的门户"
  },
  {
    "start": 7.57,
    "end": 11.48,
    "text": "来自大天使MICHAEL的光之信息"
  },
  {
    "start": 11.48,
    "end": 14.09,
    "text": "神圣抄写员Ronna Vezane"
  },
  {
    "start": 14.09,
    "end": 16.64,
    "text": "翻译 / 解读 暮雨"
  },
  {
    "start": 16.64,
    "end": 18.99,
    "text": "上一集我们分享了"
  },
  {
    "start": 18.99,
    "end": 21.85,
    "text": "来自大天使Michael的光之信息"
  },
  {
    "start": 21.85,
    "end": 25.45,
    "text": "协调你的身体 | 情绪体 | 心智体"
  },
  {
    "start": 25.45,
    "end": 28.81,
    "text": "通向高阶意识的三个层面演化"
  },
  {
    "start": 28.81,
    "end": 32.55,
    "text": "其中提到心轮是通往高阶意识的桥梁"
  },
  {
    "start": 32.55,
    "end": 35.42,
    "text": "本集将更详细阐释"
  },
  {
    "start": 35.42,
    "end": 38.95,
    "text": "如何打开你神圣之心的门户"
  },
  {
    "start": 38.95,
    "end": 44.26,
    "text": "在我们的多条DNA链 和人类的神圣心智"
  },
  {
    "start": 44.26,
    "end": 47.36,
    "text": "以及神圣心灵中心的背部门户上"
  },
  {
    "start": 47.36,
    "end": 51.74,
    "text": "都被放置了一层遗忘的面纱 （即 光膜）"
  },
  {
    "start": 51.74,
    "end": 54.16,
    "text": "如上一集所述"
  },
  {
    "start": 54.16,
    "end": 56.06,
    "text": "人类的神圣心智"
  },
  {
    "start": 56.06,
    "end": 58.91,
    "text": "是一个储存在大脑后部上方的"
  },
  {
    "start": 58.91,
    "end": 61.08,
    "text": "乙太水晶种子原子（ ）"
  },
  {
    "start": 61.08,
    "end": 65.05,
    "text": "（ 你可以把它理解成一个光的数据苞 ）"
  },
  {
    "start": 65.05,
    "end": 66.46,
    "text": "这里有一层光膜"
  },
  {
    "start": 66.46,
    "end": 71.02,
    "text": "保护着进入神圣心智门户的通道及其内容"
  },
  {
    "start": 71.02,
    "end": 76.53,
    "text": "直到你将自己的频率提升到更高的第四维度的适当水平"
  },
  {
    "start": 76.53,
    "end": 78.25,
    "text": "才被允许访问"
  },
  {
    "start": 78.25,
    "end": 82.81,
    "text": "你的神圣心智 包含你古老历史的浓缩版本"
  },
  {
    "start": 82.81,
    "end": 85.85,
    "text": "以及你在这个宇宙的众多前世中"
  },
  {
    "start": 85.85,
    "end": 88.07,
    "text": "所整合的部分智慧"
  },
  {
    "start": 88.07,
    "end": 91.31,
    "text": "品质 才能 和重要信息"
  },
  {
    "start": 91.31,
    "end": 95.29,
    "text": "当我们于内在 恢复平衡与和谐"
  },
  {
    "start": 95.29,
    "end": 98.65,
    "text": "并在扬升与重新统一的螺旋阶梯上迈进"
  },
  {
    "start": 98.65,
    "end": 99.72,
    "text": "时"
  },
  {
    "start": 99.72,
    "end": 102.92,
    "text": "这些限制性的光膜会慢慢溶解"
  },
  {
    "start": 102.92,
    "end": 104.15,
    "text": "由此"
  },
  {
    "start": 104.15,
    "end": 108.46,
    "text": "我们能够接收和散发不断提升的光频率"
  },
  {
    "start": 108.46,
    "end": 112.73,
    "text": "并将这些转变性的 高级振动模式的光频率"
  },
  {
    "start": 112.73,
    "end": 115.0,
    "text": "辐射到地球的核心"
  },
  {
    "start": 115.0,
    "end": 116.33,
    "text": "然后"
  },
  {
    "start": 116.33,
    "end": 119.57,
    "text": "通过你神圣心灵中心的门户"
  },
  {
    "start": 119.57,
    "end": 124.72,
    "text": "从身体前后两个方向（即 通过前心轮和后心轮 ）"
  },
  {
    "start": 124.72,
    "end": 128.67,
    "text": "将其投射到整个世界"
  },
  {
    "start": 129.67,
    "end": 133.94,
    "text": "忆起你是谁  │ 你的星际血统"
  },
  {
    "start": 133.94,
    "end": 136.0,
    "text": "亲爱的大师们"
  },
  {
    "start": 136.0,
    "end": 137.07,
    "text": "你们进入密度的"
  },
  {
    "start": 137.07,
    "end": 137.74,
    "text": "旅程"
  },
  {
    "start": 137.74,
    "end": 140.33,
    "text": "是一场极具冒险的经历"
  },
  {
    "start": 140.33,
    "end": 141.11,
    "text": "按照你们的"
  },
  {
    "start": 141.11,
    "end": 142.61,
    "text": "时间计算"
  },
  {
    "start": 142.61,
    "end": 145.47,
    "text": "这段旅程已经跨越了数十亿年"
  },
  {
    "start": 145.47,
    "end": 147.51,
    "text": "我们曾解释过"
  },
  {
    "start": 147.51,
    "end": 149.95,
    "text": "当你们越来越深入浩瀚的虚空"
  },
  {
    "start": 149.95,
    "end": 152.69,
    "text": "和黑暗的宇宙空间时"
  },
  {
    "start": 152.69,
    "end": 155.32,
    "text": "你们协助参与创造 ——"
  },
  {
    "start": 155.32,
    "end": 160.61,
    "text": "用光 物质 纹理 和形状填满了虚空"
  },
  {
    "start": 160.61,
    "end": 163.61,
    "text": "创造出了超乎你们想象的奇迹"
  },
  {
    "start": 163.61,
    "end": 164.98,
    "text": "之后"
  },
  {
    "start": 164.98,
    "end": 166.96,
    "text": "根据神圣计划"
  },
  {
    "start": 166.96,
    "end": 171.55,
    "text": "你们沉浸在 每一个由自己参与创造的新现实中"
  },
  {
    "start": 171.55,
    "end": 173.78,
    "text": "体验着创造的各种形式"
  },
  {
    "start": 173.78,
    "end": 175.19,
    "text": "于是"
  },
  {
    "start": 175.19,
    "end": 178.43,
    "text": "固态物质的显现过程开始 ——"
  },
  {
    "start": 178.43,
    "end": 181.03,
    "text": "最初通过纯粹的思想"
  },
  {
    "start": 181.03,
    "end": 184.42,
    "text": "从至高造物主的心灵中诞生"
  },
  {
    "start": 184.42,
    "end": 188.27,
    "text": "然后通过每个宇宙的父神/母神的心智"
  },
  {
    "start": 188.27,
    "end": 192.72,
    "text": "当你越来越远离一切造物的纯粹源头时"
  },
  {
    "start": 192.72,
    "end": 196.74,
    "text": "最后是通过你们自己的思想来体验创造"
  },
  {
    "start": 196.74,
    "end": 199.57,
    "text": "当你进入你的个体意识后"
  },
  {
    "start": 199.57,
    "end": 203.65,
    "text": "意识到自己 是至高造物主的神圣火花"
  },
  {
    "start": 203.65,
    "end": 204.06,
    "text": "是一"
  },
  {
    "start": 204.06,
    "end": 205.94,
    "text": "切万有的一部分"
  },
  {
    "start": 205.94,
    "end": 209.11,
    "text": "你便知道自己注定要作为光的使者"
  },
  {
    "start": 209.11,
    "end": 212.02,
    "text": "前往浩瀚的 未显化的虚空"
  },
  {
    "start": 212.02,
    "end": 215.98,
    "text": "因这一认知已经深深编码在"
  },
  {
    "start": 215.98,
    "end": 219.88,
    "text": "你不朽的灵魂和你神圣心灵的核心中"
  },
  {
    "start": 219.88,
    "end": 220.85,
    "text": "你"
  },
  {
    "start": 220.85,
    "end": 223.99,
    "text": "以及所有其他觉醒的意识火花"
  },
  {
    "start": 223.99,
    "end": 228.35,
    "text": "注定要体验所有奇妙而多样性的创造 ——"
  },
  {
    "start": 228.35,
    "end": 231.81,
    "text": "它们来自于造物主 我们的父神/母神"
  },
  {
    "start": 231.81,
    "end": 236.54,
    "text": "以及所有 留在造物主稀有领域内的 伟大光之存有"
  },
  {
    "start": 236.54,
    "end": 239.07,
    "text": "我们告诉你们这一切"
  },
  {
    "start": 239.07,
    "end": 243.53,
    "text": "是希望让你们深刻意识到 自己是多么古老和复杂"
  },
  {
    "start": 243.53,
    "end": 246.33,
    "text": "你们带着丰富的知识"
  },
  {
    "start": 246.33,
    "end": 249.91,
    "text": "拥有复杂而古老的血统来到这一世"
  },
  {
    "start": 249.91,
    "end": 253.78,
    "text": "这些血统信息 编码在你们的DNA 细"
  },
  {
    "start": 253.78,
    "end": 257.32,
    "text": "胞结构 心智体和情绪体中"
  },
  {
    "start": 257.32,
    "end": 261.0,
    "text": "以及你们更广泛的意识觉知  脉轮系统中"
  },
  {
    "start": 261.0,
    "end": 263.0,
    "text": "你常常会想"
  },
  {
    "start": 263.0,
    "end": 266.73,
    "text": "为什么同一个家庭的成员会如此不同"
  },
  {
    "start": 266.73,
    "end": 269.42,
    "text": "从狭隘的角度来看"
  },
  {
    "start": 269.42,
    "end": 272.13,
    "text": "他们来自相同的父母和血统"
  },
  {
    "start": 272.13,
    "end": 273.4,
    "text": "然而"
  },
  {
    "start": 273.4,
    "end": 276.4,
    "text": "你在这个生命中的家族血统"
  },
  {
    "start": 276.4,
    "end": 281.91,
    "text": "只是你 庞大又珍贵遗产的 微小部分"
  },
  {
    "start": 281.91,
    "end": 284.98,
    "text": "・下降与分裂"
  },
  {
    "start": 284.98,
    "end": 290.01,
    "text": "体验二元性  为了体验创造的多样性"
  },
  {
    "start": 290.01,
    "end": 290.78,
    "text": "你们已经无"
  },
  {
    "start": 290.78,
    "end": 291.18,
    "text": "数次"
  },
  {
    "start": 291.18,
    "end": 293.14,
    "text": "分离了自己的意识"
  },
  {
    "start": 293.14,
    "end": 293.82,
    "text": "或者说你"
  },
  {
    "start": 293.82,
    "end": 294.04,
    "text": "分"
  },
  {
    "start": 294.04,
    "end": 295.85,
    "text": "裂了自己数百万次"
  },
  {
    "start": 295.85,
    "end": 301.42,
    "text": "你们也已经多次与自己的多个面向（你的多重自我）重聚"
  },
  {
    "start": 301.42,
    "end": 303.35,
    "text": "次数多到难以计数"
  },
  {
    "start": 303.35,
    "end": 305.18,
    "text": "每次这样做"
  },
  {
    "start": 305.18,
    "end": 308.79,
    "text": "你都会向你的记忆库添加更为复杂的信息"
  },
  {
    "start": 308.79,
    "end": 310.22,
    "text": "和独特的经历"
  },
  {
    "start": 310.22,
    "end": 314.59,
    "text": "随着你离至高造物主的完美越来越远"
  },
  {
    "start": 314.59,
    "end": 316.88,
    "text": "你进入的多维度越深"
  },
  {
    "start": 316.88,
    "end": 319.02,
    "text": "你的创造就越密集"
  },
  {
    "start": 319.02,
    "end": 320.4,
    "text": "也越不完美"
  },
  {
    "start": 320.4,
    "end": 323.86,
    "text": "因为你可以利用的纯净之光就越少"
  },
  {
    "start": 323.86,
    "end": 325.09,
    "text": "因此"
  },
  {
    "start": 325.09,
    "end": 326.76,
    "text": "不应该有责备"
  },
  {
    "start": 326.76,
    "end": 329.27,
    "text": "也不应该感到愧疚和失败"
  },
  {
    "start": 329.27,
    "end": 331.8,
    "text": "这是一次学习经历"
  },
  {
    "start": 331.8,
    "end": 333.06,
    "text": "然而"
  },
  {
    "start": 333.06,
    "end": 336.69,
    "text": "现在是你重新获得自我掌控力的时刻"
  },
  {
    "start": 336.69,
    "end": 340.36,
    "text": "重新拥有按照原始神圣计划"
  },
  {
    "start": 340.36,
    "end": 342.97,
    "text": "创造美丽与和谐事物的能力"
  },
  {
    "start": 342.97,
    "end": 345.32,
    "text": "现在你已经意识到"
  },
  {
    "start": 345.32,
    "end": 347.24,
    "text": "自己有能力获取 ——"
  },
  {
    "start": 347.24,
    "end": 349.84,
    "text": "被称为爱与光的金刚粒子 ——"
  },
  {
    "start": 349.84,
    "end": 354.24,
    "text": "它们是全光谱 造物主之光的无限供应"
  },
  {
    "start": 354.24,
    "end": 355.75,
    "text": "你还在等什么呢"
  },
  {
    "start": 355.75,
    "end": 359.28,
    "text": "拒绝你与生俱来的神圣权利与天赋"
  },
  {
    "start": 359.28,
    "end": 360.71,
    "text": "是一种嘲弄"
  },
  {
    "start": 360.71,
    "end": 365.33,
    "text": "你的更高自我 将不会停止推动你觉醒"
  },
  {
    "start": 365.33,
    "end": 368.42,
    "text": "并催促你主张自己的神圣遗产"
  },
  {
    "start": 368.42,
    "end": 370.58,
    "text": "我们已经解释过"
  },
  {
    "start": 370.58,
    "end": 374.96,
    "text": "光与影的光谱是如何在这个宇宙中创造的"
  },
  {
    "start": 374.96,
    "end": 375.66,
    "text": "以便让你"
  },
  {
    "start": 375.66,
    "end": 375.87,
    "text": "能"
  },
  {
    "start": 375.87,
    "end": 377.83,
    "text": "够体验二元性和极性"
  },
  {
    "start": 377.83,
    "end": 380.08,
    "text": "在更高的维度中"
  },
  {
    "start": 380.08,
    "end": 382.95,
    "text": "对于那些最接近我们父神/母神"
  },
  {
    "start": 382.95,
    "end": 386.12,
    "text": "以及伟大的中央太阳的存在来说"
  },
  {
    "start": 386.12,
    "end": 389.89,
    "text": "二元性光谱非常狭窄 然而"
  },
  {
    "start": 389.89,
    "end": 392.22,
    "text": "随着每个维度的建立"
  },
  {
    "start": 392.22,
    "end": 395.11,
    "text": "它变得越来越拓宽和明显"
  },
  {
    "start": 395.11,
    "end": 397.05,
    "text": "直到它达到将要被体验到的"
  },
  {
    "start": 397.05,
    "end": 399.28,
    "text": "最大的二元性"
  },
  {
    "start": 399.67,
    "end": 403.89,
    "text": "暮雨·注 集合点 与知觉方式"
  },
  {
    "start": 403.89,
    "end": 406.29,
    "text": "卡洛斯·卡斯塔尼达（ ）所著的"
  },
  {
    "start": 406.29,
    "end": 409.83,
    "text": "唐望系列中提到的 集合点概念"
  },
  {
    "start": 409.83,
    "end": 411.64,
    "text": "从另一个角度描述了"
  },
  {
    "start": 411.64,
    "end": 414.23,
    "text": "决定我们体验二元性的光谱"
  },
  {
    "start": 414.23,
    "end": 418.13,
    "text": "古典巫士看见人类的能量本质"
  },
  {
    "start": 418.13,
    "end": 420.52,
    "text": "唐望说 他们把人类形容为"
  },
  {
    "start": 420.52,
    "end": 423.94,
    "text": "一个明亮的 像巨大的蛋的形状"
  },
  {
    "start": 423.94,
    "end": 424.59,
    "text": "他们称为"
  },
  {
    "start": 424.59,
    "end": 425.91,
    "text": "明晰之蛋"
  },
  {
    "start": 425.91,
    "end": 428.18,
    "text": "人类明晰球体中"
  },
  {
    "start": 428.18,
    "end": 431.89,
    "text": "有一个关键特征 有一处极明亮的圆点"
  },
  {
    "start": 431.89,
    "end": 433.99,
    "text": "像个网球般大小"
  },
  {
    "start": 433.99,
    "end": 436.5,
    "text": "永远嵌在明晰球体内部"
  },
  {
    "start": 436.5,
    "end": 438.15,
    "text": "平贴在表面"
  },
  {
    "start": 438.15,
    "end": 440.69,
    "text": "位置大约在人类右肩骨"
  },
  {
    "start": 440.69,
    "end": 442.28,
    "text": "离背部一臂之遥"
  },
  {
    "start": 442.28,
    "end": 445.47,
    "text": "明晰球体比人体要大很多"
  },
  {
    "start": 445.47,
    "end": 448.79,
    "text": "而这个亮点是能量球体的一部分"
  },
  {
    "start": 448.79,
    "end": 453.22,
    "text": "过去的巫士在看见了这个亮点的功能后"
  },
  {
    "start": 453.22,
    "end": 455.18,
    "text": "将其称为集合点 ( ）"
  },
  {
    "start": 455.18,
    "end": 458.01,
    "text": "集合点赋予我们知觉的能力"
  },
  {
    "start": 458.01,
    "end": 461.84,
    "text": "巫士看见人类的知觉集合在那一点上"
  },
  {
    "start": 461.84,
    "end": 464.76,
    "text": "看见所有的生物都有这样的亮点"
  },
  {
    "start": 464.76,
    "end": 468.15,
    "text": "他们推断知觉必然都发生在这一点上"
  },
  {
    "start": 468.15,
    "end": 468.67,
    "text": "他"
  },
  {
    "start": 468.67,
    "end": 471.83,
    "text": "们看见无数的宇宙明亮能量纤维"
  },
  {
    "start": 471.83,
    "end": 473.96,
    "text": "穿过明晰球体"
  },
  {
    "start": 473.96,
    "end": 476.79,
    "text": "其中只有少数穿过集合点"
  },
  {
    "start": 476.79,
    "end": 479.28,
    "text": "因为集合点的面积要小得多"
  },
  {
    "start": 479.28,
    "end": 480.57,
    "text": "此外"
  },
  {
    "start": 480.57,
    "end": 484.9,
    "text": "古代巫士发现 通过移动集合点的位置"
  },
  {
    "start": 484.9,
    "end": 486.72,
    "text": "可以改变知觉方式"
  },
  {
    "start": 486.72,
    "end": 489.34,
    "text": "甚至可以知觉到其他世界"
  },
  {
    "start": 489.34,
    "end": 491.17,
    "text": "据唐望说"
  },
  {
    "start": 491.17,
    "end": 493.15,
    "text": "有些古代墨西哥巫士"
  },
  {
    "start": 493.15,
    "end": 496.69,
    "text": "能变成乌鸦 鹰 豹子 等动物"
  },
  {
    "start": 496.69,
    "end": 499.96,
    "text": "也是因为他们将自己的集合点移动到"
  },
  {
    "start": 499.96,
    "end": 503.39,
    "text": "与这些生物的集合点一致的位置实现的"
  },
  {
    "start": 503.39,
    "end": 506.18,
    "text": "想进一步了解集合点"
  },
  {
    "start": 506.18,
    "end": 509.06,
    "text": "请查看之前的视频或文章"
  },
  {
    "start": 509.06,
    "end": 511.41,
    "text": "每个人都具备的隐藏功能"
  },
  {
    "start": 511.41,
    "end": 513.02,
    "text": "控梦的艺术  │"
  },
  {
    "start": 513.02,
    "end": 514.86,
    "text": "集合点是改变知觉的"
  },
  {
    "start": 514.86,
    "end": 520.61,
    "text": "关键   ・因果法则"
  },
  {
    "start": 520.61,
    "end": 524.88,
    "text": "│ 并没有审判与惩罚 你意识到"
  },
  {
    "start": 524.88,
    "end": 528.37,
    "text": "人类深陷于二元性和极性之中"
  },
  {
    "start": 528.37,
    "end": 531.46,
    "text": "从而造成如此多的痛苦和磨难"
  },
  {
    "start": 531.46,
    "end": 533.16,
    "text": "但这一切并非命中注"
  },
  {
    "start": 533.16,
    "end": 534.03,
    "text": "定或原"
  },
  {
    "start": 534.03,
    "end": 535.27,
    "text": "本的计划"
  },
  {
    "start": 535.27,
    "end": 537.14,
    "text": "现在是时候"
  },
  {
    "start": 537.14,
    "end": 538.44,
    "text": "将过去的扭曲和"
  },
  {
    "start": 538.44,
    "end": 541.79,
    "text": "过度行为重新带回和谐中"
  },
  {
    "start": 541.79,
    "end": 543.88,
    "text": "我们最大的愿望是帮助您"
  },
  {
    "start": 543.88,
    "end": 546.23,
    "text": "轻松优雅地度过这个过程"
  },
  {
    "start": 546.23,
    "end": 550.17,
    "text": "请注意我们的话 你们没有被评判"
  },
  {
    "start": 550.17,
    "end": 551.78,
    "text": "也从未被任何人"
  },
  {
    "start": 551.78,
    "end": 556.88,
    "text": "和任何来自不可见 或更高领域的存在所评判 ——"
  },
  {
    "start": 556.88,
    "end": 558.67,
    "text": "只有你们评判自己"
  },
  {
    "start": 558.67,
    "end": 560.04,
    "text": "根据宇宙的因"
  },
  {
    "start": 560.04,
    "end": 560.19,
    "text": "果"
  },
  {
    "start": 560.19,
    "end": 561.23,
    "text": "法则"
  },
  {
    "start": 561.23,
    "end": 564.65,
    "text": "你的所有思想 意图和行为"
  },
  {
    "start": 564.65,
    "end": 567.87,
    "text": "都被存储在你的能量场和脉轮系统中"
  },
  {
    "start": 567.87,
    "end": 571.74,
    "text": "你放射出由此产生的振动模式"
  },
  {
    "start": 571.74,
    "end": 573.65,
    "text": "这些振动模式以一种"
  },
  {
    "start": 573.65,
    "end": 582.01,
    "text": "无限的形式从你身上发出 （ 这意味着这些能量以一种连续 循环的方式传播 ）"
  },
  {
    "start": 582.01,
    "end": 585.82,
    "text": "然后以相同的频率和程度返回到你身上"
  },
  {
    "start": 585.82,
    "end": 587.74,
    "text": "在过去"
  },
  {
    "start": 587.74,
    "end": 589.94,
    "text": "人们往往要花好几世"
  },
  {
    "start": 589.94,
    "end": 594.0,
    "text": "才能收获积极 充满爱的行为所带来的回报"
  },
  {
    "start": 594.0,
    "end": 597.89,
    "text": "或体验消极 有害的行为所带来的惩罚"
  },
  {
    "start": 597.89,
    "end": 598.99,
    "text": "因此"
  },
  {
    "start": 598.99,
    "end": 600.84,
    "text": "大多数情况下"
  },
  {
    "start": 600.84,
    "end": 601.69,
    "text": "正义确实"
  },
  {
    "start": 601.69,
    "end": 603.36,
    "text": "得到了回报"
  },
  {
    "start": 603.36,
    "end": 606.78,
    "text": "而邪恶也得到了应有的回报 ——"
  },
  {
    "start": 606.78,
    "end": 609.11,
    "text": "虽然这一点并不明显"
  },
  {
    "start": 609.11,
    "end": 613.01,
    "text": "因为这些结果可能需要很多世才能显现出来"
  },
  {
    "start": 613.01,
    "end": 615.17,
    "text": "我们再次强调"
  },
  {
    "start": 615.17,
    "end": 618.4,
    "text": "没有任何伟大或渺小的存在"
  },
  {
    "start": 618.4,
    "end": 620.46,
    "text": "在给予奖励或惩罚"
  },
  {
    "start": 620.46,
    "end": 623.73,
    "text": "宇宙法则坚定不移地存在着"
  },
  {
    "start": 623.73,
    "end": 627.67,
    "text": "而你们自己的高我监控着你的进步或不足"
  },
  {
    "start": 627.67,
    "end": 628.71,
    "text": "你的高我"
  },
  {
    "start": 628.71,
    "end": 629.21,
    "text": "要么通"
  },
  {
    "start": 629.21,
    "end": 631.87,
    "text": "过为你清除前方的障碍"
  },
  {
    "start": 631.87,
    "end": 634.45,
    "text": "并赐予你大大小小的奇迹"
  },
  {
    "start": 634.45,
    "end": 638.46,
    "text": "要么通过在你面前设置更多障碍"
  },
  {
    "start": 638.46,
    "end": 644.21,
    "text": "希望你能够觉醒并踏上扬升的螺旋阶梯"
  },
  {
    "start": 644.21,
    "end": 647.21,
    "text": "疗愈过去"
  },
  {
    "start": 647.21,
    "end": 648.37,
    "text": "规划未来"
  },
  {
    "start": 648.37,
    "end": 651.95,
    "text": "活在当下 亲爱的"
  },
  {
    "start": 651.95,
    "end": 655.73,
    "text": "你们中有太多人背负着过去的沉重负担——"
  },
  {
    "start": 655.73,
    "end": 658.96,
    "text": "这些重担包括你们在今生所犯的错误"
  },
  {
    "start": 658.96,
    "end": 660.63,
    "text": "以及许多来自过去的制"
  },
  {
    "start": 660.63,
    "end": 661.5,
    "text": "约"
  },
  {
    "start": 661.5,
    "end": 661.78,
    "text": "和"
  },
  {
    "start": 661.78,
    "end": 664.57,
    "text": "埋藏在记忆深处的前世痛苦事件"
  },
  {
    "start": 664.57,
    "end": 665.81,
    "text": "或行为"
  },
  {
    "start": 665.81,
    "end": 670.05,
    "text": "继续保留这些记忆或背负不公平的负担"
  },
  {
    "start": 670.05,
    "end": 671.8,
    "text": "已经不再对你有益"
  },
  {
    "start": 671.8,
    "end": 673.63,
    "text": "现在是时候"
  },
  {
    "start": 673.63,
    "end": 676.94,
    "text": "让我们帮助你们治愈过去的痛苦记忆"
  },
  {
    "start": 676.94,
    "end": 679.8,
    "text": "正如我们正在清理第三/第四维度"
  },
  {
    "start": 679.8,
    "end": 683.05,
    "text": "集体意识信念模式中的扭曲"
  },
  {
    "start": 683.05,
    "end": 684.61,
    "text": "并将这些维度带回"
  },
  {
    "start": 684.61,
    "end": 687.62,
    "text": "其最初设计的二元性光谱一样"
  },
  {
    "start": 689.62,
    "end": 693.34,
    "text": "・遗忘的面纱  光膜"
  },
  {
    "start": 693.34,
    "end": 698.34,
    "text": "当你们下降到有限的 限制性的意识领域时"
  },
  {
    "start": 698.34,
    "end": 702.81,
    "text": "一种光膜（ ）被放置在 你们的多条DNA链周围"
  },
  {
    "start": 702.81,
    "end": 705.11,
    "text": "只留下两条是可访问和活"
  },
  {
    "start": 705.11,
    "end": 705.81,
    "text": "跃的"
  },
  {
    "start": 705.81,
    "end": 708.38,
    "text": "这层光膜也覆盖在你们"
  },
  {
    "start": 708.38,
    "end": 709.91,
    "text": "的记忆上"
  },
  {
    "start": 709.91,
    "end": 715.19,
    "text": "以及存储在你们高级大脑结构 （被称为神圣心智 ）中的"
  },
  {
    "start": 715.19,
    "end": 717.79,
    "text": "\"智慧之光 数据包（ ）\"周围"
  },
  {
    "start": 717.79,
    "end": 721.29,
    "text": "你们的记忆被蒙上了一层面纱"
  },
  {
    "start": 721.29,
    "end": 722.46,
    "text": "因此"
  },
  {
    "start": 722.46,
    "end": 724.21,
    "text": "大多数情况下"
  },
  {
    "start": 724.21,
    "end": 727.14,
    "text": "你们无法忆起自己的前世生活"
  },
  {
    "start": 727.14,
    "end": 730.22,
    "text": "因为记住所有过去的错误和不完美"
  },
  {
    "start": 730.22,
    "end": 732.1,
    "text": "将是一个过重的负担"
  },
  {
    "start": 732.1,
    "end": 734.91,
    "text": "这是一种仁慈的行为"
  },
  {
    "start": 734.91,
    "end": 736.8,
    "text": "因为事实证明"
  },
  {
    "start": 736.8,
    "end": 739.92,
    "text": "仅仅是原谅自己在今生的错误和误判"
  },
  {
    "start": 739.92,
    "end": 741.57,
    "text": "已经相当困难"
  },
  {
    "start": 741.57,
    "end": 744.11,
    "text": "更不用说所有过去的偏差了"
  },
  {
    "start": 744.11,
    "end": 744.61,
    "text": "275 00:12:25,110 --> 00:12:29,890 ・溶解光膜  │ 整合更高频率的光"
  },
  {
    "start": 749.89,
    "end": 753.08,
    "text": "当你们恢复平衡与和谐"
  },
  {
    "start": 753.08,
    "end": 757.68,
    "text": "并在扬升与重新统一的螺旋阶梯上迈进时"
  },
  {
    "start": 757.68,
    "end": 761.09,
    "text": "这些限制性的光膜正在慢慢溶解"
  },
  {
    "start": 761.09,
    "end": 763.71,
    "text": "在你们神圣心灵中心的背部"
  },
  {
    "start": 763.71,
    "end": 767.14,
    "text": "门户上曾被放置了一层光膜"
  },
  {
    "start": 767.14,
    "end": 768.61,
    "text": "直到你们开始返回"
  },
  {
    "start": 768.61,
    "end": 771.51,
    "text": "更高维度和光之领域的旅程"
  },
  {
    "start": 771.51,
    "end": 772.74,
    "text": "然而"
  },
  {
    "start": 772.74,
    "end": 773.24,
    "text": "是你们"
  },
  {
    "start": 773.24,
    "end": 773.54,
    "text": "自己"
  },
  {
    "start": 773.54,
    "end": 777.34,
    "text": "在神圣心灵中心的前部漩涡上放置了一层"
  },
  {
    "start": 777.34,
    "end": 778.63,
    "text": "保护膜"
  },
  {
    "start": 778.63,
    "end": 782.9,
    "text": "因为你们曾经多次受到伤害 失望和幻灭"
  },
  {
    "start": 782.9,
    "end": 784.31,
    "text": "慢慢地"
  },
  {
    "start": 784.31,
    "end": 786.27,
    "text": "但可以肯定的是"
  },
  {
    "start": 786.27,
    "end": 787.79,
    "text": "通过我们提供给你们的"
  },
  {
    "start": 787.79,
    "end": 787.98,
    "text": "技"
  },
  {
    "start": 787.98,
    "end": 788.98,
    "text": "术"
  },
  {
    "start": 788.98,
    "end": 792.59,
    "text": "你们已经逐渐溶解了那些限制性的光膜"
  },
  {
    "start": 792.59,
    "end": 797.61,
    "text": "使得爱与光能够以原本应有的方式自由地流向你们"
  },
  {
    "start": 797.61,
    "end": 799.73,
    "text": "以及从你们之内流出"
  },
  {
    "start": 799.73,
    "end": 804.29,
    "text": "为了接收和散发不断提升的光频率"
  },
  {
    "start": 804.29,
    "end": 807.45,
    "text": "你们必须能够将这些高级振动模式"
  },
  {
    "start": 807.45,
    "end": 809.92,
    "text": "整合并渗透到你的存在中"
  },
  {
    "start": 809.92,
    "end": 811.86,
    "text": "我们提醒你们"
  },
  {
    "start": 811.86,
    "end": 813.7,
    "text": "至关重要的是 ——"
  },
  {
    "start": 813.7,
    "end": 816.34,
    "text": "你开始将这些转变性的光频率"
  },
  {
    "start": 816.34,
    "end": 818.63,
    "text": "辐射到地球的核心"
  },
  {
    "start": 818.63,
    "end": 822.22,
    "text": "然后通过你神圣心灵中心的门户"
  },
  {
    "start": 822.22,
    "end": 826.04,
    "text": "从前后两个方向将其投射到整个世界"
  },
  {
    "start": 826.04,
    "end": 827.53,
    "text": "请记住"
  },
  {
    "start": 827.53,
    "end": 827.75,
    "text": "我"
  },
  {
    "start": 827.75,
    "end": 829.71,
    "text": "们曾告诉你们"
  },
  {
    "start": 829.71,
    "end": 832.47,
    "text": "当你第一次来到地球时"
  },
  {
    "start": 832.47,
    "end": 834.58,
    "text": "你们是闪耀的晶体光柱"
  },
  {
    "start": 834.58,
    "end": 838.17,
    "text": "随着你们逐渐沉入密度之中"
  },
  {
    "start": 838.17,
    "end": 841.31,
    "text": "你们开始建造一个物质的十字架"
  },
  {
    "start": 841.31,
    "end": 844.63,
    "text": "随着你的光与影的光谱不断增加"
  },
  {
    "start": 844.63,
    "end": 847.28,
    "text": "这个十字架变得越来越笨重"
  },
  {
    "start": 847.28,
    "end": 848.65,
    "text": "现在"
  },
  {
    "start": 848.65,
    "end": 851.39,
    "text": "你们正在用爱 来接纳和治愈"
  },
  {
    "start": 851.39,
    "end": 853.75,
    "text": "那些你所创造的碎片"
  },
  {
    "start": 853.75,
    "end": 854.0,
    "text": "使"
  },
  {
    "start": 854.0,
    "end": 856.96,
    "text": "其恢复到平衡与和谐状态"
  },
  {
    "start": 856.96,
    "end": 858.85,
    "text": "因为你正在寻求并接入"
  },
  {
    "start": 858.85,
    "end": 862.26,
    "text": "越来越高的光频率"
  },
  {
    "start": 862.926,
    "end": 867.35,
    "text": "・回归当下  │ 寂静中心"
  },
  {
    "start": 867.35,
    "end": 871.17,
    "text": "我们一再告诉你们 治愈过去"
  },
  {
    "start": 871.17,
    "end": 873.35,
    "text": "规划未来"
  },
  {
    "start": 873.35,
    "end": 874.87,
    "text": "然后活在当下"
  },
  {
    "start": 875.37,
    "end": 877.87,
    "text": "因为当下      正是静止点"
  },
  {
    "start": 877.87,
    "end": 879.96,
    "text": "或创造的力量中心"
  },
  {
    "start": 879.96,
    "end": 883.09,
    "text": "为何不进入那个螺旋的中心"
  },
  {
    "start": 883.09,
    "end": 885.93,
    "text": "进入二元性和极性的暴风眼中"
  },
  {
    "start": 885.93,
    "end": 889.59,
    "text": "在那里一切都是平静与安宁的"
  },
  {
    "start": 889.59,
    "end": 890.18,
    "text": "并充满"
  },
  {
    "start": 890.18,
    "end": 890.56,
    "text": "了纯"
  },
  {
    "start": 890.56,
    "end": 890.74,
    "text": "净"
  },
  {
    "start": 890.74,
    "end": 893.51,
    "text": "而丰富的宇宙生命力物质"
  },
  {
    "start": 893.51,
    "end": 893.86,
    "text": "只等"
  },
  {
    "start": 893.86,
    "end": 897.08,
    "text": "待着 被塑造成你们对未来的愿景"
  },
  {
    "start": 897.08,
    "end": 898.85,
    "text": "就在这一刻"
  },
  {
    "start": 898.85,
    "end": 899.96,
    "text": "当你们进入自己"
  },
  {
    "start": 899.96,
    "end": 902.61,
    "text": "神圣心灵中心时"
  },
  {
    "start": 902.61,
    "end": 905.3,
    "text": "你可以体验到我们父神/母神"
  },
  {
    "start": 905.3,
    "end": 906.69,
    "text": "和至高造物主"
  },
  {
    "start": 906.69,
    "end": 908.89,
    "text": "无条件的爱与慈悲"
  },
  {
    "start": 908.89,
    "end": 911.53,
    "text": "你可以毫无疑问地知晓"
  },
  {
    "start": 911.53,
    "end": 914.13,
    "text": "你们是被珍视的儿子或女儿"
  },
  {
    "start": 914.13,
    "end": 916.11,
    "text": "正肩负着重要的使命"
  },
  {
    "start": 916.11,
    "end": 919.39,
    "text": "你们所说或所做的任何事情"
  },
  {
    "start": 919.39,
    "end": 923.41,
    "text": "都不会削弱那份深厚的爱"
  },
  {
    "start": 924.41,
    "end": 928.52,
    "text": "・宽恕  │ 终结内在之战"
  },
  {
    "start": 928.52,
    "end": 930.02,
    "text": "请记住"
  },
  {
    "start": 930.02,
    "end": 931.93,
    "text": "通过宽恕的礼物"
  },
  {
    "start": 931.93,
    "end": 935.29,
    "text": "你们的情绪体 精神体和以太体"
  },
  {
    "start": 935.29,
    "end": 937.95,
    "text": "可以得到治愈 并恢复完整"
  },
  {
    "start": 937.95,
    "end": 941.55,
    "text": "站在镜子前 凝视自己的眼睛"
  },
  {
    "start": 941.55,
    "end": 943.72,
    "text": "或者进入你的光之金字塔"
  },
  {
    "start": 943.72,
    "end": 945.49,
    "text": "并躺在水晶桌上"
  },
  {
    "start": 945.49,
    "end": 951.01,
    "text": "对自己说 我原谅自己在过去 现在或未来的"
  },
  {
    "start": 951.01,
    "end": 953.47,
    "text": "任何行动 思想或行"
  },
  {
    "start": 953.47,
    "end": 954.34,
    "text": "为"
  },
  {
    "start": 954.34,
    "end": 957.66,
    "text": "只要它们不符合神圣之爱的频率"
  },
  {
    "start": 957.66,
    "end": 959.51,
    "text": "不论是在这一现实中"
  },
  {
    "start": 959.51,
    "end": 961.92,
    "text": "还是在其他任何现实中"
  },
  {
    "start": 961.92,
    "end": 964.13,
    "text": "我宽恕所有 我认为"
  },
  {
    "start": 964.13,
    "end": 966.83,
    "text": "在这一世 或其他任何世中"
  },
  {
    "start": 966.83,
    "end": 968.7,
    "text": "对我不公正的人"
  },
  {
    "start": 968.7,
    "end": 971.84,
    "text": "并将我们共同创造的所有负面记忆"
  },
  {
    "start": 971.84,
    "end": 973.82,
    "text": "受影响的能量 和可能"
  },
  {
    "start": 973.82,
    "end": 975.14,
    "text": "的未来"
  },
  {
    "start": 975.14,
    "end": 977.59,
    "text": "包裹在一个爱的泡泡中"
  },
  {
    "start": 977.59,
    "end": 979.39,
    "text": "将其归还给他们"
  },
  {
    "start": 979.39,
    "end": 981.7,
    "text": "我请求宽恕的天使"
  },
  {
    "start": 981.7,
    "end": 983.14,
    "text": "以爱与光的频率"
  },
  {
    "start": 983.14,
    "end": 986.04,
    "text": "渗透到我存在的所有面向"
  },
  {
    "start": 986.04,
    "end": 987.49,
    "text": "使我可以成为一个"
  },
  {
    "start": 987.49,
    "end": 990.34,
    "text": "以灵魂为中心 以心为中心的"
  },
  {
    "start": 990.34,
    "end": 993.33,
    "text": "光之承载者 和自我掌握者"
  },
  {
    "start": 993.663,
    "end": 996.14,
    "text": "深呼吸"
  },
  {
    "start": 996.14,
    "end": 998.63,
    "text": "进入你神圣心灵的中心"
  },
  {
    "start": 998.63,
    "end": 1001.01,
    "text": "允许纯粹的爱与光"
  },
  {
    "start": 1001.01,
    "end": 1003.79,
    "text": "通过你的高我倾注到你身上"
  },
  {
    "start": 1003.79,
    "end": 1007.2,
    "text": "当这种神圣之爱的灵丹妙药"
  },
  {
    "start": 1007.2,
    "end": 1010.25,
    "text": "渗透到你存在的最深处时"
  },
  {
    "start": 1010.25,
    "end": 1012.92,
    "text": "感受你心灵中心的扩展"
  },
  {
    "start": 1012.92,
    "end": 1017.38,
    "text": "神圣之爱是解放你们自我束缚的钥匙 ——"
  },
  {
    "start": 1017.38,
    "end": 1020.3,
    "text": "这些枷锁是由你们自己编织的"
  },
  {
    "start": 1020.3,
    "end": 1022.88,
    "text": "它们束缚 限制 并纠缠你"
  },
  {
    "start": 1022.88,
    "end": 1023.07,
    "text": "们"
  },
  {
    "start": 1023.07,
    "end": 1024.67,
    "text": "于业力互动中"
  },
  {
    "start": 1024.67,
    "end": 1028.01,
    "text": "当你否认这种神圣之爱时"
  },
  {
    "start": 1028.01,
    "end": 1030.48,
    "text": "你实际上是在否认你的遗产"
  },
  {
    "start": 1030.48,
    "end": 1032.61,
    "text": "和你与生俱来的神圣权利"
  },
  {
    "start": 1032.61,
    "end": 1036.08,
    "text": "尽可能多地进行这个冥想练习"
  },
  {
    "start": 1036.08,
    "end": 1039.79,
    "text": "直到你感受到并接受了这样一个真理"
  },
  {
    "start": 1039.79,
    "end": 1041.61,
    "text": "你值得被宽恕"
  },
  {
    "start": 1041.61,
    "end": 1046.04,
    "text": "自我宽恕有助于宽恕所有其他人"
  },
  {
    "start": 1046.04,
    "end": 1049.99,
    "text": "也是打开 通往神圣之心中心门户的过程中"
  },
  {
    "start": 1049.99,
    "end": 1051.61,
    "text": "不可或缺的一步"
  },
  {
    "start": 1051.61,
    "end": 1055.86,
    "text": "要成功连接 你高我的众多面向"
  },
  {
    "start": 1055.86,
    "end": 1058.16,
    "text": "你的心灵门户必须打开"
  },
  {
    "start": 1058.16,
    "end": 1060.05,
    "text": "你必须努力恢复"
  },
  {
    "start": 1060.05,
    "end": 1062.8,
    "text": "自身内在的和谐与平衡"
  },
  {
    "start": 1062.8,
    "end": 1066.65,
    "text": "才能准备好与你重要的灵魂家族连接"
  },
  {
    "start": 1066.65,
    "end": 1069.49,
    "text": "你那痛苦 无法令人满足的"
  },
  {
    "start": 1069.49,
    "end": 1069.75,
    "text": "尘"
  },
  {
    "start": 1069.75,
    "end": 1071.34,
    "text": "世关系"
  },
  {
    "start": 1071.34,
    "end": 1073.43,
    "text": "源于内心的不配得到"
  },
  {
    "start": 1073.43,
    "end": 1074.47,
    "text": "内疚感"
  },
  {
    "start": 1074.47,
    "end": 1077.7,
    "text": "害怕失败和被拒绝的恐惧"
  },
  {
    "start": 1077.7,
    "end": 1082.82,
    "text": "性别之战实际上是一场与自我的内在斗争"
  },
  {
    "start": 1082.82,
    "end": 1086.37,
    "text": "因为你将自己的需求 欲望和渴望"
  },
  {
    "start": 1086.37,
    "end": 1088.36,
    "text": "投射到别人身上"
  },
  {
    "start": 1088.36,
    "end": 1091.95,
    "text": "希望他们能够提供你内心缺失的东西"
  },
  {
    "start": 1091.95,
    "end": 1095.2,
    "text": "你的人际关系会向你反映出"
  },
  {
    "start": 1095.2,
    "end": 1097.65,
    "text": "需要克服的消极能量"
  },
  {
    "start": 1097.65,
    "end": 1101.06,
    "text": "以及反映出你希望自己具备的积极品质"
  },
  {
    "start": 1101.06,
    "end": 1103.32,
    "text": "关系可以是痛苦的"
  },
  {
    "start": 1103.32,
    "end": 1105.44,
    "text": "也可以是充实的"
  },
  {
    "start": 1105.44,
    "end": 1109.45,
    "text": "这取决于你如何选择玩关系游戏的方式"
  },
  {
    "start": 1109.45,
    "end": 1112.2,
    "text": "消极 有害的伴侣关系"
  },
  {
    "start": 1112.2,
    "end": 1116.25,
    "text": "是基于恐惧 僵化 自我中心"
  },
  {
    "start": 1116.25,
    "end": 1117.79,
    "text": "且充满限制的"
  },
  {
    "start": 1117.79,
    "end": 1121.47,
    "text": "神圣的关系则以爱为基础"
  },
  {
    "start": 1121.47,
    "end": 1123.41,
    "text": "受灵性启发"
  },
  {
    "start": 1123.41,
    "end": 1125.87,
    "text": "它们允许双方整合并表达"
  },
  {
    "start": 1125.87,
    "end": 1128.73,
    "text": "其内在的积极男性和女性特质"
  },
  {
    "start": 1128.73,
    "end": 1132.01,
    "text": "它们注重完整性和统一性"
  },
  {
    "start": 1132.01,
    "end": 1133.99,
    "text": "但同时又灵活"
  },
  {
    "start": 1133.99,
    "end": 1135.89,
    "text": "且允许自由表达"
  },
  {
    "start": 1135.89,
    "end": 1139.44,
    "text": "当你提升你的意识并恢复内在的和"
  },
  {
    "start": 1139.44,
    "end": 1139.71,
    "text": "谐"
  },
  {
    "start": 1139.71,
    "end": 1141.04,
    "text": "时"
  },
  {
    "start": 1141.04,
    "end": 1144.09,
    "text": "你将辐射出更加精致的频率模式"
  },
  {
    "start": 1144.09,
    "end": 1145.37,
    "text": "因此"
  },
  {
    "start": 1145.37,
    "end": 1147.39,
    "text": "你会吸引到那些与你在"
  },
  {
    "start": 1147.39,
    "end": 1150.3,
    "text": "神圣光谱的相同频率水平"
  },
  {
    "start": 1150.3,
    "end": 1152.42,
    "text": "并令你感到舒适的人"
  },
  {
    "start": 1152.42,
    "end": 1156.86,
    "text": "在第五维度 入门级的重新统一过程中"
  },
  {
    "start": 1156.86,
    "end": 1161.45,
    "text": "涉及需要重新加入 你灵魂家族的许多面向"
  },
  {
    "start": 1161.45,
    "end": 1163.7,
    "text": "他们与你同行穿越了许多"
  },
  {
    "start": 1163.7,
    "end": 1163.92,
    "text": "时"
  },
  {
    "start": 1163.92,
    "end": 1164.69,
    "text": "代"
  },
  {
    "start": 1164.69,
    "end": 1169.11,
    "text": "你们将再次享受合一意识的奇妙状态"
  },
  {
    "start": 1169.11,
    "end": 1170.72,
    "text": "亲爱的"
  },
  {
    "start": 1170.72,
    "end": 1173.6,
    "text": "你们愿意现在就开始宽恕的过程吗"
  },
  {
    "start": 1173.6,
    "end": 1175.99,
    "text": "你们愿意齐心协力"
  },
  {
    "start": 1175.99,
    "end": 1179.03,
    "text": "打开你神圣心灵中心的门户"
  },
  {
    "start": 1179.03,
    "end": 1182.84,
    "text": "以便这些奇妙的礼物 可以降临到你们身上吗"
  },
  {
    "start": 1182.84,
    "end": 1184.88,
    "text": "请呼唤我们"
  },
  {
    "start": 1184.88,
    "end": 1186.87,
    "text": "让我们为您提供帮助"
  },
  {
    "start": 1186.87,
    "end": 1188.47,
    "text": "请记住"
  },
  {
    "start": 1188.47,
    "end": 1192.55,
    "text": "我们的距离只隔着一个心跳和一个转念"
  },
  {
    "start": 1192.55,
    "end": 1197.8,
    "text": "我们用神圣 无条件的爱将你们环绕"
  },
  {
    "start": 1197.8,
    "end": 1198.16,
    "text": "455 00:19:58,160 --> 00:19:59,500 我是大天使"
  }
]