[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "无限呼吸 / 静止点 冥想方法"
  },
  {
    "start": 6.28,
    "end": 8.32,
    "text": "光之信息"
  },
  {
    "start": 8.32,
    "end": 12.23,
    "text": "来自大天使MICHAEL的智慧教导"
  },
  {
    "start": 12.23,
    "end": 15.499,
    "text": "神圣抄写员Ronna Vezane"
  },
  {
    "start": 15.5,
    "end": 18.05,
    "text": "翻译 / 解读 暮雨"
  },
  {
    "start": 18.05,
    "end": 19.05,
    "text": "一个内心不安宁的人"
  },
  {
    "start": 21.59,
    "end": 24.12,
    "text": "呼吸总是快而浅的"
  },
  {
    "start": 24.12,
    "end": 26.15,
    "text": "只限于胸部与头部"
  },
  {
    "start": 26.15,
    "end": 29.38,
    "text": "而一个内心平和宁静的人"
  },
  {
    "start": 29.38,
    "end": 31.63,
    "text": "呼吸则自然沉到腹部"
  },
  {
    "start": 31.63,
    "end": 34.27,
    "text": "婴儿就是这样呼吸的"
  },
  {
    "start": 34.27,
    "end": 36.76,
    "text": "我们平躺或睡觉时"
  },
  {
    "start": 36.76,
    "end": 40.6,
    "text": "通常也会自动切换成这种腹式呼吸"
  },
  {
    "start": 40.6,
    "end": 42.62,
    "text": "这也是身体在睡眠中"
  },
  {
    "start": 42.62,
    "end": 44.94,
    "text": "容易获得修复的原因之一"
  },
  {
    "start": 44.94,
    "end": 46.61,
    "text": "有趣的是"
  },
  {
    "start": 46.61,
    "end": 52.1,
    "text": "当我追溯Spirit （精神 灵魂）这个词的词源时"
  },
  {
    "start": 52.1,
    "end": 55.06,
    "text": "发现它来自拉丁语的spiritus"
  },
  {
    "start": 55.06,
    "end": 59.5,
    "text": "意为 呼吸 精气 神灵的呼吸"
  },
  {
    "start": 59.5,
    "end": 61.94,
    "text": "这似乎暗示了 呼吸"
  },
  {
    "start": 61.94,
    "end": 64.12,
    "text": "与更高维度的精神世界"
  },
  {
    "start": 64.12,
    "end": 67.24,
    "text": "和神圣力量有着某种关联"
  },
  {
    "start": 67.24,
    "end": 68.36,
    "text": "然而"
  },
  {
    "start": 68.36,
    "end": 71.36,
    "text": "现代人已经忘记了古老的教义"
  },
  {
    "start": 71.36,
    "end": 73.86,
    "text": "以及如何正确地呼吸"
  },
  {
    "start": 73.86,
    "end": 76.97,
    "text": "导致我们的情绪 身体状况"
  },
  {
    "start": 76.97,
    "end": 79.6,
    "text": "思想和心灵都因此失衡"
  },
  {
    "start": 79.6,
    "end": 85.67,
    "text": "这篇文章为大家提供了一种解决办法 ——无限呼吸方法"
  },
  {
    "start": 85.67,
    "end": 88.39,
    "text": "来自大天使MICHAEL的智慧教导"
  },
  {
    "start": 88.39,
    "end": 90.86,
    "text": "通过练习无限呼吸"
  },
  {
    "start": 90.86,
    "end": 94.71,
    "text": "你会获得更多的能量 光和力量"
  },
  {
    "start": 94.71,
    "end": 97.47,
    "text": "为你的以太体和物质身体赋能"
  },
  {
    "start": 97.47,
    "end": 99.04,
    "text": "它们将神奇地加速"
  },
  {
    "start": 99.04,
    "end": 102.23,
    "text": "清理身体中任何不和谐的能量"
  },
  {
    "start": 102.23,
    "end": 103.36,
    "text": "此外"
  },
  {
    "start": 103.36,
    "end": 107.13,
    "text": "你还将逐渐获取更多 更高维度"
  },
  {
    "start": 107.13,
    "end": 109.36,
    "text": "新创造的思维形式"
  },
  {
    "start": 109.36,
    "end": 113.3,
    "text": "同时将它们锚定在你的物质身体和现实中"
  },
  {
    "start": 113.3,
    "end": 115.38,
    "text": "并深深地扎根于地球"
  },
  {
    "start": 115.38,
    "end": 117.38,
    "text": "42 00:01:57,380 --> 00:02:00,260 冥想前的准备"
  },
  {
    "start": 120.26,
    "end": 122.64,
    "text": "1.  首先"
  },
  {
    "start": 122.64,
    "end": 127.62,
    "text": "请确保 你将这份礼物用于所有人的最高福祉"
  },
  {
    "start": 127.62,
    "end": 129.78,
    "text": "你渴望为他人服务"
  },
  {
    "start": 129.78,
    "end": 133.29,
    "text": "并确保你的意愿与造物主的意愿一致"
  },
  {
    "start": 133.29,
    "end": 135.27,
    "text": "亲爱的勇士们"
  },
  {
    "start": 135.27,
    "end": 139.05,
    "text": "你不会被要求做任何你无法完成的事情"
  },
  {
    "start": 139.05,
    "end": 141.21,
    "text": "捍卫造物主事业的回报"
  },
  {
    "start": 141.21,
    "end": 143.97,
    "text": "将首先降临到你身上"
  },
  {
    "start": 143.97,
    "end": 147.33,
    "text": "然后经由你辐射到全世界"
  },
  {
    "start": 147.33,
    "end": 150.27,
    "text": "2.  阅读这些文字"
  },
  {
    "start": 150.27,
    "end": 152.94,
    "text": "直到你完全理解这些练习"
  },
  {
    "start": 152.94,
    "end": 155.47,
    "text": "并能在脑海中想象整个过程"
  },
  {
    "start": 155.47,
    "end": 156.55,
    "text": "然后"
  },
  {
    "start": 156.55,
    "end": 158.05,
    "text": "闭上眼睛"
  },
  {
    "start": 158.05,
    "end": 162.63,
    "text": "允许你的天使助手 或高我  超灵 来帮助你"
  },
  {
    "start": 162.63,
    "end": 164.88,
    "text": "让你的呼吸能量和光频率"
  },
  {
    "start": 164.88,
    "end": 168.11,
    "text": "顺畅而有力地流经你的身体"
  },
  {
    "start": 168.11,
    "end": 170.11,
    "text": "64 00:02:50,110 --> 00:02:54,010 冥想方法 和 分步技术"
  },
  {
    "start": 174.01,
    "end": 178.71,
    "text": "・基础版 │无限呼吸冥想"
  },
  {
    "start": 178.71,
    "end": 180.77,
    "text": "深吸一口气"
  },
  {
    "start": 180.77,
    "end": 190.93,
    "text": "将你的意识 集中在太阳能量中心 （即胸腺 心脏 和太阳神经丛区域）"
  },
  {
    "start": 190.93,
    "end": 193.62,
    "text": "无论你如何感知"
  },
  {
    "start": 193.62,
    "end": 196.11,
    "text": "想象你的太阳能量中心"
  },
  {
    "start": 196.11,
    "end": 199.17,
    "text": "充满了创造的神圣光粒子"
  },
  {
    "start": 199.17,
    "end": 201.48,
    "text": "当你深呼吸时"
  },
  {
    "start": 201.48,
    "end": 205.29,
    "text": "感受能量 在你的身体内聚集"
  },
  {
    "start": 205.29,
    "end": 209.26,
    "text": "并沿着你的背部脊柱 向上移动"
  },
  {
    "start": 209.26,
    "end": 210.75,
    "text": "随后"
  },
  {
    "start": 210.75,
    "end": 214.07,
    "text": "能量进一步渗透到你的延髓"
  },
  {
    "start": 214.07,
    "end": 218.28,
    "text": "那里是脊柱与大脑最底部 相连的地方"
  },
  {
    "start": 218.28,
    "end": 222.92,
    "text": "其中包含 控制呼吸和循环的神经中枢"
  },
  {
    "start": 222.92,
    "end": 226.04,
    "text": "并连接着你的扬升脉轮"
  },
  {
    "start": 226.04,
    "end": 229.54,
    "text": "造物主之光的能量 继续移动"
  },
  {
    "start": 229.54,
    "end": 231.85,
    "text": "穿过扬升脉轮"
  },
  {
    "start": 231.85,
    "end": 234.55,
    "text": "离开你的后脑勺 以弧形"
  },
  {
    "start": 234.55,
    "end": 238.67,
    "text": "从头顶上方 约15厘米处流出"
  },
  {
    "start": 238.67,
    "end": 241.51,
    "text": "然后向下从你的面前扫过"
  },
  {
    "start": 241.51,
    "end": 245.03,
    "text": "并再次进入太阳能量中心"
  },
  {
    "start": 245.03,
    "end": 246.26,
    "text": "接着"
  },
  {
    "start": 246.26,
    "end": 250.1,
    "text": "能量继续沿着背部脊柱 向下流动"
  },
  {
    "start": 250.1,
    "end": 253.27,
    "text": "经过根脉轮 （即会阴部"
  },
  {
    "start": 253.27,
    "end": 254.55,
    "text": "海底轮）"
  },
  {
    "start": 254.55,
    "end": 256.54,
    "text": "以弧形离开身体"
  },
  {
    "start": 256.54,
    "end": 259.15,
    "text": "沿着身体前方上升"
  },
  {
    "start": 259.15,
    "end": 262.34,
    "text": "并再次返回太阳能量中心"
  },
  {
    "start": 262.34,
    "end": 265.4,
    "text": "完成一个完整的周期循环"
  },
  {
    "start": 265.4,
    "end": 268.38,
    "text": "透过每一次无限呼吸"
  },
  {
    "start": 268.38,
    "end": 273.26,
    "text": "你都会获得更多的能量 光 和力量"
  },
  {
    "start": 273.26,
    "end": 274.77,
    "text": "接下来"
  },
  {
    "start": 274.77,
    "end": 278.64,
    "text": "继续进行深沉 有节奏的呼吸"
  },
  {
    "start": 278.64,
    "end": 282.86,
    "text": "同时想象 这个光与能量的无限符号"
  },
  {
    "start": 282.86,
    "end": 284.39,
    "text": "其弧度"
  },
  {
    "start": 284.39,
    "end": 287.96,
    "text": "在你的头顶上方 和身体下方"
  },
  {
    "start": 287.96,
    "end": 289.98,
    "text": "不断向外延伸"
  },
  {
    "start": 289.98,
    "end": 291.99,
    "text": "越来越远"
  },
  {
    "start": 291.99,
    "end": 296.47,
    "text": "并使向下的弧线深入到地球内部"
  },
  {
    "start": 296.47,
    "end": 301.61,
    "text": "这些能量会随着每个有节奏的呼吸周期"
  },
  {
    "start": 301.61,
    "end": 305.4,
    "text": "再次回到你的太阳能量中心"
  },
  {
    "start": 305.4,
    "end": 307.7,
    "text": "只要你感觉舒适"
  },
  {
    "start": 307.7,
    "end": 310.4,
    "text": "就继续这个过程"
  },
  {
    "start": 310.4,
    "end": 312.78,
    "text": "因为随着你吸收越来越多"
  },
  {
    "start": 312.78,
    "end": 314.74,
    "text": "珍贵的金刚粒子"
  },
  {
    "start": 314.74,
    "end": 316.44,
    "text": "它们将神奇地加速"
  },
  {
    "start": 316.44,
    "end": 320.93,
    "text": "清理 身体中任何不和谐能量的过程"
  },
  {
    "start": 320.93,
    "end": 324.35,
    "text": "并用造物主之光的能量填补空缺"
  },
  {
    "start": 324.35,
    "end": 325.48,
    "text": "此外"
  },
  {
    "start": 325.48,
    "end": 329.57,
    "text": "你还将逐渐获取更多 更高维度"
  },
  {
    "start": 329.57,
    "end": 331.87,
    "text": "新创造的思维形式"
  },
  {
    "start": 331.87,
    "end": 336.72,
    "text": "同时 将它们锚定在你的物质身体和现实中"
  },
  {
    "start": 336.72,
    "end": 338.86,
    "text": "并深深地扎根于地球"
  },
  {
    "start": 338.86,
    "end": 344.29,
    "text": "当你与亲爱的地球分享这份奇妙的创造礼物时"
  },
  {
    "start": 344.29,
    "end": 346.91,
    "text": "地球将从这一过程中受益"
  },
  {
    "start": 346.91,
    "end": 348.45,
    "text": "反过来"
  },
  {
    "start": 348.45,
    "end": 352.3,
    "text": "地球将加强和协调与你的连接"
  },
  {
    "start": 352.3,
    "end": 355.71,
    "text": "帮助你实现 父神/母神在地球上"
  },
  {
    "start": 355.71,
    "end": 359.0,
    "text": "创造天堂家园的工作"
  },
  {
    "start": 359.38,
    "end": 360.58,
    "text": "暮雨·注"
  },
  {
    "start": 360.58,
    "end": 366.4,
    "text": "任何的不平衡都会导致我们的能量体中 产生真空"
  },
  {
    "start": 366.4,
    "end": 371.16,
    "text": "这些空缺 吸引了周围 类似频率的能量填补进来"
  },
  {
    "start": 371.16,
    "end": 373.28,
    "text": "详细的资料可以参考"
  },
  {
    "start": 373.28,
    "end": 374.44,
    "text": "朵洛莉丝·侃南的"
  },
  {
    "start": 374.44,
    "end": 378.74,
    "text": "《生死之间》第32集 讨论了邪恶"
  },
  {
    "start": 378.74,
    "end": 379.49,
    "text": "附身"
  },
  {
    "start": 379.49,
    "end": 382.6,
    "text": "邪气入侵是缘自能量的失衡"
  },
  {
    "start": 382.6,
    "end": 384.6,
    "text": "137 00:06:24,600 --> 00:06:28,280 ・静止点冥想 │ 零点能量"
  },
  {
    "start": 388.66,
    "end": 392.02,
    "text": "静止点  是在呼气结束 和"
  },
  {
    "start": 392.02,
    "end": 394.48,
    "text": "下一次吸气之间的停顿"
  },
  {
    "start": 394.48,
    "end": 396.69,
    "text": "（也就是止息）"
  },
  {
    "start": 396.69,
    "end": 398.41,
    "text": "关于止息"
  },
  {
    "start": 398.41,
    "end": 401.18,
    "text": "我们在《大角星人文摘》第15集中"
  },
  {
    "start": 401.18,
    "end": 404.77,
    "text": "有更详细的阐释"
  },
  {
    "start": 404.77,
    "end": 407.6,
    "text": "在呼吸的静止点时"
  },
  {
    "start": 407.6,
    "end": 410.86,
    "text": "将你的注意力集中在太阳能量中心"
  },
  {
    "start": 410.86,
    "end": 413.65,
    "text": "这是纯粹的创造时刻"
  },
  {
    "start": 413.65,
    "end": 415.66,
    "text": "一个有限的时刻"
  },
  {
    "start": 415.66,
    "end": 418.97,
    "text": "在这一刻我们处于完美的上帝时刻"
  },
  {
    "start": 418.97,
    "end": 423.66,
    "text": "你可能需要多练习几次静止点无限呼吸"
  },
  {
    "start": 423.66,
    "end": 425.48,
    "text": "以便熟悉这个过程"
  },
  {
    "start": 425.48,
    "end": 428.27,
    "text": "为了强调静止点时刻"
  },
  {
    "start": 428.27,
    "end": 431.88,
    "text": "你可以收紧腹部肌肉并轻轻吸一口气"
  },
  {
    "start": 431.88,
    "end": 436.53,
    "text": "这样做会关闭 体内无限能量的电路"
  },
  {
    "start": 436.53,
    "end": 440.6,
    "text": "并将其扩散到你的整个物理身体中"
  },
  {
    "start": 440.6,
    "end": 442.37,
    "text": "这是非常有益的"
  },
  {
    "start": 442.37,
    "end": 445.13,
    "text": "将加速你的转化过程"
  },
  {
    "start": 445.13,
    "end": 446.8,
    "text": "许多人问"
  },
  {
    "start": 446.8,
    "end": 449.54,
    "text": "在进行吸气和呼气时"
  },
  {
    "start": 449.54,
    "end": 453.22,
    "text": "呼吸应该在太阳能量中心的哪个位置进入"
  },
  {
    "start": 453.22,
    "end": 454.85,
    "text": "答案是"
  },
  {
    "start": 454.85,
    "end": 456.97,
    "text": "每个人的情况都不一样"
  },
  {
    "start": 456.97,
    "end": 459.33,
    "text": "当你练习时"
  },
  {
    "start": 459.33,
    "end": 463.68,
    "text": "呼吸 会在你太阳能量中心的适当位置"
  },
  {
    "start": 463.68,
    "end": 465.64,
    "text": "自动进入和退出"
  },
  {
    "start": 465.64,
    "end": 468.7,
    "text": "不要试图强迫和控制"
  },
  {
    "start": 468.7,
    "end": 473.22,
    "text": "这些智能的能量会自己找到合适的路径"
  },
  {
    "start": 473.6,
    "end": 477.18,
    "text": "静止点能量   或称零点能量"
  },
  {
    "start": 477.18,
    "end": 479.97,
    "text": "是宇宙中一切事物的源头"
  },
  {
    "start": 479.97,
    "end": 485.18,
    "text": "通过练习和完善无限呼吸和静止点冥想"
  },
  {
    "start": 485.18,
    "end": 486.62,
    "text": "你可以安全地接触到"
  },
  {
    "start": 486.62,
    "end": 490.77,
    "text": "上帝的呼吸和宇宙中最强大的能量"
  },
  {
    "start": 490.77,
    "end": 496.0,
    "text": "它们一直在那里等待着我们去利用"
  },
  {
    "start": 496.0,
    "end": 498.0,
