[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "整合七道光芒"
  },
  {
    "start": 6.25,
    "end": 9.12,
    "text": "重新定义自我欲望体"
  },
  {
    "start": 9.12,
    "end": 13.03,
    "text": "来自大天使MICHAEL的光之信息"
  },
  {
    "start": 13.03,
    "end": 15.64,
    "text": "神圣抄写员Ronna Vezane"
  },
  {
    "start": 15.64,
    "end": 18.19,
    "text": "翻译 / 解读 暮雨"
  },
  {
    "start": 18.19,
    "end": 21.34,
    "text": "想成为自己生命的掌控者"
  },
  {
    "start": 21.34,
    "end": 23.88,
    "text": "而不是被命运随意摆布"
  },
  {
    "start": 23.88,
    "end": 26.59,
    "text": "你应当首先成为 具有统一意识的"
  },
  {
    "start": 26.59,
    "end": 28.79,
    "text": "灵性/人性复合体"
  },
  {
    "start": 28.79,
    "end": 31.56,
    "text": "然而对于大多数人来说"
  },
  {
    "start": 31.56,
    "end": 34.47,
    "text": "身体的物理感官享受和欲望"
  },
  {
    "start": 34.47,
    "end": 37.75,
    "text": "已经凌驾于更具敏锐的灵性感官之上"
  },
  {
    "start": 37.75,
    "end": 39.04,
    "text": "因此"
  },
  {
    "start": 39.04,
    "end": 43.05,
    "text": "你需要重新定义 变异后的自我欲望体"
  },
  {
    "start": 43.05,
    "end": 46.58,
    "text": "重新建立你的自我意识 和灵魂意识之间的"
  },
  {
    "start": 46.58,
    "end": 47.9,
    "text": "正确关系"
  },
  {
    "start": 47.9,
    "end": 49.81,
    "text": "你们的目标是"
  },
  {
    "start": 49.81,
    "end": 53.41,
    "text": "整合和协调身体的七个主要脉轮"
  },
  {
    "start": 53.41,
    "end": 56.64,
    "text": "平衡 心理和情绪能量场"
  },
  {
    "start": 56.64,
    "end": 58.83,
    "text": "并用你的灵性体照亮它们"
  },
  {
    "start": 58.83,
    "end": 62.95,
    "text": "我们将从七种意识层次定义每个类别"
  },
  {
    "start": 62.95,
    "end": 65.28,
    "text": "以便你们能够迅速识别"
  },
  {
    "start": 65.28,
    "end": 68.35,
    "text": "需要重点关注 和纠正的内容"
  },
  {
    "start": 68.35,
    "end": 69.35,
    "text": "26 00:01:09,350 --> 00:01:12,940 进入第五维度 新地球"
  },
  {
    "start": 72.94,
    "end": 75.0,
    "text": "亲爱的大师们"
  },
  {
    "start": 75.0,
    "end": 76.95,
    "text": "当我们监测你们的进展"
  },
  {
    "start": 76.95,
    "end": 80.21,
    "text": "衡量你们思维模式的光商水平"
  },
  {
    "start": 80.21,
    "end": 82.15,
    "text": "看到你们积极地整合"
  },
  {
    "start": 82.15,
    "end": 84.74,
    "text": "造物主意识的奇妙能量"
  },
  {
    "start": 84.74,
    "end": 86.91,
    "text": "我们为你们取得的惊人进步"
  },
  {
    "start": 86.91,
    "end": 89.27,
    "text": "感到非常欣慰"
  },
  {
    "start": 89.27,
    "end": 92.95,
    "text": "消极思想形式作为能量漩涡"
  },
  {
    "start": 92.95,
    "end": 95.98,
    "text": "在三个较低的星光层盘旋已久"
  },
  {
    "start": 95.98,
    "end": 98.0,
    "text": "影响了人类亿万年"
  },
  {
    "start": 98.0,
    "end": 99.28,
    "text": "现在"
  },
  {
    "start": 99.28,
    "end": 103.04,
    "text": "它们正逐渐被希望 灵感 喜悦"
  },
  {
    "start": 103.04,
    "end": 105.6,
    "text": "等积极的思想形式取代"
  },
  {
    "start": 105.6,
    "end": 107.78,
    "text": "人们开始认识到"
  },
  {
    "start": 107.78,
    "end": 111.83,
    "text": "匮乏 只是一种不平衡的消极思想"
  },
  {
    "start": 111.83,
    "end": 115.78,
    "text": "而丰盛 是每个人与生俱来的神圣权利"
  },
  {
    "start": 115.78,
    "end": 118.72,
    "text": "为了继承你的神圣遗产"
  },
  {
    "start": 118.72,
    "end": 122.0,
    "text": "你们所要做的 就是接受和相信"
  },
  {
    "start": 122.0,
    "end": 124.95,
    "text": "——自己是值得拥有的这一事实"
  },
  {
    "start": 124.95,
    "end": 129.61,
    "text": "并通过积极的思想 善意的行为 和具体行动"
  },
  {
    "start": 129.61,
    "end": 132.08,
    "text": "来巩固这一现实"
  },
  {
    "start": 132.45,
    "end": 136.0,
    "text": "暮雨·注这里大天使MICHAEL提到的光商"
  },
  {
    "start": 136.0,
    "end": 139.91,
    "text": "我们在另一个视频中详细阐释了这个概念"
  },
  {
    "start": 139.91,
    "end": 142.75,
    "text": "这是一则来自大角星人的信息"
  },
  {
    "start": 143.13,
    "end": 147.7,
    "text": "光商   是你的能量场中 能够容纳的光能量"
  },
  {
    "start": 147.7,
    "end": 149.73,
    "text": "和光频率的百分比"
  },
  {
    "start": 149.73,
    "end": 154.3,
    "text": "无论你的目标是 将自己提升至第五维度"
  },
  {
    "start": 154.3,
    "end": 157.21,
    "text": "还是迈入新地球的实相"
  },
  {
    "start": 157.21,
    "end": 159.15,
    "text": "你都需要更高的光商"
  },
  {
    "start": 159.15,
    "end": 161.76,
    "text": "这则来自大角星人的信息"
  },
  {
    "start": 161.76,
    "end": 163.59,
    "text": "提供了一些方法"
  },
  {
    "start": 163.59,
    "end": 167.82,
    "text": "可以帮助你提升灵性光商"
  },
  {
    "start": 167.82,
    "end": 168.82,
    "text": "62 00:02:48,820 --> 00:02:51,910 一个强大而奇妙的新愿景"
  },
  {
    "start": 171.91,
    "end": 175.35,
    "text": "一个人类与地球的可能性未来"
  },
  {
    "start": 175.35,
    "end": 178.43,
    "text": "正等待着你们进入第五维度的实相"
  },
  {
    "start": 178.43,
    "end": 182.99,
    "text": "这个愿景每时每刻都在被加强和放大"
  },
  {
    "start": 182.99,
    "end": 185.31,
    "text": "这是一个所有人类"
  },
  {
    "start": 185.31,
    "end": 189.39,
    "text": "以及矿物 植物 动物 精灵和元素王国"
  },
  {
    "start": 189.39,
    "end": 192.06,
    "text": "将在地球和平共存的未来"
  },
  {
    "start": 192.06,
    "end": 195.58,
    "text": "请想象一个美丽而原始的地球"
  },
  {
    "start": 195.58,
    "end": 198.62,
    "text": "有着清澈闪亮的水滋养着万物"
  },
  {
    "start": 198.62,
    "end": 201.17,
    "text": "清新健康的空气供你们呼吸"
  },
  {
    "start": 201.17,
    "end": 205.21,
    "text": "这将是一个充满丰盛和富足的世界"
  },
  {
    "start": 205.21,
    "end": 207.93,
    "text": "没有人会因缺乏足够的食物"
  },
  {
    "start": 207.93,
    "end": 210.68,
    "text": "住所或机会而遭受苦难"
  },
  {
    "start": 210.68,
    "end": 214.22,
    "text": "这将是一个不同种族 文化"
  },
  {
    "start": 214.22,
    "end": 218.77,
    "text": "信仰和传统都被受到尊重的世界 ——"
  },
  {
    "start": 218.77,
    "end": 223.13,
    "text": "没有人会试图将自己的信仰强加于他人"
  },
  {
    "start": 223.13,
    "end": 224.97,
    "text": "否认他人的真理"
  },
  {
    "start": 224.97,
    "end": 227.88,
    "text": "或剥夺他们遵循习俗生活的权利"
  },
  {
    "start": 227.88,
    "end": 231.78,
    "text": "随着越来越多的人将注意力和思想"
  },
  {
    "start": 231.78,
    "end": 236.62,
    "text": "从旧有的 自我限制性思维模式中抽离"
  },
  {
    "start": 236.62,
    "end": 240.94,
    "text": "这些消极心理正逐渐消失并丧失影响力"
  },
  {
    "start": 240.94,
    "end": 243.2,
    "text": "我们一再强调"
  },
  {
    "start": 243.2,
    "end": 245.36,
    "text": "你的思想具有能量 ——"
  },
  {
    "start": 245.36,
    "end": 249.14,
    "text": "无论积极或消极 ——你所关注的"
  },
  {
    "start": 249.14,
    "end": 250.52,
    "text": "就会被放大"
  },
  {
    "start": 251.02,
    "end": 251.52,
    "text": "88 00:04:11,520 --> 00:04:15,730 你们中许多人 如此着迷于扬升的渴望"
  },
  {
    "start": 255.73,
    "end": 259.7,
    "text": "盼望生活在 更高维度的感知天堂中"
  },
  {
    "start": 259.7,
    "end": 261.57,
    "text": "以至于忘记和忽视了"
  },
  {
    "start": 261.57,
    "end": 266.7,
    "text": "体验旅程的壮丽 奇迹 喜悦 和益处"
  },
  {
    "start": 266.7,
    "end": 269.76,
    "text": "每个新的意识扩展阶段"
  },
  {
    "start": 269.76,
    "end": 272.27,
    "text": "都有其特殊的意义和奇迹"
  },
  {
    "start": 272.27,
    "end": 274.96,
    "text": "它们值得你细细品味和享受"
  },
  {
    "start": 274.96,
    "end": 277.55,
    "text": "每当你释放一些旧有的"
  },
  {
    "start": 277.55,
    "end": 281.24,
    "text": "自我限制性 痛苦的思想模式 习惯"
  },
  {
    "start": 281.24,
    "end": 283.8,
    "text": "或内在的不和谐能量时"
  },
  {
    "start": 283.8,
    "end": 285.54,
    "text": "你就会经历转变"
  },
  {
    "start": 285.54,
    "end": 288.99,
    "text": "去除掉你的一部分（或很大部分）伪装"
  },
  {
    "start": 288.99,
    "end": 291.45,
    "text": "如此 你就能够整合"
  },
  {
    "start": 291.45,
    "end": 293.74,
    "text": "神圣自我的另一个方面"
  },
  {
    "start": 293.74,
    "end": 296.63,
    "text": "通过这种持续的内在工作"
  },
  {
    "start": 296.63,
    "end": 298.93,
    "text": "你逐渐创造了一个新的"
  },
  {
    "start": 298.93,
    "end": 300.48,
    "text": "更有力量的自我"
  },
  {
    "start": 300.48,
    "end": 301.74,
    "text": "由此"
  },
  {
    "start": 301.74,
    "end": 304.86,
    "text": "一个全新的现实向你敞开"
  },
  {
    "start": 304.86,
    "end": 307.38,
    "text": "你将接触到许多新概念"
  },
  {
    "start": 307.38,
    "end": 308.89,
    "text": "解锁更多才能"
  },
  {
    "start": 308.89,
    "end": 314.5,
    "text": "而你对更精微的灵性世界的敏感性（即 量子世界）"
  },
  {
    "start": 314.5,
    "end": 318.17,
    "text": "将奇迹般地 在你周围逐渐展现"
  },
  {
    "start": 318.17,
    "end": 319.86,
    "text": "那些多年来"
  },
  {
    "start": 319.86,
    "end": 322.65,
    "text": "遵循我们教导的人都知道"
  },
  {
    "start": 322.65,
    "end": 325.49,
    "text": "地球上灵性和人性体验的主要课题"
  },
  {
    "start": 325.49,
    "end": 328.89,
    "text": "是分离 二元性和极性"
  },
  {
    "start": 328.89,
    "end": 332.23,
    "text": "其最终目标是回归到 你们多维度自我的"
  },
  {
    "start": 332.23,
    "end": 334.49,
    "text": "平衡 和谐与完整"
  },
  {
    "start": 334.49,
    "end": 337.53,
    "text": "以及与一切万有的合一意识"
  },
  {
    "start": 337.53,
    "end": 340.14,
    "text": "当你们踏上冒险之旅"
  },
  {
    "start": 340.14,
    "end": 343.67,
    "text": "去履行造物主的神圣使命时"
  },
  {
    "start": 343.67,
    "end": 346.31,
    "text": "你们每个人都将自己的神圣自我"
  },
  {
    "start": 346.31,
    "end": 346.97,
    "text": "分裂成"
  },
  {
    "start": 346.97,
    "end": 349.16,
    "text": "数百个个体意识火花"
  },
  {
    "start": 349.16,
    "end": 350.61,
    "text": "造物主说"
  },
  {
    "start": 350.61,
    "end": 351.64,
    "text": "去吧"
  },
  {
    "start": 351.64,
    "end": 354.5,
    "text": "以我的名义创造无尽的新世界"
  },
  {
    "start": 354.88,
    "end": 355.58,
    "text": "然而"
  },
  {
    "start": 355.58,
    "end": 357.16,
    "text": "在旅程中"
  },
  {
    "start": 357.16,
    "end": 360.51,
    "text": "许多人忘记了一条重要的宇宙法则"
  },
  {
    "start": 360.51,
    "end": 362.81,
    "text": "你必须体验你所创造的事物"
  },
  {
    "start": 363.31,
    "end": 363.81,
    "text": "131 00:06:03,810 --> 00:06:08,590 重新走上和谐与灵性重聚之路的寻求者们"
  },
  {
    "start": 368.59,
    "end": 371.75,
    "text": "起因于你们厌倦了过去的痛苦和磨难"
  },
  {
    "start": 371.75,
    "end": 373.03,
    "text": "于是"
  },
  {
    "start": 373.03,
    "end": 376.12,
    "text": "你的灵魂自我终于引起了你的注意"
  },
  {
    "start": 376.12,
    "end": 378.91,
    "text": "这促使你准备好聆听灵魂的低语"
  },
  {
    "start": 378.91,
    "end": 382.5,
    "text": "而那些孜孜不倦追寻更高真理"
  },
  {
    "start": 382.5,
    "end": 385.67,
    "text": "并努力在生活中践行这一真理的人"
  },
  {
    "start": 385.67,
    "end": 387.69,
    "text": "现在正在收获回报"
  },
  {
    "start": 387.69,
    "end": 389.85,
    "text": "你们正在学习 ——"
  },
  {
    "start": 389.85,
    "end": 392.61,
    "text": "你们是自己生命的掌控者"
  },
  {
    "start": 392.61,
    "end": 394.82,
    "text": "而不是被命运随意摆布"
  },
  {
    "start": 394.82,
    "end": 399.18,
    "text": "你没有在遭受任何人的惩罚或奖赏"
  },
  {
    "start": 399.18,
    "end": 401.19,
    "text": "因为你已经意识到 ——"
  },
  {
    "start": 401.19,
    "end": 404.12,
    "text": "你对自己的思想和行为负责"
  },
  {
    "start": 404.12,
    "end": 406.21,
    "text": "并且是通过你自己发出的"
  },
  {
    "start": 406.21,
    "end": 409.56,
    "text": "和谐或不和谐的 频率模式"
  },
  {
    "start": 409.56,
    "end": 413.82,
    "text": "创造了自己的现实 ——全部的现实"
  },
  {
    "start": 413.82,
    "end": 415.87,
    "text": "你们终于认识到"
  },
  {
    "start": 415.87,
    "end": 418.15,
    "text": "你从未失去过任何东西"
  },
  {
    "start": 418.15,
    "end": 419.62,
    "text": "相反"
  },
  {
    "start": 419.62,
    "end": 423.36,
    "text": "当你的意愿与造物主的意愿对齐时"
  },
  {
    "start": 423.36,
    "end": 427.7,
    "text": "就为无限的奇迹和可能性进入你们的生活"
  },
  {
    "start": 427.7,
    "end": 430.71,
    "text": "打开了通道"
  },
  {
    "start": 430.71,
    "end": 431.71,
    "text": "155 00:07:11,710 --> 00:07:16,460 新自我  灵性 /人性 复合体"
  },
  {
    "start": 436.46,
    "end": 439.01,
    "text": "我们已经深入讨论过"
  },
  {
    "start": 439.01,
    "end": 444.06,
    "text": "如何恢复和调谐 你们多重脉轮系统的 所有面向"
  },
  {
    "start": 444.06,
    "end": 446.83,
    "text": "以及整合与平衡 造物主意识"
  },
  {
    "start": 446.83,
    "end": 450.5,
    "text": "光线的美德 品质 和属性的重要性"
  },
  {
    "start": 450.5,
    "end": 454.64,
    "text": "如果你存在的任何一个面向失去平衡"
  },
  {
    "start": 454.64,
    "end": 458.39,
    "text": "其他面向都将无法发挥其最大潜能"
  },
  {
    "start": 458.39,
    "end": 462.01,
    "text": "你们应当成为一个具有统一意识的"
  },
  {
    "start": 462.01,
    "end": 464.2,
    "text": "灵性和人性复合体"
  },
  {
    "start": 464.2,
    "end": 465.5,
    "text": "然而"
  },
  {
    "start": 465.5,
    "end": 467.54,
    "text": "对于大多数人来说"
  },
  {
    "start": 467.54,
    "end": 470.52,
    "text": "身体的物质感官享受和欲望"
  },
  {
    "start": 470.52,
    "end": 474.97,
    "text": "已经凌驾于他们更具敏锐的灵性感官之上"
  },
  {
    "start": 474.97,
    "end": 478.69,
    "text": "一个主要依赖大脑思维生活的人"
  },
  {
    "start": 478.69,
    "end": 482.76,
    "text": "错失了从心灵 精炼的情感 和灵魂中"
  },
  {
    "start": 482.76,
    "end": 486.58,
    "text": "获得奇迹 力量 与乐趣"
  },
  {
    "start": 486.58,
    "end": 489.14,
    "text": "一个受情绪驱使的人"
  },
  {
    "start": 489.14,
    "end": 492.12,
    "text": "生活在一个不稳定的世界中"
  },
  {
    "start": 492.12,
    "end": 496.18,
    "text": "他的世界缺乏坚实的基础或牢固的结构"
  },
  {
    "start": 496.18,
    "end": 501.66,
    "text": "因此容易受到日常事件 和周围人的情绪起伏影响"
  },
  {
    "start": 501.66,
    "end": 504.85,
    "text": "一个与灵性切断联结的人"
  },
  {
    "start": 504.85,
    "end": 506.8,
    "text": "过着没有希望的生活"
  },
  {
    "start": 506.8,
    "end": 510.93,
    "text": "无论他在物质世界中获得或积累了什么"
  },
  {
    "start": 510.93,
    "end": 513.64,
    "text": "他都过着一种难以滋养灵魂"
  },
  {
    "start": 513.64,
    "end": 516.33,
    "text": "无法于内心感到持久满足"
  },
  {
    "start": 516.33,
    "end": 518.83,
    "text": "失去光彩的生活"
  },
  {
    "start": 518.83,
    "end": 520.79,
    "text": "数千年来"
  },
  {
    "start": 520.79,
    "end": 524.11,
    "text": "人类一直专注于灵性的情感方面"
  },
  {
    "start": 524.11,
    "end": 527.93,
    "text": "却忽视了灵性的科学或思考层面"
  },
  {
    "start": 527.93,
    "end": 532.42,
    "text": "宇宙和天地万物都在最高造物主颁布的"
  },
  {
    "start": 532.42,
    "end": 535.23,
    "text": "永恒不变的宇宙法则下运作"
  },
  {
    "start": 535.23,
    "end": 539.44,
    "text": "了解这些法则并与之和谐共处"
  },
  {
    "start": 539.44,
    "end": 542.22,
    "text": "你就会与造物主的意志保持一致"
  },
  {
    "start": 542.22,
    "end": 544.81,
    "text": "结果是你们可以确信"
  },
  {
    "start": 544.81,
    "end": 548.32,
    "text": "宇宙中所有的美丽 恩赐和丰盛"
  },
  {
    "start": 548.32,
    "end": 549.7,
    "text": "都将属于你们"
  },
  {
    "start": 549.7,
    "end": 550.7,
    "text": "195 00:09:10,700 --> 00:09:17,490 重新定义自我欲望体  身体 /情感 /心智 /灵性"
  },
  {
    "start": 557.49,
    "end": 560.54,
    "text": "接下来至关重要的一步是"
  },
  {
    "start": 560.54,
    "end": 562.19,
    "text": "回归到我们所称的"
  },
  {
    "start": 562.19,
    "end": 563.78,
    "text": "四个较低身体系统的"
  },
  {
    "start": 563.78,
    "end": 565.19,
    "text": "和谐与平衡"
  },
  {
    "start": 565.19,
    "end": 569.54,
    "text": "即物质身体 情感 心智和灵性"
  },
  {
    "start": 569.54,
    "end": 570.86,
    "text": "首先"
  },
  {
    "start": 570.86,
    "end": 575.09,
    "text": "你需要了解每个脉轮的能量 品质和属性"
  },
  {
    "start": 575.09,
    "end": 578.72,
    "text": "以及它们如何影响四个身体系统"
  },
  {
    "start": 579.09,
    "end": 583.07,
    "text": "暮雨·注 关于人类的7层能量场"
  },
  {
    "start": 583.07,
    "end": 585.89,
    "text": "从里到外的顺序是 以太体"
  },
  {
    "start": 585.89,
    "end": 586.83,
    "text": "情绪体"
  },
  {
    "start": 586.83,
    "end": 587.89,
    "text": "心智体"
  },
  {
    "start": 587.89,
    "end": 589.06,
    "text": "星光体"
  },
  {
    "start": 589.06,
    "end": 590.39,
    "text": "以太体模版"
  },
  {
    "start": 590.39,
    "end": 591.74,
    "text": "天人体"
  },
  {
    "start": 591.74,
    "end": 593.65,
    "text": "因果体或称精微身"
  },
  {
    "start": 593.65,
    "end": 597.26,
    "text": "这是目前大多数人采取的分类方法"
  },
  {
    "start": 597.26,
    "end": 601.45,
    "text": "这里大天使Michael提到的四个较低身体系统"
  },
  {
    "start": 601.45,
    "end": 602.95,
    "text": "物质身体"
  },
  {
    "start": 602.95,
    "end": 605.56,
    "text": "情感 心智和灵性体"
  },
  {
    "start": 605.56,
    "end": 610.48,
    "text": "暮雨分析大天使是从能量属性的角度"
  },
  {
    "start": 610.48,
    "end": 614.58,
    "text": "把以太体和星光体都统一归为灵性体"
  },
  {
    "start": 614.58,
    "end": 618.47,
    "text": "以太体是物质身体的隐形能量副本"
  },
  {
    "start": 618.47,
    "end": 621.25,
    "text": "是最接近肉身的一层能量场"
  },
  {
    "start": 621.25,
    "end": 624.08,
    "text": "星光体在心智体之外"
  },
  {
    "start": 624.08,
    "end": 625.98,
    "text": "它与心轮相连"
  },
  {
    "start": 625.98,
    "end": 627.47,
    "text": "与爱有关"
  },
  {
    "start": 627.47,
    "end": 630.41,
    "text": "是连接我们与物质生活的较低脉轮"
  },
  {
    "start": 630.41,
    "end": 632.65,
    "text": "和我们灵性存在的较高脉轮"
  },
  {
    "start": 632.65,
    "end": 633.95,
    "text": "之间的桥梁"
  },
  {
    "start": 633.95,
    "end": 637.23,
    "text": "所有直觉 潜意识活动"
  },
  {
    "start": 637.23,
    "end": 639.05,
    "text": "都发生在这个层面"
  },
  {
    "start": 639.05,
    "end": 640.31,
    "text": "所以"
  },
  {
    "start": 640.31,
    "end": 644.86,
    "text": "当大天使Michael提到较低身体系统中的灵性体时"
  },
  {
    "start": 644.86,
    "end": 647.92,
    "text": "建议大家不要停留在字面的解读上"
  },
  {
    "start": 647.92,
    "end": 651.75,
    "text": "应理解其背后的本质"
  },
  {
    "start": 651.75,
    "end": 652.75,
    "text": "234 00:10:52,750 --> 00:10:56,340 激发和培养你的情商和心理直觉"
  },
  {
    "start": 656.34,
    "end": 657.96,
    "text": "是非常必要的"
  },
  {
    "start": 657.96,
    "end": 662.34,
    "text": "你需要重新定义 变异后的自我欲望体"
  },
  {
    "start": 662.34,
    "end": 664.68,
    "text": "并重新建立你的自我意识"
  },
  {
    "start": 664.68,
    "end": 667.4,
    "text": "和灵魂意识之间的正确关系"
  },
  {
    "start": 667.78,
    "end": 672.15,
    "text": "自我意识被设计为在灵魂的指导下运作"
  },
  {
    "start": 672.15,
    "end": 673.72,
    "text": "而不是相反"
  },
  {
    "start": 673.72,
    "end": 675.08,
    "text": "因此"
  },
  {
    "start": 675.08,
    "end": 679.16,
    "text": "你应将注意力集中于你内在世界的现实"
  },
  {
    "start": 679.16,
    "end": 681.46,
    "text": "而不是外部世界的幻象"
  },
  {
    "start": 681.46,
    "end": 683.05,
    "text": "这意味着"
  },
  {
    "start": 683.05,
    "end": 687.68,
    "text": "你将不再寻求某件事 某个人或某个事物"
  },
  {
    "start": 687.68,
    "end": 690.6,
    "text": "来获得片刻的满足或幸福 ——"
  },
  {
    "start": 690.6,
    "end": 692.74,
    "text": "这些通常是短暂的"
  },
  {
    "start": 692.74,
    "end": 695.29,
    "text": "且往往无法达到你的期望"
  },
  {
    "start": 695.29,
    "end": 697.33,
    "text": "当你转向内心"
  },
  {
    "start": 697.33,
    "end": 699.74,
    "text": "确认你的自我价值"
  },
  {
    "start": 699.74,
    "end": 703.19,
    "text": "滋养你的情感和精神需求时"
  },
  {
    "start": 703.19,
    "end": 708.49,
    "text": "你将获得 源源不断的内在力量 和支持"
  },
  {
    "start": 708.49,
    "end": 709.49,
    "text": "254 00:11:49,490 --> 00:11:53,470 整合七道光芒 / 七个脉轮"
  },
  {
    "start": 713.47,
    "end": 716.28,
    "text": "你们中的许多人 选择体验"
  },
  {
    "start": 716.28,
    "end": 719.866,
    "text": "第一 第三 或第五道光芒的强大能量"
  },
  {
    "start": 720.089,
    "end": 722.1,
    "text": "（即 海底轮"
  },
  {
    "start": 722.34,
    "end": 725.28,
    "text": "太阳神经丛脉轮 和喉轮）"
  },
  {
    "start": 725.49,
    "end": 727.84,
    "text": "这往往导致一种倾向 ——"
  },
  {
    "start": 728.03,
    "end": 729.54,
    "text": "几乎只使用左脑"
  },
  {
    "start": 729.72,
    "end": 731.85,
    "text": "即代表理性的脑半球"
  },
  {
    "start": 731.85,
    "end": 735.51,
    "text": "以致形成一种线性 向外关注的"
  },
  {
    "start": 735.51,
    "end": 737.48,
    "text": "分析型思维模式"
  },
  {
    "start": 737.48,
    "end": 738.75,
    "text": "然而"
  },
  {
    "start": 738.75,
    "end": 741.78,
    "text": "你们人生课程的一个主要重点是 ——"
  },
  {
    "start": 741.78,
    "end": 745.21,
    "text": "学习使用抽象 /情感的右脑结构"
  },
  {
    "start": 745.21,
    "end": 749.24,
    "text": "探索并整合你们本性中的情感方面"
  },
  {
    "start": 749.24,
    "end": 751.37,
    "text": "第二道光芒的人"
  },
  {
    "start": 751.37,
    "end": 754.81,
    "text": "通常在生理和心理方面更加平衡"
  },
  {
    "start": 754.81,
    "end": 756.35,
    "text": "（即 脐轮"
  },
  {
    "start": 756.35,
    "end": 758.89,
    "text": "也是位于腹部的力量中心）"
  },
  {
    "start": 758.89,
    "end": 762.86,
    "text": "因此他们会探索并使用大脑的左右半球"
  },
  {
    "start": 762.86,
    "end": 765.72,
    "text": "但情况并非总是如此"
  },
  {
    "start": 765.72,
    "end": 767.22,
    "text": "最后"
  },
  {
    "start": 767.22,
    "end": 769.59,
    "text": "那些选择在此生体验和平衡"
  },
  {
    "start": 769.59,
    "end": 772.93,
    "text": "第四 第六和第七道光芒的人"
  },
  {
    "start": 772.93,
    "end": 774.55,
    "text": "（即 心轮"
  },
  {
    "start": 774.55,
    "end": 776.89,
    "text": "眉心轮 和顶轮）"
  },
  {
    "start": 776.89,
    "end": 780.01,
    "text": "倾向于主要在右脑结构中运作"
  },
  {
    "start": 780.01,
    "end": 782.88,
    "text": "他们的本性往往非常情绪化"
  },
  {
    "start": 782.88,
    "end": 787.23,
    "text": "他们的世界常常被认为是情绪的过山车"
  },
  {
    "start": 787.23,
    "end": 790.82,
    "text": "很难找到平衡或和谐地生活"
  },
  {
    "start": 790.82,
    "end": 792.94,
    "text": "我们再次强调"
  },
  {
    "start": 792.94,
    "end": 795.12,
    "text": "你们的目标是整合和协调"
  },
  {
    "start": 795.12,
    "end": 797.43,
    "text": "身体的七个主要脉轮"
  },
  {
    "start": 797.43,
    "end": 800.59,
    "text": "平衡心智体和情绪体的能量场"
  },
  {
    "start": 800.59,
    "end": 803.17,
    "text": "并用你的灵性本质照亮它们"
  },
  {
    "start": 803.17,
    "end": 806.27,
    "text": "下面我们将定义每个类别"
  },
  {
    "start": 806.27,
    "end": 808.42,
    "text": "以便你们能够迅速识别"
  },
  {
    "start": 808.42,
    "end": 812.84,
    "text": "需要重点关注和纠正的内容"
  },
  {
    "start": 812.84,
    "end": 813.84,
    "text": "295 00:13:33,840 --> 00:13:36,890 七种意识层次"
  },
  {
    "start": 816.89,
    "end": 819.69,
    "text": "心智体焦点"
  },
  {
    "start": 819.69,
    "end": 822.92,
    "text": "当心智体是主要关注点时"
  },
  {
    "start": 822.92,
    "end": 826.21,
    "text": "你的信念系统 态度和知识"
  },
  {
    "start": 826.21,
    "end": 829.97,
    "text": "仅来源于书本和历史/传统的叙述"
  },
  {
    "start": 829.97,
    "end": 832.58,
    "text": "而没有情感或灵性上的验证"
  },
  {
    "start": 832.58,
    "end": 835.0,
    "text": "你倾向善于分析"
  },
  {
    "start": 835.0,
    "end": 837.07,
    "text": "常表现得刻板僵化"
  },
  {
    "start": 837.07,
    "end": 838.87,
    "text": "喜好评判"
  },
  {
    "start": 838.87,
    "end": 840.92,
    "text": "并总是保持理智的控制"
  },
  {
    "start": 840.92,
    "end": 843.21,
    "text": "你的想象力有限"
  },
  {
    "start": 843.21,
    "end": 847.53,
    "text": "只相信有形的和可以科学验证的事物"
  },
  {
    "start": 847.53,
    "end": 850.33,
    "text": "情绪体焦点"
  },
  {
    "start": 850.33,
    "end": 854.53,
    "text": "当情绪体 作为你内在的驱动力时"
  },
  {
    "start": 854.53,
    "end": 856.78,
    "text": "你很容易受到大众意识"
  },
  {
    "start": 856.78,
    "end": 859.11,
    "text": "强烈情绪浪潮的影响"
  },
  {
    "start": 859.11,
    "end": 861.13,
    "text": "并被偏离了真实本性的"
  },
  {
    "start": 861.13,
    "end": 862.84,
    "text": "自我情绪所左右"
  },
  {
    "start": 862.84,
    "end": 865.38,
    "text": "你需要检查和了解"
  },
  {
    "start": 865.38,
    "end": 868.14,
    "text": "你的情绪如何通过欲望和需求"
  },
  {
    "start": 868.14,
    "end": 869.95,
    "text": "来驱动和控制你"
  },
  {
    "start": 869.95,
    "end": 873.42,
    "text": "并仔细审视自己的动机"
  },
  {
    "start": 873.42,
    "end": 876.89,
    "text": "被灵性体照亮的心智体"
  },
  {
    "start": 876.89,
    "end": 881.13,
    "text": "当你学会整合你的神性之光 和灵魂之光 的"
  },
  {
    "start": 881.13,
    "end": 884.77,
    "text": "所有属性 品质 和美德时"
  },
  {
    "start": 884.77,
    "end": 887.92,
    "text": "你就学会了利用超意识心智的智慧"
  },
  {
    "start": 887.92,
    "end": 890.78,
    "text": "以及如何专注于当下的静止点"
  },
  {
    "start": 890.78,
    "end": 893.31,
    "text": "你已经完善了整个过程"
  },
  {
    "start": 893.31,
    "end": 896.87,
    "text": "即 疗愈过去 规划未来"
  },
  {
    "start": 896.87,
    "end": 899.49,
    "text": "活在当下的力量中"
  },
  {
    "start": 899.49,
    "end": 902.96,
    "text": "被灵性体照亮的情绪体"
  },
  {
    "start": 902.96,
    "end": 907.45,
    "text": "当心智体和情绪体达到和谐统一时"
  },
  {
    "start": 907.45,
    "end": 911.3,
    "text": "在你永无止境地 追求启蒙的过程中"
  },
  {
    "start": 911.3,
    "end": 913.33,
    "text": "你将学会依赖你的心理直觉"
  },
  {
    "start": 913.33,
    "end": 917.12,
    "text": "去验证 和整合你所接触到的更高真理"
  },
  {
    "start": 917.12,
    "end": 922.63,
    "text": "你学会通过心灵 和灵魂的监视器 验证你的真理"
  },
  {
    "start": 922.63,
    "end": 925.55,
    "text": "并尽你所能地遵循这些真理生活"
  },
  {
    "start": 925.55,
    "end": 928.8,
    "text": "新的扩展性思维和观念"
  },
  {
    "start": 928.8,
    "end": 931.62,
    "text": "将成为你生活的常态"
  },
  {
    "start": 931.62,
    "end": 936.38,
    "text": "情绪体+心智体  等于情感智力"
  },
  {
    "start": 936.38,
    "end": 940.84,
    "text": "你所散发的情绪能量和你专注的意图"
  },
  {
    "start": 940.84,
    "end": 943.99,
    "text": "是创造过程中最重要的组成部分"
  },
  {
    "start": 943.99,
    "end": 948.8,
    "text": "当你的情绪体与心智体达到力量平衡时"
  },
  {
    "start": 948.8,
    "end": 950.74,
    "text": "你开始了解自己"
  },
  {
    "start": 950.74,
    "end": 953.42,
    "text": "并学会识别行为背后的动机"
  },
  {
    "start": 953.42,
    "end": 956.46,
    "text": "当你理解了宇宙法则的运作"
  },
  {
    "start": 956.46,
    "end": 958.72,
    "text": "你逐渐学会将自己的意志"
  },
  {
    "start": 958.72,
    "end": 961.03,
    "text": "与上帝的意志保持一致"
  },
  {
    "start": 961.03,
    "end": 966.0,
    "text": "当你优雅而坚定地朝着你期望的目标前进时"
  },
  {
    "start": 966.0,
    "end": 970.25,
    "text": "最理想的状态是 情感的超然态度"
  },
  {
    "start": 970.63,
    "end": 973.43,
    "text": "暮雨·注 类似的概念"
  },
  {
    "start": 973.43,
    "end": 976.64,
    "text": "在《大角星人文摘》17集中提到"
  },
  {
    "start": 976.64,
    "end": 980.57,
    "text": "大角星人建议人类发展共情智力"
  },
  {
    "start": 980.57,
    "end": 983.7,
    "text": "必须找到连接思想和心灵的方法"
  },
  {
    "start": 983.7,
    "end": 987.15,
    "text": "一旦你发展了自己的共情智力"
  },
  {
    "start": 987.15,
    "end": 990.59,
    "text": "你将以某种神秘的方式影响集体 ——"
  },
  {
    "start": 990.59,
    "end": 993.76,
    "text": "你通过微观量子效应做到这一点"
  },
  {
    "start": 993.76,
    "end": 996.71,
    "text": "这不是什么模糊的温暖主意"
  },
  {
    "start": 996.71,
    "end": 999.47,
    "text": "这是物理学原理"
  },
  {
    "start": 999.47,
    "end": 1001.95,
    "text": "一个原子中最微小的变化"
  },
  {
    "start": 1001.95,
    "end": 1004.22,
    "text": "都能影响一个分子"
  },
  {
    "start": 1004.22,
    "end": 1006.98,
    "text": "而分子进而影响整个结构"
  },
  {
    "start": 1006.98,
    "end": 1012.12,
    "text": "因为我们每个人都与彼此 与万物相连"
  },
  {
    "start": 1012.12,
    "end": 1015.84,
    "text": "灵性体 /心智体意识"
  },
  {
    "start": 1015.84,
    "end": 1019.43,
    "text": "当你开始使用灵魂自我的智慧"
  },
  {
    "start": 1019.43,
    "end": 1021.64,
    "text": "你将触及无限可能性的"
  },
  {
    "start": 1021.64,
    "end": 1024.31,
    "text": "宇宙神圣之光的能量流"
  },
  {
    "start": 1024.31,
    "end": 1026.77,
    "text": "当你在第五维度中"
  },
  {
    "start": 1026.77,
    "end": 1030.96,
    "text": "创造和使用力量与光的金字塔时"
  },
  {
    "start": 1030.96,
    "end": 1032.45,
    "text": "你将学会如何绕过"
  },
  {
    "start": 1032.45,
    "end": 1035.13,
    "text": "第三/第四维度的扭曲"
  },
  {
    "start": 1035.13,
    "end": 1036.49,
    "text": "这一刻"
  },
  {
    "start": 1036.49,
    "end": 1038.95,
    "text": "真正的奇迹开始发生"
  },
  {
    "start": 1038.95,
    "end": 1041.35,
    "text": "你将毫无疑问地确信"
  },
  {
    "start": 1041.35,
    "end": 1045.75,
    "text": "你在所有的努力中都与圣灵紧密合作"
  },
  {
    "start": 1045.75,
    "end": 1049.44,
    "text": "灵性体 /情绪体意识"
  },
  {
    "start": 1049.44,
    "end": 1052.14,
    "text": "爱能够调和你的情绪"
  },
  {
    "start": 1052.14,
    "end": 1054.68,
    "text": "尽管你仍然具有人性"
  },
  {
    "start": 1054.68,
    "end": 1056.49,
    "text": "但你已经掌握了洞察力"
  },
  {
    "start": 1056.49,
    "end": 1058.54,
    "text": "当你置身于周围发生的"
  },
  {
    "start": 1058.54,
    "end": 1061.52,
    "text": "所有负面性生活戏剧时"
  },
  {
    "start": 1061.52,
    "end": 1062.84,
    "text": "你变得超然"
  },
  {
    "start": 1062.84,
    "end": 1064.23,
    "text": "如今"
  },
  {
    "start": 1064.23,
    "end": 1068.66,
    "text": "你从一个更高的视角 ——自我掌控者的角度"
  },
  {
    "start": 1068.66,
    "end": 1072.31,
    "text": "看待生活中的事件"
  },
  {
    "start": 1072.31,
    "end": 1072.81,
    "text": "386 00:17:53,310 --> 00:17:55,970 整合四个层面意识"
  },
  {
    "start": 1075.97,
    "end": 1079.46,
    "text": "灵性 /心智 /情感 /身体"
  },
  {
    "start": 1079.46,
    "end": 1084.05,
    "text": "当你通过内在的灵性和你的神性之光"
  },
  {
    "start": 1084.05,
    "end": 1087.62,
    "text": "从父神 /母神那里 获得滋养"
  },
  {
    "start": 1087.62,
    "end": 1090.81,
    "text": "你便不再向外寻求自我价值的验证"
  },
  {
    "start": 1090.81,
    "end": 1094.3,
    "text": "当你进入喜悦和幸福的状态时"
  },
  {
    "start": 1094.3,
    "end": 1096.82,
    "text": "也不再经历剧烈的情绪波动"
  },
  {
    "start": 1096.82,
    "end": 1099.83,
    "text": "你学会在这个世界中生活"
  },
  {
    "start": 1099.83,
    "end": 1101.99,
    "text": "它被你创造的 更高频率的"
  },
  {
    "start": 1101.99,
    "end": 1104.59,
    "text": "爱与光的能量场包围"
  },
  {
    "start": 1104.59,
    "end": 1107.14,
    "text": "因为你扩展了自己的意识"
  },
  {
    "start": 1107.14,
    "end": 1111.46,
    "text": "整合了目前可供你使用的 多维度自我"
  },
  {
    "start": 1111.46,
    "end": 1115.87,
    "text": "当你与神性自我的多个面向 合一时"
  },
  {
    "start": 1115.87,
    "end": 1118.52,
    "text": "你将生活在提升的意识状态中"
  },
  {
    "start": 1118.52,
    "end": 1123.44,
    "text": "你从一种成为的状态转变为存在的状态"
  },
  {
    "start": 1123.44,
    "end": 1126.15,
    "text": "你已经发展出清晰的洞察力"
  },
  {
    "start": 1126.15,
    "end": 1128.36,
    "text": "和纯粹的意图"
  },
  {
    "start": 1128.36,
    "end": 1130.77,
    "text": "不再受幻象的迷雾影响"
  },
  {
    "start": 1130.77,
    "end": 1136.18,
    "text": "你从神圣未显化的潜能宝库中获取智慧与力量"
  },
  {
    "start": 1136.18,
    "end": 1139.97,
    "text": "塑造并创造出你最伟大的愿景和愿望"
  },
  {
    "start": 1139.97,
    "end": 1141.86,
    "text": "与此同时"
  },
  {
    "start": 1141.86,
    "end": 1143.84,
    "text": "你与万物和谐共处"
  },
  {
    "start": 1143.84,
    "end": 1145.44,
    "text": "你坚信"
  },
  {
    "start": 1145.44,
    "end": 1148.24,
    "text": "只要你努力实现自己的目标"
  },
  {
    "start": 1148.24,
    "end": 1151.47,
    "text": "就能拥有或成为 你想要显化的一切"
  },
  {
    "start": 1151.47,
    "end": 1155.03,
    "text": "你逐渐学会信赖你的天使助手"
  },
  {
    "start": 1155.03,
    "end": 1158.48,
    "text": "并从他们的存在中获取力量和营养"
  },
  {
    "start": 1158.48,
    "end": 1163.6,
    "text": "最终你将被视为在人类形态中展现出和谐与统一"
  },
  {
    "start": 1163.6,
    "end": 1166.25,
    "text": "一个光芒四射的灵性存在"
  },
  {
    "start": 1166.25,
    "end": 1168.41,
    "text": "勇敢的心灵们"
  },
  {
    "start": 1168.41,
    "end": 1170.14,
    "text": "在扬升的道路上"
  },
  {
    "start": 1170.14,
    "end": 1173.51,
    "text": "我们可以为你们提供工具和知识"
  },
  {
    "start": 1173.51,
    "end": 1176.34,
    "text": "鼓励和启发 然而"
  },
  {
    "start": 1176.34,
    "end": 1179.85,
    "text": "你必须自愿将知识转化为智慧"
  },
  {
    "start": 1179.85,
    "end": 1182.45,
    "text": "并采取必要的行动"
  },
  {
    "start": 1182.45,
    "end": 1185.06,
    "text": "最终收回你被封印的神性"
  },
  {
    "start": 1185.06,
    "end": 1188.25,
    "text": "迎接一直在等待着你的荣耀"
  },
  {
    "start": 1188.25,
    "end": 1191.68,
    "text": "我是你旅途中的忠实伙伴"
  },
  {
    "start": 1191.68,
    "end": 1194.26,
    "text": "你被无限地爱着"
  },
  {
    "start": 1194.26,
    "end": 1197.119,
    "text": "我是大天使 Michael"
  },
  {
    "start": 1197.12,
    "end": 1197.62,
    "text": "430 00:19:57,620 --> 00:20:00,720 作者补充"
  },
  {
    "start": 1200.72,
    "end": 1205.52,
    "text": "造物主本质  │ 光之金字塔能量场"
  },
  {
    "start": 1205.52,
    "end": 1208.94,
    "text": "我们的父神/母神 上帝 和大天使"
  },
  {
    "start": 1208.94,
    "end": 1211.94,
    "text": "集体 在每个创造层级"
  },
  {
    "start": 1211.94,
    "end": 1215.05,
    "text": "都创造了具有生命力的光之金字塔"
  },
  {
    "start": 1215.05,
    "end": 1218.07,
    "text": "通过光之金字塔的能量场"
  },
  {
    "start": 1218.07,
    "end": 1221.62,
    "text": "我们可以访问生命的白火记忆种子原子"
  },
  {
    "start": 1221.62,
    "end": 1224.33,
    "text": "它们是造物主本质的金刚粒子"
  },
  {
    "start": 1224.33,
    "end": 1227.69,
    "text": "这些赋予生命的光之金字塔"
  },
  {
    "start": 1227.69,
    "end": 1231.27,
    "text": "让我们能够获取更高维度的光频率"
  },
  {
    "start": 1231.27,
    "end": 1233.91,
    "text": "这是促使我们转变的必要条件"
  },
  {
    "start": 1233.91,
    "end": 1235.17,
    "text": "这样"
  },
  {
    "start": 1235.17,
    "end": 1236.85,
    "text": "我们人类就能够返回"
  },
  {
    "start": 1236.85,
    "end": 1241.08,
    "text": "更高的意识状态 ——我们的神性状态"
  },
  {
    "start": 1241.08,
    "end": 1245.25,
    "text": "暮雨·注 有生命的光之金字塔"
  },
  {
    "start": 1245.25,
    "end": 1248.5,
    "text": "即这种能量场并非静态结构"
  },
  {
    "start": 1248.5,
    "end": 1252.24,
    "text": "而是动态的 充满能量和活力的存在"
  },
  {
    "start": 1252.24,
    "end": 1255.04,
    "text": "它们拥有生命和意识"
  },
  {
    "start": 1255.04,
    "end": 1257.65,
    "text": "能够与我们的意识和能量互动"
  },
  {
    "start": 1257.65,
    "end": 1259.86,
    "text": "当我们在冥想中"
  },
  {
    "start": 1259.86,
    "end": 1263.45,
    "text": "与这些光之金字塔能量场联结时"
  },
  {
    "start": 1263.45,
    "end": 1265.73,
    "text": "它们会透过我们的意图"
  },
  {
    "start": 1265.73,
    "end": 1270.84,
    "text": "为我们提供能量支持和转变的力量"
  },
  {
    "start": 1270.84,
    "end": 1271.34,
    "text": "455 00:21:11,340 --> 00:21:14,160 以太体"
  },
  {
    "start": 1274.16,
    "end": 1278.45,
    "text": "金色的以太网 包含了人体的完美蓝图"
  },
  {
    "start": 1278.45,
    "end": 1281.36,
    "text": "它是物质肉身的隐形能量副本"
  },
  {
    "start": 1281.36,
    "end": 1284.14,
    "text": "也被称为星光体 或以太体"
  },
  {
    "start": 1284.14,
    "end": 1287.84,
    "text": "它包含了我们三个较低层次 物理身体的"
  },
  {
    "start": 1287.84,
    "end": 1289.33,
    "text": "完美蓝图"
  },
  {
    "start": 1289.33,
    "end": 1294.04,
    "text": "（即 物质身体 情绪体 心智体 ）"
  },
  {
    "start": 1294.04,
    "end": 1297.98,
    "text": "它的作用是维持物质形态并赋予其活力"
  },
  {
    "start": 1297.98,
    "end": 1300.39,
    "text": "控制消化和吸收过程"
  },
  {
    "start": 1300.39,
    "end": 1304.31,
    "text": "修复因生活中的磨损 造成的物质形态损害"
  },
  {
    "start": 1304.31,
    "end": 1306.62,
    "text": "以太体作为记忆体"
  },
  {
    "start": 1306.62,
    "end": 1309.96,
    "text": "它容易受到我们的思想和情绪的影响"
  },
  {
    "start": 1309.96,
    "end": 1312.38,
    "text": "无论是积极的还是消极的"
  },
  {
    "start": 1312.38,
    "end": 1314.29,
    "text": "疾病或虚弱"
  },
  {
    "start": 1314.29,
    "end": 1317.52,
    "text": "会首先发生在以太体层面"
  },
  {
    "start": 1317.52,
    "end": 1320.6,
    "text": "然后才会逐渐渗透到物质身体"
  },
  {
    "start": 1320.6,
    "end": 1322.06,
    "text": "同样"
  },
  {
    "start": 1322.06,
    "end": 1326.39,
    "text": "物质身体的平衡与和谐也始于以太体"
  },
  {
    "start": 1326.39,
    "end": 1330.72,
    "text": "然后逐渐体现在肉身中"
  },
  {
    "start": 1330.72,
    "end": 1331.22,
    "text": "476 00:22:11,220 --> 00:22:15,930 心智体 是意识的三位一体"
  },
  {
    "start": 1335.93,
    "end": 1343.45,
    "text": "我们的心智体包含三个层面 意识心智  潜意识  和超意识心智"
  },
  {
    "start": 1343.45,
    "end": 1346.06,
    "text": "・意识心智"
  },
  {
    "start": 1346.06,
    "end": 1348.5,
    "text": "是由负责直觉的右脑"
  },
  {
    "start": 1348.5,
    "end": 1353.07,
    "text": "和负责线性思维 推理 分析的左脑组成"
  },
  {
    "start": 1353.07,
    "end": 1355.46,
    "text": "心智控制着大脑"
  },
  {
    "start": 1355.46,
    "end": 1358.05,
    "text": "而大脑被设计为超意识心智"
  },
  {
    "start": 1358.05,
    "end": 1361.85,
    "text": "和我们的超灵/更高自我的延伸"
  },
  {
    "start": 1361.85,
    "end": 1366.19,
    "text": "・潜意识  / 即我们的主观心智"
  },
  {
    "start": 1366.19,
    "end": 1368.33,
    "text": "潜意识记录并存储"
  },
  {
    "start": 1368.33,
    "end": 1370.39,
    "text": "我们所经历的一切"
  },
  {
    "start": 1370.39,
    "end": 1373.59,
    "text": "所见 所闻 所思和所感"
  },
  {
    "start": 1373.59,
    "end": 1376.84,
    "text": "潜意识从字面上理解一切"
  },
  {
    "start": 1376.84,
    "end": 1380.93,
    "text": "也就是说 无论我们是亲身经历了某件事"
  },
  {
    "start": 1380.93,
    "end": 1383.36,
    "text": "或只是生动地想象了它"
  },
  {
    "start": 1383.36,
    "end": 1386.11,
    "text": "潜意识都会将其视为事实"
  },
  {
    "start": 1386.11,
    "end": 1391.28,
    "text": "这就是为什么将消极的 使人衰弱的负面记忆"
  },
  {
    "start": 1391.28,
    "end": 1394.84,
    "text": "转变为正面积极的记忆是如此重要"
  },
  {
    "start": 1394.84,
    "end": 1397.09,
    "text": "我们的思想和意图"
  },
  {
    "start": 1397.09,
    "end": 1399.76,
    "text": "会与特定的频率产生共鸣"
  },
  {
    "start": 1399.76,
    "end": 1402.27,
    "text": "通过运用意志力（即意愿"
  },
  {
    "start": 1402.27,
    "end": 1404.83,
    "text": "意图） 和有意识的努力"
  },
  {
    "start": 1404.83,
    "end": 1407.6,
    "text": "改变我们投射出的频率模式"
  },
  {
    "start": 1407.6,
    "end": 1412.17,
    "text": "我们就可以创造出理想的生活 健康的身体和环境"
  },
  {
    "start": 1412.56,
    "end": 1414.88,
    "text": "暮雨·注 这段话说明了"
  },
  {
    "start": 1414.88,
    "end": 1416.95,
    "text": "意识不是由大脑产生"
  },
  {
    "start": 1416.95,
    "end": 1418.5,
    "text": "相反"
  },
  {
    "start": 1418.5,
    "end": 1422.51,
    "text": "大脑只是承载和表达意识的物理工具"
  },
  {
    "start": 1422.51,
    "end": 1425.33,
    "text": "・超意识心智"
  },
  {
    "start": 1425.33,
    "end": 1428.32,
    "text": "随着我们提升意识的频率模式"
  },
  {
    "start": 1428.32,
    "end": 1430.03,
    "text": "和振动场"
  },
  {
    "start": 1430.03,
    "end": 1432.38,
    "text": "我们能够进入越来越高层次的"
  },
  {
    "start": 1432.38,
    "end": 1433.97,
    "text": "造物主意识"
  },
  {
    "start": 1433.97,
    "end": 1436.09,
    "text": "一旦清除了连接我们与"
  },
  {
    "start": 1436.09,
    "end": 1442.77,
    "text": "高我  超灵 和第五维度神圣三位一体光柱中的 静电和扭曲"
  },
  {
    "start": 1442.77,
    "end": 1444.53,
    "text": "我们的超意识心智"
  },
  {
    "start": 1444.53,
    "end": 1448.61,
    "text": "就会直接从神圣心智中获得智慧"
  },
  {
    "start": 1448.61,
    "end": 1450.67,
    "text": "亲爱的朋友们"
  },
  {
    "start": 1450.67,
    "end": 1452.56,
    "text": "在这个充满剧变"
  },
  {
    "start": 1452.56,
    "end": 1455.38,
    "text": "混乱和动荡的压力时期"
  },
  {
    "start": 1455.38,
    "end": 1457.43,
    "text": "我们比以往任何时候"
  },
  {
    "start": 1457.43,
    "end": 1459.55,
    "text": "都更需要以心为中心"
  },
  {
    "start": 1459.55,
    "end": 1461.27,
    "text": "以及对灵魂的专注"
  },
  {
    "start": 1461.27,
    "end": 1463.83,
    "text": "我们的思想和情感"
  },
  {
    "start": 1463.83,
    "end": 1467.3,
    "text": "在世俗经历中创造了因果业力反应"
  },
  {
    "start": 1467.3,
    "end": 1470.55,
    "text": "当我们提升自己的振动模式"
  },
  {
    "start": 1470.55,
    "end": 1473.18,
    "text": "努力使自己的情绪体和心智体"
  },
  {
    "start": 1473.18,
    "end": 1475.17,
    "text": "恢复平衡与和谐"
  },
  {
    "start": 1475.17,
    "end": 1477.44,
    "text": "我们便脱离了业力之轮"
  },
  {
    "start": 1477.44,
    "end": 1479.57,
    "text": "重新回到恩典状态"
  },
  {
    "start": 1479.57,
    "end": 1481.14,
    "text": "多年来"
  },
  {
    "start": 1481.14,
    "end": 1485.0,
    "text": "我将大天使Michael越来越多的智慧真言"
  },
  {
    "start": 1485.0,
    "end": 1487.17,
    "text": "融入我的知识记忆库中"
  },
  {
    "start": 1487.17,
    "end": 1488.8,
    "text": "这极大地帮助了我"
  },
  {
    "start": 1488.8,
    "end": 1492.05,
    "text": "理解自己的特质和消极模式"
  },
  {
    "start": 1492.05,
    "end": 1494.67,
    "text": "让我拥有智慧和工具"
  },
  {
    "start": 1494.67,
    "end": 1496.99,
    "text": "逐渐成为自己命运的主人"
  },
  {
    "start": 1496.99,
    "end": 1500.36,
    "text": "我真诚地希望这些智慧教导"
  },
  {
    "start": 1500.36,
    "end": 1504.53,
    "text": "也能帮助你们在觉醒的道路上 优雅前行"
  },
  {
    "start": 1504.53,
    "end": 1506.68,
    "text": "永远爱你们"
  },
  {
    "start": 1506.68,
    "end": 1509.24,
    "text": "愿天使赐福"
  },
  {
    "start": 1509.24,
    "end": 1511.349,
    "text": "Ronna Vezane"
  },
  {
    "start": 1511.35,
    "end": 1512.35,
    "text": "547 00:25:12,350 --> 00:25:13,350"
  }
]