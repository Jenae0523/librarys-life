[
  {
    "start": 0.0,
    "end": 0.966,
    "text": "协调"
  },
  {
    "start": 0.966,
    "end": 6.033,
    "text": "你的身体 情绪体 和心智体来自大"
  },
  {
    "start": 6.033,
    "end": 8.966,
    "text": "天使MICHAEL的光之信息"
  },
  {
    "start": 9.0,
    "end": 12.733,
    "text": "神圣抄写员Ronna Vezane翻译"
  },
  {
    "start": 12.766,
    "end": 17.233,
    "text": "/ 解读 暮雨通向高"
  },
  {
    "start": 17.233,
    "end": 17.4,
    "text": "阶"
  },
  {
    "start": 17.4,
    "end": 20.933,
    "text": "意识的三个层面演化 首先"
  },
  {
    "start": 20.966,
    "end": 21.233,
    "text": "心"
  },
  {
    "start": 21.266,
    "end": 23.966,
    "text": "轮是通往高阶意识的桥梁"
  },
  {
    "start": 24.0,
    "end": 25.2,
    "text": "情绪体"
  },
  {
    "start": 25.2,
    "end": 26.566,
    "text": "感知能力"
  },
  {
    "start": 26.6,
    "end": 30.3,
    "text": "通过灵魂/神圣之心的中心进化"
  },
  {
    "start": 30.3,
    "end": 32.666,
    "text": "心智体 意识"
  },
  {
    "start": 32.7,
    "end": 35.4,
    "text": "通过神圣心智和灵魂意识进"
  },
  {
    "start": 35.4,
    "end": 36.133,
    "text": "化"
  },
  {
    "start": 36.133,
    "end": 42.433,
    "text": "灵性感悟力  通过灵魂 和当前存在于我们内在的超灵 /高我 来"
  },
  {
    "start": 42.433,
    "end": 43.633,
    "text": "实现的"
  },
  {
    "start": 43.666,
    "end": 46.0,
    "text": "人类的神圣心智"
  },
  {
    "start": 46.033,
    "end": 49.166,
    "text": "是一个储存在 大脑后部上方的"
  },
  {
    "start": 49.166,
    "end": 51.366,
    "text": "乙太水晶种子原子"
  },
  {
    "start": 51.4,
    "end": 53.266,
    "text": "这里有一层光膜"
  },
  {
    "start": 53.266,
    "end": 58.066,
    "text": "保护着进入神圣心智门户的通道 及其内容"
  },
  {
    "start": 58.066,
    "end": 60.633,
    "text": "直到你将自己的频率提升到更"
  },
  {
    "start": 60.633,
    "end": 63.866,
    "text": "高的 第四维度的适当水平"
  },
  {
    "start": 63.9,
    "end": 65.633,
    "text": "才被允许访问"
  },
  {
    "start": 65.633,
    "end": 70.666,
    "text": "你的神圣心智  包含你古老历史的浓缩版本"
  },
  {
    "start": 70.666,
    "end": 73.7,
    "text": "以及你在这个宇宙的众多前世中"
  },
  {
    "start": 73.7,
    "end": 76.966,
    "text": "所整合的部分智慧 和重要信息"
  },
  {
    "start": 77.0,
    "end": 81.033,
    "text": "在地球上 成为自我掌握的大师"
  },
  {
    "start": 81.033,
    "end": 84.8,
    "text": "包含获取和整合 储存在神圣心智中的"
  },
  {
    "start": 84.8,
    "end": 88.8,
    "text": "属性 品质 才能的必要部分"
  },
  {
    "start": 88.8,
    "end": 91.233,
    "text": "旧自我意识的死亡"
  },
  {
    "start": 91.266,
    "end": 96.366,
    "text": "灵魂意识 成为主导亲爱的大师们"
  },
  {
    "start": 96.366,
    "end": 100.933,
    "text": "当你们调谐到第四维度中段 的光频率时"
  },
  {
    "start": 100.933,
    "end": 103.866,
    "text": "你们就放下了作为人类的想法——"
  },
  {
    "start": 103.9,
    "end": 106.833,
    "text": "你将不再以过去的方式看待自己"
  },
  {
    "start": 106.833,
    "end": 107.0,
    "text": "作"
  },
  {
    "start": 107.0,
    "end": 109.466,
    "text": "为一个人的身份和存在"
  },
  {
    "start": 109.5,
    "end": 111.166,
    "text": "你对人类身份的理"
  },
  {
    "start": 111.166,
    "end": 114.433,
    "text": "解将发生根本性的转变"
  },
  {
    "start": 114.433,
    "end": 118.133,
    "text": "这是你的灵魂意识 开始显现的时刻"
  },
  {
    "start": 118.166,
    "end": 121.533,
    "text": "你允许它 成为你生活中的主导力量"
  },
  {
    "start": 121.533,
    "end": 126.266,
    "text": "这意味着你开始聆听 身体元素的智慧"
  },
  {
    "start": 126.3,
    "end": 128.033,
    "text": "听取它发出的 关于"
  },
  {
    "start": 128.033,
    "end": 132.2,
    "text": "什么是适合你 身体和情感健康的信号"
  },
  {
    "start": 132.2,
    "end": 134.9,
    "text": "你的DNA 和身体细胞"
  },
  {
    "start": 134.9,
    "end": 137.733,
    "text": "将开始整合更高频率的光"
  },
  {
    "start": 137.766,
    "end": 139.4,
    "text": "渐渐地"
  },
  {
    "start": 139.4,
    "end": 140.766,
    "text": "你开始与新时代的"
  },
  {
    "start": 140.8,
    "end": 143.566,
    "text": "精微能量 共振和调谐"
  },
  {
    "start": 143.566,
    "end": 146.6,
    "text": "这个转变的过程可以比喻为"
  },
  {
    "start": 146.633,
    "end": 148.966,
    "text": "旧的自我意识的死亡"
  },
  {
    "start": 149.0,
    "end": 152.0,
    "text": "这实际上是揭开幻象面纱的过程"
  },
  {
    "start": 152.366,
    "end": 156.333,
    "text": "暮雨·注关于旧自我意识的来源"
  },
  {
    "start": 156.366,
    "end": 159.4,
    "text": "唐望给出了特别的解释"
  },
  {
    "start": 159.433,
    "end": 161.3,
    "text": "人类有一个外来心智"
  },
  {
    "start": 161.3,
    "end": 164.633,
    "text": "来自于地球掠食者 / 黑影无机生物"
  },
  {
    "start": 164.666,
    "end": 167.766,
    "text": "它们是奴役人类的外来力量"
  },
  {
    "start": 167.766,
    "end": 169.166,
    "text": "另外"
  },
  {
    "start": 169.2,
    "end": 170.766,
    "text": "关于从自我意识的死"
  },
  {
    "start": 170.8,
    "end": 172.8,
    "text": "亡到真我的觉醒"
  },
  {
    "start": 172.8,
    "end": 174.533,
    "text": "有两篇文章"
  },
  {
    "start": 174.533,
    "end": 176.833,
    "text": "灵性成长周期"
  },
  {
    "start": 176.866,
    "end": 180.666,
    "text": "并非线性的过程 和灵魂能量沉"
  },
  {
    "start": 180.666,
    "end": 181.666,
    "text": "入身体的三个"
  },
  {
    "start": 181.7,
    "end": 182.866,
    "text": "阶段"
  },
  {
    "start": 182.866,
    "end": 185.5,
    "text": "感兴趣的朋友可以访问下面的链接"
  },
  {
    "start": 185.5,
    "end": 191.7,
    "text": "查看扬升过程的重要步骤"
  },
  {
    "start": 191.7,
    "end": 196.666,
    "text": "随着你整合 你每一个新层次的超灵 / 高我"
  },
  {
    "start": 196.7,
    "end": 199.2,
    "text": "你吸收了存在于那一层面"
  },
  {
    "start": 199.2,
    "end": 201.5,
    "text": "更广阔自我的智慧和启迪"
  },
  {
    "start": 201.533,
    "end": 207.333,
    "text": "你正在剥离 多层的密度 （即负能量和阻碍）"
  },
  {
    "start": 207.333,
    "end": 210.7,
    "text": "这些是你在漫长的地球转世经历中"
  },
  {
    "start": 210.733,
    "end": 213.033,
    "text": "吸收进你金色光场中的"
  },
  {
    "start": 213.033,
    "end": 214.8,
    "text": "俗话说"
  },
  {
    "start": 214.833,
    "end": 216.3,
    "text": "光明使你自由"
  },
  {
    "start": 216.3,
    "end": 217.3,
    "text": "这句话"
  },
  {
    "start": 217.333,
    "end": 217.5,
    "text": "是"
  },
  {
    "start": 217.533,
    "end": 219.633,
    "text": "真实的陈述"
  },
  {
    "start": 219.633,
    "end": 220.433,
    "text": "因为光正"
  },
  {
    "start": 220.433,
    "end": 223.066,
    "text": "在溶解 你长久以来背负的"
  },
  {
    "start": 223.1,
    "end": 225.166,
    "text": "层层消极情绪"
  },
  {
    "start": 225.166,
    "end": 227.366,
    "text": "当你转向内在"
  },
  {
    "start": 227.4,
    "end": 231.266,
    "text": "并学习专注于 你神圣之心的中心"
  },
  {
    "start": 231.3,
    "end": 233.733,
    "text": "以及当下的力量时"
  },
  {
    "start": 233.733,
    "end": 235.5,
    "text": "你开始在自己创造的"
  },
  {
    "start": 235.5,
    "end": 237.866,
    "text": "精微金色光场中运作"
  },
  {
    "start": 237.9,
    "end": 240.166,
    "text": "随着时间的推移"
  },
  {
    "start": 240.2,
    "end": 242.433,
    "text": "作为光的转化者"
  },
  {
    "start": 242.433,
    "end": 244.433,
    "text": "你们开始汲取和整合"
  },
  {
    "start": 244.466,
    "end": 248.366,
    "text": "最大数量造物主之光的 金刚粒子（  ）"
  },
  {
    "start": 248.4,
    "end": 249.4,
    "text": "然后"
  },
  {
    "start": 249.4,
    "end": 251.266,
    "text": "你们开始有意识地将剩余"
  },
  {
    "start": 251.266,
    "end": 253.966,
    "text": "的光 辐射给人类和世界"
  },
  {
    "start": 254.0,
    "end": 258.1,
    "text": "当你内在达到一定程度的和谐时"
  },
  {
    "start": 258.1,
    "end": 261.6,
    "text": "你就打开了 通往更高维度的物质身体 的"
  },
  {
    "start": 261.633,
    "end": 263.766,
    "text": "门户和通道"
  },
  {
    "start": 263.8,
    "end": 264.766,
    "text": "包括"
  },
  {
    "start": 264.766,
    "end": 266.433,
    "text": "扬升脉轮"
  },
  {
    "start": 266.433,
    "end": 268.133,
    "text": "延髓"
  },
  {
    "start": 268.166,
    "end": 270.966,
    "text": "位于头骨底部的迷走神经"
  },
  {
    "start": 270.966,
    "end": 275.366,
    "text": "以及你神圣之心和神圣心智的背部门户"
  },
  {
    "start": 275.4,
    "end": 279.1,
    "text": "这些都是扬升过程中的重要步骤"
  },
  {
    "start": 279.1,
    "end": 281.533,
    "text": "当这一过程完成时"
  },
  {
    "start": 281.533,
    "end": 283.133,
    "text": "你就可以顺利迈向"
  },
  {
    "start": 283.133,
    "end": 285.666,
    "text": "第五维度的第一个子层次（  ）"
  },
  {
    "start": 285.7,
    "end": 287.166,
    "text": "在那里"
  },
  {
    "start": 287.166,
    "end": 290.0,
    "text": "你的入门级神圣三位一体 （ ）"
  },
  {
    "start": 290.033,
    "end": 292.233,
    "text": "正等待着欢迎你的到来"
  },
  {
    "start": 292.633,
    "end": 295.766,
    "text": "暮雨·注有关什么是三位一体"
  },
  {
    "start": 295.766,
    "end": 298.733,
    "text": "协调我们的三个能量中心"
  },
  {
    "start": 298.766,
    "end": 302.5,
    "text": "头脑 心灵和腹部 的文章和视频"
  },
  {
    "start": 302.5,
    "end": 304.433,
    "text": "在灵魂能量沉入身体的"
  },
  {
    "start": 304.466,
    "end": 308.8,
    "text": "三个阶段中有详细阐释"
  },
  {
    "start": 308.8,
    "end": 313.1,
    "text": "下载 扬升的生命蓝图・"
  },
  {
    "start": 313.133,
    "end": 317.7,
    "text": "完美的人类原型  │ 亚当夏娃卡蒙体"
  },
  {
    "start": 317.7,
    "end": 320.3,
    "text": "亚当/夏娃卡蒙身体（ ）"
  },
  {
    "start": 320.333,
    "end": 322.466,
    "text": "是你最初的 个性化种子"
  },
  {
    "start": 322.466,
    "end": 324.366,
    "text": "原子神性自我( )"
  },
  {
    "start": 324.366,
    "end": 327.266,
    "text": "它处于完全意识的光体结构"
  },
  {
    "start": 327.266,
    "end": 331.2,
    "text": "由耶洛因（ ）光之主和物质形态的创造者——"
  },
  {
    "start": 331.2,
    "end": 333.2,
    "text": "作为人类原型创造"
  },
  {
    "start": 333.233,
    "end": 336.633,
    "text": "亚当·卡蒙 体现了男人和女人"
  },
  {
    "start": 336.633,
    "end": 339.733,
    "text": "原初完整的神圣和精神本质"
  },
  {
    "start": 339.766,
    "end": 342.566,
    "text": "它与你个人的超灵光体不同"
  },
  {
    "start": 342.6,
    "end": 344.166,
    "text": "你的高我们（ ）"
  },
  {
    "start": 344.166,
    "end": 346.7,
    "text": "你的精神/超灵光体（ ）"
  },
  {
    "start": 346.733,
    "end": 349.533,
    "text": "以及你的神圣三位一体都是你"
  },
  {
    "start": 349.533,
    "end": 350.966,
    "text": "神性自我（ ）——"
  },
  {
    "start": 351.0,
    "end": 353.633,
    "text": "你那最初光体的折射面向"
  },
  {
    "start": 353.633,
    "end": 357.633,
    "text": "它们本身也正在向神圣意识进化"
  },
  {
    "start": 357.633,
    "end": 362.7,
    "text": "卡蒙光体 （ ） 有能力采取任何必要的形式"
  },
  {
    "start": 362.7,
    "end": 364.3,
    "text": "来创造和体验"
  },
  {
    "start": 364.3,
    "end": 364.4,
    "text": "你"
  },
  {
    "start": 364.433,
    "end": 366.566,
    "text": "们父神/母神为这个宇宙"
  },
  {
    "start": 366.6,
    "end": 368.933,
    "text": "设定的所有形式的创造"
  },
  {
    "start": 368.933,
    "end": 371.4,
    "text": "亚当/夏娃卡蒙是一"
  },
  {
    "start": 371.4,
    "end": 374.166,
    "text": "种灵性与物质结合的创造"
  },
  {
    "start": 374.2,
    "end": 377.0,
    "text": "在神圣造物的所有周期中"
  },
  {
    "start": 377.0,
    "end": 381.0,
    "text": "化身于各种行星世界"
  },
  {
    "start": 381.033,
    "end": 384.933,
    "text": "・物质肉身（ ）在觉醒的初期"
  },
  {
    "start": 384.933,
    "end": 386.733,
    "text": "人们渴望转向内心"
  },
  {
    "start": 386.766,
    "end": 389.566,
    "text": "并倾听灵魂的内在智慧——"
  },
  {
    "start": 389.566,
    "end": 391.566,
    "text": "这种灵魂意识"
  },
  {
    "start": 391.566,
    "end": 394.833,
    "text": "包括你的身体元素和记忆种子原子"
  },
  {
    "start": 394.866,
    "end": 396.633,
    "text": "其中也包含了你最初的"
  },
  {
    "start": 396.633,
    "end": 401.1,
    "text": "亚当/夏娃卡蒙光体的完美蓝图"
  },
  {
    "start": 401.133,
    "end": 405.2,
    "text": "・情绪体（ ）首先你会意识到"
  },
  {
    "start": 405.233,
    "end": 409.233,
    "text": "你的情绪通过你的生存需求 你的欲望"
  },
  {
    "start": 409.233,
    "end": 412.6,
    "text": "和更深层的愿望或追求来控制你"
  },
  {
    "start": 412.6,
    "end": 414.833,
    "text": "但从长远来看"
  },
  {
    "start": 414.866,
    "end": 418.366,
    "text": "这并不会给你带来持久的幸福或满足感"
  },
  {
    "start": 418.366,
    "end": 419.466,
    "text": "于是"
  },
  {
    "start": 419.5,
    "end": 421.633,
    "text": "你开始转向内在"
  },
  {
    "start": 421.633,
    "end": 423.633,
    "text": "质疑你的生活选择"
  },
  {
    "start": 423.666,
    "end": 426.1,
    "text": "思考你的行为带来的结果"
  },
  {
    "start": 426.1,
    "end": 429.033,
    "text": "对于生活中的痛苦和不满"
  },
  {
    "start": 429.066,
    "end": 430.766,
    "text": "你开始寻找答案"
  },
  {
    "start": 430.766,
    "end": 435.4,
    "text": "当你逐渐留心并遵循灵魂的指引时"
  },
  {
    "start": 435.433,
    "end": 437.833,
    "text": "你的超意识心智的声音就会"
  },
  {
    "start": 437.833,
    "end": 439.733,
    "text": "变得更强"
  },
  {
    "start": 439.766,
    "end": 442.266,
    "text": "当你变得舒适自在"
  },
  {
    "start": 442.3,
    "end": 446.066,
    "text": "并开始信赖 这个更高智慧的声音时"
  },
  {
    "start": 446.066,
    "end": 449.966,
    "text": "自我欲望体 （ ）会逐渐放弃控制"
  },
  {
    "start": 450.0,
    "end": 455.2,
    "text": "而灵魂自我 （ ）将成为你生活中的指导者和引导力量"
  },
  {
    "start": 455.2,
    "end": 457.566,
    "text": "你开始将你的意愿与"
  },
  {
    "start": 457.566,
    "end": 461.166,
    "text": "你更高自我的意愿保持一致"
  },
  {
    "start": 461.2,
    "end": 464.3,
    "text": "因为你逐渐学会信任来自你神圣"
  },
  {
    "start": 464.3,
    "end": 464.6,
    "text": "心"
  },
  {
    "start": 464.6,
    "end": 466.966,
    "text": "智的灵感和直觉思维"
  },
  {
    "start": 467.0,
    "end": 468.433,
    "text": "最终"
  },
  {
    "start": 468.433,
    "end": 469.633,
    "text": "你开始从更高的"
  },
  {
    "start": 469.633,
    "end": 473.3,
    "text": "角度看待生活中所有的互动和经历"
  },
  {
    "start": 473.3,
    "end": 477.6,
    "text": "通过更准确 客观地认识人际交往"
  },
  {
    "start": 477.633,
    "end": 480.733,
    "text": "你逐渐培养起情感上的超然态度"
  },
  {
    "start": 480.766,
    "end": 484.6,
    "text": "在经历了大部分重要的情感考验后"
  },
  {
    "start": 484.6,
    "end": 486.966,
    "text": "你对人类情感的本质有了更"
  },
  {
    "start": 486.966,
    "end": 487.233,
    "text": "深"
  },
  {
    "start": 487.233,
    "end": 488.2,
    "text": "的理解"
  },
  {
    "start": 488.2,
    "end": 489.5,
    "text": "再次"
  },
  {
    "start": 489.533,
    "end": 491.833,
    "text": "你学会顺其自然"
  },
  {
    "start": 491.866,
    "end": 492.9,
    "text": "并将考验和"
  },
  {
    "start": 492.9,
    "end": 496.133,
    "text": "挑战视为成长的礼物和机会"
  },
  {
    "start": 496.166,
    "end": 500.3,
    "text": "当你努力生活并专注于当下时"
  },
  {
    "start": 500.333,
    "end": 503.0,
    "text": "你已经学会了与过去和解"
  },
  {
    "start": 503.0,
    "end": 505.2,
    "text": "并规划你的全新未来"
  },
  {
    "start": 505.2,
    "end": 507.566,
    "text": "随着时间的推移"
  },
  {
    "start": 507.6,
    "end": 509.4,
    "text": "情绪体的振动模式"
  },
  {
    "start": 509.4,
    "end": 512.066,
    "text": "被提升到一个更高的层次"
  },
  {
    "start": 512.1,
    "end": 513.7,
    "text": "也超越了物质领域"
  },
  {
    "start": 513.733,
    "end": 517.5,
    "text": "对个体的磁性吸引力"
  },
  {
    "start": 517.5,
    "end": 519.4,
    "text": "・心智体（ ）"
  },
  {
    "start": 519.433,
    "end": 522.433,
    "text": "你开始意识到自己的潜意识"
  },
  {
    "start": 522.466,
    "end": 525.666,
    "text": "和日常意识心智的局限性"
  },
  {
    "start": 525.666,
    "end": 528.433,
    "text": "发现你在集体意识的信念结构中"
  },
  {
    "start": 528.433,
    "end": 532.033,
    "text": "是多么僵化 受限和困顿"
  },
  {
    "start": 532.033,
    "end": 535.866,
    "text": "你自愿开始了一个自我分析的过程"
  },
  {
    "start": 535.9,
    "end": 539.166,
    "text": "重新评估 自己的态度 判断"
  },
  {
    "start": 539.166,
    "end": 543.1,
    "text": "和程序化观念 （即固定模式）"
  },
  {
    "start": 543.1,
    "end": 546.7,
    "text": "你渐渐感受到一种强烈的渴望——"
  },
  {
    "start": 546.7,
    "end": 548.7,
    "text": "想要扩展你的知识"
  },
  {
    "start": 548.733,
    "end": 551.133,
    "text": "超越你的物质现实"
  },
  {
    "start": 551.166,
    "end": 555.033,
    "text": "因为你试图了解 自己为什么存在于地球上"
  },
  {
    "start": 555.033,
    "end": 557.366,
    "text": "以及生命的更深层意义"
  },
  {
    "start": 557.4,
    "end": 561.533,
    "text": "你的本能心智逐渐让位于 你更高层次的"
  },
  {
    "start": 561.533,
    "end": 563.4,
    "text": "智力心智"
  },
  {
    "start": 563.4,
    "end": 565.266,
    "text": "而你也逐渐获得通往"
  },
  {
    "start": 565.3,
    "end": 568.133,
    "text": "神圣/直觉心智的通道"
  },
  {
    "start": 568.133,
    "end": 572.6,
    "text": "当你的灵魂自我 成为你命运的导演时"
  },
  {
    "start": 572.6,
    "end": 575.266,
    "text": "你的生活开始戏剧性地改善"
  },
  {
    "start": 575.266,
    "end": 576.6,
    "text": "然后"
  },
  {
    "start": 576.633,
    "end": 580.766,
    "text": "信念和信任成为一种内在的确定性"
  },
  {
    "start": 580.8,
    "end": 584.2,
    "text": "你深信一切都按照神圣的秩序发生"
  },
  {
    "start": 584.2,
    "end": 586.6,
    "text": "你也确信 自己正走在"
  },
  {
    "start": 586.6,
    "end": 588.966,
    "text": "一条螺旋上升的道路上"
  },
  {
    "start": 589.0,
    "end": 591.366,
    "text": "通往一个更加精致 和谐"
  },
  {
    "start": 591.366,
    "end": 593.4,
    "text": "和充满爱的现实"
  },
  {
    "start": 593.433,
    "end": 596.466,
    "text": "你所要做的就是安住于当下"
  },
  {
    "start": 596.5,
    "end": 599.333,
    "text": "脚踏实地地迈出每一步"
  },
  {
    "start": 599.366,
    "end": 604.166,
    "text": "因为道路 会在你面前自然展开"
  },
  {
    "start": 604.166,
    "end": 607.2,
    "text": "・自我掌握的大师"
  },
  {
    "start": 607.2,
    "end": 610.6,
    "text": "自我掌握的大师 是自主的（ ）"
  },
  {
    "start": 610.633,
    "end": 612.5,
    "text": "能自我调整的（"
  },
  {
    "start": 612.5,
    "end": 614.5,
    "text": "具有自我意识（ ） 和灵魂意识（"
  },
  {
    "start": 614.533,
    "end": 614.966,
    "text": "）的"
  },
  {
    "start": 615.0,
    "end": 617.066,
    "text": "自我掌握的大师"
  },
  {
    "start": 617.066,
    "end": 620.033,
    "text": "对周围环境做出积极反应"
  },
  {
    "start": 620.066,
    "end": 624.233,
    "text": "同时从更高的角度观察世俗的生活经历"
  },
  {
    "start": 624.266,
    "end": 626.966,
    "text": "虽身处于世界之中"
  },
  {
    "start": 626.966,
    "end": 628.9,
    "text": "但不属于这个世界"
  },
  {
    "start": 628.933,
    "end": 630.933,
    "text": "对于他们来说"
  },
  {
    "start": 630.966,
    "end": 634.6,
    "text": "唯一最深刻的事件是第一次体验到"
  },
  {
    "start": 634.6,
    "end": 638.033,
    "text": "来自神圣心智 和灵魂中散发出的"
  },
  {
    "start": 638.033,
    "end": 640.533,
    "text": "充满爱的能量和喜悦"
  },
  {
    "start": 640.566,
    "end": 643.4,
    "text": "灵魂的本质 就是爱"
  },
  {
    "start": 643.4,
    "end": 648.4,
    "text": "当你存在于第三/第四维度环境中的限制时"
  },
  {
    "start": 648.433,
    "end": 650.8,
    "text": "你正是通过你的灵魂自我"
  },
  {
    "start": 650.8,
    "end": 653.7,
    "text": "与母神/父神的爱的本质相连"
  },
  {
    "start": 653.733,
    "end": 656.4,
    "text": "一个自我掌握的大师"
  },
  {
    "start": 656.4,
    "end": 660.0,
    "text": "会始终坚定地站在神圣心灵的中心"
  },
  {
    "start": 660.033,
    "end": 662.533,
    "text": "在混乱和变化之中"
  },
  {
    "start": 662.533,
    "end": 665.633,
    "text": "牢牢抓住神圣心智的智慧"
  },
  {
    "start": 665.633,
    "end": 669.533,
    "text": "同时 从我们的父神/母神那里汲取力量"
  },
  {
    "start": 669.533,
    "end": 670.866,
    "text": "以更好地应对"
  },
  {
    "start": 670.9,
    "end": 674.133,
    "text": "随着个体的内在成长和觉醒"
  },
  {
    "start": 674.166,
    "end": 676.7,
    "text": "逐渐消散的低维度幻象"
  },
  {
    "start": 677.1,
    "end": 679.266,
    "text": "暮雨·注如何最好地应对"
  },
  {
    "start": 679.266,
    "end": 682.9,
    "text": "新闻 战争 死亡和破坏"
  },
  {
    "start": 682.9,
    "end": 685.8,
    "text": "│ 受害者与加害者 │ 反射法则 │"
  },
  {
    "start": 685.8,
    "end": 687.666,
    "text": "摆脱无力感"
  },
  {
    "start": 687.666,
    "end": 689.8,
    "text": "这则来自昴宿星的教导"
  },
  {
    "start": 689.8,
    "end": 691.933,
    "text": "提供了一个新的视角"
  },
  {
    "start": 691.966,
    "end": 694.466,
    "text": "帮助你看待低纬度的幻象"
  },
  {
    "start": 694.466,
    "end": 698.133,
    "text": "・大师（ ）（暮雨注"
  },
  {
    "start": 698.166,
    "end": 699.466,
    "text": "ADEPT 这个"
  },
  {
    "start": 699.466,
    "end": 700.7,
    "text": "单词"
  },
  {
    "start": 700.733,
    "end": 703.2,
    "text": "在这里指的是在灵性道路上"
  },
  {
    "start": 703.2,
    "end": 706.266,
    "text": "有高度修炼和成就的人 ）"
  },
  {
    "start": 706.266,
    "end": 709.7,
    "text": "他们是坚定地走在光明之路上的人"
  },
  {
    "start": 709.7,
    "end": 712.666,
    "text": "他意图的焦点源自于神圣心智"
  },
  {
    "start": 712.7,
    "end": 714.266,
    "text": "和神圣心灵"
  },
  {
    "start": 714.266,
    "end": 717.666,
    "text": "他在第三/第四维度的意识层面上"
  },
  {
    "start": 717.7,
    "end": 720.166,
    "text": "已经平衡 协调"
  },
  {
    "start": 720.166,
    "end": 723.233,
    "text": "并整合了灵魂自我的所有面向"
  },
  {
    "start": 723.233,
    "end": 725.233,
    "text": "他已经能够直接连接"
  },
  {
    "start": 725.266,
    "end": 727.766,
    "text": "他的神圣三位一体（ ）——"
  },
  {
    "start": 727.766,
    "end": 729.966,
    "text": "该三位一体 至少存在于"
  },
  {
    "start": 730.0,
    "end": 732.233,
    "text": "第五维度的入门层次"
  },
  {
    "start": 732.266,
    "end": 734.633,
    "text": "为了达到这个阶段"
  },
  {
    "start": 734.633,
    "end": 739.1,
    "text": "求道者 必须完成启蒙 /开悟的前四个阶段"
  },
  {
    "start": 739.1,
    "end": 742.6,
    "text": "并在前四个维度上 实现了自我掌握"
  },
  {
    "start": 742.633,
    "end": 746.633,
    "text": "这是目前向人类开放的扬升水平"
  },
  {
    "start": 746.633,
    "end": 748.366,
    "text": "许多勇敢的灵魂"
  },
  {
    "start": 748.4,
    "end": 753.066,
    "text": "将在物质身体中实现这一目标"
  },
  {
    "start": 753.066,
    "end": 755.233,
    "text": "・门徒（ ）"
  },
  {
    "start": 755.266,
    "end": 757.4,
    "text": "门徒是一个听从灵魂"
  },
  {
    "start": 757.4,
    "end": 759.166,
    "text": "自我低语的人"
  },
  {
    "start": 759.2,
    "end": 761.166,
    "text": "并积极寻求启蒙 智"
  },
  {
    "start": 761.166,
    "end": 763.166,
    "text": "慧 自我实现"
  },
  {
    "start": 763.2,
    "end": 765.5,
    "text": "并最终实现自我掌握的人"
  },
  {
    "start": 765.5,
    "end": 769.333,
    "text": "・神圣心智 / 高等心智（ ）"
  },
  {
    "start": 769.333,
    "end": 772.1,
    "text": "人类的神圣心智是一个"
  },
  {
    "start": 772.133,
    "end": 774.633,
    "text": "储存在 大脑后部上方的"
  },
  {
    "start": 774.633,
    "end": 776.833,
    "text": "乙太水晶种子原子（ ）"
  },
  {
    "start": 776.866,
    "end": 778.7,
    "text": "这里有一层光膜"
  },
  {
    "start": 778.7,
    "end": 783.6,
    "text": "保护着进入神圣心智 门户的通道及其内容"
  },
  {
    "start": 783.633,
    "end": 783.833,
    "text": "直"
  },
  {
    "start": 783.833,
    "end": 786.766,
    "text": "到你将自己的频率 提升到更高的"
  },
  {
    "start": 786.8,
    "end": 789.433,
    "text": "第四维度的适当水平"
  },
  {
    "start": 789.433,
    "end": 791.166,
    "text": "才被允许访问"
  },
  {
    "start": 791.166,
    "end": 795.7,
    "text": "你的神圣心智 包含你古老历史的浓缩版本"
  },
  {
    "start": 795.7,
    "end": 798.733,
    "text": "以及你在这个宇宙的众多前世中"
  },
  {
    "start": 798.766,
    "end": 802.033,
    "text": "所整合的部分智慧和重要信息"
  },
  {
    "start": 802.066,
    "end": 803.566,
    "text": "在地球上"
  },
  {
    "start": 803.566,
    "end": 806.1,
    "text": "成为自我掌握的大师"
  },
  {
    "start": 806.1,
    "end": 806.9,
    "text": "包含获取"
  },
  {
    "start": 806.9,
    "end": 809.833,
    "text": "和整合 储存在神圣心智中的"
  },
  {
    "start": 809.866,
    "end": 814.1,
    "text": "属性 品质 才能 的必要部分"
  },
  {
    "start": 814.5,
    "end": 816.6,
    "text": "暮雨·注什么是光膜"
  },
  {
    "start": 816.6,
    "end": 823.333,
    "text": "在大天使MICHAEL的另一篇通灵传讯《打开你神圣之心的门户》中提到"
  },
  {
    "start": 823.366,
    "end": 825.633,
    "text": "在灵性下降过程中"
  },
  {
    "start": 825.633,
    "end": 827.766,
    "text": "为了限制和保护"
  },
  {
    "start": 827.8,
    "end": 832.2,
    "text": "人类DNA中的多条DNA链 被一层光膜包裹住"
  },
  {
    "start": 832.2,
    "end": 836.2,
    "text": "它就像一种限制 屏障或封印"
  },
  {
    "start": 836.233,
    "end": 840.566,
    "text": "使得这些DNA链 不再完全活跃或不可访问"
  },
  {
    "start": 840.6,
    "end": 844.966,
    "text": "这意味着在灵魂进入物质世界时"
  },
  {
    "start": 844.966,
    "end": 847.833,
    "text": "你的高等智慧 记忆 或能力"
  },
  {
    "start": 847.866,
    "end": 849.1,
    "text": "被暂时封闭"
  },
  {
    "start": 849.1,
    "end": 853.633,
    "text": "这种限制 是为了帮助灵魂 能够集中精力"
  },
  {
    "start": 853.633,
    "end": 855.3,
    "text": "在当前的物质世界中"
  },
  {
    "start": 855.3,
    "end": 857.833,
    "text": "体验 学习和成长"
  },
  {
    "start": 857.866,
    "end": 861.366,
    "text": "而不会被过多的灵性记忆和能力所干扰"
  },
  {
    "start": 861.366,
    "end": 864.233,
    "text": "这种限制性的光之膜"
  },
  {
    "start": 864.266,
    "end": 868.033,
    "text": "只有在灵魂达到一定的平衡和提升后"
  },
  {
    "start": 868.033,
    "end": 868.433,
    "text": "才会"
  },
  {
    "start": 868.433,
    "end": 868.633,
    "text": "逐"
  },
  {
    "start": 868.666,
    "end": 869.9,
    "text": "渐溶解"
  },
  {
    "start": 869.9,
    "end": 872.066,
    "text": "使这些隐藏的能力和记忆"
  },
  {
    "start": 872.1,
    "end": 874.933,
    "text": "重新被激活和访问"
  },
  {
    "start": 874.933,
    "end": 879.766,
    "text": "垃圾DNA在科学研究中"
  },
  {
    "start": 879.766,
    "end": 881.833,
    "text": "确实有类似的发现"
  },
  {
    "start": 881.866,
    "end": 884.133,
    "text": "人类基因组中"
  },
  {
    "start": 884.133,
    "end": 885.566,
    "text": "大约只有1-2"
  },
  {
    "start": 885.566,
    "end": 885.8,
    "text": "%"
  },
  {
    "start": 885.8,
    "end": 889.666,
    "text": "的DNA序列 被认为是编码蛋白质的"
  },
  {
    "start": 889.7,
    "end": 893.066,
    "text": "即所谓的活跃或功能性DNA"
  },
  {
    "start": 893.066,
    "end": 894.7,
    "text": "其余98"
  },
  {
    "start": 894.7,
    "end": 899.5,
    "text": "至99%的DNA序列曾经被称为垃圾DNA"
  },
  {
    "start": 899.5,
    "end": 902.033,
    "text": "因为科学家们 一开始并不知道"
  },
  {
    "start": 902.066,
    "end": 903.4,
    "text": "这些部分的功能"
  },
  {
    "start": 903.4,
    "end": 904.6,
    "text": "然而"
  },
  {
    "start": 904.633,
    "end": 906.833,
    "text": "近年来的研究表明"
  },
  {
    "start": 906.833,
    "end": 910.033,
    "text": "垃圾DNA这个术语其实是误导性的"
  },
  {
    "start": 910.033,
    "end": 911.6,
    "text": "实际上"
  },
  {
    "start": 911.633,
    "end": 913.966,
    "text": "许多所谓的垃圾DNA"
  },
  {
    "start": 913.966,
    "end": 916.366,
    "text": "在细胞功能和遗传调控中"
  },
  {
    "start": 916.4,
    "end": 918.366,
    "text": "都扮演着重要角色"
  },
  {
    "start": 918.4,
    "end": 919.833,
    "text": "例如"
  },
  {
    "start": 919.833,
    "end": 922.1,
    "text": "研究发现的调控功能"
  },
  {
    "start": 922.133,
    "end": 924.233,
    "text": "很多非编码DNA序列"
  },
  {
    "start": 924.233,
    "end": 926.833,
    "text": "实际起着非常重要的作用"
  },
  {
    "start": 926.833,
    "end": 928.566,
    "text": "它们负责控制哪些基因"
  },
  {
    "start": 928.566,
    "end": 933.266,
    "text": "在什么时间 和什么部位被激活"
  },
  {
    "start": 933.3,
    "end": 938.366,
    "text": "当你连接到 你更广阔的超灵的众多面向时"
  },
  {
    "start": 938.366,
    "end": 942.1,
    "text": "你将会触及 高我的心智或智慧层面"
  },
  {
    "start": 942.133,
    "end": 944.4,
    "text": "这种智慧 最终会将"
  },
  {
    "start": 944.4,
    "end": 944.833,
    "text": "你"
  },
  {
    "start": 944.833,
    "end": 946.733,
    "text": "与你的我是临在 （"
  },
  {
    "start": 946.766,
    "end": 951.0,
    "text": "）/上帝之光（ ） /上帝种子原子（ ）相连接"
  },
  {
    "start": 951.0,
    "end": 954.633,
    "text": "这将使你能够接触到 父母神的智慧"
  },
  {
    "start": 954.666,
    "end": 957.633,
    "text": "或者 这个子宇宙（ ）的集体智慧"
  },
  {
    "start": 957.633,
    "end": 961.066,
    "text": "神圣心智（ ） 是你神圣的上帝种子"
  },
  {
    "start": 961.066,
    "end": 962.133,
    "text": "原子"
  },
  {
    "start": 962.133,
    "end": 964.9,
    "text": "在更高层次上的总体体现——"
  },
  {
    "start": 964.9,
    "end": 966.133,
    "text": "归根结底"
  },
  {
    "start": 966.166,
    "end": 968.8,
    "text": "是我们父神/母神的神圣心智"
  },
  {
    "start": 968.8,
    "end": 970.966,
    "text": "为了更好地理解"
  },
  {
    "start": 970.966,
    "end": 972.633,
    "text": "你可以说高等心智"
  },
  {
    "start": 972.666,
    "end": 975.533,
    "text": "是你意识的一种精炼频率"
  },
  {
    "start": 975.533,
    "end": 979.466,
    "text": "每当你下载 超灵 /高我的一个面向时"
  },
  {
    "start": 979.5,
    "end": 982.233,
    "text": "你就获得了 更高的意识水平"
  },
  {
    "start": 982.233,
    "end": 985.166,
    "text": "当你行走在扬升之路上"
  },
  {
    "start": 985.166,
    "end": 989.466,
    "text": "进入一个可被接受的 光明与阴影的光谱时"
  },
  {
    "start": 989.466,
    "end": 990.966,
    "text": "你的目标是"
  },
  {
    "start": 991.0,
    "end": 992.533,
    "text": "培养在神圣心智"
  },
  {
    "start": 992.533,
    "end": 995.833,
    "text": "和神圣心灵中 居于中心的能力"
  },
  {
    "start": 995.833,
    "end": 999.933,
    "text": "你学会有意识地 对周围发生的事情 保持更"
  },
  {
    "start": 999.933,
    "end": 1000.133,
    "text": "高"
  },
  {
    "start": 1000.133,
    "end": 1001.3,
    "text": "的视角"
  },
  {
    "start": 1001.333,
    "end": 1001.833,
    "text": "同时"
  },
  {
    "start": 1001.866,
    "end": 1005.766,
    "text": "对每个人 表达同情 和无条件的爱——"
  },
  {
    "start": 1005.766,
    "end": 1008.6,
    "text": "这就是一个自我掌握大师的目标"
  },
  {
    "start": 1008.6,
    "end": 1012.733,
    "text": "当你逐渐调频到更高频率的光之中"
  },
  {
    "start": 1012.766,
    "end": 1016.466,
    "text": "你会逐渐适应神圣火焰呼吸的流动"
  },
  {
    "start": 1016.466,
    "end": 1020.0,
    "text": "它在古代教义中被称为生命之河"
  },
  {
    "start": 1020.0,
    "end": 1021.333,
    "text": "爱之河"
  },
  {
    "start": 1021.366,
    "end": 1023.566,
    "text": "光之河 或安塔卡拉纳（ ）"
  },
  {
    "start": 1023.6,
    "end": 1027.3,
    "text": "在这条生生不息的生命之河中"
  },
  {
    "start": 1027.3,
    "end": 1032.933,
    "text": "被编码 及隐藏着一股强大的 光芒四射的知识之流——"
  },
  {
    "start": 1032.933,
    "end": 1035.533,
    "text": "这是一种创造性天赋的密码"
  },
  {
    "start": 1035.566,
    "end": 1036.8,
    "text": "然而"
  },
  {
    "start": 1036.8,
    "end": 1040.9,
    "text": "你必须利用神圣心智 和灵魂自我的智慧"
  },
  {
    "start": 1040.9,
    "end": 1044.066,
    "text": "才能够获取这种内在的力量"
  },
  {
    "start": 1044.466,
    "end": 1046.9,
    "text": "暮雨·注 关于这点"
  },
  {
    "start": 1046.9,
    "end": 1052.5,
    "text": "相关的文章和视频《抹大拉手稿》第13集有详细讨论"
  },
  {
    "start": 1052.533,
    "end": 1054.9,
    "text": "灵性发展的自然结果  /"
  },
  {
    "start": 1054.9,
    "end": 1056.966,
    "text": "人类进化的下个阶段是"
  },
  {
    "start": 1057.0,
    "end": 1057.433,
    "text": "悉地（ ）"
  },
  {
    "start": 1057.433,
    "end": 1060.6,
    "text": "和意识力量"
  },
  {
    "start": 1060.633,
    "end": 1065.233,
    "text": "星际种子  / 光之工作者的使命"
  },
  {
    "start": 1065.233,
    "end": 1068.966,
    "text": "你们被称为星际种子（ ）是有原因的"
  },
  {
    "start": 1068.966,
    "end": 1072.0,
    "text": "因为当你们回归自我掌握时"
  },
  {
    "start": 1072.0,
    "end": 1077.266,
    "text": "你们将启动 创造性水晶生命代码 种子原子（   ）的过程——"
  },
  {
    "start": 1077.3,
    "end": 1080.4,
    "text": "这是一个全新 先进的进化过程"
  },
  {
    "start": 1080.4,
    "end": 1086.333,
    "text": "最终将被即将到来的 黄金星系（ ）中的生命形式 所使用"
  },
  {
    "start": 1086.333,
    "end": 1090.7,
    "text": "请你们仔细研究 我们所揭示的内容"
  },
  {
    "start": 1090.733,
    "end": 1093.133,
    "text": "并努力 将我们所创造的宇宙"
  },
  {
    "start": 1093.133,
    "end": 1095.333,
    "text": "概要图 牢记于心"
  },
  {
    "start": 1095.333,
    "end": 1097.8,
    "text": "以便你们能够理解"
  },
  {
    "start": 1097.8,
    "end": 1099.7,
    "text": "正在你们眼前展开的"
  },
  {
    "start": 1099.7,
    "end": 1102.366,
    "text": "奇妙宇宙事件的下一阶段"
  },
  {
    "start": 1102.4,
    "end": 1104.5,
    "text": "作为光之使者"
  },
  {
    "start": 1104.533,
    "end": 1108.133,
    "text": "你们承诺 要成为我们在地球上的代表"
  },
  {
    "start": 1108.166,
    "end": 1110.1,
    "text": "在你们内在"
  },
  {
    "start": 1110.1,
    "end": 1113.5,
    "text": "你们拥有 完成第四维度领域剩余部分的"
  },
  {
    "start": 1113.5,
    "end": 1116.7,
    "text": "地球之旅 所需的一切"
  },
  {
    "start": 1116.7,
    "end": 1118.833,
    "text": "当怀疑出现时"
  },
  {
    "start": 1118.866,
    "end": 1120.266,
    "text": "请记住"
  },
  {
    "start": 1120.266,
    "end": 1122.266,
    "text": "你们过去的所有经历"
  },
  {
    "start": 1122.3,
    "end": 1122.766,
    "text": "无论"
  },
  {
    "start": 1122.766,
    "end": 1125.333,
    "text": "是成功或看似失败"
  },
  {
    "start": 1125.333,
    "end": 1128.433,
    "text": "都提供了丰富的经验供你们借鉴"
  },
  {
    "start": 1128.466,
    "end": 1130.1,
    "text": "亲爱的"
  },
  {
    "start": 1130.1,
    "end": 1133.4,
    "text": "请闪耀你们的光让所有人看见"
  },
  {
    "start": 1133.433,
    "end": 1135.433,
    "text": "请呼唤我们"
  },
  {
    "start": 1135.466,
    "end": 1137.7,
    "text": "我们将尽一切可能的方式"
  },
  {
    "start": 1137.7,
    "end": 1139.6,
    "text": "为您提供帮助"
  },
  {
    "start": 1139.6,
    "end": 1143.233,
    "text": "要知道 我永远与你们同在"
  },
  {
    "start": 1143.233,
    "end": 1145.866,
    "text": "并深深地爱着你们"
  },
  {
    "start": 1145.9,
    "end": 1148.566,
    "text": "我是大天使 MICHAEL"
  },
  {
    "start": 1148.566,
    "end": 1154.466,
    "text": "名词解释 / 暮雨注延髓是什么"
  },
  {
    "start": 1154.5,
    "end": 1157.3,
    "text": "延髓（ ）是脑干的一部分"
  },
  {
    "start": 1157.3,
    "end": 1160.233,
    "text": "它将大脑 与脊髓连接起来"
  },
  {
    "start": 1160.266,
    "end": 1164.866,
    "text": "这使得延髓成为神经系统的主要连接点"
  },
  {
    "start": 1164.9,
    "end": 1167.666,
    "text": "延髓是将心血管系统"
  },
  {
    "start": 1167.666,
    "end": 1170.366,
    "text": "和呼吸系统连接在一起"
  },
  {
    "start": 1170.366,
    "end": 1172.933,
    "text": "形成一个统一系统的地方"
  },
  {
    "start": 1172.933,
    "end": 1174.933,
    "text": "该系统控制着你的心率"
  },
  {
    "start": 1174.966,
    "end": 1177.3,
    "text": "呼吸 血压等功能"
  },
  {
    "start": 1177.3,
    "end": 1184.266,
    "text": "在《玫瑰十字会的秘密》（ ）这本书 关于神经系统的章节中记载"
  },
  {
    "start": 1184.3,
    "end": 1185.866,
    "text": "超意识心智 是"
  },
  {
    "start": 1185.9,
    "end": 1189.8,
    "text": "客观思维 和主观思维共同作用的结果"
  },
  {
    "start": 1189.8,
    "end": 1192.766,
    "text": "这三个心智 分别位于三个区域"
  },
  {
    "start": 1192.8,
    "end": 1194.033,
    "text": "中"
  },
  {
    "start": 1194.033,
    "end": 1196.333,
    "text": "大脑 小脑和延髓"
  },
  {
    "start": 1196.333,
    "end": 1199.4,
    "text": "大脑负责关注当前事物"
  },
  {
    "start": 1199.4,
    "end": 1201.7,
    "text": "小脑关注过去"
  },
  {
    "start": 1201.7,
    "end": 1205.633,
    "text": "而延髓则关注过去 现在和未来"
  },
  {
    "start": 1205.666,
    "end": 1209.866,
    "text": "超意识心智被视为意识的极致表达"
  },
  {
    "start": 1209.866,
    "end": 1213.833,
    "text": "客观和主观的头脑分别支配着身体和"
  },
  {
    "start": 1213.833,
    "end": 1214.066,
    "text": "灵"
  },
  {
    "start": 1214.1,
    "end": 1215.333,
    "text": "魂"
  },
  {
    "start": 1215.333,
    "end": 1219.1,
    "text": "而超意识的心智是灵性表达的途径"
  },
  {
    "start": 1219.1,
    "end": 1224.733,
    "text": "这段文字似乎从另一个角度解释了三位一体"
  },
  {
    "start": 1224.766,
    "end": 1225.866,
    "text": "此外"
  },
  {
    "start": 1225.9,
    "end": 1228.466,
    "text": "暮雨注意到在冥想时"
  },
  {
    "start": 1228.466,
    "end": 1232.133,
    "text": "尤其在进入更深层次的意识状态时"
  },
  {
    "start": 1232.133,
    "end": 1235.533,
    "text": "会感觉到微麻的电流 流经延髓"
  },
  {
    "start": 1235.566,
    "end": 1238.766,
    "text": "向上扩展 填充了整个头颅"
  },
  {
    "start": 1238.766,
    "end": 1241.666,
    "text": "向下顺着脊髓 布满整个背部"
  },
  {
    "start": 1241.7,
    "end": 1243.966,
    "text": "并延伸至四肢"
  },
  {
    "start": 1243.966,
    "end": 1246.266,
    "text": "《玫瑰十字会的秘密》"
  },
  {
    "start": 1246.3,
    "end": 1249.9,
    "text": "这本书大约写于16-17世纪"
  },
  {
    "start": 1249.9,
    "end": 1252.4,
    "text": "书中称玫瑰十字会起源于"
  },
  {
    "start": 1252.4,
    "end": 1254.966,
    "text": "亚特兰蒂斯人的古老教义"
  },
  {
    "start": 1255.0,
    "end": 1256.1,
    "text": "亚特兰蒂"
  },
  {
    "start": 1256.1,
    "end": 1259.1,
    "text": "斯人将自己的知识传授给了"
  },
  {
    "start": 1259.133,
    "end": 1260.866,
    "text": "早期的埃及人"
  },
  {
    "start": 1260.9,
    "end": 1262.566,
    "text": "通过传统"
  },
  {
    "start": 1262.566,
    "end": 1265.466,
    "text": "在某些情况下通过文字"
  },
  {
    "start": 1265.5,
    "end": 1268.133,
    "text": "这些知识一直流传到现在"
  },
  {
    "start": 1268.133,
    "end": 1271.133,
    "text": "迷走神经是什么"
  },
  {
    "start": 1271.133,
    "end": 1272.833,
    "text": "迷走神经（ ）"
  },
  {
    "start": 1272.866,
    "end": 1275.166,
    "text": "又称第十 脑神经 ( )"
  },
  {
    "start": 1275.166,
    "end": 1280.0,
    "text": "它是脑神经中最长 最大 最复杂的神经之一"
  },
  {
    "start": 1280.033,
    "end": 1281.466,
    "text": "起源于延髓"
  },
  {
    "start": 1281.5,
    "end": 1285.233,
    "text": "通过颅底的 颈静脉孔 离开颅骨"
  },
  {
    "start": 1285.233,
    "end": 1288.166,
    "text": "然后一直延伸到腹部的器官"
  },
  {
    "start": 1288.166,
    "end": 1292.266,
    "text": "包括心脏 肺部 消化系统等"
  },
  {
    "start": 1292.3,
    "end": 1294.6,
    "text": "其分布区域涵盖了全身"
  },
  {
    "start": 1294.633,
    "end": 1300.033,
    "text": "迷走神经在调节心脏 消化和呼吸等功能中起"
  },
  {
    "start": 1300.033,
    "end": 1301.166,
    "text": "着重要作用"
  },
  {
    "start": 1301.2,
    "end": 1305.0,
    "text": "医学界认为许多病症 如颈部疼痛"
  },
  {
    "start": 1305.0,
    "end": 1306.7,
    "text": "抑郁症 焦虑症"
  },
  {
    "start": 1306.7,
    "end": 1310.333,
    "text": "头痛 癫痫 炎症 关节炎"
  },
  {
    "start": 1310.366,
    "end": 1313.8,
    "text": "甚至心脏问题（如心动过速）等"
  },
  {
    "start": 1313.833,
    "end": 1318.133,
    "text": "可能与迷走神经的活动 或功能紊乱有关"
  },
  {
    "start": 1320.166,
    "end": 1321.066,
    "text": "扬升"
  },
  {
    "start": 1321.066,
    "end": 1321.333,
    "text": "症"
  },
  {
    "start": 1321.333,
    "end": 1323.966,
    "text": "状  和 神圣之心的"
  },
  {
    "start": 1324.0,
    "end": 1326.533,
    "text": "背部门户以"
  },
  {
    "start": 1326.533,
    "end": 1329.833,
    "text": "下是暮雨个人的扬升症状分享"
  },
  {
    "start": 1329.866,
    "end": 1331.166,
    "text": "仅供参考"
  },
  {
    "start": 1331.2,
    "end": 1334.1,
    "text": "我的扬升症状大多数情况"
  },
  {
    "start": 1334.133,
    "end": 1336.633,
    "text": "与太阳能量活动同步"
  },
  {
    "start": 1336.633,
    "end": 1338.933,
    "text": "我在之前写过两篇文章"
  },
  {
    "start": 1338.966,
    "end": 1342.733,
    "text": "介绍了宇宙能量活动对人类的影响"
  },
  {
    "start": 1342.733,
    "end": 1345.966,
    "text": "感兴趣的朋友可以了解一下"
  },
  {
    "start": 1346.0,
    "end": 1348.866,
    "text": "扬升症状的种类很多"
  },
  {
    "start": 1348.866,
    "end": 1350.733,
    "text": "通常会交替发生"
  },
  {
    "start": 1350.733,
    "end": 1353.366,
    "text": "这里我想重点谈谈"
  },
  {
    "start": 1353.4,
    "end": 1354.233,
    "text": "大天使MICH"
  },
  {
    "start": 1354.266,
    "end": 1356.433,
    "text": "AEL提到的背部门户——"
  },
  {
    "start": 1356.433,
    "end": 1359.533,
    "text": "这也是我主要经历的扬升症状"
  },
  {
    "start": 1359.566,
    "end": 1365.366,
    "text": "集中表现为 背部心轮 感受到强烈的能量压力"
  },
  {
    "start": 1365.366,
    "end": 1367.833,
    "text": "能量似乎来自两个方向"
  },
  {
    "start": 1367.866,
    "end": 1372.0,
    "text": "一个是从头顶 沿着延髓和脊柱往下"
  },
  {
    "start": 1372.0,
    "end": 1375.466,
    "text": "大部分能量汇聚于后背心轮处"
  },
  {
    "start": 1375.466,
    "end": 1379.4,
    "text": "另一束能量柱 则来自于后背"
  },
  {
    "start": 1379.433,
    "end": 1382.6,
    "text": "穿过背部心轮 直达前胸心轮"
  },
  {
    "start": 1382.6,
    "end": 1385.533,
    "text": "整个过程可能持续数天"
  },
  {
    "start": 1385.566,
    "end": 1388.333,
    "text": "突然出现 又突然消失"
  },
  {
    "start": 1388.333,
    "end": 1390.3,
    "text": "情况严重时"
  },
  {
    "start": 1390.333,
    "end": 1394.066,
    "text": "会感觉自己仿佛站在一个能量瀑布下"
  },
  {
    "start": 1394.1,
    "end": 1396.633,
    "text": "承受着很强的能量冲击"
  },
  {
    "start": 1396.633,
    "end": 1398.366,
    "text": "身体极度疲倦"
  },
  {
    "start": 1398.366,
    "end": 1400.133,
    "text": "在这种时候"
  },
  {
    "start": 1400.166,
    "end": 1400.966,
    "text": "最好的做"
  },
  {
    "start": 1400.966,
    "end": 1401.233,
    "text": "法"
  },
  {
    "start": 1401.233,
    "end": 1403.233,
    "text": "就是多喝纯净水"
  },
  {
    "start": 1403.266,
    "end": 1403.433,
    "text": "多"
  },
  {
    "start": 1403.433,
    "end": 1404.333,
    "text": "睡觉"
  },
  {
    "start": 1404.333,
    "end": 1406.8,
    "text": "多与大自然接触"
  },
  {
    "start": 1406.8,
    "end": 1409.033,
    "text": "你们是否也有类似的扬升"
  },
  {
    "start": 1409.066,
    "end": 1409.533,
    "text": "症状"
  }
]