[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "光之信息"
  },
  {
    "start": 6.04,
    "end": 9.92,
    "text": "来自大天使MICHAEL的智慧教导"
  },
  {
    "start": 9.92,
    "end": 12.52,
    "text": "神圣抄写员Ronna Vezane"
  },
  {
    "start": 12.52,
    "end": 15.07,
    "text": "翻译 / 解读 暮雨"
  },
  {
    "start": 15.07,
    "end": 16.07,
    "text": "以下这张图是大天使"
  },
  {
    "start": 18.31,
    "end": 24.27,
    "text": "Michael 下载到作者 Ronna Vezane意识中的一张全息图"
  },
  {
    "start": 24.27,
    "end": 26.9,
    "text": "解析了这个子宇宙的创造过程"
  },
  {
    "start": 26.9,
    "end": 29.34,
    "text": "图中清晰地展示了"
  },
  {
    "start": 29.34,
    "end": 31.27,
    "text": "在意识层面的物质领域"
  },
  {
    "start": 31.27,
    "end": 33.04,
    "text": "共同创造的过程"
  },
  {
    "start": 33.04,
    "end": 36.61,
    "text": "这种共同创造涉及我们的父神 母"
  },
  {
    "start": 36.61,
    "end": 37.48,
    "text": "神"
  },
  {
    "start": 37.48,
    "end": 41.15,
    "text": "光之主耶洛因（即有形事物的建造者）"
  },
  {
    "start": 41.15,
    "end": 43.64,
    "text": "大天使王国 龙族 精"
  },
  {
    "start": 43.64,
    "end": 45.61,
    "text": "灵王国 元素王国和"
  },
  {
    "start": 45.61,
    "end": 47.1,
    "text": "人类"
  },
  {
    "start": 47.1,
    "end": 49.55,
    "text": "在我们的银河系中"
  },
  {
    "start": 49.55,
    "end": 53.18,
    "text": "每个时代都创建了一个新的神圣蓝图"
  },
  {
    "start": 53.18,
    "end": 55.3,
    "text": "每一个新的创造"
  },
  {
    "start": 55.3,
    "end": 57.95,
    "text": "无论是星系 子宇宙"
  },
  {
    "start": 57.95,
    "end": 60.82,
    "text": "银河系 太阳系 行星"
  },
  {
    "start": 60.82,
    "end": 64.16,
    "text": "或是一个新的有灵魂的人类种族"
  },
  {
    "start": 64.16,
    "end": 66.45,
    "text": "都遵循这一共同创造机制"
  },
  {
    "start": 66.45,
    "end": 68.81,
    "text": "和各自的神圣蓝图"
  },
  {
    "start": 68.81,
    "end": 71.14,
    "text": "这说明宇宙中一切事物"
  },
  {
    "start": 71.14,
    "end": 74.77,
    "text": "都是有序 有计划地创造出来的"
  },
  {
    "start": 74.77,
    "end": 77.17,
    "text": "而非随机或混乱地形成"
  },
  {
    "start": 77.17,
    "end": 80.1,
    "text": "下面我们将阐释整个过程"
  },
  {
    "start": 80.1,
    "end": 82.13,
    "text": "和定义相关概念"
  },
  {
    "start": 82.13,
    "end": 84.42,
    "text": "通过理解创造原理"
  },
  {
    "start": 84.42,
    "end": 87.57,
    "text": "和人类在神圣计划中的位置"
  },
  {
    "start": 87.57,
    "end": 90.09,
    "text": "将有助于提升冥想效果"
  },
  {
    "start": 90.09,
    "end": 95.07,
    "text": "希望你们能将其吸收并整合到意识的各个层次中"
  },
  {
    "start": 95.07,
    "end": 96.07,
    "text": "37 00:01:36,070 --> 00:01:37,590 新神圣蓝图"
  },
  {
    "start": 97.59,
    "end": 97.95,
    "text": "种子"
  },
  {
    "start": 97.95,
    "end": 100.68,
    "text": "原子的承载者与传递者"
  },
  {
    "start": 100.68,
    "end": 102.59,
    "text": "光之主耶洛因"
  },
  {
    "start": 102.59,
    "end": 105.66,
    "text": "12位大天使和龙族"
  },
  {
    "start": 105.66,
    "end": 109.11,
    "text": "・神圣蓝图种子原子"
  },
  {
    "start": 109.11,
    "end": 112.39,
    "text": "我们这个子宇宙的神圣蓝图"
  },
  {
    "start": 112.39,
    "end": 114.59,
    "text": "通过我们的父神/母神"
  },
  {
    "start": 114.59,
    "end": 118.4,
    "text": "穿越多个维度（从12维度至1维度）"
  },
  {
    "start": 118.4,
    "end": 122.95,
    "text": "最终传递给人类 地球 和精灵 元素王国"
  },
  {
    "start": 123.33,
    "end": 126.66,
    "text": "暮雨·注 种子原子"
  },
  {
    "start": 126.66,
    "end": 131.31,
    "text": "创造的机制 围绕着这些种子原子展开"
  },
  {
    "start": 131.31,
    "end": 133.83,
    "text": "它们是一切创造的核心"
  },
  {
    "start": 133.83,
    "end": 138.44,
    "text": "其中编码着神圣源头意识最纯粹的表达"
  },
  {
    "start": 138.44,
    "end": 141.73,
    "text": "以及创造的蓝图 / 模版 / 公式"
  },
  {
    "start": 141.73,
    "end": 146.48,
    "text": "一个人要达到更高意识和存在状态的关键是——"
  },
  {
    "start": 146.48,
    "end": 150.55,
    "text": "逐步激活和整合这些新神圣蓝图种子原子"
  },
  {
    "start": 150.55,
    "end": 154.92,
    "text": "我们的父神 直接从最高造物主那里 接收"
  },
  {
    "start": 154.92,
    "end": 159.33,
    "text": "白火种子原子 （也称为 造物主之光的金刚粒子 ）"
  },
  {
    "start": 159.33,
    "end": 160.83,
    "text": "然后"
  },
  {
    "start": 160.83,
    "end": 163.77,
    "text": "他将这些神圣之光的粒子注入到"
  },
  {
    "start": 163.77,
    "end": 167.17,
    "text": "他新创造的神圣蓝图种子原子中"
  },
  {
    "start": 167.17,
    "end": 170.56,
    "text": "这个新创造物可以是任何事物"
  },
  {
    "start": 170.56,
    "end": 175.47,
    "text": "从星系 子宇宙 银河系 太阳系 行星"
  },
  {
    "start": 175.47,
    "end": 178.08,
    "text": "到新的有灵魂的人类种族"
  },
  {
    "start": 178.08,
    "end": 179.25,
    "text": "然而"
  },
  {
    "start": 179.25,
    "end": 183.49,
    "text": "我们目前将关注的是为地球创建的新蓝图"
  },
  {
    "start": 183.49,
    "end": 186.73,
    "text": "以及我们人类正在经历的转变过程——"
  },
  {
    "start": 186.73,
    "end": 188.21,
    "text": "即平衡和协调"
  },
  {
    "start": 188.21,
    "end": 192.17,
    "text": "我们第四维度世界的最后子层次 （复数）"
  },
  {
    "start": 192.17,
    "end": 195.92,
    "text": "并为进入第五维度的新环境做准备"
  },
  {
    "start": 195.92,
    "end": 198.52,
    "text": "这个过程包括整合银河意识的"
  },
  {
    "start": 198.52,
    "end": 200.11,
    "text": "五种更高层次的光"
  },
  {
    "start": 200.11,
    "end": 200.91,
    "text": "芒"
  },
  {
    "start": 200.91,
    "end": 204.84,
    "text": "在我们的父神为地球的新神圣计划"
  },
  {
    "start": 204.84,
    "end": 207.9,
    "text": "完成了播种白火种子原子后"
  },
  {
    "start": 207.9,
    "end": 211.63,
    "text": "这些原子就被植入我们母神的宇宙子宫中"
  },
  {
    "start": 211.63,
    "end": 212.95,
    "text": "之后"
  },
  {
    "start": 212.95,
    "end": 217.03,
    "text": "母神用她的圣灵频率 （生命 爱 和智慧）"
  },
  {
    "start": 217.03,
    "end": 218.68,
    "text": "激活新创造物的种子"
  },
  {
    "start": 218.68,
    "end": 219.64,
    "text": "原子"
  },
  {
    "start": 219.64,
    "end": 221.1,
    "text": "然后"
  },
  {
    "start": 221.1,
    "end": 225.72,
    "text": "她将它们辐射到另一个光之太阳（天国的太阳）"
  },
  {
    "start": 225.72,
    "end": 228.53,
    "text": "那里是儿子和女儿们的居住地"
  },
  {
    "start": 228.53,
    "end": 230.22,
    "text": "它们是我们这个子宇宙的"
  },
  {
    "start": 230.22,
    "end": 233.51,
    "text": "主要二元性/极性蓝图的承载者"
  },
  {
    "start": 233.51,
    "end": 236.5,
    "text": "这个天堂的太阳已经编码了"
  },
  {
    "start": 236.5,
    "end": 240.05,
    "text": "人类在整个地球周期的神圣蓝图"
  },
  {
    "start": 240.05,
    "end": 241.2,
    "text": "然而"
  },
  {
    "start": 241.2,
    "end": 244.38,
    "text": "在进入水瓶座时代的第一个阶段之前"
  },
  {
    "start": 244.38,
    "end": 245.67,
    "text": "新的组件——"
  },
  {
    "start": 245.67,
    "end": 248.13,
    "text": "升级版的神圣蓝图——"
  },
  {
    "start": 248.13,
    "end": 250.33,
    "text": "必须经过修改和激活"
  },
  {
    "start": 250.33,
    "end": 252.9,
    "text": "才能发送到天使王国进行进一"
  },
  {
    "start": 252.9,
    "end": 253.27,
    "text": "步分"
  },
  {
    "start": 253.27,
    "end": 254.1,
    "text": "配"
  },
  {
    "start": 254.1,
    "end": 257.5,
    "text": "・12位大天使"
  },
  {
    "start": 257.5,
    "end": 257.94,
    "text": "光之"
  },
  {
    "start": 257.94,
    "end": 262.55,
    "text": "金字塔 增强后的神圣蓝图"
  },
  {
    "start": 262.55,
    "end": 266.18,
    "text": "随后被辐射到我们子宇宙十二位大天使"
  },
  {
    "start": 266.18,
    "end": 268.33,
    "text": "所代表的十二道光芒中"
  },
  {
    "start": 268.33,
    "end": 272.86,
    "text": "这些奇妙的生命体将其整合并扩展"
  },
  {
    "start": 272.86,
    "end": 275.26,
    "text": "以适应造物主之光的新频率"
  },
  {
    "start": 275.26,
    "end": 281.98,
    "text": "这个神圣蓝图是专门为地球 人类以及精灵和元素王国设"
  },
  {
    "start": 281.98,
    "end": 283.41,
    "text": "计的"
  },
  {
    "start": 283.41,
    "end": 287.51,
    "text": "大天使们将神圣蓝图内的十二道光芒的"
  },
  {
    "start": 287.51,
    "end": 290.69,
    "text": "所有属性 品质和美德"
  },
  {
    "start": 290.69,
    "end": 292.93,
    "text": "辐射到三个巨大的光之金字"
  },
  {
    "start": 292.93,
    "end": 294.55,
    "text": "塔中"
  },
  {
    "start": 294.55,
    "end": 296.69,
    "text": "左边的金字塔"
  },
  {
    "start": 296.69,
    "end": 302.43,
    "text": "包含了人类能够获取 第四维度七个子层次的最终通行 所需的"
  },
  {
    "start": 302.43,
    "end": 302.67,
    "text": "新"
  },
  {
    "start": 302.67,
    "end": 304.06,
    "text": "任务"
  },
  {
    "start": 304.06,
    "end": 306.74,
    "text": "中间的金字塔最大"
  },
  {
    "start": 306.74,
    "end": 308.27,
    "text": "包含地球盖亚"
  },
  {
    "start": 308.27,
    "end": 310.26,
    "text": "过渡到更高的第四维度"
  },
  {
    "start": 310.26,
    "end": 312.26,
    "text": "和较低的第五维度环境的"
  },
  {
    "start": 312.26,
    "end": 313.8,
    "text": "数据"
  },
  {
    "start": 313.8,
    "end": 318.4,
    "text": "右边的金字塔包含了更高振动频率的光"
  },
  {
    "start": 318.4,
    "end": 320.85,
    "text": "这些光将由精灵和元素王国"
  },
  {
    "start": 320.85,
    "end": 322.82,
    "text": "辐射到元素生命"
  },
  {
    "start": 322.82,
    "end": 325.72,
    "text": "以及地球层面上所有无灵魂的创"
  },
  {
    "start": 325.72,
    "end": 327.17,
    "text": "造物"
  },
  {
    "start": 327.17,
    "end": 328.02,
    "text": "暮雨"
  },
  {
    "start": 328.02,
    "end": 328.96,
    "text": "·注"
  },
  {
    "start": 328.96,
    "end": 332.97,
    "text": "精灵是依附于地球的高电磁智能体"
  },
  {
    "start": 332.97,
    "end": 335.91,
    "text": "而天使是更高的电磁智能体"
  },
  {
    "start": 335.91,
    "end": 338.44,
    "text": "由于人类的视觉感官"
  },
  {
    "start": 338.44,
    "end": 341.76,
    "text": "只能感知到非常狭窄的能量频谱"
  },
  {
    "start": 341.76,
    "end": 344.16,
    "text": "所以在没有帮助的情况下"
  },
  {
    "start": 344.16,
    "end": 346.22,
    "text": "我们无法看到紫外线"
  },
  {
    "start": 346.22,
    "end": 348.93,
    "text": "x射线 或伽玛射线"
  },
  {
    "start": 348.93,
    "end": 352.38,
    "text": "更不用说科学家还没有发现的更高光谱"
  },
  {
    "start": 352.38,
    "end": 355.13,
    "text": "大角星人从电磁频谱的角度"
  },
  {
    "start": 355.13,
    "end": 357.45,
    "text": "揭秘了精灵 灵魂"
  },
  {
    "start": 357.45,
    "end": 362.37,
    "text": "神话人物 天使 UFO等各种具有意识的生命体"
  },
  {
    "start": 362.37,
    "end": 363.7,
    "text": "它们是真实"
  },
  {
    "start": 363.7,
    "end": 364.24,
    "text": "存在"
  },
  {
    "start": 364.24,
    "end": 364.82,
    "text": "的"
  },
  {
    "start": 364.82,
    "end": 369.27,
    "text": "・光之主/耶洛因  有形事物的"
  },
  {
    "start": 369.27,
    "end": 373.85,
    "text": "建造者 在光之金字塔阶段"
  },
  {
    "start": 373.85,
    "end": 377.69,
    "text": "伟大的光之主/耶洛因/有形事物的建造者"
  },
  {
    "start": 377.69,
    "end": 379.27,
    "text": "接管了这个过程"
  },
  {
    "start": 379.27,
    "end": 382.13,
    "text": "在三个光之金字塔中"
  },
  {
    "start": 382.13,
    "end": 384.81,
    "text": "新激活的蓝图被再次编码"
  },
  {
    "start": 384.81,
    "end": 388.64,
    "text": "同时被编码的还有白火记忆种子原子"
  },
  {
    "start": 388.64,
    "end": 393.15,
    "text": "这些原子中包含了 水瓶座时代扩展的"
  },
  {
    "start": 393.15,
    "end": 396.31,
    "text": "十二道光芒的全部属性 品质"
  },
  {
    "start": 396.31,
    "end": 398.23,
    "text": "和美德的频率模式"
  },
  {
    "start": 398.23,
    "end": 399.58,
    "text": "接着"
  },
  {
    "start": 399.58,
    "end": 403.11,
    "text": "耶洛因对新创造项目的蓝图进行改进"
  },
  {
    "start": 403.11,
    "end": 404.88,
    "text": "将频率逐步调低"
  },
  {
    "start": 404.88,
    "end": 407.91,
    "text": "以适应不同维度或层次的需要"
  },
  {
    "start": 407.91,
    "end": 408.75,
    "text": "并添加所"
  },
  {
    "start": 408.75,
    "end": 409.14,
    "text": "有细"
  },
  {
    "start": 409.14,
    "end": 409.97,
    "text": "节"
  },
  {
    "start": 409.97,
    "end": 410.97,
    "text": "155 00:06:50,970 --> 00:06:54,480 ・龙族 然后"
  },
  {
    "start": 414.48,
    "end": 416.75,
    "text": "每个光之金字塔中"
  },
  {
    "start": 416.75,
    "end": 419.88,
    "text": "光之主召唤出伟大的龙族"
  },
  {
    "start": 419.88,
    "end": 422.94,
    "text": "大天使Michael是龙族的总指挥"
  },
  {
    "start": 422.94,
    "end": 424.31,
    "text": "是的"
  },
  {
    "start": 424.31,
    "end": 426.69,
    "text": "龙族是真实存在的"
  },
  {
    "start": 426.69,
    "end": 430.24,
    "text": "这些伟大而令人敬畏的存在"
  },
  {
    "start": 430.24,
    "end": 434.44,
    "text": "在更高层次中的真实形象是极其壮丽的"
  },
  {
    "start": 434.44,
    "end": 439.25,
    "text": "龙族具有不同的大小 颜色和形态"
  },
  {
    "start": 439.25,
    "end": 442.04,
    "text": "具体取决于它们服务的子维度"
  },
  {
    "start": 442.04,
    "end": 445.25,
    "text": "维度环境的电磁能量模式越低"
  },
  {
    "start": 445.25,
    "end": 447.09,
    "text": "龙的体型就越小"
  },
  {
    "start": 447.09,
    "end": 448.32,
    "text": "此外"
  },
  {
    "start": 448.32,
    "end": 452.82,
    "text": "它们的大小也与它们特定的创造性专长有关"
  },
  {
    "start": 452.82,
    "end": 455.03,
    "text": "这些专长种类繁多"
  },
  {
    "start": 455.03,
    "end": 455.25,
    "text": "无"
  },
  {
    "start": 455.25,
    "end": 456.4,
    "text": "穷无尽"
  },
  {
    "start": 456.4,
    "end": 460.23,
    "text": "每种龙都被分配给一位特定的大天使"
  },
  {
    "start": 460.23,
    "end": 463.33,
    "text": "它体现了这位大天使所散发光芒的"
  },
  {
    "start": 463.33,
    "end": 465.65,
    "text": "属性 品质和美德"
  },
  {
    "start": 465.65,
    "end": 469.24,
    "text": "这些光芒的颜色会定期变化"
  },
  {
    "start": 469.24,
    "end": 474.2,
    "text": "这取决于许多因素（大天使Michael说这里暂时不讨论）"
  },
  {
    "start": 474.2,
    "end": 475.91,
    "text": "简单来说"
  },
  {
    "start": 475.91,
    "end": 479.33,
    "text": "龙会采用其指导天使的光芒颜色"
  },
  {
    "start": 479.33,
    "end": 482.6,
    "text": "这与它们所在的维度 频率层次"
  },
  {
    "start": 482.6,
    "end": 485.64,
    "text": "以及履行职责的时间范围有关"
  },
  {
    "start": 485.64,
    "end": 486.79,
    "text": "此外"
  },
  {
    "start": 486.79,
    "end": 488.98,
    "text": "在更高的维度中"
  },
  {
    "start": 488.98,
    "end": 492.18,
    "text": "大天使的数量远远超过十二位"
  },
  {
    "start": 492.18,
    "end": 495.62,
    "text": "它们负责执行来自光之主耶洛因的指导"
  },
  {
    "start": 495.62,
    "end": 496.46,
    "text": "和任务"
  },
  {
    "start": 496.46,
    "end": 498.66,
    "text": "接下来的阶段中"
  },
  {
    "start": 498.66,
    "end": 501.28,
    "text": "龙族前往另一个层面"
  },
  {
    "start": 501.28,
    "end": 504.19,
    "text": "在该层面新规划的神圣蓝图"
  },
  {
    "start": 504.19,
    "end": 506.96,
    "text": "将在物质存在的领域中显现"
  },
  {
    "start": 506.96,
    "end": 509.65,
    "text": "对于目前地球的情况"
  },
  {
    "start": 509.65,
    "end": 512.44,
    "text": "这些蓝图存在于第五维度"
  },
  {
    "start": 512.44,
    "end": 515.22,
    "text": "以便地球上 已经到达更高的"
  },
  {
    "start": 515.22,
    "end": 516.48,
    "text": "第四维度层次的"
  },
  {
    "start": 516.48,
    "end": 519.3,
    "text": "星际种子灵魂 能够访问"
  },
  {
    "start": 519.3,
    "end": 523.87,
    "text": "龙的数量取决于要播种的项目规模和范围"
  },
  {
    "start": 523.87,
    "end": 526.53,
    "text": "或者需要多少兆瓦的上帝种子原"
  },
  {
    "start": 526.53,
    "end": 527.58,
    "text": "子光量"
  },
  {
    "start": 527.58,
    "end": 534.82,
    "text": "龙族的另一个任务是从我们父神 母神那里 获取爱和生命力能量"
  },
  {
    "start": 534.82,
    "end": 538.76,
    "text": "然后将其提供给伟大的精灵/元素王国——"
  },
  {
    "start": 538.76,
    "end": 543.05,
    "text": "即所有未被赋予我是 灵魂意识的创造物"
  },
  {
    "start": 543.05,
    "end": 547.13,
    "text": "精灵/元素王国 与上帝源头的生命线"
  },
  {
    "start": 547.13,
    "end": 548.36,
    "text": "由伟大的龙族"
  },
  {
    "start": 548.36,
    "end": 549.8,
    "text": "提供支持"
  },
  {
    "start": 549.8,
    "end": 552.18,
    "text": "每个子维度的龙族"
  },
  {
    "start": 552.18,
    "end": 555.01,
    "text": "都辐射出该层次的振动模式"
  },
  {
    "start": 555.01,
    "end": 556.48,
    "text": "随后"
  },
  {
    "start": 556.48,
    "end": 560.37,
    "text": "种子原子被聚集到光之金字塔中"
  },
  {
    "start": 560.37,
    "end": 563.86,
    "text": "这些金字塔已被放置在全球各地——"
  },
  {
    "start": 563.86,
    "end": 565.84,
    "text": "自然界的元素天使们"
  },
  {
    "start": 565.84,
    "end": 567.6,
    "text": "会去这些能量场中"
  },
  {
    "start": 567.6,
    "end": 571.02,
    "text": "补充它们的上帝之光 （类似充电）"
  },
  {
    "start": 571.02,
    "end": 572.48,
    "text": "然后"
  },
  {
    "start": 572.48,
    "end": 575.26,
    "text": "它们将新神圣蓝图的种子原子"
  },
  {
    "start": 575.26,
    "end": 577.76,
    "text": "辐射成无数的公式"
  },
  {
    "start": 577.76,
    "end": 581.09,
    "text": "这些公式被发送到广阔的元素王国"
  },
  {
    "start": 581.09,
    "end": 583.34,
    "text": "这些忠诚的服务者"
  },
  {
    "start": 583.34,
    "end": 586.96,
    "text": "为所有未被赋予灵魂的神圣创造物"
  },
  {
    "start": 586.96,
    "end": 587.33,
    "text": "供应"
  },
  {
    "start": 587.33,
    "end": 587.7,
    "text": "生命"
  },
  {
    "start": 587.7,
    "end": 588.71,
    "text": "力能量"
  },
  {
    "start": 588.71,
    "end": 592.43,
    "text": "下集预告  光之金字"
  },
  {
    "start": 592.43,
    "end": 594.51,
    "text": "塔冥想方法"
  },
  {
    "start": 594.51,
    "end": 597.39,
    "text": "地球上每一个化身的灵魂"
  },
  {
    "start": 597.39,
    "end": 600.58,
    "text": "都在第五维度第一个子层次内"
  },
  {
    "start": 600.58,
    "end": 603.88,
    "text": "拥有一个 个人的光之金字塔"
  },
  {
    "start": 603.88,
    "end": 606.22,
    "text": "这是你自己的私人避难所"
  },
  {
    "start": 606.22,
    "end": 610.31,
    "text": "在神圣金字塔内有我们的天使助手"
  },
  {
    "start": 610.31,
    "end": 611.7,
    "text": "我们的灵性指导"
  },
  {
    "start": 611.7,
    "end": 613.79,
    "text": "和更高领域的导师"
  },
  {
    "start": 613.79,
    "end": 618.48,
    "text": "每次我们在冥想 或睡眠期间去那里时"
  },
  {
    "start": 618.48,
    "end": 622.29,
    "text": "我们可以接受这些灵性存有的帮助和指导"
  },
  {
    "start": 622.29,
    "end": 625.16,
    "text": "并将第五维度 更多的精细频率"
  },
  {
    "start": 625.16,
    "end": 625.9,
    "text": "带回我们的"
  },
  {
    "start": 625.9,
    "end": 627.28,
    "text": "物理身体中"
  },
  {
    "start": 627.28,
    "end": 630.8,
    "text": "光之金字塔的功能和用途繁多"
  },
  {
    "start": 630.8,
    "end": 633.15,
    "text": "包括个人的光之金字塔"
  },
  {
    "start": 633.15,
    "end": 636.7,
    "text": "世界金字塔和世界服务器金字塔"
  },
  {
    "start": 636.7,
    "end": 637.89,
    "text": "此外"
  },
  {
    "start": 637.89,
    "end": 641.69,
    "text": "我们还可以创建各种特殊用途的金字塔"
  },
  {
    "start": 641.69,
    "end": 645.04,
    "text": "例如工作项目金字塔 团队金字塔"
  },
  {
    "start": 645.04,
    "end": 647.27,
    "text": "和灵魂家族金字塔"
  },
  {
    "start": 647.27,
    "end": 648.88,
    "text": "事实上"
  },
  {
    "start": 648.88,
    "end": 651.53,
    "text": "你可以建造任意数量的金字塔"
  },
  {
    "start": 651.53,
    "end": 652.73,
    "text": "越多越好"
  },
  {
    "start": 652.73,
    "end": 654.47,
    "text": "因为这样"
  },
  {
    "start": 654.47,
    "end": 659.61,
    "text": "你将在你的金字塔中引入适当的振动频率和天使助手"
  },
  {
    "start": 659.61,
    "end": 662.24,
    "text": "来协助并支持你的特定目标"
  },
  {
    "start": 662.24,
    "end": 663.64,
    "text": "对此"
  },
  {
    "start": 663.64,
    "end": 664.22,
    "text": "大天使"
  },
  {
    "start": 664.22,
    "end": 667.93,
    "text": "Michael介绍了光之金字塔的具体冥想方法"
  },
  {
    "start": 667.93,
    "end": 670.07,
    "text": "以帮助我们提升和发挥全部"
  },
  {
    "start": 670.07,
    "end": 670.44,
    "text": "的神"
  },
  {
    "start": 670.44,
    "end": 670.65,
    "text": "圣"
  },
  {
    "start": 670.65,
    "end": 670.88,
    "text": "潜"
  },
  {
    "start": 670.88,
    "end": 671.42,
    "text": "能"
  }
]