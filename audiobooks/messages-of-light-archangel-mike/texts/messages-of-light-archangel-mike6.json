[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "保持稳定"
  },
  {
    "start": 3.7,
    "end": 5.03,
    "text": "亲爱的"
  },
  {
    "start": 5.03,
    "end": 8.94,
    "text": "来自大天使MICHAEL的智慧教导"
  },
  {
    "start": 8.94,
    "end": 12.219,
    "text": "神圣抄写员Ronna Vezane"
  },
  {
    "start": 12.22,
    "end": 14.77,
    "text": "翻译 / 解读 暮雨"
  },
  {
    "start": 14.77,
    "end": 15.77,
    "text": "整合更高频率的光"
  },
  {
    "start": 18.41,
    "end": 21.1,
    "text": "激活你的无限潜能"
  },
  {
    "start": 21.1,
    "end": 25.09,
    "text": "随着每次下载更高频率的能量"
  },
  {
    "start": 25.09,
    "end": 27.94,
    "text": "你的理解力和意识水平都会提高"
  },
  {
    "start": 27.94,
    "end": 29.82,
    "text": "星际种子"
  },
  {
    "start": 29.82,
    "end": 31.65,
    "text": "你正在经历剧变"
  },
  {
    "start": 31.65,
    "end": 34.81,
    "text": "你们不再被允许停滞不前"
  },
  {
    "start": 34.81,
    "end": 38.17,
    "text": "因为时间和转变过程进展越来越快"
  },
  {
    "start": 38.17,
    "end": 42.73,
    "text": "你们的语言 思维方式都在不断变化"
  },
  {
    "start": 42.73,
    "end": 46.5,
    "text": "人类大脑中记录过去的旧区域"
  },
  {
    "start": 46.5,
    "end": 49.42,
    "text": "正在逐渐被精炼或溶解"
  },
  {
    "start": 49.42,
    "end": 53.35,
    "text": "这是为什么你们开始感觉 以前发生的一切"
  },
  {
    "start": 53.35,
    "end": 55.68,
    "text": "甚至是去年发生的事"
  },
  {
    "start": 55.68,
    "end": 57.78,
    "text": "似乎都是一场模糊的梦"
  },
  {
    "start": 57.78,
    "end": 62.38,
    "text": "因为你们大脑中的新区域 正在被激活"
  },
  {
    "start": 62.38,
    "end": 66.87,
    "text": "你必须学会 用全新的方式思考与感知 ——"
  },
  {
    "start": 66.87,
    "end": 71.01,
    "text": "光的信息包 具有重要意义的全息图像"
  },
  {
    "start": 71.01,
    "end": 73.36,
    "text": "以及神圣几何图案"
  },
  {
    "start": 73.36,
    "end": 75.76,
    "text": "将开始渗入你们的意识"
  },
  {
    "start": 75.76,
    "end": 78.96,
    "text": "你必须学会如何解读它们"
  },
  {
    "start": 78.96,
    "end": 81.45,
    "text": "并发展你的辨别力"
  },
  {
    "start": 81.45,
    "end": 85.31,
    "text": "成熟的灵性 并非无意识的体验"
  },
  {
    "start": 85.31,
    "end": 90.31,
    "text": "你必须努力发展一种 自我维持的神性"
  },
  {
    "start": 90.31,
    "end": 93.31,
    "text": "因为当你回归自我掌握时"
  },
  {
    "start": 93.31,
    "end": 96.07,
    "text": "你将启动 光体化的过程 ——"
  },
  {
    "start": 96.07,
    "end": 99.68,
    "text": "激活与整合你在其他转世经历中的"
  },
  {
    "start": 99.68,
    "end": 103.26,
    "text": "特殊天赋 属性 和品质等潜力"
  },
  {
    "start": 103.26,
    "end": 106.47,
    "text": "作为一个有意识的共同创造者"
  },
  {
    "start": 106.47,
    "end": 108.63,
    "text": "你能够通过神圣呼吸"
  },
  {
    "start": 108.63,
    "end": 111.38,
    "text": "获取宇宙无限量的金刚粒子"
  },
  {
    "start": 111.38,
    "end": 114.05,
    "text": "将其用于你的创造性工作"
  },
  {
    "start": 114.05,
    "end": 116.05,
    "text": "成为自我掌握的大师"
  },
  {
    "start": 119.29,
    "end": 121.28,
    "text": "亲爱的大师们"
  },
  {
    "start": 121.28,
    "end": 124.81,
    "text": "我们将回顾 过去一些关键课程"
  },
  {
    "start": 124.81,
    "end": 129.78,
    "text": "供那些希望在此生 主张获得 完整灵魂意识"
  },
  {
    "start": 129.78,
    "end": 133.22,
    "text": "并达到 自我掌握的人学习"
  },
  {
    "start": 133.6,
    "end": 137.35,
    "text": "暮雨·注 什么是自我掌握"
  },
  {
    "start": 137.35,
    "end": 142.429,
    "text": "自我掌握 （Self-mastery） 是大天使Michael"
  },
  {
    "start": 142.43,
    "end": 144.41,
    "text": "常提到的一个术语"
  },
  {
    "start": 144.41,
    "end": 146.24,
    "text": "为了更好地理解"
  },
  {
    "start": 146.24,
    "end": 149.5,
    "text": "在此有必要先阐释它包含的完整意义"
  },
  {
    "start": 149.87,
    "end": 153.43,
    "text": "Self-mastery 指的是 一种对自我"
  },
  {
    "start": 153.43,
    "end": 155.84,
    "text": "思想 情绪和行为"
  },
  {
    "start": 155.84,
    "end": 157.84,
    "text": "高度掌握的状态"
  },
  {
    "start": 157.84,
    "end": 161.53,
    "text": "以及持续地自我改进和实现目标的能力"
  },
  {
    "start": 161.53,
    "end": 164.93,
    "text": "具体包括以下几个方面"
  },
  {
    "start": 164.93,
    "end": 168.43,
    "text": "1. 思想的觉知与控制"
  },
  {
    "start": 168.43,
    "end": 171.26,
    "text": "能深刻洞察自己的思维模式"
  },
  {
    "start": 171.26,
    "end": 174.29,
    "text": "行为习惯 和情绪触发点"
  },
  {
    "start": 174.29,
    "end": 177.12,
    "text": "能有意识地引导思维活动"
  },
  {
    "start": 177.12,
    "end": 180.38,
    "text": "避免消极 或破坏性的想法"
  },
  {
    "start": 180.38,
    "end": 185.23,
    "text": "始终选择 积极 和建设性的思维方式"
  },
  {
    "start": 185.23,
    "end": 187.97,
    "text": "2. 情绪管理"
  },
  {
    "start": 187.97,
    "end": 193.63,
    "text": "能够识别 理解 和适当表达 自己的情绪"
  },
  {
    "start": 193.63,
    "end": 195.7,
    "text": "不被情绪裹挟"
  },
  {
    "start": 195.7,
    "end": 199.23,
    "text": "能够在各种情境下保持冷静和理性"
  },
  {
    "start": 199.23,
    "end": 200.23,
    "text": "行为控制  "
  },
  {
    "start": 203.42,
    "end": 206.63,
    "text": "行动源于内在价值观 和目标"
  },
  {
    "start": 206.63,
    "end": 210.48,
    "text": "不受外界因素 或短期诱惑轻易影响"
  },
  {
    "start": 210.48,
    "end": 212.75,
    "text": "从而触发冲动行为"
  },
  {
    "start": 212.75,
    "end": 215.97,
    "text": "能自律地坚持良好习惯"
  },
  {
    "start": 215.97,
    "end": 219.91,
    "text": "总是保持行动的一致性 和决心"
  },
  {
    "start": 219.91,
    "end": 225.52,
    "text": "4. 目标导向  能设定明确的目标"
  },
  {
    "start": 225.52,
    "end": 228.26,
    "text": "并有毅力和决心保持专注"
  },
  {
    "start": 228.26,
    "end": 229.51,
    "text": "达成目标"
  },
  {
    "start": 229.51,
    "end": 231.25,
    "text": "在过程中"
  },
  {
    "start": 231.25,
    "end": 233.93,
    "text": "能克服各种障碍和挑战"
  },
  {
    "start": 233.93,
    "end": 234.93,
    "text": "5. 适应能力"
  },
  {
    "start": 237.86,
    "end": 241.55,
    "text": "可以灵活应对突发的变化和挑战"
  },
  {
    "start": 241.55,
    "end": 244.75,
    "text": "6. 持续自我完善"
  },
  {
    "start": 244.75,
    "end": 247.8,
    "text": "深刻了解自己的优点与不足"
  },
  {
    "start": 247.8,
    "end": 249.56,
    "text": "能够自我反省"
  },
  {
    "start": 249.56,
    "end": 251.66,
    "text": "从经验中吸取教训"
  },
  {
    "start": 251.66,
    "end": 254.17,
    "text": "以持续改进自我"
  },
  {
    "start": 254.17,
    "end": 256.17,
    "text": "92 00:04:16,170 --> 00:04:18,170"
  },
  {
    "start": 258.17,
    "end": 263.48,
    "text": "无限呼吸  │ 激活与创造的神圣呼吸"
  },
  {
    "start": 263.48,
    "end": 266.21,
    "text": "我们所称的神圣呼吸"
  },
  {
    "start": 266.21,
    "end": 269.13,
    "text": "不仅包含了通常标准的 第三维度"
  },
  {
    "start": 269.13,
    "end": 272.68,
    "text": "和第四维度的空气 （即氧气）"
  },
  {
    "start": 272.68,
    "end": 274.57,
    "text": "也包含了普拉那——"
  },
  {
    "start": 274.57,
    "end": 277.11,
    "text": "它代表着宇宙生命力能量——"
  },
  {
    "start": 277.11,
    "end": 280.0,
    "text": "这种能量以电流的形式"
  },
  {
    "start": 280.0,
    "end": 282.97,
    "text": "流入并贯穿 整个物质身体"
  },
  {
    "start": 282.97,
    "end": 284.26,
    "text": "此外"
  },
  {
    "start": 284.26,
    "end": 287.83,
    "text": "它还包含造物主之光的金刚粒子"
  },
  {
    "start": 287.83,
    "end": 291.08,
    "text": "随着你意识层次的提升"
  },
  {
    "start": 291.08,
    "end": 294.89,
    "text": "这些神圣粒子的亮度和力量也会增强"
  },
  {
    "start": 294.89,
    "end": 297.61,
    "text": "赋予力量的无限呼吸"
  },
  {
    "start": 297.61,
    "end": 300.2,
    "text": "打开了通往造物主意识的多维度通"
  },
  {
    "start": 300.2,
    "end": 300.96,
    "text": "道"
  },
  {
    "start": 300.96,
    "end": 305.44,
    "text": "当你逐渐改变思维和感知方式时"
  },
  {
    "start": 305.44,
    "end": 307.62,
    "text": "你的内在视角也会自动拓"
  },
  {
    "start": 307.62,
    "end": 308.42,
    "text": "宽"
  },
  {
    "start": 308.42,
    "end": 313.12,
    "text": "・激活 与整合 种子原"
  },
  {
    "start": 313.12,
    "end": 316.24,
    "text": "子 一旦你打开了"
  },
  {
    "start": 316.24,
    "end": 318.2,
    "text": "位于背部肩胛骨之间"
  },
  {
    "start": 318.2,
    "end": 320.68,
    "text": "神圣之心的背部门户"
  },
  {
    "start": 320.68,
    "end": 324.49,
    "text": "无限呼吸的吸气循环就会通过延髓"
  },
  {
    "start": 324.49,
    "end": 329.27,
    "text": "从头骨底部的扬升脉轮 （即头的背部门户）"
  },
  {
    "start": 329.27,
    "end": 331.73,
    "text": "向上扫入你的灵魂之星"
  },
  {
    "start": 331.73,
    "end": 336.35,
    "text": "当神圣呼吸通过你的灵魂之星时"
  },
  {
    "start": 336.35,
    "end": 339.15,
    "text": "你吸入的 造物主之光的金刚粒子"
  },
  {
    "start": 339.15,
    "end": 340.27,
    "text": "被编码"
  },
  {
    "start": 340.27,
    "end": 344.03,
    "text": "以整合 来自你的超灵 /高我"
  },
  {
    "start": 344.03,
    "end": 346.09,
    "text": "特定数量的 生命代码"
  },
  {
    "start": 346.09,
    "end": 346.73,
    "text": "记忆种子"
  },
  {
    "start": 346.73,
    "end": 348.26,
    "text": "原子"
  },
  {
    "start": 348.26,
    "end": 350.48,
    "text": "呼气或吐气时"
  },
  {
    "start": 350.48,
    "end": 353.58,
    "text": "神圣呼吸 会穿过根脉轮"
  },
  {
    "start": 353.58,
    "end": 355.41,
    "text": "或称海底轮"
  },
  {
    "start": 355.41,
    "end": 358.75,
    "text": "并激活 那里的昆达里尼种子原子"
  },
  {
    "start": 358.75,
    "end": 363.02,
    "text": "这些储存在根脉轮中的 金刚粒子"
  },
  {
    "start": 363.02,
    "end": 366.44,
    "text": "在你的超灵/高我的精确监控下"
  },
  {
    "start": 366.44,
    "end": 369.58,
    "text": "被添加到神圣呼吸中"
  },
  {
    "start": 369.58,
    "end": 371.18,
    "text": "暮雨·注"
  },
  {
    "start": 371.18,
    "end": 373.75,
    "text": "我们在《抹大拉手稿》第10集"
  },
  {
    "start": 373.75,
    "end": 374.63,
    "text": "荷鲁斯内"
  },
  {
    "start": 374.63,
    "end": 377.1,
    "text": "在炼金术  新手入门冥想方法中"
  },
  {
    "start": 377.1,
    "end": 380.24,
    "text": "提到的 储存在骨盆区域的生命力能量"
  },
  {
    "start": 380.24,
    "end": 381.68,
    "text": "塞赫姆"
  },
  {
    "start": 381.68,
    "end": 384.09,
    "text": "正是昆达里尼种子原子"
  },
  {
    "start": 384.09,
    "end": 387.04,
    "text": "抹大拉的玛利亚提供的信息"
  },
  {
    "start": 387.04,
    "end": 390.38,
    "text": "与大天使Michael的内容互为补充"
  },
  {
    "start": 390.38,
    "end": 391.8,
    "text": "相互印证"
  },
  {
    "start": 391.8,
    "end": 394.54,
    "text": "增强了可信度和完整性"
  },
  {
    "start": 394.54,
    "end": 399.22,
    "text": "希望深入研究的朋友可以去查看"
  },
  {
    "start": 399.22,
    "end": 402.82,
    "text": "储存在根脉轮中的 金刚光粒子"
  },
  {
    "start": 402.82,
    "end": 405.11,
    "text": "是独一无二的"
  },
  {
    "start": 405.11,
    "end": 411.18,
    "text": "因为它们包含了你当前 神圣蓝图中 被编码的 记忆种子原子——"
  },
  {
    "start": 411.18,
    "end": 414.46,
    "text": "其中包含了你 其他转世经历中的"
  },
  {
    "start": 414.46,
    "end": 417.68,
    "text": "特殊天赋 属性 和品质——"
  },
  {
    "start": 417.68,
    "end": 421.1,
    "text": "也包含那些 你带到此生"
  },
  {
    "start": 421.1,
    "end": 424.22,
    "text": "需要被疗愈与调和的扭曲 记忆种子"
  },
  {
    "start": 424.22,
    "end": 425.8,
    "text": "原子"
  },
  {
    "start": 425.8,
    "end": 429.74,
    "text": "然后 神圣呼吸 向上移动"
  },
  {
    "start": 429.74,
    "end": 432.34,
    "text": "回到物质身体前方"
  },
  {
    "start": 432.34,
    "end": 435.43,
    "text": "并自动进入 身体的 晶体静止点"
  },
  {
    "start": 435.43,
    "end": 440.36,
    "text": "种子原子 所在的位置 （即太阳力量中心）"
  },
  {
    "start": 440.36,
    "end": 444.18,
    "text": "这个种子原子 被设计用来磁化"
  },
  {
    "start": 444.18,
    "end": 445.89,
    "text": "整合 和储备"
  },
  {
    "start": 445.89,
    "end": 448.14,
    "text": "这些更高频率的光粒子"
  },
  {
    "start": 448.14,
    "end": 451.29,
    "text": "它可以被称为集结中心"
  },
  {
    "start": 451.29,
    "end": 453.54,
    "text": "因为它直接连接到你的神圣"
  },
  {
    "start": 453.54,
    "end": 455.06,
    "text": "之心"
  },
  {
    "start": 455.06,
    "end": 456.45,
    "text": "然后"
  },
  {
    "start": 456.45,
    "end": 459.11,
    "text": "金刚光粒子 经由无限呼吸"
  },
  {
    "start": 459.11,
    "end": 461.88,
    "text": "被吸入 你的神圣之心"
  },
  {
    "start": 461.88,
    "end": 466.42,
    "text": "并通过你思想的源头 或原始意图 激活"
  },
  {
    "start": 466.81,
    "end": 469.12,
    "text": "这些编码好的金刚粒子"
  },
  {
    "start": 469.12,
    "end": 472.87,
    "text": "随时准备被呼出到 你的十二道光线"
  },
  {
    "start": 472.87,
    "end": 475.69,
    "text": "创造之轮 以及整个世界"
  },
  {
    "start": 475.69,
    "end": 476.87,
    "text": "此外"
  },
  {
    "start": 476.87,
    "end": 481.61,
    "text": "一部分的光粒子也将被输送到 第五维度世界金字塔"
  },
  {
    "start": 481.61,
    "end": 483.83,
    "text": "和其他你选择的 光之金"
  },
  {
    "start": 483.83,
    "end": 485.29,
    "text": "字塔"
  },
  {
    "start": 485.29,
    "end": 488.48,
    "text": "一旦你进入了你的神圣之心"
  },
  {
    "start": 488.48,
    "end": 491.02,
    "text": "并激活了太阳力量中心"
  },
  {
    "start": 491.02,
    "end": 494.1,
    "text": "位于太阳力量中心的零点或静止点"
  },
  {
    "start": 494.1,
    "end": 497.57,
    "text": "种子原子就会开始储存宇宙能量"
  },
  {
    "start": 497.57,
    "end": 500.13,
    "text": "当你成为一个自我掌握者"
  },
  {
    "start": 500.13,
    "end": 503.24,
    "text": "和有意识的共同创造者时"
  },
  {
    "start": 503.24,
    "end": 506.38,
    "text": "你将能够获取无限量的金刚粒子"
  },
  {
    "start": 506.38,
    "end": 509.03,
    "text": "将其用于你的创造性工作"
  },
  {
    "start": 509.03,
    "end": 511.34,
    "text": "并与他人分享"
  },
  {
    "start": 511.34,
    "end": 514.55,
    "text": "作为一个已觉醒的自我掌握者"
  },
  {
    "start": 514.55,
    "end": 516.41,
    "text": "你所吸引到的神圣宇宙"
  },
  {
    "start": 516.41,
    "end": 517.8,
    "text": "白火金刚粒子"
  },
  {
    "start": 517.8,
    "end": 519.54,
    "text": "必须不断循环"
  },
  {
    "start": 519.54,
    "end": 523.31,
    "text": "因为只有在每个灵魂当前的启蒙水平下"
  },
  {
    "start": 523.31,
    "end": 525.87,
    "text": "适合整合的那部分能量"
  },
  {
    "start": 525.87,
    "end": 528.84,
    "text": "才可以被存储在物质身体中"
  },
  {
    "start": 528.84,
    "end": 531.22,
    "text": "其余的能量必须辐射到物质"
  },
  {
    "start": 531.22,
    "end": 532.77,
    "text": "世界"
  },
  {
    "start": 533.15,
    "end": 535.97,
    "text": "暮雨·注 太阳力量中心"
  },
  {
    "start": 535.97,
    "end": 538.56,
    "text": "并非脉轮系统的太阳神经"
  },
  {
    "start": 538.56,
    "end": 542.69,
    "text": "丛脉轮我在之前翻译的文章中"
  },
  {
    "start": 542.69,
    "end": 546.99,
    "text": "把Solar Power Center翻译为太阳能量中心"
  },
  {
    "start": 546.99,
    "end": 548.83,
    "text": "思忖再三"
  },
  {
    "start": 548.83,
    "end": 552.88,
    "text": "为避免与太阳神经丛脉轮的概念混淆"
  },
  {
    "start": 552.88,
    "end": 555.65,
    "text": "将其翻译为太阳力量中心"
  },
  {
    "start": 555.65,
    "end": 558.83,
    "text": "更能准确传达大天使Michael的本意"
  },
  {
    "start": 558.83,
    "end": 562.16,
    "text": "以下是我在翻阅大天使其他资料后的"
  },
  {
    "start": 562.16,
    "end": 566.07,
    "text": "总结  在你激活 并连接到"
  },
  {
    "start": 566.07,
    "end": 569.71,
    "text": "你的神圣之心和神圣心智之前"
  },
  {
    "start": 569.71,
    "end": 572.52,
    "text": "你的太阳神经丛在物质层面上"
  },
  {
    "start": 572.52,
    "end": 579.51,
    "text": "作为辐射能量中心发挥作用 （即 你使用的是太阳神经丛脉轮）"
  },
  {
    "start": 579.51,
    "end": 580.74,
    "text": "然而"
  },
  {
    "start": 580.74,
    "end": 583.1,
    "text": "当你提升了你的频率"
  },
  {
    "start": 583.1,
    "end": 585.02,
    "text": "你的灵魂自我从此成为"
  },
  {
    "start": 585.02,
    "end": 587.72,
    "text": "你生命中的主导力量时"
  },
  {
    "start": 587.72,
    "end": 589.48,
    "text": "你将逐渐获得对你"
  },
  {
    "start": 589.48,
    "end": 593.15,
    "text": "神圣之心和神圣心智的访问权"
  },
  {
    "start": 593.15,
    "end": 594.4,
    "text": "因此"
  },
  {
    "start": 594.4,
    "end": 596.05,
    "text": "你的太阳神经丛"
  },
  {
    "start": 596.05,
    "end": 599.71,
    "text": "将逐渐整合为太阳力量中心"
  },
  {
    "start": 599.71,
    "end": 602.01,
    "text": "该中心由太阳神经丛"
  },
  {
    "start": 602.01,
    "end": 604.77,
    "text": "心脏 胸腺和喉咙组成"
  },
  {
    "start": 604.77,
    "end": 606.53,
    "text": "从此之后"
  },
  {
    "start": 606.53,
    "end": 610.25,
    "text": "你的神圣之心将成为你的力量中心"
  },
  {
    "start": 610.25,
    "end": 613.42,
    "text": "因为你将有 源源不断的生命金刚粒子"
  },
  {
    "start": 613.42,
    "end": 617.35,
    "text": "通过你的神圣心灵的中心 流进你"
  },
  {
    "start": 617.35,
    "end": 620.44,
    "text": "然后流遍你的整个物质身体"
  },
  {
    "start": 620.44,
    "end": 622.3,
    "text": "最后流向世界"
  },
  {
    "start": 622.3,
    "end": 625.23,
    "text": "你也将在神圣之心的内殿中"
  },
  {
    "start": 625.23,
    "end": 627.66,
    "text": "找到慰藉 力量 和"
  },
  {
    "start": 627.66,
    "end": 628.16,
    "text": "同情"
  },
  {
    "start": 628.16,
    "end": 628.92,
    "text": "心"
  },
  {
    "start": 628.92,
    "end": 633.38,
    "text": "・松果体  │ 大脑的光"
  },
  {
    "start": 633.38,
    "end": 635.16,
    "text": "过滤器"
  },
  {
    "start": 635.16,
    "end": 639.25,
    "text": "松果体可以称为大脑的光过滤器"
  },
  {
    "start": 639.63,
    "end": 643.54,
    "text": "脉轮系统被设计为吸引 磁化 和过滤"
  },
  {
    "start": 643.54,
    "end": 647.03,
    "text": "适当的振动频率 融入身体"
  },
  {
    "start": 647.03,
    "end": 650.83,
    "text": "这些振动频率由大天使们辐射出"
  },
  {
    "start": 650.83,
    "end": 652.17,
    "text": "每一道特定光线"
  },
  {
    "start": 652.17,
    "end": 656.7,
    "text": "携带着独特的属性 品质 和美德"
  },
  {
    "start": 656.7,
    "end": 659.15,
    "text": "有一个复杂的公式"
  },
  {
    "start": 659.15,
    "end": 662.14,
    "text": "由各种各样的频率模式组成"
  },
  {
    "start": 662.14,
    "end": 666.02,
    "text": "这些频率模式不断穿透人类的能量场"
  },
  {
    "start": 666.02,
    "end": 667.37,
    "text": "然后传递到物质"
  },
  {
    "start": 667.37,
    "end": 670.29,
    "text": "身体中的腺体和记忆中心"
  },
  {
    "start": 670.29,
    "end": 674.28,
    "text": "随着每次下载更高频率的能量"
  },
  {
    "start": 674.28,
    "end": 676.62,
    "text": "你的理解力 和意识水平都"
  },
  {
    "start": 676.62,
    "end": 677.02,
    "text": "会提"
  },
  {
    "start": 677.02,
    "end": 679.35,
    "text": "高"
  },
  {
    "start": 679.35,
    "end": 683.86,
    "text": "发展成熟的灵性"
  },
  {
    "start": 683.86,
    "end": 684.73,
    "text": "回归神"
  },
  {
    "start": 684.73,
    "end": 690.39,
    "text": "性自我 成熟的灵性并非无意识的体验"
  },
  {
    "start": 690.39,
    "end": 694.6,
    "text": "你必须努力发展一种自我维持的神性"
  },
  {
    "start": 694.6,
    "end": 696.69,
    "text": "在这种状态下"
  },
  {
    "start": 696.69,
    "end": 699.74,
    "text": "你不断呼吸着丰富的生命之气——"
  },
  {
    "start": 699.74,
    "end": 702.65,
    "text": "即 造物主本质的金刚粒子"
  },
  {
    "start": 702.65,
    "end": 704.35,
    "text": "通过这样做"
  },
  {
    "start": 704.35,
    "end": 707.85,
    "text": "你将开始经由第八脉轮（你的灵魂之星）"
  },
  {
    "start": 707.85,
    "end": 710.74,
    "text": "以及你神圣之心的背部门户"
  },
  {
    "start": 710.74,
    "end": 712.4,
    "text": "从生命之河获得灵"
  },
  {
    "start": 712.4,
    "end": 714.17,
    "text": "性滋养"
  },
  {
    "start": 714.17,
    "end": 716.77,
    "text": "每个有自我觉察力的人"
  },
  {
    "start": 716.77,
    "end": 719.68,
    "text": "都像一颗活生生的星星"
  },
  {
    "start": 719.68,
    "end": 721.97,
    "text": "能够根据自己的意识水平"
  },
  {
    "start": 721.97,
    "end": 724.98,
    "text": "接收和传递 谐波频率振动"
  },
  {
    "start": 724.98,
    "end": 727.82,
    "text": "正如你现在所知道的"
  },
  {
    "start": 727.82,
    "end": 731.56,
    "text": "这些频率被称为 你的灵魂之歌"
  },
  {
    "start": 731.56,
    "end": 733.41,
    "text": "你是一个光点"
  },
  {
    "start": 733.41,
    "end": 736.04,
    "text": "一个充满活力的神圣火花"
  },
  {
    "start": 736.04,
    "end": 740.72,
    "text": "而这个子宇宙是由一首 巨大的天体灵魂之"
  },
  {
    "start": 740.72,
    "end": 742.46,
    "text": "歌组成"
  },
  {
    "start": 742.46,
    "end": 746.22,
    "text": "随着你逐渐掌握 轻松 而深沉地"
  },
  {
    "start": 746.22,
    "end": 749.2,
    "text": "呼吸 神圣气息的能力"
  },
  {
    "start": 749.2,
    "end": 754.95,
    "text": "你的意识 将逐渐下沉到 你的神圣之心的中心"
  },
  {
    "start": 754.95,
    "end": 758.99,
    "text": "然后 再深入到 鱼眼 曼荼罗"
  },
  {
    "start": 758.99,
    "end": 761.89,
    "text": "其中包含白火记忆种子原子——"
  },
  {
    "start": 761.89,
    "end": 763.87,
    "text": "这是你个人 与我们"
  },
  {
    "start": 764.11,
    "end": 767.6,
    "text": "父神 /母神的 神圣面向"
  },
  {
    "start": 767.6,
    "end": 768.86,
    "text": "这时"
  },
  {
    "start": 768.86,
    "end": 772.88,
    "text": "你可以汲取 你所能容纳的 所有神圣之爱"
  },
  {
    "start": 772.88,
    "end": 774.25,
    "text": "同时"
  },
  {
    "start": 774.25,
    "end": 777.52,
    "text": "你开始意识到 自己既是造梦者"
  },
  {
    "start": 777.52,
    "end": 779.86,
    "text": "也是梦本身"
  },
  {
    "start": 779.86,
    "end": 783.09,
    "text": "正是在这个神圣的空间中"
  },
  {
    "start": 783.09,
    "end": 785.53,
    "text": "你将开始回家之旅"
  },
  {
    "start": 785.53,
    "end": 788.06,
    "text": "回归你完整的神性"
  },
  {
    "start": 788.06,
    "end": 790.35,
    "text": "并努力 将自己重塑为"
  },
  {
    "start": 790.35,
    "end": 793.9,
    "text": "我们父神/母神的 太阳之子"
  },
  {
    "start": 793.9,
    "end": 796.98,
    "text": "这一切都是命中注定的"
  },
  {
    "start": 796.98,
    "end": 797.56,
    "text": "这是你的"
  },
  {
    "start": 797.56,
    "end": 799.58,
    "text": "神圣遗产"
  },
  {
    "start": 799.96,
    "end": 805.87,
    "text": "暮雨·注 鱼眼 曼荼罗 （Vesica Piscis Mandala） 是"
  },
  {
    "start": 806.17,
    "end": 808.14,
    "text": "神圣几何的基本元素"
  },
  {
    "start": 808.14,
    "end": 813.15,
    "text": "它由两个 相同半径的圆 相交形成"
  },
  {
    "start": 813.15,
    "end": 816.8,
    "text": "两个圆的交集部分就是Vesica Piscis"
  },
  {
    "start": 816.8,
    "end": 818.85,
    "text": "它看起来像一个鱼形"
  },
  {
    "start": 818.85,
    "end": 822.54,
    "text": "这是一个重要的神圣几何图形"
  },
  {
    "start": 822.54,
    "end": 826.08,
    "text": "象征着创造能量 和宇宙的起源"
  },
  {
    "start": 826.08,
    "end": 828.83,
    "text": "它代表着二元性与统一"
  },
  {
    "start": 828.83,
    "end": 832.65,
    "text": "例如阴阳 男性和女性的结合"
  },
  {
    "start": 832.65,
    "end": 835.11,
    "text": "并最终达到统一与和谐"
  },
  {
    "start": 835.11,
    "end": 836.33,
    "text": "因此"
  },
  {
    "start": 836.33,
    "end": 839.14,
    "text": "在灵性和宗教传统中"
  },
  {
    "start": 839.14,
    "end": 843.15,
    "text": "鱼眼曼荼罗常用于冥想和灵性启示"
  },
  {
    "start": 843.15,
    "end": 844.46,
    "text": "帮助连接更高的"
  },
  {
    "start": 844.46,
    "end": 847.39,
    "text": "意识层次"
  },
  {
    "start": 847.39,
    "end": 849.06,
    "text": "请记住"
  },
  {
    "start": 849.06,
    "end": 851.02,
    "text": "你的原型存在"
  },
  {
    "start": 851.02,
    "end": 852.68,
    "text": "只有极微小的碎片"
  },
  {
    "start": 852.68,
    "end": 855.75,
    "text": "在第三/第四维度的密度中化身"
  },
  {
    "start": 855.75,
    "end": 860.99,
    "text": "第四维度包含星光界 （即我们常说的灵界）"
  },
  {
    "start": 860.99,
    "end": 863.54,
    "text": "它是通往第五维度的桥梁"
  },
  {
    "start": 863.54,
    "end": 866.82,
    "text": "前三个 较低的子层次"
  },
  {
    "start": 866.82,
    "end": 869.72,
    "text": "充满了大量情绪能量碎片"
  },
  {
    "start": 869.72,
    "end": 873.19,
    "text": "与各种不和谐频率 和思维形式"
  },
  {
    "start": 873.19,
    "end": 877.86,
    "text": "第四维度是人类在地球上所有过去时代的"
  },
  {
    "start": 877.86,
    "end": 879.99,
    "text": "集体意识信念的宝库"
  },
  {
    "start": 879.99,
    "end": 884.66,
    "text": "第四维度还包含了地球的心智体能量场"
  },
  {
    "start": 884.85,
    "end": 890.05,
    "text": "（暮雨注  意味着当我们的意识调谐到第四维度时"
  },
  {
    "start": 890.05,
    "end": 890.83,
    "text": "可以与地球"
  },
  {
    "start": 890.83,
    "end": 891.18,
    "text": "的思"
  },
  {
    "start": 891.18,
    "end": 896.43,
    "text": "想沟通）  星际种子"
  },
  {
    "start": 896.43,
    "end": 897.01,
    "text": "你正在"
  },
  {
    "start": 897.01,
    "end": 898.96,
    "text": "经历剧变"
  },
  {
    "start": 898.96,
    "end": 902.66,
    "text": "你们被称为星际种子是有原因的"
  },
  {
    "start": 902.66,
    "end": 906.03,
    "text": "因为当你回归自我掌握时"
  },
  {
    "start": 906.03,
    "end": 909.99,
    "text": "你将启动 整合高度发达的 晶体生命代码"
  },
  {
    "start": 909.99,
    "end": 912.4,
    "text": "记忆种子原子的过程 ——"
  },
  {
    "start": 912.4,
    "end": 915.61,
    "text": "这是一个新的 先进的进化过程"
  },
  {
    "start": 915.61,
    "end": 919.17,
    "text": "将用于即将到来的黄金时代"
  },
  {
    "start": 919.55,
    "end": 921.29,
    "text": "人类已经准备好"
  },
  {
    "start": 921.29,
    "end": 923.8,
    "text": "在意识上迈出巨大的步伐"
  },
  {
    "start": 923.8,
    "end": 926.83,
    "text": "在每个人的灵魂旅程中"
  },
  {
    "start": 926.83,
    "end": 928.93,
    "text": "某个时刻 都会有一种"
  },
  {
    "start": 928.93,
    "end": 931.92,
    "text": "渴望回归到 更高领域的心愿"
  },
  {
    "start": 931.92,
    "end": 935.57,
    "text": "这种神圣的不满足感 正在滋生"
  },
  {
    "start": 935.57,
    "end": 937.79,
    "text": "无法被忽视"
  },
  {
    "start": 937.79,
    "end": 939.15,
    "text": "首先"
  },
  {
    "start": 939.15,
    "end": 942.31,
    "text": "你必须意识到你良知的微妙声音"
  },
  {
    "start": 942.31,
    "end": 945.88,
    "text": "当你开始关注灵性的召唤时"
  },
  {
    "start": 945.88,
    "end": 947.34,
    "text": "你之灵魂的低语"
  },
  {
    "start": 947.34,
    "end": 951.19,
    "text": "将变得越来越清晰和更加与众不同"
  },
  {
    "start": 951.19,
    "end": 958.57,
    "text": "当你调谐到具有更高振动模式的人 地方 思想和行为时"
  },
  {
    "start": 958.57,
    "end": 961.85,
    "text": "你的感觉天性 就会变得更加敏感"
  },
  {
    "start": 961.85,
    "end": 963.23,
    "text": "最终"
  },
  {
    "start": 963.23,
    "end": 966.54,
    "text": "你将学会区分 你的灵魂家族"
  },
  {
    "start": 966.54,
    "end": 970.08,
    "text": "以及不同大师 和天使存有的 灵魂之歌"
  },
  {
    "start": 970.08,
    "end": 972.12,
    "text": "的振动模式"
  },
  {
    "start": 972.12,
    "end": 973.34,
    "text": "是的"
  },
  {
    "start": 973.34,
    "end": 976.72,
    "text": "人类正处于剧烈的变化之中"
  },
  {
    "start": 976.72,
    "end": 979.2,
    "text": "这是一个意义深远的进化过程"
  },
  {
    "start": 979.2,
    "end": 981.04,
    "text": "但请记住"
  },
  {
    "start": 981.04,
    "end": 984.86,
    "text": "这只是永无止境的 螺旋的一部分"
  },
  {
    "start": 984.86,
    "end": 988.56,
    "text": "所有正在觉醒至神性意识的人"
  },
  {
    "start": 988.56,
    "end": 990.96,
    "text": "都经历了这个宇宙中各种重"
  },
  {
    "start": 990.96,
    "end": 992.27,
    "text": "要的过渡过程"
  },
  {
    "start": 992.27,
    "end": 993.88,
    "text": "请注意"
  },
  {
    "start": 993.88,
    "end": 996.52,
    "text": "你们不再被允许停滞不前"
  },
  {
    "start": 996.52,
    "end": 999.89,
    "text": "甚至不能长时间停留在某个层面——"
  },
  {
    "start": 999.89,
    "end": 1003.33,
    "text": "因为时间和转变过程进展得太快了"
  },
  {
    "start": 1003.33,
    "end": 1005.71,
    "text": "你们的语言在变化"
  },
  {
    "start": 1005.71,
    "end": 1008.1,
    "text": "你们的思维方式也不同了"
  },
  {
    "start": 1008.1,
    "end": 1012.41,
    "text": "人类大脑中 记录过去的旧区域"
  },
  {
    "start": 1012.41,
    "end": 1015.63,
    "text": "正在逐渐被精炼 或溶解"
  },
  {
    "start": 1015.63,
    "end": 1019.89,
    "text": "这是为什么你们开始感觉 以前发生的一切"
  },
  {
    "start": 1019.89,
    "end": 1022.37,
    "text": "甚至是去年发生的事"
  },
  {
    "start": 1022.37,
    "end": 1025.23,
    "text": "似乎都是一场模糊的梦"
  },
  {
    "start": 1025.23,
    "end": 1029.65,
    "text": "你们大脑中的新区域 正在被激活"
  },
  {
    "start": 1029.65,
    "end": 1030.93,
    "text": "你必须学会 用"
  },
  {
    "start": 1030.93,
    "end": 1031.45,
    "text": "全新"
  },
  {
    "start": 1031.45,
    "end": 1034.56,
    "text": "的方式思考"
  },
  {
    "start": 1034.56,
    "end": 1038.29,
    "text": "辨别力"
  },
  {
    "start": 1038.29,
    "end": 1038.77,
    "text": "辨别"
  },
  {
    "start": 1039.57,
    "end": 1041.52,
    "text": "辨别力"
  },
  {
    "start": 1041.52,
    "end": 1043.56,
    "text": "光的信息包"
  },
  {
    "start": 1043.56,
    "end": 1046.46,
    "text": "具有重要意义的全息图像"
  },
  {
    "start": 1046.46,
    "end": 1050.74,
    "text": "以及神圣几何图案 将开始渗入你的意识"
  },
  {
    "start": 1050.74,
    "end": 1051.58,
    "text": "你必须学会"
  },
  {
    "start": 1051.58,
    "end": 1053.85,
    "text": "如何解读它们"
  },
  {
    "start": 1053.85,
    "end": 1056.96,
    "text": "你可能会感觉那些你正在超越的人"
  },
  {
    "start": 1056.96,
    "end": 1058.56,
    "text": "不再理解你"
  },
  {
    "start": 1058.56,
    "end": 1061.22,
    "text": "或者你无法找到合适的词语"
  },
  {
    "start": 1061.22,
    "end": 1064.37,
    "text": "来继续旧有的 日常对话模式"
  },
  {
    "start": 1064.37,
    "end": 1066.27,
    "text": "你还会发现"
  },
  {
    "start": 1066.27,
    "end": 1068.72,
    "text": "当你开始用心灵感应的方式"
  },
  {
    "start": 1068.72,
    "end": 1072.01,
    "text": "接收周围人的能量和思想时"
  },
  {
    "start": 1072.01,
    "end": 1075.23,
    "text": "你不再需要用言语表达每一个想法"
  },
  {
    "start": 1075.23,
    "end": 1077.77,
    "text": "你的直觉力会增强"
  },
  {
    "start": 1077.77,
    "end": 1079.68,
    "text": "你不会轻易被欺骗"
  },
  {
    "start": 1079.68,
    "end": 1083.9,
    "text": "你将以灵性的正直说出你的真相"
  },
  {
    "start": 1083.9,
    "end": 1085.53,
    "text": "并不愿再参与 过"
  },
  {
    "start": 1085.53,
    "end": 1087.94,
    "text": "去的负面游戏"
  },
  {
    "start": 1087.94,
    "end": 1089.85,
    "text": "我们恳请你们"
  },
  {
    "start": 1089.85,
    "end": 1095.49,
    "text": "不要执着于 任何一种存在方式 任何一种模式"
  },
  {
    "start": 1095.49,
    "end": 1098.82,
    "text": "或过于狭隘 和固定的思想体系"
  },
  {
    "start": 1098.82,
    "end": 1100.01,
    "text": "此外"
  },
  {
    "start": 1100.01,
    "end": 1103.89,
    "text": "不要接受任何 将你的力量与自主权"
  },
  {
    "start": 1103.89,
    "end": 1104.39,
    "text": "交付"
  },
  {
    "start": 1104.39,
    "end": 1106.64,
    "text": "于他人的协议"
  },
  {
    "start": 1106.64,
    "end": 1108.37,
    "text": "辨别力"
  },
  {
    "start": 1108.37,
    "end": 1109.65,
    "text": "辨别力"
  },
  {
    "start": 1109.65,
    "end": 1111.6,
    "text": "辨别力"
  },
  {
    "start": 1111.6,
    "end": 1115.43,
    "text": "我们再怎么强调这一点也不为过"
  },
  {
    "start": 1115.43,
    "end": 1120.85,
    "text": "因为当一个表面上的真理出现并被你纳入信念体系时"
  },
  {
    "start": 1120.85,
    "end": 1123.16,
    "text": "它可能很快会被更高的真理"
  },
  {
    "start": 1123.16,
    "end": 1125.33,
    "text": "或新的概念所取代"
  },
  {
    "start": 1125.33,
    "end": 1127.05,
    "text": "回顾过去"
  },
  {
    "start": 1127.05,
    "end": 1128.78,
    "text": "你是否注意到"
  },
  {
    "start": 1128.78,
    "end": 1132.34,
    "text": "许多你现在接受为绝对真理的知识"
  },
  {
    "start": 1132.34,
    "end": 1133.49,
    "text": "在十年前"
  },
  {
    "start": 1133.49,
    "end": 1135.31,
    "text": "甚至六个月前"
  },
  {
    "start": 1135.31,
    "end": 1136.96,
    "text": "都是你无法想象的"
  },
  {
    "start": 1136.96,
    "end": 1138.46,
    "text": "请意识到"
  },
  {
    "start": 1138.46,
    "end": 1141.43,
    "text": "许多你今天深信不疑的事情"
  },
  {
    "start": 1141.43,
    "end": 1143.51,
    "text": "在明天或不久的将来可"
  },
  {
    "start": 1143.51,
    "end": 1145.74,
    "text": "能会发生改变"
  },
  {
    "start": 1145.74,
    "end": 1147.94,
    "text": "从精神上讲"
  },
  {
    "start": 1147.94,
    "end": 1152.38,
    "text": "新思想和新概念正在不断冲击你的意识"
  },
  {
    "start": 1152.38,
    "end": 1155.64,
    "text": "起初这些想法是模糊的"
  },
  {
    "start": 1155.64,
    "end": 1158.65,
    "text": "但随着你运用增强的推理能力"
  },
  {
    "start": 1158.65,
    "end": 1164.17,
    "text": "逐步展开和解码 未来的公式 理论 和创新发明"
  },
  {
    "start": 1164.17,
    "end": 1166.97,
    "text": "它们会逐渐变得清晰"
  },
  {
    "start": 1166.97,
    "end": 1170.86,
    "text": "当你进入第五维度的更高层面时"
  },
  {
    "start": 1170.86,
    "end": 1173.16,
    "text": "你将开始忆起 这个子宇宙的"
  },
  {
    "start": 1173.16,
    "end": 1175.48,
    "text": "创造蓝图的各个方面——"
  },
  {
    "start": 1175.48,
    "end": 1180.54,
    "text": "包括如何保持纯粹的思想直到它显化成现实"
  },
  {
    "start": 1180.54,
    "end": 1184.96,
    "text": "也包括你如何协助创造各种奇妙的事物"
  },
  {
    "start": 1184.96,
    "end": 1189.73,
    "text": "当你超越时间与空间进入光之领域时"
  },
  {
    "start": 1189.73,
    "end": 1191.8,
    "text": "你们中的许多人将开始看到"
  },
  {
    "start": 1191.8,
    "end": 1194.87,
    "text": "几何图形 闪闪发光的水晶"
  },
  {
    "start": 1194.87,
    "end": 1197.37,
    "text": "和绚丽的新色彩"
  },
  {
    "start": 1197.37,
    "end": 1199.55,
    "text": "我们告诉过你们"
  },
  {
    "start": 1199.55,
    "end": 1204.04,
    "text": "许多特殊的恩赐将赋予那些勇敢站出来"
  },
  {
    "start": 1204.04,
    "end": 1206.13,
    "text": "并主张他们遗产的人"
  },
  {
    "start": 1206.13,
    "end": 1208.0,
    "text": "就是现在"
  },
  {
    "start": 1208.0,
    "end": 1210.56,
    "text": "随着大众的觉醒 并开始呼吁"
  },
  {
    "start": 1210.56,
    "end": 1214.24,
    "text": "援助 解决方案 信息 和鼓励"
  },
  {
    "start": 1214.24,
    "end": 1216.15,
    "text": "我的勇士们"
  },
  {
    "start": 1216.15,
    "end": 1220.01,
    "text": "你们比以往任何时候 都更为重要"
  },
  {
    "start": 1220.01,
    "end": 1223.16,
    "text": "我们正等待着赋予你们力量"
  },
  {
    "start": 1223.16,
    "end": 1224.46,
    "text": "超乎想象的智"
  },
  {
    "start": 1224.46,
    "end": 1225.26,
    "text": "慧"
  },
  {
    "start": 1225.26,
    "end": 1227.05,
    "text": "能力 和知识"
  },
  {
    "start": 1227.05,
    "end": 1228.05,
    "text": "442 00:20:29,050 --> 00:20:31,900 ・提升大脑潜力"
  },
  {
    "start": 1231.9,
    "end": 1237.14,
    "text": "你们的大脑实际上一直以 100% 的容量运作"
  },
  {
    "start": 1237.14,
    "end": 1240.01,
    "text": "这可能会让你感到惊讶"
  },
  {
    "start": 1240.01,
    "end": 1241.41,
    "text": "因为你可能听说过"
  },
  {
    "start": 1241.41,
    "end": 1242.61,
    "text": "普通人只使用了"
  },
  {
    "start": 1242.61,
    "end": 1245.72,
    "text": "大约 10%的大脑脑力"
  },
  {
    "start": 1245.72,
    "end": 1248.43,
    "text": "在20世纪中期以前"
  },
  {
    "start": 1248.43,
    "end": 1252.44,
    "text": "大多数人只被允许访问大脑的有限部分——"
  },
  {
    "start": 1252.44,
    "end": 1255.77,
    "text": "那些部分是与第三 和第四维度较低层"
  },
  {
    "start": 1255.77,
    "end": 1258.15,
    "text": "面 产生共振的频率"
  },
  {
    "start": 1258.15,
    "end": 1260.91,
    "text": "受到限制的是心智"
  },
  {
    "start": 1260.91,
    "end": 1263.06,
    "text": "而不是大脑"
  },
  {
    "start": 1263.06,
    "end": 1267.19,
    "text": "当你平衡 并整合更高频率时"
  },
  {
    "start": 1267.19,
    "end": 1270.58,
    "text": "你将获得对你神圣心智的访问权"
  },
  {
    "start": 1270.58,
    "end": 1277.79,
    "text": "其中包含更多的大脑潜力 （即 记忆种子原子, 它携带着你其他转世经历中的"
  },
  {
    "start": 1277.79,
    "end": 1280.55,
    "text": "特殊天赋 属性和品质）"
  },
  {
    "start": 1280.55,
    "end": 1284.63,
    "text": "这就是你如何获取更高第四维度和第五"
  },
  {
    "start": 1284.63,
    "end": 1286.83,
    "text": "维度宇宙智慧的方式"
  },
  {
    "start": 1286.83,
    "end": 1290.58,
    "text": "一些高级灵魂甚至已经开始接触"
  },
  {
    "start": 1290.58,
    "end": 1292.92,
    "text": "第六维度的入门级别"
  },
  {
    "start": 1292.92,
    "end": 1296.68,
    "text": "只有当你协调到那些精细的频率时"
  },
  {
    "start": 1296.68,
    "end": 1300.2,
    "text": "才能访问这些高级的大脑区域"
  },
  {
    "start": 1300.2,
    "end": 1304.36,
    "text": "当前的主要目标是提升你的振动频率"
  },
  {
    "start": 1304.36,
    "end": 1308.54,
    "text": "以达到必要的水平来清除保护你的光膜——"
  },
  {
    "start": 1308.54,
    "end": 1313.55,
    "text": "这些光膜存在于你神圣心智和神圣心灵的门户"
  },
  {
    "start": 1313.55,
    "end": 1316.35,
    "text": "以及大脑结构的第五维度层面"
  },
  {
    "start": 1316.35,
    "end": 1318.07,
    "text": "直到那时"
  },
  {
    "start": 1318.07,
    "end": 1319.43,
    "text": "你才真正开始在你"
  },
  {
    "start": 1319.43,
    "end": 1319.74,
    "text": "的灵"
  },
  {
    "start": 1319.74,
    "end": 1321.91,
    "text": "性探索中取得进展"
  },
  {
    "start": 1321.91,
    "end": 1322.91,
    "text": "473 00:22:03,910 --> 00:22:07,410 起起伏伏的扬升过程"
  },
  {
    "start": 1327.41,
    "end": 1329.1,
    "text": "请注意"
  },
  {
    "start": 1329.1,
    "end": 1331.13,
    "text": "扬升过程有起有落"
  },
  {
    "start": 1331.13,
    "end": 1332.76,
    "text": "周期性地"
  },
  {
    "start": 1332.76,
    "end": 1336.42,
    "text": "会有强大的 新的高频宇宙射线——"
  },
  {
    "start": 1336.42,
    "end": 1339.13,
    "text": "承载着水瓶座时代的神圣蓝图——"
  },
  {
    "start": 1339.13,
    "end": 1340.64,
    "text": "轰击地球"
  },
  {
    "start": 1340.64,
    "end": 1342.4,
    "text": "并在中间有一段安静的"
  },
  {
    "start": 1342.4,
    "end": 1343.21,
    "text": "时间"
  },
  {
    "start": 1343.21,
    "end": 1345.67,
    "text": "以避免能量过载"
  },
  {
    "start": 1345.67,
    "end": 1347.03,
    "text": "扬升"
  },
  {
    "start": 1347.03,
    "end": 1349.81,
    "text": "并非一个稳定向前的运动过程"
  },
  {
    "start": 1349.81,
    "end": 1354.22,
    "text": "而是先有新能量 和新信息的涌入"
  },
  {
    "start": 1354.22,
    "end": 1356.83,
    "text": "然后是同化 整合"
  },
  {
    "start": 1356.83,
    "end": 1360.1,
    "text": "和显化 的周期性活动"
  },
  {
    "start": 1360.1,
    "end": 1362.25,
    "text": "在此过程中"
  },
  {
    "start": 1362.25,
    "end": 1366.13,
    "text": "许多感觉可能对你来说显得更为强烈"
  },
  {
    "start": 1366.13,
    "end": 1368.6,
    "text": "你有时可能会感到自己"
  },
  {
    "start": 1368.6,
    "end": 1370.54,
    "text": "跳入了未知的深渊"
  },
  {
    "start": 1370.54,
    "end": 1372.93,
    "text": "或退回到不确定的境地"
  },
  {
    "start": 1372.93,
    "end": 1374.76,
    "text": "另一些时候"
  },
  {
    "start": 1374.76,
    "end": 1378.23,
    "text": "你可能会感到一种强烈的脆弱感"
  },
  {
    "start": 1378.23,
    "end": 1380.16,
    "text": "到目前为止"
  },
  {
    "start": 1380.16,
    "end": 1381.65,
    "text": "你应该已经适应了"
  },
  {
    "start": 1381.65,
    "end": 1385.31,
    "text": "放大 和加速的频率 起起伏伏"
  },
  {
    "start": 1385.31,
    "end": 1386.66,
    "text": "然而"
  },
  {
    "start": 1386.66,
    "end": 1390.51,
    "text": "当你被推动到 下一个意识水平时"
  },
  {
    "start": 1390.51,
    "end": 1392.49,
    "text": "这些振动频率通常会在"
  },
  {
    "start": 1392.49,
    "end": 1395.64,
    "text": "你的身体 心智体    和情绪"
  },
  {
    "start": 1395.64,
    "end": 1396.49,
    "text": "体内"
  },
  {
    "start": 1396.49,
    "end": 1398.12,
    "text": "引发不同程度的反"
  },
  {
    "start": 1398.12,
    "end": 1400.4,
    "text": "应"
  },
  {
    "start": 1402.4,
    "end": 1405.6,
    "text": "进化的抉择时刻"
  },
  {
    "start": 1405.6,
    "end": 1406.87,
    "text": "现在"
  },
  {
    "start": 1406.87,
    "end": 1409.26,
    "text": "是你做决定的时刻"
  },
  {
    "start": 1409.26,
    "end": 1412.09,
    "text": "因为这是一个灵魂收割的时代"
  },
  {
    "start": 1412.09,
    "end": 1414.82,
    "text": "每个人必须决定 是否愿意"
  },
  {
    "start": 1414.82,
    "end": 1416.54,
    "text": "跟随地球 一起"
  },
  {
    "start": 1416.54,
    "end": 1419.18,
    "text": "进入更高维度的频率"
  },
  {
    "start": 1419.18,
    "end": 1421.01,
    "text": "或者转移到另一个"
  },
  {
    "start": 1421.01,
    "end": 1422.87,
    "text": "已回到最初设计光谱的"
  },
  {
    "start": 1422.87,
    "end": 1425.64,
    "text": "第三/第四维度行星——"
  },
  {
    "start": 1425.64,
    "end": 1427.21,
    "text": "在那里继续完成他们在"
  },
  {
    "start": 1427.21,
    "end": 1429.77,
    "text": "二元性和极性领域中的课程"
  },
  {
    "start": 1429.77,
    "end": 1433.66,
    "text": "许多灵魂将选择离开地球层面"
  },
  {
    "start": 1433.66,
    "end": 1437.09,
    "text": "这是他们的契约和神圣使命的一部分"
  },
  {
    "start": 1437.09,
    "end": 1438.6,
    "text": "同时"
  },
  {
    "start": 1438.6,
    "end": 1440.68,
    "text": "许多其他美丽的灵魂"
  },
  {
    "start": 1440.68,
    "end": 1442.87,
    "text": "也正在被安排或准备好"
  },
  {
    "start": 1442.87,
    "end": 1445.92,
    "text": "担任具备决策权和影响力的角色"
  },
  {
    "start": 1445.92,
    "end": 1448.32,
    "text": "他们会保持低调"
  },
  {
    "start": 1448.32,
    "end": 1450.02,
    "text": "可能在幕后"
  },
  {
    "start": 1450.02,
    "end": 1454.45,
    "text": "直到时机成熟才会站出来让公众知道"
  },
  {
    "start": 1454.45,
    "end": 1458.28,
    "text": "他们将充满活力 具有影响力"
  },
  {
    "start": 1458.28,
    "end": 1460.89,
    "text": "并为人类带来新愿景——"
  },
  {
    "start": 1460.89,
    "end": 1463.68,
    "text": "这一愿景将服务于所有人"
  },
  {
    "start": 1463.68,
    "end": 1466.84,
    "text": "为即将到来的新时代奠定基础"
  },
  {
    "start": 1466.84,
    "end": 1468.03,
    "text": "因此"
  },
  {
    "start": 1468.03,
    "end": 1469.92,
    "text": "我们会对你们说 亲"
  },
  {
    "start": 1469.92,
    "end": 1470.54,
    "text": "爱的"
  },
  {
    "start": 1470.54,
    "end": 1471.58,
    "text": "保持稳定"
  },
  {
    "start": 1471.58,
    "end": 1472.85,
    "text": "坚持不懈"
  },
  {
    "start": 1472.85,
    "end": 1476.15,
    "text": "现在是寻求个人真理的时刻"
  },
  {
    "start": 1476.15,
    "end": 1480.09,
    "text": "是重新掌控和主宰你们世界的时刻"
  },
  {
    "start": 1480.09,
    "end": 1483.32,
    "text": "也是忆起你们作为造物主的代表"
  },
  {
    "start": 1483.32,
    "end": 1485.84,
    "text": "肩负着一个重要使命——"
  },
  {
    "start": 1485.84,
    "end": 1487.7,
    "text": "人类与地球的进化"
  },
  {
    "start": 1487.7,
    "end": 1491.89,
    "text": "请接受你们作为共同创造大师的力量"
  },
  {
    "start": 1491.89,
    "end": 1495.05,
    "text": "整合并激活你们内在潜藏的天赋"
  },
  {
    "start": 1495.05,
    "end": 1496.53,
    "text": "亲爱的"
  },
  {
    "start": 1496.53,
    "end": 1499.76,
    "text": "如果你被引导接触到我们当前的教义"
  },
  {
    "start": 1499.76,
    "end": 1501.98,
    "text": "却发现它们难以理解"
  },
  {
    "start": 1501.98,
    "end": 1503.53,
    "text": "请不要灰心"
  },
  {
    "start": 1503.53,
    "end": 1505.89,
    "text": "我们的许多光之使者"
  },
  {
    "start": 1505.89,
    "end": 1507.0,
    "text": "一直不知疲倦地"
  },
  {
    "start": 1507.0,
    "end": 1509.78,
    "text": "努力传递我们的智慧教义"
  },
  {
    "start": 1509.78,
    "end": 1512.92,
    "text": "这些教义涵盖了从基本的灵性原则"
  },
  {
    "start": 1512.92,
    "end": 1515.27,
    "text": "到许多中级层次"
  },
  {
    "start": 1515.27,
    "end": 1517.81,
    "text": "再到当前的高级宇宙教义"
  },
  {
    "start": 1517.81,
    "end": 1522.73,
    "text": "如果你去寻找和研究这些过去的教义信息"
  },
  {
    "start": 1522.73,
    "end": 1527.12,
    "text": "你将能够找到适合你当前理解水平的内容"
  },
  {
    "start": 1527.12,
    "end": 1528.04,
    "text": "并且你可以在"
  },
  {
    "start": 1528.04,
    "end": 1531.59,
    "text": "这个基础上继续前进和深入学习"
  },
  {
    "start": 1531.59,
    "end": 1535.16,
    "text": "人类的进化过程正在全速推进"
  },
  {
    "start": 1535.16,
    "end": 1537.58,
    "text": "以惊人的速度向前发展"
  },
  {
    "start": 1537.58,
    "end": 1538.99,
    "text": "亲爱的"
  },
  {
    "start": 1538.99,
    "end": 1542.2,
    "text": "请敞开你们的思想和心灵"
  },
  {
    "start": 1542.2,
    "end": 1545.75,
    "text": "拥抱即将到来的神圣之爱与光的注入"
  },
  {
    "start": 1545.75,
    "end": 1550.78,
    "text": "在我们一起迈向这段不可思议的新现实的旅程时"
  },
  {
    "start": 1550.78,
    "end": 1554.09,
    "text": "与我们一起享受重聚的荣耀"
  },
  {
    "start": 1554.09,
    "end": 1556.88,
    "text": "我们始终与你们同在"
  },
  {
    "start": 1556.88,
    "end": 1559.43,
    "text": "你们被深深地爱着"
  },
  {
    "start": 1560.33,
    "end": 1560.392,
    "text": "天"
  }
]