[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "光之信息"
  },
  {
    "start": 6.04,
    "end": 9.95,
    "text": "来自大天使MICHAEL的智慧教导"
  },
  {
    "start": 9.95,
    "end": 14.88,
    "text": "引用自《自我掌控的秘密 扬升的钥匙》"
  },
  {
    "start": 14.88,
    "end": 17.38,
    "text": "和《提升人类的魔力与威严》"
  },
  {
    "start": 17.38,
    "end": 20.649,
    "text": "神圣抄写员Ronna Vezane"
  },
  {
    "start": 20.65,
    "end": 23.2,
    "text": "翻译 / 解读 暮雨"
  },
  {
    "start": 23.2,
    "end": 24.2,
    "text": "亲爱的大师们"
  },
  {
    "start": 26.35,
    "end": 29.44,
    "text": "你们中的许多人 感觉自己 正置身于"
  },
  {
    "start": 29.44,
    "end": 33.99,
    "text": "一场 漫长而艰难的比赛 最后冲刺阶段"
  },
  {
    "start": 33.99,
    "end": 37.41,
    "text": "而你们的精力和热情正在减退"
  },
  {
    "start": 37.41,
    "end": 40.09,
    "text": "你们对于世俗生活的诱惑力"
  },
  {
    "start": 40.09,
    "end": 42.25,
    "text": "越来越感到厌倦"
  },
  {
    "start": 42.25,
    "end": 44.38,
    "text": "曾经让你们兴奋的事物"
  },
  {
    "start": 44.38,
    "end": 46.47,
    "text": "似乎变得黯淡无光"
  },
  {
    "start": 46.47,
    "end": 49.45,
    "text": "这是因为你们正同时存在于"
  },
  {
    "start": 49.45,
    "end": 52.97,
    "text": "两个截然不同的现实 或多个维度"
  },
  {
    "start": 52.97,
    "end": 55.09,
    "text": "并在其间来回转换"
  },
  {
    "start": 55.09,
    "end": 57.07,
    "text": "你们中许多人"
  },
  {
    "start": 57.07,
    "end": 59.55,
    "text": "已经准备好 实现量子飞跃"
  },
  {
    "start": 59.55,
    "end": 61.61,
    "text": "进入第五维度意识"
  },
  {
    "start": 61.61,
    "end": 66.55,
    "text": "你们的旧世界（存在状态）  正在迅速消失"
  },
  {
    "start": 66.55,
    "end": 68.51,
    "text": "其速度远远快于"
  },
  {
    "start": 68.51,
    "end": 70.84,
    "text": "你们整合新存在状态中的"
  },
  {
    "start": 70.84,
    "end": 73.13,
    "text": "精炼能量和观念的速度"
  },
  {
    "start": 73.13,
    "end": 77.51,
    "text": "当你们意识到宇宙层面正在发生的事"
  },
  {
    "start": 77.51,
    "end": 79.79,
    "text": "就不会对当前的地球局势"
  },
  {
    "start": 79.79,
    "end": 81.85,
    "text": "感到那么紧张和困惑"
  },
  {
    "start": 81.85,
    "end": 83.73,
    "text": "请相信我们"
  },
  {
    "start": 83.73,
    "end": 85.45,
    "text": "解脱即将来临"
  },
  {
    "start": 85.45,
    "end": 90.63,
    "text": "我们最大的愿望之一是协助你们完成这个过程"
  },
  {
    "start": 90.63,
    "end": 93.6,
    "text": "使你们的过渡能够轻松优雅地完成"
  },
  {
    "start": 93.6,
    "end": 95.82,
    "text": "在过去的许多年里"
  },
  {
    "start": 95.82,
    "end": 99.91,
    "text": "我们提供了大量信息 冥想和练习"
  },
  {
    "start": 99.91,
    "end": 102.7,
    "text": "帮助转化旧的消极能量模式"
  },
  {
    "start": 102.7,
    "end": 105.5,
    "text": "这一转化过程是必要的"
  },
  {
    "start": 105.5,
    "end": 107.58,
    "text": "以便四个较低身体"
  },
  {
    "start": 107.58,
    "end": 109.8,
    "text": "也是四个较低意识系统"
  },
  {
    "start": 109.8,
    "end": 112.19,
    "text": "能够更好地吸收和整合"
  },
  {
    "start": 112.19,
    "end": 115.21,
    "text": "造物主之光的纯净细胞 ——"
  },
  {
    "start": 115.21,
    "end": 117.27,
    "text": "它们是一种新的光芒"
  },
  {
    "start": 117.27,
    "end": 120.32,
    "text": "来自至高无上的造物主 散发的"
  },
  {
    "start": 120.32,
    "end": 124.47,
    "text": "更高频率 更强大的个性化表达"
  },
  {
    "start": 124.85,
    "end": 127.44,
    "text": "光之金字塔  是为帮助你"
  },
  {
    "start": 127.44,
    "end": 130.09,
    "text": "接收造物主之光而存在的"
  },
  {
    "start": 130.09,
    "end": 132.7,
    "text": "下面我们将分别阐释"
  },
  {
    "start": 132.7,
    "end": 135.78,
    "text": "光之金字塔的不同种类及用途"
  },
  {
    "start": 135.78,
    "end": 140.27,
    "text": "以及光之金字塔冥想的具体步骤 和冥想建议"
  },
  {
    "start": 140.27,
    "end": 143.09,
    "text": "希望帮助你们提升冥想效果"
  },
  {
    "start": 143.09,
    "end": 145.09,
    "text": "51 00:02:25,090 --> 00:02:27,920 你的个人金字塔"
  },
  {
    "start": 147.92,
    "end": 151.06,
    "text": "每个投生在地球上的灵魂"
  },
  {
    "start": 151.06,
    "end": 153.69,
    "text": "在第五维度的第一个子层次"
  },
  {
    "start": 153.69,
    "end": 156.78,
    "text": "都有一个 个人光之金字塔频道"
  },
  {
    "start": 156.78,
    "end": 160.39,
    "text": "当我们下降到第四和第三维度时"
  },
  {
    "start": 160.39,
    "end": 164.44,
    "text": "我们在那里留下了 神圣自我的以太复制体"
  },
  {
    "start": 164.44,
    "end": 166.55,
    "text": "静卧在一张水晶桌上"
  },
  {
    "start": 166.55,
    "end": 169.16,
    "text": "这个光之金字塔充当了"
  },
  {
    "start": 169.16,
    "end": 172.35,
    "text": "连接较低自我 与更高自我的功能"
  },
  {
    "start": 172.35,
    "end": 175.47,
    "text": "我们在地球上的四个较低自我"
  },
  {
    "start": 175.47,
    "end": 178.41,
    "text": "也是四个较低身体形态 包括"
  },
  {
    "start": 178.41,
    "end": 179.62,
    "text": "物质身体"
  },
  {
    "start": 179.62,
    "end": 182.29,
    "text": "情绪体 心智体和以太体"
  },
  {
    "start": 182.29,
    "end": 186.39,
    "text": "更高自我 是位于第五维度入门层次的"
  },
  {
    "start": 186.39,
    "end": 188.83,
    "text": "神圣三位一体"
  },
  {
    "start": 188.83,
    "end": 191.3,
    "text": "在神圣金字塔内"
  },
  {
    "start": 191.3,
    "end": 193.14,
    "text": "有我们的天使助手"
  },
  {
    "start": 193.14,
    "end": 196.47,
    "text": "以及我们位于更高领域的指导灵和老师"
  },
  {
    "start": 196.47,
    "end": 200.45,
    "text": "每次在冥想或睡眠期间前往那里时"
  },
  {
    "start": 200.45,
    "end": 203.78,
    "text": "我们都会将第五维度的 更多精炼频率"
  },
  {
    "start": 203.78,
    "end": 205.86,
    "text": "带回我们的物理身体中"
  },
  {
    "start": 205.86,
    "end": 210.26,
    "text": "我们可以去光之金字塔进行灵性练习"
  },
  {
    "start": 210.26,
    "end": 212.72,
    "text": "接受天国助手们的帮助"
  },
  {
    "start": 212.72,
    "end": 215.11,
    "text": "随着时间的推移"
  },
  {
    "start": 215.11,
    "end": 218.0,
    "text": "当个人的振动模式愈加精炼"
  },
  {
    "start": 218.0,
    "end": 220.95,
    "text": "我们将通过个人的光之金字塔"
  },
  {
    "start": 220.95,
    "end": 224.65,
    "text": "与世界金字塔 世界服务金字塔"
  },
  {
    "start": 224.65,
    "end": 228.11,
    "text": "以及第六维度 第一个子层次内的光之城"
  },
  {
    "start": 228.11,
    "end": 229.47,
    "text": "建立连接"
  },
  {
    "start": 229.47,
    "end": 232.97,
    "text": "（注 有多个光之城）"
  },
  {
    "start": 232.97,
    "end": 235.64,
    "text": "在你的个人金字塔中"
  },
  {
    "start": 235.64,
    "end": 239.36,
    "text": "只有你的指导灵与守护者与你在一起"
  },
  {
    "start": 239.36,
    "end": 242.44,
    "text": "这是你的私人圣殿/ 庇护所"
  },
  {
    "start": 242.44,
    "end": 246.84,
    "text": "你也可以创造其他特殊功能的光之金字塔"
  },
  {
    "start": 246.84,
    "end": 249.4,
    "text": "例如工作/项目金字塔"
  },
  {
    "start": 249.4,
    "end": 250.55,
    "text": "团队金字塔"
  },
  {
    "start": 250.55,
    "end": 252.84,
    "text": "和灵魂家族金字塔"
  },
  {
    "start": 253.22,
    "end": 253.73,
    "text": "暮雨·注"
  },
  {
    "start": 253.73,
    "end": 257.3,
    "text": "这里没有明确说明光之金字塔的结构"
  },
  {
    "start": 257.3,
    "end": 260.46,
    "text": "暮雨推测根据神圣三位一体"
  },
  {
    "start": 260.46,
    "end": 263.69,
    "text": "光之金字塔应该是一个正四面体"
  },
  {
    "start": 263.69,
    "end": 265.69,
    "text": "94 00:04:25,690 --> 00:04:29,510 创建各种功能的光之金字塔"
  },
  {
    "start": 269.51,
    "end": 271.39,
    "text": "如果你愿意"
  },
  {
    "start": 271.39,
    "end": 274.66,
    "text": "你可以利用你的个人金字塔进行通灵"
  },
  {
    "start": 274.66,
    "end": 278.55,
    "text": "或者你可以为此目的专门创建一个金字塔"
  },
  {
    "start": 278.55,
    "end": 280.59,
    "text": "当你这样做时"
  },
  {
    "start": 280.59,
    "end": 284.98,
    "text": "邀请你的指导灵 老师和天使朋友们加入你"
  },
  {
    "start": 284.98,
    "end": 289.53,
    "text": "这个个人金字塔将由适当的频率组成"
  },
  {
    "start": 289.53,
    "end": 292.5,
    "text": "并调谐到你所设想的具体项目上"
  },
  {
    "start": 292.5,
    "end": 294.2,
    "text": "请记住"
  },
  {
    "start": 294.2,
    "end": 297.17,
    "text": "你可以建造任意数量的光之金字塔"
  },
  {
    "start": 297.17,
    "end": 298.62,
    "text": "事实上"
  },
  {
    "start": 298.62,
    "end": 301.55,
    "text": "建造的金字塔越多越好"
  },
  {
    "start": 301.55,
    "end": 303.66,
    "text": "因为这样做你可以吸引到"
  },
  {
    "start": 303.66,
    "end": 306.72,
    "text": "适合的振动频率和天使助手们"
  },
  {
    "start": 306.72,
    "end": 308.74,
    "text": "来支持你的具体目标"
  },
  {
    "start": 308.74,
    "end": 311.32,
    "text": "天使王国也有专家"
  },
  {
    "start": 311.32,
    "end": 313.73,
    "text": "就像我们在地球上一样"
  },
  {
    "start": 313.73,
    "end": 316.28,
    "text": "这些天使 是代表上帝意识的"
  },
  {
    "start": 316.28,
    "end": 319.81,
    "text": "所有属性 美德 和品质的化身"
  },
  {
    "start": 319.81,
    "end": 322.51,
    "text": "它们在每个特定光芒的"
  },
  {
    "start": 322.51,
    "end": 324.66,
    "text": "大天使的指导下工作"
  },
  {
    "start": 324.66,
    "end": 327.44,
    "text": "你可以称它们为工蜂天使"
  },
  {
    "start": 327.44,
    "end": 330.43,
    "text": "工蜂天使的数量数以亿计"
  },
  {
    "start": 330.43,
    "end": 332.33,
    "text": "它们总是很热心"
  },
  {
    "start": 332.33,
    "end": 334.27,
    "text": "并随时准备帮助你"
  },
  {
    "start": 334.65,
    "end": 335.85,
    "text": "暮雨·注"
  },
  {
    "start": 335.85,
    "end": 340.16,
    "text": "我们在上一集 这个子宇宙的创造过程"
  },
  {
    "start": 340.16,
    "end": 342.28,
    "text": "提到过这些代表十二道光芒的"
  },
  {
    "start": 342.28,
    "end": 343.78,
    "text": "十二位大天使"
  },
  {
    "start": 343.78,
    "end": 347.76,
    "text": "在创造子宇宙中的作用"
  },
  {
    "start": 347.76,
    "end": 351.66,
    "text": "当你进入 你个人的光之金字塔"
  },
  {
    "start": 351.66,
    "end": 355.86,
    "text": "或为特定项目或任务建造的光之金字塔时"
  },
  {
    "start": 355.86,
    "end": 360.22,
    "text": "你就在你的光之圣殿打开了一条通道 ——"
  },
  {
    "start": 360.22,
    "end": 363.94,
    "text": "这使得造物主表达之光的 完整力量"
  },
  {
    "start": 363.94,
    "end": 367.72,
    "text": "多样性 和新的光谱能够流入"
  },
  {
    "start": 367.72,
    "end": 370.63,
    "text": "助你在自己的努力中取得成功"
  },
  {
    "start": 370.63,
    "end": 371.91,
    "text": "同时"
  },
  {
    "start": 371.91,
    "end": 376.15,
    "text": "你也打开了一扇 通往丰盛的个人门户"
  },
  {
    "start": 376.15,
    "end": 379.02,
    "text": "因为你创造了一个神圣空间"
  },
  {
    "start": 379.02,
    "end": 381.22,
    "text": "让造物主之光的金刚粒子"
  },
  {
    "start": 381.22,
    "end": 383.39,
    "text": "参与你的共同创造过程"
  },
  {
    "start": 383.39,
    "end": 384.87,
    "text": "请记住"
  },
  {
    "start": 384.87,
    "end": 387.6,
    "text": "我们曾多次告诉过你们"
  },
  {
    "start": 387.6,
    "end": 390.09,
    "text": "你们是共同创造的大师 ——"
  },
  {
    "start": 390.09,
    "end": 391.63,
    "text": "只是你们遗忘了"
  },
  {
    "start": 391.63,
    "end": 392.71,
    "text": "此外"
  },
  {
    "start": 392.71,
    "end": 393.95,
    "text": "请牢记"
  },
  {
    "start": 393.95,
    "end": 396.8,
    "text": "丰盛呈现的形式种类繁多"
  },
  {
    "start": 396.8,
    "end": 399.33,
    "text": "（并非只有金钱一种"
  },
  {
    "start": 399.33,
    "end": 400.96,
    "text": "请发挥你的想象力"
  },
  {
    "start": 400.96,
    "end": 401.96,
    "text": "）"
  },
  {
    "start": 401.96,
    "end": 403.28,
    "text": "最后"
  },
  {
    "start": 403.28,
    "end": 406.6,
    "text": "我们强烈建议你至少偶尔访问一下"
  },
  {
    "start": 406.6,
    "end": 409.37,
    "text": "照耀你所在地区的天国光之城"
  },
  {
    "start": 409.37,
    "end": 410.94,
    "text": "入睡前"
  },
  {
    "start": 410.94,
    "end": 414.23,
    "text": "自动进入你的个人光之金字塔"
  },
  {
    "start": 414.23,
    "end": 417.78,
    "text": "并请求在适当的时候带你前往光之城"
  },
  {
    "start": 417.78,
    "end": 419.78,
    "text": "153 00:06:59,780 --> 00:07:02,680 世界金字塔"
  },
  {
    "start": 422.68,
    "end": 427.14,
    "text": "位于第五维度 更高层次的世界金字塔"
  },
  {
    "start": 427.14,
    "end": 431.62,
    "text": "供任何希望通过 当前正在进行的扬升过程 ——"
  },
  {
    "start": 431.62,
    "end": 433.09,
    "text": "为全人类"
  },
  {
    "start": 433.09,
    "end": 436.15,
    "text": "也为地球及其所有生灵的最大利益"
  },
  {
    "start": 436.15,
    "end": 438.06,
    "text": "而工作的灵魂使用"
  },
  {
    "start": 438.06,
    "end": 441.7,
    "text": "在冥想期间或每晚的梦境旅行中"
  },
  {
    "start": 441.7,
    "end": 444.19,
    "text": "访问这座世界金字塔"
  },
  {
    "start": 444.19,
    "end": 445.87,
    "text": "便可以将其治愈能量"
  },
  {
    "start": 445.87,
    "end": 448.88,
    "text": "分享给地球及其居民"
  },
  {
    "start": 448.88,
    "end": 451.71,
    "text": "在世界的光之金字塔中"
  },
  {
    "start": 451.71,
    "end": 454.01,
    "text": "包含一个地球的以太复制品"
  },
  {
    "start": 454.01,
    "end": 455.67,
    "text": "和一把水晶椅"
  },
  {
    "start": 455.67,
    "end": 458.4,
    "text": "这个世界的全息复制品"
  },
  {
    "start": 458.4,
    "end": 461.68,
    "text": "会吸入来自造物主的光芒"
  },
  {
    "start": 461.68,
    "end": 464.5,
    "text": "然后呼出神圣无条件的爱"
  },
  {
    "start": 464.5,
    "end": 468.74,
    "text": "这种奇妙的能量随后被过滤或稀释"
  },
  {
    "start": 468.74,
    "end": 472.88,
    "text": "以便所有准备好 开放心灵中心的人接收"
  },
  {
    "start": 472.88,
    "end": 478.4,
    "text": "从而开启 他们成为银河系 灵性/人性生命体的过程"
  },
  {
    "start": 478.4,
    "end": 480.4,
    "text": "174 00:08:00,400 --> 00:08:03,500 世界服务金字塔"
  },
  {
    "start": 483.5,
    "end": 488.5,
    "text": "这座金字塔专为那些能量特征 或灵魂之歌"
  },
  {
    "start": 488.5,
    "end": 491.31,
    "text": "与第四维度中期或更高维度"
  },
  {
    "start": 491.31,
    "end": 493.56,
    "text": "产生共鸣的灵魂保留"
  },
  {
    "start": 493.56,
    "end": 496.94,
    "text": "它是一个复合结构的金字塔"
  },
  {
    "start": 496.94,
    "end": 499.99,
    "text": "内嵌有许多不同类型的小金字塔"
  },
  {
    "start": 499.99,
    "end": 504.74,
    "text": "世界服务金字塔是世界服务者们的会议地点"
  },
  {
    "start": 504.74,
    "end": 506.78,
    "text": "世界服务者可以到此"
  },
  {
    "start": 506.78,
    "end": 509.67,
    "text": "汇集和聚焦他们的灵性能量"
  },
  {
    "start": 509.67,
    "end": 513.47,
    "text": "以帮助提升地球及其居民的灵性频率"
  },
  {
    "start": 513.47,
    "end": 516.47,
    "text": "成为世界服务者的灵魂"
  },
  {
    "start": 516.47,
    "end": 518.97,
    "text": "首先关注的是群体意识"
  },
  {
    "start": 518.97,
    "end": 521.1,
    "text": "然后是合一意识"
  },
  {
    "start": 521.1,
    "end": 524.7,
    "text": "他们的目标是帮助尽可能多的灵魂"
  },
  {
    "start": 524.7,
    "end": 528.07,
    "text": "加速在扬升道路上的进步"
  },
  {
    "start": 528.07,
    "end": 529.34,
    "text": "此外"
  },
  {
    "start": 529.34,
    "end": 531.62,
    "text": "人类的世界服务金字塔"
  },
  {
    "start": 531.62,
    "end": 533.61,
    "text": "由四面体分形组成"
  },
  {
    "start": 533.61,
    "end": 537.36,
    "text": "你们太阳系内的大多数世界服务金字塔"
  },
  {
    "start": 537.36,
    "end": 540.02,
    "text": "包含64个四面体"
  },
  {
    "start": 540.02,
    "end": 541.53,
    "text": "然而整个银河系中的"
  },
  {
    "start": 541.53,
    "end": 544.15,
    "text": "复杂度数量各不相同"
  },
  {
    "start": 544.53,
    "end": 546.71,
    "text": "暮雨·注四面体分形"
  },
  {
    "start": 546.71,
    "end": 548.55,
    "text": "即将一个四面体分成"
  },
  {
    "start": 548.55,
    "end": 551.67,
    "text": "四个四面体和一个八面体"
  },
  {
    "start": 551.67,
    "end": 556.06,
    "text": "然后以同样的方式再次分割每个四面体"
  },
  {
    "start": 556.06,
    "end": 558.52,
    "text": "这个过程可以一直继续"
  },
  {
    "start": 558.52,
    "end": 561.12,
    "text": "这被称为分形结构"
  },
  {
    "start": 561.12,
    "end": 564.04,
    "text": "即无论在大尺度还是小尺度上"
  },
  {
    "start": 564.04,
    "end": 567.14,
    "text": "形状都具有自相似性"
  },
  {
    "start": 567.14,
    "end": 572.26,
    "text": "金字塔的中心有一个巨大的四面体金字塔光源"
  },
  {
    "start": 572.26,
    "end": 576.3,
    "text": "主体结构中遍布各种大大小小的金字塔"
  },
  {
    "start": 576.3,
    "end": 580.19,
    "text": "一些金字塔面向金字塔顶端"
  },
  {
    "start": 580.19,
    "end": 583.12,
    "text": "另一些则面朝下 然而"
  },
  {
    "start": 583.12,
    "end": 586.85,
    "text": "在更高的领域并没有这种区别"
  },
  {
    "start": 586.85,
    "end": 589.74,
    "text": "因为没有对上下的感知"
  },
  {
    "start": 589.74,
    "end": 594.17,
    "text": "关于这些在外层空间中的 奇妙路径站点"
  },
  {
    "start": 594.17,
    "end": 596.54,
    "text": "还有很多需要解释的地方"
  },
  {
    "start": 596.54,
    "end": 597.73,
    "text": "然而"
  },
  {
    "start": 597.73,
    "end": 602.09,
    "text": "我们此时可以向你传达的最重要的信息是"
  },
  {
    "start": 602.09,
    "end": 604.84,
    "text": "你们应当把加入世界服务的行列"
  },
  {
    "start": 604.84,
    "end": 607.18,
    "text": "视为一种莫大的荣耀"
  },
  {
    "start": 607.18,
    "end": 610.77,
    "text": "这也是你灵性进化过程中的一个里程碑"
  },
  {
    "start": 610.77,
    "end": 612.77,
    "text": "224 00:10:12,770 --> 00:10:15,830 光之金字塔冥想"
  },
  {
    "start": 615.83,
    "end": 617.9,
    "text": "亲爱的大师们"
  },
  {
    "start": 617.9,
    "end": 621.28,
    "text": "现在是时候释放 转化 和升级"
  },
  {
    "start": 621.28,
    "end": 624.25,
    "text": "旧有的限制性思维模式了"
  },
  {
    "start": 624.25,
    "end": 627.01,
    "text": "这些是你们在过去接受的观念"
  },
  {
    "start": 627.01,
    "end": 629.18,
    "text": "并造就了你的现实"
  },
  {
    "start": 629.18,
    "end": 633.19,
    "text": "如果你们愿意花一些时间冥想和沉思"
  },
  {
    "start": 633.19,
    "end": 638.11,
    "text": "回顾你们在第三和第四维度现实中 创造的模式"
  },
  {
    "start": 638.11,
    "end": 642.0,
    "text": "包括心智 情感 身体和以太层面"
  },
  {
    "start": 642.0,
    "end": 644.16,
    "text": "以及一些精神上的限制"
  },
  {
    "start": 644.16,
    "end": 646.63,
    "text": "你们很快就会发现"
  },
  {
    "start": 646.63,
    "end": 649.89,
    "text": "是时候释放那些束缚你们的联系"
  },
  {
    "start": 649.89,
    "end": 652.78,
    "text": "这样你们就能进入更高的意识层面"
  },
  {
    "start": 652.78,
    "end": 656.85,
    "text": "一个不断扩展 充满力量的世界"
  },
  {
    "start": 656.85,
    "end": 658.04,
    "text": "目前"
  },
  {
    "start": 658.04,
    "end": 664.33,
    "text": "你们的四个较低身体系统（物质身体 心智体 情绪体和以太体）"
  },
  {
    "start": 664.33,
    "end": 666.21,
    "text": "正试图 适应和赶上"
  },
  {
    "start": 666.21,
    "end": 668.46,
    "text": "你们的灵魂/灵性自我"
  },
  {
    "start": 668.46,
    "end": 670.99,
    "text": "这给你们的尘世之躯"
  },
  {
    "start": 670.99,
    "end": 673.46,
    "text": "带来了巨大的压力和负担"
  },
  {
    "start": 673.46,
    "end": 675.48,
    "text": "亲爱的朋友们"
  },
  {
    "start": 675.48,
    "end": 679.57,
    "text": "我们将为你们提供一种光之金字塔冥想方法"
  },
  {
    "start": 679.57,
    "end": 682.56,
    "text": "帮助你们快速而优雅地完成这个过程"
  },
  {
    "start": 682.56,
    "end": 685.29,
    "text": "通过这种冥想方式"
  },
  {
    "start": 685.29,
    "end": 687.67,
    "text": "可以访问你在这一轮进化中的"
  },
  {
    "start": 687.67,
    "end": 689.79,
    "text": "全部神圣潜能 ——"
  },
  {
    "start": 689.79,
    "end": 692.55,
    "text": "在第四维度的多个层次中"
  },
  {
    "start": 692.55,
    "end": 695.61,
    "text": "整合你所有余下的灵魂碎片 ——"
  },
  {
    "start": 695.61,
    "end": 697.53,
    "text": "那些等待了数亿年"
  },
  {
    "start": 697.53,
    "end": 701.02,
    "text": "才与你们重新建立联系的自我面向"
  },
  {
    "start": 701.02,
    "end": 704.15,
    "text": "我们在此为你们指引道路"
  },
  {
    "start": 704.15,
    "end": 706.38,
    "text": "但你必须主动采取步骤"
  },
  {
    "start": 706.38,
    "end": 707.89,
    "text": "完成整个过程"
  },
  {
    "start": 707.89,
    "end": 711.69,
    "text": "我们保证这一切将是值得付出努力的"
  },
  {
    "start": 711.69,
    "end": 713.69,
    "text": "261 00:11:53,690 --> 00:11:57,750 ・让我们 从物理身体开始"
  },
  {
    "start": 717.75,
    "end": 721.58,
    "text": "进入 你的个人光之金字塔"
  },
  {
    "start": 721.58,
    "end": 724.37,
    "text": "躺在 水晶桌上"
  },
  {
    "start": 724.37,
    "end": 728.26,
    "text": "你可以请求 健康与活力之光"
  },
  {
    "start": 728.26,
    "end": 731.73,
    "text": "辐射到 你的物质身体中"
  },
  {
    "start": 731.73,
    "end": 734.84,
    "text": "或者 其他特质的光芒"
  },
  {
    "start": 734.84,
    "end": 738.5,
    "text": "如美丽  青春"
  },
  {
    "start": 738.5,
    "end": 740.65,
    "text": "协调能力"
  },
  {
    "start": 740.65,
    "end": 744.02,
    "text": "意志力  力量"
  },
  {
    "start": 744.02,
    "end": 747.96,
    "text": "优雅  清晰的视觉"
  },
  {
    "start": 747.96,
    "end": 750.22,
    "text": "灵敏的听觉"
  },
  {
    "start": 750.22,
    "end": 752.37,
    "text": "灵活性 等"
  },
  {
    "start": 752.37,
    "end": 756.22,
    "text": "各种 能够增强你身体健康的属性"
  },
  {
    "start": 756.22,
    "end": 761.2,
    "text": "每次只激活 一到两种光芒的能量"
  },
  {
    "start": 761.2,
    "end": 763.02,
    "text": "你的神性自我"
  },
  {
    "start": 763.02,
    "end": 765.92,
    "text": "我是临在 和你的超灵 /高"
  },
  {
    "start": 765.92,
    "end": 768.57,
    "text": "我 将监督整个过程"
  },
  {
    "start": 768.57,
    "end": 771.37,
    "text": "并确保你只整合适量的能量"
  },
  {
    "start": 771.37,
    "end": 775.23,
    "text": "你的愿望不应只为加速转化"
  },
  {
    "start": 775.23,
    "end": 778.49,
    "text": "而是始终遵循轻松优雅的法则"
  },
  {
    "start": 778.49,
    "end": 779.99,
    "text": "亲爱的"
  },
  {
    "start": 779.99,
    "end": 781.73,
    "text": "享受整个过程"
  },
  {
    "start": 781.73,
    "end": 784.92,
    "text": "如果你允许这个过程为你工作"
  },
  {
    "start": 784.92,
    "end": 787.72,
    "text": "通过走出因果业力的领域"
  },
  {
    "start": 787.72,
    "end": 792.43,
    "text": "进入更高频率的领域 （在那里恩典法则适用）"
  },
  {
    "start": 792.43,
    "end": 795.09,
    "text": "那么 充满创伤 压力"
  },
  {
    "start": 795.09,
    "end": 799.83,
    "text": "痛苦教训 和失败的时代 将会结束"
  },
  {
    "start": 799.83,
    "end": 800.83,
    "text": "290 00:13:20,830 --> 00:13:24,690 ・现在 专注于情绪体"
  },
  {
    "start": 804.69,
    "end": 807.79,
    "text": "当你站在水晶桌前时"
  },
  {
    "start": 807.79,
    "end": 812.07,
    "text": "看到你的情绪体 在台上显现 并成形"
  },
  {
    "start": 812.07,
    "end": 815.98,
    "text": "你的情绪体 在你眼中是什么样子的"
  },
  {
    "start": 815.98,
    "end": 818.87,
    "text": "花一些时间研究它"
  },
  {
    "start": 818.87,
    "end": 822.12,
    "text": "观察 组成你情绪体的 不同色调"
  },
  {
    "start": 822.12,
    "end": 823.03,
    "text": "颜色"
  },
  {
    "start": 823.03,
    "end": 824.43,
    "text": "和形状"
  },
  {
    "start": 824.43,
    "end": 827.57,
    "text": "你可能会惊讶于你所看到的"
  },
  {
    "start": 827.57,
    "end": 831.76,
    "text": "无论你感知到什么 它都是有效的"
  },
  {
    "start": 831.76,
    "end": 834.26,
    "text": "如果你持续练习"
  },
  {
    "start": 834.26,
    "end": 839.01,
    "text": "你的内在感官将会变得更加敏锐和清晰"
  },
  {
    "start": 839.01,
    "end": 840.27,
    "text": "现在"
  },
  {
    "start": 840.27,
    "end": 843.19,
    "text": "你可以请求 造物主纯粹之爱"
  },
  {
    "start": 843.19,
    "end": 843.97,
    "text": "的光频率"
  },
  {
    "start": 843.97,
    "end": 845.72,
    "text": "倾斜而出"
  },
  {
    "start": 845.72,
    "end": 848.23,
    "text": "充满 你的情绪体"
  },
  {
    "start": 848.23,
    "end": 850.68,
    "text": "并源源不断地 溢出"
  },
  {
    "start": 850.68,
    "end": 854.84,
    "text": "冲走 你意识中 所有的自卑感"
  },
  {
    "start": 854.84,
    "end": 858.4,
    "text": "内疚 羞耻 和怀疑"
  },
  {
    "start": 858.4,
    "end": 859.75,
    "text": "接着"
  },
  {
    "start": 859.75,
    "end": 863.0,
    "text": "依次呼唤出同情的光芒"
  },
  {
    "start": 863.0,
    "end": 866.17,
    "text": "怜悯 与宽恕的光芒"
  },
  {
    "start": 866.17,
    "end": 868.39,
    "text": "接纳的光芒"
  },
  {
    "start": 868.39,
    "end": 876.58,
    "text": "热情  和平  和谐  仁慈 与善意"
  },
  {
    "start": 876.58,
    "end": 882.84,
    "text": "敏锐的直觉力  勇气 等诸如此类的光芒"
  },
  {
    "start": 882.84,
    "end": 884.41,
    "text": "然后"
  },
  {
    "start": 884.41,
    "end": 889.06,
    "text": "看到你的情绪体 被每一种特质的能量 充满"
  },
  {
    "start": 889.06,
    "end": 892.84,
    "text": "以便你在某一时间整合适合你的能量"
  },
  {
    "start": 892.84,
    "end": 893.84,
    "text": "321 00:14:53,840 --> 00:14:57,720 ・下面 专注于心智体"
  },
  {
    "start": 897.72,
    "end": 901.06,
    "text": "再次站在你的水晶桌前"
  },
  {
    "start": 901.06,
    "end": 905.38,
    "text": "看见你的心智体 显现 并在台上成形"
  },
  {
    "start": 905.38,
    "end": 909.32,
    "text": "你的心智体 在你眼中是什么样子的"
  },
  {
    "start": 909.32,
    "end": 912.27,
    "text": "它是强烈 而清晰的"
  },
  {
    "start": 912.27,
    "end": 915.76,
    "text": "还是色彩混乱 而扭曲的"
  },
  {
    "start": 915.76,
    "end": 917.03,
    "text": "接着"
  },
  {
    "start": 917.03,
    "end": 920.11,
    "text": "依次呼唤出 真理之光"
  },
  {
    "start": 920.11,
    "end": 922.2,
    "text": "意志力之光"
  },
  {
    "start": 922.2,
    "end": 925.56,
    "text": "勇气  智慧"
  },
  {
    "start": 925.56,
    "end": 930.92,
    "text": "智力  专注力  创造力"
  },
  {
    "start": 930.92,
    "end": 933.34,
    "text": "神圣思想"
  },
  {
    "start": 933.34,
    "end": 935.63,
    "text": "光之语/模式"
  },
  {
    "start": 935.63,
    "end": 939.57,
    "text": "神圣几何  纪律"
  },
  {
    "start": 939.57,
    "end": 944.97,
    "text": "逻辑性  科学知识  秩序"
  },
  {
    "start": 944.97,
    "end": 950.65,
    "text": "接受之光  和给予 与分享之光"
  },
  {
    "start": 950.65,
    "end": 955.17,
    "text": "这些光芒 流经一个悬挂在水晶桌中央"
  },
  {
    "start": 955.17,
    "end": 961.37,
    "text": "巨大的 能量生成晶体 （类似一个水晶能源装置）"
  },
  {
    "start": 961.37,
    "end": 964.82,
    "text": "然后注入你的个人光之金字塔中"
  },
  {
    "start": 964.82,
    "end": 969.0,
    "text": "你的神圣意识火花 我是临在"
  },
  {
    "start": 969.0,
    "end": 972.38,
    "text": "将过滤 每一束表达之光的精华"
  },
  {
    "start": 972.38,
    "end": 976.4,
    "text": "以其最纯粹的形式注入你的以太复制体"
  },
  {
    "start": 976.4,
    "end": 979.66,
    "text": "随着这些光芒完全渗透"
  },
  {
    "start": 979.66,
    "end": 984.56,
    "text": "你看到你的金字塔 被各种光芒 的本质和力量 充满"
  },
  {
    "start": 984.56,
    "end": 986.08,
    "text": "要知道"
  },
  {
    "start": 986.08,
    "end": 988.9,
    "text": "你将通过你目前所在的光柱"
  },
  {
    "start": 988.9,
    "end": 992.93,
    "text": "把每一种光芒的礼物/天赋带回你身边"
  },
  {
    "start": 992.93,
    "end": 998.64,
    "text": "但只是 适合你目前水平的光量"
  },
  {
    "start": 998.64,
    "end": 999.64,
    "text": "351 00:16:39,640 --> 00:16:43,360 ・现在 专注于以太体"
  },
  {
    "start": 1003.36,
    "end": 1007.39,
    "text": "你的以太体包含着你光体的蓝图"
  },
  {
    "start": 1007.39,
    "end": 1009.47,
    "text": "并包裹着你的物质身体"
  },
  {
    "start": 1009.47,
    "end": 1011.56,
    "text": "扭曲和缺陷"
  },
  {
    "start": 1011.56,
    "end": 1015.23,
    "text": "会首先存在于以太体 然后"
  },
  {
    "start": 1015.23,
    "end": 1017.38,
    "text": "才显现在物质层面"
  },
  {
    "start": 1017.38,
    "end": 1019.8,
    "text": "现在情况反过来"
  },
  {
    "start": 1019.8,
    "end": 1022.08,
    "text": "完美物质形态的创造本质"
  },
  {
    "start": 1022.08,
    "end": 1024.54,
    "text": "被储存在以太体中"
  },
  {
    "start": 1024.54,
    "end": 1028.23,
    "text": "你必须再次用和谐之光填满你的以太体"
  },
  {
    "start": 1028.23,
    "end": 1029.55,
    "text": "如此"
  },
  {
    "start": 1029.55,
    "end": 1033.67,
    "text": "这些创造本质就能被你的物质身体利用"
  },
  {
    "start": 1033.67,
    "end": 1035.98,
    "text": "从而恢复到完美状态"
  },
  {
    "start": 1035.98,
    "end": 1037.65,
    "text": "现在"
  },
  {
    "start": 1037.65,
    "end": 1041.03,
    "text": "看看你的以太体在你眼中是什么样子的"
  },
  {
    "start": 1041.03,
    "end": 1044.69,
    "text": "你能看见或想象 由扭曲能量"
  },
  {
    "start": 1044.69,
    "end": 1046.72,
    "text": "形成的黑暗之网吗"
  },
  {
    "start": 1046.72,
    "end": 1051.24,
    "text": "是否存在更密集 更黑暗的区域"
  },
  {
    "start": 1051.24,
    "end": 1053.38,
    "text": "它们位于哪个部位"
  },
  {
    "start": 1053.38,
    "end": 1054.84,
    "text": "最终"
  },
  {
    "start": 1054.84,
    "end": 1056.47,
    "text": "这种能力将成为 你"
  },
  {
    "start": 1056.47,
    "end": 1058.86,
    "text": "敏锐洞察力本能的一部分"
  },
  {
    "start": 1058.86,
    "end": 1062.17,
    "text": "你的以太体 ——元素意识"
  },
  {
    "start": 1062.17,
    "end": 1063.94,
    "text": "将开始告诉你"
  },
  {
    "start": 1063.94,
    "end": 1066.02,
    "text": "你的身体在哪里失衡"
  },
  {
    "start": 1066.02,
    "end": 1068.12,
    "text": "处于最痛苦的状态"
  },
  {
    "start": 1068.12,
    "end": 1070.3,
    "text": "以及你可能在哪里"
  },
  {
    "start": 1070.3,
    "end": 1075.08,
    "text": "经历下一次健康危机 或疾病"
  },
  {
    "start": 1075.08,
    "end": 1076.22,
    "text": "此外"
  },
  {
    "start": 1076.22,
    "end": 1079.39,
    "text": "在进入轻度的阿尔法状态时"
  },
  {
    "start": 1079.39,
    "end": 1081.74,
    "text": "你可能希望连续一两个星期"
  },
  {
    "start": 1081.74,
    "end": 1084.11,
    "text": "集中注意力于你的物质身体"
  },
  {
    "start": 1084.11,
    "end": 1086.0,
    "text": "因为你已准备好"
  },
  {
    "start": 1086.0,
    "end": 1088.79,
    "text": "接收并显化这些强大的能量"
  },
  {
    "start": 1088.79,
    "end": 1092.07,
    "text": "如果你在过程中感到迷失方向"
  },
  {
    "start": 1092.07,
    "end": 1093.88,
    "text": "不踏实或不舒服"
  },
  {
    "start": 1093.88,
    "end": 1095.97,
    "text": "先暂停一两天"
  },
  {
    "start": 1095.97,
    "end": 1097.54,
    "text": "然后再继续"
  },
  {
    "start": 1097.54,
    "end": 1100.52,
    "text": "让你的灵魂成为你的向导"
  },
  {
    "start": 1100.52,
    "end": 1103.9,
    "text": "不要模仿他人的进程或转变模式"
  },
  {
    "start": 1103.9,
    "end": 1105.08,
    "text": "因为"
  },
  {
    "start": 1105.08,
    "end": 1108.32,
    "text": "你正在接通你自己的神圣智慧"
  },
  {
    "start": 1108.32,
    "end": 1112.0,
    "text": "正在激活你自己的创造性天赋"
  },
  {
    "start": 1112.0,
    "end": 1113.72,
    "text": "无论何时"
  },
  {
    "start": 1113.72,
    "end": 1115.33,
    "text": "只要你愿意"
  },
  {
    "start": 1115.33,
    "end": 1117.84,
    "text": "你都可以识别 和专注于"
  },
  {
    "start": 1117.84,
    "end": 1120.43,
    "text": "投射到你身上的光芒的颜色"
  },
  {
    "start": 1120.43,
    "end": 1121.66,
    "text": "然而"
  },
  {
    "start": 1121.66,
    "end": 1125.55,
    "text": "首先请先专注于 每一种光芒 所具有的"
  },
  {
    "start": 1125.55,
    "end": 1127.76,
    "text": "感觉特质 或情感特性"
  },
  {
    "start": 1127.76,
    "end": 1128.9,
    "text": "此外"
  },
  {
    "start": 1128.9,
    "end": 1132.67,
    "text": "每次你整合了一条新的表达之光时"
  },
  {
    "start": 1132.67,
    "end": 1135.03,
    "text": "你的灵气场 就会改变"
  },
  {
    "start": 1135.03,
    "end": 1138.16,
    "text": "（我们将在最后名词解释部分"
  },
  {
    "start": 1138.16,
    "end": 1141.52,
    "text": "解释人体灵气场 /人体光环的构成"
  },
  {
    "start": 1141.52,
    "end": 1142.52,
    "text": "410 00:19:02,520 --> 00:19:05,410 ・无限呼吸过程"
  },
  {
    "start": 1145.41,
    "end": 1147.52,
    "text": "无限呼吸过程"
  },
  {
    "start": 1147.52,
    "end": 1150.69,
    "text": "是获取新创造能量的另一种方式"
  },
  {
    "start": 1150.69,
    "end": 1153.6,
    "text": "当你点燃你的扬升脉轮"
  },
  {
    "start": 1153.6,
    "end": 1157.41,
    "text": "它位于脊柱顶部和大脑底部的位置"
  },
  {
    "start": 1157.41,
    "end": 1160.08,
    "text": "你就打开了通往银河意识的门户"
  },
  {
    "start": 1160.08,
    "end": 1162.13,
    "text": "这个重要的燃点"
  },
  {
    "start": 1162.13,
    "end": 1165.62,
    "text": "是当前人类进化过程的重要组成部分"
  },
  {
    "start": 1165.62,
    "end": 1169.2,
    "text": "全人类都为这一事件而被编码"
  },
  {
    "start": 1169.2,
    "end": 1173.07,
    "text": "迟早它会发生在地球上每一个灵魂身上"
  },
  {
    "start": 1173.07,
    "end": 1175.71,
    "text": "当你进行无限呼吸"
  },
  {
    "start": 1175.71,
    "end": 1180.0,
    "text": "并看到它循环进入地球 和以太层面时"
  },
  {
    "start": 1180.0,
    "end": 1182.79,
    "text": "你也在帮助 让这份了不起的礼物"
  },
  {
    "start": 1182.79,
    "end": 1187.99,
    "text": "在第一 第二 第三和第四维度起作用"
  },
  {
    "start": 1187.99,
    "end": 1192.07,
    "text": "也包括上帝意识 在那里的每一个面向"
  },
  {
    "start": 1192.07,
    "end": 1194.3,
    "text": "亲爱的大师们"
  },
  {
    "start": 1194.3,
    "end": 1197.88,
    "text": "当你辐射出 造物主的爱与光时"
  },
  {
    "start": 1197.88,
    "end": 1200.25,
    "text": "它将呈现出 你所吸收的"
  },
  {
    "start": 1200.25,
    "end": 1202.36,
    "text": "每一道光芒的放大特性"
  },
  {
    "start": 1202.36,
    "end": 1204.8,
    "text": "在这样做的过程中"
  },
  {
    "start": 1204.8,
    "end": 1207.17,
    "text": "你将开始投射 自己独特的"
  },
  {
    "start": 1207.17,
    "end": 1210.24,
    "text": "上帝之光 ——你的灵魂之歌 ——"
  },
  {
    "start": 1210.24,
    "end": 1212.03,
    "text": "这是你给予人类的礼物"
  },
  {
    "start": 1212.03,
    "end": 1214.49,
    "text": "我们伸出友谊的双手"
  },
  {
    "start": 1214.49,
    "end": 1216.95,
    "text": "将我们的本质与你们的融合"
  },
  {
    "start": 1216.95,
    "end": 1220.77,
    "text": "我们为您发送和平与欢乐的光芒"
  },
  {
    "start": 1220.77,
    "end": 1222.23,
    "text": "但最重要的是"
  },
  {
    "start": 1222.23,
    "end": 1224.55,
    "text": "我们为您献上我们的爱"
  },
  {
    "start": 1224.55,
    "end": 1227.57,
    "text": "我是 大天使 MICHAEL"
  },
  {
    "start": 1227.57,
    "end": 1229.57,
    "text": "441 00:20:29,570 --> 00:20:32,150 冥想建议"
  },
  {
    "start": 1232.15,
    "end": 1235.58,
    "text": "在进行光之金字塔冥想之前"
  },
  {
    "start": 1235.58,
    "end": 1238.48,
    "text": "你最好先了解一下上一集的内容"
  },
  {
    "start": 1238.48,
    "end": 1241.58,
    "text": "我们这个子宇宙的创造过程及原理"
  },
  {
    "start": 1241.58,
    "end": 1243.19,
    "text": "会帮助你更好地理解"
  },
  {
    "start": 1243.19,
    "end": 1246.67,
    "text": "光之金字塔在整个创造过程中的功能"
  },
  {
    "start": 1246.67,
    "end": 1251.05,
    "text": "以便提升你的冥想效果"
  },
  {
    "start": 1251.05,
    "end": 1253.85,
    "text": "持之以恒的冥想练习"
  },
  {
    "start": 1253.85,
    "end": 1259.58,
    "text": "会让你养成习惯性的反思和沉思状态"
  },
  {
    "start": 1259.58,
    "end": 1261.3,
    "text": "正念意识"
  },
  {
    "start": 1261.3,
    "end": 1265.34,
    "text": "也称 正念觉知  是你的首要目标"
  },
  {
    "start": 1265.34,
    "end": 1267.39,
    "text": "以便获取灵魂自我"
  },
  {
    "start": 1267.39,
    "end": 1271.45,
    "text": "神圣心智和神圣心灵的访问权限"
  },
  {
    "start": 1271.45,
    "end": 1273.6,
    "text": "你必须首先意识到"
  },
  {
    "start": 1273.6,
    "end": 1276.54,
    "text": "需要做出的具体改变是什么"
  },
  {
    "start": 1276.54,
    "end": 1281.38,
    "text": "以实现内在与外在的平衡与和谐"
  },
  {
    "start": 1281.76,
    "end": 1283.54,
    "text": "暮雨·注"
  },
  {
    "start": 1283.54,
    "end": 1287.43,
    "text": "什么是正念意识  / 正念觉知"
  },
  {
    "start": 1287.43,
    "end": 1292.69,
    "text": "正念觉知是一种有意识地 保持在当下的状态"
  },
  {
    "start": 1292.69,
    "end": 1295.16,
    "text": "不受过去或未来的干扰"
  },
  {
    "start": 1295.16,
    "end": 1296.97,
    "text": "不带任何评判"
  },
  {
    "start": 1296.97,
    "end": 1300.37,
    "text": "全身心地专注于当前的感知和体验"
  },
  {
    "start": 1300.37,
    "end": 1306.1,
    "text": "它培养了一种 对自己的思想 情感 身体知觉"
  },
  {
    "start": 1306.1,
    "end": 1311.46,
    "text": "以及周围环境 冷静 专注的意识觉知"
  },
  {
    "start": 1311.46,
    "end": 1315.91,
    "text": "正念觉知具体表现在哪些方面"
  },
  {
    "start": 1315.91,
    "end": 1318.47,
    "text": "关注当下"
  },
  {
    "start": 1318.47,
    "end": 1322.43,
    "text": "将注意力集中在当前发生的事情上"
  },
  {
    "start": 1322.43,
    "end": 1325.9,
    "text": "而不是纠结于过去 或担忧未来"
  },
  {
    "start": 1325.9,
    "end": 1332.41,
    "text": "（技巧  将注意力集中在 后脑 延髓的部位 ）"
  },
  {
    "start": 1332.41,
    "end": 1335.51,
    "text": "非评判性观察"
  },
  {
    "start": 1335.51,
    "end": 1339.32,
    "text": "注意自己的思想 情绪和感觉"
  },
  {
    "start": 1339.32,
    "end": 1342.62,
    "text": "不给它们贴上好或坏的标签"
  },
  {
    "start": 1342.62,
    "end": 1346.58,
    "text": "也包括你对他人的非评判性观察"
  },
  {
    "start": 1346.58,
    "end": 1349.34,
    "text": "这可以帮助你净化人性中的恶意"
  },
  {
    "start": 1349.34,
    "end": 1350.53,
    "text": "此外"
  },
  {
    "start": 1350.53,
    "end": 1352.72,
    "text": "评判是左脑的工作"
  },
  {
    "start": 1352.72,
    "end": 1357.59,
    "text": "被左脑支配的意识 只会远离当下"
  },
  {
    "start": 1357.59,
    "end": 1360.28,
    "text": "冷静的意识"
  },
  {
    "start": 1360.28,
    "end": 1363.42,
    "text": "在观察内在和外在经历时"
  },
  {
    "start": 1363.42,
    "end": 1365.35,
    "text": "保持平和与镇定"
  },
  {
    "start": 1365.35,
    "end": 1371.73,
    "text": "（技巧  将注意力集中在 腹部的力量中心 ）"
  },
  {
    "start": 1371.73,
    "end": 1374.55,
    "text": "有意识的注意力"
  },
  {
    "start": 1374.55,
    "end": 1379.01,
    "text": "有意识地选择 注意力的焦点集中在某处"
  },
  {
    "start": 1379.01,
    "end": 1381.88,
    "text": "保持过程中不被干扰和分心"
  },
  {
    "start": 1381.88,
    "end": 1386.25,
    "text": "这有助于培养你控制能量 引导能量"
  },
  {
    "start": 1386.25,
    "end": 1388.81,
    "text": "和显化积极现实的能力"
  },
  {
    "start": 1388.81,
    "end": 1392.47,
    "text": "以及激活更多潜能"
  },
  {
    "start": 1392.47,
    "end": 1397.97,
    "text": "身体觉知  关注当下身体的感觉和状态"
  },
  {
    "start": 1397.97,
    "end": 1399.49,
    "text": "这是身体的元素"
  },
  {
    "start": 1399.49,
    "end": 1403.27,
    "text": "生命 灵魂 与我们对话的方式"
  },
  {
    "start": 1403.27,
    "end": 1406.12,
    "text": "同时培养了你对能量的敏感度"
  },
  {
    "start": 1406.12,
    "end": 1410.2,
    "text": "也有助于提升冥想效果"
  },
  {
    "start": 1410.2,
    "end": 1415.01,
    "text": "思想觉知  观察思想的产生"
  },
  {
    "start": 1415.01,
    "end": 1416.7,
    "text": "而不被卷入其中"
  },
  {
    "start": 1416.7,
    "end": 1418.35,
    "text": "请记住"
  },
  {
    "start": 1418.35,
    "end": 1420.0,
    "text": "你不是你的思想"
  },
  {
    "start": 1420.0,
    "end": 1422.98,
    "text": "超越的关键是把你的身份认知"
  },
  {
    "start": 1422.98,
    "end": 1423.66,
    "text": "转变为"
  },
  {
    "start": 1423.66,
    "end": 1429.56,
    "text": "客观的 不带评判的旁观者/观察者"
  },
  {
    "start": 1429.56,
    "end": 1432.16,
    "text": "情绪感悟力"
  },
  {
    "start": 1432.16,
    "end": 1435.61,
    "text": "觉察并承认当下生起的情绪"
  },
  {
    "start": 1435.61,
    "end": 1436.59,
    "text": "不去压制"
  },
  {
    "start": 1436.59,
    "end": 1438.23,
    "text": "也不任其裹挟"
  },
  {
    "start": 1438.23,
    "end": 1442.61,
    "text": "也包括觉察最微妙 不易察觉的情感"
  },
  {
    "start": 1442.61,
    "end": 1447.38,
    "text": "（技巧  有意识的深呼吸 / 腹式呼吸"
  },
  {
    "start": 1447.38,
    "end": 1450.99,
    "text": "情绪 是创造的催化剂"
  },
  {
    "start": 1450.99,
    "end": 1454.2,
    "text": "是推动你完成目标的潮汐力"
  },
  {
    "start": 1454.2,
    "end": 1457.49,
    "text": "你可以善用它）"
  },
  {
    "start": 1457.49,
    "end": 1459.84,
    "text": "你可以在任何时候"
  },
  {
    "start": 1459.84,
    "end": 1463.07,
    "text": "通过各种方式来练习正念觉知"
  },
  {
    "start": 1463.07,
    "end": 1469.83,
    "text": "包括正式的冥想 （坐着 行走 或动态冥想练习）"
  },
  {
    "start": 1469.83,
    "end": 1474.92,
    "text": "和非正式练习 （在一天中的短暂间歇中"
  },
  {
    "start": 1474.92,
    "end": 1477.89,
    "text": "或任何你想起的时刻）"
  },
  {
    "start": 1477.89,
    "end": 1479.28,
    "text": "然后"
  },
  {
    "start": 1479.28,
    "end": 1482.46,
    "text": "将正念觉知 融入到你的日常活动中"
  },
  {
    "start": 1482.46,
    "end": 1486.94,
    "text": "如吃饭 工作 运动 或交流"
  },
  {
    "start": 1486.94,
    "end": 1491.18,
    "text": "通过长期持久的 训练正念觉知"
  },
  {
    "start": 1491.18,
    "end": 1493.99,
    "text": "你会发现自己发展出 更强大的"
  },
  {
    "start": 1493.99,
    "end": 1496.51,
    "text": "应对生活挑战的能力"
  },
  {
    "start": 1496.51,
    "end": 1500.08,
    "text": "而不是自动 或习惯性地 被动反应"
  },
  {
    "start": 1500.08,
    "end": 1505.01,
    "text": "你不再轻易 被自己 或他人的情绪左右"
  },
  {
    "start": 1505.01,
    "end": 1508.5,
    "text": "因此能在当下 做出更好的决策"
  },
  {
    "start": 1508.5,
    "end": 1509.82,
    "text": "（既利于自己"
  },
  {
    "start": 1509.82,
    "end": 1511.2,
    "text": "也利于他人）"
  },
  {
    "start": 1511.2,
    "end": 1512.65,
    "text": "同时"
  },
  {
    "start": 1512.65,
    "end": 1514.35,
    "text": "你也提升了在生活中"
  },
  {
    "start": 1514.35,
    "end": 1517.01,
    "text": "整体的幸福感 和平衡感"
  },
  {
    "start": 1517.01,
    "end": 1519.01,
    "text": "540 00:25:19,010 --> 00:25:21,710 名词解释"
  },
  {
    "start": 1521.71,
    "end": 1524.12,
    "text": "以太体"
  },
  {
    "start": 1524.12,
    "end": 1525.72,
    "text": "以太体"
  },
  {
    "start": 1525.72,
    "end": 1530.72,
    "text": "是维持生命的 生命力能量的载体"
  },
  {
    "start": 1530.72,
    "end": 1533.32,
    "text": "星光体"
  },
  {
    "start": 1533.32,
    "end": 1535.02,
    "text": "星光体"
  },
  {
    "start": 1535.02,
    "end": 1540.36,
    "text": "是由主观感知 和情绪的能量组成"
  },
  {
    "start": 1540.36,
    "end": 1542.89,
    "text": "心智体"
  },
  {
    "start": 1542.89,
    "end": 1544.36,
    "text": "心智体"
  },
  {
    "start": 1544.36,
    "end": 1549.82,
    "text": "是智力 智慧 和意志力的能量"
  },
  {
    "start": 1549.82,
    "end": 1552.76,
    "text": "人体灵气场"
  },
  {
    "start": 1552.76,
    "end": 1555.23,
    "text": "也称为人体光环"
  },
  {
    "start": 1555.23,
    "end": 1558.83,
    "text": "是你的主导灵魂 本质的一个碎片"
  },
  {
    "start": 1558.83,
    "end": 1561.38,
    "text": "它是你与超灵 的众多面向"
  },
  {
    "start": 1561.38,
    "end": 1564.98,
    "text": "和你的神种原子 之间的连接"
  },
  {
    "start": 1564.98,
    "end": 1567.15,
    "text": "你的人体灵气场"
  },
  {
    "start": 1567.15,
    "end": 1570.55,
    "text": "由以下四个独特元素组成"
  },
  {
    "start": 1570.55,
    "end": 1573.03,
    "text": "物理光环"
  },
  {
    "start": 1573.03,
    "end": 1578.56,
    "text": "它会呈现出物质身体的健康 和活力状态"
  },
  {
    "start": 1578.56,
    "end": 1583.51,
    "text": "星光体光环  是情感的场域"
  },
  {
    "start": 1583.51,
    "end": 1587.82,
    "text": "在未觉醒的人类中是占主导地位的光环力量"
  },
  {
    "start": 1587.82,
    "end": 1590.81,
    "text": "星光层情感的本质 是由"
  },
  {
    "start": 1590.81,
    "end": 1592.27,
    "text": "自我欲望体的利益"
  },
  {
    "start": 1592.27,
    "end": 1596.24,
    "text": "和 以我 我自己 我的 焦点组成"
  },
  {
    "start": 1596.24,
    "end": 1600.83,
    "text": "爱的合一力量 将逐渐提升自我意识"
  },
  {
    "start": 1600.83,
    "end": 1602.91,
    "text": "使光环变得平衡"
  },
  {
    "start": 1602.91,
    "end": 1604.66,
    "text": "回归和谐"
  },
  {
    "start": 1604.66,
    "end": 1608.67,
    "text": "频率模式变得更加精细"
  },
  {
    "start": 1608.67,
    "end": 1612.19,
    "text": "主导灵魂自我的光环"
  },
  {
    "start": 1612.19,
    "end": 1615.23,
    "text": "包含着你原始亚当 /夏娃卡蒙光体"
  },
  {
    "start": 1615.23,
    "end": 1617.0,
    "text": "的神圣蓝图"
  },
  {
    "start": 1617.0,
    "end": 1619.43,
    "text": "它们是你最初的个性化种子"
  },
  {
    "start": 1619.43,
    "end": 1621.44,
    "text": "原子神性自我"
  },
  {
    "start": 1621.44,
    "end": 1624.53,
    "text": "它处于完全意识的光体结构"
  },
  {
    "start": 1624.53,
    "end": 1628.56,
    "text": "由耶洛因 光之主 有形事物的建造者 ——"
  },
  {
    "start": 1628.56,
    "end": 1630.69,
    "text": "作为人类原型创造"
  },
  {
    "start": 1630.69,
    "end": 1634.07,
    "text": "亚当 /夏娃卡蒙光体"
  },
  {
    "start": 1634.07,
    "end": 1636.43,
    "text": "体现了男人和女人原初完整的"
  },
  {
    "start": 1636.43,
    "end": 1640.44,
    "text": "神圣 和精神本质"
  },
  {
    "start": 1640.44,
    "end": 1644.54,
    "text": "情绪体灵气场  爱的合一力量"
  },
  {
    "start": 1644.54,
    "end": 1647.46,
    "text": "将逐渐提升自我意识"
  },
  {
    "start": 1647.46,
    "end": 1649.68,
    "text": "使情绪体灵气场变成"
  },
  {
    "start": 1649.68,
    "end": 1653.37,
    "text": "由同情心和无条件的爱的频率组成"
  },
  {
    "start": 1653.37,
    "end": 1657.28,
    "text": "在扬升道路上的修行者的目标是"
  },
  {
    "start": 1657.28,
    "end": 1658.49,
    "text": "平衡和协调"
  },
  {
    "start": 1658.49,
    "end": 1660.66,
    "text": "七大主要脉轮中心"
  },
  {
    "start": 1660.66,
    "end": 1664.18,
    "text": "使修行者的灵气 通过太阳能量中心"
  },
  {
    "start": 1664.18,
    "end": 1668.48,
    "text": "辐射出纯净的 爱与光的有形力场"
  },
  {
    "start": 1668.48,
    "end": 1671.7,
    "text": "从而允许 灵魂之光 闪耀"
  },
  {
    "start": 1671.7,
    "end": 1673.7,
    "text": "598 00:27:53,700 --> 00:27:55,700"
  },
  {
    "start": 1675.7,
    "end": 1677.7,
    "text": "600 00:27:57,700 --> 00:27:59,700"
  }
]