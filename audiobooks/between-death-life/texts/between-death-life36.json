[
  {
    "start": 0.0,
    "end": 1.733,
    "text": "《生死之间》"
  },
  {
    "start": 1.733,
    "end": 3.3,
    "text": "星光界的议会"
  },
  {
    "start": 3.3,
    "end": 4.5,
    "text": "上集"
  },
  {
    "start": 4.533,
    "end": 7.166,
    "text": "作者 朵洛莉丝·侃南"
  },
  {
    "start": 7.166,
    "end": 10.3,
    "text": "我回溯个案到转世期间"
  },
  {
    "start": 10.333,
    "end": 12.7,
    "text": "发现她在出席议会的会议"
  },
  {
    "start": 12.7,
    "end": 15.6,
    "text": "周遭的环境超脱世俗"
  },
  {
    "start": 15.6,
    "end": 17.066,
    "text": "美观壮丽"
  },
  {
    "start": 17.066,
    "end": 19.5,
    "text": "显然是在较高的层面举行"
  },
  {
    "start": 19.5,
    "end": 21.233,
    "text": "个案说"
  },
  {
    "start": 21.266,
    "end": 24.4,
    "text": "如果用物质层面的眼睛来看"
  },
  {
    "start": 24.433,
    "end": 28.0,
    "text": "我们所聚集的地方是飘浮在半空中"
  },
  {
    "start": 28.0,
    "end": 30.666,
    "text": "但其实这里是由能量场支撑"
  },
  {
    "start": 30.7,
    "end": 32.7,
    "text": "你们层面的眼睛并无法"
  },
  {
    "start": 32.7,
    "end": 35.1,
    "text": "感知或看到这个能量场"
  },
  {
    "start": 35.1,
    "end": 37.6,
    "text": "它是美丽的深紫色"
  },
  {
    "start": 37.6,
    "end": 39.3,
    "text": "包围着我们每个人"
  },
  {
    "start": 39.333,
    "end": 42.1,
    "text": "这里没有墙壁或天花板"
  },
  {
    "start": 42.1,
    "end": 45.0,
    "text": "一切都是深紫色和金色"
  },
  {
    "start": 45.0,
    "end": 47.7,
    "text": "飘浮在能量场中间的"
  },
  {
    "start": 47.733,
    "end": 50.033,
    "text": "我想应该可以说是会议室"
  },
  {
    "start": 50.033,
    "end": 52.733,
    "text": "四处都有金色的柱子"
  },
  {
    "start": 52.733,
    "end": 54.566,
    "text": "柱身有凹槽装饰"
  },
  {
    "start": 54.566,
    "end": 57.0,
    "text": "这些柱子除了美观外"
  },
  {
    "start": 57.033,
    "end": 59.033,
    "text": "没有什么特别的目的"
  },
  {
    "start": 59.066,
    "end": 60.866,
    "text": "但可以用来聚集能量"
  },
  {
    "start": 60.866,
    "end": 63.5,
    "text": "柱子以等距的方式排列"
  },
  {
    "start": 63.533,
    "end": 66.7,
    "text": "整个结构可以用来当作能量发电机"
  },
  {
    "start": 66.7,
    "end": 68.866,
    "text": "但这不是它们主要的用处"
  },
  {
    "start": 68.9,
    "end": 71.8,
    "text": "在柱子后面是金色的帷幕"
  },
  {
    "start": 71.833,
    "end": 73.633,
    "text": "金色映衬着紫色"
  },
  {
    "start": 73.633,
    "end": 75.0,
    "text": "非常漂亮"
  },
  {
    "start": 75.0,
    "end": 77.833,
    "text": "我们坐的家具是金子做的"
  },
  {
    "start": 77.866,
    "end": 79.8,
    "text": "但上面有木头纹理"
  },
  {
    "start": 79.8,
    "end": 83.033,
    "text": "就好像是用长出来就是金子的树木制成"
  },
  {
    "start": 83.033,
    "end": 84.466,
    "text": "非常美"
  },
  {
    "start": 84.5,
    "end": 87.866,
    "text": "你们有围坐在桌子还是什么的吗"
  },
  {
    "start": 87.866,
    "end": 89.0,
    "text": "没有"
  },
  {
    "start": 89.033,
    "end": 91.8,
    "text": "我们是在靠近这个会议室的边缘"
  },
  {
    "start": 91.8,
    "end": 95.466,
    "text": "大概有四五排错列的椅子往上排列"
  },
  {
    "start": 95.5,
    "end": 98.866,
    "text": "这样后面的人就不会被前面的人挡住"
  },
  {
    "start": 98.866,
    "end": 101.0,
    "text": "其实也不是真的椅子"
  },
  {
    "start": 101.033,
    "end": 103.766,
    "text": "是一层一层往上的平缓阶梯"
  },
  {
    "start": 103.8,
    "end": 105.633,
    "text": "就像露天剧场那样"
  },
  {
    "start": 105.633,
    "end": 108.433,
    "text": "阶梯环绕着中间的空地"
  },
  {
    "start": 108.466,
    "end": 112.5,
    "text": "有人想要上前讲话或发表意见的话"
  },
  {
    "start": 112.5,
    "end": 115.433,
    "text": "就可以到中间大家都看得到的地方"
  },
  {
    "start": 115.466,
    "end": 120.033,
    "text": "这里很像是有着金柱子和金帷幕的椭圆形法庭"
  },
  {
    "start": 120.033,
    "end": 122.0,
    "text": "旁边有层层阶梯"
  },
  {
    "start": 122.033,
    "end": 124.433,
    "text": "中间空着的地方有个讲台"
  },
  {
    "start": 124.433,
    "end": 128.4,
    "text": "但是这个讲台比一般的讲台漂亮多了"
  },
  {
    "start": 128.433,
    "end": 129.8,
    "text": "很像木制品"
  },
  {
    "start": 129.8,
    "end": 132.0,
    "text": "不过它真的是用金子做的"
  },
  {
    "start": 132.0,
    "end": 135.033,
    "text": "讲台是为了让大家展示东西"
  },
  {
    "start": 135.066,
    "end": 136.433,
    "text": "比如説"
  },
  {
    "start": 136.466,
    "end": 138.266,
    "text": "从这个讲台可以投射出"
  },
  {
    "start": 138.3,
    "end": 140.366,
    "text": "你们所谓的全息图"
  },
  {
    "start": 140.366,
    "end": 141.6,
    "text": "立体影像"
  },
  {
    "start": 141.633,
    "end": 144.266,
    "text": "为什么会需要立体影像"
  },
  {
    "start": 144.266,
    "end": 146.966,
    "text": "这要看当时讨论的主题"
  },
  {
    "start": 147.0,
    "end": 148.8,
    "text": "和需要呈现的东西"
  },
  {
    "start": 148.8,
    "end": 150.566,
    "text": "我们通常来这里"
  },
  {
    "start": 150.566,
    "end": 153.8,
    "text": "是讨论我们在地球上曾有过的影响"
  },
  {
    "start": 153.8,
    "end": 155.8,
    "text": "还有以后会有的影响"
  },
  {
    "start": 155.833,
    "end": 158.966,
    "text": "它会如何符合整个宇宙的大局规划"
  },
  {
    "start": 159.0,
    "end": 161.5,
    "text": "在讲台区域呈现的东西"
  },
  {
    "start": 161.5,
    "end": 164.8,
    "text": "展示的是这个特定宇宙的整体模式"
  },
  {
    "start": 164.8,
    "end": 167.466,
    "text": "我们的业如何跟这个模式互动"
  },
  {
    "start": 167.466,
    "end": 170.5,
    "text": "还有我们应该继续走哪条路才能开悟"
  },
  {
    "start": 170.533,
    "end": 174.333,
    "text": "我们现在的形式可以飘浮在空中"
  },
  {
    "start": 174.366,
    "end": 175.966,
    "text": "如果我们想的话"
  },
  {
    "start": 175.966,
    "end": 177.733,
    "text": "我们不用坐下"
  },
  {
    "start": 177.766,
    "end": 179.766,
    "text": "但大家几乎都坐着"
  },
  {
    "start": 179.766,
    "end": 182.0,
    "text": "因为这样气氛比较舒适"
  },
  {
    "start": 182.033,
    "end": 184.6,
    "text": "你们现在是什么形式"
  },
  {
    "start": 184.633,
    "end": 188.4,
    "text": "我看到的灵魂看起来像白色的光"
  },
  {
    "start": 188.4,
    "end": 192.2,
    "text": "有点像各种形状和颜色的迷你太阳"
  },
  {
    "start": 192.233,
    "end": 193.7,
    "text": "从中心发亮"
  },
  {
    "start": 193.7,
    "end": 197.266,
    "text": "好像一个能量球散发出光芒"
  },
  {
    "start": 197.266,
    "end": 200.533,
    "text": "从中心散发的光除了白色"
  },
  {
    "start": 200.566,
    "end": 202.933,
    "text": "还依稀可以看到別的颜色"
  },
  {
    "start": 202.933,
    "end": 205.633,
    "text": "有点像极光或蛋白石"
  },
  {
    "start": 205.633,
    "end": 207.3,
    "text": "只是我们看到的蛋白石"
  },
  {
    "start": 207.333,
    "end": 209.433,
    "text": "通常只有一种颜色"
  },
  {
    "start": 209.433,
    "end": 212.3,
    "text": "但这些灵魂有不同颜色的光芒"
  },
  {
    "start": 212.333,
    "end": 215.566,
    "text": "似乎是显示它们的感觉 情绪"
  },
  {
    "start": 215.566,
    "end": 217.466,
    "text": "想法和发展的程度"
  },
  {
    "start": 217.5,
    "end": 222.233,
    "text": "我以为光所呈现的形状是人类的样子"
  },
  {
    "start": 222.233,
    "end": 224.266,
    "text": "但其实它像一个球"
  },
  {
    "start": 224.3,
    "end": 226.9,
    "text": "你就像是在看太阳一样"
  },
  {
    "start": 226.9,
    "end": 229.466,
    "text": "你看不到确切的轮廓"
  },
  {
    "start": 229.5,
    "end": 231.133,
    "text": "因为实在太亮了"
  },
  {
    "start": 231.133,
    "end": 233.933,
    "text": "但你知道有个能量的中心"
  },
  {
    "start": 233.933,
    "end": 236.866,
    "text": "也看得到能量以光芒的形式散发"
  },
  {
    "start": 236.9,
    "end": 238.6,
    "text": "在跳动吗"
  },
  {
    "start": 238.6,
    "end": 240.6,
    "text": "是稳定的流动"
  },
  {
    "start": 240.6,
    "end": 242.6,
    "text": "散发出光"
  },
  {
    "start": 242.633,
    "end": 244.533,
    "text": "这个形容不错"
  },
  {
    "start": 244.566,
    "end": 246.933,
    "text": "就是从一个中心散发出来"
  },
  {
    "start": 246.933,
    "end": 251.733,
    "text": "每个灵魂都悬浮在这些层层阶梯上的特定位置"
  },
  {
    "start": 251.733,
    "end": 254.966,
    "text": "每个灵魂都有自觉或自我意识"
  },
  {
    "start": 255.0,
    "end": 256.566,
    "text": "就像我和你一样"
  },
  {
    "start": 256.6,
    "end": 260.566,
    "text": "只是它们理解的层面比你们高出许多"
  },
  {
    "start": 260.6,
    "end": 264.0,
    "text": "它们的位置是由某种能量决定"
  },
  {
    "start": 264.033,
    "end": 266.166,
    "text": "灵魂悬浮在空中"
  },
  {
    "start": 266.166,
    "end": 269.2,
    "text": "根据本身能量与周遭能量的互动"
  },
  {
    "start": 269.2,
    "end": 270.666,
    "text": "而在不同位置"
  },
  {
    "start": 270.7,
    "end": 275.233,
    "text": "这些一排排的阶梯以某种模式散发能量"
  },
  {
    "start": 275.266,
    "end": 278.4,
    "text": "悬浮在上面就跟坐在椅子上一样"
  },
  {
    "start": 278.4,
    "end": 282.366,
    "text": "灵魂就是以这个能量椅垫支撑自己"
  },
  {
    "start": 282.4,
    "end": 285.033,
    "text": "你说这是在比较高的层面"
  },
  {
    "start": 285.066,
    "end": 285.933,
    "text": "对"
  },
  {
    "start": 285.966,
    "end": 290.066,
    "text": "这里的灵魂还在转世之间（指在灵界/星光界）"
  },
  {
    "start": 290.066,
    "end": 292.466,
    "text": "我们都在努力提升自己的业"
  },
  {
    "start": 292.5,
    "end": 295.366,
    "text": "我们已经到达这个特定层面"
  },
  {
    "start": 295.366,
    "end": 299.066,
    "text": "只要我们没有跟任何地球的生命有直接关系"
  },
  {
    "start": 299.1,
    "end": 302.966,
    "text": "就可以到更高层面去规划自己未来的道路"
  },
  {
    "start": 302.966,
    "end": 306.033,
    "text": "我们也必须规划如何帮助那些"
  },
  {
    "start": 306.066,
    "end": 309.133,
    "text": "还没有进展到我们这个程度的灵魂"
  },
  {
    "start": 309.166,
    "end": 310.5,
    "text": "同样地"
  },
  {
    "start": 310.5,
    "end": 314.133,
    "text": "比我们进展更高阶的灵魂也在帮助我们"
  },
  {
    "start": 314.166,
    "end": 316.0,
    "text": "我们帮助彼此"
  },
  {
    "start": 316.0,
    "end": 318.5,
    "text": "所有一切都是相互关联"
  },
  {
    "start": 318.533,
    "end": 319.933,
    "text": "息息相关的"
  },
  {
    "start": 319.933,
    "end": 321.4,
    "text": "你是説"
  },
  {
    "start": 321.433,
    "end": 325.266,
    "text": "这个层面比一般灵魂到达的层面还要高"
  },
  {
    "start": 325.266,
    "end": 327.766,
    "text": "但还是有比这里更高的层面"
  },
  {
    "start": 327.766,
    "end": 328.733,
    "text": "对"
  },
  {
    "start": 328.766,
    "end": 331.8,
    "text": "最高的层面就是达到完全的开悟"
  },
  {
    "start": 331.8,
    "end": 334.4,
    "text": "我们还没到达那个层级"
  },
  {
    "start": 334.4,
    "end": 335.866,
    "text": "但我们在努力"
  },
  {
    "start": 335.9,
    "end": 338.066,
    "text": "也知道自己的进度不错"
  },
  {
    "start": 338.066,
    "end": 340.366,
    "text": "所以我们才会被赋予"
  },
  {
    "start": 340.4,
    "end": 343.166,
    "text": "帮助比我们层级低的灵魂的任务"
  },
  {
    "start": 343.166,
    "end": 345.333,
    "text": "像是当指导灵吗"
  },
  {
    "start": 345.333,
    "end": 346.233,
    "text": "对"
  },
  {
    "start": 346.233,
    "end": 348.5,
    "text": "当我们在转世期的时候"
  },
  {
    "start": 348.533,
    "end": 350.933,
    "text": "时间的概念跟地球不同"
  },
  {
    "start": 350.966,
    "end": 354.5,
    "text": "有时候跟人世生命有直接相关的人"
  },
  {
    "start": 354.5,
    "end": 355.8,
    "text": "会需要帮忙"
  },
  {
    "start": 355.833,
    "end": 360.233,
    "text": "我们可以较不费力地从这个层面帮助他们"
  },
  {
    "start": 360.266,
    "end": 362.466,
    "text": "因为我们是在较高的层面"
  },
  {
    "start": 362.466,
    "end": 366.333,
    "text": "我想你可以说这个角色有点像指导"
  },
  {
    "start": 366.366,
    "end": 369.6,
    "text": "就像时不时会伸出援手的哥哥或姐姐"
  },
  {
    "start": 369.633,
    "end": 370.7,
    "text": "此外"
  },
  {
    "start": 370.7,
    "end": 372.766,
    "text": "其他处于转世期间"
  },
  {
    "start": 372.766,
    "end": 375.3,
    "text": "但不像我们这么进化的灵魂"
  },
  {
    "start": 375.333,
    "end": 377.9,
    "text": "常常需要我们协助规划未来"
  },
  {
    "start": 377.9,
    "end": 380.2,
    "text": "以便继续在业力方面进步"
  },
  {
    "start": 380.233,
    "end": 384.4,
    "text": "我们会以本身的经验提供忠告和建议"
  },
  {
    "start": 384.4,
    "end": 386.533,
    "text": "他们再自己做出决定"
  },
  {
    "start": 386.566,
    "end": 390.1,
    "text": "就像更高层级的灵魂对我们的方式一样"
  },
  {
    "start": 390.133,
    "end": 394.933,
    "text": "更高层级的灵魂在努力达成更高的目标时"
  },
  {
    "start": 394.933,
    "end": 398.3,
    "text": "也会跟我们分享他们如何提升他们的业"
  },
  {
    "start": 398.333,
    "end": 402.0,
    "text": "以及同样的作法是否对我们的业也有帮助"
  },
  {
    "start": 402.0,
    "end": 405.466,
    "text": "那么如果有你回答不出来的问题"
  },
  {
    "start": 405.5,
    "end": 407.833,
    "text": "你会问別的层级的灵魂吗"
  },
  {
    "start": 407.866,
    "end": 412.166,
    "text": "你现在看得到在其它层级的这些灵魂吗"
  },
  {
    "start": 412.2,
    "end": 413.9,
    "text": "现在看不到"
  },
  {
    "start": 413.9,
    "end": 416.833,
    "text": "我们是在这个层级的议会处理事情"
  },
  {
    "start": 416.833,
    "end": 418.133,
    "text": "目前都顺利"
  },
  {
    "start": 418.133,
    "end": 420.133,
    "text": "但如果遇到困难"
  },
  {
    "start": 420.133,
    "end": 422.366,
    "text": "我们可以利用能量柱和讲台"
  },
  {
    "start": 422.4,
    "end": 424.933,
    "text": "来联系较高层级的灵魂"
  },
  {
    "start": 424.933,
    "end": 427.066,
    "text": "他们就会过来与我们交流"
  },
  {
    "start": 427.1,
    "end": 431.033,
    "text": "你们无法到他们的层级去找他们吗"
  },
  {
    "start": 431.066,
    "end": 433.6,
    "text": "必须是他们来你们的层级吗"
  },
  {
    "start": 433.6,
    "end": 436.966,
    "text": "我们可以透过远距沟通联系他们"
  },
  {
    "start": 437.0,
    "end": 438.733,
    "text": "就像你们的无线电"
  },
  {
    "start": 438.766,
    "end": 440.833,
    "text": "但要直接沟通的话"
  },
  {
    "start": 440.833,
    "end": 443.366,
    "text": "他们必须来到我们的层面"
  },
  {
    "start": 443.366,
    "end": 446.2,
    "text": "因为我们的开悟只到某个程度"
  },
  {
    "start": 446.233,
    "end": 450.3,
    "text": "我们的能量等级还不能与更高阶相容"
  },
  {
    "start": 450.3,
    "end": 452.233,
    "text": "无法上到更高层级"
  },
  {
    "start": 452.233,
    "end": 455.033,
    "text": "但我们可以去较低的层级"
  },
  {
    "start": 455.066,
    "end": 457.666,
    "text": "因为我们已经经过那些层级"
  },
  {
    "start": 457.666,
    "end": 461.433,
    "text": "知道要怎么调整自己的能量与它们相容"
  },
  {
    "start": 461.433,
    "end": 464.7,
    "text": "所以我们可以去那里帮助在那里的灵魂"
  },
  {
    "start": 464.733,
    "end": 468.6,
    "text": "当你透过地球人世在业力上进步"
  },
  {
    "start": 468.6,
    "end": 469.9,
    "text": "回来之后"
  },
  {
    "start": 469.933,
    "end": 473.766,
    "text": "较高层级的灵魂会让你了解你所完成的事"
  },
  {
    "start": 473.8,
    "end": 476.1,
    "text": "而你会发现自己的能量"
  },
  {
    "start": 476.133,
    "end": 478.7,
    "text": "已经跟新到达的层面相容了"
  },
  {
    "start": 478.7,
    "end": 481.766,
    "text": "你记得別的层级是怎么回事"
  },
  {
    "start": 481.766,
    "end": 484.2,
    "text": "所以你仍然可以到较低层级"
  },
  {
    "start": 484.233,
    "end": 485.966,
    "text": "去帮助那里的灵魂"
  },
  {
    "start": 485.966,
    "end": 491.166,
    "text": "你说从你的层级可以比较不费力地帮助別人"
  },
  {
    "start": 491.166,
    "end": 494.866,
    "text": "如果从其他层级需要花较多力气吗"
  },
  {
    "start": 494.9,
    "end": 496.533,
    "text": "这要看情况"
  },
  {
    "start": 496.533,
    "end": 499.866,
    "text": "我们可以较不费力地帮助地球层面的人"
  },
  {
    "start": 499.9,
    "end": 503.133,
    "text": "是因为我们一直跟那个层面有密切联系"
  },
  {
    "start": 503.133,
    "end": 505.2,
    "text": "当我们在这一边时"
  },
  {
    "start": 505.2,
    "end": 507.933,
    "text": "我们可以看到能量的基层结构"
  },
  {
    "start": 507.966,
    "end": 510.966,
    "text": "看到所有事物是如何连结在一起"
  },
  {
    "start": 510.966,
    "end": 514.4,
    "text": "因此我们可以稍微从旁推动"
  },
  {
    "start": 514.433,
    "end": 517.266,
    "text": "帮助某人往特定的方向前进"
  },
  {
    "start": 517.266,
    "end": 520.033,
    "text": "这不必是任何重大的改变"
  },
  {
    "start": 520.033,
    "end": 523.066,
    "text": "却可以让事情往另一个方向发展"
  },
  {
    "start": 523.1,
    "end": 525.5,
    "text": "而不是原本发展的那个方向"
  },
  {
    "start": 525.533,
    "end": 528.666,
    "text": "在哪里会需要你花最多的能量"
  },
  {
    "start": 528.666,
    "end": 532.333,
    "text": "联系较高层级需要较多能量"
  },
  {
    "start": 532.366,
    "end": 534.833,
    "text": "因为我们的能力跟那里不相容"
  },
  {
    "start": 534.833,
    "end": 537.8,
    "text": "我们必须集中能量并提升"
  },
  {
    "start": 537.833,
    "end": 541.566,
    "text": "才能在较高层级选出共鸣和谐的振动"
  },
  {
    "start": 541.566,
    "end": 544.433,
    "text": "另一个会花很多能量的情形"
  },
  {
    "start": 544.466,
    "end": 546.8,
    "text": "就是需要去造访或帮助那些"
  },
  {
    "start": 546.833,
    "end": 548.633,
    "text": "有许多负面业力的人"
  },
  {
    "start": 548.633,
    "end": 550.566,
    "text": "一个人的业越负面"
  },
  {
    "start": 550.6,
    "end": 552.6,
    "text": "相容性就越低"
  },
  {
    "start": 552.6,
    "end": 555.866,
    "text": "要跟他们沟通或帮助他们也就比较困难"
  },
  {
    "start": 555.9,
    "end": 558.7,
    "text": "就像要把同极的磁铁推在一起"
  },
  {
    "start": 558.733,
    "end": 560.1,
    "text": "它们会相斥"
  },
  {
    "start": 560.1,
    "end": 561.566,
    "text": "就像那个情形"
  },
  {
    "start": 561.6,
    "end": 565.566,
    "text": "我们认为他们无意识地筑起了能量障碍"
  },
  {
    "start": 565.566,
    "end": 569.266,
    "text": "他们不知道自己是在如何影响自己的业"
  },
  {
    "start": 569.3,
    "end": 572.233,
    "text": "他们就一直重复这样的循环"
  },
  {
    "start": 572.233,
    "end": 575.233,
    "text": "我们通常必须密切地注意他们"
  },
  {
    "start": 575.266,
    "end": 578.3,
    "text": "试着在他们较弱的时候突破障碍"
  },
  {
    "start": 578.3,
    "end": 580.4,
    "text": "给他们一丝希望的曙光"
  },
  {
    "start": 580.433,
    "end": 582.433,
    "text": "就这样的一点希望"
  },
  {
    "start": 582.433,
    "end": 585.266,
    "text": "能够帮助他们跳出负面循环"
  },
  {
    "start": 585.3,
    "end": 587.133,
    "text": "开始创造正面的业"
  },
  {
    "start": 587.133,
    "end": 590.333,
    "text": "这比起那些较能接受你们世界的人"
  },
  {
    "start": 590.366,
    "end": 592.133,
    "text": "要难帮助多了"
  },
  {
    "start": 592.133,
    "end": 593.4,
    "text": "没错"
  },
  {
    "start": 593.4,
    "end": 596.1,
    "text": "那些在努力解决负面业力的人"
  },
  {
    "start": 596.133,
    "end": 599.033,
    "text": "就像是活在一个空心的甜甜圈里"
  },
  {
    "start": 599.033,
    "end": 602.666,
    "text": "他们一直在这个甜甜圈里面绕圈子"
  },
  {
    "start": 602.7,
    "end": 604.433,
    "text": "什么进展都没有"
  },
  {
    "start": 604.433,
    "end": 606.3,
    "text": "如果情况更糟"
  },
  {
    "start": 606.333,
    "end": 609.033,
    "text": "就像是以螺旋方式往下降"
  },
  {
    "start": 609.033,
    "end": 610.833,
    "text": "需要某人抓住他们"
  },
  {
    "start": 610.833,
    "end": 612.333,
    "text": "帮他们往上爬"
  },
  {
    "start": 612.366,
    "end": 613.6,
    "text": "反之"
  },
  {
    "start": 613.633,
    "end": 616.566,
    "text": "正面业力的人就像在爬楼梯"
  },
  {
    "start": 616.566,
    "end": 619.066,
    "text": "这是开放得多的情况"
  },
  {
    "start": 619.066,
    "end": 621.533,
    "text": "而且跟他们联系要容易多了"
  },
  {
    "start": 621.533,
    "end": 625.566,
    "text": "负面业力的人通常是在关闭的状态"
  },
  {
    "start": 625.6,
    "end": 627.733,
    "text": "比较难突破他们的心防"
  },
  {
    "start": 627.733,
    "end": 630.733,
    "text": "他们可能根本不知道你们在那里"
  },
  {
    "start": 630.766,
    "end": 632.333,
    "text": "确实不知道"
  },
  {
    "start": 632.333,
    "end": 635.733,
    "text": "他们在周围筑起的心智与能量围墙"
  },
  {
    "start": 635.733,
    "end": 638.966,
    "text": "把他们不想面对的东西都挡在外面"
  },
  {
    "start": 639.0,
    "end": 642.9,
    "text": "你们会指派特定的人来帮助他们吗"
  },
  {
    "start": 642.933,
    "end": 646.333,
    "text": "还是看到谁有需要就帮助谁"
  },
  {
    "start": 646.366,
    "end": 649.2,
    "text": "我们不是被指派给特定的人"
  },
  {
    "start": 649.2,
    "end": 651.366,
    "text": "我们比较像在监看"
  },
  {
    "start": 651.366,
    "end": 655.0,
    "text": "我们被告知要注意整体里的某个区域"
  },
  {
    "start": 655.033,
    "end": 658.2,
    "text": "每看到需要轻推一下或帮助的部份"
  },
  {
    "start": 658.233,
    "end": 660.7,
    "text": "我们就会主动采取行动协助"
  },
  {
    "start": 660.7,
    "end": 663.8,
    "text": "每次帮的人可能都不一样"
  },
  {
    "start": 663.833,
    "end": 665.933,
    "text": "每当我们帮助某人"
  },
  {
    "start": 665.933,
    "end": 668.566,
    "text": "帮助整体的业朝向正面时"
  },
  {
    "start": 668.6,
    "end": 671.233,
    "text": "有时特定的人会因此受惠"
  },
  {
    "start": 671.233,
    "end": 673.133,
    "text": "但往往我们的行动总会"
  },
  {
    "start": 673.166,
    "end": 674.866,
    "text": "一次就帮上许多人"
  }
]