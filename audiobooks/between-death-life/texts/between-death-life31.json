[
  {
    "start": 0.0,
    "end": 1.833,
    "text": "《生死之间》"
  },
  {
    "start": 1.833,
    "end": 3.7,
    "text": "耶稣与三位一体"
  },
  {
    "start": 3.733,
    "end": 6.366,
    "text": "作者 朵洛莉丝·侃南"
  },
  {
    "start": 6.366,
    "end": 10.2,
    "text": "我们要相信耶穌这个人是上帝的儿子吗"
  },
  {
    "start": 10.2,
    "end": 12.733,
    "text": "这是非常简化的说法"
  },
  {
    "start": 12.733,
    "end": 14.433,
    "text": "毕竟上帝不是人"
  },
  {
    "start": 14.466,
    "end": 15.933,
    "text": "怎么会有儿子呢"
  },
  {
    "start": 15.966,
    "end": 18.1,
    "text": "用这个词来表达"
  },
  {
    "start": 18.133,
    "end": 21.533,
    "text": "是让那个时代的人们有一个初浅的认识"
  },
  {
    "start": 21.533,
    "end": 25.533,
    "text": "「儿子」这个词不应该从字面上去解读"
  },
  {
    "start": 25.533,
    "end": 28.2,
    "text": "耶穌是来自灵魂实相中"
  },
  {
    "start": 28.233,
    "end": 30.333,
    "text": "另一个层面的使者"
  },
  {
    "start": 30.366,
    "end": 32.9,
    "text": "那个层面比地球灵魂的层面"
  },
  {
    "start": 32.933,
    "end": 34.3,
    "text": "更接近上帝"
  },
  {
    "start": 34.3,
    "end": 38.133,
    "text": "耶穌的层级不是直接在上帝之下"
  },
  {
    "start": 38.133,
    "end": 39.633,
    "text": "换句话说"
  },
  {
    "start": 39.666,
    "end": 42.7,
    "text": "还有层级比耶穌更接近上帝"
  },
  {
    "start": 42.733,
    "end": 43.733,
    "text": "然而"
  },
  {
    "start": 43.733,
    "end": 45.166,
    "text": "它来自的层级"
  },
  {
    "start": 45.166,
    "end": 48.366,
    "text": "从来没有相同层级的灵魂来过地球"
  },
  {
    "start": 48.4,
    "end": 51.6,
    "text": "人类心智很难明瞭这样的概念"
  },
  {
    "start": 51.6,
    "end": 56.133,
    "text": "因此必须用人类能理解的词汇（上帝的儿子）来表达"
  },
  {
    "start": 56.133,
    "end": 57.566,
    "text": "《圣经》教导我们"
  },
  {
    "start": 57.6,
    "end": 60.866,
    "text": "耶穌下来地球之前与上帝同在"
  },
  {
    "start": 60.866,
    "end": 62.733,
    "text": "它属于上帝的一部分"
  },
  {
    "start": 62.766,
    "end": 66.3,
    "text": "这跟我们的灵魂是上帝的一部分"
  },
  {
    "start": 66.3,
    "end": 68.2,
    "text": "是不是同样的道理"
  },
  {
    "start": 68.2,
    "end": 69.4,
    "text": "没错"
  },
  {
    "start": 69.433,
    "end": 72.1,
    "text": "但它并没有比较像上帝"
  },
  {
    "start": 72.1,
    "end": 73.9,
    "text": "真要说的话"
  },
  {
    "start": 73.9,
    "end": 75.566,
    "text": "它在较高的层面"
  },
  {
    "start": 75.6,
    "end": 78.966,
    "text": "有没有其他投生转世的灵魂"
  },
  {
    "start": 79.0,
    "end": 81.2,
    "text": "可以归类到相同的「角色」"
  },
  {
    "start": 81.233,
    "end": 84.2,
    "text": "不知道角色这个字对不对"
  },
  {
    "start": 84.2,
    "end": 87.133,
    "text": "但有没有谁曾到地球协助"
  },
  {
    "start": 87.133,
    "end": 90.4,
    "text": "是像基督徒眼中的耶穌一样伟大"
  },
  {
    "start": 90.4,
    "end": 93.1,
    "text": "有没有谁是我们不知道"
  },
  {
    "start": 93.1,
    "end": 95.9,
    "text": "但是是以相同方式转生的呢"
  },
  {
    "start": 95.933,
    "end": 98.133,
    "text": "如果你是问现在"
  },
  {
    "start": 98.166,
    "end": 99.533,
    "text": "那我不可以说"
  },
  {
    "start": 99.533,
    "end": 102.766,
    "text": "过去有没有別的像耶穌的使者"
  },
  {
    "start": 102.8,
    "end": 104.066,
    "text": "当然有"
  },
  {
    "start": 104.1,
    "end": 105.933,
    "text": "这都有清楚的记录"
  },
  {
    "start": 105.933,
    "end": 107.9,
    "text": "名字无关紧要"
  },
  {
    "start": 107.933,
    "end": 110.566,
    "text": "因为人很容易忽略背后的意图"
  },
  {
    "start": 110.566,
    "end": 112.7,
    "text": "而把重点放在个体身上"
  },
  {
    "start": 112.733,
    "end": 115.066,
    "text": "过去有些名不见经传"
  },
  {
    "start": 115.066,
    "end": 117.266,
    "text": "名气虽然没有那么响亮"
  },
  {
    "start": 117.266,
    "end": 119.533,
    "text": "但也来自相同层面的灵魂"
  },
  {
    "start": 119.533,
    "end": 121.966,
    "text": "他们实现了自己的目的"
  },
  {
    "start": 122.0,
    "end": 123.5,
    "text": "令人敬佩"
  },
  {
    "start": 123.533,
    "end": 125.533,
    "text": "但只是不如耶穌有名"
  },
  {
    "start": 125.533,
    "end": 128.1,
    "text": "耶穌的死有何目的"
  },
  {
    "start": 128.1,
    "end": 131.366,
    "text": "他的死完全是自己的选择"
  },
  {
    "start": 131.4,
    "end": 134.533,
    "text": "《圣经》可能有不一样的见解"
  },
  {
    "start": 134.566,
    "end": 137.233,
    "text": "如果有人要相信也没有关系"
  },
  {
    "start": 137.233,
    "end": 141.066,
    "text": "但是死于人类之手及人类的意志"
  },
  {
    "start": 141.1,
    "end": 142.833,
    "text": "而不是上天的意旨"
  },
  {
    "start": 142.833,
    "end": 146.6,
    "text": "是他决定把自己交付给人类的命运"
  },
  {
    "start": 146.633,
    "end": 147.833,
    "text": "没错"
  },
  {
    "start": 147.866,
    "end": 150.2,
    "text": "《圣经》的確说耶穌表示"
  },
  {
    "start": 150.2,
    "end": 152.4,
    "text": "没有人取了他的性命"
  },
  {
    "start": 152.4,
    "end": 155.4,
    "text": "是自己的决定（指决意牺牲性命"
  },
  {
    "start": 155.4,
    "end": 157.0,
    "text": "的確如此"
  },
  {
    "start": 157.033,
    "end": 159.533,
    "text": "但这么做的目的是什么"
  },
  {
    "start": 159.566,
    "end": 161.766,
    "text": "如果你想探究目的"
  },
  {
    "start": 161.766,
    "end": 163.866,
    "text": "留意一下是谁杀了他"
  },
  {
    "start": 163.866,
    "end": 164.9,
    "text": "是人们"
  },
  {
    "start": 164.9,
    "end": 166.4,
    "text": "人们就是侩子手"
  },
  {
    "start": 166.4,
    "end": 168.266,
    "text": "这么说只是要强调"
  },
  {
    "start": 168.3,
    "end": 169.966,
    "text": "过去人类的互动层次"
  },
  {
    "start": 170.0,
    "end": 172.766,
    "text": "跟今天一样（意思是没有提升）"
  },
  {
    "start": 172.766,
    "end": 177.2,
    "text": "他的死是要向众人证明他们可以重生吗"
  },
  {
    "start": 177.2,
    "end": 180.133,
    "text": "如果大家这样才会相信的话"
  },
  {
    "start": 180.166,
    "end": 181.8,
    "text": "那就是这么回事"
  },
  {
    "start": 181.8,
    "end": 183.733,
    "text": "实际上不是"
  },
  {
    "start": 183.766,
    "end": 185.433,
    "text": "但是有象征意义"
  },
  {
    "start": 185.433,
    "end": 188.2,
    "text": "那实际上是怎么回事"
  },
  {
    "start": 188.233,
    "end": 191.066,
    "text": "耶穌必须死去这件事"
  },
  {
    "start": 191.1,
    "end": 192.666,
    "text": "无法字面解读"
  },
  {
    "start": 192.7,
    "end": 196.466,
    "text": "他就是把自己的性命交到人的手中"
  },
  {
    "start": 196.466,
    "end": 198.066,
    "text": "任凭他们处置"
  },
  {
    "start": 198.066,
    "end": 200.6,
    "text": "这个结果有详细记载"
  },
  {
    "start": 200.6,
    "end": 204.5,
    "text": "为什么选择以这么可怕的方式死去"
  },
  {
    "start": 204.5,
    "end": 206.5,
    "text": "那不是他选的"
  },
  {
    "start": 206.5,
    "end": 208.5,
    "text": "是当时的社会风气"
  },
  {
    "start": 208.533,
    "end": 210.5,
    "text": "他只是顺应罢了"
  },
  {
    "start": 210.5,
    "end": 211.9,
    "text": "如果想的话"
  },
  {
    "start": 211.9,
    "end": 214.066,
    "text": "他是有力量逃离死亡"
  },
  {
    "start": 214.1,
    "end": 216.033,
    "text": "但他选择那样的经验"
  },
  {
    "start": 216.033,
    "end": 217.466,
    "text": "我们是想瞭解"
  },
  {
    "start": 217.5,
    "end": 220.9,
    "text": "选择这样的死法是想证明什么"
  },
  {
    "start": 220.9,
    "end": 223.066,
    "text": "他有自己的动机"
  },
  {
    "start": 223.066,
    "end": 224.666,
    "text": "我不会去猜测"
  },
  {
    "start": 224.666,
    "end": 227.0,
    "text": "要是他今天还活着"
  },
  {
    "start": 227.0,
    "end": 229.6,
    "text": "类似的情况或许还会发生"
  },
  {
    "start": 229.633,
    "end": 231.366,
    "text": "他会遭到冤枉"
  },
  {
    "start": 231.366,
    "end": 233.5,
    "text": "送交刑事司法体系"
  },
  {
    "start": 233.5,
    "end": 235.266,
    "text": "然后透过注射毒液"
  },
  {
    "start": 235.3,
    "end": 238.8,
    "text": "坐电椅 枪击 上吊要他正法"
  },
  {
    "start": 238.833,
    "end": 242.833,
    "text": "钉十字架只是当时「流行」的处死方式"
  },
  {
    "start": 242.833,
    "end": 245.2,
    "text": "如果我们不瞭解原因"
  },
  {
    "start": 245.2,
    "end": 247.1,
    "text": "一切似乎就没有意义"
  },
  {
    "start": 247.133,
    "end": 249.533,
    "text": "不要向耶穌找答案"
  },
  {
    "start": 249.566,
    "end": 251.2,
    "text": "看看你们的同胞"
  },
  {
    "start": 251.2,
    "end": 253.7,
    "text": "答案在于他是被处死"
  },
  {
    "start": 253.733,
    "end": 255.766,
    "text": "重点是不公义的现象"
  },
  {
    "start": 255.766,
    "end": 258.6,
    "text": "人类对彼此不公不义"
  },
  {
    "start": 258.6,
    "end": 260.0,
    "text": "你是这个意思吗"
  },
  {
    "start": 260.0,
    "end": 261.2,
    "text": "没错"
  },
  {
    "start": 261.233,
    "end": 262.1,
    "text": "嗯"
  },
  {
    "start": 262.133,
    "end": 264.633,
    "text": "耶穌为人类的罪而死"
  },
  {
    "start": 264.633,
    "end": 266.866,
    "text": "这种说法流传至今"
  },
  {
    "start": 266.866,
    "end": 268.666,
    "text": "你瞭解这个概念吗"
  },
  {
    "start": 268.666,
    "end": 271.6,
    "text": "这不过是將他的死合理化"
  },
  {
    "start": 271.6,
    "end": 273.6,
    "text": "这个说法在《圣经》里"
  },
  {
    "start": 273.633,
    "end": 275.933,
    "text": "以非常初浅的方式解释"
  },
  {
    "start": 275.933,
    "end": 278.7,
    "text": "必须要有更宽广的理解力"
  },
  {
    "start": 278.733,
    "end": 282.433,
    "text": "才能瞭解整个生命历程和耶穌的体验"
  },
  {
    "start": 282.433,
    "end": 285.033,
    "text": "许多常见且既定的信仰"
  },
  {
    "start": 285.033,
    "end": 287.633,
    "text": "对真正的理解会有阻碍"
  },
  {
    "start": 287.666,
    "end": 291.3,
    "text": "坚守那样的想法无法让人在觉知上成长"
  },
  {
    "start": 291.333,
    "end": 294.2,
    "text": "或是更明白哲学思想的真正功能"
  },
  {
    "start": 294.233,
    "end": 298.2,
    "text": "圣经旧约常说到「圣灵」（Holy Ghost）"
  },
  {
    "start": 298.2,
    "end": 302.1,
    "text": "而在新约的圣灵则常用Holy Spirit"
  },
  {
    "start": 302.1,
    "end": 304.9,
    "text": "圣灵是来自上帝的灵"
  },
  {
    "start": 304.9,
    "end": 306.566,
    "text": "它可以帮助大家"
  },
  {
    "start": 306.6,
    "end": 309.2,
    "text": "我想瞭解更多细节"
  },
  {
    "start": 309.2,
    "end": 310.666,
    "text": "以及运作的机制"
  },
  {
    "start": 310.666,
    "end": 312.166,
    "text": "在我们看来"
  },
  {
    "start": 312.2,
    "end": 315.466,
    "text": "你的意识在试着瞭解上帝本质的一面"
  },
  {
    "start": 315.466,
    "end": 318.7,
    "text": "却不清楚你们所说的「上帝」有不同面向"
  },
  {
    "start": 318.7,
    "end": 320.766,
    "text": "也就是所谓的三位一体"
  },
  {
    "start": 320.766,
    "end": 323.666,
    "text": "圣父 圣灵 圣子"
  },
  {
    "start": 323.7,
    "end": 324.833,
    "text": "但是"
  },
  {
    "start": 324.833,
    "end": 327.733,
    "text": "要你们的意识去理解圣灵的概念"
  },
  {
    "start": 327.766,
    "end": 330.333,
    "text": "就像瞭解圣父的概念一样困难"
  },
  {
    "start": 330.366,
    "end": 331.466,
    "text": "总之"
  },
  {
    "start": 331.5,
    "end": 333.9,
    "text": "这个灵的本质就是能量"
  },
  {
    "start": 333.9,
    "end": 335.966,
    "text": "与其说是生命形式"
  },
  {
    "start": 336.0,
    "end": 337.833,
    "text": "不如说是生命力量"
  },
  {
    "start": 337.866,
    "end": 340.366,
    "text": "或许也可以说是生命的维持"
  },
  {
    "start": 340.366,
    "end": 342.4,
    "text": "也就是指生命的本质"
  },
  {
    "start": 342.4,
    "end": 344.6,
    "text": "而非充满这个生命的人格"
  },
  {
    "start": 344.633,
    "end": 346.4,
    "text": "没有灵魂"
  },
  {
    "start": 346.4,
    "end": 348.2,
    "text": "人有可能存活吗"
  },
  {
    "start": 348.233,
    "end": 349.4,
    "text": "不行"
  },
  {
    "start": 349.4,
    "end": 350.666,
    "text": "没有生命"
  },
  {
    "start": 350.666,
    "end": 352.566,
    "text": "人格要怎么活下去"
  },
  {
    "start": 352.566,
    "end": 354.866,
    "text": "生命有不同的层面"
  },
  {
    "start": 354.866,
    "end": 356.366,
    "text": "有肉体生活"
  },
  {
    "start": 356.4,
    "end": 357.866,
    "text": "也有灵魂生活"
  },
  {
    "start": 357.9,
    "end": 361.0,
    "text": "生命是延续个人意识的要素"
  },
  {
    "start": 361.0,
    "end": 363.233,
    "text": "在你们的层级就是人格"
  },
  {
    "start": 363.233,
    "end": 367.333,
    "text": "所以你的意思是灵魂就是生命本身"
  },
  {
    "start": 367.366,
    "end": 370.166,
    "text": "这么说我们就能明白"
  },
  {
    "start": 370.2,
    "end": 373.833,
    "text": "如果要用你们能够瞭解的字汇来解释"
  },
  {
    "start": 373.833,
    "end": 375.766,
    "text": "这么说应该算准确"
  },
  {
    "start": 375.8,
    "end": 377.0,
    "text": "因此"
  },
  {
    "start": 377.033,
    "end": 379.233,
    "text": "教会说的三位一体"
  },
  {
    "start": 379.233,
    "end": 382.766,
    "text": "其实比想像中更贴近真实的概念"
  },
  {
    "start": 382.766,
    "end": 384.833,
    "text": "它们彼此分开"
  },
  {
    "start": 384.866,
    "end": 387.9,
    "text": "就如我们与上帝分开一样"
  },
  {
    "start": 387.933,
    "end": 389.833,
    "text": "然而同时又是一体"
  },
  {
    "start": 389.833,
    "end": 393.266,
    "text": "它们是同样东西的不同形式"
  },
  {
    "start": 393.3,
    "end": 396.6,
    "text": "但是这个概念已经用简化的言语形容"
  },
  {
    "start": 396.633,
    "end": 398.933,
    "text": "以方便人类的心智理解"
  },
  {
    "start": 398.933,
    "end": 402.6,
    "text": "要人们想像上帝是能量很难"
  },
  {
    "start": 402.633,
    "end": 404.966,
    "text": "因此在过去赋予上帝人格"
  },
  {
    "start": 405.0,
    "end": 406.733,
    "text": "就容易理解多了"
  },
  {
    "start": 406.733,
    "end": 409.266,
    "text": "从我得到的资讯来看"
  },
  {
    "start": 409.3,
    "end": 412.233,
    "text": "圣灵和上帝本质上是一样的"
  },
  {
    "start": 412.233,
    "end": 414.433,
    "text": "它们是遍布一切的生命力"
  },
  {
    "start": 414.466,
    "end": 416.466,
    "text": "不论少了哪一个"
  },
  {
    "start": 416.5,
    "end": 418.4,
    "text": "都不会有生命"
  },
  {
    "start": 418.433,
    "end": 420.933,
    "text": "因为那就是驱动生命的能量"
  },
  {
    "start": 420.933,
    "end": 422.066,
    "text": "因此"
  },
  {
    "start": 422.066,
    "end": 425.266,
    "text": "教会说我们要让圣灵进入我们的心"
  },
  {
    "start": 425.3,
    "end": 427.3,
    "text": "这句话就有矛盾"
  },
  {
    "start": 427.3,
    "end": 429.433,
    "text": "因为圣灵早在里面了"
  },
  {
    "start": 429.466,
    "end": 432.266,
    "text": "少了这个圣灵便没有生命"
  },
  {
    "start": 432.266,
    "end": 433.833,
    "text": "暮雨批注"
  },
  {
    "start": 433.833,
    "end": 437.733,
    "text": "教会说我们要让圣灵进入我们的心"
  },
  {
    "start": 437.766,
    "end": 439.7,
    "text": "暮雨有自己的理解"
  },
  {
    "start": 439.7,
    "end": 442.433,
    "text": "圣灵和上帝的生命原始驱动力"
  },
  {
    "start": 442.466,
    "end": 444.766,
    "text": "确实一直都在我们的身体里"
  },
  {
    "start": 444.766,
    "end": 448.166,
    "text": "也许就是储存在脊柱底部的昆达里尼能量"
  },
  {
    "start": 448.2,
    "end": 451.233,
    "text": "但也许还有其它层面的生命力"
  },
  {
    "start": 451.233,
    "end": 453.233,
    "text": "在我们刚出生时"
  },
  {
    "start": 453.266,
    "end": 456.3,
    "text": "那股原始的生命力处于最纯洁"
  },
  {
    "start": 456.3,
    "end": 459.166,
    "text": "最接近上帝和圣灵的活动状态"
  },
  {
    "start": 459.2,
    "end": 463.1,
    "text": "但随着我们在这个世界上受到的各种影响"
  },
  {
    "start": 463.1,
    "end": 465.6,
    "text": "这股生命力可能被压制"
  },
  {
    "start": 465.633,
    "end": 469.166,
    "text": "我们身体与精神的各个层面的能量阻塞"
  },
  {
    "start": 469.2,
    "end": 471.1,
    "text": "能量无法自然流动"
  },
  {
    "start": 471.1,
    "end": 473.033,
    "text": "旧的能量无法释放"
  },
  {
    "start": 473.033,
    "end": 475.133,
    "text": "新的能量也不得进入"
  },
  {
    "start": 475.133,
    "end": 477.166,
    "text": "我们的原始生命力"
  },
  {
    "start": 477.2,
    "end": 479.8,
    "text": "就这样逐渐失去了原初的活力"
  },
  {
    "start": 479.833,
    "end": 481.0,
    "text": "因此"
  },
  {
    "start": 481.0,
    "end": 483.333,
    "text": "让圣灵进入我们的心"
  },
  {
    "start": 483.333,
    "end": 486.7,
    "text": "可以理解为让宇宙原初的生命驱动力"
  },
  {
    "start": 486.733,
    "end": 489.333,
    "text": "再次在我们身体里流动起来"
  },
  {
    "start": 489.333,
    "end": 492.466,
    "text": "而心是物质身体与灵魂能量的连接点"
  },
  {
    "start": 492.466,
    "end": 494.166,
    "text": "敞开心也意味着"
  },
  {
    "start": 494.166,
    "end": 497.233,
    "text": "排除这个连接点的能量堵塞"
  },
  {
    "start": 497.233,
    "end": 499.733,
    "text": "让生命力能再次自然流动"
  }
]