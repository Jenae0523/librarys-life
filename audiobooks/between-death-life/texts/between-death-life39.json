[
  {
    "start": 0.0,
    "end": 1.866,
    "text": "《生死之间》"
  },
  {
    "start": 1.866,
    "end": 3.533,
    "text": "灵魂替换者"
  },
  {
    "start": 3.533,
    "end": 6.166,
    "text": "作者 朵洛莉丝·侃南"
  },
  {
    "start": 6.2,
    "end": 9.666,
    "text": "这次灵魂替换者的催眠经验"
  },
  {
    "start": 9.666,
    "end": 11.9,
    "text": "完全是在预期外发生"
  },
  {
    "start": 11.9,
    "end": 13.2,
    "text": "然而"
  },
  {
    "start": 13.233,
    "end": 16.033,
    "text": "这种事也从来就没办法预料"
  },
  {
    "start": 16.033,
    "end": 19.333,
    "text": "每当回溯个案到出生经验"
  },
  {
    "start": 19.366,
    "end": 21.333,
    "text": "大多数人重新体验的"
  },
  {
    "start": 21.333,
    "end": 24.4,
    "text": "都是以传统方式来到这个世界"
  },
  {
    "start": 24.4,
    "end": 27.0,
    "text": "因此我对这次完全不同的"
  },
  {
    "start": 27.033,
    "end": 29.8,
    "text": "进入肉体的方式毫无准备"
  },
  {
    "start": 29.8,
    "end": 33.233,
    "text": "这次的个案是一位年轻女性"
  },
  {
    "start": 33.233,
    "end": 37.0,
    "text": "在催眠前她已告诉我她的出生故事"
  },
  {
    "start": 37.033,
    "end": 41.766,
    "text": "她説她一度死于母亲在家生产的时候"
  },
  {
    "start": 41.766,
    "end": 43.5,
    "text": "医生努力了"
  },
  {
    "start": 43.533,
    "end": 46.1,
    "text": "但没办法把她救回来"
  },
  {
    "start": 46.1,
    "end": 49.4,
    "text": "于是医生把她瘫软的身体放到一旁"
  },
  {
    "start": 49.433,
    "end": 51.533,
    "text": "转而去照顾她母亲"
  },
  {
    "start": 51.533,
    "end": 54.0,
    "text": "而她之所以现在还活着"
  },
  {
    "start": 54.0,
    "end": 56.366,
    "text": "完全是因为阿姨的帮助"
  },
  {
    "start": 56.4,
    "end": 59.4,
    "text": "虽然医生已经宣告无救"
  },
  {
    "start": 59.4,
    "end": 61.366,
    "text": "阿姨仍花了好几分钟"
  },
  {
    "start": 61.366,
    "end": 63.766,
    "text": "抢救这个没有生命的身体"
  },
  {
    "start": 63.8,
    "end": 66.1,
    "text": "后来终于听到微弱的哭声"
  },
  {
    "start": 66.1,
    "end": 68.666,
    "text": "这个年轻女子听这个故事"
  },
  {
    "start": 68.7,
    "end": 70.4,
    "text": "已经听了一辈子"
  },
  {
    "start": 70.4,
    "end": 72.566,
    "text": "她的家人都觉得"
  },
  {
    "start": 72.6,
    "end": 75.033,
    "text": "要不是阿姨的契而不舍"
  },
  {
    "start": 75.066,
    "end": 77.166,
    "text": "她今天就不会还活着了"
  },
  {
    "start": 77.2,
    "end": 80.2,
    "text": "我想带她回到出生的时候"
  },
  {
    "start": 80.2,
    "end": 82.9,
    "text": "看看到底发生了什么事"
  },
  {
    "start": 82.933,
    "end": 86.633,
    "text": "因为个案向来能从这样的回溯获益良多"
  },
  {
    "start": 86.666,
    "end": 90.466,
    "text": "灵魂对母亲怀孕期间和他们出生前"
  },
  {
    "start": 90.5,
    "end": 93.2,
    "text": "所发生的一切完全清楚"
  },
  {
    "start": 93.2,
    "end": 95.366,
    "text": "透过回溯这样的经验"
  },
  {
    "start": 95.4,
    "end": 98.333,
    "text": "能让他们更了解家人的情绪和态度"
  },
  {
    "start": 98.333,
    "end": 101.7,
    "text": "我带过许多个案回溯出生经验"
  },
  {
    "start": 101.7,
    "end": 103.366,
    "text": "所以我能確定"
  },
  {
    "start": 103.4,
    "end": 104.9,
    "text": "出生的时候"
  },
  {
    "start": 104.9,
    "end": 106.766,
    "text": "这位年轻女子的灵魂"
  },
  {
    "start": 106.8,
    "end": 109.066,
    "text": "根本不在宝宝的身体里"
  },
  {
    "start": 109.066,
    "end": 111.266,
    "text": "她因为某个原因延误了"
  },
  {
    "start": 111.266,
    "end": 112.566,
    "text": "或许"
  },
  {
    "start": 112.6,
    "end": 115.966,
    "text": "她还在另一个层面的学校与老师説话"
  },
  {
    "start": 116.0,
    "end": 117.6,
    "text": "来不及回来"
  },
  {
    "start": 117.6,
    "end": 119.066,
    "text": "也或许"
  },
  {
    "start": 119.1,
    "end": 122.033,
    "text": "她对于进入这个生命有些怀疑"
  },
  {
    "start": 122.033,
    "end": 124.433,
    "text": "老师们必须更努力说服她"
  },
  {
    "start": 124.433,
    "end": 128.733,
    "text": "灵魂常常在规划地球学校课程的时候"
  },
  {
    "start": 128.766,
    "end": 130.866,
    "text": "尝试清除太多的业"
  },
  {
    "start": 130.866,
    "end": 133.566,
    "text": "于是他们会开始怀疑"
  },
  {
    "start": 133.566,
    "end": 135.366,
    "text": "负担会不会太重"
  },
  {
    "start": 135.366,
    "end": 137.9,
    "text": "这就像申请大学"
  },
  {
    "start": 137.9,
    "end": 141.466,
    "text": "有些必修课会比轻松的选修课困难"
  },
  {
    "start": 141.5,
    "end": 142.9,
    "text": "学生会开始发觉"
  },
  {
    "start": 142.9,
    "end": 145.5,
    "text": "自己承担的多过自己的能力"
  },
  {
    "start": 145.533,
    "end": 148.4,
    "text": "进入一个生命也是如此"
  },
  {
    "start": 148.4,
    "end": 151.2,
    "text": "在规划时总是看似容易"
  },
  {
    "start": 151.233,
    "end": 154.233,
    "text": "而往往当业的关系安排好后"
  },
  {
    "start": 154.266,
    "end": 156.233,
    "text": "灵魂已来不及反悔"
  },
  {
    "start": 156.233,
    "end": 158.8,
    "text": "由于她出生时的状况"
  },
  {
    "start": 158.8,
    "end": 161.633,
    "text": "我没有请她回到出生的时候"
  },
  {
    "start": 161.666,
    "end": 162.9,
    "text": "而是请她回到"
  },
  {
    "start": 162.9,
    "end": 165.966,
    "text": "进入现在跟我说话的这个肉体的那一刻"
  },
  {
    "start": 166.0,
    "end": 167.3,
    "text": "也许"
  },
  {
    "start": 167.333,
    "end": 170.166,
    "text": "就是我的用词触发了这次事件"
  },
  {
    "start": 170.2,
    "end": 172.2,
    "text": "我数到三后"
  },
  {
    "start": 172.2,
    "end": 173.733,
    "text": "问她在做什么"
  },
  {
    "start": 173.733,
    "end": 175.233,
    "text": "我在观察"
  },
  {
    "start": 175.233,
    "end": 177.9,
    "text": "我没有感到惊讶"
  },
  {
    "start": 177.9,
    "end": 180.833,
    "text": "因为我知道她不会在婴儿的身体里"
  },
  {
    "start": 180.866,
    "end": 182.466,
    "text": "你在哪里"
  },
  {
    "start": 182.466,
    "end": 183.8,
    "text": "在床脚"
  },
  {
    "start": 183.8,
    "end": 186.1,
    "text": "（她深吸了一口气）"
  },
  {
    "start": 186.133,
    "end": 188.666,
    "text": "我正准备进入这个身体"
  },
  {
    "start": 188.666,
    "end": 189.7,
    "text": "不再离开"
  },
  {
    "start": 189.733,
    "end": 193.2,
    "text": "在这之前都只是  短暂停留"
  },
  {
    "start": 193.2,
    "end": 195.433,
    "text": "你説婴儿的身体吗"
  },
  {
    "start": 195.466,
    "end": 196.666,
    "text": "不"
  },
  {
    "start": 196.7,
    "end": 198.433,
    "text": "不是婴儿的身体"
  },
  {
    "start": 198.433,
    "end": 199.433,
    "text": "是成人"
  },
  {
    "start": 199.466,
    "end": 201.566,
    "text": "我吓了一大跳"
  },
  {
    "start": 201.6,
    "end": 203.666,
    "text": "完全没有心理准备"
  },
  {
    "start": 203.666,
    "end": 205.633,
    "text": "这是什么意思"
  },
  {
    "start": 205.666,
    "end": 209.866,
    "text": "你是说你进入的不是刚出生的婴儿身体"
  },
  {
    "start": 209.9,
    "end": 210.9,
    "text": "不是"
  },
  {
    "start": 210.9,
    "end": 213.0,
    "text": "这并不寻常吧"
  },
  {
    "start": 213.033,
    "end": 214.733,
    "text": "是不寻常"
  },
  {
    "start": 214.733,
    "end": 217.666,
    "text": "但渐渐开始变得比大家想像中常见"
  },
  {
    "start": 217.666,
    "end": 218.866,
    "text": "你説"
  },
  {
    "start": 218.9,
    "end": 222.766,
    "text": "在这之前你进到这个身体的时间都很短"
  },
  {
    "start": 222.766,
    "end": 224.733,
    "text": "这是什么意思"
  },
  {
    "start": 224.766,
    "end": 226.866,
    "text": "灵魂交换了"
  },
  {
    "start": 226.866,
    "end": 228.666,
    "text": "有点像试用期"
  },
  {
    "start": 228.666,
    "end": 230.4,
    "text": "决定要不要让渡身体"
  },
  {
    "start": 230.433,
    "end": 233.133,
    "text": "看她是否要接受自己要求的事"
  },
  {
    "start": 233.166,
    "end": 235.166,
    "text": "这是她要求的"
  },
  {
    "start": 235.166,
    "end": 236.333,
    "text": "对"
  },
  {
    "start": 236.366,
    "end": 238.5,
    "text": "是经由要求发生的"
  },
  {
    "start": 238.5,
    "end": 240.9,
    "text": "另一个灵魂觉得自己的时间到了"
  },
  {
    "start": 240.933,
    "end": 243.8,
    "text": "我不太能接受她讲的事"
  },
  {
    "start": 243.8,
    "end": 246.033,
    "text": "听起来很像「灵魂替换」"
  },
  {
    "start": 246.066,
    "end": 250.066,
    "text": "这是露丝•蒙哥马利著作里出现的词汇"
  },
  {
    "start": 250.1,
    "end": 252.166,
    "text": "后来被大家广泛使用"
  },
  {
    "start": 252.166,
    "end": 253.966,
    "text": "它大致的意思是指"
  },
  {
    "start": 253.966,
    "end": 256.866,
    "text": "灵魂「进入」某个活着的身体"
  },
  {
    "start": 256.9,
    "end": 259.0,
    "text": "而不是出生为婴见"
  },
  {
    "start": 259.033,
    "end": 261.9,
    "text": "我在之前的回溯催眠中"
  },
  {
    "start": 261.9,
    "end": 263.933,
    "text": "只遇过一次这个现象"
  },
  {
    "start": 263.933,
    "end": 267.633,
    "text": "那次是灵魂进入生了重病的孩子身体"
  },
  {
    "start": 267.666,
    "end": 271.333,
    "text": "原本在身体里的灵魂想要离开"
  },
  {
    "start": 271.333,
    "end": 273.466,
    "text": "于是出现了「换灵」现象"
  },
  {
    "start": 273.5,
    "end": 278.533,
    "text": "那次催眠疗程是在一九六〇年间进行"
  },
  {
    "start": 278.566,
    "end": 281.366,
    "text": "那时根本还没有「换灵者」这个词呢"
  },
  {
    "start": 281.366,
    "end": 284.666,
    "text": "（这个事件记载在《五世记忆》这本书里"
  },
  {
    "start": 284.7,
    "end": 286.166,
    "text": "为什么"
  },
  {
    "start": 286.166,
    "end": 287.8,
    "text": "发生什么事了吗"
  },
  {
    "start": 287.8,
    "end": 290.5,
    "text": "灵魂替换的原因是什么"
  },
  {
    "start": 290.533,
    "end": 294.833,
    "text": "她以为自己能够承担她这世要处理的问题"
  },
  {
    "start": 294.866,
    "end": 297.066,
    "text": "当她发现力不从心时"
  },
  {
    "start": 297.1,
    "end": 298.4,
    "text": "她要求回去"
  },
  {
    "start": 298.4,
    "end": 300.266,
    "text": "你可以解释吗"
  },
  {
    "start": 300.266,
    "end": 304.4,
    "text": "（深呼吸）她没有她以为有的能力"
  },
  {
    "start": 304.4,
    "end": 307.4,
    "text": "因此她要求脱离这样的处境"
  },
  {
    "start": 307.4,
    "end": 309.6,
    "text": "如果身体死了"
  },
  {
    "start": 309.6,
    "end": 311.133,
    "text": "不是也脱离了吗"
  },
  {
    "start": 311.166,
    "end": 312.8,
    "text": "没错"
  },
  {
    "start": 312.8,
    "end": 315.6,
    "text": "可是如果另一个灵魂可以接替"
  },
  {
    "start": 315.6,
    "end": 317.9,
    "text": "并且做许多有益的事"
  },
  {
    "start": 317.9,
    "end": 320.033,
    "text": "那为什么要让这个身体死去"
  },
  {
    "start": 320.066,
    "end": 322.733,
    "text": "是灵魂认为自己没办法解决"
  },
  {
    "start": 322.766,
    "end": 325.066,
    "text": "自己选择要处理的业"
  },
  {
    "start": 325.1,
    "end": 326.966,
    "text": "因此决定要离开身体"
  },
  {
    "start": 326.966,
    "end": 330.466,
    "text": "而这个身体  还不到死亡的时候"
  },
  {
    "start": 330.5,
    "end": 331.966,
    "text": "身体必须继续"
  },
  {
    "start": 331.966,
    "end": 334.166,
    "text": "当发生这样的情形"
  },
  {
    "start": 334.2,
    "end": 336.333,
    "text": "身体会继续运作"
  },
  {
    "start": 336.333,
    "end": 338.433,
    "text": "好让下一个灵魂可以进入"
  },
  {
    "start": 338.466,
    "end": 342.133,
    "text": "当灵魂想离开或是违背合约"
  },
  {
    "start": 342.133,
    "end": 344.4,
    "text": "做这样的事不会被责骂吗"
  },
  {
    "start": 344.433,
    "end": 346.566,
    "text": "这不是违背合约"
  },
  {
    "start": 346.6,
    "end": 348.666,
    "text": "只是灵魂知道自己的状态"
  },
  {
    "start": 348.666,
    "end": 351.766,
    "text": "因为我们这一边的世界非常清楚"
  },
  {
    "start": 351.8,
    "end": 354.2,
    "text": "也知道不是一切都能照计划走"
  },
  {
    "start": 354.233,
    "end": 357.733,
    "text": "所以这纯粹是这种情况的理想解决方法"
  },
  {
    "start": 357.733,
    "end": 360.933,
    "text": "我们赞同这个载具的灵魂替换"
  },
  {
    "start": 360.966,
    "end": 362.8,
    "text": "因为令人钦佩且高尚"
  },
  {
    "start": 362.833,
    "end": 365.533,
    "text": "这比让身体死去要有效益"
  },
  {
    "start": 365.533,
    "end": 366.7,
    "text": "而且有帮助"
  },
  {
    "start": 366.733,
    "end": 368.7,
    "text": "身体死去的话"
  },
  {
    "start": 368.7,
    "end": 370.433,
    "text": "就不能再使用"
  },
  {
    "start": 370.466,
    "end": 373.2,
    "text": "不能用来做好事或进行工作了"
  },
  {
    "start": 373.2,
    "end": 375.866,
    "text": "如果她取走身体的性命才会"
  },
  {
    "start": 375.866,
    "end": 377.766,
    "text": "你是説自杀吗"
  },
  {
    "start": 377.8,
    "end": 381.666,
    "text": "我想了解灵魂替换和自杀有什么不同"
  },
  {
    "start": 381.666,
    "end": 384.6,
    "text": "是因为自杀会破坏身体吗"
  },
  {
    "start": 384.633,
    "end": 385.9,
    "text": "对"
  },
  {
    "start": 385.9,
    "end": 387.433,
    "text": "但这只是移转身体"
  },
  {
    "start": 387.466,
    "end": 390.133,
    "text": "给另一个会做好事的灵魂"
  },
  {
    "start": 390.133,
    "end": 392.0,
    "text": "这没有造成伤害"
  },
  {
    "start": 392.033,
    "end": 394.133,
    "text": "也不会有人觉得这个灵魂不好"
  },
  {
    "start": 394.133,
    "end": 396.6,
    "text": "这个交换是双方都同意的"
  },
  {
    "start": 396.6,
    "end": 399.0,
    "text": "所以自杀会被责骂"
  },
  {
    "start": 399.0,
    "end": 400.233,
    "text": "对"
  },
  {
    "start": 400.266,
    "end": 403.666,
    "text": "不只是因为身体还没有人接手就报废了"
  },
  {
    "start": 403.666,
    "end": 406.2,
    "text": "灵魂能量的和谐也会被干扰"
  },
  {
    "start": 406.2,
    "end": 408.533,
    "text": "这种行为是难以原谅的"
  },
  {
    "start": 408.566,
    "end": 411.9,
    "text": "因为那个身体有必须完成的事"
  },
  {
    "start": 411.9,
    "end": 413.266,
    "text": "但却中断了"
  },
  {
    "start": 413.3,
    "end": 414.433,
    "text": "没错"
  },
  {
    "start": 414.433,
    "end": 416.633,
    "text": "让我困惑的是"
  },
  {
    "start": 416.633,
    "end": 418.433,
    "text": "这听起来好像附身"
  },
  {
    "start": 418.466,
    "end": 421.833,
    "text": "最近有很多像《大法师》的电影"
  },
  {
    "start": 421.833,
    "end": 424.166,
    "text": "让这个概念变得很可怕"
  },
  {
    "start": 424.2,
    "end": 426.233,
    "text": "那是不一样的"
  },
  {
    "start": 426.233,
    "end": 430.333,
    "text": "附身是乖戾的灵魂想要控制另一个灵魂"
  },
  {
    "start": 430.366,
    "end": 433.766,
    "text": "但在灵魂替换的情况并没有控制的问题"
  },
  {
    "start": 433.8,
    "end": 435.933,
    "text": "身体里只有一个灵魂"
  },
  {
    "start": 435.933,
    "end": 439.933,
    "text": "原本的灵魂必须放弃\\让渡这个身体"
  },
  {
    "start": 439.966,
    "end": 442.366,
    "text": "另一个灵魂才能进入"
  },
  {
    "start": 442.4,
    "end": 444.6,
    "text": "这是双方完全同意的行为"
  },
  {
    "start": 444.6,
    "end": 447.8,
    "text": "而附身却是没有获得同意的占据"
  },
  {
    "start": 447.8,
    "end": 452.766,
    "text": "后来我从別的个案也听到这个主题的类似説法"
  },
  {
    "start": 452.766,
    "end": 455.633,
    "text": "你听过「灵魂替换者」这个词吗"
  },
  {
    "start": 455.666,
    "end": 457.9,
    "text": "那是正確的说法"
  },
  {
    "start": 457.9,
    "end": 459.766,
    "text": "你可以解释吗"
  },
  {
    "start": 459.8,
    "end": 461.5,
    "text": "我们之前提过"
  },
  {
    "start": 461.5,
    "end": 464.666,
    "text": "等待转世的灵魂比可用的身体还多"
  },
  {
    "start": 464.666,
    "end": 465.833,
    "text": "有时候"
  },
  {
    "start": 465.833,
    "end": 469.2,
    "text": "灵魂会不想再以肉体的方式存在"
  },
  {
    "start": 469.2,
    "end": 471.0,
    "text": "物质世界的重担与烦恼"
  },
  {
    "start": 471.033,
    "end": 473.133,
    "text": "已让灵魂无法再撑下去"
  },
  {
    "start": 473.133,
    "end": 475.0,
    "text": "于是这个灵魂就被给予"
  },
  {
    "start": 475.033,
    "end": 476.9,
    "text": "过渡到「另一边」的机会"
  },
  {
    "start": 476.933,
    "end": 478.1,
    "text": "接着"
  },
  {
    "start": 478.1,
    "end": 479.866,
    "text": "灵魂世界的某个灵魂"
  },
  {
    "start": 479.9,
    "end": 481.833,
    "text": "就有机会进入那个身体"
  },
  {
    "start": 481.833,
    "end": 484.266,
    "text": "这就像是交换位置"
  },
  {
    "start": 484.3,
    "end": 486.333,
    "text": "对双方来説都有好处"
  },
  {
    "start": 486.333,
    "end": 490.1,
    "text": "原本的灵魂回到了他真正的家"
  },
  {
    "start": 490.1,
    "end": 491.933,
    "text": "而那个灵界过来的灵魂"
  },
  {
    "start": 491.933,
    "end": 493.7,
    "text": "得到了载具来处理业"
  },
  {
    "start": 493.7,
    "end": 496.566,
    "text": "如果灵魂想回到灵界"
  },
  {
    "start": 496.6,
    "end": 499.366,
    "text": "为什么不能让身体直接死亡"
  },
  {
    "start": 499.366,
    "end": 501.966,
    "text": "这样就会浪费了那个载具"
  },
  {
    "start": 501.966,
    "end": 503.133,
    "text": "那具身体"
  },
  {
    "start": 503.133,
    "end": 506.233,
    "text": "而且往往要考虑到时间因素"
  },
  {
    "start": 506.266,
    "end": 507.366,
    "text": "比如说"
  },
  {
    "start": 507.4,
    "end": 508.966,
    "text": "假设原本的灵魂"
  },
  {
    "start": 508.966,
    "end": 511.066,
    "text": "必须和太太处理一段关系"
  },
  {
    "start": 511.1,
    "end": 514.266,
    "text": "后来先生发现自己无法负荷"
  },
  {
    "start": 514.266,
    "end": 515.966,
    "text": "于是回到了灵界"
  },
  {
    "start": 515.966,
    "end": 520.233,
    "text": "进入身体的那个新灵魂就必须负起责任"
  },
  {
    "start": 520.266,
    "end": 522.766,
    "text": "与太太共同处理那个业力事项"
  },
  {
    "start": 522.766,
    "end": 526.066,
    "text": "要完成了先前同意的工作之后"
  },
  {
    "start": 526.1,
    "end": 527.733,
    "text": "这个新进入的存在体"
  },
  {
    "start": 527.733,
    "end": 530.133,
    "text": "才可以开始进行自己的工作和业"
  },
  {
    "start": 530.133,
    "end": 534.033,
    "text": "所以他必须答应完成先前灵魂要做的事"
  },
  {
    "start": 534.066,
    "end": 535.333,
    "text": "没错"
  },
  {
    "start": 535.333,
    "end": 537.133,
    "text": "如果没有双方的同意"
  },
  {
    "start": 537.166,
    "end": 539.166,
    "text": "就不能进行灵魂交换"
  },
  {
    "start": 539.2,
    "end": 541.0,
    "text": "一方要交付业"
  },
  {
    "start": 541.0,
    "end": 543.0,
    "text": "另一方则承担那些业"
  },
  {
    "start": 543.0,
    "end": 546.5,
    "text": "你说这种现象变得越来越常见"
  },
  {
    "start": 546.533,
    "end": 547.433,
    "text": "为什么"
  },
  {
    "start": 547.466,
    "end": 550.466,
    "text": "住在地球的压力变得太大吗"
  },
  {
    "start": 550.5,
    "end": 551.6,
    "text": "对"
  },
  {
    "start": 551.6,
    "end": 554.933,
    "text": "灵魂替换现象的原因之一是时间不够"
  },
  {
    "start": 554.966,
    "end": 556.1,
    "text": "载具也不够"
  },
  {
    "start": 556.1,
    "end": 557.366,
    "text": "另一方面"
  },
  {
    "start": 557.4,
    "end": 559.5,
    "text": "进入身体的新灵魂"
  },
  {
    "start": 559.5,
    "end": 562.3,
    "text": "在新的身体里不需经历出生的创伤"
  },
  {
    "start": 562.333,
    "end": 564.233,
    "text": "或孩童时期的创伤"
  },
  {
    "start": 564.233,
    "end": 567.6,
    "text": "也不用花上好些年等待身体成熟运作"
  },
  {
    "start": 567.633,
    "end": 570.4,
    "text": "他们有很强的心灵能力"
  },
  {
    "start": 570.4,
    "end": 573.566,
    "text": "比较容易接受来自灵魂世界的影响"
  },
  {
    "start": 573.6,
    "end": 575.933,
    "text": "因为从另一个世界带来的记忆与能力"
  },
  {
    "start": 575.933,
    "end": 577.766,
    "text": "都还很清晰和活跃"
  },
  {
    "start": 577.8,
    "end": 581.2,
    "text": "如果可以不必经历出生和孩童时期"
  },
  {
    "start": 581.2,
    "end": 583.5,
    "text": "不必忘掉之前的所有记忆"
  },
  {
    "start": 583.533,
    "end": 585.733,
    "text": "那么这不是最理想的方式吗"
  },
  {
    "start": 585.766,
    "end": 589.166,
    "text": "这样就能透过他们做许多有益的事"
  },
  {
    "start": 589.2,
    "end": 592.766,
    "text": "这种对灵魂世界保持开放的态度"
  },
  {
    "start": 592.8,
    "end": 596.0,
    "text": "不论是在现在或未来都非常需要"
  },
  {
    "start": 596.0,
    "end": 599.366,
    "text": "这些是要引导其他人进入新地球的灵魂"
  },
  {
    "start": 599.4,
    "end": 601.766,
    "text": "灵魂替换者带来的能量"
  },
  {
    "start": 601.766,
    "end": 603.933,
    "text": "也会影响周遭的人"
  },
  {
    "start": 603.933,
    "end": 606.5,
    "text": "通常是表面上看不出的影响"
  },
  {
    "start": 606.533,
    "end": 608.833,
    "text": "因此许多重要的工作"
  },
  {
    "start": 608.833,
    "end": 611.366,
    "text": "就是透过灵魂替换而完成的"
  },
  {
    "start": 611.4,
    "end": 614.966,
    "text": "回到前面被替换灵魂的女孩的案例"
  },
  {
    "start": 614.966,
    "end": 616.833,
    "text": "我问个案的灵魂"
  },
  {
    "start": 616.833,
    "end": 618.2,
    "text": "灵魂的替换"
  },
  {
    "start": 618.233,
    "end": 620.2,
    "text": "是在哪里决定和討论的"
  },
  {
    "start": 620.2,
    "end": 621.9,
    "text": "在灵界"
  },
  {
    "start": 621.933,
    "end": 624.666,
    "text": "我们会跟灵界的老师討论并做决定"
  },
  {
    "start": 624.666,
    "end": 628.666,
    "text": "我纳闷这个身体的人格会不会有意见"
  },
  {
    "start": 628.7,
    "end": 631.366,
    "text": "这个女孩想必并不知道"
  },
  {
    "start": 631.366,
    "end": 633.633,
    "text": "有这么重大的决定发生"
  },
  {
    "start": 633.633,
    "end": 636.166,
    "text": "她有去哪里参与討论吗"
  },
  {
    "start": 636.2,
    "end": 637.533,
    "text": "有"
  },
  {
    "start": 637.533,
    "end": 639.166,
    "text": "当她睡着的时候"
  },
  {
    "start": 639.2,
    "end": 641.4,
    "text": "她的灵魂会出体到別的地方"
  },
  {
    "start": 641.4,
    "end": 644.066,
    "text": "这个討论持续了很久吗"
  },
  {
    "start": 644.1,
    "end": 645.733,
    "text": "大概有两个月"
  },
  {
    "start": 645.733,
    "end": 648.533,
    "text": "你要进入的这个身体是几岁"
  },
  {
    "start": 648.566,
    "end": 649.966,
    "text": "二十一岁"
  },
  {
    "start": 649.966,
    "end": 651.766,
    "text": "二十一岁"
  },
  {
    "start": 651.8,
    "end": 653.466,
    "text": "这又吓了我一跳"
  },
  {
    "start": 653.466,
    "end": 657.633,
    "text": "我在这个女孩二十一歳生日后不久认识她"
  },
  {
    "start": 657.633,
    "end": 659.166,
    "text": "所以这表示这个改变"
  },
  {
    "start": 659.2,
    "end": 661.5,
    "text": "是在我遇见她不久前发生的"
  },
  {
    "start": 661.5,
    "end": 664.7,
    "text": "然而她跟我平常接触的一般人"
  },
  {
    "start": 664.733,
    "end": 666.366,
    "text": "并没有什么不同"
  },
  {
    "start": 666.366,
    "end": 671.0,
    "text": "所以之前的灵魂在那个身体也待了蛮久的"
  },
  {
    "start": 671.033,
    "end": 672.266,
    "text": "对"
  },
  {
    "start": 672.266,
    "end": 674.066,
    "text": "厘清了很多事"
  },
  {
    "start": 674.1,
    "end": 676.8,
    "text": "但是要处理的业实在太多了"
  },
  {
    "start": 676.8,
    "end": 678.666,
    "text": "那个灵魂没有办法完成"
  },
  {
    "start": 678.7,
    "end": 680.566,
    "text": "是因为这样"
  },
  {
    "start": 680.566,
    "end": 683.566,
    "text": "才延误了出生时进入身体的时间吗"
  },
  {
    "start": 683.6,
    "end": 686.533,
    "text": "她当时是不是在考虑自己"
  },
  {
    "start": 686.533,
    "end": 689.8,
    "text": "能否完成她给自己的所有工作"
  },
  {
    "start": 689.833,
    "end": 694.033,
    "text": "她年轻的人生已经面对过许多问题"
  },
  {
    "start": 694.066,
    "end": 695.866,
    "text": "从表面上来看"
  },
  {
    "start": 695.866,
    "end": 698.3,
    "text": "她都面对且顺利解决了"
  },
  {
    "start": 698.333,
    "end": 700.9,
    "text": "她真的一直活得那么不开心"
  },
  {
    "start": 700.9,
    "end": 703.033,
    "text": "而硬撑到二十一岁"
  },
  {
    "start": 703.066,
    "end": 707.966,
    "text": "这是不是表示我们其实永远不会真正认识一个人"
  },
  {
    "start": 707.966,
    "end": 711.5,
    "text": "我们是不是也永远无法真正认识自己"
  },
  {
    "start": 711.533,
    "end": 715.333,
    "text": "这次的情况让我头一次强烈感受到"
  },
  {
    "start": 715.333,
    "end": 718.133,
    "text": "人类的不同部份（身体和灵魂）"
  },
  {
    "start": 718.133,
    "end": 720.133,
    "text": "和这些部份的独立"
  },
  {
    "start": 720.133,
    "end": 723.5,
    "text": "我们对这些部份却没有什么控制权"
  },
  {
    "start": 723.533,
    "end": 727.266,
    "text": "是谁决定谁应该进入这个身体"
  },
  {
    "start": 727.3,
    "end": 731.433,
    "text": "灵界的老师认为这两个灵魂性格相似"
  },
  {
    "start": 731.433,
    "end": 733.066,
    "text": "所以不会引起注意"
  },
  {
    "start": 733.1,
    "end": 735.3,
    "text": "你认识另一个灵魂吗"
  },
  {
    "start": 735.333,
    "end": 736.633,
    "text": "对"
  },
  {
    "start": 736.633,
    "end": 739.066,
    "text": "我们之前一起经历过別的人生"
  },
  {
    "start": 739.066,
    "end": 740.866,
    "text": "在另一个个案中"
  },
  {
    "start": 740.9,
    "end": 741.933,
    "text": "我问"
  },
  {
    "start": 741.933,
    "end": 745.833,
    "text": "是如何决定谁会进入这个继续活着的身体"
  },
  {
    "start": 745.866,
    "end": 750.033,
    "text": "跟当初决定谁进入这个身体一样的方式"
  },
  {
    "start": 750.066,
    "end": 753.033,
    "text": "根据谁需要跟这些人处理业"
  },
  {
    "start": 753.033,
    "end": 755.466,
    "text": "还有他们觉得自己能不能"
  },
  {
    "start": 755.5,
    "end": 757.4,
    "text": "应付必须完成的事"
  },
  {
    "start": 757.4,
    "end": 760.233,
    "text": "以及这个灵魂是否进步到可以跳过"
  },
  {
    "start": 760.266,
    "end": 762.9,
    "text": "出生和孩童时期的学习"
  },
  {
    "start": 762.9,
    "end": 765.9,
    "text": "带着完整的记忆直接进入身体"
  },
  {
    "start": 765.9,
    "end": 768.533,
    "text": "那原本灵魂的业呢"
  },
  {
    "start": 768.533,
    "end": 770.133,
    "text": "你会替他们继续吗"
  },
  {
    "start": 770.133,
    "end": 771.0,
    "text": "对"
  },
  {
    "start": 771.033,
    "end": 773.0,
    "text": "在约定的协议里"
  },
  {
    "start": 773.0,
    "end": 775.866,
    "text": "我必须完成前一个人要完成的事"
  },
  {
    "start": 775.9,
    "end": 778.533,
    "text": "所以你要处理另一个人的业"
  },
  {
    "start": 778.566,
    "end": 780.133,
    "text": "不太算是业"
  },
  {
    "start": 780.133,
    "end": 782.466,
    "text": "因为当一个生命开始"
  },
  {
    "start": 782.466,
    "end": 785.5,
    "text": "原本的那个灵魂有很多要做的事"
  },
  {
    "start": 785.533,
    "end": 788.666,
    "text": "由于会跟別的灵魂频繁互动"
  },
  {
    "start": 788.666,
    "end": 791.333,
    "text": "如果某些特定责任没完成"
  },
  {
    "start": 791.366,
    "end": 793.4,
    "text": "就会影响许多人的人生"
  },
  {
    "start": 793.433,
    "end": 796.833,
    "text": "因此灵魂必须先协议好"
  },
  {
    "start": 796.866,
    "end": 799.066,
    "text": "要能执行这些责任才行"
  },
  {
    "start": 799.066,
    "end": 800.533,
    "text": "你是説"
  },
  {
    "start": 800.566,
    "end": 804.366,
    "text": "进来的灵魂知道前一个灵魂的所有责任"
  },
  {
    "start": 804.366,
    "end": 807.3,
    "text": "而且是在进入之前就知道"
  },
  {
    "start": 807.3,
    "end": 809.7,
    "text": "知道他们必须做什么"
  },
  {
    "start": 809.733,
    "end": 810.666,
    "text": "没错"
  },
  {
    "start": 810.7,
    "end": 813.166,
    "text": "当灵魂交换的时候"
  },
  {
    "start": 813.2,
    "end": 815.366,
    "text": "身体会有任何感觉吗"
  },
  {
    "start": 815.366,
    "end": 816.566,
    "text": "不会"
  },
  {
    "start": 816.6,
    "end": 819.3,
    "text": "心跳和呼吸都照样继续"
  },
  {
    "start": 819.3,
    "end": 820.766,
    "text": "很多时候"
  },
  {
    "start": 820.8,
    "end": 823.166,
    "text": "交换是在濒死时发生"
  },
  {
    "start": 823.166,
    "end": 825.8,
    "text": "这个人就像是死了又活起来"
  },
  {
    "start": 825.8,
    "end": 827.9,
    "text": "但并非都是如此"
  },
  {
    "start": 827.933,
    "end": 829.933,
    "text": "很多时候只是睡个觉"
  },
  {
    "start": 829.966,
    "end": 831.233,
    "text": "醒来时"
  },
  {
    "start": 831.233,
    "end": 832.7,
    "text": "你就在身体里"
  },
  {
    "start": 832.733,
    "end": 834.733,
    "text": "原本的灵魂已经走了"
  },
  {
    "start": 834.733,
    "end": 837.1,
    "text": "但你接收了所有的回忆"
  },
  {
    "start": 837.133,
    "end": 838.933,
    "text": "因此你就是那一个人"
  },
  {
    "start": 838.933,
    "end": 840.7,
    "text": "但载具呢"
  },
  {
    "start": 840.733,
    "end": 843.1,
    "text": "那个人会发现有什么改变吗"
  },
  {
    "start": 843.1,
    "end": 846.966,
    "text": "通常身体不会知道灵魂已经转移了"
  },
  {
    "start": 847.0,
    "end": 851.3,
    "text": "因为新的灵魂也会具有那个生命的过往记忆"
  },
  {
    "start": 851.3,
    "end": 854.133,
    "text": "所以从身体的角度来看"
  },
  {
    "start": 854.166,
    "end": 856.3,
    "text": "没有明显的所有权改变"
  },
  {
    "start": 856.333,
    "end": 858.366,
    "text": "为什么这个人"
  },
  {
    "start": 858.4,
    "end": 860.3,
    "text": "这个身体的日常意识"
  },
  {
    "start": 860.3,
    "end": 862.2,
    "text": "不知道发生了这样的事"
  },
  {
    "start": 862.233,
    "end": 865.1,
    "text": "有时候是因为那时知道的话"
  },
  {
    "start": 865.133,
    "end": 866.7,
    "text": "冲击会太大"
  },
  {
    "start": 866.7,
    "end": 870.0,
    "text": "有些换灵者一辈子都不知道"
  },
  {
    "start": 870.0,
    "end": 872.433,
    "text": "但他们的人生变得更好"
  },
  {
    "start": 872.466,
    "end": 873.8,
    "text": "更快乐"
  },
  {
    "start": 873.833,
    "end": 875.266,
    "text": "为别人付出"
  },
  {
    "start": 875.266,
    "end": 876.833,
    "text": "做了很多好事"
  },
  {
    "start": 876.866,
    "end": 878.933,
    "text": "记忆并不重要"
  },
  {
    "start": 878.933,
    "end": 880.7,
    "text": "做的好事才重要"
  },
  {
    "start": 880.7,
    "end": 883.233,
    "text": "所以你有自己的回忆"
  },
  {
    "start": 883.233,
    "end": 885.266,
    "text": "而你也接收她的回忆"
  },
  {
    "start": 885.3,
    "end": 887.7,
    "text": "我有她这一世的回忆"
  },
  {
    "start": 887.7,
    "end": 889.5,
    "text": "再之前就没有了"
  },
  {
    "start": 889.5,
    "end": 892.6,
    "text": "所以你不会带着其他人世的记录"
  },
  {
    "start": 892.633,
    "end": 893.866,
    "text": "不会"
  },
  {
    "start": 893.866,
    "end": 895.366,
    "text": "只有我自己的"
  },
  {
    "start": 895.366,
    "end": 898.366,
    "text": "这又启发了另一个有趣的想法"
  },
  {
    "start": 898.366,
    "end": 900.4,
    "text": "这是不是表示"
  },
  {
    "start": 900.433,
    "end": 903.166,
    "text": "如果我几年前就回溯她的话"
  },
  {
    "start": 903.166,
    "end": 906.3,
    "text": "我得到的会是完全不同的转世记忆"
  },
  {
    "start": 906.333,
    "end": 909.533,
    "text": "跟这一年与她合作时得到的完全不同"
  },
  {
    "start": 909.566,
    "end": 913.466,
    "text": "这个情形曾发生在其他研究者身上"
  },
  {
    "start": 913.5,
    "end": 916.766,
    "text": "也因此往往被心理学家和怀疑论者"
  },
  {
    "start": 916.766,
    "end": 918.833,
    "text": "拿来反驳轮廻的概念"
  },
  {
    "start": 918.866,
    "end": 921.133,
    "text": "所以身体没有话説"
  },
  {
    "start": 921.133,
    "end": 922.7,
    "text": "换句话説"
  },
  {
    "start": 922.7,
    "end": 924.7,
    "text": "没人问过身体的意愿"
  },
  {
    "start": 924.733,
    "end": 928.066,
    "text": "日常意识并不会被影响或打断"
  },
  {
    "start": 928.066,
    "end": 929.933,
    "text": "只是潜意识换手了"
  },
  {
    "start": 929.933,
    "end": 933.5,
    "text": "并没有不舒服或是受干扰的感觉"
  },
  {
    "start": 933.533,
    "end": 936.6,
    "text": "有时候如果必要或想要的话"
  },
  {
    "start": 936.6,
    "end": 939.466,
    "text": "就会意识到并记起灵魂的替换"
  },
  {
    "start": 939.5,
    "end": 940.966,
    "text": "大多时候"
  },
  {
    "start": 941.0,
    "end": 942.8,
    "text": "这是逐渐的知道"
  },
  {
    "start": 942.833,
    "end": 945.766,
    "text": "而且也可能会记起转换的確实时候"
  },
  {
    "start": 945.766,
    "end": 948.433,
    "text": "这就是让我困扰的地方"
  },
  {
    "start": 948.433,
    "end": 950.166,
    "text": "好像你不能説什么"
  },
  {
    "start": 950.2,
    "end": 951.9,
    "text": "对我来説"
  },
  {
    "start": 951.9,
    "end": 953.333,
    "text": "这很令人不安"
  },
  {
    "start": 953.333,
    "end": 954.6,
    "text": "想想"
  },
  {
    "start": 954.6,
    "end": 957.633,
    "text": "我们的意识对于自己生命所发生的事"
  },
  {
    "start": 957.666,
    "end": 959.9,
    "text": "的影响力竟如此小"
  },
  {
    "start": 959.9,
    "end": 963.066,
    "text": "我们的意识似乎就只是层薄膜"
  },
  {
    "start": 963.066,
    "end": 965.533,
    "text": "覆盖着非常复杂的内在"
  },
  {
    "start": 965.533,
    "end": 968.233,
    "text": "这位年轻女子醒来后"
  },
  {
    "start": 968.266,
    "end": 970.766,
    "text": "听到自己被催眠时说的话"
  },
  {
    "start": 970.766,
    "end": 974.4,
    "text": "形容她受到惊吓还是很委婉的説法"
  },
  {
    "start": 974.4,
    "end": 975.533,
    "text": "她説"
  },
  {
    "start": 975.566,
    "end": 976.2,
    "text": "不"
  },
  {
    "start": 976.2,
    "end": 977.766,
    "text": "她无法相信"
  },
  {
    "start": 977.766,
    "end": 980.666,
    "text": "她不觉得自己有什么不一样"
  },
  {
    "start": 980.666,
    "end": 982.933,
    "text": "她觉得自己还是同一个人"
  },
  {
    "start": 982.933,
    "end": 985.533,
    "text": "她的意识反抗那个想法"
  },
  {
    "start": 985.566,
    "end": 987.333,
    "text": "和我一样"
  },
  {
    "start": 987.333,
    "end": 990.2,
    "text": "她也觉得很难接受这么复杂的事"
  },
  {
    "start": 990.233,
    "end": 991.933,
    "text": "我告诉她"
  },
  {
    "start": 991.933,
    "end": 994.366,
    "text": "如果她不想接受这个想法"
  },
  {
    "start": 994.4,
    "end": 995.866,
    "text": "可以不要接受"
  },
  {
    "start": 995.9,
    "end": 999.433,
    "text": "她可以就把它当作有趣的怪事看待"
  },
  {
    "start": 999.433,
    "end": 1002.333,
    "text": "不过她確实有説她父母提过"
  },
  {
    "start": 1002.333,
    "end": 1004.233,
    "text": "她好像不一样了"
  },
  {
    "start": 1004.233,
    "end": 1006.6,
    "text": "在过去的一年有些改变"
  },
  {
    "start": 1006.6,
    "end": 1009.733,
    "text": "但这也可能是自然的成长过程"
  },
  {
    "start": 1009.766,
    "end": 1012.566,
    "text": "我们没有人可以保持不变"
  },
  {
    "start": 1012.6,
    "end": 1014.633,
    "text": "我们都持续在成长"
  }
]