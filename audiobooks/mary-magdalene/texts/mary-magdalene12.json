[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "【暮雨·注】"
  },
  {
    "start": 5.61,
    "end": 7.41,
    "text": "为方便理解"
  },
  {
    "start": 7.41,
    "end": 11.53,
    "text": "在最后附有有关概念的名词解释和补充资料"
  },
  {
    "start": 11.53,
    "end": 14.1,
    "text": "“荷鲁斯内在炼金术“"
  },
  {
    "start": 14.1,
    "end": 17.24,
    "text": "新手入门指南"
  },
  {
    "start": 17.24,
    "end": 18.8,
    "text": "本章适用于那些"
  },
  {
    "start": 18.8,
    "end": 22.67,
    "text": "希望探索荷鲁斯炼金术基本实践的人"
  },
  {
    "start": 22.67,
    "end": 25.6,
    "text": "抹大拉的玛利亚在手稿中"
  },
  {
    "start": 25.6,
    "end": 29.0,
    "text": "提供了一种高级形式的个人实践"
  },
  {
    "start": 29.0,
    "end": 32.4,
    "text": "但对许多读者来说可能过于复杂"
  },
  {
    "start": 32.4,
    "end": 33.7,
    "text": "因此"
  },
  {
    "start": 33.7,
    "end": 38.98,
    "text": "我向她询问是否可以提供一种更简单的准备性练习"
  },
  {
    "start": 38.98,
    "end": 41.38,
    "text": "以下是结果"
  },
  {
    "start": 41.38,
    "end": 45.59,
    "text": "《抹大拉手稿》并非旨在作为教学手册"
  },
  {
    "start": 45.59,
    "end": 46.04,
    "text": "而是"
  },
  {
    "start": 46.04,
    "end": 48.02,
    "text": "为了传达一种信息"
  },
  {
    "start": 48.02,
    "end": 49.31,
    "text": "因此"
  },
  {
    "start": 49.31,
    "end": 52.37,
    "text": "下面的练习步骤充当着教学功能"
  },
  {
    "start": 52.37,
    "end": 54.43,
    "text": "它们将为您提供"
  },
  {
    "start": 54.43,
    "end": 57.68,
    "text": "进入手稿中提到的“高级双蛇实践”"
  },
  {
    "start": 57.68,
    "end": 59.58,
    "text": "所需的基本经验"
  },
  {
    "start": 59.58,
    "end": 62.01,
    "text": "根据抹大拉的观点"
  },
  {
    "start": 62.01,
    "end": 64.12,
    "text": "荷鲁斯炼金术是“独自修"
  },
  {
    "start": 64.12,
    "end": 67.72,
    "text": "行者”和“神圣关系炼金术”的基础"
  },
  {
    "start": 67.72,
    "end": 71.65,
    "text": "这两条道路之间的主要区别在于"
  },
  {
    "start": 71.65,
    "end": 74.71,
    "text": "独自修行者必须通过自己的努力"
  },
  {
    "start": 74.71,
    "end": 77.12,
    "text": "产生额外的能量和狂喜"
  },
  {
    "start": 77.12,
    "end": 80.35,
    "text": "而在神圣的谭崔关系中"
  },
  {
    "start": 80.35,
    "end": 82.65,
    "text": "则通过性行为自然地获得"
  },
  {
    "start": 82.65,
    "end": 84.66,
    "text": "所需的能量和狂喜"
  },
  {
    "start": 84.66,
    "end": 88.05,
    "text": "节德柱或称脉轮的神圣通道"
  },
  {
    "start": 88.05,
    "end": 90.47,
    "text": "是从脊柱底部开始"
  },
  {
    "start": 90.47,
    "end": 91.86,
    "text": "并沿着脊柱向上"
  },
  {
    "start": 91.86,
    "end": 93.46,
    "text": "延伸至头部"
  },
  {
    "start": 93.46,
    "end": 94.57,
    "text": "此外"
  },
  {
    "start": 94.57,
    "end": 97.67,
    "text": "还有另一条“次要的节德柱通道”"
  },
  {
    "start": 97.67,
    "end": 100.8,
    "text": "从会阴直接向上延伸至头顶"
  },
  {
    "start": 100.8,
    "end": 102.73,
    "text": "它被称为中央柱"
  },
  {
    "start": 102.73,
    "end": 105.52,
    "text": "在一些秘传学派中"
  },
  {
    "start": 105.52,
    "end": 107.95,
    "text": "它又被称为生命能量管道"
  },
  {
    "start": 107.95,
    "end": 110.29,
    "text": "或称普拉纳能量管道"
  },
  {
    "start": 110.29,
    "end": 115.02,
    "text": "以下的训练练习会使用到这两条通道"
  },
  {
    "start": 115.02,
    "end": 121.05,
    "text": "（暮雨注 在文章中附有两条通道的位置关系图）"
  },
  {
    "start": 121.05,
    "end": 124.27,
    "text": "与节德柱相关的基本炼金术任务"
  },
  {
    "start": 124.27,
    "end": 126.47,
    "text": "是积累足够的能量"
  },
  {
    "start": 126.47,
    "end": 127.51,
    "text": "以便将其沿"
  },
  {
    "start": 127.51,
    "end": 130.54,
    "text": "着能量通道发送至头部中心"
  },
  {
    "start": 130.54,
    "end": 135.34,
    "text": "下面的训练练习旨在通过呼吸的力量"
  },
  {
    "start": 135.34,
    "end": 137.22,
    "text": "产生所需的能量"
  },
  {
    "start": 137.22,
    "end": 137.84,
    "text": "它们"
  },
  {
    "start": 137.84,
    "end": 139.89,
    "text": "的目的是使您了解"
  },
  {
    "start": 139.89,
    "end": 143.58,
    "text": "节德柱中微妙能量向上移动的感觉"
  },
  {
    "start": 143.58,
    "end": 146.13,
    "text": "即熟悉您身体的感觉"
  },
  {
    "start": 146.13,
    "end": 148.55,
    "text": "训练手册的第一部分"
  },
  {
    "start": 148.55,
    "end": 150.95,
    "text": "包括三个不同的练习"
  },
  {
    "start": 150.95,
    "end": 154.39,
    "text": "第一个练习涉及次要的节德柱"
  },
  {
    "start": 154.39,
    "end": 157.25,
    "text": "指从会阴直至头顶的中央柱"
  },
  {
    "start": 157.25,
    "end": 162.99,
    "text": "第二个练习涉及沿脊椎底部向上延伸的主要节德柱"
  },
  {
    "start": 162.99,
    "end": 168.73,
    "text": "第三个练习则处理将能量带到头部后的情况"
  },
  {
    "start": 168.73,
    "end": 173.26,
    "text": "训练手册的第二部分旨在使您了解"
  },
  {
    "start": 173.26,
    "end": 176.83,
    "text": "如何将穿过主要节德柱移动的能量"
  },
  {
    "start": 176.83,
    "end": 179.33,
    "text": "转化为蛇形波动的能量"
  },
  {
    "start": 179.33,
    "end": 181.66,
    "text": "最后一个练习"
  },
  {
    "start": 181.66,
    "end": 185.27,
    "text": "让您通过体验能量同时在月亮电路和太阳"
  },
  {
    "start": 185.27,
    "end": 186.81,
    "text": "电路中移动"
  },
  {
    "start": 186.81,
    "end": 190.65,
    "text": "来激活两条蛇的通道"
  },
  {
    "start": 190.65,
    "end": 193.67,
    "text": "读者注意事项"
  },
  {
    "start": 193.67,
    "end": 199.21,
    "text": "由于这些练习会为大脑和头部中心带来能量"
  },
  {
    "start": 199.21,
    "end": 202.21,
    "text": "因此它们对某些人来说是禁忌的"
  },
  {
    "start": 202.21,
    "end": 206.84,
    "text": "如果您曾经头部受过伤或经历过中风"
  },
  {
    "start": 206.84,
    "end": 207.97,
    "text": "请在开始练习"
  },
  {
    "start": 207.97,
    "end": 208.11,
    "text": "之"
  },
  {
    "start": 208.11,
    "end": 210.37,
    "text": "前先咨询您的医生"
  },
  {
    "start": 210.37,
    "end": 213.03,
    "text": "患有癫痫症状的人"
  },
  {
    "start": 213.03,
    "end": 215.65,
    "text": "也应在进行这些冥想训练之前"
  },
  {
    "start": 215.65,
    "end": 217.49,
    "text": "征求医生的意见"
  },
  {
    "start": 217.49,
    "end": 219.74,
    "text": "对于躁郁症患者"
  },
  {
    "start": 219.74,
    "end": 222.28,
    "text": "特别是在躁狂期间"
  },
  {
    "start": 222.28,
    "end": 224.56,
    "text": "这些练习绝对是禁忌的"
  },
  {
    "start": 224.56,
    "end": 226.92,
    "text": "而对于其他人"
  },
  {
    "start": 226.92,
    "end": 229.76,
    "text": "冥想是非常安全且有益的"
  },
  {
    "start": 229.76,
    "end": 233.64,
    "text": "如果您在冥想过程中感到头痛"
  },
  {
    "start": 233.64,
    "end": 237.3,
    "text": "请立即停止并休息"
  },
  {
    "start": 237.3,
    "end": 240.2,
    "text": "第一阶段 │ 激活并提升生命力"
  },
  {
    "start": 240.2,
    "end": 241.98,
    "text": "塞赫姆"
  },
  {
    "start": 241.98,
    "end": 246.9,
    "text": "第一个练习 次要节德柱通道"
  },
  {
    "start": 246.9,
    "end": 248.69,
    "text": "舒适地坐下"
  },
  {
    "start": 248.69,
    "end": 250.01,
    "text": "闭上眼睛"
  },
  {
    "start": 250.01,
    "end": 252.15,
    "text": "将注意力的焦点"
  },
  {
    "start": 252.15,
    "end": 254.89,
    "text": "也就是将你意识的炼金容器"
  },
  {
    "start": 254.89,
    "end": 255.38,
    "text": "放在你"
  },
  {
    "start": 255.38,
    "end": 256.82,
    "text": "的骨盆底部"
  },
  {
    "start": 256.82,
    "end": 260.74,
    "text": "这个区域在你身体腹部的最低部位"
  },
  {
    "start": 260.74,
    "end": 261.71,
    "text": "骨盆的中心"
  },
  {
    "start": 261.71,
    "end": 262.9,
    "text": "位置"
  },
  {
    "start": 262.9,
    "end": 265.0,
    "text": "找到一个对你来说愉悦"
  },
  {
    "start": 265.0,
    "end": 266.32,
    "text": "的节奏"
  },
  {
    "start": 266.32,
    "end": 269.22,
    "text": "深深地呼吸（但要舒适地）"
  },
  {
    "start": 269.22,
    "end": 271.69,
    "text": "将气息带入到你的腹部"
  },
  {
    "start": 271.69,
    "end": 273.75,
    "text": "当你吸气时"
  },
  {
    "start": 273.75,
    "end": 277.35,
    "text": "让下腹部膨胀 当你呼气时"
  },
  {
    "start": 277.35,
    "end": 279.53,
    "text": "则收紧下腹部 ——"
  },
  {
    "start": 279.53,
    "end": 283.07,
    "text": "这种呼吸方式 称为“腹式呼吸”"
  },
  {
    "start": 283.07,
    "end": 286.63,
    "text": "一开始你可能会感觉不习惯"
  },
  {
    "start": 286.63,
    "end": 288.44,
    "text": "然而一段时间后"
  },
  {
    "start": 288.44,
    "end": 291.64,
    "text": "它会使你感觉自然而舒适"
  },
  {
    "start": 291.64,
    "end": 294.11,
    "text": "在所有这些练习中"
  },
  {
    "start": 294.11,
    "end": 296.29,
    "text": "非常重要的一点是"
  },
  {
    "start": 296.29,
    "end": 297.22,
    "text": "所有的呼吸"
  },
  {
    "start": 297.22,
    "end": 299.4,
    "text": "都应该是轻柔和舒适的"
  },
  {
    "start": 299.4,
    "end": 301.53,
    "text": "在这些练习中"
  },
  {
    "start": 301.53,
    "end": 304.28,
    "text": "不应该强迫任何事情发生"
  },
  {
    "start": 304.28,
    "end": 306.16,
    "text": "当你吸气时"
  },
  {
    "start": 306.16,
    "end": 309.61,
    "text": "想象你呼吸的能量深入到你骨盆的每一"
  },
  {
    "start": 309.61,
    "end": 311.52,
    "text": "个角落和缝隙"
  },
  {
    "start": 311.52,
    "end": 315.44,
    "text": "这是因为你正在激活塞赫姆的振动"
  },
  {
    "start": 315.44,
    "end": 318.15,
    "text": "而塞赫姆或者说你的生命力"
  },
  {
    "start": 318.15,
    "end": 320.4,
    "text": "它被孕育在骨盆区域"
  },
  {
    "start": 320.4,
    "end": 322.4,
    "text": "当你呼气时"
  },
  {
    "start": 322.4,
    "end": 322.68,
    "text": "将"
  },
  {
    "start": 322.68,
    "end": 325.57,
    "text": "你的注意力保持在骨盆区域"
  },
  {
    "start": 325.57,
    "end": 328.39,
    "text": "这将导致塞赫姆的能量"
  },
  {
    "start": 328.39,
    "end": 331.54,
    "text": "在骨盆中聚积和增强"
  },
  {
    "start": 331.54,
    "end": 333.87,
    "text": "持续这样做几分钟"
  },
  {
    "start": 333.87,
    "end": 334.79,
    "text": "然后"
  },
  {
    "start": 334.79,
    "end": 337.48,
    "text": "想象一个微妙的能量通道"
  },
  {
    "start": 337.48,
    "end": 340.14,
    "text": "从你的会阴一直延伸到头"
  },
  {
    "start": 340.14,
    "end": 340.71,
    "text": "顶"
  },
  {
    "start": 340.71,
    "end": 343.52,
    "text": "会阴位于你躯干最低点"
  },
  {
    "start": 343.52,
    "end": 346.81,
    "text": "介于生殖器和肛门之间的中间位置"
  },
  {
    "start": 346.81,
    "end": 348.41,
    "text": "接下来"
  },
  {
    "start": 348.41,
    "end": 349.58,
    "text": "你的注意力会有一"
  },
  {
    "start": 349.58,
    "end": 353.59,
    "text": "个轻微但显著的转移 ——当你吸气时"
  },
  {
    "start": 353.59,
    "end": 357.68,
    "text": "像先前一样将注意力集中在骨盆区域"
  },
  {
    "start": 357.68,
    "end": 359.73,
    "text": "但当你呼气时"
  },
  {
    "start": 359.73,
    "end": 361.38,
    "text": "将你的注意力"
  },
  {
    "start": 361.38,
    "end": 364.04,
    "text": "也就是你意识的炼金容器"
  },
  {
    "start": 364.04,
    "end": 366.76,
    "text": "转移到这条微妙的能量通道中"
  },
  {
    "start": 366.76,
    "end": 370.64,
    "text": "这将导致塞赫姆的能量进入通道"
  },
  {
    "start": 370.64,
    "end": 372.34,
    "text": "并开始向上移动"
  },
  {
    "start": 372.34,
    "end": 374.72,
    "text": "随着你继续呼气"
  },
  {
    "start": 374.72,
    "end": 378.4,
    "text": "将你的注意力沿着通道一直移动到头部"
  },
  {
    "start": 378.4,
    "end": 381.22,
    "text": "然后重复这个呼吸模式"
  },
  {
    "start": 381.22,
    "end": 382.91,
    "text": "换句话说"
  },
  {
    "start": 382.91,
    "end": 384.74,
    "text": "每次你吸气时"
  },
  {
    "start": 384.74,
    "end": 387.75,
    "text": "将注意力集中在骨盆区域"
  },
  {
    "start": 387.75,
    "end": 390.96,
    "text": "并在整个吸气过程中保持在那里"
  },
  {
    "start": 390.96,
    "end": 392.68,
    "text": "当你呼气时"
  },
  {
    "start": 392.68,
    "end": 395.92,
    "text": "再将注意力转移到能量通道"
  },
  {
    "start": 395.92,
    "end": 397.14,
    "text": "并开始将你意识"
  },
  {
    "start": 397.14,
    "end": 399.43,
    "text": "的焦点沿着通道向头部移"
  },
  {
    "start": 399.43,
    "end": 400.09,
    "text": "动"
  },
  {
    "start": 400.09,
    "end": 402.59,
    "text": "根据需要重复多次"
  },
  {
    "start": 402.59,
    "end": 404.91,
    "text": "直到你明显地感觉到能量"
  },
  {
    "start": 404.91,
    "end": 408.13,
    "text": "沿着次要的节德柱向上移动"
  },
  {
    "start": 408.13,
    "end": 409.68,
    "text": "并进入头部"
  },
  {
    "start": 409.68,
    "end": 413.07,
    "text": "这些练习是逐步建立起来的"
  },
  {
    "start": 413.07,
    "end": 415.51,
    "text": "因此在进入下一步之前"
  },
  {
    "start": 415.51,
    "end": 417.93,
    "text": "掌握每一步是至关重要的"
  },
  {
    "start": 417.93,
    "end": 421.2,
    "text": "确保你能够清晰地感受到"
  },
  {
    "start": 421.2,
    "end": 425.42,
    "text": "有微妙的能量沿着次要节德柱向上移动"
  },
  {
    "start": 425.42,
    "end": 426.9,
    "text": "并进入头部"
  },
  {
    "start": 426.9,
    "end": 427.95,
    "text": "如果你对"
  },
  {
    "start": 427.95,
    "end": 430.16,
    "text": "此没有明确的感觉"
  },
  {
    "start": 430.16,
    "end": 432.79,
    "text": "就反复进行这些练习"
  },
  {
    "start": 432.79,
    "end": 436.95,
    "text": "直到你有清晰的感觉为止"
  },
  {
    "start": 436.95,
    "end": 438.78,
    "text": "注意事项  │"
  },
  {
    "start": 438.78,
    "end": 441.8,
    "text": "关于不舒适的身体感觉"
  },
  {
    "start": 441.8,
    "end": 443.06,
    "text": "偶尔"
  },
  {
    "start": 443.06,
    "end": 445.37,
    "text": "一个人可能会因这些练习"
  },
  {
    "start": 445.37,
    "end": 447.58,
    "text": "而感到紧张或头痛"
  },
  {
    "start": 447.58,
    "end": 451.19,
    "text": "这可能是由于下巴肌肉 面部"
  },
  {
    "start": 451.19,
    "end": 455.0,
    "text": "或颈部肌肉中存在习惯性紧张导致的"
  },
  {
    "start": 455.0,
    "end": 455.94,
    "text": "这种类"
  },
  {
    "start": 455.94,
    "end": 457.91,
    "text": "型的肌肉紧张"
  },
  {
    "start": 457.91,
    "end": 460.75,
    "text": "往往会限制生命力塞赫姆向"
  },
  {
    "start": 460.75,
    "end": 462.5,
    "text": "头部移动的运动"
  },
  {
    "start": 462.5,
    "end": 465.21,
    "text": "如果你在练习过程中"
  },
  {
    "start": 465.21,
    "end": 467.48,
    "text": "任何时候感到不适"
  },
  {
    "start": 467.48,
    "end": 469.66,
    "text": "应立即停止练习"
  },
  {
    "start": 469.66,
    "end": 471.25,
    "text": "并稍后再尝试"
  },
  {
    "start": 471.25,
    "end": 474.28,
    "text": "如果你发现每次练习时"
  },
  {
    "start": 474.28,
    "end": 477.35,
    "text": "都会出现这种类型的肌肉紧张"
  },
  {
    "start": 477.35,
    "end": 479.69,
    "text": "你可以尝试打个哈欠"
  },
  {
    "start": 479.69,
    "end": 481.83,
    "text": "因为打哈欠有助于减轻"
  },
  {
    "start": 481.83,
    "end": 485.83,
    "text": "脸部 下巴肌肉和肩膀的肌肉紧张"
  },
  {
    "start": 485.83,
    "end": 489.95,
    "text": "你只需在吸气和呼气时打哈欠即可"
  },
  {
    "start": 489.95,
    "end": 492.48,
    "text": "这种方法非常有效"
  },
  {
    "start": 492.48,
    "end": 493.97,
    "text": "也很有趣"
  },
  {
    "start": 493.97,
    "end": 496.75,
    "text": "如果紧张感持续存在"
  },
  {
    "start": 496.75,
    "end": 500.44,
    "text": "我建议你将注意力集中在紧张的区域"
  },
  {
    "start": 500.44,
    "end": 502.62,
    "text": "并想象每次呼气时"
  },
  {
    "start": 502.62,
    "end": 505.46,
    "text": "紧张感都会随之消散并离开"
  },
  {
    "start": 505.46,
    "end": 507.96,
    "text": "这样尝试几分钟"
  },
  {
    "start": 507.96,
    "end": 513.59,
    "text": "往往可以很好地消解这种类型的肌肉紧张"
  },
  {
    "start": 514.59,
    "end": 519.26,
    "text": "第二个练习 主要节德柱通道"
  },
  {
    "start": 519.26,
    "end": 521.25,
    "text": "在这个练习中"
  },
  {
    "start": 521.25,
    "end": 524.54,
    "text": "基本的操作与第一个练习相同"
  },
  {
    "start": 524.54,
    "end": 526.03,
    "text": "唯一的区别是"
  },
  {
    "start": 526.03,
    "end": 529.67,
    "text": "塞赫姆的运动是沿着主要的节德柱"
  },
  {
    "start": 529.67,
    "end": 531.81,
    "text": "即沿着脊柱向上移动的"
  },
  {
    "start": 531.81,
    "end": 534.52,
    "text": "舒适地坐着"
  },
  {
    "start": 534.52,
    "end": 535.83,
    "text": "闭上眼睛"
  },
  {
    "start": 535.83,
    "end": 537.82,
    "text": "将你的注意力"
  },
  {
    "start": 537.82,
    "end": 538.18,
    "text": "也就"
  },
  {
    "start": 538.18,
    "end": 540.4,
    "text": "是你意识的炼金容器"
  },
  {
    "start": 540.4,
    "end": 541.96,
    "text": "放在骨盆底部"
  },
  {
    "start": 541.96,
    "end": 545.58,
    "text": "找到一个对你来说愉悦的节奏"
  },
  {
    "start": 545.58,
    "end": 547.99,
    "text": "深呼吸（但要舒适地）"
  },
  {
    "start": 547.99,
    "end": 549.96,
    "text": "将气息带入腹部"
  },
  {
    "start": 549.96,
    "end": 551.9,
    "text": "当你吸气时"
  },
  {
    "start": 551.9,
    "end": 553.83,
    "text": "让下腹膨胀"
  },
  {
    "start": 553.83,
    "end": 555.17,
    "text": "当你呼气时"
  },
  {
    "start": 555.17,
    "end": 556.38,
    "text": "收紧下腹"
  },
  {
    "start": 556.38,
    "end": 558.26,
    "text": "当你吸气时"
  },
  {
    "start": 558.26,
    "end": 560.17,
    "text": "想象你呼吸的能量"
  },
  {
    "start": 560.17,
    "end": 563.11,
    "text": "深入到盆骨的每一个角落和缝隙"
  },
  {
    "start": 563.11,
    "end": 565.22,
    "text": "这样做的原因是"
  },
  {
    "start": 565.22,
    "end": 568.01,
    "text": "正如你在第一个练习中一样"
  },
  {
    "start": 568.01,
    "end": 570.78,
    "text": "这引起了塞赫姆的搅动"
  },
  {
    "start": 570.78,
    "end": 572.21,
    "text": "而塞赫姆"
  },
  {
    "start": 572.21,
    "end": 574.07,
    "text": "即你的生命力能量"
  },
  {
    "start": 574.07,
    "end": 576.73,
    "text": "则被储存在你的盆骨区域"
  },
  {
    "start": 576.73,
    "end": 578.64,
    "text": "当你呼气时"
  },
  {
    "start": 578.64,
    "end": 581.17,
    "text": "保持注意力在盆骨区域"
  },
  {
    "start": 581.17,
    "end": 584.4,
    "text": "这将使塞赫姆的生命力能量"
  },
  {
    "start": 584.4,
    "end": 586.82,
    "text": "在盆骨中聚积和增强"
  },
  {
    "start": 586.82,
    "end": 589.42,
    "text": "持续这样做几分钟左右"
  },
  {
    "start": 589.42,
    "end": 590.99,
    "text": "接下来"
  },
  {
    "start": 590.99,
    "end": 593.2,
    "text": "你的注意力会有所改变"
  },
  {
    "start": 593.2,
    "end": 594.93,
    "text": "在吸气时"
  },
  {
    "start": 594.93,
    "end": 598.09,
    "text": "注意力仍然集中在盆骨区域"
  },
  {
    "start": 598.09,
    "end": 599.84,
    "text": "但在呼气时"
  },
  {
    "start": 599.84,
    "end": 602.24,
    "text": "将注意力转移到脊柱"
  },
  {
    "start": 602.24,
    "end": 604.04,
    "text": "即主要节德柱"
  },
  {
    "start": 604.04,
    "end": 605.68,
    "text": "并随着每次呼气"
  },
  {
    "start": 605.68,
    "end": 608.2,
    "text": "将注意力从脊柱底部向上移动"
  },
  {
    "start": 608.2,
    "end": 609.14,
    "text": "到头顶"
  },
  {
    "start": 609.14,
    "end": 611.64,
    "text": "持续这样做几分钟"
  },
  {
    "start": 611.64,
    "end": 614.59,
    "text": "直到你明显地感觉到能量"
  },
  {
    "start": 614.59,
    "end": 616.91,
    "text": "沿着脊柱向上移动至头顶"
  },
  {
    "start": 616.91,
    "end": 621.76,
    "text": "当你清晰地感受到这种微妙能量的流动后"
  },
  {
    "start": 621.76,
    "end": 624.23,
    "text": "继续进行下面第三个练习"
  },
  {
    "start": 624.23,
    "end": 627.93,
    "text": "如果你没有感受到这种能量的流动"
  },
  {
    "start": 627.93,
    "end": 630.2,
    "text": "请重复这个练习"
  },
  {
    "start": 630.2,
    "end": 632.88,
    "text": "直到你感受到为止"
  },
  {
    "start": 632.88,
    "end": 637.9,
    "text": "第三个练习 头部中心"
  },
  {
    "start": 637.9,
    "end": 642.11,
    "text": "的能量循环  在这个练习中"
  },
  {
    "start": 642.11,
    "end": 646.09,
    "text": "你将遵循与第二个练习相同的步骤进行"
  },
  {
    "start": 646.09,
    "end": 647.78,
    "text": "但有一个不同之处"
  },
  {
    "start": 647.78,
    "end": 649.63,
    "text": "当你呼气时"
  },
  {
    "start": 649.63,
    "end": 653.02,
    "text": "当塞赫姆或称生命力的能量沿着脊柱向"
  },
  {
    "start": 653.02,
    "end": 653.22,
    "text": "上"
  },
  {
    "start": 653.22,
    "end": 654.73,
    "text": "移动时"
  },
  {
    "start": 654.73,
    "end": 657.18,
    "text": "你将其带入头部的中心"
  },
  {
    "start": 657.18,
    "end": 657.6,
    "text": "而不"
  },
  {
    "start": 657.6,
    "end": 658.53,
    "text": "是顶部"
  },
  {
    "start": 658.53,
    "end": 662.49,
    "text": "当生命力能量被带入头部中心时"
  },
  {
    "start": 662.49,
    "end": 665.22,
    "text": "你允许其在大脑中循环"
  },
  {
    "start": 665.22,
    "end": 667.18,
    "text": "并感知能量的运动"
  },
  {
    "start": 667.18,
    "end": 671.06,
    "text": "具体操作如下 舒适地坐着"
  },
  {
    "start": 671.06,
    "end": 672.37,
    "text": "闭上眼睛"
  },
  {
    "start": 672.37,
    "end": 674.66,
    "text": "将你注意力的焦点"
  },
  {
    "start": 674.66,
    "end": 677.03,
    "text": "也就是你意识的炼金容器"
  },
  {
    "start": 677.03,
    "end": 678.53,
    "text": "放在骨盆底部"
  },
  {
    "start": 678.53,
    "end": 681.92,
    "text": "找到一个对你来说愉悦的节奏"
  },
  {
    "start": 681.92,
    "end": 684.49,
    "text": "深深地呼吸（要舒适地）"
  },
  {
    "start": 684.49,
    "end": 686.32,
    "text": "将气息带入腹部"
  },
  {
    "start": 686.32,
    "end": 687.29,
    "text": "当你吸"
  },
  {
    "start": 687.29,
    "end": 688.25,
    "text": "气时"
  },
  {
    "start": 688.25,
    "end": 690.12,
    "text": "让下腹部膨胀"
  },
  {
    "start": 690.12,
    "end": 692.02,
    "text": "呼气时收紧下腹部"
  },
  {
    "start": 692.02,
    "end": 693.83,
    "text": "当你吸气时"
  },
  {
    "start": 693.83,
    "end": 696.07,
    "text": "想象呼吸的能量深入到"
  },
  {
    "start": 696.07,
    "end": 698.54,
    "text": "你骨盆的每一个角落和缝隙"
  },
  {
    "start": 698.54,
    "end": 700.74,
    "text": "这样做的原因是"
  },
  {
    "start": 700.74,
    "end": 703.93,
    "text": "你正在激发生命力能量塞赫姆"
  },
  {
    "start": 703.93,
    "end": 707.3,
    "text": "你的生命力能量被储存在骨盆区域"
  },
  {
    "start": 707.3,
    "end": 709.2,
    "text": "当你呼气时"
  },
  {
    "start": 709.2,
    "end": 709.8,
    "text": "保持注"
  },
  {
    "start": 709.8,
    "end": 711.71,
    "text": "意力在骨盆区域"
  },
  {
    "start": 711.71,
    "end": 714.46,
    "text": "这将使塞赫姆的能量"
  },
  {
    "start": 714.46,
    "end": 716.77,
    "text": "在骨盆中聚积和增强"
  },
  {
    "start": 716.77,
    "end": 719.13,
    "text": "持续这样做几分钟"
  },
  {
    "start": 719.13,
    "end": 722.71,
    "text": "在骨盆区域积聚能量几分钟后"
  },
  {
    "start": 722.71,
    "end": 725.8,
    "text": "你已经准备好进入下一个阶段"
  },
  {
    "start": 725.8,
    "end": 727.68,
    "text": "在吸气时"
  },
  {
    "start": 727.68,
    "end": 730.57,
    "text": "注意力仍然集中在骨盆区域"
  },
  {
    "start": 730.57,
    "end": 732.39,
    "text": "但在呼气时"
  },
  {
    "start": 732.39,
    "end": 734.51,
    "text": "则将注意力转移到脊柱 ——"
  },
  {
    "start": 734.51,
    "end": 736.74,
    "text": "主要的节德柱上"
  },
  {
    "start": 736.74,
    "end": 737.33,
    "text": "并随着"
  },
  {
    "start": 737.33,
    "end": 742.36,
    "text": "每次呼气将注意力从脊柱底部移动至头部中心"
  },
  {
    "start": 742.36,
    "end": 743.62,
    "text": "由此"
  },
  {
    "start": 743.62,
    "end": 748.63,
    "text": "塞赫姆的能量将跟随你注意力的移动路径流动"
  },
  {
    "start": 748.63,
    "end": 751.46,
    "text": "并向上流入大脑的中心区域"
  },
  {
    "start": 751.46,
    "end": 753.9,
    "text": "然后暂停片刻"
  },
  {
    "start": 753.9,
    "end": 756.46,
    "text": "感受能量在不同的大脑区域中"
  },
  {
    "start": 756.46,
    "end": 758.45,
    "text": "自行流动的感觉"
  },
  {
    "start": 758.45,
    "end": 760.92,
    "text": "持续这样做几分钟"
  },
  {
    "start": 760.92,
    "end": 761.29,
    "text": "直到"
  },
  {
    "start": 761.29,
    "end": 765.55,
    "text": "你清晰地感觉到能量沿着脊柱向上流动"
  },
  {
    "start": 765.55,
    "end": 767.96,
    "text": "并进入大脑的中心区域"
  },
  {
    "start": 768.33,
    "end": 769.57,
    "text": "暮雨·注"
  },
  {
    "start": 769.57,
    "end": 773.07,
    "text": "这个“暂停”可能也包含“停止呼吸”"
  },
  {
    "start": 773.07,
    "end": 774.57,
    "text": "也就是止息"
  },
  {
    "start": 774.57,
    "end": 778.66,
    "text": "这一点在《大角星人文摘》里也有提到"
  },
  {
    "start": 778.66,
    "end": 781.7,
    "text": "“注意吸气与呼气之间的间隙"
  },
  {
    "start": 781.7,
    "end": 784.4,
    "text": "你会发现间隙越来越长"
  },
  {
    "start": 784.4,
    "end": 785.26,
    "text": "你的呼"
  },
  {
    "start": 785.26,
    "end": 786.8,
    "text": "吸可能会暂停"
  },
  {
    "start": 786.8,
    "end": 789.37,
    "text": "你甚至可能停止呼吸"
  },
  {
    "start": 789.37,
    "end": 790.8,
    "text": "不要担心"
  },
  {
    "start": 790.8,
    "end": 792.32,
    "text": "当你需要的时候"
  },
  {
    "start": 792.32,
    "end": 793.9,
    "text": "你会再次呼吸"
  },
  {
    "start": 793.9,
    "end": 796.51,
    "text": "当呼吸变得很浅和/或完"
  },
  {
    "start": 796.51,
    "end": 797.93,
    "text": "全停止时"
  },
  {
    "start": 797.93,
    "end": 800.19,
    "text": "你进入了一个静止的时刻"
  },
  {
    "start": 800.19,
    "end": 801.23,
    "text": "然后"
  },
  {
    "start": 801.23,
    "end": 802.86,
    "text": "将你的注意力转移到"
  },
  {
    "start": 802.86,
    "end": 805.06,
    "text": "头部中心的松果体上"
  },
  {
    "start": 805.06,
    "end": 808.97,
    "text": "将你的注意力集中在两个重点关注的区域"
  },
  {
    "start": 808.97,
    "end": 812.56,
    "text": "即吸气 呼气的间隙与松果体"
  },
  {
    "start": 812.56,
    "end": 814.44,
    "text": "当你这样做时"
  },
  {
    "start": 814.44,
    "end": 817.97,
    "text": "你将进入一个更深的静止状态 ”"
  },
  {
    "start": 818.47,
    "end": 819.86,
    "text": "恰好"
  },
  {
    "start": 819.86,
    "end": 822.59,
    "text": "松果体就位于大脑的中心位置"
  },
  {
    "start": 822.59,
    "end": 823.94,
    "text": "因此"
  },
  {
    "start": 823.94,
    "end": 826.71,
    "text": "第三个练习是为了在第二阶段"
  },
  {
    "start": 826.71,
    "end": 828.58,
    "text": "将注意力聚焦于松果体"
  },
  {
    "start": 828.58,
    "end": 830.4,
    "text": "而做的练习准备"
  },
  {
    "start": 830.4,
    "end": 837.13,
    "text": "（在文章中附有《大角星人文摘》中有关呼吸的链接）"
  },
  {
    "start": 838.13,
    "end": 842.81,
    "text": "第二阶段 │ 激活（更精微的）蛇状能量"
  },
  {
    "start": 842.81,
    "end": 847.22,
    "text": "第一个练习 单蛇的升起"
  },
  {
    "start": 847.22,
    "end": 849.98,
    "text": "在第二阶段的练习中"
  },
  {
    "start": 849.98,
    "end": 851.49,
    "text": "你将重复第一阶段"
  },
  {
    "start": 851.49,
    "end": 853.94,
    "text": "最后一个练习中所做的事情"
  },
  {
    "start": 853.94,
    "end": 855.61,
    "text": "但不同的是"
  },
  {
    "start": 855.61,
    "end": 856.5,
    "text": "你不是将能"
  },
  {
    "start": 856.5,
    "end": 856.75,
    "text": "量"
  },
  {
    "start": 856.75,
    "end": 856.94,
    "text": "带"
  },
  {
    "start": 856.94,
    "end": 858.61,
    "text": "入头部中心"
  },
  {
    "start": 858.61,
    "end": 861.68,
    "text": "而是将能量引导至头盖骨顶部的"
  },
  {
    "start": 861.68,
    "end": 862.7,
    "text": "正下方"
  },
  {
    "start": 862.7,
    "end": 864.08,
    "text": "也就是两个大脑半"
  },
  {
    "start": 864.08,
    "end": 865.24,
    "text": "球的上方"
  },
  {
    "start": 865.24,
    "end": 866.45,
    "text": "此外"
  },
  {
    "start": 866.45,
    "end": 869.12,
    "text": "第二阶段的练习重点是"
  },
  {
    "start": 869.12,
    "end": 873.16,
    "text": "使这种能量的移动方式类似于眼镜蛇"
  },
  {
    "start": 873.16,
    "end": 875.96,
    "text": "蛇的尾部延伸至脊柱底部"
  },
  {
    "start": 875.96,
    "end": 879.91,
    "text": "蛇的头部则延伸进入大脑两个半球之上"
  },
  {
    "start": 879.91,
    "end": 883.69,
    "text": "以这种方式将生命力能量保持蛇的"
  },
  {
    "start": 883.69,
    "end": 885.35,
    "text": "形态"
  },
  {
    "start": 885.35,
    "end": 889.06,
    "text": "这将引起一种独特类型的大脑刺激"
  },
  {
    "start": 889.06,
    "end": 892.08,
    "text": "这就是乌拉埃乌斯的前身"
  },
  {
    "start": 892.08,
    "end": 893.79,
    "text": "舒适地坐着"
  },
  {
    "start": 893.79,
    "end": 895.1,
    "text": "闭上眼睛"
  },
  {
    "start": 895.1,
    "end": 897.38,
    "text": "将你注意力的焦点"
  },
  {
    "start": 897.38,
    "end": 899.84,
    "text": "也就是你意识的炼金容器"
  },
  {
    "start": 899.84,
    "end": 901.54,
    "text": "放在你的骨盆底部"
  },
  {
    "start": 901.54,
    "end": 904.93,
    "text": "找到一个对你来说愉悦的节奏"
  },
  {
    "start": 904.93,
    "end": 907.5,
    "text": "深深地呼吸（要舒适地）"
  },
  {
    "start": 907.5,
    "end": 909.33,
    "text": "将气息带入腹部"
  },
  {
    "start": 909.33,
    "end": 911.34,
    "text": "当你吸气时"
  },
  {
    "start": 911.34,
    "end": 911.99,
    "text": "让下腹"
  },
  {
    "start": 911.99,
    "end": 913.08,
    "text": "膨胀"
  },
  {
    "start": 913.08,
    "end": 914.88,
    "text": "呼气时收紧下腹"
  },
  {
    "start": 914.88,
    "end": 916.62,
    "text": "当你吸气时"
  },
  {
    "start": 916.62,
    "end": 918.82,
    "text": "想象呼吸的能量深入到"
  },
  {
    "start": 918.82,
    "end": 921.61,
    "text": "你骨盆的每一个角落和缝隙"
  },
  {
    "start": 921.61,
    "end": 923.63,
    "text": "激活储存在骨盆区域中的"
  },
  {
    "start": 923.63,
    "end": 925.92,
    "text": "生命力能量塞赫姆"
  },
  {
    "start": 925.92,
    "end": 927.82,
    "text": "当你呼气时"
  },
  {
    "start": 927.82,
    "end": 930.33,
    "text": "保持注意力在骨盆区域"
  },
  {
    "start": 930.33,
    "end": 933.5,
    "text": "这将导致塞赫姆的能量"
  },
  {
    "start": 933.5,
    "end": 934.92,
    "text": "在骨盆中聚积和"
  },
  {
    "start": 934.92,
    "end": 935.87,
    "text": "增强"
  },
  {
    "start": 935.87,
    "end": 938.47,
    "text": "持续这样做几分钟左右"
  },
  {
    "start": 938.47,
    "end": 942.03,
    "text": "在盆骨区域积累能量几分钟后"
  },
  {
    "start": 942.03,
    "end": 944.9,
    "text": "你已经准备好进入下一阶段"
  },
  {
    "start": 944.9,
    "end": 946.78,
    "text": "在吸气时"
  },
  {
    "start": 946.78,
    "end": 949.68,
    "text": "注意力仍然集中在盆骨区域"
  },
  {
    "start": 949.68,
    "end": 951.44,
    "text": "但在呼气时"
  },
  {
    "start": 951.44,
    "end": 953.56,
    "text": "则将注意力转移至脊柱 ——"
  },
  {
    "start": 953.56,
    "end": 955.77,
    "text": "主要的节德柱上"
  },
  {
    "start": 955.77,
    "end": 958.49,
    "text": "并随着每次呼气将注意力从"
  },
  {
    "start": 958.49,
    "end": 961.87,
    "text": "脊柱底部移向大脑的两个半球之上"
  },
  {
    "start": 961.87,
    "end": 964.23,
    "text": "位于头盖骨下方的空间"
  },
  {
    "start": 964.23,
    "end": 968.38,
    "text": "当你感知到大脑上方的这个空间时"
  },
  {
    "start": 968.38,
    "end": 971.01,
    "text": "允许自己感受能量的流动"
  },
  {
    "start": 971.01,
    "end": 972.44,
    "text": "然后"
  },
  {
    "start": 972.44,
    "end": 976.71,
    "text": "想象这股能量的形态如同一条眼镜蛇"
  },
  {
    "start": 976.71,
    "end": 979.95,
    "text": "它的脑袋在你的大脑上方伸展开"
  },
  {
    "start": 979.95,
    "end": 982.45,
    "text": "然后重复这个过程"
  },
  {
    "start": 982.45,
    "end": 984.99,
    "text": "直到你清晰地感受到能量在"
  },
  {
    "start": 984.99,
    "end": 986.02,
    "text": "大脑上方"
  },
  {
    "start": 986.02,
    "end": 988.49,
    "text": "形成蛇的形象"
  },
  {
    "start": 990.49,
    "end": 996.16,
    "text": "第二个练习 双蛇运动 （黑蛇和金蛇）"
  },
  {
    "start": 996.16,
    "end": 998.23,
    "text": "在这个练习中"
  },
  {
    "start": 998.23,
    "end": 1000.47,
    "text": "假设你已经成功地体验了"
  },
  {
    "start": 1000.47,
    "end": 1002.7,
    "text": "上一个练习中的单蛇"
  },
  {
    "start": 1002.7,
    "end": 1006.39,
    "text": "如果你还没有明显地感受到单蛇"
  },
  {
    "start": 1006.39,
    "end": 1009.39,
    "text": "请返回之前的练习继续练习"
  },
  {
    "start": 1009.39,
    "end": 1011.11,
    "text": "你可以在《抹大拉手"
  },
  {
    "start": 1011.11,
    "end": 1012.71,
    "text": "稿》第6集"
  },
  {
    "start": 1012.71,
    "end": 1015.66,
    "text": "回顾关于黑蛇和金蛇的描述"
  },
  {
    "start": 1015.66,
    "end": 1018.09,
    "text": "黑蛇（也称月亮蛇）"
  },
  {
    "start": 1018.09,
    "end": 1021.58,
    "text": "通过节德柱左侧的月亮电路上升"
  },
  {
    "start": 1021.58,
    "end": 1023.17,
    "text": "黑蛇与虚空的黑暗"
  },
  {
    "start": 1023.17,
    "end": 1026.56,
    "text": "或万物的创造者（宇宙母亲）相连"
  },
  {
    "start": 1026.56,
    "end": 1029.05,
    "text": "金蛇（也称太阳蛇"
  },
  {
    "start": 1029.05,
    "end": 1032.28,
    "text": "）通过节德柱的右侧太阳电路上升"
  },
  {
    "start": 1032.28,
    "end": 1034.27,
    "text": "金蛇与光明相连"
  },
  {
    "start": 1034.27,
    "end": 1035.51,
    "text": "在某种意"
  },
  {
    "start": 1035.51,
    "end": 1036.32,
    "text": "义上"
  },
  {
    "start": 1036.32,
    "end": 1040.29,
    "text": "这两条蛇在炼金术中代表对立的力量"
  },
  {
    "start": 1040.29,
    "end": 1044.69,
    "text": "当你将两个对立面同时放入炼金容器中时"
  },
  {
    "start": 1044.69,
    "end": 1047.28,
    "text": "就有可能产生巨大的能量"
  },
  {
    "start": 1047.28,
    "end": 1049.79,
    "text": "在这个预备训练中"
  },
  {
    "start": 1049.79,
    "end": 1052.16,
    "text": "你将使塞赫姆的能量分裂成"
  },
  {
    "start": 1052.16,
    "end": 1054.24,
    "text": "两条不同的能量流"
  },
  {
    "start": 1054.24,
    "end": 1058.94,
    "text": "随着生命力能量沿着主要节德柱上升"
  },
  {
    "start": 1058.94,
    "end": 1061.83,
    "text": "它采取了两条不同但平行的路径"
  },
  {
    "start": 1061.83,
    "end": 1065.81,
    "text": "黑蛇从节德柱的左侧底部升起"
  },
  {
    "start": 1065.81,
    "end": 1068.07,
    "text": "而金蛇也同时从节"
  },
  {
    "start": 1068.07,
    "end": 1070.1,
    "text": "德柱的右侧底部升起"
  },
  {
    "start": 1070.1,
    "end": 1071.49,
    "text": "然而"
  },
  {
    "start": 1071.49,
    "end": 1075.23,
    "text": "当它们继续沿着节德柱向头部上升时"
  },
  {
    "start": 1075.23,
    "end": 1078.53,
    "text": "它们将在进入每一个脉轮时相互交叉"
  },
  {
    "start": 1078.53,
    "end": 1080.49,
    "text": "以此种方式"
  },
  {
    "start": 1080.49,
    "end": 1085.43,
    "text": "金蛇在进入生殖轮时穿越到节德柱的左侧"
  },
  {
    "start": 1085.43,
    "end": 1088.08,
    "text": "而黑蛇则穿越到右侧"
  },
  {
    "start": 1088.08,
    "end": 1091.67,
    "text": "随着它们继续沿着节德柱上升"
  },
  {
    "start": 1091.67,
    "end": 1094.91,
    "text": "金蛇在进入太阳神经丛脉轮时"
  },
  {
    "start": 1094.91,
    "end": 1097.01,
    "text": "再次穿越回到右侧"
  },
  {
    "start": 1097.01,
    "end": 1099.33,
    "text": "黑蛇则穿越回左侧"
  },
  {
    "start": 1099.33,
    "end": 1100.87,
    "text": "接下来"
  },
  {
    "start": 1100.87,
    "end": 1103.24,
    "text": "当金蛇进入心轮时"
  },
  {
    "start": 1103.24,
    "end": 1105.07,
    "text": "它穿越到左侧"
  },
  {
    "start": 1105.07,
    "end": 1107.45,
    "text": "而黑蛇穿越到右侧"
  },
  {
    "start": 1107.45,
    "end": 1109.8,
    "text": "当它们进入喉轮时"
  },
  {
    "start": 1109.8,
    "end": 1113.13,
    "text": "金蛇返回到节德柱的右侧"
  },
  {
    "start": 1113.13,
    "end": 1115.37,
    "text": "而黑蛇回到左侧"
  },
  {
    "start": 1115.37,
    "end": 1116.64,
    "text": "最终"
  },
  {
    "start": 1116.64,
    "end": 1118.96,
    "text": "它们在头部中心相遇"
  },
  {
    "start": 1118.96,
    "end": 1121.58,
    "text": "金蛇在右侧悬浮"
  },
  {
    "start": 1121.58,
    "end": 1124.21,
    "text": "而黑蛇在左侧悬浮"
  },
  {
    "start": 1124.21,
    "end": 1126.43,
    "text": "它们彼此面对面"
  },
  {
    "start": 1126.43,
    "end": 1129.06,
    "text": "松果体正好位于在它们之间"
  },
  {
    "start": 1129.06,
    "end": 1132.45,
    "text": "抹大拉手稿第8集中提供了"
  },
  {
    "start": 1132.45,
    "end": 1135.57,
    "text": "关于如何进一步进行该练习的指导"
  },
  {
    "start": 1135.57,
    "end": 1136.97,
    "text": "然而"
  },
  {
    "start": 1136.97,
    "end": 1139.33,
    "text": "本章中这个预备练习的目的"
  },
  {
    "start": 1139.33,
    "end": 1141.57,
    "text": "仅仅是让你熟悉"
  },
  {
    "start": 1141.57,
    "end": 1146.49,
    "text": "将两条蛇提升到节德柱并进入头部的现象"
  },
  {
    "start": 1146.49,
    "end": 1149.1,
    "text": "要进行这个练习"
  },
  {
    "start": 1149.1,
    "end": 1150.58,
    "text": "请舒适地坐着"
  },
  {
    "start": 1150.58,
    "end": 1151.67,
    "text": "闭上眼睛"
  },
  {
    "start": 1151.67,
    "end": 1153.95,
    "text": "将你注意力的焦点"
  },
  {
    "start": 1153.95,
    "end": 1156.41,
    "text": "也就是你意识的炼金容器"
  },
  {
    "start": 1156.41,
    "end": 1158.11,
    "text": "放在你的骨盆底部"
  },
  {
    "start": 1158.11,
    "end": 1161.5,
    "text": "找到一个对你来说愉悦的节奏"
  },
  {
    "start": 1161.5,
    "end": 1164.07,
    "text": "深深地呼吸（要舒适地）"
  },
  {
    "start": 1164.07,
    "end": 1165.9,
    "text": "将气息带入腹部"
  },
  {
    "start": 1165.9,
    "end": 1167.91,
    "text": "当你吸气时"
  },
  {
    "start": 1167.91,
    "end": 1169.65,
    "text": "让下腹膨胀"
  },
  {
    "start": 1169.65,
    "end": 1170.98,
    "text": "呼气时收紧下"
  },
  {
    "start": 1170.98,
    "end": 1171.45,
    "text": "腹"
  },
  {
    "start": 1171.45,
    "end": 1173.28,
    "text": "当你吸气时"
  },
  {
    "start": 1173.28,
    "end": 1175.48,
    "text": "想象呼吸的能量深入到"
  },
  {
    "start": 1175.48,
    "end": 1178.27,
    "text": "你骨盆的每一个角落和缝隙"
  },
  {
    "start": 1178.27,
    "end": 1180.29,
    "text": "激活储存在骨盆区域中的"
  },
  {
    "start": 1180.29,
    "end": 1182.58,
    "text": "生命力能量塞赫姆"
  },
  {
    "start": 1182.58,
    "end": 1184.48,
    "text": "当你呼气时"
  },
  {
    "start": 1184.48,
    "end": 1186.99,
    "text": "保持注意力在骨盆区域"
  },
  {
    "start": 1186.99,
    "end": 1190.16,
    "text": "这将导致塞赫姆的能量"
  },
  {
    "start": 1190.16,
    "end": 1192.53,
    "text": "在骨盆中聚积和增强"
  },
  {
    "start": 1192.53,
    "end": 1195.13,
    "text": "持续这样做几分钟左右"
  },
  {
    "start": 1195.13,
    "end": 1196.25,
    "text": "在盆骨区"
  },
  {
    "start": 1196.25,
    "end": 1198.69,
    "text": "域积累能量几分钟后"
  },
  {
    "start": 1198.69,
    "end": 1201.56,
    "text": "你已经准备好进入下一阶段"
  },
  {
    "start": 1201.56,
    "end": 1203.38,
    "text": "当你吸气时"
  },
  {
    "start": 1203.38,
    "end": 1206.65,
    "text": "注意力仍然集中在骨盆区域"
  },
  {
    "start": 1206.65,
    "end": 1208.4,
    "text": "但当你呼气时"
  },
  {
    "start": 1208.4,
    "end": 1210.67,
    "text": "将注意力转移至脊柱底部"
  },
  {
    "start": 1210.67,
    "end": 1213.44,
    "text": "通过意愿（意志）的力量"
  },
  {
    "start": 1213.44,
    "end": 1216.75,
    "text": "想象两条蛇被呼吸的能量充满"
  },
  {
    "start": 1216.75,
    "end": 1219.09,
    "text": "随着继续呼气"
  },
  {
    "start": 1219.09,
    "end": 1219.74,
    "text": "你将通过"
  },
  {
    "start": 1219.74,
    "end": 1222.92,
    "text": "两条蛇的路径向上发送能量"
  },
  {
    "start": 1222.92,
    "end": 1227.71,
    "text": "尽可能清晰地在你的脑海中想象整个画面"
  },
  {
    "start": 1227.71,
    "end": 1231.73,
    "text": "想象并感受它们在每个脉轮处相互交叉"
  },
  {
    "start": 1231.73,
    "end": 1234.29,
    "text": "最终在头部的中心结束"
  },
  {
    "start": 1234.29,
    "end": 1236.13,
    "text": "继续练习"
  },
  {
    "start": 1236.13,
    "end": 1240.09,
    "text": "直到你清晰地感受到两条蛇状能量"
  },
  {
    "start": 1240.09,
    "end": 1243.32,
    "text": "沿脊柱向上流动并进入头部"
  },
  {
    "start": 1243.32,
    "end": 1246.87,
    "text": "允许自己去感受生命力能量"
  },
  {
    "start": 1246.87,
    "end": 1250.97,
    "text": "沿着这两条路径上升时的运动状态"
  },
  {
    "start": 1250.97,
    "end": 1252.67,
    "text": "正如这两条蛇"
  },
  {
    "start": 1252.67,
    "end": 1255.27,
    "text": "在你呼吸的作用下“扭动”一样"
  },
  {
    "start": 1255.27,
    "end": 1259.57,
    "text": "感受由于这个练习而在大脑内产生的微"
  },
  {
    "start": 1259.57,
    "end": 1262.43,
    "text": "妙能量"
  },
  {
    "start": 1263.43,
    "end": 1266.13,
    "text": "【名词解释】"
  },
  {
    "start": 1266.13,
    "end": 1271.42,
    "text": "中央柱 一条微妙的能量通道"
  },
  {
    "start": 1271.42,
    "end": 1275.02,
    "text": "从脊柱前方的底部（即会阴位置"
  },
  {
    "start": 1275.02,
    "end": 1277.44,
    "text": "会阴位于你躯干最低点"
  },
  {
    "start": 1277.44,
    "end": 1280.74,
    "text": "介于生殖器和肛门之间的中间位置）,"
  },
  {
    "start": 1280.74,
    "end": 1286.3,
    "text": "一直延伸至头顶 （参见生命能量通道的名词解释）"
  },
  {
    "start": 1286.3,
    "end": 1289.23,
    "text": "中央柱也是练习中所说的“"
  },
  {
    "start": 1289.23,
    "end": 1289.46,
    "text": "次"
  },
  {
    "start": 1289.46,
    "end": 1292.87,
    "text": "要的节德柱通道"
  },
  {
    "start": 1292.87,
    "end": 1297.8,
    "text": "生命能量管道 也称普拉纳能量管"
  },
  {
    "start": 1297.8,
    "end": 1298.59,
    "text": "道"
  },
  {
    "start": 1298.59,
    "end": 1301.1,
    "text": "这条微妙的能量通道"
  },
  {
    "start": 1301.1,
    "end": 1304.6,
    "text": "用于传递“普拉纳”或称生命力能量"
  },
  {
    "start": 1304.6,
    "end": 1307.71,
    "text": "通过激活和加强这个通道"
  },
  {
    "start": 1307.71,
    "end": 1310.65,
    "text": "可以促进能量循环和提升整体"
  },
  {
    "start": 1310.65,
    "end": 1311.84,
    "text": "活力与平衡"
  },
  {
    "start": 1311.84,
    "end": 1314.64,
    "text": "这条特别的能量通道"
  },
  {
    "start": 1314.64,
    "end": 1318.24,
    "text": "可以被视为人体磁场内的磁力线中心"
  },
  {
    "start": 1318.24,
    "end": 1320.61,
    "text": "所有的双极磁体"
  },
  {
    "start": 1320.61,
    "end": 1322.49,
    "text": "包括我们的身体"
  },
  {
    "start": 1322.49,
    "end": 1324.55,
    "text": "都有一个北极和南极"
  },
  {
    "start": 1324.55,
    "end": 1327.56,
    "text": "这两极围绕一个轴产生"
  },
  {
    "start": 1327.56,
    "end": 1328.7,
    "text": "就像地球的轴"
  },
  {
    "start": 1328.7,
    "end": 1330.23,
    "text": "线一样"
  },
  {
    "start": 1330.23,
    "end": 1332.63,
    "text": "地球也是一个双极磁体"
  },
  {
    "start": 1332.63,
    "end": 1334.57,
    "text": "在人体内部"
  },
  {
    "start": 1334.57,
    "end": 1337.22,
    "text": "这个轴线从头顶到会阴"
  },
  {
    "start": 1337.22,
    "end": 1341.67,
    "text": "位于脊柱的前方（参见中央柱的解释）"
  },
  {
    "start": 1341.67,
    "end": 1345.43,
    "text": "磁力线是一种帮助理解磁场的概念性工"
  },
  {
    "start": 1345.43,
    "end": 1346.71,
    "text": "具"
  },
  {
    "start": 1346.71,
    "end": 1349.4,
    "text": "用来描述磁场分布的路径"
  },
  {
    "start": 1349.4,
    "end": 1350.72,
    "text": "方向与强度"
  },
  {
    "start": 1350.72,
    "end": 1353.59,
    "text": "它们代表了磁场中的力线"
  },
  {
    "start": 1353.59,
    "end": 1357.43,
    "text": "以及物体在磁场中所受到的力的方向和大小"
  },
  {
    "start": 1357.43,
    "end": 1362.29,
    "text": "乌拉埃乌斯 有时被称为“膏抹”"
  },
  {
    "start": 1362.29,
    "end": 1364.04,
    "text": "乌拉埃乌斯是指"
  },
  {
    "start": 1364.04,
    "end": 1367.63,
    "text": "当生命力塞赫姆被带入节德柱"
  },
  {
    "start": 1367.63,
    "end": 1370.09,
    "text": "并进入大脑时发生的现象"
  },
  {
    "start": 1370.09,
    "end": 1375.26,
    "text": "这种运动会产生一种类似蛇形的能量形式"
  },
  {
    "start": 1375.26,
    "end": 1375.45,
    "text": "这"
  },
  {
    "start": 1375.45,
    "end": 1377.48,
    "text": "可能是为什么古埃及人将乌"
  },
  {
    "start": 1377.48,
    "end": 1378.85,
    "text": "拉埃乌斯描"
  }
]