[
  {
    "start": 0.0,
    "end": 4.032,
    "text": "古代中国那些富有深刻直觉洞察力的智者"
  },
  {
    "start": 4.032,
    "end": 6.24,
    "text": "通过聆听与观察自然"
  },
  {
    "start": 6.24,
    "end": 9.264,
    "text": "探索出天地万物的创造模式,"
  },
  {
    "start": 9.264,
    "end": 10.704,
    "text": "他们最终发现"
  },
  {
    "start": 10.704,
    "end": 13.728,
    "text": "宇宙间存在两种微妙的力量"
  },
  {
    "start": 13.728,
    "end": 16.368,
    "text": "阴与阳 ——它们互为补充"
  },
  {
    "start": 16.368,
    "end": 18.064,
    "text": "却又时常对立"
  },
  {
    "start": 18.064,
    "end": 22.0,
    "text": "被视为构成万物的两种基本元素"
  },
  {
    "start": 22.0,
    "end": 26.48,
    "text": "阴阳的本质 潜能与动能"
  },
  {
    "start": 26.48,
    "end": 29.104,
    "text": "在道家的象征体系中"
  },
  {
    "start": 29.104,
    "end": 32.384,
    "text": "太阳和月亮常被用来代表阴与阳"
  },
  {
    "start": 32.384,
    "end": 35.872,
    "text": "阳（如太阳）代表光与热"
  },
  {
    "start": 35.872,
    "end": 37.68,
    "text": "是一种动态的力量"
  },
  {
    "start": 37.68,
    "end": 38.976,
    "text": "具有行动力"
  },
  {
    "start": 38.976,
    "end": 40.336,
    "text": "推动性"
  },
  {
    "start": 40.336,
    "end": 44.688,
    "text": "闪电就是阳的体现——它照亮天空"
  },
  {
    "start": 44.688,
    "end": 46.496,
    "text": "爆发出巨大能量"
  },
  {
    "start": 46.496,
    "end": 50.016,
    "text": "并且一击即中 毫不迟疑"
  },
  {
    "start": 50.016,
    "end": 52.48,
    "text": "阴（如月亮）"
  },
  {
    "start": 52.48,
    "end": 55.936,
    "text": "带有湿润 清凉与幽暗的特质"
  },
  {
    "start": 55.936,
    "end": 59.104,
    "text": "它代表的是一种尚未被激发"
  },
  {
    "start": 59.104,
    "end": 61.328,
    "text": "但充满可能性的势能"
  },
  {
    "start": 61.328,
    "end": 62.704,
    "text": "而非动能"
  },
  {
    "start": 62.704,
    "end": 66.528,
    "text": "势能是指物体由于其位置 状态或结构"
  },
  {
    "start": 66.528,
    "end": 68.368,
    "text": "而储存的能量,"
  },
  {
    "start": 68.368,
    "end": 72.272,
    "text": "例如 抬起的石头具有重力势能"
  },
  {
    "start": 72.272,
    "end": 75.776,
    "text": "被压缩的弹簧储存弹性势能"
  },
  {
    "start": 75.776,
    "end": 78.768,
    "text": "所以阴被比喻为潜能,"
  },
  {
    "start": 78.768,
    "end": 81.04,
    "text": "或未被激发的能量"
  },
  {
    "start": 81.04,
    "end": 83.344,
    "text": "正如埋在土里的种子"
  },
  {
    "start": 83.344,
    "end": 87.296,
    "text": "处于阴的影响之中 它被湿气包围"
  },
  {
    "start": 87.296,
    "end": 89.808,
    "text": "环境黑暗而清凉"
  },
  {
    "start": 89.808,
    "end": 93.04,
    "text": "而当太阳（阳）出来时"
  },
  {
    "start": 93.04,
    "end": 94.864,
    "text": "阳光温暖了土壤"
  },
  {
    "start": 94.864,
    "end": 96.416,
    "text": "种子开始生长"
  },
  {
    "start": 96.416,
    "end": 97.68,
    "text": "这时"
  },
  {
    "start": 97.68,
    "end": 99.776,
    "text": "阴与阳达到了平衡"
  },
  {
    "start": 99.776,
    "end": 101.728,
    "text": "由此孕育出了生命"
  },
  {
    "start": 101.728,
    "end": 103.024,
    "text": "然而"
  },
  {
    "start": 103.024,
    "end": 104.4,
    "text": "若水分阴过多"
  },
  {
    "start": 104.4,
    "end": 107.904,
    "text": "种子会腐烂 若热量阳过强"
  },
  {
    "start": 107.904,
    "end": 110.576,
    "text": "种子则会枯萎死亡"
  },
  {
    "start": 110.576,
    "end": 112.624,
    "text": "阴与阳"
  },
  {
    "start": 112.624,
    "end": 115.152,
    "text": "并非静止不变的两股力量"
  },
  {
    "start": 115.152,
    "end": 116.496,
    "text": "实际上"
  },
  {
    "start": 116.496,
    "end": 118.544,
    "text": "它们不断地相互转化"
  },
  {
    "start": 118.544,
    "end": 120.272,
    "text": "阴转化为阳"
  },
  {
    "start": 120.272,
    "end": 122.368,
    "text": "阳也会转化为阴"
  },
  {
    "start": 122.368,
    "end": 125.344,
    "text": "尽管我们无法直接看见阴或阳"
  },
  {
    "start": 125.344,
    "end": 129.2,
    "text": "但我们都可以亲身感受到它们带来的影响"
  },
  {
    "start": 129.2,
    "end": 132.784,
    "text": "我想通过大学时的一场校园足球赛"
  },
  {
    "start": 132.784,
    "end": 136.256,
    "text": "来说明阴阳如何在生活中交织流转"
  },
  {
    "start": 136.256,
    "end": 138.32,
    "text": "当时正是秋天"
  },
  {
    "start": 138.32,
    "end": 142.592,
    "text": "校园被红色和黄色的树叶染得绚丽多彩"
  },
  {
    "start": 142.592,
    "end": 145.584,
    "text": "阳光与微风在空气中交融"
  },
  {
    "start": 145.584,
    "end": 149.568,
    "text": "温暖与凉爽并存,这种自然的平衡"
  },
  {
    "start": 149.568,
    "end": 153.12,
    "text": "让我感受到阴阳的力量在身边流动"
  },
  {
    "start": 153.12,
    "end": 154.512,
    "text": "那天"
  },
  {
    "start": 154.512,
    "end": 157.2,
    "text": "校园因为返校节热闹非凡"
  },
  {
    "start": 157.2,
    "end": 158.736,
    "text": "大家满怀期待"
  },
  {
    "start": 158.736,
    "end": 160.736,
    "text": "比赛还没开始"
  },
  {
    "start": 160.736,
    "end": 162.928,
    "text": "观众席已是一片沸腾"
  },
  {
    "start": 162.928,
    "end": 164.288,
    "text": "欢呼雀跃"
  },
  {
    "start": 164.288,
    "end": 167.888,
    "text": "充满活力——人们此时是阳的状态"
  },
  {
    "start": 167.888,
    "end": 170.8,
    "text": "外放 热烈且充满力量"
  },
  {
    "start": 170.8,
    "end": 173.104,
    "text": "而当比赛正式开始"
  },
  {
    "start": 173.104,
    "end": 175.072,
    "text": "所有人又安静下来"
  },
  {
    "start": 175.072,
    "end": 177.52,
    "text": "屏息关注球场上的每一个动作——"
  },
  {
    "start": 177.52,
    "end": 179.408,
    "text": "我们又变成了阴"
  },
  {
    "start": 179.408,
    "end": 181.616,
    "text": "内敛沉稳且专注"
  },
  {
    "start": 181.616,
    "end": 184.112,
    "text": "随着比赛节奏起伏"
  },
  {
    "start": 184.112,
    "end": 187.52,
    "text": "我们的情绪也随着球场上的变化而翻转"
  },
  {
    "start": 187.52,
    "end": 189.392,
    "text": "当球队逼近球门"
  },
  {
    "start": 189.392,
    "end": 191.232,
    "text": "我们再次高声尖叫"
  },
  {
    "start": 191.232,
    "end": 194.992,
    "text": "阳气升腾 但当对方抢走球权"
  },
  {
    "start": 194.992,
    "end": 196.256,
    "text": "局势逆转"
  },
  {
    "start": 196.256,
    "end": 197.936,
    "text": "我们又陷入一片沉默"
  },
  {
    "start": 197.936,
    "end": 199.808,
    "text": "阳再度归于阴"
  },
  {
    "start": 199.808,
    "end": 201.472,
    "text": "整个下午"
  },
  {
    "start": 201.472,
    "end": 205.28,
    "text": "我超然地看着这场情绪的阴阳交替之舞"
  },
  {
    "start": 205.28,
    "end": 206.688,
    "text": "热烈与平静"
  },
  {
    "start": 206.688,
    "end": 209.296,
    "text": "希望与失落 动与静"
  },
  {
    "start": 209.296,
    "end": 211.6,
    "text": "阳与阴的不断转换"
  },
  {
    "start": 211.6,
    "end": 213.824,
    "text": "直到最后夕阳落下"
  },
  {
    "start": 213.824,
    "end": 215.168,
    "text": "新月升起"
  },
  {
    "start": 215.168,
    "end": 216.656,
    "text": "阳转为阴"
  },
  {
    "start": 216.656,
    "end": 219.072,
    "text": "一切重新归于宁静"
  },
  {
    "start": 219.072,
    "end": 221.088,
    "text": "人生亦如此"
  },
  {
    "start": 221.088,
    "end": 223.552,
    "text": "在看似平常的起伏之间"
  },
  {
    "start": 223.552,
    "end": 228.368,
    "text": "阴与阳始终在流动 平衡 彼此转化"
  },
  {
    "start": 228.368,
    "end": 231.728,
    "text": "文化态度 与 阴的智慧"
  },
  {
    "start": 231.728,
    "end": 234.352,
    "text": "我们生活在一个气的海洋里"
  },
  {
    "start": 234.352,
    "end": 236.704,
    "text": "有些气属阳性"
  },
  {
    "start": 236.704,
    "end": 238.288,
    "text": "充满力量与方向"
  },
  {
    "start": 238.288,
    "end": 240.048,
    "text": "有些属于阴性"
  },
  {
    "start": 240.048,
    "end": 242.288,
    "text": "是接纳与休息的特质"
  },
  {
    "start": 242.288,
    "end": 244.176,
    "text": "大多数情况下"
  },
  {
    "start": 244.176,
    "end": 246.464,
    "text": "我们并未察觉它的存在"
  },
  {
    "start": 246.464,
    "end": 249.344,
    "text": "尽管它在许多层面影响着我们"
  },
  {
    "start": 249.344,
    "end": 251.296,
    "text": "道教炼金术士"
  },
  {
    "start": 251.296,
    "end": 253.728,
    "text": "是已经觉察到这个无所不在的"
  },
  {
    "start": 254.08,
    "end": 256.416,
    "text": "气之海洋的修行者"
  },
  {
    "start": 256.416,
    "end": 258.672,
    "text": "通过内丹术的修行"
  },
  {
    "start": 258.672,
    "end": 261.28,
    "text": "他们学会将这种能量吸入体内"
  },
  {
    "start": 261.28,
    "end": 262.608,
    "text": "用以转化意识"
  },
  {
    "start": 262.608,
    "end": 264.08,
    "text": "并滋养身心"
  },
  {
    "start": 264.08,
    "end": 265.392,
    "text": "改善健康"
  },
  {
    "start": 265.392,
    "end": 266.704,
    "text": "然而"
  },
  {
    "start": 266.704,
    "end": 268.96,
    "text": "我们现代工业化的生活方式"
  },
  {
    "start": 268.96,
    "end": 271.68,
    "text": "却破坏了身心的平衡状态"
  },
  {
    "start": 271.68,
    "end": 274.912,
    "text": "我们的生活方式过分偏向阳性——"
  },
  {
    "start": 274.912,
    "end": 277.008,
    "text": "推崇效率和行动"
  },
  {
    "start": 277.008,
    "end": 280.304,
    "text": "把有所作为视为唯一的价值"
  },
  {
    "start": 280.304,
    "end": 282.016,
    "text": "而无为与静止"
  },
  {
    "start": 282.016,
    "end": 285.344,
    "text": "在文化中常被误解为软弱无能"
  },
  {
    "start": 285.344,
    "end": 287.392,
    "text": "我们用咖啡因来提神"
  },
  {
    "start": 287.392,
    "end": 291.312,
    "text": "对速度与生产力充满执念,我们是阳"
  },
  {
    "start": 291.312,
    "end": 293.056,
    "text": "并为此感到自豪"
  },
  {
    "start": 293.056,
    "end": 297.856,
    "text": "但问题在于 这种状态即失去了平衡"
  },
  {
    "start": 297.856,
    "end": 300.208,
    "text": "最终也是具毁灭性的"
  },
  {
    "start": 300.208,
    "end": 302.896,
    "text": "我们往往忽略了一个道理"
  },
  {
    "start": 302.896,
    "end": 306.08,
    "text": "其实——阳是从阴中产生的"
  },
  {
    "start": 306.08,
    "end": 307.664,
    "text": "举个例子"
  },
  {
    "start": 307.664,
    "end": 311.248,
    "text": "华盛顿州有一座巨大的水力发电站大坝"
  },
  {
    "start": 311.248,
    "end": 312.464,
    "text": "也许"
  },
  {
    "start": 312.464,
    "end": 315.728,
    "text": "没有什么比电更阳刚的能量了"
  },
  {
    "start": 315.728,
    "end": 317.056,
    "text": "但是"
  },
  {
    "start": 317.056,
    "end": 319.744,
    "text": "这里发电的源头却是水——"
  },
  {
    "start": 319.744,
    "end": 321.904,
    "text": "一种极具阴性的物质"
  },
  {
    "start": 321.904,
    "end": 323.936,
    "text": "为建造水电站"
  },
  {
    "start": 323.936,
    "end": 325.792,
    "text": "人们在河流上筑坝"
  },
  {
    "start": 325.792,
    "end": 328.656,
    "text": "如今已是一大片静止的湖泊"
  },
  {
    "start": 328.656,
    "end": 332.08,
    "text": "这片湖水大部分时间都是静止的"
  },
  {
    "start": 332.08,
    "end": 334.848,
    "text": "除了风吹起的微波轻轻荡漾"
  },
  {
    "start": 334.848,
    "end": 336.368,
    "text": "它是阴"
  },
  {
    "start": 336.368,
    "end": 338.384,
    "text": "静止而充满潜能"
  },
  {
    "start": 338.384,
    "end": 340.8,
    "text": "但当水坝的闸门打开"
  },
  {
    "start": 340.8,
    "end": 343.472,
    "text": "这股阴性的湖水就被唤醒"
  },
  {
    "start": 343.472,
    "end": 346.096,
    "text": "转化为奔流不息的阳"
  },
  {
    "start": 346.096,
    "end": 349.344,
    "text": "激烈的水流推动巨大的涡轮机转动"
  },
  {
    "start": 349.344,
    "end": 351.184,
    "text": "再将这股动能转化为"
  },
  {
    "start": 351.184,
    "end": 354.64,
    "text": "另一种形式的阳——电力"
  },
  {
    "start": 354.64,
    "end": 357.216,
    "text": "它点亮灯光 启动电视"
  },
  {
    "start": 357.216,
    "end": 360.144,
    "text": "和各种为我们节省时间的电器"
  },
  {
    "start": 360.144,
    "end": 361.248,
    "text": "只是"
  },
  {
    "start": 361.248,
    "end": 364.624,
    "text": "我们并没有足够的时间来真正享受"
  },
  {
    "start": 364.624,
    "end": 367.2,
    "text": "这又是另一个问题了"
  },
  {
    "start": 367.2,
    "end": 369.008,
    "text": "我们正被一股阳性能量"
  },
  {
    "start": 369.008,
    "end": 371.248,
    "text": "狂热的文化旋风裹挟"
  },
  {
    "start": 371.248,
    "end": 373.696,
    "text": "速食店随处可见"
  },
  {
    "start": 373.696,
    "end": 377.232,
    "text": "装潢常用红色和黄色这样的阳性色彩"
  },
  {
    "start": 377.232,
    "end": 379.552,
    "text": "以刺激顾客加快进食速度"
  },
  {
    "start": 379.552,
    "end": 382.0,
    "text": "好为下一批顾客腾出位置"
  },
  {
    "start": 382.0,
    "end": 387.12,
    "text": "背景中循环播放着一种机械 单调的电子流行乐"
  },
  {
    "start": 387.12,
    "end": 390.56,
    "text": "还有快节奏的环境音乐在潜移默化中"
  },
  {
    "start": 390.56,
    "end": 393.696,
    "text": "催促我们做任何事情都更快一点"
  },
  {
    "start": 393.696,
    "end": 396.832,
    "text": "我使用音乐这个词相当随意"
  },
  {
    "start": 396.832,
    "end": 398.752,
    "text": "因为这些后现代的噪音"
  },
  {
    "start": 398.752,
    "end": 400.656,
    "text": "与真正的音乐相比"
  },
  {
    "start": 400.656,
    "end": 404.064,
    "text": "早已失去了其本该具备的崇高属性——"
  },
  {
    "start": 404.064,
    "end": 406.64,
    "text": "比如疗愈力与启发性"
  },
  {
    "start": 406.64,
    "end": 408.304,
    "text": "你看"
  },
  {
    "start": 408.304,
    "end": 411.088,
    "text": "音乐或者说被糟蹋的音乐"
  },
  {
    "start": 411.088,
    "end": 413.84,
    "text": "一直是让我耿耿于怀的话题"
  },
  {
    "start": 413.84,
    "end": 416.704,
    "text": "所以请原谅我这一段牢骚"
  },
  {
    "start": 416.704,
    "end": 419.344,
    "text": "我们还是回到阴与阳的话题"
  },
  {
    "start": 419.344,
    "end": 423.424,
    "text": "总结一下我想表达的重点 许多西方人"
  },
  {
    "start": 423.424,
    "end": 424.88,
    "text": "尤其是美国人"
  },
  {
    "start": 424.88,
    "end": 428.768,
    "text": "似乎对任何空白的空间或时间感到不安"
  },
  {
    "start": 428.768,
    "end": 430.832,
    "text": "必须填满每一刻"
  },
  {
    "start": 430.832,
    "end": 432.528,
    "text": "其结果是"
  },
  {
    "start": 432.528,
    "end": 435.152,
    "text": "压力相关的疾病大幅增加"
  },
  {
    "start": 435.152,
    "end": 439.696,
    "text": "人的身体根本无法长时间维持在阳的状态中"
  },
  {
    "start": 439.696,
    "end": 443.344,
    "text": "它需要阴——需要有空白 需要休息"
  },
  {
    "start": 443.344,
    "end": 445.76,
    "text": "甚至需要做梦的时间"
  },
  {
    "start": 445.76,
    "end": 447.952,
    "text": "但在西方文化中"
  },
  {
    "start": 447.952,
    "end": 450.96,
    "text": "什么都不做常常被视为懒惰"
  },
  {
    "start": 450.96,
    "end": 451.728,
    "text": "然而"
  },
  {
    "start": 451.728,
    "end": 455.728,
    "text": "有时候这恰恰是我们最明智的选择"
  },
  {
    "start": 455.728,
    "end": 457.888,
    "text": "如果你想要成为阳"
  },
  {
    "start": 457.888,
    "end": 460.416,
    "text": "那你最好花些时间成为阴"
  },
  {
    "start": 460.416,
    "end": 464.832,
    "text": "真正的道家绝不会让自己耗尽太多阳气——"
  },
  {
    "start": 464.832,
    "end": 467.28,
    "text": "他们会设法避免这种情况"
  },
  {
    "start": 467.28,
    "end": 468.528,
    "text": "因为"
  },
  {
    "start": 468.528,
    "end": 470.416,
    "text": "道家炼金术讲究的"
  },
  {
    "start": 470.416,
    "end": 473.52,
    "text": "正是这两种力量之间的精妙平衡"
  },
  {
    "start": 473.52,
    "end": 477.44,
    "text": "古代道家对这种现象有着深刻的理解"
  },
  {
    "start": 477.44,
    "end": 481.616,
    "text": "如果说有什么概念能够代表道家精神"
  },
  {
    "start": 481.616,
    "end": 484.56,
    "text": "那就是平衡中的从容"
  },
  {
    "start": 484.56,
    "end": 488.192,
    "text": "对于一位真正实践道家炼金术的人来说"
  },
  {
    "start": 488.192,
    "end": 491.408,
    "text": "平衡的理念几乎成了身体本能——"
  },
  {
    "start": 491.408,
    "end": 493.84,
    "text": "因为道家炼金术能否成功"
  },
  {
    "start": 493.84,
    "end": 497.552,
    "text": "关键在于能否恰当地运用阴与阳的力量"
  },
  {
    "start": 497.552,
    "end": 501.296,
    "text": "而在众多关于阴阳调和的修炼法门中"
  },
  {
    "start": 501.296,
    "end": 506.16,
    "text": "本书关注的重点是道教中的双修"
  },
  {
    "start": 506.16,
    "end": 510.352,
    "text": "道家的双修之道 调和阴阳"
  },
  {
    "start": 510.352,
    "end": 514.096,
    "text": "双修,与抹大拉手稿中讨论的方法"
  },
  {
    "start": 514.096,
    "end": 516.368,
    "text": "有着惊人的相似之处"
  },
  {
    "start": 516.368,
    "end": 519.552,
    "text": "但也存在一些非常显著的不同"
  },
  {
    "start": 519.552,
    "end": 522.0,
    "text": "为了理解这种炼丹术"
  },
  {
    "start": 522.0,
    "end": 524.384,
    "text": "我们必须回到阴阳的概念"
  },
  {
    "start": 524.384,
    "end": 526.416,
    "text": "根据道家理论"
  },
  {
    "start": 526.416,
    "end": 530.496,
    "text": "健康的女性体内拥有几乎无限量的阴气"
  },
  {
    "start": 530.496,
    "end": 532.528,
    "text": "这是她天性的一部分"
  },
  {
    "start": 532.528,
    "end": 534.24,
    "text": "相比之下"
  },
  {
    "start": 534.24,
    "end": 537.984,
    "text": "健康的男性拥有的阳气则是有限的"
  },
  {
    "start": 537.984,
    "end": 539.856,
    "text": "与女性不同"
  },
  {
    "start": 539.856,
    "end": 544.032,
    "text": "男性的天性并没有赋予他无限的阳气储备"
  },
  {
    "start": 544.032,
    "end": 546.8,
    "text": "在高级的气功修炼中"
  },
  {
    "start": 546.8,
    "end": 550.032,
    "text": "女性炼丹师必须收集足够多的阳气"
  },
  {
    "start": 550.032,
    "end": 552.672,
    "text": "来平衡她体内过剩的阴气"
  },
  {
    "start": 552.672,
    "end": 555.648,
    "text": "而男性则必须收集阴气"
  },
  {
    "start": 555.648,
    "end": 558.192,
    "text": "来调和体内过剩的阳气"
  },
  {
    "start": 558.192,
    "end": 559.632,
    "text": "实际上"
  },
  {
    "start": 559.632,
    "end": 562.224,
    "text": "这一过程要复杂得多"
  },
  {
    "start": 562.224,
    "end": 566.416,
    "text": "修炼者体内阴阳的最终平衡至关重要"
  },
  {
    "start": 566.416,
    "end": 568.96,
    "text": "因为只有当阴阳达到平衡时"
  },
  {
    "start": 568.96,
    "end": 570.928,
    "text": "才能进行某些炼丹术"
  },
  {
    "start": 570.928,
    "end": 572.08,
    "text": "因此"
  },
  {
    "start": 572.08,
    "end": 576.08,
    "text": "所有道士都致力于调和自身的阴阳力量"
  },
  {
    "start": 576.08,
    "end": 578.832,
    "text": "那些独自修炼的炼金术士"
  },
  {
    "start": 578.832,
    "end": 583.744,
    "text": "必须通过复杂的炼金术冥想和能量调控（如气功）"
  },
  {
    "start": 583.744,
    "end": 585.472,
    "text": "来完成这项任务"
  },
  {
    "start": 585.472,
    "end": 588.672,
    "text": "而那些与异性伴侣一起修炼的人"
  },
  {
    "start": 588.672,
    "end": 592.592,
    "text": "可以在性行为过程中直接收集所需的气"
  },
  {
    "start": 592.592,
    "end": 594.304,
    "text": "在性接触时"
  },
  {
    "start": 594.304,
    "end": 597.712,
    "text": "身体内外都会产生大量过剩的气"
  },
  {
    "start": 597.712,
    "end": 600.064,
    "text": "抚摸和爱抚的动作会引发"
  },
  {
    "start": 600.064,
    "end": 602.208,
    "text": "体内及周围气的流动"
  },
  {
    "start": 602.208,
    "end": 605.152,
    "text": "受过双修训练的炼金术士"
  },
  {
    "start": 605.152,
    "end": 608.592,
    "text": "能够将这些过剩的气引入自己的气体身"
  },
  {
    "start": 608.592,
    "end": 611.088,
    "text": "从而大幅提升他们的修炼"
  },
  {
    "start": 611.088,
    "end": 613.392,
    "text": "在双修过程中"
  },
  {
    "start": 613.392,
    "end": 615.472,
    "text": "男性会避免射精"
  },
  {
    "start": 615.472,
    "end": 618.128,
    "text": "因为射精会耗损他的阳气"
  },
  {
    "start": 618.128,
    "end": 620.24,
    "text": "并导致结束性交行为"
  },
  {
    "start": 620.24,
    "end": 622.048,
    "text": "在这种炼丹术中"
  },
  {
    "start": 622.048,
    "end": 623.952,
    "text": "需要长时间的性交"
  },
  {
    "start": 623.952,
    "end": 626.768,
    "text": "原因很简单也很务实"
  },
  {
    "start": 626.768,
    "end": 629.568,
    "text": "延长性爱可以产生大量气"
  },
  {
    "start": 629.568,
    "end": 632.672,
    "text": "而双修的目标正是收集过剩的气"
  },
  {
    "start": 632.672,
    "end": 634.416,
    "text": "所以越多越好"
  },
  {
    "start": 634.416,
    "end": 636.512,
    "text": "为了帮助这个过程"
  },
  {
    "start": 636.512,
    "end": 640.272,
    "text": "古代道家发展了一种叫做山谷高潮的技巧"
  },
  {
    "start": 640.272,
    "end": 643.472,
    "text": "当男性感到射精即将来临时"
  },
  {
    "start": 643.472,
    "end": 645.728,
    "text": "他会停止对生殖器的刺激"
  },
  {
    "start": 645.728,
    "end": 647.184,
    "text": "休息片刻"
  },
  {
    "start": 647.184,
    "end": 648.768,
    "text": "直到欲望消退"
  },
  {
    "start": 648.768,
    "end": 651.2,
    "text": "然后再继续性交"
  },
  {
    "start": 651.2,
    "end": 653.792,
    "text": "刺激与休息交替进行"
  },
  {
    "start": 653.792,
    "end": 656.64,
    "text": "持续时间由双方意愿决定"
  },
  {
    "start": 656.64,
    "end": 658.096,
    "text": "结果是"
  },
  {
    "start": 658.096,
    "end": 663.264,
    "text": "双方都会进入高度转化且感官知觉极为敏锐的状态"
  },
  {
    "start": 663.264,
    "end": 666.912,
    "text": "因此他们对气的敏感度也大大提高"
  },
  {
    "start": 666.912,
    "end": 668.336,
    "text": "此外"
  },
  {
    "start": 668.336,
    "end": 670.368,
    "text": "持续的性接触所产生的"
  },
  {
    "start": 670.368,
    "end": 674.176,
    "text": "过剩阴阳之气也相当可观"
  },
  {
    "start": 674.176,
    "end": 677.232,
    "text": "道家炼丹术的最终目标是"
  },
  {
    "start": 677.232,
    "end": 680.192,
    "text": "长生不老 得道成仙"
  },
  {
    "start": 680.192,
    "end": 682.272,
    "text": "通过静修之法"
  },
  {
    "start": 682.272,
    "end": 685.136,
    "text": "炼丹术士获得了内心的宁静"
  },
  {
    "start": 685.136,
    "end": 688.832,
    "text": "并训练自己感知各种不同类型的气"
  },
  {
    "start": 688.832,
    "end": 690.816,
    "text": "借助这一认知"
  },
  {
    "start": 690.816,
    "end": 694.016,
    "text": "他们能够通过身体内精微的经络通道"
  },
  {
    "start": 694.016,
    "end": 696.544,
    "text": "采集并培育有益的气"
  },
  {
    "start": 696.544,
    "end": 697.824,
    "text": "由此"
  },
  {
    "start": 697.824,
    "end": 701.552,
    "text": "道家炼丹术士学会了如何将多余的气"
  },
  {
    "start": 701.552,
    "end": 703.296,
    "text": "提炼为精纯能量"
  },
  {
    "start": 703.296,
    "end": 706.784,
    "text": "用以增进健康和提升意识层级"
  },
  {
    "start": 706.784,
    "end": 708.848,
    "text": "在这个过程中"
  },
  {
    "start": 708.848,
    "end": 712.208,
    "text": "炼丹术士的身体不仅变得更加健康"
  },
  {
    "start": 712.208,
    "end": 713.984,
    "text": "还充满活力"
  },
  {
    "start": 713.984,
    "end": 716.304,
    "text": "这是因为他们不断采集气"
  },
  {
    "start": 716.304,
    "end": 719.744,
    "text": "并将其导入五脏六腑的自然结果"
  },
  {
    "start": 719.744,
    "end": 721.968,
    "text": "令人欣慰的是"
  },
  {
    "start": 721.968,
    "end": 724.56,
    "text": "即使最终未能炼成仙体"
  },
  {
    "start": 724.56,
    "end": 727.696,
    "text": "炼丹术所带来的收获与修行本身"
  },
  {
    "start": 727.696,
    "end": 729.536,
    "text": "也是值得的"
  },
  {
    "start": 729.536,
    "end": 731.008,
    "text": "最终"
  },
  {
    "start": 731.008,
    "end": 732.992,
    "text": "通过坚持不懈的修炼"
  },
  {
    "start": 732.992,
    "end": 734.864,
    "text": "炼丹术士的精微气体身"
  },
  {
    "start": 734.864,
    "end": 738.032,
    "text": "也会被充盈的生命能量所激活"
  },
  {
    "start": 738.032,
    "end": 740.608,
    "text": "变得如同肉身一般真实"
  },
  {
    "start": 740.608,
    "end": 742.304,
    "text": "借助气体身"
  },
  {
    "start": 742.304,
    "end": 745.68,
    "text": "他们可以在冥想中进入仙界——在那里"
  },
  {
    "start": 745.68,
    "end": 748.992,
    "text": "聚集着众多已飞升的炼丹术大师"
  },
  {
    "start": 748.992,
    "end": 751.136,
    "text": "在他们的教导加持下"
  },
  {
    "start": 751.136,
    "end": 755.824,
    "text": "修行者可以大大加快自身的修炼进程"
  },
  {
    "start": 755.824,
    "end": 759.504,
    "text": "在关于古埃及炼金术的分享中也提到"
  },
  {
    "start": 759.504,
    "end": 761.792,
    "text": "更高层次的炼金术知识"
  },
  {
    "start": 761.792,
    "end": 763.808,
    "text": "往往来自灵界的导师"
  },
  {
    "start": 763.808,
    "end": 766.176,
    "text": "它们被称为阿库尔"
  },
  {
    "start": 766.176,
    "end": 767.936,
    "text": "暮雨认为"
  },
  {
    "start": 767.936,
    "end": 771.264,
    "text": "这与密宗瑜伽所追求的与神合一"
  },
  {
    "start": 771.264,
    "end": 775.072,
    "text": "以及藏传佛教中召唤本尊神祇的观修"
  },
  {
    "start": 775.072,
    "end": 776.816,
    "text": "目标是一致的——"
  },
  {
    "start": 776.816,
    "end": 780.048,
    "text": "即通过连接居住在精神维度的存有"
  },
  {
    "start": 780.048,
    "end": 781.68,
    "text": "在他们的引导下"
  },
  {
    "start": 781.68,
    "end": 784.368,
    "text": "加速修行者的成长与蜕变"
  },
  {
    "start": 784.368,
    "end": 786.688,
    "text": "正如道家所相信的"
  },
  {
    "start": 786.688,
    "end": 788.464,
    "text": "最深奥的秘密"
  },
  {
    "start": 788.464,
    "end": 791.888,
    "text": "唯有通过道本身才能揭示"
  },
  {
    "start": 791.888,
    "end": 795.008,
    "text": "你无法从书籍中找到这些真理"
  },
  {
    "start": 795.008,
    "end": 796.976,
    "text": "因为禁止写下它们"
  },
  {
    "start": 796.976,
    "end": 799.76,
    "text": "唯有亲证方能领悟"
  },
  {
    "start": 799.76,
    "end": 801.216,
    "text": "最终"
  },
  {
    "start": 801.216,
    "end": 803.328,
    "text": "这项伟大的炼金术任务——"
  },
  {
    "start": 803.328,
    "end": 806.736,
    "text": "将性精华转化为神的过程"
  },
  {
    "start": 806.736,
    "end": 808.416,
    "text": "开始结出硕果"
  },
  {
    "start": 808.416,
    "end": 811.056,
    "text": "多年的苦修终有所成"
  },
  {
    "start": 811.056,
    "end": 813.28,
    "text": "从某种意义上说"
  },
  {
    "start": 813.28,
    "end": 816.016,
    "text": "尽管炼丹术士仍拥有肉身"
  },
  {
    "start": 816.016,
    "end": 819.024,
    "text": "但更多的是精神而非肉体"
  },
  {
    "start": 819.024,
    "end": 823.344,
    "text": "修行的道士此时已成为真正的圣贤"
  },
  {
    "start": 823.344,
    "end": 824.976,
    "text": "直到有一天"
  },
  {
    "start": 824.976,
    "end": 827.856,
    "text": "圣人感应到宇宙万象汇聚于一点"
  },
  {
    "start": 827.856,
    "end": 829.76,
    "text": "的机缘时刻到来——"
  },
  {
    "start": 829.76,
    "end": 832.976,
    "text": "这正是天地阴阳达到完全平衡"
  },
  {
    "start": 832.976,
    "end": 836.288,
    "text": "所有力量在此刻完美汇聚的时机"
  },
  {
    "start": 836.288,
    "end": 840.048,
    "text": "也往往是突破轮回 飞升成仙的契机"
  },
  {
    "start": 840.048,
    "end": 841.632,
    "text": "此时"
  },
  {
    "start": 841.632,
    "end": 843.344,
    "text": "死亡或许已近"
  },
  {
    "start": 843.344,
    "end": 846.896,
    "text": "或者炼丹术士选择自愿离开人世"
  },
  {
    "start": 846.896,
    "end": 849.312,
    "text": "通过进入深度冥想"
  },
  {
    "start": 849.312,
    "end": 852.32,
    "text": "圣人超越了时间与空间的束缚"
  },
  {
    "start": 852.32,
    "end": 853.856,
    "text": "呼吸停止"
  },
  {
    "start": 853.856,
    "end": 856.48,
    "text": "意识转移至气体身"
  },
  {
    "start": 856.48,
    "end": 857.456,
    "text": "这一过程"
  },
  {
    "start": 857.456,
    "end": 859.744,
    "text": "他早已演练无数次"
  },
  {
    "start": 859.744,
    "end": 861.12,
    "text": "于是"
  },
  {
    "start": 861.12,
    "end": 862.64,
    "text": "圣人乘龙而起"
  },
  {
    "start": 862.64,
    "end": 863.952,
    "text": "化光飞升"
  },
  {
    "start": 863.952,
    "end": 865.424,
    "text": "进入仙境"
  },
  {
    "start": 865.424,
    "end": 869.36,
    "text": "那龙正是他自身转化后的本性"
  },
  {
    "start": 869.36,
    "end": 873.504,
    "text": "炼丹术士此时已化为纯粹的能量存在"
  },
  {
    "start": 873.504,
    "end": 877.296,
    "text": "并可能以此状态存续极其漫长的时间"
  },
  {
    "start": 877.296,
    "end": 878.56,
    "text": "然而"
  },
  {
    "start": 878.56,
    "end": 880.032,
    "text": "也可能有一天"
  },
  {
    "start": 880.032,
    "end": 881.376,
    "text": "当圣人不再执着于"
  },
  {
    "start": 881.376,
    "end": 884.064,
    "text": "哪怕最细微的存在形式"
  },
  {
    "start": 884.064,
    "end": 885.76,
    "text": "他便会舍弃仙境"
  },
  {
    "start": 885.76,
    "end": 887.872,
    "text": "继续前行"
  },
  {
    "start": 887.872,
    "end": 890.848,
    "text": "大师级的炼丹术士将进一步提纯"
  },
  {
    "start": 890.848,
    "end": 893.456,
    "text": "那已极度精微的气体身"
  },
  {
    "start": 893.456,
    "end": 894.784,
    "text": "最终"
  },
  {
    "start": 894.784,
    "end": 897.232,
    "text": "在达到最细微的存在形式后"
  },
  {
    "start": 897.232,
    "end": 902.24,
    "text": "他将回归至源头——那无形的天堂之境"
  },
  {
    "start": 902.24,
    "end": 905.264,
    "text": "当圣人融入这一原初之地"
  },
  {
    "start": 905.264,
    "end": 908.272,
    "text": "自我的一切痕迹也随之消散——"
  },
  {
    "start": 908.272,
    "end": 910.8,
    "text": "如同水滴融入光之大海"
  },
  {
    "start": 910.8,
    "end": 912.096,
    "text": "此刻"
  },
  {
    "start": 912.096,
    "end": 913.296,
    "text": "不再有形体"
  },
  {
    "start": 913.296,
    "end": 914.896,
    "text": "不再有圣人"
  },
  {
    "start": 914.896,
    "end": 918.576,
    "text": "唯有道存在"
  }
]