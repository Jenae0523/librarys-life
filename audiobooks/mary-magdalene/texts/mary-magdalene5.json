[
  {
    "start": 0.0,
    "end": 3.0,
    "text": "【暮雨·注】名词解释"
  },
  {
    "start": 6.466,
    "end": 8.0,
    "text": "【炼金术】"
  },
  {
    "start": 8.033,
    "end": 12.0,
    "text": "是将一种形式 转化为另一种形式的"
  },
  {
    "start": 12.0,
    "end": 14.3,
    "text": "神秘艺术和科学"
  },
  {
    "start": 14.3,
    "end": 18.0,
    "text": "内在炼金术（例如埃及的体系）"
  },
  {
    "start": 18.0,
    "end": 21.233,
    "text": "是将意识的能量 和化身的生命力"
  },
  {
    "start": 21.266,
    "end": 24.066,
    "text": "转化为扩展的意识状态"
  },
  {
    "start": 24.1,
    "end": 28.433,
    "text": "以赋予修行者 增强的能力"
  },
  {
    "start": 28.433,
    "end": 30.0,
    "text": "【化身】"
  },
  {
    "start": 30.033,
    "end": 31.6,
    "text": "这本书特指"
  },
  {
    "start": 31.6,
    "end": 35.466,
    "text": "承载某种神奇力量（如伊西斯能量）的物质"
  },
  {
    "start": 35.466,
    "end": 36.333,
    "text": "肉身"
  },
  {
    "start": 36.366,
    "end": 38.633,
    "text": "但需要明确的是"
  },
  {
    "start": 38.633,
    "end": 41.333,
    "text": "化身并非等同于那种能量"
  },
  {
    "start": 41.366,
    "end": 44.566,
    "text": "他只能容纳能量的一小部分"
  },
  {
    "start": 44.6,
    "end": 47.8,
    "text": "同时保持着自身独特的人格特质"
  },
  {
    "start": 47.8,
    "end": 52.433,
    "text": "类似“神性”与人性并存"
  },
  {
    "start": 52.466,
    "end": 54.333,
    "text": "【荷鲁斯】"
  },
  {
    "start": 54.333,
    "end": 57.766,
    "text": "他是伊西斯和奥西里斯的儿子"
  },
  {
    "start": 57.8,
    "end": 59.9,
    "text": "在象征意义上"
  },
  {
    "start": 59.9,
    "end": 63.3,
    "text": "荷鲁斯代表精神/灵性的（奥西里斯）"
  },
  {
    "start": 63.3,
    "end": 66.233,
    "text": "和代表物质的（伊西斯）的结合"
  },
  {
    "start": 66.266,
    "end": 69.933,
    "text": "关于荷鲁斯的故事是寓言性的"
  },
  {
    "start": 69.933,
    "end": 71.6,
    "text": "因为他的灵性旅程"
  },
  {
    "start": 71.633,
    "end": 74.1,
    "text": "与我们的灵性旅程相同"
  },
  {
    "start": 74.1,
    "end": 77.5,
    "text": "就是我们通过提升脉轮的神圣通道"
  },
  {
    "start": 77.533,
    "end": 81.2,
    "text": "达到扩展的意识状态"
  },
  {
    "start": 81.2,
    "end": 83.033,
    "text": "【伊西斯】"
  },
  {
    "start": 83.066,
    "end": 85.366,
    "text": "是荷鲁斯的母亲"
  },
  {
    "start": 85.366,
    "end": 89.1,
    "text": "也是埃及神话中最重要的女神之一"
  },
  {
    "start": 89.1,
    "end": 91.566,
    "text": "她被视为宇宙之母"
  },
  {
    "start": 91.6,
    "end": 93.633,
    "text": "有关她的信仰传播到了"
  },
  {
    "start": 93.633,
    "end": 97.6,
    "text": "大多数已知的古代世界"
  },
  {
    "start": 97.633,
    "end": 99.233,
    "text": "【性魔法】"
  },
  {
    "start": 99.266,
    "end": 103.666,
    "text": "将性运用于魔法中有着悠久的历史"
  },
  {
    "start": 103.7,
    "end": 105.4,
    "text": "其跨越了数千年"
  },
  {
    "start": 105.4,
    "end": 108.133,
    "text": "和众多的文化和灵性传承"
  },
  {
    "start": 108.133,
    "end": 109.533,
    "text": "然而"
  },
  {
    "start": 109.566,
    "end": 113.5,
    "text": "伊西斯的性魔法并非被视为一般的魔法"
  },
  {
    "start": 113.5,
    "end": 116.4,
    "text": "与试图通过神奇的转变"
  },
  {
    "start": 116.4,
    "end": 119.6,
    "text": "来影响外部世界的一般魔法相比"
  },
  {
    "start": 119.6,
    "end": 122.0,
    "text": "伊西斯的性魔法旨在专注于"
  },
  {
    "start": 122.033,
    "end": 124.333,
    "text": "意识本身的神奇转化"
  },
  {
    "start": 124.366,
    "end": 125.566,
    "text": "因此"
  },
  {
    "start": 125.566,
    "end": 128.966,
    "text": "它实际上是一种内在的炼金术"
  },
  {
    "start": 129.0,
    "end": 131.5,
    "text": "一种针对在肉身中可以利用的"
  },
  {
    "start": 131.5,
    "end": 137.2,
    "text": "最原始和最强大能量来实现的炼金术"
  },
  {
    "start": 137.233,
    "end": 139.533,
    "text": "【入门/或称启蒙】"
  },
  {
    "start": 139.533,
    "end": 144.066,
    "text": "指从一个意识层次进入下一个层次的过程"
  },
  {
    "start": 144.1,
    "end": 147.633,
    "text": "入门 /启蒙是一种里程碑"
  },
  {
    "start": 147.633,
    "end": 150.3,
    "text": "承认达到或掌握了某种水平"
  },
  {
    "start": 150.333,
    "end": 154.133,
    "text": "它们可以由一个灵性存在直接授予"
  },
  {
    "start": 154.133,
    "end": 156.066,
    "text": "或者在某些情况下"
  },
  {
    "start": 156.066,
    "end": 158.766,
    "text": "由一个具有物质肉身的人授予"
  },
  {
    "start": 158.8,
    "end": 160.766,
    "text": "入门或启蒙"
  },
  {
    "start": 160.8,
    "end": 165.366,
    "text": "通常在某个特定的教派 组织或传统中进行"
  },
  {
    "start": 165.4,
    "end": 167.3,
    "text": "整个过程中"
  },
  {
    "start": 167.3,
    "end": 170.766,
    "text": "个人经历一系列的仪式 教导和考验"
  },
  {
    "start": 170.8,
    "end": 175.4,
    "text": "以达到某种精神 知识或心灵上的提升和转变"
  },
  {
    "start": 175.4,
    "end": 177.166,
    "text": "它们包括特定的仪式"
  },
  {
    "start": 177.2,
    "end": 180.266,
    "text": "动作 祈祷 冥想 学习"
  },
  {
    "start": 180.266,
    "end": 185.466,
    "text": "和传授特定的教义或秘密知识等"
  },
  {
    "start": 185.466,
    "end": 188.133,
    "text": "【入门者/或称启蒙者】"
  },
  {
    "start": 188.166,
    "end": 191.466,
    "text": "指已经通过了一个意识层次"
  },
  {
    "start": 191.466,
    "end": 195.066,
    "text": "到达下一个意识层次的门户或门槛的人"
  },
  {
    "start": 195.066,
    "end": 196.9,
    "text": "一般而言"
  },
  {
    "start": 196.9,
    "end": 200.6,
    "text": "入门者已经接受了神圣科学的训练"
  },
  {
    "start": 200.633,
    "end": 203.8,
    "text": "并获得了承担该神圣科学的精神传承的"
  },
  {
    "start": 203.8,
    "end": 206.766,
    "text": "访问权限"
  },
  {
    "start": 206.8,
    "end": 208.033,
    "text": "【Ka】"
  },
  {
    "start": 208.033,
    "end": 212.866,
    "text": "是埃及炼金术中描述的一种微妙的能量体"
  },
  {
    "start": 212.9,
    "end": 216.2,
    "text": "Ka是物质身体的能量副本"
  },
  {
    "start": 216.2,
    "end": 220.3,
    "text": "有时被称为以太双重体或灵性孪生体"
  },
  {
    "start": 220.3,
    "end": 222.8,
    "text": "埃及炼金术的很大一部分"
  },
  {
    "start": 222.8,
    "end": 227.266,
    "text": "是关注于对Ka能量体的转化"
  },
  {
    "start": 227.3,
    "end": 228.633,
    "text": "【扬升】"
  },
  {
    "start": 228.633,
    "end": 235.433,
    "text": "指将生命力 通过脉轮的神圣通道 提升至更高的大脑中枢的过程"
  },
  {
    "start": 235.433,
    "end": 238.433,
    "text": "从而激活更高的超感官意识"
  },
  {
    "start": 238.433,
    "end": 239.966,
    "text": "使修行者能够进入"
  },
  {
    "start": 240.0,
    "end": 242.833,
    "text": "精神/灵性的存在境界"
  },
  {
    "start": 242.866,
    "end": 245.1,
    "text": "这个术语也适用于"
  },
  {
    "start": 245.1,
    "end": 250.666,
    "text": "将Ka能量体提升至能量与光的更高领域"
  },
  {
    "start": 250.7,
    "end": 252.7,
    "text": "85 00:04:12,700 --> 00:04:15,900 【延伸阅读】历史资料补充"
  },
  {
    "start": 255.9,
    "end": 258.8,
    "text": "以下是书中出现的名词"
  },
  {
    "start": 258.833,
    "end": 261.966,
    "text": "所涉及的历史和地理资料"
  },
  {
    "start": 262.0,
    "end": 264.366,
    "text": "【圣殿骑士团】"
  },
  {
    "start": 264.366,
    "end": 268.666,
    "text": "是中世纪时期的一个基督教军事组织"
  },
  {
    "start": 268.666,
    "end": 270.7,
    "text": "成立于12世纪初"
  },
  {
    "start": 270.7,
    "end": 275.3,
    "text": "他们承诺同时担任骑士和修道士的职责"
  },
  {
    "start": 275.3,
    "end": 278.533,
    "text": "并在欧洲多国得到君主和教会的支持"
  },
  {
    "start": 278.566,
    "end": 280.333,
    "text": "迅速发展壮大"
  },
  {
    "start": 280.366,
    "end": 283.333,
    "text": "他们的组织结构高度秘密"
  },
  {
    "start": 283.366,
    "end": 285.933,
    "text": "采用独特的仪式和誓言"
  },
  {
    "start": 285.933,
    "end": 288.633,
    "text": "在保罗·柯艾略的《朝圣》中"
  },
  {
    "start": 288.666,
    "end": 290.766,
    "text": "记载了成为圣殿骑士的"
  },
  {
    "start": 290.8,
    "end": 292.7,
    "text": "秘密入会仪式过程"
  },
  {
    "start": 292.7,
    "end": 295.366,
    "text": "尽管在14世纪初"
  },
  {
    "start": 295.4,
    "end": 297.666,
    "text": "法国国王腓力四世和教会"
  },
  {
    "start": 297.7,
    "end": 301.433,
    "text": "发起了对圣殿骑士团的审判和迫害"
  },
  {
    "start": 301.433,
    "end": 303.5,
    "text": "并指控他们为异端"
  },
  {
    "start": 303.5,
    "end": 306.266,
    "text": "这导致了圣殿骑士团的解散"
  },
  {
    "start": 306.3,
    "end": 308.366,
    "text": "然而许多人认为"
  },
  {
    "start": 308.366,
    "end": 311.366,
    "text": "一些成员可能幸存下来"
  },
  {
    "start": 311.4,
    "end": 314.866,
    "text": "并很有可能更改了圣殿骑士团的名称"
  },
  {
    "start": 314.9,
    "end": 317.1,
    "text": "或采取建立分会的形式"
  },
  {
    "start": 317.1,
    "end": 318.766,
    "text": "继续秘密存在"
  },
  {
    "start": 318.766,
    "end": 322.066,
    "text": "有关圣殿骑士团的历史和传说"
  },
  {
    "start": 322.1,
    "end": 326.2,
    "text": "涉及其所守护的秘密 财富和神圣遗物"
  },
  {
    "start": 326.2,
    "end": 329.333,
    "text": "根据《抹大拉手稿》的描述"
  },
  {
    "start": 329.366,
    "end": 331.5,
    "text": "是否他们守护的秘密之一"
  },
  {
    "start": 331.5,
    "end": 333.566,
    "text": "正是耶稣的血脉"
  },
  {
    "start": 333.6,
    "end": 339.5,
    "text": "毕竟这会再次引发对耶稣基督的神性和人性的争议"
  },
  {
    "start": 339.5,
    "end": 340.733,
    "text": "此外"
  },
  {
    "start": 340.733,
    "end": 343.4,
    "text": "他们守护的另一个秘密可能是"
  },
  {
    "start": 343.4,
    "end": 346.1,
    "text": "与灵性炼金术有关的知识"
  },
  {
    "start": 346.133,
    "end": 347.533,
    "text": "圣杯"
  },
  {
    "start": 347.566,
    "end": 350.366,
    "text": "或许并不是指真实的杯子"
  },
  {
    "start": 350.366,
    "end": 353.933,
    "text": "这个词也许象征了“耶稣的血脉”"
  },
  {
    "start": 353.966,
    "end": 356.666,
    "text": "和“内在炼金术的秘密知识”"
  },
  {
    "start": 356.7,
    "end": 360.566,
    "text": "在《抹大拉手稿》中有这样的描述"
  },
  {
    "start": 360.566,
    "end": 363.866,
    "text": "两条蛇力会在松果体附近的位置"
  },
  {
    "start": 363.866,
    "end": 365.666,
    "text": "或者头部的中心"
  },
  {
    "start": 365.666,
    "end": 366.933,
    "text": "面对面地对峙"
  },
  {
    "start": 366.933,
    "end": 369.5,
    "text": "在这里想象一个圣杯"
  },
  {
    "start": 369.533,
    "end": 372.266,
    "text": "松果体正好处于圣杯的底部"
  },
  {
    "start": 372.266,
    "end": 375.266,
    "text": "手稿中多次提到“圣杯”这个词"
  },
  {
    "start": 375.266,
    "end": 379.4,
    "text": "并且都与内在炼金术有关"
  },
  {
    "start": 379.4,
    "end": 382.2,
    "text": "【托尔山和格拉斯顿伯里】"
  },
  {
    "start": 382.2,
    "end": 387.733,
    "text": "托尔山坐落于英格兰索默塞特郡的格拉斯顿伯里镇附近"
  },
  {
    "start": 387.766,
    "end": 389.4,
    "text": "是一座小山丘"
  },
  {
    "start": 389.4,
    "end": 393.933,
    "text": "书中提到它是德鲁伊人最神圣的心脏"
  },
  {
    "start": 393.933,
    "end": 396.266,
    "text": "在另一些资料中"
  },
  {
    "start": 396.3,
    "end": 398.866,
    "text": "它被视为“世界心轮的中心”"
  },
  {
    "start": 398.866,
    "end": 400.666,
    "text": "和“圣杯的家乡”"
  },
  {
    "start": 400.666,
    "end": 402.866,
    "text": "关于这里的传说"
  },
  {
    "start": 402.866,
    "end": 408.733,
    "text": "总是与亚瑟王 圆桌骑士和圣杯等神秘元素紧密相连"
  },
  {
    "start": 408.766,
    "end": 412.933,
    "text": "格拉斯顿伯里还因其悠久的历史"
  },
  {
    "start": 412.933,
    "end": 415.3,
    "text": "修道院遗址而闻名"
  },
  {
    "start": 415.333,
    "end": 416.766,
    "text": "这些遗址被认为是"
  },
  {
    "start": 416.766,
    "end": 419.533,
    "text": "英国最早的基督教修道院之一"
  },
  {
    "start": 419.533,
    "end": 424.966,
    "text": "因此这里成为了灵性和宗教朝圣者的聚集地"
  },
  {
    "start": 425.0,
    "end": 428.133,
    "text": "吸引着许多人前来寻找灵感和宁静"
  },
  {
    "start": 428.133,
    "end": 432.033,
    "text": "把格拉斯顿伯里视为“圣杯的家乡”"
  },
  {
    "start": 432.066,
    "end": 434.366,
    "text": "这个观点十分有趣"
  },
  {
    "start": 434.4,
    "end": 436.466,
    "text": "如果“圣杯”是指Yeshua"
  },
  {
    "start": 436.5,
    "end": 439.6,
    "text": "在最后的晚餐中使用的酒杯"
  },
  {
    "start": 439.6,
    "end": 443.033,
    "text": "为什么“圣杯的家乡”却在英格兰"
  },
  {
    "start": 443.033,
    "end": 444.766,
    "text": "而不是耶路撒冷"
  },
  {
    "start": 444.766,
    "end": 445.866,
    "text": "然而"
  },
  {
    "start": 445.9,
    "end": 448.2,
    "text": "《抹大拉手稿》中提到"
  },
  {
    "start": 448.2,
    "end": 451.133,
    "text": "Sahr到达英格兰时才一岁"
  },
  {
    "start": 451.133,
    "end": 453.7,
    "text": "并一直居住在格拉斯顿伯里"
  },
  {
    "start": 453.7,
    "end": 457.233,
    "text": "显然这里的“圣杯”是指Yeshua的女儿Sahr"
  },
  {
    "start": 457.266,
    "end": 458.933,
    "text": "【德鲁伊人】"
  },
  {
    "start": 458.933,
    "end": 461.166,
    "text": "他们作为古代凯尔特文化的"
  },
  {
    "start": 461.2,
    "end": 464.533,
    "text": "守护者和智慧传承者的角色"
  },
  {
    "start": 464.566,
    "end": 467.666,
    "text": "以及他们对知识和宇宙奥秘的追求"
  },
  {
    "start": 467.7,
    "end": 470.666,
    "text": "一直是历史上备受瞩目的一部分"
  },
  {
    "start": 470.666,
    "end": 474.266,
    "text": "德鲁伊人具有广泛的知识和技能"
  },
  {
    "start": 474.266,
    "end": 478.366,
    "text": "涵盖了宗教祭司 哲学家 占卜师"
  },
  {
    "start": 478.366,
    "end": 479.833,
    "text": "医师和法官等"
  },
  {
    "start": 479.833,
    "end": 483.833,
    "text": "他们的信仰系统强调与自然界的联系"
  },
  {
    "start": 483.866,
    "end": 486.933,
    "text": "他们被认为是连接人类与神灵"
  },
  {
    "start": 486.933,
    "end": 489.0,
    "text": "自然和宇宙的媒介"
  },
  {
    "start": 489.0,
    "end": 491.333,
    "text": "具有神秘的力量和智慧"
  },
  {
    "start": 491.366,
    "end": 496.033,
    "text": "但随着罗马帝国的扩张和基督教的传播"
  },
  {
    "start": 496.033,
    "end": 499.666,
    "text": "德鲁伊信仰逐渐受到压制和边缘化"
  },
  {
    "start": 499.7,
    "end": 502.566,
    "text": "德鲁伊人的存在可以追溯到"
  },
  {
    "start": 502.566,
    "end": 505.666,
    "text": "古代欧洲的凯尔特文化时期"
  },
  {
    "start": 505.666,
    "end": 509.833,
    "text": "大约从公元前2世纪到公元1世纪之间"
  },
  {
    "start": 509.866,
    "end": 512.066,
    "text": "他们居住的地区"
  },
  {
    "start": 512.066,
    "end": 515.933,
    "text": "包括现今的英国 爱尔兰 苏格兰"
  },
  {
    "start": 515.966,
    "end": 518.666,
    "text": "威尔士和法国的一部分地区"
  },
  {
    "start": 518.666,
    "end": 519.766,
    "text": "然而"
  },
  {
    "start": 519.8,
    "end": 522.3,
    "text": "德鲁伊人的历史可能更早"
  },
  {
    "start": 522.3,
    "end": 528.3,
    "text": "可以追溯到公元前6世纪甚至更早的时期"
  },
  {
    "start": 528.3,
    "end": 530.166,
    "text": "【福音书】"
  },
  {
    "start": 530.166,
    "end": 534.033,
    "text": "是基督教圣经中的一部重要文献"
  },
  {
    "start": 534.066,
    "end": 537.266,
    "text": "记载了耶稣基督的生平 教导"
  },
  {
    "start": 537.266,
    "end": 539.2,
    "text": "奇迹和救赎故事"
  },
  {
    "start": 539.2,
    "end": 542.566,
    "text": "基督教的四本福音书分别为"
  },
  {
    "start": 542.6,
    "end": 547.6,
    "text": "《马太福音》 《马可福音》 《路加福音》和《约翰福音》"
  },
  {
    "start": 547.6,
    "end": 552.933,
    "text": "其中马太和约翰被认为是Yeshua的门徒"
  },
  {
    "start": 552.933,
    "end": 554.0,
    "text": "《马可福音》"
  },
  {
    "start": 554.0,
    "end": 556.8,
    "text": "据说马可是彼得的传记作者"
  },
  {
    "start": 556.833,
    "end": 559.0,
    "text": "彼得是Yeshua的门徒"
  },
  {
    "start": 559.0,
    "end": 561.833,
    "text": "《路加福音》的作者路加"
  },
  {
    "start": 561.866,
    "end": 565.833,
    "text": "是耶稣时代的医生和跟随Yeshua的人之一"
  },
  {
    "start": 565.833,
    "end": 569.666,
    "text": "福音书的作者身份 写作时间和"
  },
  {
    "start": 569.7,
    "end": 573.6,
    "text": "文本的可靠性等方面一直存在争议"
  },
  {
    "start": 573.6,
    "end": 577.166,
    "text": "一些学者认为这些福音书的作者"
  },
  {
    "start": 577.2,
    "end": 579.6,
    "text": "可能是匿名的信徒"
  },
  {
    "start": 579.6,
    "end": 582.9,
    "text": "而不是直接与耶稣接触的门徒"
  },
  {
    "start": 582.933,
    "end": 587.5,
    "text": "他们认为这些福音书可能是在后来的时期"
  },
  {
    "start": 587.533,
    "end": 590.133,
    "text": "由多个作者或社群编写而成"
  },
  {
    "start": 590.133,
    "end": 593.733,
    "text": "由于福音书的传承和复制过程"
  },
  {
    "start": 593.733,
    "end": 596.233,
    "text": "以及可能的修改和添加"
  },
  {
    "start": 596.233,
    "end": 599.5,
    "text": "一些学者认为福音书中的一些细节"
  },
  {
    "start": 599.533,
    "end": 603.066,
    "text": "可能受到了后来的修订或解释的影响"
  },
  {
    "start": 603.066,
    "end": 607.566,
    "text": "这在朵洛莉絲·侃南通过催眠获得的资料里"
  },
  {
    "start": 607.6,
    "end": 611.3,
    "text": "也有提到类似的观点"
  },
  {
    "start": 611.3,
    "end": 613.366,
    "text": "【圣玛丽海滨】"
  },
  {
    "start": 613.4,
    "end": 616.933,
    "text": "是法国普罗旺斯地区的一个小镇"
  },
  {
    "start": 616.933,
    "end": 618.666,
    "text": "位于地中海沿岸"
  },
  {
    "start": 618.7,
    "end": 623.133,
    "text": "它以与抹大拉的玛丽亚相关的传说而闻名"
  },
  {
    "start": 623.166,
    "end": 627.566,
    "text": "据说抹大拉在这里登陆并传播基督教"
  },
  {
    "start": 627.6,
    "end": 629.5,
    "text": "【美索不达米亚】"
  },
  {
    "start": 629.5,
    "end": 632.4,
    "text": "是指位于现代伊拉克境内的"
  },
  {
    "start": 632.4,
    "end": 634.2,
    "text": "古代文明地区"
  },
  {
    "start": 634.233,
    "end": 640.066,
    "text": "它是指位于幼发拉底河和底格里斯河之间的地区"
  },
  {
    "start": 640.1,
    "end": 644.366,
    "text": "这个地区在历史上被认为是人类文明的发源地之一"
  },
  {
    "start": 644.4,
    "end": 648.133,
    "text": "这片土地上出现了众多古代文明"
  },
  {
    "start": 648.133,
    "end": 654.333,
    "text": "如苏美尔 巴比伦 亚述和新巴比伦等"
  }
]