[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "人体能量场 能量的载体"
  },
  {
    "start": 7.19,
    "end": 11.32,
    "text": "芭芭拉‧布伦南作为一名疗愈师和超感知者"
  },
  {
    "start": 11.32,
    "end": 14.67,
    "text": "她通过长期观察和治愈人的能量场"
  },
  {
    "start": 14.67,
    "end": 19.04,
    "text": "并在分别研究了植物 动物和人类的能量场后发现——"
  },
  {
    "start": 19.04,
    "end": 21.79,
    "text": "人体能量场为细胞提供了"
  },
  {
    "start": 21.79,
    "end": 24.89,
    "text": "一个可供其生长的能量矩阵结构"
  },
  {
    "start": 24.89,
    "end": 26.64,
    "text": "换句话说"
  },
  {
    "start": 26.64,
    "end": 29.34,
    "text": "人体能量场先于肉体存在"
  },
  {
    "start": 29.34,
    "end": 34.62,
    "text": "她提出支持这个观点的一种现象是 “幻肢效应”"
  },
  {
    "start": 34.62,
    "end": 38.06,
    "text": "并且相同的情况在植物身上也存在"
  },
  {
    "start": 38.06,
    "end": 41.49,
    "text": "被称为“幻叶效应”"
  },
  {
    "start": 41.49,
    "end": 45.66,
    "text": "科学解释  │ 什么是幻肢效应"
  },
  {
    "start": 45.66,
    "end": 49.39,
    "text": "维基百科的解释是 某些人和动物在"
  },
  {
    "start": 49.39,
    "end": 52.26,
    "text": "失去四肢后产生的一种幻觉"
  },
  {
    "start": 52.26,
    "end": 56.35,
    "text": "使他们感觉失去的四肢仍然附着在躯干上"
  },
  {
    "start": 56.35,
    "end": 58.81,
    "text": "并与身体的其他部分一起移动"
  },
  {
    "start": 58.81,
    "end": 61.24,
    "text": "约五到八成的截肢患者"
  },
  {
    "start": 61.24,
    "end": 63.6,
    "text": "会经历这种幻肢现象"
  },
  {
    "start": 63.6,
    "end": 66.74,
    "text": "幻肢效应也可能出现在其他部位"
  },
  {
    "start": 66.74,
    "end": 70.68,
    "text": "如乳房 牙齿 眼睛 阴茎 鼻 脸"
  },
  {
    "start": 70.68,
    "end": 73.22,
    "text": "甚至腹腔内的子宫和阑尾等"
  },
  {
    "start": 73.22,
    "end": 75.33,
    "text": "天生没有四肢的人"
  },
  {
    "start": 75.33,
    "end": 78.37,
    "text": "或瘫痪的病患也会出现幻肢"
  },
  {
    "start": 78.37,
    "end": 81.86,
    "text": "约一半的幻肢患者会经历难以忍受"
  },
  {
    "start": 81.86,
    "end": 82.97,
    "text": "的幻肢痛"
  },
  {
    "start": 82.97,
    "end": 85.53,
    "text": "幻肢也会有其他感受"
  },
  {
    "start": 85.53,
    "end": 88.45,
    "text": "如热 冷 痒或挤压感"
  },
  {
    "start": 88.45,
    "end": 91.39,
    "text": "有时幻肢会比正常的肢体短"
  },
  {
    "start": 91.39,
    "end": 93.62,
    "text": "或以不舒服的姿势扭曲"
  },
  {
    "start": 93.62,
    "end": 97.0,
    "text": "关于幻肢产生的原因有许多不同的猜"
  },
  {
    "start": 97.0,
    "end": 98.0,
    "text": "测"
  },
  {
    "start": 98.0,
    "end": 100.75,
    "text": "早期普遍的解释是在截肢后"
  },
  {
    "start": 100.75,
    "end": 103.49,
    "text": "肢断神经形成的神经瘤易发炎"
  },
  {
    "start": 103.49,
    "end": 105.86,
    "text": "并传递纷乱的信息到大脑"
  },
  {
    "start": 105.86,
    "end": 108.22,
    "text": "使大脑误以为断肢仍存在"
  },
  {
    "start": 108.22,
    "end": 111.48,
    "text": "但一位神经科学家拉马钱德兰（"
  },
  {
    "start": 111.48,
    "end": 112.97,
    "text": "）的新发现"
  },
  {
    "start": 112.97,
    "end": 116.28,
    "text": "则为幻肢的成因提供一个新的解释"
  },
  {
    "start": 116.28,
    "end": 117.94,
    "text": "并被广泛接受"
  },
  {
    "start": 117.94,
    "end": 119.4,
    "text": "他提出"
  },
  {
    "start": 119.4,
    "end": 121.24,
    "text": "周边神经将信息传达至"
  },
  {
    "start": 121.24,
    "end": 123.33,
    "text": "大脑皮质的感觉区"
  },
  {
    "start": 123.33,
    "end": 125.06,
    "text": "由此产生知觉"
  },
  {
    "start": 125.06,
    "end": 129.09,
    "text": "人体各部位在大脑皮质有固定的投射区"
  },
  {
    "start": 129.09,
    "end": 130.15,
    "text": "以手为例"
  },
  {
    "start": 130.15,
    "end": 132.14,
    "text": "手部神经的投射区域"
  },
  {
    "start": 132.14,
    "end": 134.89,
    "text": "与脸区 躯干区相邻"
  },
  {
    "start": 134.89,
    "end": 137.04,
    "text": "当手被截去时"
  },
  {
    "start": 137.04,
    "end": 138.67,
    "text": "手部神经失效"
  },
  {
    "start": 138.67,
    "end": 139.75,
    "text": "然而"
  },
  {
    "start": 139.75,
    "end": 144.51,
    "text": "脸区或躯干区的神经纤维则向旁延伸至手区"
  },
  {
    "start": 144.51,
    "end": 147.52,
    "text": "使脸传出的信息除了到达脸区外"
  },
  {
    "start": 147.52,
    "end": 149.24,
    "text": "也会到达手区"
  },
  {
    "start": 149.24,
    "end": 153.1,
    "text": "拉玛在其著作 《寻找脑中幻影》中"
  },
  {
    "start": 153.1,
    "end": 155.45,
    "text": "有这样一段描述"
  },
  {
    "start": 155.45,
    "end": 157.5,
    "text": "我刺激他的脸颊"
  },
  {
    "start": 157.5,
    "end": 159.875,
    "text": "“你感觉如何 ”“你在触"
  },
  {
    "start": 159.875,
    "end": 163.39,
    "text": "摸我的脸颊 ”“还有什么 ”“喂"
  },
  {
    "start": 163.39,
    "end": 164.175,
    "text": "你知道"
  },
  {
    "start": 164.175,
    "end": 165.6,
    "text": "这很奇怪"
  },
  {
    "start": 165.6,
    "end": 167.76,
    "text": "你在触摸我失去的大拇指"
  },
  {
    "start": 167.76,
    "end": 168.21,
    "text": "我的幻"
  },
  {
    "start": 168.21,
    "end": 170.43,
    "text": "拇指 ”我把棉棒移到他"
  },
  {
    "start": 170.43,
    "end": 171.53,
    "text": "的上唇"
  },
  {
    "start": 171.53,
    "end": 171.84,
    "text": "“这里"
  },
  {
    "start": 171.84,
    "end": 176.315,
    "text": "如何 ”“你在触摸我的食指和我的上唇 ”"
  },
  {
    "start": 176.315,
    "end": 177.165,
    "text": "“真的"
  },
  {
    "start": 177.165,
    "end": 179.17,
    "text": "你确定 ”“是"
  },
  {
    "start": 179.17,
    "end": 183.19,
    "text": "我能感觉它在这两个地方 ” 拉玛由"
  },
  {
    "start": 183.19,
    "end": 184.21,
    "text": "此推测"
  },
  {
    "start": 184.21,
    "end": 185.67,
    "text": "每当患者笑"
  },
  {
    "start": 185.67,
    "end": 187.52,
    "text": "或打呵欠时"
  },
  {
    "start": 187.52,
    "end": 189.39,
    "text": "其脸部的神经脉冲也"
  },
  {
    "start": 189.39,
    "end": 191.7,
    "text": "投射到大脑皮质手区"
  },
  {
    "start": 191.7,
    "end": 192.78,
    "text": "刺激大脑产生"
  },
  {
    "start": 192.78,
    "end": 192.95,
    "text": "手"
  },
  {
    "start": 192.95,
    "end": 194.49,
    "text": "还存在的错觉"
  },
  {
    "start": 194.49,
    "end": 195.86,
    "text": "有趣的是"
  },
  {
    "start": 195.86,
    "end": 198.31,
    "text": "在治疗幻肢痛的疗法中"
  },
  {
    "start": 198.31,
    "end": 202.37,
    "text": "除了常见的抗忧郁药和脊髓刺激（一种放电疗法）"
  },
  {
    "start": 202.37,
    "end": 203.84,
    "text": "还有心灵疗法"
  },
  {
    "start": 203.84,
    "end": 208.91,
    "text": "针灸和催眠也被用来治疗幻肢痛"
  },
  {
    "start": 208.91,
    "end": 213.39,
    "text": "超感知观察  │ 幻肢的能量体"
  },
  {
    "start": 213.39,
    "end": 214.47,
    "text": "然而"
  },
  {
    "start": 214.47,
    "end": 216.63,
    "text": "在患者的能量场中"
  },
  {
    "start": 216.63,
    "end": 218.91,
    "text": "超感知可以观察到幻肢"
  },
  {
    "start": 218.91,
    "end": 220.16,
    "text": "由于感觉是"
  },
  {
    "start": 220.16,
    "end": 220.35,
    "text": "能"
  },
  {
    "start": 220.35,
    "end": 222.11,
    "text": "量场所携带的"
  },
  {
    "start": 222.11,
    "end": 223.68,
    "text": "所以这对超感知观察"
  },
  {
    "start": 223.68,
    "end": 225.22,
    "text": "者来说是有意义的"
  },
  {
    "start": 225.22,
    "end": 226.99,
    "text": "在一个案例中"
  },
  {
    "start": 226.99,
    "end": 229.85,
    "text": "我的朋友约翰·皮拉克斯博士"
  },
  {
    "start": 229.85,
    "end": 233.2,
    "text": "纽约核心能量学研究所创始人和主任"
  },
  {
    "start": 233.2,
    "end": 234.15,
    "text": "以及《核心能源"
  },
  {
    "start": 234.15,
    "end": 235.72,
    "text": "学》一书的作者"
  },
  {
    "start": 235.72,
    "end": 238.39,
    "text": "正在治疗一名有幻肢效应的病人"
  },
  {
    "start": 238.39,
    "end": 242.17,
    "text": "这位女士一直觉得她的腿被绑在身体下面"
  },
  {
    "start": 242.17,
    "end": 243.95,
    "text": "所以每次坐下时"
  },
  {
    "start": 243.95,
    "end": 245.7,
    "text": "她都感觉坐在腿上"
  },
  {
    "start": 245.7,
    "end": 249.88,
    "text": "皮拉克斯博士可以看到这个肢体的能量场"
  },
  {
    "start": 249.88,
    "end": 252.1,
    "text": "弯曲成她感觉到的位置"
  },
  {
    "start": 252.1,
    "end": 254.46,
    "text": "他处理了她的能量场"
  },
  {
    "start": 254.46,
    "end": 256.39,
    "text": "使能量腿伸直"
  },
  {
    "start": 256.39,
    "end": 258.39,
    "text": "处于正常的行走姿态"
  },
  {
    "start": 258.39,
    "end": 260.42,
    "text": "这缓解了她的症状"
  },
  {
    "start": 260.42,
    "end": 261.64,
    "text": "后来"
  },
  {
    "start": 261.64,
    "end": 263.33,
    "text": "他和进行截肢手术的"
  },
  {
    "start": 263.33,
    "end": 265.44,
    "text": "外科医生核对发现"
  },
  {
    "start": 265.44,
    "end": 269.13,
    "text": "原来外科医生曾把腿绑在那个位置进行手术"
  },
  {
    "start": 269.13,
    "end": 272.2,
    "text": "我相信这位患者感受到的幻肢"
  },
  {
    "start": 272.2,
    "end": 273.69,
    "text": "就是她的能量体"
  },
  {
    "start": 273.69,
    "end": 276.92,
    "text": "这意味着肢体的基本能量结构"
  },
  {
    "start": 276.92,
    "end": 278.31,
    "text": "仍然存在"
  },
  {
    "start": 278.31,
    "end": 279.53,
    "text": "因此"
  },
  {
    "start": 279.53,
    "end": 282.05,
    "text": "这个能量场先于肉体存在"
  },
  {
    "start": 282.05,
    "end": 285.38,
    "text": "这与许多科学研究人员的观点不同"
  },
  {
    "start": 285.38,
    "end": 289.56,
    "text": "他们假设这个能量场是由身体产生的"
  },
  {
    "start": 289.56,
    "end": 291.69,
    "text": "而不是由能量场创造了物"
  },
  {
    "start": 291.69,
    "end": 291.84,
    "text": "质"
  },
  {
    "start": 291.84,
    "end": 292.63,
    "text": "身体"
  },
  {
    "start": 292.63,
    "end": 296.37,
    "text": "如果人体能量场确实先于肉体"
  },
  {
    "start": 296.37,
    "end": 298.33,
    "text": "这就意味着有一天我们可以"
  },
  {
    "start": 298.33,
    "end": 302.26,
    "text": "像火蜥蜴一样再生四肢"
  },
  {
    "start": 302.26,
    "end": 304.33,
    "text": "像火蜥蜴一样"
  },
  {
    "start": 304.33,
    "end": 307.11,
    "text": "长出新腿的小男孩"
  },
  {
    "start": 307.11,
    "end": 309.68,
    "text": "在作者 德隆瓦洛 ·麦基洗德（ ）的"
  },
  {
    "start": 309.68,
    "end": 312.29,
    "text": "《生命之花的 古老秘密》中"
  },
  {
    "start": 312.29,
    "end": 314.58,
    "text": "还真有一个案例是一个小男孩"
  },
  {
    "start": 314.58,
    "end": 317.68,
    "text": "像火蜥蜴一样长出了一条全新的腿"
  },
  {
    "start": 317.68,
    "end": 321.75,
    "text": "书中提到 一个几乎被摧毁的病变器"
  },
  {
    "start": 321.75,
    "end": 322.62,
    "text": "官"
  },
  {
    "start": 322.62,
    "end": 325.95,
    "text": "可以仅仅通过意识来恢复健康"
  },
  {
    "start": 325.95,
    "end": 329.36,
    "text": "我有一个朋友 Diana Gazes"
  },
  {
    "start": 329.36,
    "end": 331.0,
    "text": "她在纽约主持一个叫"
  },
  {
    "start": 331.0,
    "end": 333.47,
    "text": "“凝望未来”的电视节目"
  },
  {
    "start": 333.47,
    "end": 335.86,
    "text": "她经常在节目上播出"
  },
  {
    "start": 335.86,
    "end": 338.42,
    "text": "各种神奇的治愈过程"
  },
  {
    "start": 338.42,
    "end": 340.98,
    "text": "她曾计划播出一个节目"
  },
  {
    "start": 340.98,
    "end": 344.28,
    "text": "关于一个11岁男孩的神奇经历"
  },
  {
    "start": 344.28,
    "end": 347.69,
    "text": "她用视频记录他的经历超过一年"
  },
  {
    "start": 347.69,
    "end": 350.5,
    "text": "但在她几乎已经要完成时"
  },
  {
    "start": 350.5,
    "end": 352.76,
    "text": "她的节目被取消了"
  },
  {
    "start": 352.76,
    "end": 354.57,
    "text": "当男孩年幼时"
  },
  {
    "start": 354.57,
    "end": 356.3,
    "text": "他曾养过蜥蜴"
  },
  {
    "start": 356.3,
    "end": 357.67,
    "text": "众所周知"
  },
  {
    "start": 357.67,
    "end": 360.61,
    "text": "蜥蜴的腿和尾巴在被扯掉后"
  },
  {
    "start": 360.61,
    "end": 362.88,
    "text": "会再长出一个新的"
  },
  {
    "start": 362.88,
    "end": 365.32,
    "text": "而他的父母没有告诉他"
  },
  {
    "start": 365.32,
    "end": 368.78,
    "text": "这种再生能力只发生在蜥蜴身上"
  },
  {
    "start": 368.78,
    "end": 371.41,
    "text": "而不会发生在人类身上"
  },
  {
    "start": 371.41,
    "end": 372.3,
    "text": "因此"
  },
  {
    "start": 372.3,
    "end": 375.45,
    "text": "他相信一切生物都能像蜥蜴一样"
  },
  {
    "start": 375.45,
    "end": 375.87,
    "text": "包括"
  },
  {
    "start": 375.87,
    "end": 376.88,
    "text": "人类"
  },
  {
    "start": 376.88,
    "end": 378.93,
    "text": "在他大约10岁时"
  },
  {
    "start": 378.93,
    "end": 380.81,
    "text": "他失去了一条腿"
  },
  {
    "start": 380.81,
    "end": 383.16,
    "text": "那么他会做什么呢"
  },
  {
    "start": 383.16,
    "end": 385.62,
    "text": "他长出了一条新的腿"
  },
  {
    "start": 385.62,
    "end": 389.13,
    "text": "这些全都记录在Diana的视频里"
  },
  {
    "start": 389.13,
    "end": 391.28,
    "text": "在视频的最后部分"
  },
  {
    "start": 391.28,
    "end": 393.37,
    "text": "他正在长出脚趾"
  },
  {
    "start": 393.37,
    "end": 396.54,
    "text": "这一过程大约持续了一年"
  },
  {
    "start": 396.54,
    "end": 398.15,
    "text": "什么是可能"
  },
  {
    "start": 398.15,
    "end": 399.82,
    "text": "什么是不可能"
  },
  {
    "start": 399.82,
    "end": 400.41,
    "text": "这完"
  },
  {
    "start": 400.41,
    "end": 403.0,
    "text": "全取决于你的信仰系统"
  },
  {
    "start": 403.0,
    "end": 405.37,
    "text": "你相信的就是可能的"
  },
  {
    "start": 405.37,
    "end": 406.91,
    "text": "而你相信的"
  },
  {
    "start": 406.91,
    "end": 410.0,
    "text": "也会成为你给自己施加的限制"
  },
  {
    "start": 410.0,
    "end": 414.26,
    "text": "幻叶效应  │ 植物的能量场"
  },
  {
    "start": 414.26,
    "end": 416.36,
    "text": "电晕放电成像（ ）"
  },
  {
    "start": 416.36,
    "end": 418.99,
    "text": "提供了进一步的证据来支持芭芭"
  },
  {
    "start": 418.99,
    "end": 420.76,
    "text": "拉‧布伦南的假设——"
  },
  {
    "start": 420.76,
    "end": 422.76,
    "text": "即能量场才是主要的"
  },
  {
    "start": 422.76,
    "end": 424.07,
    "text": "而非肉体"
  },
  {
    "start": 424.07,
    "end": 427.62,
    "text": "这个实验证据被称为幻叶效应（ ）"
  },
  {
    "start": 427.62,
    "end": 430.16,
    "text": "幻叶效应最早是在20世纪"
  },
  {
    "start": 430.16,
    "end": 430.37,
    "text": "7"
  },
  {
    "start": 430.37,
    "end": 432.97,
    "text": "0年代由柯尔里安摄影技术（ ）"
  },
  {
    "start": 432.97,
    "end": 433.12,
    "text": "记"
  },
  {
    "start": 433.12,
    "end": 433.82,
    "text": "录到的"
  },
  {
    "start": 433.82,
    "end": 436.12,
    "text": "据称这种摄影技术"
  },
  {
    "start": 436.12,
    "end": 439.37,
    "text": "能够捕捉物体周围的电晕放电图像"
  },
  {
    "start": 439.37,
    "end": 441.39,
    "text": "在这种效应中"
  },
  {
    "start": 441.39,
    "end": 443.86,
    "text": "当叶片的一部分被切除后"
  },
  {
    "start": 443.86,
    "end": 446.48,
    "text": "使用高频电摄影技术拍摄时"
  },
  {
    "start": 446.48,
    "end": 449.72,
    "text": "叶片的影像仍然显示完整的形状"
  },
  {
    "start": 449.72,
    "end": 451.9,
    "text": "包括明亮色彩和光线"
  },
  {
    "start": 451.9,
    "end": 454.46,
    "text": "似乎切除的部分依然存在"
  },
  {
    "start": 454.46,
    "end": 455.56,
    "text": "因此"
  },
  {
    "start": 455.56,
    "end": 457.0,
    "text": "我的结论是"
  },
  {
    "start": 457.0,
    "end": 458.08,
    "text": "叶子缺失部分的"
  },
  {
    "start": 458.08,
    "end": 460.66,
    "text": "影像是能量场形成的"
  },
  {
    "start": 460.66,
    "end": 463.04,
    "text": "即使物质叶片有缺失"
  },
  {
    "start": 463.04,
    "end": 465.07,
    "text": "能量场仍然完好无损"
  },
  {
    "start": 465.07,
    "end": 466.33,
    "text": "因此"
  },
  {
    "start": 466.33,
    "end": 470.6,
    "text": "能量场不是从物质中产生的 恰恰相反"
  },
  {
    "start": 470.6,
    "end": 472.68,
    "text": "物质是由能量产生的"
  },
  {
    "start": 472.68,
    "end": 474.7,
    "text": "这一结论表明"
  },
  {
    "start": 474.7,
    "end": 478.22,
    "text": "能量场在健康和生长过程中的重要性"
  },
  {
    "start": 478.22,
    "end": 480.26,
    "text": "远远超过之前的认知"
  },
  {
    "start": 480.26,
    "end": 483.91,
    "text": "由于物质肉体是由能量场产生的"
  },
  {
    "start": 483.91,
    "end": 486.71,
    "text": "这个能量场的不平衡或扭曲"
  },
  {
    "start": 486.71,
    "end": 488.69,
    "text": "最终会导致肉体的疾病"
  },
  {
    "start": 488.69,
    "end": 489.88,
    "text": "因此"
  },
  {
    "start": 489.88,
    "end": 491.43,
    "text": "治疗能量场扭曲"
  },
  {
    "start": 491.43,
    "end": 493.11,
    "text": "将会疗愈肉体"
  },
  {
    "start": 493.11,
    "end": 494.46,
    "text": "疗愈"
  },
  {
    "start": 494.46,
    "end": 497.5,
    "text": "就是通过重组 平衡和充能"
  },
  {
    "start": 497.5,
    "end": 499.85,
    "text": "来恢复和调节能量场"
  },
  {
    "start": 501.85,
    "end": 506.15,
    "text": "人体经络  │ 现代科学研究"
  },
  {
    "start": 506.15,
    "end": 507.8,
    "text": "在作者辛蒂・黛尔（ ）的"
  },
  {
    "start": 507.8,
    "end": 511.04,
    "text": "《精微体 人体能量解剖全书》中有"
  },
  {
    "start": 511.04,
    "end": 511.21,
    "text": "大"
  },
  {
    "start": 511.21,
    "end": 512.47,
    "text": "量内容"
  },
  {
    "start": 512.47,
    "end": 516.05,
    "text": "从现代科学角度讨论了人体经络"
  },
  {
    "start": 516.05,
    "end": 517.64,
    "text": "（包括生物力学"
  },
  {
    "start": 517.64,
    "end": 519.59,
    "text": "生物电磁学"
  },
  {
    "start": 519.59,
    "end": 521.03,
    "text": "驻波理论"
  },
  {
    "start": 521.03,
    "end": 522.99,
    "text": "次级电气系统理论等）"
  },
  {
    "start": 522.99,
    "end": 527.14,
    "text": "书中列举了大量西方科学家的实验和研究"
  },
  {
    "start": 527.14,
    "end": 530.11,
    "text": "越来越多的科学家得到相同的结论"
  },
  {
    "start": 530.11,
    "end": 531.76,
    "text": "中医中的经络系统"
  },
  {
    "start": 531.76,
    "end": 534.05,
    "text": "是次级电气系统的一部分"
  },
  {
    "start": 534.05,
    "end": 536.74,
    "text": "该系统可能包括但又不同"
  },
  {
    "start": 536.74,
    "end": 537.25,
    "text": "于"
  },
  {
    "start": 537.25,
    "end": 540.64,
    "text": "已建立的循环系统和中枢神经系统"
  },
  {
    "start": 540.64,
    "end": 542.13,
    "text": "通过研究"
  },
  {
    "start": 542.13,
    "end": 544.59,
    "text": "byern nor-den-strem博士发现"
  },
  {
    "start": 544.59,
    "end": 546.62,
    "text": "电流和血液一样"
  },
  {
    "start": 546.62,
    "end": 548.29,
    "text": "都流经血液"
  },
  {
    "start": 548.29,
    "end": 552.02,
    "text": "但似乎“供给”了两个不同（但相互关联）的系统"
  },
  {
    "start": 552.02,
    "end": 554.25,
    "text": "由此科学家推论"
  },
  {
    "start": 554.25,
    "end": 556.29,
    "text": "实际上人体内存在一个“次"
  },
  {
    "start": 556.29,
    "end": 557.12,
    "text": "级电路”"
  },
  {
    "start": 557.12,
    "end": 564.46,
    "text": "而针灸就是针对这套“人体次级电气系统”进行的治疗"
  },
  {
    "start": 564.46,
    "end": 566.29,
    "text": "或许有一天"
  },
  {
    "start": 566.29,
    "end": 568.31,
    "text": "科学与灵性不再被视为"
  },
  {
    "start": 568.31,
    "end": 570.32,
    "text": "对立和隔离的两极"
  },
  {
    "start": 570.32,
    "end": 571.82,
    "text": "暮雨认为"
  },
  {
    "start": 571.82,
    "end": 575.52,
    "text": "它们只是两种不同的视角和描述方法"
  },
  {
    "start": 575.52,
    "end": 576.44,
    "text": "各自解释了"
  },
  {
    "start": 576.44,
    "end": 578.49,
    "text": "这个世界的部分事实"
  },
  {
    "start": 578.49,
    "end": 583.26,
    "text": "神秘主义和灵异现象不应再被视为迷信"
  },
  {
    "start": 583.26,
    "end": 585.67,
    "text": "而被科学信仰者拒之门外"
  },
  {
    "start": 585.67,
    "end": 590.0,
    "text": "但更不能盲目崇拜 所谓的“传统”或“神”"
  },
  {
    "start": 590.0,
    "end": 592.11,
    "text": "而缺乏理性的思考"
  },
  {
    "start": 592.11,
    "end": 594.82,
    "text": "只有将两者统一整合"
  },
  {
    "start": 594.82,
    "end": 596.84,
    "text": "我们才能获得更全面的理解"
  },
  {
    "start": 596.84,
    "end": 598.82,
    "text": "和更广阔的视野"
  },
  {
    "start": 598.82,
    "end": 600.77,
    "text": "来真正认识我们自己"
  },
  {
    "start": 600.77,
    "end": 601.99,
    "text": "向那些"
  },
  {
    "start": 601.99,
    "end": 602.14,
    "text": "已"
  },
  {
    "start": 602.14,
    "end": 602.5,
    "text": "经走"
  }
]