[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "【暮雨·注】"
  },
  {
    "start": 5.5600000000000005,
    "end": 7.3,
    "text": "为方便理解"
  },
  {
    "start": 7.3,
    "end": 11.42,
    "text": "在最后附有有关概念的名词解释和补充资料"
  },
  {
    "start": 11.42,
    "end": 13.98,
    "text": "神经科学已经证明"
  },
  {
    "start": 13.98,
    "end": 18.28,
    "text": "我们的身体与量子世界存在着密切联系"
  },
  {
    "start": 18.28,
    "end": 21.8,
    "text": "大量研究验证了你的思想和意图"
  },
  {
    "start": 21.8,
    "end": 24.59,
    "text": "可以影响和改变你的身体"
  },
  {
    "start": 24.59,
    "end": 25.48,
    "text": "那么"
  },
  {
    "start": 25.48,
    "end": 28.3,
    "text": "要如何有效地做到这一点"
  },
  {
    "start": 28.3,
    "end": 32.22,
    "text": "就像你已经学会了如何在牛顿物理现实的"
  },
  {
    "start": 32.22,
    "end": 34.82,
    "text": "日常世界中运作一样"
  },
  {
    "start": 34.82,
    "end": 38.29,
    "text": "你也可以学会在量子世界中做事"
  },
  {
    "start": 38.29,
    "end": 41.71,
    "text": "你只需要一个可靠的“教学方法”"
  },
  {
    "start": 41.71,
    "end": 43.86,
    "text": "而内在炼金术系统"
  },
  {
    "start": 43.86,
    "end": 47.66,
    "text": "正是在量子世界中运作的实践方法"
  },
  {
    "start": 47.66,
    "end": 50.94,
    "text": "根据古埃及炼金术士的说法"
  },
  {
    "start": 50.94,
    "end": 52.92,
    "text": "我们拥有两个身体"
  },
  {
    "start": 52.92,
    "end": 54.58,
    "text": "第一个称为（khat）"
  },
  {
    "start": 54.58,
    "end": 56.66,
    "text": "是我们的血肉之躯"
  },
  {
    "start": 56.66,
    "end": 58.82,
    "text": "用来进食和饮水"
  },
  {
    "start": 58.82,
    "end": 61.92,
    "text": "它是我们通常所认知的身体"
  },
  {
    "start": 61.92,
    "end": 63.3,
    "text": "这具物质身体"
  },
  {
    "start": 63.3,
    "end": 67.18,
    "text": "会随时间的推移而生长 老化"
  },
  {
    "start": 67.18,
    "end": 68.92,
    "text": "最终死亡"
  },
  {
    "start": 68.92,
    "end": 71.95,
    "text": "第二个不被普通人察觉的身体"
  },
  {
    "start": 71.95,
    "end": 73.29,
    "text": "被称为（Ka）"
  },
  {
    "start": 73.29,
    "end": 77.85,
    "text": "有时被称为以太分身或灵性孪生体"
  },
  {
    "start": 77.85,
    "end": 80.32,
    "text": "它是肉体（khat）的复制品"
  },
  {
    "start": 80.32,
    "end": 82.59,
    "text": "由纯粹的能量组成"
  },
  {
    "start": 82.59,
    "end": 84.72,
    "text": "而非血肉构成"
  },
  {
    "start": 84.72,
    "end": 87.92,
    "text": "这个Ka体渗透到 物质肉身中"
  },
  {
    "start": 87.92,
    "end": 90.19,
    "text": "并且身体的每一个部分"
  },
  {
    "start": 90.19,
    "end": 92.94,
    "text": "都被 Ka 所包围"
  },
  {
    "start": 92.94,
    "end": 94.5,
    "text": "Ka体的转变"
  },
  {
    "start": 94.5,
    "end": 98.06,
    "text": "是埃及炼金术中的一个核心重点"
  },
  {
    "start": 98.06,
    "end": 102.27,
    "text": "但在我们讨论如何实现这一转化之前"
  },
  {
    "start": 102.27,
    "end": 106.51,
    "text": "我认为最好先从物理学的角度来了解这两个身体"
  },
  {
    "start": 106.51,
    "end": 108.94,
    "text": "（Ka 和 khat）"
  },
  {
    "start": 108.94,
    "end": 112.32,
    "text": "我相信通过现代科学的语境"
  },
  {
    "start": 112.32,
    "end": 114.34,
    "text": "我们可以更好地理解Ka体"
  },
  {
    "start": 114.34,
    "end": 117.2,
    "text": "及其非同寻常的潜力"
  },
  {
    "start": 119.2,
    "end": 123.02,
    "text": "量子物理学视角"
  },
  {
    "start": 123.02,
    "end": 126.49,
    "text": "我们可以用牛顿物理学很好地描述"
  },
  {
    "start": 126.49,
    "end": 128.57,
    "text": "密实的物质身体"
  },
  {
    "start": 128.57,
    "end": 129.54,
    "text": "例如"
  },
  {
    "start": 129.54,
    "end": 130.0,
    "text": "它遵"
  },
  {
    "start": 130.0,
    "end": 130.47,
    "text": "循重"
  },
  {
    "start": 130.47,
    "end": 131.8,
    "text": "力法则 / 万有"
  },
  {
    "start": 131.8,
    "end": 133.37,
    "text": "引力定律"
  },
  {
    "start": 133.37,
    "end": 137.1,
    "text": "如果你知道它的运动方向和移动速度"
  },
  {
    "start": 137.1,
    "end": 141.17,
    "text": "你就可以确定地预测它在物理世界的位置"
  },
  {
    "start": 141.17,
    "end": 143.07,
    "text": "但Ka体却不同"
  },
  {
    "start": 143.07,
    "end": 145.96,
    "text": "Ka体不属于牛顿物理学领域"
  },
  {
    "start": 145.96,
    "end": 148.41,
    "text": "最能描述它的法则就是"
  },
  {
    "start": 148.41,
    "end": 150.41,
    "text": "量子物理学定律"
  },
  {
    "start": 150.41,
    "end": 151.92,
    "text": "你可能会问"
  },
  {
    "start": 151.92,
    "end": 155.87,
    "text": "是什么决定了某物是受“牛顿定律”约束"
  },
  {
    "start": 155.87,
    "end": 158.82,
    "text": "还是“量子力学定律”的约束"
  },
  {
    "start": 158.82,
    "end": 160.89,
    "text": "答案是 大小"
  },
  {
    "start": 160.89,
    "end": 163.77,
    "text": "大于千分之一英寸的物体"
  },
  {
    "start": 163.77,
    "end": 166.09,
    "text": "遵循“牛顿力学定律”"
  },
  {
    "start": 166.09,
    "end": 170.54,
    "text": "这是因为它们具有足够的质量（即密度或重量）来"
  },
  {
    "start": 170.54,
    "end": 172.43,
    "text": "产生引力场"
  },
  {
    "start": 172.43,
    "end": 173.4,
    "text": "然而"
  },
  {
    "start": 173.4,
    "end": 176.02,
    "text": "小于千分之一英寸的物体"
  },
  {
    "start": 176.02,
    "end": 178.39,
    "text": "则遵循不同的规律"
  },
  {
    "start": 178.39,
    "end": 181.74,
    "text": "这是因为它们的密度或质量太小"
  },
  {
    "start": 181.74,
    "end": 186.09,
    "text": "无法在物质世界产生足够强大的引力场"
  },
  {
    "start": 186.09,
    "end": 188.38,
    "text": "因而无法对其周围的物体"
  },
  {
    "start": 188.38,
    "end": 191.39,
    "text": "产生明显的吸引力或影响"
  },
  {
    "start": 191.39,
    "end": 194.78,
    "text": "Ka体存在于量子世界的领域中"
  },
  {
    "start": 194.78,
    "end": 198.63,
    "text": "因为 Ka 主要是光 /能量构成"
  },
  {
    "start": 198.63,
    "end": 200.63,
    "text": "并且质量很小"
  },
  {
    "start": 200.63,
    "end": 201.76,
    "text": "Ka体所处"
  },
  {
    "start": 201.76,
    "end": 204.97,
    "text": "的量子世界确实非常奇怪"
  },
  {
    "start": 204.97,
    "end": 206.22,
    "text": "事实上"
  },
  {
    "start": 206.22,
    "end": 209.1,
    "text": "我们同时存在于牛顿物理世界"
  },
  {
    "start": 209.1,
    "end": 211.07,
    "text": "和量子世界中"
  },
  {
    "start": 211.07,
    "end": 215.39,
    "text": "我们的物质身体完全处于牛顿世界中"
  },
  {
    "start": 215.39,
    "end": 216.34,
    "text": "例如"
  },
  {
    "start": 216.34,
    "end": 216.6,
    "text": "如果"
  },
  {
    "start": 216.6,
    "end": 218.91,
    "text": "我们从悬崖上跳下来"
  },
  {
    "start": 218.91,
    "end": 221.54,
    "text": "我们就会一直坠落直至落地"
  },
  {
    "start": 221.54,
    "end": 223.82,
    "text": "成为重力的牺牲品"
  },
  {
    "start": 223.82,
    "end": 224.63,
    "text": "（当然"
  },
  {
    "start": 224.63,
    "end": 226.58,
    "text": "除非我们是在蹦极"
  },
  {
    "start": 226.58,
    "end": 228.47,
    "text": "在这种情况下"
  },
  {
    "start": 228.47,
    "end": 232.25,
    "text": "一个等量且相反的力将我们拉回来"
  },
  {
    "start": 232.25,
    "end": 233.26,
    "text": "）但是"
  },
  {
    "start": 233.26,
    "end": 237.43,
    "text": "如果我们进入我们身体的原子和亚原子水平"
  },
  {
    "start": 237.43,
    "end": 240.84,
    "text": "我们就完全处于一个不同的世界中"
  },
  {
    "start": 240.84,
    "end": 242.21,
    "text": "构成我们身体的"
  },
  {
    "start": 242.21,
    "end": 246.3,
    "text": "微小粒子不受牛顿物理定律的约束"
  },
  {
    "start": 246.3,
    "end": 247.32,
    "text": "相反"
  },
  {
    "start": 247.32,
    "end": 250.27,
    "text": "它们受量子力学的约束"
  },
  {
    "start": 252.27,
    "end": 254.46,
    "text": "・光的波粒二象性  │"
  },
  {
    "start": 254.46,
    "end": 257.27,
    "text": "贝尔定律"
  },
  {
    "start": 257.27,
    "end": 259.48,
    "text": "按照我们人类的标准"
  },
  {
    "start": 259.48,
    "end": 262.85,
    "text": "量子世界确实是非常奇怪的"
  },
  {
    "start": 262.85,
    "end": 263.84,
    "text": "通过讨论"
  },
  {
    "start": 263.84,
    "end": 264.14,
    "text": "光的"
  },
  {
    "start": 264.14,
    "end": 265.14,
    "text": "实验"
  },
  {
    "start": 265.14,
    "end": 267.91,
    "text": "我们可以更好地理解这一点"
  },
  {
    "start": 267.91,
    "end": 268.28,
    "text": "我"
  },
  {
    "start": 268.28,
    "end": 269.51,
    "text": "们现在知道"
  },
  {
    "start": 269.51,
    "end": 273.04,
    "text": "光可以呈现出两种截然不同的形式"
  },
  {
    "start": 273.04,
    "end": 275.63,
    "text": "具有完全不同的特性"
  },
  {
    "start": 275.63,
    "end": 278.9,
    "text": "它可以表现为粒子（光子）的形式"
  },
  {
    "start": 278.9,
    "end": 281.52,
    "text": "也可以表现为波的形式"
  },
  {
    "start": 281.52,
    "end": 283.93,
    "text": "尽管听起来很荒谬"
  },
  {
    "start": 283.93,
    "end": 285.81,
    "text": "但如果研究人员试图"
  },
  {
    "start": 285.81,
    "end": 288.46,
    "text": "在实验中观察波状光"
  },
  {
    "start": 288.46,
    "end": 291.49,
    "text": "那么光就会以波的形式呈现"
  },
  {
    "start": 291.49,
    "end": 292.62,
    "text": "然而"
  },
  {
    "start": 292.62,
    "end": 296.54,
    "text": "如果研究人员试图观察粒子形式的光"
  },
  {
    "start": 296.54,
    "end": 299.75,
    "text": "那么他们就会看到粒子形式的光"
  },
  {
    "start": 299.75,
    "end": 302.38,
    "text": "量子物理学的这一早期发现"
  },
  {
    "start": 302.38,
    "end": 304.72,
    "text": "最终形成了贝尔定理"
  },
  {
    "start": 304.72,
    "end": 307.52,
    "text": "该定理指出在量子层面上"
  },
  {
    "start": 307.52,
    "end": 309.89,
    "text": "不存在客观的观察者"
  },
  {
    "start": 309.89,
    "end": 313.62,
    "text": "因为实验者的意图会影响实验结果"
  },
  {
    "start": 313.62,
    "end": 314.91,
    "text": "不知何故"
  },
  {
    "start": 314.91,
    "end": 317.23,
    "text": "研究人员的意图神秘地"
  },
  {
    "start": 317.23,
    "end": 320.34,
    "text": "影响了亚原子粒子的行为"
  },
  {
    "start": 320.34,
    "end": 324.23,
    "text": "科学尚未解释这种现象发生的原因"
  },
  {
    "start": 324.23,
    "end": 324.77,
    "text": "但人们"
  },
  {
    "start": 324.77,
    "end": 328.33,
    "text": "普遍认为贝尔定理是正确的"
  },
  {
    "start": 328.33,
    "end": 331.47,
    "text": "物理学家不愿意将贝尔定理"
  },
  {
    "start": 331.47,
    "end": 333.59,
    "text": "归因于亚原子粒子的"
  },
  {
    "start": 333.59,
    "end": 336.18,
    "text": "微小世界之外的现象"
  },
  {
    "start": 336.18,
    "end": 339.9,
    "text": "这样做的原因当然是因为日常物体"
  },
  {
    "start": 339.9,
    "end": 341.78,
    "text": "如台球和火箭"
  },
  {
    "start": 341.78,
    "end": 343.46,
    "text": "因其质量太大"
  },
  {
    "start": 343.46,
    "end": 346.26,
    "text": "而不会受到意图的影响"
  },
  {
    "start": 348.26,
    "end": 350.73,
    "text": "・量子世界与牛顿世界的"
  },
  {
    "start": 350.73,
    "end": 354.27,
    "text": "“神奇交汇处” “"
  },
  {
    "start": 354.27,
    "end": 358.95,
    "text": "意图”  被认为在量子层面上具有影响力"
  },
  {
    "start": 358.95,
    "end": 359.75,
    "text": "但在牛顿"
  },
  {
    "start": 359.75,
    "end": 360.16,
    "text": "世界"
  },
  {
    "start": 360.16,
    "end": 363.06,
    "text": "中影响力却不那么显著"
  },
  {
    "start": 363.06,
    "end": 364.88,
    "text": "但量子世界和牛顿"
  },
  {
    "start": 364.88,
    "end": 368.27,
    "text": "世界之间有一个神奇的交汇处"
  },
  {
    "start": 368.27,
    "end": 370.5,
    "text": "存在于我们的大脑内部 ——"
  },
  {
    "start": 370.5,
    "end": 373.25,
    "text": "藏在我们大脑神经元（即"
  },
  {
    "start": 373.25,
    "end": 376.17,
    "text": "神经细胞）之间的微小间隙"
  },
  {
    "start": 376.17,
    "end": 378.71,
    "text": "这些间隙被称为“突触”"
  },
  {
    "start": 378.71,
    "end": 381.44,
    "text": "而这些间隙的平均距离 ——"
  },
  {
    "start": 381.44,
    "end": 383.54,
    "text": "你可能已经猜到了"
  },
  {
    "start": 383.54,
    "end": 386.25,
    "text": "大约是一千分之一英寸"
  },
  {
    "start": 386.25,
    "end": 389.95,
    "text": "这就是进入奇怪的量子世界的入口点"
  },
  {
    "start": 389.95,
    "end": 391.62,
    "text": "神经脉冲（即"
  },
  {
    "start": 391.62,
    "end": 394.38,
    "text": "在神经系统中传递的电信号）"
  },
  {
    "start": 394.38,
    "end": 397.44,
    "text": "必须沿着神经元的长度传播"
  },
  {
    "start": 397.44,
    "end": 399.66,
    "text": "并跳跃穿过微小的突触间"
  },
  {
    "start": 399.66,
    "end": 400.36,
    "text": "隙"
  },
  {
    "start": 400.36,
    "end": 402.97,
    "text": "才能到达下一个神经元"
  },
  {
    "start": 402.97,
    "end": 405.98,
    "text": "神经脉冲类似于接力赛"
  },
  {
    "start": 405.98,
    "end": 410.31,
    "text": "它们沿着神经元的长度奔跑并跳过障碍"
  },
  {
    "start": 410.31,
    "end": 412.24,
    "text": "真正跨越障碍的"
  },
  {
    "start": 412.24,
    "end": 415.65,
    "text": "是一种叫做“神经递质”的小分子"
  },
  {
    "start": 415.65,
    "end": 417.36,
    "text": "在任何时刻"
  },
  {
    "start": 417.36,
    "end": 421.63,
    "text": "都有成千上万的神经递质在跨越障碍"
  },
  {
    "start": 421.63,
    "end": 424.88,
    "text": "而每个时刻都是一个量子事件"
  },
  {
    "start": 424.88,
    "end": 426.8,
    "text": "因为这些分子的大小"
  },
  {
    "start": 426.8,
    "end": 430.08,
    "text": "大约都小于一千分之一英寸"
  },
  {
    "start": 430.08,
    "end": 432.18,
    "text": "这就是为什么我们的思想"
  },
  {
    "start": 432.18,
    "end": 436.2,
    "text": "如此新颖和不可预测的原因之一"
  },
  {
    "start": 436.2,
    "end": 440.44,
    "text": "一些成功跨越突触障碍的神经递质完成了"
  },
  {
    "start": 440.44,
    "end": 442.53,
    "text": "信息传递的任务"
  },
  {
    "start": 442.53,
    "end": 445.08,
    "text": "而另一些则未能做到"
  },
  {
    "start": 445.08,
    "end": 447.85,
    "text": "那些成功跃过的神经递质"
  },
  {
    "start": 447.85,
    "end": 451.46,
    "text": "会在下一个神经细胞内产生反应"
  },
  {
    "start": 451.46,
    "end": 453.79,
    "text": "如果这些障碍赛跑发生在"
  },
  {
    "start": 453.79,
    "end": 457.58,
    "text": "大脑的思考部分（指大脑新皮质）"
  },
  {
    "start": 457.58,
    "end": 460.35,
    "text": "那么我们就会有思考的体验"
  },
  {
    "start": 460.35,
    "end": 463.41,
    "text": "意图的概念对于“量子物理学”"
  },
  {
    "start": 463.41,
    "end": 466.73,
    "text": "和“内在炼金术”都至关重要"
  },
  {
    "start": 466.73,
    "end": 467.88,
    "text": "事实上"
  },
  {
    "start": 467.88,
    "end": 469.21,
    "text": "我们会发现——"
  },
  {
    "start": 469.21,
    "end": 471.58,
    "text": "正是通过注意力和个人意志（"
  },
  {
    "start": 471.58,
    "end": 473.15,
    "text": "意图）的作用"
  },
  {
    "start": 473.15,
    "end": 476.9,
    "text": "炼金术士能够影响自己的身体和思想中"
  },
  {
    "start": 476.9,
    "end": 479.14,
    "text": "的特定量子事件"
  },
  {
    "start": 479.14,
    "end": 483.22,
    "text": "我们稍后将会非常清楚地看到这一点"
  },
  {
    "start": 483.22,
    "end": 484.34,
    "text": "但目前"
  },
  {
    "start": 484.34,
    "end": 486.48,
    "text": "让我简单地说明一下"
  },
  {
    "start": 486.48,
    "end": 488.09,
    "text": "内在炼金术"
  },
  {
    "start": 488.09,
    "end": 490.47,
    "text": "比如埃及炼金术体系"
  },
  {
    "start": 490.47,
    "end": 494.45,
    "text": "主要是改变量子宇宙的某些方面的方法"
  },
  {
    "start": 494.45,
    "end": 498.05,
    "text": "由于Ka体本身就处于量子领域"
  },
  {
    "start": 498.05,
    "end": 501.98,
    "text": "因此很容易受到炼金术士意图的影响"
  },
  {
    "start": 503.98,
    "end": 509.55,
    "text": "・量子世界还存在其他奇怪的现象"
  },
  {
    "start": 509.55,
    "end": 510.53,
    "text": "例如"
  },
  {
    "start": 510.53,
    "end": 512.45,
    "text": "你无法预测事物"
  },
  {
    "start": 512.45,
    "end": 514.26,
    "text": "在牛顿世界中"
  },
  {
    "start": 514.26,
    "end": 515.97,
    "text": "如果你扔东西"
  },
  {
    "start": 515.97,
    "end": 517.4,
    "text": "你可以预测它会落在"
  },
  {
    "start": 517.4,
    "end": 518.38,
    "text": "哪里"
  },
  {
    "start": 518.38,
    "end": 521.55,
    "text": "但在量子世界中却不是这样"
  },
  {
    "start": 521.55,
    "end": 522.12,
    "text": "这里"
  },
  {
    "start": 522.12,
    "end": 524.39,
    "text": "只有概率和可能性"
  },
  {
    "start": 524.39,
    "end": 527.38,
    "text": "在量子世界中飞行的物体"
  },
  {
    "start": 527.38,
    "end": 530.03,
    "text": "可能会落在你期望的地方"
  },
  {
    "start": 530.03,
    "end": 532.95,
    "text": "也可能它们只是在原地绕圈旋转"
  },
  {
    "start": 532.95,
    "end": 534.85,
    "text": "或分解成光"
  },
  {
    "start": 534.85,
    "end": 536.43,
    "text": "在量子世界"
  },
  {
    "start": 536.43,
    "end": 538.79,
    "text": "可能性几乎是无限的"
  },
  {
    "start": 538.79,
    "end": 539.73,
    "text": "此外"
  },
  {
    "start": 539.73,
    "end": 543.05,
    "text": "当两个粒子在量子世界中相遇时"
  },
  {
    "start": 543.05,
    "end": 546.13,
    "text": "就会发生一种非常奇怪的现象 ——"
  },
  {
    "start": 546.13,
    "end": 548.26,
    "text": "在它们偶然相遇后"
  },
  {
    "start": 548.26,
    "end": 549.83,
    "text": "这两个粒子在空间"
  },
  {
    "start": 549.83,
    "end": 551.12,
    "text": "中分开"
  },
  {
    "start": 551.12,
    "end": 554.24,
    "text": "并各自按照自己的方式前进"
  },
  {
    "start": 554.24,
    "end": 558.55,
    "text": "但如果其中一个改变了自己的旋转方向"
  },
  {
    "start": 558.55,
    "end": 563.0,
    "text": "另一个粒子也会立即改变自己的旋转方向"
  },
  {
    "start": 563.0,
    "end": 565.41,
    "text": "对于这种奇怪的行为"
  },
  {
    "start": 565.41,
    "end": 567.98,
    "text": "目前还没有合理的解释"
  },
  {
    "start": 567.98,
    "end": 570.19,
    "text": "尽管在牛顿世界中"
  },
  {
    "start": 570.19,
    "end": 572.86,
    "text": "我们不必担心此类“恶作剧”"
  },
  {
    "start": 572.86,
    "end": 576.67,
    "text": "但它们却是量子世界的重要组成部分"
  },
  {
    "start": 576.67,
    "end": 578.34,
    "text": "我已经提到过"
  },
  {
    "start": 578.34,
    "end": 579.2,
    "text": "我们的思想"
  },
  {
    "start": 579.2,
    "end": 584.02,
    "text": "是如何存在于量子现实的奇怪暮光地带的"
  },
  {
    "start": 584.02,
    "end": 585.43,
    "text": "我的意思是"
  },
  {
    "start": 585.43,
    "end": 591.54,
    "text": "负责思维的神经事件（指神经递质跳跃穿过突触间隙的行为）"
  },
  {
    "start": 591.54,
    "end": 594.76,
    "text": "显然是在量子世界中发生的"
  },
  {
    "start": 594.76,
    "end": 598.66,
    "text": "正是我们神经系统中的这种奇怪特性"
  },
  {
    "start": 598.66,
    "end": 603.98,
    "text": "使我们有可能影响自己的身体和思想中的量子事件"
  },
  {
    "start": 603.98,
    "end": 607.42,
    "text": "那么我这句话是什么意思呢"
  },
  {
    "start": 607.42,
    "end": 609.31,
    "text": "我是否在暗示"
  },
  {
    "start": 609.31,
    "end": 612.5,
    "text": "你和我可以仅仅通过精神上的专注"
  },
  {
    "start": 612.5,
    "end": 615.84,
    "text": "就能对我们自己的生理产生影响"
  },
  {
    "start": 615.84,
    "end": 616.79,
    "text": "是的"
  },
  {
    "start": 616.79,
    "end": 618.49,
    "text": "我是这么认为的"
  },
  {
    "start": 618.49,
    "end": 623.15,
    "text": "这也是内在炼金术如此有效的原因之一"
  },
  {
    "start": 625.15,
    "end": 628.65,
    "text": "我们的身体和心灵紧密相连  │"
  },
  {
    "start": 628.65,
    "end": 631.73,
    "text": "止痛的案例"
  },
  {
    "start": 631.73,
    "end": 632.9,
    "text": "事实上"
  },
  {
    "start": 632.9,
    "end": 635.52,
    "text": "它们如同一枚硬币的两面"
  },
  {
    "start": 635.52,
    "end": 637.96,
    "text": "验证身体和心灵相互关联"
  },
  {
    "start": 637.96,
    "end": 638.28,
    "text": "性的"
  },
  {
    "start": 638.28,
    "end": 639.28,
    "text": "研究"
  },
  {
    "start": 639.28,
    "end": 643.45,
    "text": "正大量涌现于全球各地的科学期刊"
  },
  {
    "start": 643.45,
    "end": 644.45,
    "text": "医学中"
  },
  {
    "start": 644.45,
    "end": 649.03,
    "text": "一个相对较新的领域是心理神经免疫学"
  },
  {
    "start": 649.03,
    "end": 651.14,
    "text": "这是一个很大的词"
  },
  {
    "start": 651.14,
    "end": 654.62,
    "text": "但基本上它意味着我们的思想和情绪"
  },
  {
    "start": 654.62,
    "end": 657.32,
    "text": "如何影响我们的生理状况"
  },
  {
    "start": 657.32,
    "end": 659.86,
    "text": "尤其是我们的免疫系统"
  },
  {
    "start": 659.86,
    "end": 663.02,
    "text": "我可以引用很多这方面的研究"
  },
  {
    "start": 663.02,
    "end": 666.37,
    "text": "但我认为一个故事可能更有效地"
  },
  {
    "start": 666.37,
    "end": 668.34,
    "text": "服务于我们的目的"
  },
  {
    "start": 668.34,
    "end": 672.93,
    "text": "尽管这个情况涉及止痛而不是内在炼金术"
  },
  {
    "start": 672.93,
    "end": 676.01,
    "text": "但其中一些原理是相同的"
  },
  {
    "start": 676.01,
    "end": 677.22,
    "text": "几年前"
  },
  {
    "start": 677.22,
    "end": 679.52,
    "text": "一位客户被介绍给我"
  },
  {
    "start": 679.52,
    "end": 682.48,
    "text": "因为她患有剧烈的身体疼痛"
  },
  {
    "start": 682.48,
    "end": 684.78,
    "text": "她正处于癌症晚期"
  },
  {
    "start": 684.78,
    "end": 687.35,
    "text": "并且已经转移至她的脊柱"
  },
  {
    "start": 687.35,
    "end": 688.15,
    "text": "用她自"
  },
  {
    "start": 688.15,
    "end": 689.32,
    "text": "己的话说"
  },
  {
    "start": 689.32,
    "end": 692.71,
    "text": "她一直处于持续不断的疼痛之中"
  },
  {
    "start": 692.71,
    "end": 697.69,
    "text": "当琼（我已经改变了她的名字）描述她的情况时"
  },
  {
    "start": 697.69,
    "end": 701.41,
    "text": "我让她评估她当前的疼痛和不适程度"
  },
  {
    "start": 701.41,
    "end": 703.79,
    "text": "10分是最严重的程度"
  },
  {
    "start": 703.79,
    "end": 706.51,
    "text": "0分是最轻微的程度"
  },
  {
    "start": 706.51,
    "end": 710.86,
    "text": "她自我评估的疼痛水平在八级左右"
  },
  {
    "start": 710.86,
    "end": 713.76,
    "text": "然后我让她描述她曾经历过的"
  },
  {
    "start": 713.76,
    "end": 717.84,
    "text": "最放松 最令人耳目一新的经历"
  },
  {
    "start": 717.84,
    "end": 722.95,
    "text": "她详细描述了她去亚利桑那州塞多纳的一次经历"
  },
  {
    "start": 722.95,
    "end": 723.09,
    "text": "以"
  },
  {
    "start": 723.09,
    "end": 727.45,
    "text": "及她如何喜欢该地区的红色岩石和峡谷"
  },
  {
    "start": 727.45,
    "end": 730.65,
    "text": "我拿出办公室里的立体音响"
  },
  {
    "start": 730.65,
    "end": 734.36,
    "text": "播放了一些专门为降低脑电波活动"
  },
  {
    "start": 734.36,
    "end": 736.56,
    "text": "转变至更为放松的 ——"
  },
  {
    "start": 736.56,
    "end": 739.38,
    "text": "能为增强阿尔法脑波活动 ——"
  },
  {
    "start": 739.38,
    "end": 741.39,
    "text": "而创作的音乐"
  },
  {
    "start": 741.39,
    "end": 745.99,
    "text": "然后我让她想象自己再次身处塞多纳"
  },
  {
    "start": 745.99,
    "end": 749.02,
    "text": "我让她尽可能生动地感受到"
  },
  {
    "start": 749.02,
    "end": 750.12,
    "text": "看到它"
  },
  {
    "start": 750.12,
    "end": 751.67,
    "text": "并听到声音"
  },
  {
    "start": 751.67,
    "end": 754.74,
    "text": "尽量真实地感受到身体的感觉"
  },
  {
    "start": 754.74,
    "end": 756.61,
    "text": "甚至闻到香气"
  },
  {
    "start": 756.61,
    "end": 759.54,
    "text": "在她回忆起那时的情景时"
  },
  {
    "start": 759.54,
    "end": 763.97,
    "text": "她原本绷紧的脸部肌肉稍微放松了一些"
  },
  {
    "start": 763.97,
    "end": 766.23,
    "text": "然后我建议她找一个"
  },
  {
    "start": 766.23,
    "end": 768.52,
    "text": "她觉得特别美丽和舒缓"
  },
  {
    "start": 768.52,
    "end": 769.79,
    "text": "的地方"
  },
  {
    "start": 769.79,
    "end": 773.74,
    "text": "她选择了一块俯瞰峡谷的大石头"
  },
  {
    "start": 773.74,
    "end": 776.36,
    "text": "然后我建议她想象这块巨石"
  },
  {
    "start": 776.36,
    "end": 778.69,
    "text": "具有强大的治愈能量"
  },
  {
    "start": 778.69,
    "end": 780.61,
    "text": "并且每一次呼吸"
  },
  {
    "start": 780.61,
    "end": 782.25,
    "text": "她都会毫不费力地"
  },
  {
    "start": 782.25,
    "end": 785.68,
    "text": "将这些治愈能量吸入她体内"
  },
  {
    "start": 785.68,
    "end": 786.96,
    "text": "几分钟后"
  },
  {
    "start": 786.96,
    "end": 789.01,
    "text": "琼突然睁开眼睛"
  },
  {
    "start": 789.01,
    "end": 791.14,
    "text": "伸手去拿钱包"
  },
  {
    "start": 791.14,
    "end": 792.12,
    "text": "打开后"
  },
  {
    "start": 792.12,
    "end": 793.99,
    "text": "她抽出一张纸巾"
  },
  {
    "start": 793.99,
    "end": 796.63,
    "text": "熟练地拍了拍眼睛周围"
  },
  {
    "start": 796.63,
    "end": 798.79,
    "text": "“发生了什么 ”我问"
  },
  {
    "start": 798.79,
    "end": 803.07,
    "text": "“它消失了 ”“什么消失了 ”“疼痛"
  },
  {
    "start": 803.07,
    "end": 807.44,
    "text": "疼痛消失了 ”从疼痛中解脱出来是非常"
  },
  {
    "start": 807.44,
    "end": 808.99,
    "text": "情绪化的"
  },
  {
    "start": 808.99,
    "end": 810.66,
    "text": "在给她一些时间"
  },
  {
    "start": 810.66,
    "end": 811.93,
    "text": "让自己平静下来"
  },
  {
    "start": 811.93,
    "end": 812.84,
    "text": "后"
  },
  {
    "start": 812.84,
    "end": 814.06,
    "text": "我请她评估她"
  },
  {
    "start": 814.06,
    "end": 815.75,
    "text": "的疼痛程度"
  },
  {
    "start": 815.75,
    "end": 816.91,
    "text": "零分"
  },
  {
    "start": 816.91,
    "end": 817.54,
    "text": "在几"
  },
  {
    "start": 817.54,
    "end": 818.76,
    "text": "次会诊中"
  },
  {
    "start": 818.76,
    "end": 822.97,
    "text": "我向琼展示了如何通过精神注意力和意图"
  },
  {
    "start": 822.97,
    "end": 825.37,
    "text": "来控制自己的疼痛"
  },
  {
    "start": 825.37,
    "end": 826.7,
    "text": "她报告说"
  },
  {
    "start": 826.7,
    "end": 829.07,
    "text": "尽管癌症仍在扩散"
  },
  {
    "start": 829.07,
    "end": 829.25,
    "text": "但"
  },
  {
    "start": 829.25,
    "end": 832.66,
    "text": "她无需药物就能大大减轻疼痛"
  },
  {
    "start": 832.66,
    "end": 836.53,
    "text": "结束琼疼痛的神经事件非常复杂"
  },
  {
    "start": 836.53,
    "end": 839.88,
    "text": "而且它们是从量子世界产生的"
  },
  {
    "start": 839.88,
    "end": 843.27,
    "text": "如果有人无意中走进我的办公室"
  },
  {
    "start": 843.27,
    "end": 846.2,
    "text": "他们会看到一个女人闭着眼睛"
  },
  {
    "start": 846.2,
    "end": 848.41,
    "text": "坐在椅子上听音乐"
  },
  {
    "start": 848.41,
    "end": 850.79,
    "text": "但这是牛顿物理世界"
  },
  {
    "start": 850.79,
    "end": 853.24,
    "text": "是物质和人类的世界"
  },
  {
    "start": 853.24,
    "end": 856.39,
    "text": "量子领域仍然是看不见的"
  },
  {
    "start": 856.39,
    "end": 858.44,
    "text": "但正是这个世界造成了"
  },
  {
    "start": 858.44,
    "end": 861.18,
    "text": "琼对疼痛的感受变化"
  },
  {
    "start": 861.18,
    "end": 862.94,
    "text": "正是在这个领域"
  },
  {
    "start": 862.94,
    "end": 866.2,
    "text": "隐藏在她大脑内的突触间隙之间"
  },
  {
    "start": 866.2,
    "end": 868.96,
    "text": "神经递质争夺着主导地位——"
  },
  {
    "start": 868.96,
    "end": 873.33,
    "text": "其中一些神经信使传递着疼痛的信息"
  },
  {
    "start": 873.33,
    "end": 874.22,
    "text": "毕竟"
  },
  {
    "start": 874.22,
    "end": 876.42,
    "text": "她脊柱中垂死的细胞"
  },
  {
    "start": 876.42,
    "end": 880.42,
    "text": "一直在向她的大脑发送死亡的信号"
  },
  {
    "start": 880.42,
    "end": 882.05,
    "text": "但与此同时"
  },
  {
    "start": 882.05,
    "end": 883.51,
    "text": "其他信使则携带着"
  },
  {
    "start": 883.51,
    "end": 887.43,
    "text": "平和 放松和舒适的感觉信号"
  },
  {
    "start": 887.43,
    "end": 889.04,
    "text": "在某个瞬间"
  },
  {
    "start": 889.04,
    "end": 891.16,
    "text": "带来安慰的神经信使"
  },
  {
    "start": 891.16,
    "end": 894.43,
    "text": "战胜了疼痛和死亡的信使"
  },
  {
    "start": 894.43,
    "end": 897.68,
    "text": "如果我可以富有诗意地表达的话"
  },
  {
    "start": 897.68,
    "end": 899.46,
    "text": "所有这一切都发生在"
  },
  {
    "start": 899.46,
    "end": 902.56,
    "text": "量子海洋的泡沫和浪花中"
  },
  {
    "start": 902.56,
    "end": 904.91,
    "text": "尽管这片海洋对于我们的眼"
  },
  {
    "start": 904.91,
    "end": 906.71,
    "text": "睛来说看不见"
  },
  {
    "start": 906.71,
    "end": 909.5,
    "text": "但它是一切存在的诞生地"
  },
  {
    "start": 909.5,
    "end": 913.13,
    "text": "无论是在我们的内心深处还是外部"
  },
  {
    "start": 913.13,
    "end": 915.52,
    "text": "它是所有造物的母泉"
  },
  {
    "start": 915.52,
    "end": 919.11,
    "text": "这才是所有内在炼金术的最终焦点"
  },
  {
    "start": 919.11,
    "end": 921.36,
    "text": "无论其方法如何"
  },
  {
    "start": 921.36,
    "end": 926.39,
    "text": "改变炼金术士身体和心灵中的量子事件的方法"
  },
  {
    "start": 926.39,
    "end": 931.22,
    "text": "在很多方面与发生在琼身上的情况相似"
  },
  {
    "start": 931.22,
    "end": 933.21,
    "text": "主要的区别在于"
  },
  {
    "start": 933.21,
    "end": 936.51,
    "text": "炼金术士并不是寻求改变疼痛"
  },
  {
    "start": 936.51,
    "end": 939.39,
    "text": "而是在寻求改变意识本身"
  },
  {
    "start": 939.39,
    "end": 942.02,
    "text": "造成这一重大改变的机构"
  },
  {
    "start": 942.02,
    "end": 944.96,
    "text": "正是思想与意识的结合"
  },
  {
    "start": 944.96,
    "end": 948.89,
    "text": "思想和意识都是转瞬即逝的东西"
  },
  {
    "start": 948.89,
    "end": 951.17,
    "text": "任何一个试图长时间保持"
  },
  {
    "start": 951.17,
    "end": 954.27,
    "text": "其中一者的人都知道这一点"
  },
  {
    "start": 954.27,
    "end": 956.44,
    "text": "也正是在思想中"
  },
  {
    "start": 956.44,
    "end": 959.19,
    "text": "我们可以体验到在现实世界中"
  },
  {
    "start": 959.19,
    "end": 961.69,
    "text": "永远无法做到的事情"
  },
  {
    "start": 961.69,
    "end": 963.93,
    "text": "我所说的现实世界"
  },
  {
    "start": 963.93,
    "end": 967.71,
    "text": "是指日常生活中的牛顿物理现实"
  },
  {
    "start": 967.71,
    "end": 968.68,
    "text": "例如"
  },
  {
    "start": 968.68,
    "end": 971.89,
    "text": "我们已经习惯了地心引力/重力"
  },
  {
    "start": 971.89,
    "end": 974.06,
    "text": "我们预期物体掉下来"
  },
  {
    "start": 974.06,
    "end": 975.81,
    "text": "它们就会掉落"
  },
  {
    "start": 975.81,
    "end": 979.27,
    "text": "我们并没有期待事物漂浮在空中"
  },
  {
    "start": 979.27,
    "end": 981.57,
    "text": "也许在我们的梦境中会"
  },
  {
    "start": 981.57,
    "end": 984.03,
    "text": "但在现实中却不然"
  },
  {
    "start": 984.03,
    "end": 987.08,
    "text": "我想向读者提出的观点是"
  },
  {
    "start": 987.08,
    "end": 990.0,
    "text": "我们同时生活在两个现实中"
  },
  {
    "start": 990.0,
    "end": 993.2,
    "text": "我们非常熟悉其中一个现实——"
  },
  {
    "start": 993.2,
    "end": 994.62,
    "text": "这是我们日常生活"
  },
  {
    "start": 994.62,
    "end": 995.81,
    "text": "的世界"
  },
  {
    "start": 995.81,
    "end": 998.21,
    "text": "如果你把东西掉在地上"
  },
  {
    "start": 998.21,
    "end": 1000.45,
    "text": "它们会掉下来的世界"
  },
  {
    "start": 1000.45,
    "end": 1001.27,
    "text": "然而"
  },
  {
    "start": 1001.27,
    "end": 1003.18,
    "text": "还有另一个现实"
  },
  {
    "start": 1003.18,
    "end": 1005.79,
    "text": "与这个现实一样真实"
  },
  {
    "start": 1005.79,
    "end": 1008.49,
    "text": "那就是量子世界的现实"
  },
  {
    "start": 1008.49,
    "end": 1011.89,
    "text": "尽管你没有意识到在此时此刻"
  },
  {
    "start": 1011.89,
    "end": 1017.43,
    "text": "有亿万个神经递质正跨越空间来创造你的思想体验"
  },
  {
    "start": 1017.43,
    "end": 1019.77,
    "text": "但它仍然正在发生"
  },
  {
    "start": 1019.77,
    "end": 1022.11,
    "text": "这个同样真实的现实"
  },
  {
    "start": 1022.11,
    "end": 1026.07,
    "text": "不属于牛顿世界 它是量子层面的"
  },
  {
    "start": 1026.07,
    "end": 1029.02,
    "text": "具有不可预测性和悖论"
  },
  {
    "start": 1031.02,
    "end": 1035.63,
    "text": "梦境 与量子世界"
  },
  {
    "start": 1035.63,
    "end": 1039.42,
    "text": "我们大多数人最接近量子世界的体验"
  },
  {
    "start": 1039.42,
    "end": 1041.7,
    "text": "就是在“做梦”的时候"
  },
  {
    "start": 1041.7,
    "end": 1043.13,
    "text": "在梦境中"
  },
  {
    "start": 1043.13,
    "end": 1043.94,
    "text": "事情有着"
  },
  {
    "start": 1043.94,
    "end": 1044.41,
    "text": "奇怪"
  },
  {
    "start": 1044.41,
    "end": 1045.5,
    "text": "的逻辑"
  },
  {
    "start": 1045.5,
    "end": 1046.71,
    "text": "在牛顿世界"
  },
  {
    "start": 1046.71,
    "end": 1047.4,
    "text": "里"
  },
  {
    "start": 1047.4,
    "end": 1049.57,
    "text": "你放在床头柜上的闹钟"
  },
  {
    "start": 1049.57,
    "end": 1052.07,
    "text": "将整夜都待在那里"
  },
  {
    "start": 1052.07,
    "end": 1053.32,
    "text": "它不会动——"
  },
  {
    "start": 1053.32,
    "end": 1056.13,
    "text": "被地心引力和熵所束缚"
  },
  {
    "start": 1056.13,
    "end": 1059.44,
    "text": "除非有人或什么东西把它撞倒"
  },
  {
    "start": 1059.44,
    "end": 1061.27,
    "text": "否则它不会移动"
  },
  {
    "start": 1061.27,
    "end": 1063.09,
    "text": "但在你的梦境中"
  },
  {
    "start": 1063.09,
    "end": 1065.79,
    "text": "时钟很可能漂浮在空中"
  },
  {
    "start": 1065.79,
    "end": 1068.58,
    "text": "它的指针可能会逆时针移动"
  },
  {
    "start": 1068.58,
    "end": 1073.18,
    "text": "将你推向过去 或者指针可能向前移动"
  },
  {
    "start": 1073.18,
    "end": 1076.1,
    "text": "将你推向某个遥远的未来"
  },
  {
    "start": 1076.1,
    "end": 1077.84,
    "text": "我们的“量子梦境”"
  },
  {
    "start": 1077.84,
    "end": 1081.6,
    "text": "同样不受牛顿物理世界的逻辑约束"
  },
  {
    "start": 1081.6,
    "end": 1084.75,
    "text": "当谈到逻辑和可预测性时"
  },
  {
    "start": 1084.75,
    "end": 1087.22,
    "text": "这些来自潜意识领域的幻影"
  },
  {
    "start": 1087.22,
    "end": 1089.4,
    "text": "是无政府主义者"
  },
  {
    "start": 1089.4,
    "end": 1090.34,
    "text": "现在"
  },
  {
    "start": 1090.34,
    "end": 1092.81,
    "text": "在西方对现实的共识观点"
  },
  {
    "start": 1092.81,
    "end": 1094.87,
    "text": "（即牛顿物理世界）"
  },
  {
    "start": 1094.87,
    "end": 1099.1,
    "text": "诸如梦境之类的经验被视为虚构 幻想"
  },
  {
    "start": 1099.1,
    "end": 1101.23,
    "text": "并被草率地驳回"
  },
  {
    "start": 1101.23,
    "end": 1103.11,
    "text": "我想告诉你的是"
  },
  {
    "start": 1103.11,
    "end": 1106.06,
    "text": "并非所有梦境都是想象的——"
  },
  {
    "start": 1106.06,
    "end": 1110.19,
    "text": "当然不会比你目前对自己的看法更虚幻"
  },
  {
    "start": 1110.19,
    "end": 1113.83,
    "text": "我建议你将那些奇怪的梦幻般的事件"
  },
  {
    "start": 1113.83,
    "end": 1116.33,
    "text": "视为替代的感知现实"
  },
  {
    "start": 1116.33,
    "end": 1119.9,
    "text": "并与你的牛顿版本的现实一样真实"
  },
  {
    "start": 1119.9,
    "end": 1121.6,
    "text": "只是不同而已"
  },
  {
    "start": 1121.95,
    "end": 1124.87,
    "text": "暮雨·注 在名词解释部分"
  },
  {
    "start": 1124.87,
    "end": 1128.22,
    "text": "详细描述了什么是替代的感知现实"
  },
  {
    "start": 1128.22,
    "end": 1131.21,
    "text": "它有助于你更好地掌握你的现实"
  },
  {
    "start": 1131.21,
    "end": 1133.04,
    "text": "毕竟"
  },
  {
    "start": 1133.04,
    "end": 1136.17,
    "text": "科学研究已经毫无疑问地证明"
  },
  {
    "start": 1136.17,
    "end": 1140.86,
    "text": "我们并没有直接体验现实（无论现实是什么）"
  },
  {
    "start": 1140.86,
    "end": 1142.3,
    "text": "我们对现实的感"
  },
  {
    "start": 1142.3,
    "end": 1146.12,
    "text": "知是通过我们受限制的身体感官"
  },
  {
    "start": 1146.12,
    "end": 1148.84,
    "text": "以及我们的信念和期望的局限性"
  },
  {
    "start": 1148.84,
    "end": 1150.76,
    "text": "来进行过滤的"
  },
  {
    "start": 1150.76,
    "end": 1151.73,
    "text": "例如"
  },
  {
    "start": 1151.73,
    "end": 1154.26,
    "text": "你正在看一本颠倒的书"
  },
  {
    "start": 1154.26,
    "end": 1156.54,
    "text": "你的视网膜实际上接收到了"
  },
  {
    "start": 1156.54,
    "end": 1159.18,
    "text": "这些页面的颠倒图像"
  },
  {
    "start": 1159.18,
    "end": 1161.34,
    "text": "但你的大脑会创造性"
  },
  {
    "start": 1161.34,
    "end": 1163.64,
    "text": "地将它们翻转过来"
  },
  {
    "start": 1163.64,
    "end": 1165.9,
    "text": "你的大脑还倾向于感知"
  },
  {
    "start": 1165.9,
    "end": 1168.56,
    "text": "它认为应该存在的东西"
  },
  {
    "start": 1168.56,
    "end": 1171.3,
    "text": "即使它实际上并不存在"
  },
  {
    "start": 1171.3,
    "end": 1173.98,
    "text": "任何尝试过校对文稿的人"
  },
  {
    "start": 1173.98,
    "end": 1176.23,
    "text": "都知道我在说什么"
  },
  {
    "start": 1176.23,
    "end": 1180.41,
    "text": "大脑倾向于看到它期望看到的东西"
  },
  {
    "start": 1180.41,
    "end": 1182.78,
    "text": "一个放错位置的逗号"
  },
  {
    "start": 1182.78,
    "end": 1185.68,
    "text": "往往会在编辑校对时被忽略"
  },
  {
    "start": 1185.68,
    "end": 1189.54,
    "text": "只是因为大脑不认为逗号会出现在那里"
  },
  {
    "start": 1189.54,
    "end": 1192.12,
    "text": "终上所述只是想指出"
  },
  {
    "start": 1192.12,
    "end": 1194.67,
    "text": "我们并不直接经历现实"
  },
  {
    "start": 1194.67,
    "end": 1196.34,
    "text": "我们对现实的感知"
  },
  {
    "start": 1196.34,
    "end": 1199.91,
    "text": "是我们的身体和思想的共同创造"
  },
  {
    "start": 1199.91,
    "end": 1200.35,
    "text": "在"
  },
  {
    "start": 1200.35,
    "end": 1201.78,
    "text": "这种背景下"
  },
  {
    "start": 1201.78,
    "end": 1205.4,
    "text": "梦只是另一种被创造的感知现实"
  },
  {
    "start": 1205.4,
    "end": 1207.02,
    "text": "顺便说一句"
  },
  {
    "start": 1207.02,
    "end": 1209.65,
    "text": "我不认为所有的梦都是有意义的"
  },
  {
    "start": 1209.65,
    "end": 1211.25,
    "text": "替代现实"
  },
  {
    "start": 1211.25,
    "end": 1213.18,
    "text": "只有其中一些"
  },
  {
    "start": 1213.18,
    "end": 1216.1,
    "text": "大多数梦只是大脑释放压力的"
  },
  {
    "start": 1216.1,
    "end": 1217.33,
    "text": "结果"
  },
  {
    "start": 1217.33,
    "end": 1218.75,
    "text": "坦率地说"
  },
  {
    "start": 1218.75,
    "end": 1223.29,
    "text": "有些梦只是晚餐时食物搭配不当的结果"
  },
  {
    "start": 1223.29,
    "end": 1226.43,
    "text": "但有些梦从心理学的角度来看"
  },
  {
    "start": 1226.43,
    "end": 1228.37,
    "text": "具有深远的意义"
  },
  {
    "start": 1228.37,
    "end": 1230.97,
    "text": "甚至可能是预兆性的"
  },
  {
    "start": 1230.97,
    "end": 1232.21,
    "text": "我相信"
  },
  {
    "start": 1232.21,
    "end": 1236.9,
    "text": "这类型的梦比其他梦具有更高的重要性或意义"
  },
  {
    "start": 1236.9,
    "end": 1241.08,
    "text": "任何做过这种梦的人都知道我在说什么"
  },
  {
    "start": 1241.08,
    "end": 1242.25,
    "text": "实际上"
  },
  {
    "start": 1242.25,
    "end": 1245.18,
    "text": "在内在炼金术的实际修炼中"
  },
  {
    "start": 1245.18,
    "end": 1249.37,
    "text": "炼金术士进入了一种颇为梦幻般的心境"
  },
  {
    "start": 1249.37,
    "end": 1250.59,
    "text": "我相信"
  },
  {
    "start": 1250.59,
    "end": 1251.65,
    "text": "这是通过炼金"
  },
  {
    "start": 1251.65,
    "end": 1256.15,
    "text": "术冥想所产生的特定大脑变化的结果"
  },
  {
    "start": 1256.15,
    "end": 1258.54,
    "text": "许多内在炼金术练习"
  },
  {
    "start": 1258.54,
    "end": 1260.73,
    "text": "会增加大脑皮层中的"
  },
  {
    "start": 1260.73,
    "end": 1264.24,
    "text": "α波 或 θ波活动"
  },
  {
    "start": 1264.24,
    "end": 1267.54,
    "text": "而更深层次的 θ波状态"
  },
  {
    "start": 1267.54,
    "end": 1270.31,
    "text": "非常类似于梦境状态"
  },
  {
    "start": 1270.31,
    "end": 1271.88,
    "text": "这些白日梦——"
  },
  {
    "start": 1271.88,
    "end": 1274.82,
    "text": "即清醒状态下的梦境体验"
  },
  {
    "start": 1274.82,
    "end": 1276.49,
    "text": "使练习者能够进入"
  },
  {
    "start": 1276.49,
    "end": 1278.51,
    "text": "在“正常意识”状态下"
  },
  {
    "start": 1278.51,
    "end": 1280.83,
    "text": "无法体验到的世界"
  },
  {
    "start": 1280.83,
    "end": 1282.93,
    "text": "正如我之前所说"
  },
  {
    "start": 1282.93,
    "end": 1286.53,
    "text": "内在炼金术的方法可以被视为直接影响"
  },
  {
    "start": 1286.53,
    "end": 1289.55,
    "text": "量子世界某些方面的手段"
  },
  {
    "start": 1289.55,
    "end": 1291.22,
    "text": "我们还将发现"
  },
  {
    "start": 1291.22,
    "end": 1294.48,
    "text": "通过内在炼金术实现对量子现实的"
  },
  {
    "start": 1294.48,
    "end": 1295.61,
    "text": "操纵"
  },
  {
    "start": 1295.61,
    "end": 1299.54,
    "text": "最有效地发生在梦幻般的心理状态中"
  },
  {
    "start": 1299.54,
    "end": 1301.44,
    "text": "每个炼金术传统"
  },
  {
    "start": 1301.44,
    "end": 1303.68,
    "text": "都发展出了自己的方法"
  },
  {
    "start": 1303.68,
    "end": 1306.81,
    "text": "来产生梦幻般的意识状态"
  },
  {
    "start": 1308.81,
    "end": 1311.63,
    "text": "掌握量子现实"
  },
  {
    "start": 1311.63,
    "end": 1313.91,
    "text": "这实际上是你认同——"
  },
  {
    "start": 1313.91,
    "end": 1315.27,
    "text": "哪个世界"
  },
  {
    "start": 1315.27,
    "end": 1320.16,
    "text": "以及在那个世界中采取哪些行为——更有效的问题"
  },
  {
    "start": 1320.16,
    "end": 1321.58,
    "text": "毫无疑问"
  },
  {
    "start": 1321.58,
    "end": 1322.76,
    "text": "你已经学会了"
  },
  {
    "start": 1322.76,
    "end": 1323.17,
    "text": "如何"
  },
  {
    "start": 1323.17,
    "end": 1324.64,
    "text": "在牛顿物理现实"
  },
  {
    "start": 1324.64,
    "end": 1327.1,
    "text": "的日常世界中运作"
  },
  {
    "start": 1327.1,
    "end": 1330.86,
    "text": "你知道如何拿起这本书并翻页"
  },
  {
    "start": 1330.86,
    "end": 1332.44,
    "text": "当你读完时"
  },
  {
    "start": 1332.44,
    "end": 1335.51,
    "text": "你知道如何再次放下这本书"
  },
  {
    "start": 1335.51,
    "end": 1338.97,
    "text": "这些是你习得的神经肌肉行为"
  },
  {
    "start": 1338.97,
    "end": 1341.21,
    "text": "当你在六个月大时"
  },
  {
    "start": 1341.21,
    "end": 1343.92,
    "text": "你并不知道如何做到这一点"
  },
  {
    "start": 1343.92,
    "end": 1346.07,
    "text": "但现在你知道了"
  },
  {
    "start": 1346.07,
    "end": 1347.79,
    "text": "你在与日常的——"
  },
  {
    "start": 1347.79,
    "end": 1351.92,
    "text": "被牛顿物理法则束缚的事物—— 互动的过程中"
  },
  {
    "start": 1351.92,
    "end": 1354.3,
    "text": "已经学会了这项技能"
  },
  {
    "start": 1354.3,
    "end": 1356.09,
    "text": "我要建议你的是"
  },
  {
    "start": 1356.09,
    "end": 1358.88,
    "text": "将内在炼金术简单地视为"
  },
  {
    "start": 1358.88,
    "end": 1363.33,
    "text": "在另一个现实（即量子世界）中运作的手段"
  },
  {
    "start": 1363.33,
    "end": 1367.27,
    "text": "就像你学会了如何拿起一本书并放下它"
  },
  {
    "start": 1367.27,
    "end": 1368.3,
    "text": "一样"
  },
  {
    "start": 1368.3,
    "end": 1371.69,
    "text": "你也可以学会在量子世界中做事"
  },
  {
    "start": 1371.69,
    "end": 1375.11,
    "text": "你只需要一个可靠的“教学方法”"
  },
  {
    "start": 1375.11,
    "end": 1379.64,
    "text": "而内在炼金术系统正是这样的教学方法"
  },
  {
    "start": 1379.99,
    "end": 1385.48,
    "text": "暮雨·注 下一集本书将提供许多真实的 奇迹般的 ——"
  },
  {
    "start": 1385.48,
    "end": 1387.35,
    "text": "通过影响“量子现实”"
  },
  {
    "start": 1387.35,
    "end": 1389.7,
    "text": "而改变“牛顿现实”的案例"
  },
  {
    "start": 1389.7,
    "end": 1392.94,
    "text": "【名词解"
  },
  {
    "start": 1392.94,
    "end": 1394.68,
    "text": "释】"
  },
  {
    "start": 1395.68,
    "end": 1399.8,
    "text": "心理神经免疫学 致力于研究"
  },
  {
    "start": 1399.8,
    "end": 1401.02,
    "text": "身体和心灵之间"
  },
  {
    "start": 1401.02,
    "end": 1403.05,
    "text": "复杂的双向关系"
  },
  {
    "start": 1403.05,
    "end": 1406.27,
    "text": "以及这种关系如何影响身心健康"
  },
  {
    "start": 1406.27,
    "end": 1407.3,
    "text": "研究人员"
  },
  {
    "start": 1407.3,
    "end": 1408.37,
    "text": "发现"
  },
  {
    "start": 1408.37,
    "end": 1409.47,
    "text": "大脑和免疫系"
  },
  {
    "start": 1409.47,
    "end": 1412.61,
    "text": "统可以通过激素 神经递质和"
  },
  {
    "start": 1412.61,
    "end": 1415.04,
    "text": "细胞因子相互传递信号"
  },
  {
    "start": 1415.04,
    "end": 1416.46,
    "text": "举例来说"
  },
  {
    "start": 1416.46,
    "end": 1420.01,
    "text": "心理压力会引发促炎细胞因子的释放"
  },
  {
    "start": 1420.01,
    "end": 1422.27,
    "text": "从而影响神经系统"
  },
  {
    "start": 1422.27,
    "end": 1426.01,
    "text": "导致抑郁症 心脏病和自身免疫性疾病"
  },
  {
    "start": 1426.01,
    "end": 1427.29,
    "text": "反过来"
  },
  {
    "start": 1427.29,
    "end": 1430.49,
    "text": "免疫系统也可以向大脑发送信号"
  },
  {
    "start": 1430.49,
    "end": 1433.89,
    "text": "由此影响情绪 认知和行为"
  },
  {
    "start": 1433.89,
    "end": 1434.92,
    "text": "然而"
  },
  {
    "start": 1434.92,
    "end": 1439.06,
    "text": "我们可以通过心理干预技术（如冥想 放松训练等）"
  },
  {
    "start": 1439.06,
    "end": 1441.16,
    "text": "来调节神经系统"
  },
  {
    "start": 1441.16,
    "end": 1443.26,
    "text": "从而改善免疫系统的功能"
  },
  {
    "start": 1445.26,
    "end": 1447.15,
    "text": "替代现实  │"
  },
  {
    "start": 1447.15,
    "end": 1450.72,
    "text": "通过“情绪过滤器” 影响现实"
  },
  {
    "start": 1451.72,
    "end": 1454.92,
    "text": "引用自《大角星人文摘》第9集"
  },
  {
    "start": 1454.92,
    "end": 1457.22,
    "text": "如何塑造你的新现实"
  },
  {
    "start": 1457.22,
    "end": 1460.6,
    "text": "你是量子场活动的创造者"
  },
  {
    "start": 1460.6,
    "end": 1462.66,
    "text": "人类有许多自我"
  },
  {
    "start": 1462.66,
    "end": 1465.14,
    "text": "其中一些在意图上是积极的"
  },
  {
    "start": 1465.14,
    "end": 1465.78,
    "text": "而有些"
  },
  {
    "start": 1465.78,
    "end": 1467.41,
    "text": "则是相当消极的"
  },
  {
    "start": 1467.41,
    "end": 1468.98,
    "text": "可以这样想"
  },
  {
    "start": 1468.98,
    "end": 1471.49,
    "text": "如果你有非常美好的一天"
  },
  {
    "start": 1471.49,
    "end": 1473.4,
    "text": "你往往会有好心情"
  },
  {
    "start": 1473.4,
    "end": 1473.91,
    "text": "它粉饰"
  },
  {
    "start": 1473.91,
    "end": 1475.78,
    "text": "了你对身边人的感知"
  },
  {
    "start": 1475.78,
    "end": 1478.01,
    "text": "它粉饰了你看待世界的方式"
  },
  {
    "start": 1478.01,
    "end": 1480.7,
    "text": "它也塑造了你与人互动的方式"
  },
  {
    "start": 1480.7,
    "end": 1482.49,
    "text": "和所采取的行动"
  },
  {
    "start": 1482.49,
    "end": 1484.1,
    "text": "另一方面"
  },
  {
    "start": 1484.1,
    "end": 1486.89,
    "text": "如果你度过了非常艰难的一天"
  },
  {
    "start": 1486.89,
    "end": 1488.47,
    "text": "你可能心情不好"
  },
  {
    "start": 1488.47,
    "end": 1490.68,
    "text": "当你心怀不满时"
  },
  {
    "start": 1490.68,
    "end": 1493.13,
    "text": "整个世界看上去大不相同"
  },
  {
    "start": 1493.13,
    "end": 1494.95,
    "text": "世界没有变"
  },
  {
    "start": 1494.95,
    "end": 1496.95,
    "text": "但你的情绪过滤器变了"
  },
  {
    "start": 1496.95,
    "end": 1499.83,
    "text": "通过这种看待事物的方式"
  },
  {
    "start": 1499.83,
    "end": 1500.92,
    "text": "有许多“我”"
  },
  {
    "start": 1500.92,
    "end": 1504.92,
    "text": "这些“我” 中的每一个都有情绪音调和振动频率"
  },
  {
    "start": 1504.92,
    "end": 1508.03,
    "text": "它创造了一个心理/情绪现实"
  },
  {
    "start": 1508.03,
    "end": 1508.92,
    "text": "而这种心理/"
  },
  {
    "start": 1508.92,
    "end": 1511.99,
    "text": "情绪现实影响你感知的方式"
  },
  {
    "start": 1511.99,
    "end": 1514.24,
    "text": "它影响你所采取的行动"
  },
  {
    "start": 1514.24,
    "end": 1515.77,
    "text": "我想说的是"
  },
  {
    "start": 1515.77,
    "end": 1518.38,
    "text": "你的情绪过滤器是会学习的"
  },
  {
    "start": 1518.38,
    "end": 1521.35,
    "text": "你需要掌握的技巧是选择过滤器"
  },
  {
    "start": 1521.35,
    "end": 1523.43,
    "text": "你希望通过它体验世界"
  },
  {
    "start": 1523.43,
    "end": 1525.7,
    "text": "把这些情绪过滤器"
  },
  {
    "start": 1525.7,
    "end": 1526.88,
    "text": "这些情绪"
  },
  {
    "start": 1526.88,
    "end": 1527.3,
    "text": "想象成一群马"
  },
  {
    "start": 1528.805,
    "end": 1530.595,
    "text": "如果它们奔向不同的方向"
  },
  {
    "start": 1530.595,
    "end": 1532.223,
    "text": "你不会走得太远"
  },
  {
    "start": 1532.503,
    "end": 1535.794,
    "text": "但如果你把你的情绪组合在一起"
  },
  {
    "start": 1535.794,
    "end": 1537.548,
    "text": "进入一致的振动状态"
  },
  {
    "start": 1537.763,
    "end": 1539.696,
    "text": "你可以强有力地移动"
  },
  {
    "start": 1539.696,
    "end": 1542.215,
    "text": "当你带着力量移动时"
  },
  {
    "start": 1542.22,
    "end": 1545.602,
    "text": "你会影响现实"
  }
]