[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "神话只是古人的幻想"
  },
  {
    "start": 4.833,
    "end": 6.933,
    "text": "还是隐藏的 天机"
  },
  {
    "start": 6.966,
    "end": 9.266,
    "text": "我相信许多人对"
  },
  {
    "start": 9.266,
    "end": 11.966,
    "text": "庄子逍遥游・北冥有鱼的故事"
  },
  {
    "start": 11.966,
    "end": 13.6,
    "text": "印象深刻"
  },
  {
    "start": 13.6,
    "end": 15.3,
    "text": "北冥有鱼"
  },
  {
    "start": 15.333,
    "end": 17.133,
    "text": "其名为鲲"
  },
  {
    "start": 17.133,
    "end": 19.2,
    "text": "这究竟是一则寓言"
  },
  {
    "start": 19.2,
    "end": 22.5,
    "text": "还是对古老修行智慧的隐喻"
  },
  {
    "start": 22.533,
    "end": 25.466,
    "text": "正如埃及神话中的人物"
  },
  {
    "start": 25.5,
    "end": 29.6,
    "text": "它们象征着内在炼金术的深层秘密"
  },
  {
    "start": 29.633,
    "end": 31.366,
    "text": "带着疑问"
  },
  {
    "start": 31.4,
    "end": 35.6,
    "text": "我找到了南怀瑾先生的《庄子諵譁》"
  },
  {
    "start": 35.6,
    "end": 41.833,
    "text": "他在书中揭示了《北冥有鱼》与道家内丹术之间的神秘联系"
  },
  {
    "start": 41.866,
    "end": 44.266,
    "text": "并提供了独到的解读"
  },
  {
    "start": 44.266,
    "end": 46.966,
    "text": "从北冥到南冥"
  },
  {
    "start": 47.0,
    "end": 48.666,
    "text": "从鲲到鹏"
  },
  {
    "start": 48.666,
    "end": 50.733,
    "text": "从沉潜到飞升"
  },
  {
    "start": 50.766,
    "end": 55.1,
    "text": "你将看到庄子的智慧如何与道家内丹术"
  },
  {
    "start": 55.1,
    "end": 56.966,
    "text": "昆达里尼修炼"
  },
  {
    "start": 56.966,
    "end": 59.7,
    "text": "甚至埃及神秘学交汇"
  },
  {
    "start": 59.733,
    "end": 61.133,
    "text": "或许"
  },
  {
    "start": 61.166,
    "end": 63.766,
    "text": "这些神话不仅仅是寓言"
  },
  {
    "start": 63.766,
    "end": 67.033,
    "text": "它们讲述的都是同一个秘密"
  },
  {
    "start": 67.033,
    "end": 70.733,
    "text": "那是一扇通往更高意识的大门"
  },
  {
    "start": 70.766,
    "end": 71.8,
    "text": "而我们"
  },
  {
    "start": 71.833,
    "end": 75.366,
    "text": "正站在门前"
  },
  {
    "start": 75.366,
    "end": 77.366,
    "text": "30 00:01:17,366 --> 00:01:20,066 人的进化潜能  │"
  },
  {
    "start": 80.066,
    "end": 83.866,
    "text": "从北溟之鲲到鹏的飞升"
  },
  {
    "start": 83.9,
    "end": 85.6,
    "text": "北冥有鱼"
  },
  {
    "start": 85.6,
    "end": 87.166,
    "text": "其名为鲲"
  },
  {
    "start": 87.2,
    "end": 88.9,
    "text": "鲲之大"
  },
  {
    "start": 88.9,
    "end": 90.933,
    "text": "不知其几千里也"
  },
  {
    "start": 90.966,
    "end": 92.466,
    "text": "化而为鸟"
  },
  {
    "start": 92.466,
    "end": 94.066,
    "text": "其名为鹏"
  },
  {
    "start": 94.066,
    "end": 95.733,
    "text": "鹏之背"
  },
  {
    "start": 95.766,
    "end": 97.866,
    "text": "不知其几千里也"
  },
  {
    "start": 97.9,
    "end": 99.633,
    "text": "怒而飞"
  },
  {
    "start": 99.633,
    "end": 101.9,
    "text": "其翼若垂天之云"
  },
  {
    "start": 101.933,
    "end": 103.6,
    "text": "是鸟也"
  },
  {
    "start": 103.633,
    "end": 106.266,
    "text": "海运则将徙于南冥"
  },
  {
    "start": 106.266,
    "end": 107.9,
    "text": "南冥者"
  },
  {
    "start": 107.933,
    "end": 110.166,
    "text": "天池也"
  },
  {
    "start": 110.166,
    "end": 114.666,
    "text": "・北溟 下丹田 海底轮  │"
  },
  {
    "start": 114.7,
    "end": 117.3,
    "text": "道家修行的起点"
  },
  {
    "start": 117.3,
    "end": 120.5,
    "text": "在许多现代出版的书籍中"
  },
  {
    "start": 120.5,
    "end": 124.1,
    "text": "北冥有鱼的冥字已没有了三点水"
  },
  {
    "start": 124.1,
    "end": 126.533,
    "text": "但南怀瑾先生曾提到"
  },
  {
    "start": 126.566,
    "end": 130.466,
    "text": "道家典籍中的北溟都有三点水"
  },
  {
    "start": 130.466,
    "end": 132.266,
    "text": "带有水的意象"
  },
  {
    "start": 132.3,
    "end": 134.466,
    "text": "在山海经中"
  },
  {
    "start": 134.466,
    "end": 138.266,
    "text": "古人将北溟视作地球的北极"
  },
  {
    "start": 138.3,
    "end": 139.566,
    "text": "那么"
  },
  {
    "start": 139.566,
    "end": 141.8,
    "text": "在道家修行体系中"
  },
  {
    "start": 141.8,
    "end": 144.566,
    "text": "北溟指的是什么呢"
  },
  {
    "start": 144.6,
    "end": 147.466,
    "text": "南怀瑾先生认为"
  },
  {
    "start": 147.5,
    "end": 149.666,
    "text": "人体的北溟对应的是"
  },
  {
    "start": 149.666,
    "end": 152.3,
    "text": "下丹田至海底轮的区域"
  },
  {
    "start": 152.333,
    "end": 154.933,
    "text": "即生命能量沉潜的源头"
  },
  {
    "start": 154.933,
    "end": 159.0,
    "text": "道家修行讲求炼精化气"
  },
  {
    "start": 159.0,
    "end": 160.4,
    "text": "炼气化神"
  },
  {
    "start": 160.433,
    "end": 162.233,
    "text": "炼神还虚"
  },
  {
    "start": 162.233,
    "end": 166.233,
    "text": "其本质是将生命能量逐步提升"
  },
  {
    "start": 166.266,
    "end": 168.166,
    "text": "最终练到头顶"
  },
  {
    "start": 168.166,
    "end": 170.766,
    "text": "进入超越性的意识境界"
  },
  {
    "start": 170.8,
    "end": 174.4,
    "text": "佛家所谓的化身千百亿"
  },
  {
    "start": 174.4,
    "end": 178.0,
    "text": "正是在讲这个道理"
  },
  {
    "start": 178.0,
    "end": 183.166,
    "text": "丹田与海底轮 能量的根基"
  },
  {
    "start": 183.2,
    "end": 186.3,
    "text": "在道家与佛教思想中"
  },
  {
    "start": 186.3,
    "end": 189.433,
    "text": "丹田被视为人体的能量中心"
  },
  {
    "start": 189.433,
    "end": 190.766,
    "text": "通常分为"
  },
  {
    "start": 190.8,
    "end": 194.533,
    "text": "上丹田（额头中央印堂处）"
  },
  {
    "start": 194.533,
    "end": 197.5,
    "text": "中丹田（心窝处）"
  },
  {
    "start": 197.5,
    "end": 201.3,
    "text": "下丹田（肚脐下约1.5寸）"
  },
  {
    "start": 201.333,
    "end": 202.833,
    "text": "其中"
  },
  {
    "start": 202.833,
    "end": 206.566,
    "text": "下丹田又称海底丹田"
  },
  {
    "start": 206.6,
    "end": 209.1,
    "text": "是精气神的储存之处"
  },
  {
    "start": 209.133,
    "end": 211.3,
    "text": "被视为能量的根基"
  },
  {
    "start": 211.3,
    "end": 213.333,
    "text": "与之相对应"
  },
  {
    "start": 213.366,
    "end": 216.866,
    "text": "海底轮位于脊椎底部（会阴部）"
  },
  {
    "start": 216.866,
    "end": 220.3,
    "text": "是七大脉轮中的最低脉轮"
  },
  {
    "start": 220.3,
    "end": 225.933,
    "text": "被认为是生命力能量（昆达里尼）觉醒的起点"
  },
  {
    "start": 225.966,
    "end": 227.733,
    "text": "由此可见"
  },
  {
    "start": 227.733,
    "end": 230.6,
    "text": "无论是道家还是瑜伽修行"
  },
  {
    "start": 230.633,
    "end": 233.633,
    "text": "都强调能量自下而上的转化"
  },
  {
    "start": 233.633,
    "end": 237.5,
    "text": "在接下来南怀瑾先生的解读中"
  },
  {
    "start": 237.533,
    "end": 242.333,
    "text": "这一观点将得到进一步阐释"
  },
  {
    "start": 242.333,
    "end": 244.333,
    "text": "91 00:04:04,333 --> 00:04:08,333 ・鲲 昆达里尼 塞赫姆  │"
  },
  {
    "start": 248.366,
    "end": 250.7,
    "text": "觉醒的潜能"
  },
  {
    "start": 251.1,
    "end": 252.4,
    "text": "北冥有鱼"
  },
  {
    "start": 252.433,
    "end": 254.0,
    "text": "其名为鲲"
  },
  {
    "start": 254.0,
    "end": 257.2,
    "text": "庄子在逍遥游中讲到"
  },
  {
    "start": 257.233,
    "end": 258.433,
    "text": "在北溟之中"
  },
  {
    "start": 258.466,
    "end": 260.566,
    "text": "有一条巨大的鱼"
  },
  {
    "start": 260.6,
    "end": 261.966,
    "text": "名为鲲"
  },
  {
    "start": 262.0,
    "end": 264.9,
    "text": "这条鲲究竟有多大呢"
  },
  {
    "start": 264.9,
    "end": 268.4,
    "text": "他说 不知其几千里也"
  },
  {
    "start": 268.9,
    "end": 271.633,
    "text": "这里的不知其几千里"
  },
  {
    "start": 271.633,
    "end": 276.066,
    "text": "与佛经中常说的八万四千相似"
  },
  {
    "start": 276.1,
    "end": 280.9,
    "text": "意指不可知 不可量 无量无边"
  },
  {
    "start": 280.933,
    "end": 284.6,
    "text": "细心的读者或许已经注意到"
  },
  {
    "start": 284.633,
    "end": 286.3,
    "text": "鲲这个字"
  },
  {
    "start": 286.333,
    "end": 288.333,
    "text": "是否让你联想到 储存在"
  },
  {
    "start": 288.333,
    "end": 290.966,
    "text": "骨盆区域的昆达里尼"
  },
  {
    "start": 290.966,
    "end": 293.666,
    "text": "这仅仅是一个巧合"
  },
  {
    "start": 293.7,
    "end": 297.6,
    "text": "还是庄子有意将昆达里尼比喻为"
  },
  {
    "start": 297.6,
    "end": 299.3,
    "text": "沉潜在北溟海中"
  },
  {
    "start": 299.333,
    "end": 303.166,
    "text": "一条无量无边的大鱼呢"
  },
  {
    "start": 303.2,
    "end": 305.266,
    "text": "在印度哲学中"
  },
  {
    "start": 305.266,
    "end": 307.2,
    "text": "昆达里尼被描绘为"
  },
  {
    "start": 307.2,
    "end": 310.4,
    "text": "蜷伏在脊柱底部的蛇形能量"
  },
  {
    "start": 310.433,
    "end": 313.366,
    "text": "它被认为是一种潜在的生命力"
  },
  {
    "start": 313.4,
    "end": 315.9,
    "text": "具有巨大的转化潜力"
  },
  {
    "start": 315.933,
    "end": 319.666,
    "text": "当这种蛇力量被成功唤醒"
  },
  {
    "start": 319.666,
    "end": 322.633,
    "text": "它可以带来身心灵的深刻转化"
  },
  {
    "start": 322.666,
    "end": 326.6,
    "text": "促使个体精神意识的觉醒和提升"
  },
  {
    "start": 326.6,
    "end": 329.6,
    "text": "进入更高层次的意识体验"
  },
  {
    "start": 329.6,
    "end": 334.1,
    "text": "甚至达到灵性开悟"
  },
  {
    "start": 334.1,
    "end": 336.1,
    "text": "123 00:05:36,100 --> 00:05:39,633 ・鲲进化为鹏 │"
  },
  {
    "start": 339.666,
    "end": 342.1,
    "text": "物化与飞升"
  },
  {
    "start": 342.1,
    "end": 343.666,
    "text": "接下来"
  },
  {
    "start": 343.666,
    "end": 347.233,
    "text": "《逍遥游》进一步描绘了鲲的变化"
  },
  {
    "start": 347.266,
    "end": 348.533,
    "text": "化而为鸟"
  },
  {
    "start": 348.566,
    "end": 350.366,
    "text": "其名为鹏"
  },
  {
    "start": 350.4,
    "end": 352.066,
    "text": "鹏之背"
  },
  {
    "start": 352.066,
    "end": 354.166,
    "text": "不知其几千里也"
  },
  {
    "start": 354.633,
    "end": 355.933,
    "text": "庄子说"
  },
  {
    "start": 355.933,
    "end": 358.466,
    "text": "这条沉潜于水中的巨鱼"
  },
  {
    "start": 358.466,
    "end": 360.466,
    "text": "忽然发生了变化"
  },
  {
    "start": 360.466,
    "end": 362.7,
    "text": "从海里跃入天空"
  },
  {
    "start": 362.733,
    "end": 365.5,
    "text": "化作展翅扶摇的大鹏鸟"
  },
  {
    "start": 365.5,
    "end": 367.8,
    "text": "它的背部之广阔"
  },
  {
    "start": 367.8,
    "end": 370.833,
    "text": "同样是不知其几千里也"
  },
  {
    "start": 370.866,
    "end": 372.466,
    "text": "表面上"
  },
  {
    "start": 372.466,
    "end": 375.3,
    "text": "这似乎是天马行空的奇谈"
  },
  {
    "start": 375.333,
    "end": 377.3,
    "text": "但南怀瑾先生认为"
  },
  {
    "start": 377.3,
    "end": 379.3,
    "text": "这是有据可查的"
  },
  {
    "start": 379.3,
    "end": 381.9,
    "text": "根据中国道家的说法"
  },
  {
    "start": 381.933,
    "end": 384.166,
    "text": "唐代有个神仙谭峭"
  },
  {
    "start": 384.166,
    "end": 386.966,
    "text": "著有一部道书叫《化书》"
  },
  {
    "start": 387.0,
    "end": 389.866,
    "text": "专门讲物化的道理"
  },
  {
    "start": 389.9,
    "end": 394.433,
    "text": "谭峭在书中提出 鳞羽毛介"
  },
  {
    "start": 394.433,
    "end": 396.233,
    "text": "因风气而变化"
  },
  {
    "start": 396.266,
    "end": 398.4,
    "text": "这句话的意思是"
  },
  {
    "start": 398.4,
    "end": 402.933,
    "text": "鱼类 鸟类 昆虫 爬行动物等生物"
  },
  {
    "start": 402.966,
    "end": 409.233,
    "text": "都会受到环境（风气 气候 地理）的影响而发生变化"
  },
  {
    "start": 409.233,
    "end": 413.033,
    "text": "这实际上是一种物种演化观念"
  },
  {
    "start": 413.066,
    "end": 417.633,
    "text": "与现代进化论中环境适应的理论不谋而合"
  },
  {
    "start": 417.633,
    "end": 422.7,
    "text": "《化书》的核心思想是化——谭峭认为"
  },
  {
    "start": 422.733,
    "end": 425.433,
    "text": "变化是宇宙的本质"
  },
  {
    "start": 425.433,
    "end": 428.9,
    "text": "天地万物皆处于不断的变化之中"
  },
  {
    "start": 428.933,
    "end": 430.633,
    "text": "人亦如此"
  },
  {
    "start": 430.633,
    "end": 434.333,
    "text": "如果人执着于固定的形态和观念"
  },
  {
    "start": 434.366,
    "end": 436.033,
    "text": "就会受到束缚"
  },
  {
    "start": 436.033,
    "end": 438.333,
    "text": "难以突破自身的局限"
  },
  {
    "start": 438.366,
    "end": 441.1,
    "text": "如无法破茧而出的蝶"
  },
  {
    "start": 441.1,
    "end": 446.433,
    "text": "从北溟之鲲到鹏之怒而飞"
  },
  {
    "start": 446.433,
    "end": 450.1,
    "text": "这不仅仅是古人对自然变化的奇想"
  },
  {
    "start": 450.133,
    "end": 453.4,
    "text": "更是一种深刻的人生哲学"
  },
  {
    "start": 453.4,
    "end": 455.0,
    "text": "鲲"
  },
  {
    "start": 455.033,
    "end": 457.433,
    "text": "代表着沉潜的无限潜能"
  },
  {
    "start": 457.466,
    "end": 462.233,
    "text": "象征着人类内在尚未被完全开发的可能性"
  },
  {
    "start": 462.233,
    "end": 467.566,
    "text": "而鹏的展翅正是突破局限 超越自我"
  },
  {
    "start": 467.6,
    "end": 471.766,
    "text": "实现精神与生命飞跃的象征"
  },
  {
    "start": 471.766,
    "end": 475.333,
    "text": "无论是道家的炼精化气"
  },
  {
    "start": 475.333,
    "end": 478.8,
    "text": "印度瑜伽的昆达里尼上升"
  },
  {
    "start": 478.8,
    "end": 481.466,
    "text": "还是谭峭的物化说"
  },
  {
    "start": 481.5,
    "end": 484.033,
    "text": "都指向一个共同的主题——"
  },
  {
    "start": 484.033,
    "end": 487.433,
    "text": "生命的潜能是无限的"
  },
  {
    "start": 487.466,
    "end": 491.566,
    "text": "而真正的进化来自于自我认知 能量"
  },
  {
    "start": 491.6,
    "end": 495.966,
    "text": "与生命状态的突破"
  },
  {
    "start": 495.966,
    "end": 497.966,
    "text": "177 00:08:17,966 --> 00:08:20,800 飞升之道"
  },
  {
    "start": 500.8,
    "end": 505.233,
    "text": "・怒而飞  │ 沉潜飞动"
  },
  {
    "start": 505.266,
    "end": 508.7,
    "text": "庄子在《逍遥游》开篇"
  },
  {
    "start": 508.733,
    "end": 511.966,
    "text": "便告诉了我们两个人生道理"
  },
  {
    "start": 512.0,
    "end": 515.933,
    "text": "沉潜飞动与怒而飞"
  },
  {
    "start": 516.4,
    "end": 518.0,
    "text": "沉潜飞动"
  },
  {
    "start": 518.0,
    "end": 520.766,
    "text": "指的是在生命尚未成熟时"
  },
  {
    "start": 520.8,
    "end": 524.0,
    "text": "必须像鲲一样沉潜于深海"
  },
  {
    "start": 524.033,
    "end": 525.166,
    "text": "积蓄力量"
  },
  {
    "start": 525.166,
    "end": 527.066,
    "text": "静待契机"
  },
  {
    "start": 527.066,
    "end": 531.266,
    "text": "无论是年轻人在人生早期的积累"
  },
  {
    "start": 531.266,
    "end": 534.9,
    "text": "还是修道者在未得道前的蛰伏期"
  },
  {
    "start": 534.933,
    "end": 537.233,
    "text": "都遵循这一原则"
  },
  {
    "start": 538.2,
    "end": 541.4,
    "text": "怒而飞中的怒 并非愤怒"
  },
  {
    "start": 541.4,
    "end": 543.0,
    "text": "而是努力的努"
  },
  {
    "start": 543.033,
    "end": 545.766,
    "text": "象征着充盈的生命能量"
  },
  {
    "start": 545.766,
    "end": 547.666,
    "text": "当积蓄到一定程度"
  },
  {
    "start": 547.666,
    "end": 549.266,
    "text": "达到极限时"
  },
  {
    "start": 549.266,
    "end": 553.366,
    "text": "生命便会如鹏鸟般冲天而起"
  },
  {
    "start": 553.366,
    "end": 557.933,
    "text": "正如飞机必须加速到一定程度才能起飞"
  },
  {
    "start": 557.966,
    "end": 559.566,
    "text": "人要实现突破"
  },
  {
    "start": 559.566,
    "end": 562.333,
    "text": "也需要足够的内在推动力"
  },
  {
    "start": 562.366,
    "end": 565.133,
    "text": "这种生命的转变过程"
  },
  {
    "start": 565.133,
    "end": 567.866,
    "text": "不仅存在于道家修行体系"
  },
  {
    "start": 567.866,
    "end": 571.5,
    "text": "也出现在世界各地的炼金术传统中"
  },
  {
    "start": 571.533,
    "end": 573.066,
    "text": "例如"
  },
  {
    "start": 573.066,
    "end": 575.666,
    "text": "《抹大拉手稿》中提到"
  },
  {
    "start": 575.666,
    "end": 579.7,
    "text": "许多炼金术符号都与飞翔的生物有关"
  },
  {
    "start": 579.733,
    "end": 584.466,
    "text": "如印度教的迦楼罗（一种大鹏金翅神鸟）"
  },
  {
    "start": 584.466,
    "end": 588.766,
    "text": "道教的龙 修道者驾鹤成仙的传说"
  },
  {
    "start": 588.8,
    "end": 592.233,
    "text": "甚至埃及神话中的鹰头神荷鲁斯"
  },
  {
    "start": 592.266,
    "end": 594.733,
    "text": "皆在象征精神的飞跃"
  },
  {
    "start": 594.733,
    "end": 597.266,
    "text": "作者汤姆肯永认为"
  },
  {
    "start": 597.266,
    "end": 600.866,
    "text": "内在炼金术的目的在于转化意识"
  },
  {
    "start": 600.9,
    "end": 602.7,
    "text": "加速个人进化"
  },
  {
    "start": 602.733,
    "end": 607.7,
    "text": "由于这种修行所带来的变化是如此深远"
  },
  {
    "start": 607.7,
    "end": 612.566,
    "text": "以至于使修行者感觉自己仿佛超越了生命的局限——"
  },
  {
    "start": 612.6,
    "end": 614.766,
    "text": "飞翔在生命之上"
  },
  {
    "start": 614.766,
    "end": 618.466,
    "text": "并从一个极其扩展的视角来观察它"
  },
  {
    "start": 618.5,
    "end": 620.966,
    "text": "正如鲲化作鹏后"
  },
  {
    "start": 621.0,
    "end": 625.0,
    "text": "世界观亦随之改变"
  },
  {
    "start": 625.0,
    "end": 627.8,
    "text": "据作者在上一章描述的"
  },
  {
    "start": 627.8,
    "end": 632.066,
    "text": "实际上内在炼金术的最终目标是永生"
  },
  {
    "start": 632.066,
    "end": 635.2,
    "text": "也是道家所说的修道成仙"
  },
  {
    "start": 635.2,
    "end": 637.066,
    "text": "彻底超越肉身"
  },
  {
    "start": 637.1,
    "end": 638.4,
    "text": "化作纯粹的能量"
  },
  {
    "start": 638.433,
    "end": 641.6,
    "text": "生物存在于精神世界之中"
  },
  {
    "start": 641.6,
    "end": 643.033,
    "text": "然而"
  },
  {
    "start": 643.033,
    "end": 648.233,
    "text": "问题来了——如何完成飞升呢"
  },
  {
    "start": 648.266,
    "end": 650.266,
    "text": "227 00:10:50,266 --> 00:10:54,833 ・海运  │ 气脉 │ 蛇力量"
  },
  {
    "start": 655.3,
    "end": 656.533,
    "text": "是鸟也"
  },
  {
    "start": 656.566,
    "end": 659.2,
    "text": "海运则将徙于南冥"
  },
  {
    "start": 659.2,
    "end": 662.6,
    "text": "这句话的核心在于海运 二字"
  },
  {
    "start": 662.633,
    "end": 667.233,
    "text": "这里的海运并非航运公司"
  },
  {
    "start": 667.233,
    "end": 669.566,
    "text": "而是庄子创造的一个词"
  },
  {
    "start": 669.6,
    "end": 671.8,
    "text": "指宇宙中有一个动力"
  },
  {
    "start": 671.8,
    "end": 673.966,
    "text": "生命里有一个动能"
  },
  {
    "start": 674.0,
    "end": 676.433,
    "text": "就是大运"
  },
  {
    "start": 676.433,
    "end": 678.3,
    "text": "在佛家"
  },
  {
    "start": 678.333,
    "end": 683.466,
    "text": "这种推动力被称为轮回 在道家"
  },
  {
    "start": 683.466,
    "end": 685.5,
    "text": "它代表着生命的流转"
  },
  {
    "start": 685.5,
    "end": 689.0,
    "text": "是推动一切变化的伟大力量"
  },
  {
    "start": 689.0,
    "end": 692.533,
    "text": "而海 则象征其广阔无边"
  },
  {
    "start": 692.566,
    "end": 695.933,
    "text": "运代表其永不停息的流转"
  },
  {
    "start": 695.933,
    "end": 698.4,
    "text": "在这一动力的推进下"
  },
  {
    "start": 698.4,
    "end": 700.6,
    "text": "生命非变不可"
  },
  {
    "start": 700.633,
    "end": 704.2,
    "text": "因此鲲鱼才会化身为大鹏鸟"
  },
  {
    "start": 704.2,
    "end": 707.233,
    "text": "大鹏鸟怒而飞"
  },
  {
    "start": 707.233,
    "end": 709.933,
    "text": "它鼓足了气飞向何方"
  },
  {
    "start": 709.966,
    "end": 712.166,
    "text": "庄子告诉我们"
  },
  {
    "start": 712.166,
    "end": 716.666,
    "text": "大鹏鸟在这股海运的推动下飞往南冥"
  },
  {
    "start": 716.666,
    "end": 718.933,
    "text": "根据道家的解释"
  },
  {
    "start": 718.933,
    "end": 721.833,
    "text": "修行者体内气脉的运行方式"
  },
  {
    "start": 721.866,
    "end": 725.166,
    "text": "与大鹏飞往南冥的过程极为相似"
  },
  {
    "start": 725.2,
    "end": 727.766,
    "text": "当人体的气脉启动"
  },
  {
    "start": 727.766,
    "end": 730.433,
    "text": "从海底发动上升至头顶"
  },
  {
    "start": 730.466,
    "end": 733.333,
    "text": "就能实现超越与升华"
  },
  {
    "start": 733.333,
    "end": 734.966,
    "text": "然而"
  },
  {
    "start": 735.0,
    "end": 737.5,
    "text": "气脉的突破并非易事"
  },
  {
    "start": 737.533,
    "end": 740.233,
    "text": "它需要一种强大的助力"
  },
  {
    "start": 740.233,
    "end": 742.033,
    "text": "而这一助力"
  },
  {
    "start": 742.033,
    "end": 746.466,
    "text": "正是被称为蛇力量的昆达里尼"
  },
  {
    "start": 746.5,
    "end": 748.966,
    "text": "前面提到的蛇力量"
  },
  {
    "start": 749.0,
    "end": 753.633,
    "text": "昆达里尼就具有这种强大的转化潜力"
  },
  {
    "start": 753.633,
    "end": 758.033,
    "text": "当昆达里尼被唤醒并逐步提升时"
  },
  {
    "start": 758.033,
    "end": 760.733,
    "text": "这股力量沿着中脉上升"
  },
  {
    "start": 760.766,
    "end": 763.133,
    "text": "穿过脊柱的各个脉轮"
  },
  {
    "start": 763.133,
    "end": 765.5,
    "text": "最终到达大脑中枢"
  },
  {
    "start": 765.533,
    "end": 770.566,
    "text": "这个过程不仅能激活并平衡身体与精神能量"
  },
  {
    "start": 770.566,
    "end": 773.766,
    "text": "还能增强大脑智力 创造力"
  },
  {
    "start": 773.766,
    "end": 777.433,
    "text": "尤其是在接受能力方面的潜力"
  },
  {
    "start": 777.433,
    "end": 778.666,
    "text": "那么"
  },
  {
    "start": 778.7,
    "end": 781.133,
    "text": "如何激活昆达里尼呢"
  },
  {
    "start": 781.166,
    "end": 783.333,
    "text": "答案回到了前面提到的"
  },
  {
    "start": 783.766,
    "end": 787.766,
    "text": "沉潜飞动和怒而飞"
  },
  {
    "start": 787.8,
    "end": 790.1,
    "text": "修行者需要通过实践"
  },
  {
    "start": 790.1,
    "end": 793.7,
    "text": "内丹术 冥想 调息等方法"
  },
  {
    "start": 793.7,
    "end": 796.166,
    "text": "使这股沉睡的能量苏醒"
  },
  {
    "start": 796.2,
    "end": 799.066,
    "text": "并沿着气脉逐步上升"
  },
  {
    "start": 799.1,
    "end": 800.566,
    "text": "关于这点"
  },
  {
    "start": 800.6,
    "end": 803.933,
    "text": "我们在抹大拉手稿第10集  荷鲁斯内"
  },
  {
    "start": 803.966,
    "end": 807.166,
    "text": "在炼金术——新手入门冥想方法中"
  },
  {
    "start": 807.2,
    "end": 810.1,
    "text": "有详细的分解冥想步骤"
  },
  {
    "start": 810.1,
    "end": 812.066,
    "text": "但在本书"
  },
  {
    "start": 812.066,
    "end": 814.466,
    "text": "在埃及炼金术的术语中"
  },
  {
    "start": 814.466,
    "end": 817.733,
    "text": "昆达里尼被称为塞赫姆"
  },
  {
    "start": 817.766,
    "end": 820.633,
    "text": "意为使事物直立的力量"
  },
  {
    "start": 820.666,
    "end": 825.633,
    "text": "象征着精神能量的觉醒与转化"
  },
  {
    "start": 825.633,
    "end": 826.833,
    "text": "那么"
  },
  {
    "start": 826.866,
    "end": 830.866,
    "text": "大鹏鸟飞往的南冥 是一个什么样的地方"
  },
  {
    "start": 830.866,
    "end": 835.533,
    "text": "它背后有什么隐藏含义"
  },
  {
    "start": 835.566,
    "end": 837.566,
    "text": "290 00:13:57,566 --> 00:14:01,933 ・南冥  │ 天池虚空"
  },
  {
    "start": 842.5,
    "end": 843.766,
    "text": "南冥者"
  },
  {
    "start": 843.8,
    "end": 845.366,
    "text": "天池也"
  },
  {
    "start": 845.366,
    "end": 848.4,
    "text": "在庄子的寓言故事中"
  },
  {
    "start": 848.4,
    "end": 853.433,
    "text": "南冥与北冥是两个相对的概念"
  },
  {
    "start": 854.133,
    "end": 856.6,
    "text": "北冥是地球的根"
  },
  {
    "start": 856.633,
    "end": 859.166,
    "text": "象征生命最初的起源"
  },
  {
    "start": 859.166,
    "end": 863.5,
    "text": "而南冥则代表无限虚空"
  },
  {
    "start": 863.533,
    "end": 865.6,
    "text": "与宇宙深处相连"
  },
  {
    "start": 865.6,
    "end": 868.4,
    "text": "被称为天池"
  },
  {
    "start": 868.4,
    "end": 870.7,
    "text": "现代科学的发展"
  },
  {
    "start": 870.733,
    "end": 873.966,
    "text": "使得人类对南极的探索不断深入"
  },
  {
    "start": 874.0,
    "end": 877.833,
    "text": "而对北极的真正了解却仍然有限"
  },
  {
    "start": 877.833,
    "end": 879.4,
    "text": "据说"
  },
  {
    "start": 879.4,
    "end": 882.233,
    "text": "飞机一旦进入北极上空"
  },
  {
    "start": 882.233,
    "end": 884.1,
    "text": "指南针会失灵"
  },
  {
    "start": 884.1,
    "end": 888.2,
    "text": "在一些古老的传说和科幻作品中"
  },
  {
    "start": 888.233,
    "end": 891.933,
    "text": "北极被认为是通向另一个世界的入口"
  },
  {
    "start": 891.933,
    "end": 895.466,
    "text": "任何接近的飞行器都会被吸入其中"
  },
  {
    "start": 895.466,
    "end": 898.733,
    "text": "因为北极是旋转的核心"
  },
  {
    "start": 898.766,
    "end": 902.066,
    "text": "是海运的源头——"
  },
  {
    "start": 902.066,
    "end": 907.4,
    "text": "这一点与道家的宇宙观不谋而合"
  },
  {
    "start": 907.433,
    "end": 909.433,
    "text": "313 00:15:09,433 --> 00:15:11,100 炁"
  },
  {
    "start": 911.133,
    "end": 913.466,
    "text": "生命之息"
  },
  {
    "start": 913.466,
    "end": 918.0,
    "text": "・六月息  │夏至阳极阴生"
  },
  {
    "start": 918.0,
    "end": 919.6,
    "text": "接下来"
  },
  {
    "start": 919.633,
    "end": 923.7,
    "text": "庄子讲理由  去以六月息者也"
  },
  {
    "start": 923.733,
    "end": 926.633,
    "text": "为什么是六月息"
  },
  {
    "start": 926.666,
    "end": 928.566,
    "text": "而非其他时节"
  },
  {
    "start": 928.566,
    "end": 930.333,
    "text": "学过易经就知道"
  },
  {
    "start": 930.366,
    "end": 933.266,
    "text": "十二卦代表一年十二个月"
  },
  {
    "start": 933.3,
    "end": 937.166,
    "text": "来表示地球气候 气运的运转"
  },
  {
    "start": 937.2,
    "end": 939.233,
    "text": "而十二卦中"
  },
  {
    "start": 939.233,
    "end": 940.433,
    "text": "六月夏至"
  },
  {
    "start": 940.433,
    "end": 942.633,
    "text": "阳极而阴生"
  },
  {
    "start": 942.666,
    "end": 945.7,
    "text": "这一时刻是能量的转换"
  },
  {
    "start": 945.7,
    "end": 949.233,
    "text": "是生命能量的周期性流转"
  },
  {
    "start": 949.266,
    "end": 950.533,
    "text": "那么"
  },
  {
    "start": 950.533,
    "end": 952.433,
    "text": "什么叫息"
  },
  {
    "start": 952.433,
    "end": 955.033,
    "text": "要注意中国的文字"
  },
  {
    "start": 955.066,
    "end": 957.866,
    "text": "息并非指息灭或消亡"
  },
  {
    "start": 957.9,
    "end": 959.233,
    "text": "而是充电"
  },
  {
    "start": 959.233,
    "end": 960.366,
    "text": "成长"
  },
  {
    "start": 960.4,
    "end": 963.666,
    "text": "即大鹏鸟六月到南极去"
  },
  {
    "start": 963.666,
    "end": 965.866,
    "text": "是为了休养生息"
  },
  {
    "start": 965.9,
    "end": 967.566,
    "text": "此外"
  },
  {
    "start": 967.6,
    "end": 971.333,
    "text": "暮雨认为息字 还有另一层意思"
  },
  {
    "start": 971.333,
    "end": 975.0,
    "text": "你们看这个字由自我的自 和心构成"
  },
  {
    "start": 975.0,
    "end": 978.4,
    "text": "这是否也意味着回归自我的内心"
  },
  {
    "start": 978.433,
    "end": 980.4,
    "text": "让心归于宁静"
  },
  {
    "start": 980.4,
    "end": 982.3,
    "text": "人就能得到休养"
  },
  {
    "start": 982.333,
    "end": 985.266,
    "text": "也能汲取能量充电和成长"
  },
  {
    "start": 985.266,
    "end": 990.0,
    "text": "这种解释与大天使迈克尔系列中的观点相似"
  },
  {
    "start": 990.033,
    "end": 995.633,
    "text": "大天使称之为静止点 神圣心脏中心"
  },
  {
    "start": 995.666,
    "end": 999.5,
    "text": "也称太阳力量中心（如图"
  },
  {
    "start": 999.5,
    "end": 1000.933,
    "text": "包含胸腺"
  },
  {
    "start": 1000.966,
    "end": 1001.933,
    "text": "心脏"
  },
  {
    "start": 1001.966,
    "end": 1003.966,
    "text": "太阳神经丛区）"
  },
  {
    "start": 1003.966,
    "end": 1008.4,
    "text": "这个区域是储存宇宙能量的集结中心"
  },
  {
    "start": 1008.4,
    "end": 1012.133,
    "text": "通过暂停呼吸 回到静止点的冥想方法"
  },
  {
    "start": 1012.133,
    "end": 1015.833,
    "text": "可以激活并整合储备在其中的能量"
  },
  {
    "start": 1015.866,
    "end": 1019.966,
    "text": "在视频 激活你无限潜能的各种方法中"
  },
  {
    "start": 1020.0,
    "end": 1026.166,
    "text": "大天使迈克尔介绍了一种无限呼吸冥想方法（如图）"
  },
  {
    "start": 1026.166,
    "end": 1030.8,
    "text": "神圣呼吸会穿过你的根脉轮/海底轮"
  },
  {
    "start": 1030.8,
    "end": 1034.0,
    "text": "并激活那里的昆达里尼种子原子"
  },
  {
    "start": 1034.033,
    "end": 1037.4,
    "text": "这些储存在根脉轮中的金刚粒子"
  },
  {
    "start": 1037.433,
    "end": 1041.366,
    "text": "在你的超灵/高我的精确监控下"
  },
  {
    "start": 1041.4,
    "end": 1043.666,
    "text": "被添加到神圣呼吸中"
  },
  {
    "start": 1043.666,
    "end": 1044.766,
    "text": "然后"
  },
  {
    "start": 1044.8,
    "end": 1047.766,
    "text": "神圣呼吸向上移动至头顶"
  },
  {
    "start": 1047.766,
    "end": 1049.5,
    "text": "利用这种方法"
  },
  {
    "start": 1049.533,
    "end": 1051.766,
    "text": "你可以提升大脑潜能"
  },
  {
    "start": 1051.766,
    "end": 1055.933,
    "text": "大多数人只能访问大脑的有限部分——"
  },
  {
    "start": 1055.933,
    "end": 1059.2,
    "text": "那些是与第三和第四维度较低层面"
  },
  {
    "start": 1059.2,
    "end": 1061.3,
    "text": "产生共振的频率"
  },
  {
    "start": 1061.333,
    "end": 1062.733,
    "text": "然而"
  },
  {
    "start": 1062.766,
    "end": 1065.7,
    "text": "当你通过提升昆达里尼能量"
  },
  {
    "start": 1065.7,
    "end": 1069.466,
    "text": "穿过中丹田（即太阳力量中心）"
  },
  {
    "start": 1069.5,
    "end": 1071.733,
    "text": "再进入头顶上丹田"
  },
  {
    "start": 1071.733,
    "end": 1074.8,
    "text": "你便激活了更高的大脑中枢"
  },
  {
    "start": 1074.8,
    "end": 1078.833,
    "text": "你将获得对你神圣心智的访问权"
  },
  {
    "start": 1078.866,
    "end": 1080.433,
    "text": "这就是你如何获取"
  },
  {
    "start": 1080.433,
    "end": 1082.466,
    "text": "更高第四维度和"
  },
  {
    "start": 1082.5,
    "end": 1085.7,
    "text": "第五维度宇宙智慧的方式"
  },
  {
    "start": 1085.7,
    "end": 1088.0,
    "text": "如同鲲化为鹏"
  },
  {
    "start": 1088.033,
    "end": 1093.266,
    "text": "你获得了更加广阔的生命视角"
  },
  {
    "start": 1093.3,
    "end": 1095.3,
    "text": "378 00:18:15,300 --> 00:18:16,466 ・野马"
  },
  {
    "start": 1096.466,
    "end": 1098.533,
    "text": "阳焰也  │ 尘埃"
  },
  {
    "start": 1098.566,
    "end": 1100.766,
    "text": "粒子也"
  },
  {
    "start": 1100.766,
    "end": 1105.3,
    "text": "南怀瑾先生进一步分析 野马也"
  },
  {
    "start": 1105.333,
    "end": 1106.533,
    "text": "尘埃也"
  },
  {
    "start": 1106.566,
    "end": 1109.266,
    "text": "生物之以息相吹也"
  },
  {
    "start": 1109.266,
    "end": 1113.6,
    "text": "野马指佛经上讲的阳焰"
  },
  {
    "start": 1113.6,
    "end": 1116.2,
    "text": "即空气中太阳光的幻影"
  },
  {
    "start": 1116.233,
    "end": 1118.833,
    "text": "如海市蜃楼——"
  },
  {
    "start": 1118.833,
    "end": 1123.266,
    "text": "这种现象通常发生在高热或极寒的环境中"
  },
  {
    "start": 1123.3,
    "end": 1126.8,
    "text": "实际上只是太阳光反射的一种投影"
  },
  {
    "start": 1127.4,
    "end": 1130.533,
    "text": "尘埃则指极微小的物质"
  },
  {
    "start": 1130.533,
    "end": 1134.2,
    "text": "佛经中常用微尘来形容"
  },
  {
    "start": 1134.233,
    "end": 1136.433,
    "text": "庄子指出"
  },
  {
    "start": 1136.433,
    "end": 1139.8,
    "text": "无论是像鲲和大鹏那样巨大的生命"
  },
  {
    "start": 1139.833,
    "end": 1142.833,
    "text": "还是比一粒灰尘还小的存在"
  },
  {
    "start": 1142.833,
    "end": 1146.4,
    "text": "它们存在于世界上靠的是什么呢"
  },
  {
    "start": 1146.433,
    "end": 1151.433,
    "text": "这就是生物之以息相吹也"
  },
  {
    "start": 1151.433,
    "end": 1154.833,
    "text": "万物皆依息而存"
  },
  {
    "start": 1154.866,
    "end": 1158.333,
    "text": "也就是修道人讲的炁"
  },
  {
    "start": 1158.366,
    "end": 1161.1,
    "text": "这个炁并非普通的空气"
  },
  {
    "start": 1161.1,
    "end": 1164.2,
    "text": "而是维系生命的根本能量"
  },
  {
    "start": 1164.2,
    "end": 1166.433,
    "text": "当炁充盈时"
  },
  {
    "start": 1166.433,
    "end": 1169.7,
    "text": "生命蓬勃 炁不足时"
  },
  {
    "start": 1169.733,
    "end": 1172.166,
    "text": "便会衰老直至凋零"
  },
  {
    "start": 1172.2,
    "end": 1175.266,
    "text": "而修行者通过调息炼炁"
  },
  {
    "start": 1175.3,
    "end": 1177.3,
    "text": "持续充盈生命能量"
  },
  {
    "start": 1177.3,
    "end": 1181.833,
    "text": "最终达到怒而飞——超越物质的局限"
  },
  {
    "start": 1181.866,
    "end": 1184.833,
    "text": "进入更高层次的觉醒状态"
  },
  {
    "start": 1184.833,
    "end": 1189.733,
    "text": "这与现代量子物理学和能量医学等理论相呼应"
  },
  {
    "start": 1189.766,
    "end": 1192.4,
    "text": "揭示了生命存在的本质"
  },
  {
    "start": 1192.4,
    "end": 1198.6,
    "text": "是在更深层次的能量流动中运转的"
  }
]