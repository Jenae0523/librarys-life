[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "在《抹大拉手稿》第13集中谈到"
  },
  {
    "start": 7.83,
    "end": 10.42,
    "text": "人类进化的下个阶段 悉地"
  },
  {
    "start": 10.42,
    "end": 12.08,
    "text": "或称意识力量"
  },
  {
    "start": 12.08,
    "end": 14.66,
    "text": "是灵性发展的自然结果"
  },
  {
    "start": 14.66,
    "end": 17.63,
    "text": "以及滥用超自然力量的潜在危险"
  },
  {
    "start": 17.63,
    "end": 22.62,
    "text": "本集我将引用卡洛斯·卡斯塔尼达所著的唐望系列"
  },
  {
    "start": 22.62,
    "end": 24.7,
    "text": "做进一步的资料补充"
  },
  {
    "start": 24.7,
    "end": 28.04,
    "text": "唐望详细解释了分身的概念"
  },
  {
    "start": 28.04,
    "end": 30.4,
    "text": "它是人类分裂感的根源"
  },
  {
    "start": 30.4,
    "end": 31.45,
    "text": "然而"
  },
  {
    "start": 31.45,
    "end": 33.23,
    "text": "透过生命回顾"
  },
  {
    "start": 33.23,
    "end": 35.6,
    "text": "我们可以结束这种分裂"
  },
  {
    "start": 35.6,
    "end": 37.33,
    "text": "实现自我的完整"
  },
  {
    "start": 37.33,
    "end": 39.29,
    "text": "从而超越肉体的限制"
  },
  {
    "start": 39.29,
    "end": 40.4,
    "text": "此外"
  },
  {
    "start": 40.4,
    "end": 43.58,
    "text": "唐望也同样谈到了悉地困境"
  },
  {
    "start": 43.58,
    "end": 50.27,
    "text": "并提出警告 一个修行者 若不能将生命中不必要的事物降至最低"
  },
  {
    "start": 50.27,
    "end": 53.49,
    "text": "他们就会 不可避免地陷入一个陷阱——"
  },
  {
    "start": 53.49,
    "end": 56.29,
    "text": "那就是 基于他们原始低级的自我"
  },
  {
    "start": 56.29,
    "end": 60.99,
    "text": "邪恶地为利益而操纵能量和控制他人"
  },
  {
    "start": 60.99,
    "end": 62.98,
    "text": "最终也困住了自己"
  },
  {
    "start": 64.98,
    "end": 66.86,
    "text": "唐望谈分身  │"
  },
  {
    "start": 66.86,
    "end": 70.04,
    "text": "人类的分裂感来自于哪里"
  },
  {
    "start": 70.04,
    "end": 71.15,
    "text": "唐望说"
  },
  {
    "start": 71.15,
    "end": 71.39,
    "text": "肉"
  },
  {
    "start": 71.39,
    "end": 76.24,
    "text": "体与能量体是人类领域中唯一相互对映的能量结"
  },
  {
    "start": 76.24,
    "end": 77.17,
    "text": "构"
  },
  {
    "start": 77.17,
    "end": 78.86,
    "text": "因此他认为"
  },
  {
    "start": 78.86,
    "end": 81.92,
    "text": "这两者才是真正的二元性"
  },
  {
    "start": 81.92,
    "end": 83.59,
    "text": "身体与心灵"
  },
  {
    "start": 83.59,
    "end": 86.63,
    "text": "灵魂与肉体等等的分类方法"
  },
  {
    "start": 86.63,
    "end": 88.84,
    "text": "只是心智的一种推论"
  },
  {
    "start": 88.84,
    "end": 91.7,
    "text": "没有任何能量事实的基础"
  },
  {
    "start": 92.04,
    "end": 93.98,
    "text": "暮雨·注“能量事实”"
  },
  {
    "start": 93.98,
    "end": 96.41,
    "text": "意思是通过直接“看见”能量来"
  },
  {
    "start": 96.41,
    "end": 98.17,
    "text": "获得一个视图"
  },
  {
    "start": 98.17,
    "end": 100.65,
    "text": "进而得到一个不可简化的结论"
  },
  {
    "start": 100.65,
    "end": 103.41,
    "text": "这个结论不是推测出来的"
  },
  {
    "start": 103.41,
    "end": 107.08,
    "text": "也不是通过我们的日常逻辑系统解释出来的"
  },
  {
    "start": 107.08,
    "end": 109.48,
    "text": "所谓的“看见”是一种"
  },
  {
    "start": 109.48,
    "end": 111.51,
    "text": "与普通人的知觉方式"
  },
  {
    "start": 111.51,
    "end": 113.8,
    "text": "完全不同的知觉过程"
  },
  {
    "start": 113.8,
    "end": 116.14,
    "text": "他们能直接感知到能量"
  },
  {
    "start": 116.14,
    "end": 117.46,
    "text": "唐望指出"
  },
  {
    "start": 117.46,
    "end": 118.57,
    "text": "借着纪律"
  },
  {
    "start": 118.57,
    "end": 121.7,
    "text": "任何人都可能使能量体更接近肉"
  },
  {
    "start": 121.7,
    "end": 122.59,
    "text": "体"
  },
  {
    "start": 122.59,
    "end": 124.32,
    "text": "通常情况下"
  },
  {
    "start": 124.32,
    "end": 127.5,
    "text": "这两者之间的距离非常遥远"
  },
  {
    "start": 127.5,
    "end": 133.55,
    "text": "但一旦能量体接近到某种距离时（这里每个人的情况都不一样）"
  },
  {
    "start": 133.55,
    "end": 135.75,
    "text": "任何人只要透过纪律"
  },
  {
    "start": 135.75,
    "end": 139.49,
    "text": "都能把能量体锻炼成一个复制的肉体"
  },
  {
    "start": 139.49,
    "end": 140.85,
    "text": "一个立体的"
  },
  {
    "start": 140.85,
    "end": 142.53,
    "text": "实质的个体"
  },
  {
    "start": 142.53,
    "end": 146.02,
    "text": "这就是巫士观念中的另一个分身"
  },
  {
    "start": 146.02,
    "end": 147.34,
    "text": "同样道理"
  },
  {
    "start": 147.34,
    "end": 149.17,
    "text": "透过相同的纪律"
  },
  {
    "start": 149.17,
    "end": 151.99,
    "text": "任何人也能把他们的实质肉体"
  },
  {
    "start": 151.99,
    "end": 154.63,
    "text": "锻炼成一个复制的能量体"
  },
  {
    "start": 154.63,
    "end": 157.66,
    "text": "一种肉眼无法看见的空灵能量"
  },
  {
    "start": 157.66,
    "end": 159.96,
    "text": "就像所有能量一样"
  },
  {
    "start": 160.3,
    "end": 164.37,
    "text": "暮雨·注这让我联想到所谓的Yeshua的复活"
  },
  {
    "start": 164.37,
    "end": 164.63,
    "text": "《抹"
  },
  {
    "start": 164.63,
    "end": 166.91,
    "text": "大拉手稿》的说法是"
  },
  {
    "start": 166.91,
    "end": 172.2,
    "text": "Yeshua通过炼金术不断增强他的Ka体（也就是能量体"
  },
  {
    "start": 172.2,
    "end": 173.49,
    "text": "以太分身）"
  },
  {
    "start": 173.49,
    "end": 178.25,
    "text": "当他去世后又再度出现在世人面前时"
  },
  {
    "start": 178.25,
    "end": 180.76,
    "text": "实际上是他成功地将能量体"
  },
  {
    "start": 180.76,
    "end": 182.95,
    "text": "汇聚成了一个实质的身体"
  },
  {
    "start": 183.95,
    "end": 186.68,
    "text": "我们内在有一种双重性"
  },
  {
    "start": 186.68,
    "end": 190.09,
    "text": "心灵是我们内在无实质的一部份"
  },
  {
    "start": 190.09,
    "end": 190.3,
    "text": "而"
  },
  {
    "start": 190.3,
    "end": 193.12,
    "text": "肉体是我们具体的一部份"
  },
  {
    "start": 193.12,
    "end": 195.53,
    "text": "这种分别使我们的能量"
  },
  {
    "start": 195.53,
    "end": 198.34,
    "text": "处于一种混乱的断裂状态"
  },
  {
    "start": 198.34,
    "end": 200.03,
    "text": "无法愈合"
  },
  {
    "start": 200.03,
    "end": 203.53,
    "text": "我们人类确实处于一种分裂状态"
  },
  {
    "start": 203.53,
    "end": 204.99,
    "text": "但我们的分裂不是"
  },
  {
    "start": 204.99,
    "end": 207.71,
    "text": "心灵与肉体之间的分离"
  },
  {
    "start": 207.71,
    "end": 210.73,
    "text": "而是在肉体与分身之间——"
  },
  {
    "start": 210.73,
    "end": 213.25,
    "text": "肉体容纳着心灵与自我"
  },
  {
    "start": 213.25,
    "end": 216.43,
    "text": "分身则是我们基本能量的容器"
  },
  {
    "start": 216.43,
    "end": 217.93,
    "text": "在出生前"
  },
  {
    "start": 217.93,
    "end": 222.48,
    "text": "人类的双重性（这种分离状态）并不存在"
  },
  {
    "start": 222.48,
    "end": 224.68,
    "text": "当我们还是婴儿时"
  },
  {
    "start": 224.68,
    "end": 225.94,
    "text": "我们都能知觉到我"
  },
  {
    "start": 225.94,
    "end": 228.92,
    "text": "们的分身 但随着成长"
  },
  {
    "start": 228.92,
    "end": 231.71,
    "text": "我们越来越强调肉体的部份"
  },
  {
    "start": 231.71,
    "end": 234.58,
    "text": "而忽略了空灵的能量部份"
  },
  {
    "start": 234.58,
    "end": 236.99,
    "text": "这种人类的社会化共识"
  },
  {
    "start": 236.99,
    "end": 239.26,
    "text": "将这两部份拉开来"
  },
  {
    "start": 239.26,
    "end": 241.13,
    "text": "一部份朝外发展"
  },
  {
    "start": 241.13,
    "end": 244.79,
    "text": "成为肉体 另一部份朝内发展"
  },
  {
    "start": 244.79,
    "end": 246.23,
    "text": "成为分身"
  },
  {
    "start": 246.23,
    "end": 247.22,
    "text": "结果"
  },
  {
    "start": 247.22,
    "end": 251.49,
    "text": "成年人都完全无法觉察另一部分的存在"
  },
  {
    "start": 251.49,
    "end": 252.88,
    "text": "在死亡时"
  },
  {
    "start": 252.88,
    "end": 255.38,
    "text": "那较重的部份—— 肉体"
  },
  {
    "start": 255.38,
    "end": 256.92,
    "text": "回归为尘土"
  },
  {
    "start": 256.92,
    "end": 261.34,
    "text": "被大地所吸收 而较轻的部份—— 分身"
  },
  {
    "start": 261.34,
    "end": 262.45,
    "text": "（能量体）"
  },
  {
    "start": 262.45,
    "end": 264.14,
    "text": "则自由离去"
  },
  {
    "start": 264.14,
    "end": 265.82,
    "text": "但是很不幸的"
  },
  {
    "start": 265.82,
    "end": 269.23,
    "text": "由于分身从未有机会发展完整"
  },
  {
    "start": 269.23,
    "end": 271.95,
    "text": "它只能体验到一剎那的自由"
  },
  {
    "start": 271.95,
    "end": 275.88,
    "text": "然后就消散在宇宙中了"
  },
  {
    "start": 275.88,
    "end": 277.58,
    "text": "生命回顾  │"
  },
  {
    "start": 277.58,
    "end": 280.43,
    "text": "超越自我限制的方法"
  },
  {
    "start": 280.43,
    "end": 283.14,
    "text": "由于肉体─心灵的双重性"
  },
  {
    "start": 283.14,
    "end": 285.39,
    "text": "是一种错误的分类"
  },
  {
    "start": 285.39,
    "end": 285.88,
    "text": "真"
  },
  {
    "start": 285.88,
    "end": 286.05,
    "text": "实"
  },
  {
    "start": 286.05,
    "end": 288.84,
    "text": "的分类是容纳心灵的肉体"
  },
  {
    "start": 288.84,
    "end": 289.77,
    "text": "以及容纳我们"
  },
  {
    "start": 289.77,
    "end": 289.99,
    "text": "能"
  },
  {
    "start": 289.99,
    "end": 291.62,
    "text": "量的空灵身体"
  },
  {
    "start": 291.62,
    "end": 293.17,
    "text": "或称分身"
  },
  {
    "start": 293.17,
    "end": 295.37,
    "text": "要结束这种分裂感"
  },
  {
    "start": 295.37,
    "end": 299.59,
    "text": "就需要将我们内在的空灵部份—— 我们的分身"
  },
  {
    "start": 299.59,
    "end": 302.05,
    "text": "带入我们的日常意识中"
  },
  {
    "start": 302.05,
    "end": 302.28,
    "text": "123 00:05:02,280 --> 00:05:04,510 当我们的肉体完全觉察到"
  },
  {
    "start": 304.51,
    "end": 307.67,
    "text": "它在能量上的空灵相对部份时"
  },
  {
    "start": 307.67,
    "end": 309.11,
    "text": "换句话说"
  },
  {
    "start": 309.11,
    "end": 313.33,
    "text": "当我们能在日常生活中使用我们的分身时"
  },
  {
    "start": 313.33,
    "end": 316.08,
    "text": "我们就超越了肉体的限制"
  },
  {
    "start": 316.08,
    "end": 317.78,
    "text": "进入了抽象——"
  },
  {
    "start": 317.78,
    "end": 320.82,
    "text": "一种完全不同的意识领域中"
  },
  {
    "start": 320.82,
    "end": 323.34,
    "text": "但对于一个成年人来说"
  },
  {
    "start": 323.34,
    "end": 326.31,
    "text": "一切似乎都已经非常固定了"
  },
  {
    "start": 326.31,
    "end": 329.76,
    "text": "感觉一辈子都不会有机会改变了"
  },
  {
    "start": 329.76,
    "end": 330.71,
    "text": "那么"
  },
  {
    "start": 330.71,
    "end": 333.69,
    "text": "如何才能实现这种超越呢"
  },
  {
    "start": 333.69,
    "end": 336.04,
    "text": "有一种方法可以改变"
  },
  {
    "start": 336.04,
    "end": 338.05,
    "text": "那就是 生命回顾"
  },
  {
    "start": 338.3,
    "end": 340.67,
    "text": "深沉而完全的生命回顾"
  },
  {
    "start": 340.67,
    "end": 342.62,
    "text": "能够使我们觉察到我"
  },
  {
    "start": 342.62,
    "end": 344.54,
    "text": "们需要改变什么"
  },
  {
    "start": 344.54,
    "end": 348.22,
    "text": "使我们毫无偏见地观看自己的生命"
  },
  {
    "start": 348.22,
    "end": 349.87,
    "text": "让我们能够从忙碌的"
  },
  {
    "start": 349.87,
    "end": 352.48,
    "text": "日常生活中暂停下来"
  },
  {
    "start": 352.48,
    "end": 354.55,
    "text": "有意识地做出选择——"
  },
  {
    "start": 354.55,
    "end": 357.55,
    "text": "是继续延续我们平常的行为"
  },
  {
    "start": 357.55,
    "end": 359.39,
    "text": "还是去改变它"
  },
  {
    "start": 359.39,
    "end": 360.99,
    "text": "意愿它离开"
  },
  {
    "start": 360.99,
    "end": 363.2,
    "text": "以免最后被它困住"
  },
  {
    "start": 363.2,
    "end": 367.72,
    "text": "唐望谈悉地  │ 出现的征兆与形式"
  },
  {
    "start": 367.72,
    "end": 369.14,
    "text": "唐望曾说"
  },
  {
    "start": 369.14,
    "end": 371.63,
    "text": "他的传承中的巫士认为"
  },
  {
    "start": 371.63,
    "end": 372.57,
    "text": "内在寂静"
  },
  {
    "start": 372.57,
    "end": 372.8,
    "text": "最"
  },
  {
    "start": 372.8,
    "end": 377.22,
    "text": "值得追求的效果是一种特殊的能量交融"
  },
  {
    "start": 377.22,
    "end": 380.39,
    "text": "总是以强烈的情绪做为前导"
  },
  {
    "start": 380.39,
    "end": 381.57,
    "text": "他认为"
  },
  {
    "start": 381.57,
    "end": 384.42,
    "text": "我的生命回顾就是激发我的情绪"
  },
  {
    "start": 384.42,
    "end": 386.83,
    "text": "到达极端的一种手段"
  },
  {
    "start": 386.83,
    "end": 390.99,
    "text": "我在那种状态中可以体验到能量的交融"
  },
  {
    "start": 390.99,
    "end": 393.69,
    "text": "暮雨曾经做过一个视频"
  },
  {
    "start": 393.69,
    "end": 396.66,
    "text": "谈到重新认识“情绪的价值”"
  },
  {
    "start": 396.66,
    "end": 397.7,
    "text": "此外"
  },
  {
    "start": 397.7,
    "end": 400.06,
    "text": "哈索尔人关于创造与显化的教"
  },
  {
    "start": 400.06,
    "end": 403.87,
    "text": "导中也强调过掌握连贯情绪的能力"
  },
  {
    "start": 403.87,
    "end": 407.51,
    "text": "并从量子物理学的角度解释了其中的原理"
  },
  {
    "start": 407.51,
    "end": 412.29,
    "text": "感兴趣的朋友可以去看之前的视频或文章"
  },
  {
    "start": 413.29,
    "end": 416.1,
    "text": "这种能量交融以色彩的形式"
  },
  {
    "start": 416.1,
    "end": 418.94,
    "text": "呈现在日常世界的地平线"
  },
  {
    "start": 418.94,
    "end": 421.33,
    "text": "也许是一座山后的天际"
  },
  {
    "start": 421.33,
    "end": 422.28,
    "text": "也许是在一堵"
  },
  {
    "start": 422.28,
    "end": 423.39,
    "text": "墙上"
  },
  {
    "start": 423.39,
    "end": 425.6,
    "text": "甚至可能只是由伸出手掌"
  },
  {
    "start": 425.6,
    "end": 427.83,
    "text": "所形成的地平线"
  },
  {
    "start": 427.83,
    "end": 430.46,
    "text": "他描述这种交融的色彩"
  },
  {
    "start": 430.46,
    "end": 433.05,
    "text": "刚开始时是一抹紫色"
  },
  {
    "start": 433.05,
    "end": 434.74,
    "text": "时间久了之后"
  },
  {
    "start": 434.74,
    "end": 438.1,
    "text": "这团紫色会逐渐扩大 散布"
  },
  {
    "start": 438.1,
    "end": 440.99,
    "text": "犹如风暴云团席卷而来"
  },
  {
    "start": 440.99,
    "end": 443.36,
    "text": "然后会有一个很奇特"
  },
  {
    "start": 443.36,
    "end": 445.61,
    "text": "很鲜艳的红点出现"
  },
  {
    "start": 445.61,
    "end": 448.88,
    "text": "彷佛从紫色的云中破空而出"
  },
  {
    "start": 448.88,
    "end": 449.82,
    "text": "他说"
  },
  {
    "start": 449.82,
    "end": 452.89,
    "text": "随着巫士越来越有纪律与经验"
  },
  {
    "start": 452.89,
    "end": 456.88,
    "text": "这个红点最后会爆发成为思想与意象"
  },
  {
    "start": 456.88,
    "end": 459.97,
    "text": "不同的人的经验会有所不同"
  },
  {
    "start": 459.97,
    "end": 461.89,
    "text": "也许在作家身上"
  },
  {
    "start": 461.89,
    "end": 464.37,
    "text": "会成为滔滔不绝的文字"
  },
  {
    "start": 464.37,
    "end": 466.64,
    "text": "而对于巫士可能看见"
  },
  {
    "start": 466.64,
    "end": 469.1,
    "text": "由能量所形成的影像"
  },
  {
    "start": 469.1,
    "end": 471.17,
    "text": "或是听见声音"
  },
  {
    "start": 471.52,
    "end": 473.9,
    "text": "暮雨·注不确定我的经验是否"
  },
  {
    "start": 473.9,
    "end": 476.44,
    "text": "与唐望说的是同一件事"
  },
  {
    "start": 476.44,
    "end": 479.72,
    "text": "仅供参考 当我让两只眼睛同时聚"
  },
  {
    "start": 479.72,
    "end": 480.91,
    "text": "焦于一点"
  },
  {
    "start": 480.91,
    "end": 482.87,
    "text": "眼神涣散放空"
  },
  {
    "start": 482.87,
    "end": 485.75,
    "text": "眼睛放松（类似做对眼"
  },
  {
    "start": 485.75,
    "end": 487.12,
    "text": "但不要用力）"
  },
  {
    "start": 487.12,
    "end": 491.73,
    "text": "眼前就会出现一抹紫色（它总是紫色的"
  },
  {
    "start": 491.73,
    "end": 495.95,
    "text": "尽管我曾经试图用意识把它变成其它颜色"
  },
  {
    "start": 495.95,
    "end": 497.39,
    "text": "但没有成功）"
  },
  {
    "start": 497.39,
    "end": 500.26,
    "text": "刚开始那团紫色很小"
  },
  {
    "start": 500.26,
    "end": 503.14,
    "text": "但随着我注意力越来越集中"
  },
  {
    "start": 503.14,
    "end": 505.62,
    "text": "那团紫色会越来越大"
  },
  {
    "start": 505.62,
    "end": 507.68,
    "text": "颜色也越来越明显"
  },
  {
    "start": 507.68,
    "end": 510.01,
    "text": "它的运动呈螺旋旋转"
  },
  {
    "start": 510.01,
    "end": 513.9,
    "text": "在保持足够长时间的专注与寂静后"
  },
  {
    "start": 513.9,
    "end": 517.18,
    "text": "紫色的中间会出现一个极小的光点"
  },
  {
    "start": 517.18,
    "end": 518.92,
    "text": "有时候是红色"
  },
  {
    "start": 518.92,
    "end": 520.72,
    "text": "有时候是白色"
  },
  {
    "start": 520.72,
    "end": 522.74,
    "text": "这个点在极快的运动"
  },
  {
    "start": 522.74,
    "end": 524.69,
    "text": "仔细看时"
  },
  {
    "start": 524.69,
    "end": 527.32,
    "text": "可以清晰地看到许多小光子"
  },
  {
    "start": 527.32,
    "end": 529.41,
    "text": "在做原子绕核运动"
  },
  {
    "start": 529.41,
    "end": 532.13,
    "text": "“原子绕核运动”的想法"
  },
  {
    "start": 532.13,
    "end": 534.78,
    "text": "是当我看到那些光子运动后"
  },
  {
    "start": 534.78,
    "end": 536.31,
    "text": "产生疑问时"
  },
  {
    "start": 536.31,
    "end": 538.15,
    "text": "心里立即得到的答案"
  },
  {
    "start": 538.15,
    "end": 539.16,
    "text": "然而"
  },
  {
    "start": 539.16,
    "end": 541.06,
    "text": "那晚我在书桌前"
  },
  {
    "start": 541.06,
    "end": 544.41,
    "text": "我没有看见任何紫色或卷云"
  },
  {
    "start": 544.41,
    "end": 548.08,
    "text": "我确定自己没有巫士所需的纪律使能量"
  },
  {
    "start": 548.08,
    "end": 549.65,
    "text": "发生交融"
  },
  {
    "start": 549.65,
    "end": 553.08,
    "text": "但我眼前出现了一个很大的红点"
  },
  {
    "start": 553.08,
    "end": 557.79,
    "text": "这个大红点毫无预兆地爆发成为一连串文字"
  },
  {
    "start": 557.79,
    "end": 561.23,
    "text": "彷佛从打字机的一端迅速输出"
  },
  {
    "start": 561.23,
    "end": 565.31,
    "text": "这些文字以极快的速度从我眼前掠过"
  },
  {
    "start": 565.31,
    "end": 567.47,
    "text": "我根本来不及阅读"
  },
  {
    "start": 567.47,
    "end": 568.39,
    "text": "接着"
  },
  {
    "start": 568.39,
    "end": 571.64,
    "text": "我听见一个声音向我描述事情"
  },
  {
    "start": 571.64,
    "end": 572.61,
    "text": "然而"
  },
  {
    "start": 572.61,
    "end": 576.28,
    "text": "声音的速度与我的耳朵也无法配合"
  },
  {
    "start": 576.28,
    "end": 579.21,
    "text": "所有声音全都混淆在一起"
  },
  {
    "start": 579.21,
    "end": 581.32,
    "text": "听不出任何意义"
  },
  {
    "start": 581.32,
    "end": 582.9,
    "text": "更糟糕的是"
  },
  {
    "start": 582.9,
    "end": 585.83,
    "text": "我开始看见一些很朦胧的景象"
  },
  {
    "start": 585.83,
    "end": 588.38,
    "text": "就像吃饱后睡觉做的梦"
  },
  {
    "start": 588.38,
    "end": 590.83,
    "text": "黑暗阴沉而且不祥"
  },
  {
    "start": 590.83,
    "end": 591.24,
    "text": "我"
  },
  {
    "start": 591.24,
    "end": 592.44,
    "text": "开始挣扎"
  },
  {
    "start": 592.44,
    "end": 594.73,
    "text": "直到我感觉想要呕吐"
  },
  {
    "start": 594.73,
    "end": 597.13,
    "text": "整件事才告一段落"
  },
  {
    "start": 597.13,
    "end": 601.47,
    "text": "我全身筋骨都感受到了这次事件的影响"
  },
  {
    "start": 601.47,
    "end": 603.09,
    "text": "精疲力竭"
  },
  {
    "start": 603.09,
    "end": 607.45,
    "text": "这次触不及防的发作让我又愤怒又气馁"
  },
  {
    "start": 607.45,
    "end": 610.18,
    "text": "唐望听完我的故事后说"
  },
  {
    "start": 610.18,
    "end": 615.12,
    "text": "这是无限首次如此降临到你身上"
  },
  {
    "start": 615.12,
    "end": 618.44,
    "text": "就像是闪电偷袭一样"
  },
  {
    "start": 618.44,
    "end": 619.0,
    "text": "它完"
  },
  {
    "start": 619.0,
    "end": 621.35,
    "text": "全接管了你的控制"
  },
  {
    "start": 621.35,
    "end": 625.17,
    "text": "对于你的视觉速度和听觉速度"
  },
  {
    "start": 625.17,
    "end": 628.62,
    "text": "你自己必须学习加以调整"
  },
  {
    "start": 628.62,
    "end": 631.33,
    "text": "对某些巫士而言"
  },
  {
    "start": 631.33,
    "end": 633.99,
    "text": "这将是一生的修行"
  },
  {
    "start": 633.99,
    "end": 636.48,
    "text": "但从现在开始"
  },
  {
    "start": 636.48,
    "end": 639.07,
    "text": "能量会在你面前显现"
  },
  {
    "start": 639.07,
    "end": 642.64,
    "text": "彷佛投射在一块电影屏幕上"
  },
  {
    "start": 642.64,
    "end": 646.47,
    "text": "至于你是否了解能量的投射"
  },
  {
    "start": 646.47,
    "end": 648.81,
    "text": "那是另外一回事"
  },
  {
    "start": 648.81,
    "end": 651.8,
    "text": "为了能正确地诠释它"
  },
  {
    "start": 651.8,
    "end": 653.88,
    "text": "你需要有经验"
  },
  {
    "start": 653.88,
    "end": 655.02,
    "text": "我建议"
  },
  {
    "start": 655.02,
    "end": 656.69,
    "text": "你不要害臊"
  },
  {
    "start": 656.69,
    "end": 659.17,
    "text": "从现在开始学习"
  },
  {
    "start": 659.17,
    "end": 661.82,
    "text": "读取能量的显现"
  },
  {
    "start": 661.82,
    "end": 664.92,
    "text": "你的真实心智正在浮现"
  },
  {
    "start": 664.92,
    "end": 668.53,
    "text": "它与那个外来的心智毫无关系"
  },
  {
    "start": 668.53,
    "end": 672.89,
    "text": "让你的真实心智来调整速度"
  },
  {
    "start": 672.89,
    "end": 674.74,
    "text": "保持寂静"
  },
  {
    "start": 674.74,
    "end": 676.25,
    "text": "不要烦躁"
  },
  {
    "start": 676.25,
    "end": 678.41,
    "text": "不管会发生什么"
  },
  {
    "start": 678.66,
    "end": 682.52,
    "text": "但为什么要把能量当成文字来阅读"
  },
  {
    "start": 682.76,
    "end": 683.91,
    "text": "我坚持问"
  },
  {
    "start": 683.91,
    "end": 685.57,
    "text": "只是为了质疑"
  },
  {
    "start": 685.57,
    "end": 686.93,
    "text": "他说"
  },
  {
    "start": 686.93,
    "end": 688.59,
    "text": "这是属于你"
  },
  {
    "start": 688.59,
    "end": 690.25,
    "text": "自己的态度"
  },
  {
    "start": 690.25,
    "end": 692.57,
    "text": "如果你去阅读"
  },
  {
    "start": 692.57,
    "end": 695.41,
    "text": "就能逐字不漏地重复"
  },
  {
    "start": 695.41,
    "end": 698.34,
    "text": "但是如果你想成为无限"
  },
  {
    "start": 698.34,
    "end": 699.62,
    "text": "的目击者"
  },
  {
    "start": 699.62,
    "end": 702.41,
    "text": "而不是无限的阅读者"
  },
  {
    "start": 702.41,
    "end": 706.55,
    "text": "你会发现自己无法描述你所看见的"
  },
  {
    "start": 706.55,
    "end": 708.78,
    "text": "你只会语无伦次"
  },
  {
    "start": 708.78,
    "end": 711.92,
    "text": "无法表达你所目击的事物"
  },
  {
    "start": 711.92,
    "end": 713.37,
    "text": "同样"
  },
  {
    "start": 713.37,
    "end": 715.35,
    "text": "如果你听见了"
  },
  {
    "start": 715.35,
    "end": 717.47,
    "text": "结果也是一样"
  },
  {
    "start": 717.47,
    "end": 720.38,
    "text": "这是属于你特有的"
  },
  {
    "start": 720.38,
    "end": 721.83,
    "text": "不管如何"
  },
  {
    "start": 721.83,
    "end": 724.08,
    "text": "无限会选择方式"
  },
  {
    "start": 724.08,
    "end": 726.85,
    "text": "你只能接受它的选择"
  },
  {
    "start": 726.85,
    "end": 729.27,
    "text": "但最重要的是"
  },
  {
    "start": 729.48,
    "end": 731.98,
    "text": "他刻意停顿片刻后说"
  },
  {
    "start": 731.98,
    "end": 737.13,
    "text": "不要只是因为你无法描述就大惊小怪"
  },
  {
    "start": 737.13,
    "end": 738.28,
    "text": "这件事"
  },
  {
    "start": 738.28,
    "end": 741.49,
    "text": "超出了我们人类的语言系统"
  },
  {
    "start": 743.49,
    "end": 747.98,
    "text": "唐望谈悉地困境  │ 人类的黑暗面"
  },
  {
    "start": 747.98,
    "end": 753.02,
    "text": "我曾激动地与唐望争辩 “人类的确有邪恶的一面"
  },
  {
    "start": 753.02,
    "end": 754.75,
    "text": "你总是否认它"
  },
  {
    "start": 754.75,
    "end": 757.18,
    "text": "总是说邪恶并不存在"
  },
  {
    "start": 757.18,
    "end": 757.33,
    "text": "只"
  },
  {
    "start": 757.33,
    "end": 760.72,
    "text": "有力量存在 ”唐望回答"
  },
  {
    "start": 760.72,
    "end": 763.15,
    "text": "“当然我们有黑暗面"
  },
  {
    "start": 763.15,
    "end": 765.82,
    "text": "人类毫无理由地杀人"
  },
  {
    "start": 765.82,
    "end": 768.64,
    "text": "以上帝之名把人烧死"
  },
  {
    "start": 768.64,
    "end": 770.64,
    "text": "人类毁灭自己"
  },
  {
    "start": 770.64,
    "end": 773.24,
    "text": "毁灭这星球上的生命"
  },
  {
    "start": 773.24,
    "end": 775.13,
    "text": "摧残地球"
  },
  {
    "start": 775.13,
    "end": 778.17,
    "text": "然后人类穿上长袍"
  },
  {
    "start": 778.17,
    "end": 780.68,
    "text": "假装上帝对我们说话"
  },
  {
    "start": 780.68,
    "end": 782.68,
    "text": "上帝说了什么呢"
  },
  {
    "start": 782.68,
    "end": 785.61,
    "text": "他说我们要做个好孩子"
  },
  {
    "start": 785.61,
    "end": 788.06,
    "text": "否则他要惩罚我们"
  },
  {
    "start": 788.06,
    "end": 791.78,
    "text": "上帝威胁了我们好几个世纪"
  },
  {
    "start": 791.78,
    "end": 794.5,
    "text": "但没有造成任何不同"
  },
  {
    "start": 794.5,
    "end": 797.12,
    "text": "不是因为我们邪恶"
  },
  {
    "start": 797.12,
    "end": 799.51,
    "text": "而是因为我们愚蠢"
  },
  {
    "start": 799.51,
    "end": 800.82,
    "text": "不错"
  },
  {
    "start": 800.82,
    "end": 802.77,
    "text": "人类有黑暗面"
  },
  {
    "start": 802.77,
    "end": 806.46,
    "text": "而它被称为愚蠢 ” 唐望说"
  },
  {
    "start": 806.46,
    "end": 807.9,
    "text": "古代的巫士证明了"
  },
  {
    "start": 807.9,
    "end": 810.67,
    "text": "人的潜能是无可限制的"
  },
  {
    "start": 810.67,
    "end": 815.08,
    "text": "但他认为那些古代的巫士是浪费 沉迷"
  },
  {
    "start": 815.08,
    "end": 815.27,
    "text": "与"
  },
  {
    "start": 815.27,
    "end": 816.74,
    "text": "放任的人"
  },
  {
    "start": 816.74,
    "end": 819.17,
    "text": "他们虽学到奇妙的事"
  },
  {
    "start": 819.17,
    "end": 822.53,
    "text": "但都是基于他们原始低级的自我"
  },
  {
    "start": 822.53,
    "end": 824.48,
    "text": "最后他们搞砸了"
  },
  {
    "start": 824.48,
    "end": 826.22,
    "text": "他们变得贪心"
  },
  {
    "start": 826.22,
    "end": 830.61,
    "text": "当古代巫士到达一条重要的交叉路口时"
  },
  {
    "start": 830.61,
    "end": 832.87,
    "text": "他们选择错误的方向"
  },
  {
    "start": 832.87,
    "end": 837.09,
    "text": "邪恶地为利益而操纵能量和控制他人"
  },
  {
    "start": 837.09,
    "end": 838.4,
    "text": "唐望指出"
  },
  {
    "start": 838.4,
    "end": 840.92,
    "text": "接触那个领域是危险的"
  },
  {
    "start": 840.92,
    "end": 844.57,
    "text": "因为当人们聚焦于物质世界的事物时"
  },
  {
    "start": 844.57,
    "end": 846.07,
    "text": "那个领域的力量就"
  },
  {
    "start": 846.07,
    "end": 848.45,
    "text": "能带出人类的邪恶"
  },
  {
    "start": 848.45,
    "end": 849.32,
    "text": "因此"
  },
  {
    "start": 849.32,
    "end": 853.38,
    "text": "一个修行者的修行生涯是漫长而艰辛的"
  },
  {
    "start": 853.38,
    "end": 857.63,
    "text": "因为他必须把生命中不必要的事物降至最低"
  },
  {
    "start": 857.63,
    "end": 861.53,
    "text": "才能够承受得住与力量接触的冲击"
  },
  {
    "start": 861.53,
    "end": 863.38,
    "text": "唐望的论点是"
  },
  {
    "start": 863.38,
    "end": 865.96,
    "text": "我们会面临两种选择"
  },
  {
    "start": 865.96,
    "end": 868.72,
    "text": "一种是跟随一般人的想法"
  },
  {
    "start": 868.72,
    "end": 871.19,
    "text": "接受这样的论断 理性告诉"
  },
  {
    "start": 871.19,
    "end": 872.14,
    "text": "我们"
  },
  {
    "start": 872.14,
    "end": 875.07,
    "text": "我们身处的世界是唯一的世界"
  },
  {
    "start": 875.07,
    "end": 876.67,
    "text": "除此之外的其他世界"
  },
  {
    "start": 876.67,
    "end": 879.38,
    "text": "不可能 也不会存在"
  },
  {
    "start": 879.38,
    "end": 883.32,
    "text": "另一种选择是跟随古代巫士的想法"
  },
  {
    "start": 883.32,
    "end": 886.11,
    "text": "我们会接受其他世界的存在"
  },
  {
    "start": 886.11,
    "end": 888.55,
    "text": "而人类低级自我的贪婪会使"
  },
  {
    "start": 888.55,
    "end": 890.87,
    "text": "我们执着于操纵能量"
  },
  {
    "start": 890.87,
    "end": 895.09,
    "text": "结果是我们真的进入了另一种奇异的领域中"
  },
  {
    "start": 895.09,
    "end": 898.79,
    "text": "但充满着对权利和利益的期待"
  },
  {
    "start": 898.79,
    "end": 900.6,
    "text": "唐望警告我们"
  },
  {
    "start": 900.6,
    "end": 903.52,
    "text": "一定要避免落入这些陷阱中"
  },
  {
    "start": 903.52,
    "end": 905.01,
    "text": "他的作法是"
  },
  {
    "start": 905.01,
    "end": 908.13,
    "text": "使用从未知领域中获取的能量"
  },
  {
    "start": 908.13,
    "end": 908.38,
    "text": "但"
  },
  {
    "start": 908.38,
    "end": 908.69,
    "text": "不接"
  }
]