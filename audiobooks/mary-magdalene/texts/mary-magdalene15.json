[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "我们大多数人最接近量子世界的体验"
  },
  {
    "start": 8.27,
    "end": 10.1,
    "text": "就是在“做梦”的时候"
  },
  {
    "start": 10.1,
    "end": 14.03,
    "text": "虽然梦境常被视为虚构 幻想"
  },
  {
    "start": 14.03,
    "end": 16.77,
    "text": "但并非所有梦境都是想象的"
  },
  {
    "start": 16.77,
    "end": 20.98,
    "text": "有些梦境与我们的日常现实一样真实"
  },
  {
    "start": 20.98,
    "end": 22.38,
    "text": "只是不同而已"
  },
  {
    "start": 22.38,
    "end": 23.67,
    "text": "毕竟"
  },
  {
    "start": 23.67,
    "end": 26.7,
    "text": "科学研究已经毫无疑问地证明"
  },
  {
    "start": 26.7,
    "end": 30.94,
    "text": "我们并没有直接体验现实（无论现实是什么）"
  },
  {
    "start": 30.94,
    "end": 33.5,
    "text": "我们对现实的感知"
  },
  {
    "start": 33.5,
    "end": 36.22,
    "text": "是身体和思想的共同创造"
  },
  {
    "start": 36.22,
    "end": 38.51,
    "text": "在这种背景下"
  },
  {
    "start": 38.51,
    "end": 41.88,
    "text": "梦只是另一种被创造的感知现实"
  },
  {
    "start": 41.88,
    "end": 46.57,
    "text": "而“控梦”是我们每个人都具备的隐藏功能"
  },
  {
    "start": 46.57,
    "end": 48.63,
    "text": "卡洛斯·卡斯塔尼达所著的"
  },
  {
    "start": 48.63,
    "end": 51.35,
    "text": "唐望系列之《做梦的艺术》这本书"
  },
  {
    "start": 51.35,
    "end": 53.33,
    "text": "揭开了其中的奥秘"
  },
  {
    "start": 53.33,
    "end": 57.05,
    "text": "全书探讨了通过控制做梦注意力"
  },
  {
    "start": 57.05,
    "end": 59.75,
    "text": "使梦境成为另一种现实"
  },
  {
    "start": 59.75,
    "end": 62.52,
    "text": "进而达到打破知觉限制的目标"
  },
  {
    "start": 62.52,
    "end": 65.17,
    "text": "唐望是一个近七十岁的"
  },
  {
    "start": 65.17,
    "end": 67.32,
    "text": "亚奎族老印第安人"
  },
  {
    "start": 67.32,
    "end": 70.95,
    "text": "这位老人的西班牙名字是望·马特斯"
  },
  {
    "start": 70.95,
    "end": 71.99,
    "text": "为表示"
  },
  {
    "start": 71.99,
    "end": 73.01,
    "text": "尊敬"
  },
  {
    "start": 73.01,
    "end": 75.49,
    "text": "卡斯塔尼达称他为唐望"
  },
  {
    "start": 77.49,
    "end": 81.22,
    "text": "做梦是调整能量体的艺术"
  },
  {
    "start": 81.22,
    "end": 82.99,
    "text": "唐望将“做梦”称为"
  },
  {
    "start": 82.99,
    "end": 84.66,
    "text": "“通往永恒的入口”"
  },
  {
    "start": 84.66,
    "end": 88.49,
    "text": "透过“做梦 ”我们能知觉其他世界"
  },
  {
    "start": 88.49,
    "end": 91.19,
    "text": "唐望传承的传统中"
  },
  {
    "start": 91.19,
    "end": 92.63,
    "text": "古代巫士发现了一个"
  },
  {
    "start": 92.63,
    "end": 93.04,
    "text": "惊人"
  },
  {
    "start": 93.04,
    "end": 94.52,
    "text": "的事实——"
  },
  {
    "start": 94.52,
    "end": 95.73,
    "text": "当做梦者抵达"
  },
  {
    "start": 95.73,
    "end": 97.29,
    "text": "做梦的第一关时"
  },
  {
    "start": 97.29,
    "end": 99.44,
    "text": "也就抵达了他们的能量体"
  },
  {
    "start": 99.44,
    "end": 101.39,
    "text": "能量体是什么?"
  },
  {
    "start": 101.39,
    "end": 105.09,
    "text": "唐望说它是相对于肉体的部分"
  },
  {
    "start": 105.09,
    "end": 108.84,
    "text": "一种像幻影般由纯能量构成的结构"
  },
  {
    "start": 108.84,
    "end": 111.32,
    "text": "由于它是纯能量"
  },
  {
    "start": 111.32,
    "end": 114.27,
    "text": "因此能够超越肉体的限制"
  },
  {
    "start": 114.27,
    "end": 116.0,
    "text": "譬如瞬间将自己传"
  },
  {
    "start": 116.0,
    "end": 118.04,
    "text": "送到宇宙的另一端"
  },
  {
    "start": 118.41,
    "end": 119.23,
    "text": "暮雨·注"
  },
  {
    "start": 119.23,
    "end": 122.74,
    "text": "这也是《抹大拉手稿》中所说的Ka体"
  },
  {
    "start": 122.74,
    "end": 127.34,
    "text": "有时被称为以太分身或灵性孪生体"
  },
  {
    "start": 127.34,
    "end": 128.99,
    "text": "唐望说"
  },
  {
    "start": 128.99,
    "end": 131.77,
    "text": "做梦是调整能量体的艺术"
  },
  {
    "start": 131.77,
    "end": 133.44,
    "text": "藉着做梦"
  },
  {
    "start": 133.44,
    "end": 134.47,
    "text": "使能量体浓"
  },
  {
    "start": 134.47,
    "end": 136.94,
    "text": "缩成一个能够知觉的单元"
  },
  {
    "start": 136.94,
    "end": 141.16,
    "text": "虽然它的知觉会受我们日常世界知觉的影响"
  },
  {
    "start": 141.16,
    "end": 143.36,
    "text": "但它是个独立的意识"
  },
  {
    "start": 145.36,
    "end": 150.88,
    "text": "人类的能量体  │ 明晰球体  │ 集合点"
  },
  {
    "start": 150.88,
    "end": 152.4,
    "text": "古典巫士“看见"
  },
  {
    "start": 152.4,
    "end": 154.67,
    "text": "”人类的能量本质"
  },
  {
    "start": 154.67,
    "end": 157.86,
    "text": "唐望说他们把人类形容为一个明亮的"
  },
  {
    "start": 157.86,
    "end": 160.01,
    "text": "像巨大的蛋的形状"
  },
  {
    "start": 160.01,
    "end": 161.97,
    "text": "他们称为明晰之蛋"
  },
  {
    "start": 161.97,
    "end": 164.24,
    "text": "人类明晰球体中"
  },
  {
    "start": 164.24,
    "end": 167.44,
    "text": "有一个关键特征 有一处极明亮的圆"
  },
  {
    "start": 167.44,
    "end": 167.95,
    "text": "点"
  },
  {
    "start": 167.95,
    "end": 170.05,
    "text": "像个网球般大小"
  },
  {
    "start": 170.05,
    "end": 172.56,
    "text": "永远嵌在明晰球体内部"
  },
  {
    "start": 172.56,
    "end": 173.22,
    "text": "平贴在"
  },
  {
    "start": 173.22,
    "end": 174.21,
    "text": "表面"
  },
  {
    "start": 174.21,
    "end": 176.75,
    "text": "位置大约在人类右肩骨"
  },
  {
    "start": 176.75,
    "end": 178.34,
    "text": "离背部一臂之遥"
  },
  {
    "start": 178.34,
    "end": 181.53,
    "text": "明晰球体比人体要大很多"
  },
  {
    "start": 181.53,
    "end": 184.85,
    "text": "而这个亮点是能量球体的一部分"
  },
  {
    "start": 184.85,
    "end": 189.28,
    "text": "过去的巫士在看见了这个亮点的功能后"
  },
  {
    "start": 189.28,
    "end": 191.93,
    "text": "将其称为集合点"
  },
  {
    "start": 193.93,
    "end": 195.72,
    "text": "集合点的功能 │"
  },
  {
    "start": 195.72,
    "end": 198.18,
    "text": "改变知觉的关键"
  },
  {
    "start": 198.18,
    "end": 201.01,
    "text": "集合点赋予我们知觉的能力"
  },
  {
    "start": 201.01,
    "end": 203.77,
    "text": "巫士看见人类的知觉集合在那一"
  },
  {
    "start": 203.77,
    "end": 204.84,
    "text": "点上"
  },
  {
    "start": 204.84,
    "end": 207.76,
    "text": "看见所有的生物都有这样的亮点"
  },
  {
    "start": 207.76,
    "end": 211.15,
    "text": "他们推断知觉必然都发生在这一点上"
  },
  {
    "start": 211.15,
    "end": 214.83,
    "text": "他们看见无数的宇宙明亮能量纤维"
  },
  {
    "start": 214.83,
    "end": 216.96,
    "text": "穿过明晰球体"
  },
  {
    "start": 216.96,
    "end": 219.79,
    "text": "其中只有少数穿过集合点"
  },
  {
    "start": 219.79,
    "end": 220.5,
    "text": "因为集合"
  },
  {
    "start": 220.5,
    "end": 220.74,
    "text": "点的"
  },
  {
    "start": 220.74,
    "end": 222.28,
    "text": "面积要小得多"
  },
  {
    "start": 222.28,
    "end": 223.66,
    "text": "然后"
  },
  {
    "start": 223.66,
    "end": 224.62,
    "text": "他们注意到集"
  },
  {
    "start": 224.62,
    "end": 229.08,
    "text": "合点周围总是有一圈特别明亮的光环"
  },
  {
    "start": 229.08,
    "end": 232.82,
    "text": "把穿过集合点的明亮纤维照得非常亮"
  },
  {
    "start": 232.82,
    "end": 234.16,
    "text": "最后"
  },
  {
    "start": 234.16,
    "end": 236.2,
    "text": "他们看见两件事"
  },
  {
    "start": 236.2,
    "end": 238.38,
    "text": "第一 人类的集合点"
  },
  {
    "start": 238.38,
    "end": 240.55,
    "text": "能够脱离原来的位置"
  },
  {
    "start": 240.55,
    "end": 244.85,
    "text": "第二 当集合点位于原来位置时"
  },
  {
    "start": 244.85,
    "end": 247.09,
    "text": "知觉似乎是正常的"
  },
  {
    "start": 247.09,
    "end": 250.65,
    "text": "这可从观察对象的行为方式来判断"
  },
  {
    "start": 250.65,
    "end": 252.0,
    "text": "但当集合点"
  },
  {
    "start": 252.0,
    "end": 254.21,
    "text": "不在平常位置时"
  },
  {
    "start": 254.21,
    "end": 257.28,
    "text": "观察对象的行为变得不寻常"
  },
  {
    "start": 257.28,
    "end": 260.14,
    "text": "表明他们的意识状态发生了改变"
  },
  {
    "start": 260.14,
    "end": 261.49,
    "text": "他们以不寻常的方"
  },
  {
    "start": 261.49,
    "end": 263.44,
    "text": "式知觉现实"
  },
  {
    "start": 263.44,
    "end": 266.64,
    "text": "古代的巫士从以上得到结论"
  },
  {
    "start": 266.64,
    "end": 268.8,
    "text": "集合点的移动越大"
  },
  {
    "start": 268.8,
    "end": 271.05,
    "text": "行为的改变越不寻常"
  },
  {
    "start": 271.05,
    "end": 272.48,
    "text": "由此可知"
  },
  {
    "start": 272.48,
    "end": 276.24,
    "text": "意识与知觉同样也发生不寻常的变化"
  },
  {
    "start": 276.63,
    "end": 277.6,
    "text": "暮雨·注"
  },
  {
    "start": 277.6,
    "end": 281.2,
    "text": "这是否解释了精神失常的原因"
  },
  {
    "start": 283.2,
    "end": 287.52,
    "text": "集合点的移动 │ 奇怪梦的由来"
  },
  {
    "start": 287.52,
    "end": 292.8,
    "text": "古代巫士发现集合点在睡眠时变得很容易移动"
  },
  {
    "start": 292.8,
    "end": 294.42,
    "text": "移动越大"
  },
  {
    "start": 294.42,
    "end": 296.24,
    "text": "所做的梦越奇异"
  },
  {
    "start": 296.24,
    "end": 300.98,
    "text": "他们发展出繁复的技巧来迫使集合点移动"
  },
  {
    "start": 300.98,
    "end": 303.9,
    "text": "像是食用知觉转变性植物后"
  },
  {
    "start": 303.9,
    "end": 307.58,
    "text": "经历了饥饿 疲劳 紧张的状态"
  },
  {
    "start": 307.58,
    "end": 309.28,
    "text": "以及最重要的——"
  },
  {
    "start": 309.28,
    "end": 310.82,
    "text": "对梦的控制"
  },
  {
    "start": 310.82,
    "end": 312.2,
    "text": "在这种方式"
  },
  {
    "start": 312.2,
    "end": 313.0,
    "text": "下"
  },
  {
    "start": 313.0,
    "end": 314.72,
    "text": "他们创造了“做梦”"
  },
  {
    "start": 314.72,
    "end": 316.22,
    "text": "巫士把做梦视"
  },
  {
    "start": 316.22,
    "end": 318.84,
    "text": "为一门极复杂的艺术"
  },
  {
    "start": 318.84,
    "end": 321.8,
    "text": "其目的在于能够随意地移动集合点"
  },
  {
    "start": 321.8,
    "end": 323.65,
    "text": "离开习惯的位置"
  },
  {
    "start": 323.65,
    "end": 326.39,
    "text": "以扩展我们所能知觉的范围"
  },
  {
    "start": 326.39,
    "end": 328.07,
    "text": "唐望说"
  },
  {
    "start": 328.07,
    "end": 331.37,
    "text": "古代巫士从对人类能量波动的看见中"
  },
  {
    "start": 331.37,
    "end": 334.48,
    "text": "得出了设定做梦艺术的五个条件"
  },
  {
    "start": 334.48,
    "end": 339.81,
    "text": "第一 他们看见只有直接通过集合点的能量纤维"
  },
  {
    "start": 339.81,
    "end": 342.13,
    "text": "才能组成协调的知觉"
  },
  {
    "start": 342.13,
    "end": 347.22,
    "text": "第二 他们看见只要集合点被移动到其他位置"
  },
  {
    "start": 347.22,
    "end": 349.67,
    "text": "无论这种移动多轻微"
  },
  {
    "start": 349.67,
    "end": 353.73,
    "text": "不同的陌生能量纤维会开始穿过集合点"
  },
  {
    "start": 353.73,
    "end": 355.86,
    "text": "产生新的意识"
  },
  {
    "start": 355.86,
    "end": 357.37,
    "text": "并使这些陌生的能量"
  },
  {
    "start": 357.37,
    "end": 359.69,
    "text": "变成稳定协调的知觉"
  },
  {
    "start": 359.69,
    "end": 361.89,
    "text": "第三 他们看见在平"
  },
  {
    "start": 361.89,
    "end": 363.7,
    "text": "常的梦境中"
  },
  {
    "start": 363.7,
    "end": 365.58,
    "text": "集合点很容易自行移动到"
  },
  {
    "start": 365.58,
    "end": 369.04,
    "text": "明晰球体表面或内部的新位置上"
  },
  {
    "start": 369.04,
    "end": 371.58,
    "text": "第四 他们看见集合点"
  },
  {
    "start": 371.58,
    "end": 374.54,
    "text": "可以被移动到明晰球体的外部"
  },
  {
    "start": 374.54,
    "end": 376.77,
    "text": "进入宇宙的能量纤维中"
  },
  {
    "start": 376.77,
    "end": 380.43,
    "text": "第五 他们看见藉着纪律训练"
  },
  {
    "start": 380.43,
    "end": 383.72,
    "text": "有可能在睡眠和平常的梦境中"
  },
  {
    "start": 383.72,
    "end": 386.24,
    "text": "培养并实践一种有系统的移"
  },
  {
    "start": 386.24,
    "end": 388.0,
    "text": "动集合点的能力"
  },
  {
    "start": 391.0,
    "end": 394.81,
    "text": "做梦注意力 │ 控制集合点"
  },
  {
    "start": 394.81,
    "end": 398.74,
    "text": "唐望把做梦注意力解释为一种对梦的控"
  },
  {
    "start": 398.74,
    "end": 399.8,
    "text": "制力"
  },
  {
    "start": 399.8,
    "end": 402.85,
    "text": "即当集合点在梦中移动时"
  },
  {
    "start": 402.85,
    "end": 406.33,
    "text": "能够使集合点能定着于新位置的能力"
  },
  {
    "start": 406.33,
    "end": 407.44,
    "text": "更浅显的"
  },
  {
    "start": 407.44,
    "end": 408.71,
    "text": "说法是"
  },
  {
    "start": 408.71,
    "end": 410.45,
    "text": "做梦注意力是意识中"
  },
  {
    "start": 410.45,
    "end": 412.47,
    "text": "不为人所知的一部分"
  },
  {
    "start": 412.47,
    "end": 414.45,
    "text": "是独立的存在"
  },
  {
    "start": 414.45,
    "end": 416.12,
    "text": "等待我们去发现"
  },
  {
    "start": 416.12,
    "end": 418.95,
    "text": "只有当我们注意到它时"
  },
  {
    "start": 418.95,
    "end": 419.31,
    "text": "才能"
  },
  {
    "start": 419.31,
    "end": 420.6,
    "text": "赋予它意义"
  },
  {
    "start": 420.6,
    "end": 422.48,
    "text": "它是一种隐藏的功"
  },
  {
    "start": 422.48,
    "end": 423.25,
    "text": "能"
  },
  {
    "start": 423.25,
    "end": 425.71,
    "text": "我们每个人都具备"
  },
  {
    "start": 425.71,
    "end": 428.09,
    "text": "但大多数人从未有机会"
  },
  {
    "start": 428.09,
    "end": 430.43,
    "text": "在日常生活中使用它"
  },
  {
    "start": 430.43,
    "end": 435.09,
    "text": "为什么大多数人被困在普通梦中"
  },
  {
    "start": 435.09,
    "end": 437.99,
    "text": "这与宇宙的能量流有关"
  },
  {
    "start": 437.99,
    "end": 440.12,
    "text": "它是个一种天然的屏障"
  },
  {
    "start": 440.12,
    "end": 441.79,
    "text": "唐望说"
  },
  {
    "start": 441.79,
    "end": 445.71,
    "text": "宇宙中所有流动的能量都有入口和出口"
  },
  {
    "start": 445.71,
    "end": 447.34,
    "text": "而在做梦中"
  },
  {
    "start": 447.34,
    "end": 449.21,
    "text": "存在七道入口"
  },
  {
    "start": 449.21,
    "end": 451.15,
    "text": "感觉上像是障碍"
  },
  {
    "start": 451.15,
    "end": 453.63,
    "text": "巫士称为“做梦的七道关口”"
  },
  {
    "start": 453.63,
    "end": 457.72,
    "text": "做梦的第一关是一道必须跨越的深沟"
  },
  {
    "start": 457.72,
    "end": 458.4,
    "text": "我们必须"
  },
  {
    "start": 458.4,
    "end": 458.62,
    "text": "能"
  },
  {
    "start": 458.62,
    "end": 462.04,
    "text": "够觉察一种在进入沉睡之前发生的特"
  },
  {
    "start": 462.04,
    "end": 463.28,
    "text": "别感觉"
  },
  {
    "start": 463.28,
    "end": 466.93,
    "text": "这种感觉像是一种舒适的沉重"
  },
  {
    "start": 466.93,
    "end": 469.3,
    "text": "使我们无法睁开双眼"
  },
  {
    "start": 469.3,
    "end": 472.16,
    "text": "当我们觉察自己正在进入梦乡"
  },
  {
    "start": 472.16,
    "end": 474.89,
    "text": "悬浮在黑暗与沉重之中时"
  },
  {
    "start": 474.89,
    "end": 477.45,
    "text": "我们便抵达了做梦的第一关"
  },
  {
    "start": 477.45,
    "end": 479.66,
    "text": "唐望反复强调"
  },
  {
    "start": 479.66,
    "end": 480.59,
    "text": "要使我们的做"
  },
  {
    "start": 480.59,
    "end": 484.44,
    "text": "梦注意力从社会化的意识牢笼中解脱"
  },
  {
    "start": 484.44,
    "end": 487.6,
    "text": "就必须重新分配使用我们已有的能量"
  },
  {
    "start": 487.6,
    "end": 489.74,
    "text": "我们的能量必须从"
  },
  {
    "start": 489.74,
    "end": 493.36,
    "text": "维持我们虚幻的自我形象中解脱出来"
  },
  {
    "start": 493.36,
    "end": 496.72,
    "text": "这样我们才能获得足够的能量"
  },
  {
    "start": 496.72,
    "end": 501.51,
    "text": "从日常意识（即第一注意力）转变进入第二注意力中"
  },
  {
    "start": 501.51,
    "end": 502.94,
    "text": "由此目击到 宇"
  },
  {
    "start": 502.94,
    "end": 503.49,
    "text": "宙真"
  }
]