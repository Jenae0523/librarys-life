[
  {
    "start": 0.0,
    "end": 1.933,
    "text": "激活人体龙穴"
  },
  {
    "start": 1.933,
    "end": 3.799,
    "text": "开启天门之钥"
  },
  {
    "start": 3.8,
    "end": 6.6,
    "text": "这是道教炼金术中少有人知"
  },
  {
    "start": 6.633,
    "end": 8.966,
    "text": "但极为实用的知识——"
  },
  {
    "start": 8.966,
    "end": 11.166,
    "text": "如何借助天地之气的龙穴"
  },
  {
    "start": 11.166,
    "end": 13.766,
    "text": "穿越时间与思想的屏障"
  },
  {
    "start": 13.8,
    "end": 15.5,
    "text": "通向道的源头"
  },
  {
    "start": 15.533,
    "end": 17.399,
    "text": "本集将一步步带你进入"
  },
  {
    "start": 17.4,
    "end": 21.0,
    "text": "真正的道家修炼之境 什么是道"
  },
  {
    "start": 21.033,
    "end": 25.433,
    "text": "为何道家如此重视气 龙穴与龙脉"
  },
  {
    "start": 25.433,
    "end": 28.533,
    "text": "思想 时间与呼吸之间"
  },
  {
    "start": 28.533,
    "end": 31.133,
    "text": "隐藏着怎样神秘的联系"
  },
  {
    "start": 31.166,
    "end": 34.799,
    "text": "它们又如何悄然影响我们的身心健康"
  },
  {
    "start": 34.8,
    "end": 38.433,
    "text": "为了缓解现代生活造成的身心压力"
  },
  {
    "start": 38.466,
    "end": 42.133,
    "text": "最后我们将介绍一种快速而简单的"
  },
  {
    "start": 42.166,
    "end": 43.766,
    "text": "道家静坐法——"
  },
  {
    "start": 43.8,
    "end": 45.433,
    "text": "天门冥想法"
  },
  {
    "start": 45.466,
    "end": 48.899,
    "text": "它特别适合那些饱受 内在对话困扰"
  },
  {
    "start": 48.9,
    "end": 51.3,
    "text": "难以进入冥想状态的人"
  },
  {
    "start": 51.3,
    "end": 55.133,
    "text": "要真正理解道家炼金术的内在逻辑"
  },
  {
    "start": 55.166,
    "end": 58.666,
    "text": "我们得从那个最古老的问题开始"
  },
  {
    "start": 58.666,
    "end": 60.866,
    "text": "何谓道"
  },
  {
    "start": 61.866,
    "end": 63.533,
    "text": "在古代中国"
  },
  {
    "start": 63.566,
    "end": 67.166,
    "text": "有两大主要的哲学流派 儒家与道家"
  },
  {
    "start": 67.2,
    "end": 68.466,
    "text": "不同的是"
  },
  {
    "start": 68.466,
    "end": 70.233,
    "text": "儒家讲求务实"
  },
  {
    "start": 70.266,
    "end": 74.299,
    "text": "强调个人在家庭和国家中的身份与责任"
  },
  {
    "start": 74.333,
    "end": 77.733,
    "text": "而道家则更具神秘色彩"
  },
  {
    "start": 77.733,
    "end": 80.299,
    "text": "它更关注人与宇宙的关系"
  },
  {
    "start": 80.333,
    "end": 82.433,
    "text": "探索如何延长生命"
  },
  {
    "start": 82.433,
    "end": 84.766,
    "text": "以实现精神上的觉悟"
  },
  {
    "start": 84.8,
    "end": 89.4,
    "text": "道家的核心思想建立在一个抽象的概念之上——"
  },
  {
    "start": 89.433,
    "end": 90.433,
    "text": "道"
  },
  {
    "start": 90.433,
    "end": 95.433,
    "text": "道被认为是一种不可见 不可捉摸的智慧能量场"
  },
  {
    "start": 95.466,
    "end": 97.533,
    "text": "这个智能的无形存在"
  },
  {
    "start": 97.566,
    "end": 99.933,
    "text": "是整个宇宙的起源"
  },
  {
    "start": 99.966,
    "end": 102.533,
    "text": "它源源不断地释放能量"
  },
  {
    "start": 102.533,
    "end": 104.266,
    "text": "孕育出天地万物"
  },
  {
    "start": 104.3,
    "end": 108.7,
    "text": "却始终不受它所创造的任何事物影响"
  },
  {
    "start": 108.733,
    "end": 110.433,
    "text": "在道家看来"
  },
  {
    "start": 110.433,
    "end": 113.133,
    "text": "人类是被宇宙眷顾的存在"
  },
  {
    "start": 113.166,
    "end": 114.066,
    "text": "因为人"
  },
  {
    "start": 114.066,
    "end": 116.166,
    "text": "内在最深处的本性"
  },
  {
    "start": 116.2,
    "end": 118.066,
    "text": "拥有一种独特天赋——"
  },
  {
    "start": 118.1,
    "end": 120.666,
    "text": "可以直接接触宇宙的源头"
  },
  {
    "start": 120.666,
    "end": 121.766,
    "text": "道"
  },
  {
    "start": 121.766,
    "end": 124.133,
    "text": "于是古人对道的追寻"
  },
  {
    "start": 124.133,
    "end": 127.533,
    "text": "最终发展出一种独特的修炼体系——"
  },
  {
    "start": 127.566,
    "end": 130.999,
    "text": "道教炼金术（又称内丹术）"
  },
  {
    "start": 131.033,
    "end": 134.666,
    "text": "它的核心教义是 通过内观与觉察"
  },
  {
    "start": 134.666,
    "end": 136.833,
    "text": "唤醒与本性的连结"
  },
  {
    "start": 136.833,
    "end": 140.166,
    "text": "进而与宇宙之道建立深层连接"
  },
  {
    "start": 140.2,
    "end": 142.7,
    "text": "这种连接一旦形成"
  },
  {
    "start": 142.733,
    "end": 145.199,
    "text": "便能汲取强大的转化力量"
  },
  {
    "start": 145.233,
    "end": 148.299,
    "text": "促使人的意识发生深刻变化"
  },
  {
    "start": 148.3,
    "end": 151.266,
    "text": "那些真正达成这一成就的修行者"
  },
  {
    "start": 151.266,
    "end": 155.199,
    "text": "被后世尊为圣人或神仙"
  },
  {
    "start": 155.2,
    "end": 157.9,
    "text": "拥有了近乎神话般的地位"
  },
  {
    "start": 157.933,
    "end": 159.633,
    "text": "毫无疑问"
  },
  {
    "start": 159.633,
    "end": 161.566,
    "text": "这与他们展现出的意识力量"
  },
  {
    "start": 161.6,
    "end": 164.5,
    "text": "——悉地密不可分"
  },
  {
    "start": 164.5,
    "end": 166.966,
    "text": "我们在抹大拉手稿第13集"
  },
  {
    "start": 167.566,
    "end": 170.999,
    "text": "人类进化的下个阶段 悉地与意识力量中"
  },
  {
    "start": 171.0,
    "end": 174.133,
    "text": "已详细探讨过悉地的概念"
  },
  {
    "start": 174.133,
    "end": 177.799,
    "text": "当一个人沿着灵性成长的道路迈进时"
  },
  {
    "start": 177.833,
    "end": 181.799,
    "text": "这种意识力量就会自然展现出来"
  },
  {
    "start": 181.833,
    "end": 184.333,
    "text": "要理解道教炼金术"
  },
  {
    "start": 184.366,
    "end": 188.466,
    "text": "我们必须先认识一种微妙的能量——气"
  },
  {
    "start": 188.8,
    "end": 192.8,
    "text": "气是一种源自道的,生命能量"
  },
  {
    "start": 192.8,
    "end": 195.833,
    "text": "如同一条涓涓不息的生命之河"
  },
  {
    "start": 195.866,
    "end": 199.399,
    "text": "从道,这一宇宙源头中流淌出来"
  },
  {
    "start": 199.4,
    "end": 200.633,
    "text": "周而复始"
  },
  {
    "start": 200.666,
    "end": 201.999,
    "text": "充盈天地"
  },
  {
    "start": 202.0,
    "end": 203.4,
    "text": "孕育万物"
  },
  {
    "start": 203.433,
    "end": 204.633,
    "text": "因此"
  },
  {
    "start": 204.633,
    "end": 207.833,
    "text": "道正是生命之气,的源头"
  },
  {
    "start": 208.066,
    "end": 210.133,
    "text": "气有很多种"
  },
  {
    "start": 210.133,
    "end": 210.999,
    "text": "例如"
  },
  {
    "start": 211.033,
    "end": 213.933,
    "text": "类星体和恒星所释放的生命能量"
  },
  {
    "start": 213.966,
    "end": 215.599,
    "text": "也是一种气"
  },
  {
    "start": 215.6,
    "end": 220.333,
    "text": "尽管它的性质与山间溪流所产生的气大不相同"
  },
  {
    "start": 220.366,
    "end": 223.199,
    "text": "大多数人对气的直觉印象"
  },
  {
    "start": 223.2,
    "end": 226.166,
    "text": "可能是空气中那种微妙的生命力"
  },
  {
    "start": 226.2,
    "end": 228.9,
    "text": "这种气,通常汇集在"
  },
  {
    "start": 228.9,
    "end": 231.433,
    "text": "远离城市的自然环境中"
  },
  {
    "start": 231.466,
    "end": 234.899,
    "text": "尤其在树木繁茂的大片原始森林"
  },
  {
    "start": 234.9,
    "end": 239.1,
    "text": "湖泊 河流或海洋等较大的水体附近"
  },
  {
    "start": 239.133,
    "end": 242.099,
    "text": "这种生命之气最为充盈"
  },
  {
    "start": 242.1,
    "end": 244.133,
    "text": "也有一些人推测"
  },
  {
    "start": 244.133,
    "end": 246.699,
    "text": "这种气可能与负离子有关"
  },
  {
    "start": 246.733,
    "end": 250.866,
    "text": "并且已有部分科学证据支持这一观点"
  },
  {
    "start": 250.9,
    "end": 252.166,
    "text": "然而"
  },
  {
    "start": 252.2,
    "end": 253.766,
    "text": "在道教炼金术中"
  },
  {
    "start": 253.766,
    "end": 256.999,
    "text": "还有一种更微妙 更精致的气"
  },
  {
    "start": 257.033,
    "end": 259.699,
    "text": "这些更高频率的精微能量"
  },
  {
    "start": 259.7,
    "end": 262.966,
    "text": "正是高级道教炼金术的修行重点之一"
  },
  {
    "start": 263.0,
    "end": 264.7,
    "text": "自古以来"
  },
  {
    "start": 264.733,
    "end": 267.699,
    "text": "道家修行者多隐居于山林"
  },
  {
    "start": 267.733,
    "end": 269.633,
    "text": "独自潜心修炼"
  },
  {
    "start": 269.633,
    "end": 270.966,
    "text": "到了后期"
  },
  {
    "start": 270.966,
    "end": 273.199,
    "text": "也有一些志同道合的修行者"
  },
  {
    "start": 273.233,
    "end": 275.299,
    "text": "会组成小型社区"
  },
  {
    "start": 275.3,
    "end": 277.566,
    "text": "共同探索内丹之道"
  },
  {
    "start": 277.6,
    "end": 279.2,
    "text": "但无论是独修"
  },
  {
    "start": 279.2,
    "end": 280.9,
    "text": "还是群修"
  },
  {
    "start": 280.933,
    "end": 284.733,
    "text": "这些道士的居所几乎总是远离尘世喧嚣"
  },
  {
    "start": 284.766,
    "end": 289.133,
    "text": "他们往往寻找气最为充盈的地方居住"
  },
  {
    "start": 289.133,
    "end": 293.666,
    "text": "这些地点被称为龙穴或龙脉"
  },
  {
    "start": 293.666,
    "end": 295.233,
    "text": "所谓龙穴"
  },
  {
    "start": 295.233,
    "end": 298.833,
    "text": "是不同类型的气,相遇交汇之处"
  },
  {
    "start": 298.833,
    "end": 300.833,
    "text": "也是修行者与宇宙之道,"
  },
  {
    "start": 300.866,
    "end": 302.899,
    "text": "深度连结的圣地"
  },
  {
    "start": 302.9,
    "end": 306.466,
    "text": "最典型的龙穴,多见于山脉之间"
  },
  {
    "start": 306.5,
    "end": 308.9,
    "text": "当两条山脊交汇时"
  },
  {
    "start": 308.9,
    "end": 311.966,
    "text": "往往在中间形成一道沟谷或山涧"
  },
  {
    "start": 311.966,
    "end": 313.433,
    "text": "此时"
  },
  {
    "start": 313.433,
    "end": 317.433,
    "text": "来自天空的天之气自上而下流动"
  },
  {
    "start": 317.433,
    "end": 319.299,
    "text": "它会在山脊交汇处"
  },
  {
    "start": 319.3,
    "end": 323.133,
    "text": "与山体所蕴藏的地之气相遇"
  },
  {
    "start": 323.166,
    "end": 325.166,
    "text": "这两股生命之气"
  },
  {
    "start": 325.2,
    "end": 327.466,
    "text": "汇聚成一个强烈的能量场"
  },
  {
    "start": 327.466,
    "end": 329.966,
    "text": "这正是龙穴"
  },
  {
    "start": 330.0,
    "end": 331.366,
    "text": "同样地"
  },
  {
    "start": 331.366,
    "end": 333.866,
    "text": "两条溪流或河川汇合之处"
  },
  {
    "start": 333.866,
    "end": 336.066,
    "text": "也会形成有力的气场"
  },
  {
    "start": 336.1,
    "end": 339.633,
    "text": "这类地理位置也被称为龙穴"
  },
  {
    "start": 339.633,
    "end": 343.299,
    "text": "道家修行者会四处寻觅这些龙穴"
  },
  {
    "start": 343.3,
    "end": 347.733,
    "text": "并选择在这些地点（或附近）建立修行居所"
  },
  {
    "start": 347.766,
    "end": 349.266,
    "text": "如此一来"
  },
  {
    "start": 349.266,
    "end": 353.033,
    "text": "他们便能直接从周围环境中汲取充沛的气"
  },
  {
    "start": 353.066,
    "end": 356.366,
    "text": "使内丹术修炼事半功倍"
  },
  {
    "start": 356.4,
    "end": 360.433,
    "text": "入静  │ 思想与呼吸的微妙联系"
  },
  {
    "start": 360.433,
    "end": 362.466,
    "text": "如同密宗瑜伽"
  },
  {
    "start": 362.5,
    "end": 366.066,
    "text": "道家炼金术的修行者也需训练心智"
  },
  {
    "start": 366.066,
    "end": 368.333,
    "text": "进入长时间的静止状态"
  },
  {
    "start": 368.366,
    "end": 371.033,
    "text": "心灵的寂静至关重要"
  },
  {
    "start": 371.066,
    "end": 373.499,
    "text": "因为唯有在完全的内在静默中"
  },
  {
    "start": 373.5,
    "end": 376.933,
    "text": "人才能真正体验,道"
  },
  {
    "start": 376.966,
    "end": 378.299,
    "text": "此外"
  },
  {
    "start": 378.333,
    "end": 380.966,
    "text": "道家的许多炼金术转化过程"
  },
  {
    "start": 380.966,
    "end": 384.333,
    "text": "也必须在心无杂念的状态中进行"
  },
  {
    "start": 384.366,
    "end": 387.366,
    "text": "道家的静修方式多种多样"
  },
  {
    "start": 387.366,
    "end": 388.899,
    "text": "有些涉及运动"
  },
  {
    "start": 388.9,
    "end": 392.766,
    "text": "如太极拳 有些则以静坐为主"
  },
  {
    "start": 392.8,
    "end": 395.633,
    "text": "如天门法,等冥想练习"
  },
  {
    "start": 395.633,
    "end": 397.666,
    "text": "这些修持的最终目的"
  },
  {
    "start": 397.7,
    "end": 401.3,
    "text": "是为引导意识进入深度宁静的状态"
  },
  {
    "start": 401.333,
    "end": 403.499,
    "text": "在实际修炼过程中"
  },
  {
    "start": 403.5,
    "end": 405.2,
    "text": "尤其是在初期"
  },
  {
    "start": 405.233,
    "end": 408.233,
    "text": "心中常常会涌现出大量杂念"
  },
  {
    "start": 408.233,
    "end": 410.899,
    "text": "思绪时而如洪水般奔涌"
  },
  {
    "start": 410.933,
    "end": 413.599,
    "text": "时而又如细流般缓慢穿梭"
  },
  {
    "start": 413.6,
    "end": 415.566,
    "text": "随着修炼的深入"
  },
  {
    "start": 415.6,
    "end": 418.0,
    "text": "修行者会逐渐察觉到"
  },
  {
    "start": 418.0,
    "end": 420.733,
    "text": "思维的速度似乎开始减慢"
  },
  {
    "start": 420.766,
    "end": 423.533,
    "text": "念头之间出现了更多空隙"
  },
  {
    "start": 423.533,
    "end": 424.966,
    "text": "最终"
  },
  {
    "start": 424.966,
    "end": 426.366,
    "text": "在某个时刻"
  },
  {
    "start": 426.4,
    "end": 429.1,
    "text": "思绪甚至会完全停止"
  },
  {
    "start": 429.1,
    "end": 431.5,
    "text": "哪怕只是极短暂的一瞬"
  },
  {
    "start": 431.533,
    "end": 433.266,
    "text": "更进一步地"
  },
  {
    "start": 433.3,
    "end": 435.0,
    "text": "修行者还注意到"
  },
  {
    "start": 435.0,
    "end": 436.733,
    "text": "在这些入静状态中"
  },
  {
    "start": 436.766,
    "end": 439.333,
    "text": "呼吸也会发生显著变化"
  },
  {
    "start": 439.333,
    "end": 441.366,
    "text": "随着思绪放缓"
  },
  {
    "start": 441.4,
    "end": 444.4,
    "text": "呼吸往往变得更加悠长而缓慢"
  },
  {
    "start": 444.4,
    "end": 447.0,
    "text": "而当思想完全静止时"
  },
  {
    "start": 447.033,
    "end": 449.233,
    "text": "通常呼吸会变得很浅"
  },
  {
    "start": 449.233,
    "end": 450.933,
    "text": "甚至完全暂停"
  },
  {
    "start": 450.966,
    "end": 453.466,
    "text": "这种现象具有重要意义"
  },
  {
    "start": 453.5,
    "end": 456.233,
    "text": "从神经科学的角度来看"
  },
  {
    "start": 456.233,
    "end": 458.633,
    "text": "这一变化源于修行者的大脑波动"
  },
  {
    "start": 458.666,
    "end": 463.733,
    "text": "进入了较低频率的,α波或,θ波状态"
  },
  {
    "start": 463.766,
    "end": 465.599,
    "text": "在这些脑波状态下"
  },
  {
    "start": 465.6,
    "end": 467.266,
    "text": "呼吸自然放慢"
  },
  {
    "start": 467.266,
    "end": 470.799,
    "text": "身体也进入一种深度放松的节奏"
  },
  {
    "start": 470.833,
    "end": 475.999,
    "text": "这里的频率低,是指每秒钟脑波振动的次数较少"
  },
  {
    "start": 476.0,
    "end": 477.9,
    "text": "α波"
  },
  {
    "start": 477.9,
    "end": 482.166,
    "text": "大约每秒8到13次波动 θ波"
  },
  {
    "start": 482.2,
    "end": 483.633,
    "text": "则更低"
  },
  {
    "start": 483.633,
    "end": 485.799,
    "text": "大约每秒4到8次波动"
  },
  {
    "start": 485.833,
    "end": 488.466,
    "text": "相关的冥想研究也发现"
  },
  {
    "start": 488.466,
    "end": 492.966,
    "text": "当大脑中,α波或,θ波增多时"
  },
  {
    "start": 493.0,
    "end": 494.6,
    "text": "不仅呼吸变慢"
  },
  {
    "start": 494.633,
    "end": 497.099,
    "text": "心率和血压也会降低"
  },
  {
    "start": 497.1,
    "end": 500.066,
    "text": "肌肉紧张度也随之减轻——"
  },
  {
    "start": 500.066,
    "end": 501.466,
    "text": "所有这些生理反应"
  },
  {
    "start": 501.5,
    "end": 505.166,
    "text": "都对缓解压力有极其积极的作用"
  },
  {
    "start": 505.2,
    "end": 506.733,
    "text": "事实上"
  },
  {
    "start": 506.766,
    "end": 507.899,
    "text": "研究表明"
  },
  {
    "start": 507.9,
    "end": 510.033,
    "text": "那些长期练习冥想的人"
  },
  {
    "start": 510.033,
    "end": 513.299,
    "text": "普遍比不冥想的人精神压力更低"
  },
  {
    "start": 513.3,
    "end": 515.633,
    "text": "情绪也更加稳定"
  },
  {
    "start": 515.666,
    "end": 518.133,
    "text": "除了这些生理层面的变化"
  },
  {
    "start": 518.133,
    "end": 521.833,
    "text": "修行者常常还会经历一种更深刻的感受"
  },
  {
    "start": 521.866,
    "end": 524.399,
    "text": "时间的消失"
  },
  {
    "start": 524.4,
    "end": 527.866,
    "text": "呼吸的停止与时间感的消失之间"
  },
  {
    "start": 527.9,
    "end": 531.533,
    "text": "似乎存在一种微妙而深刻的关联"
  },
  {
    "start": 531.566,
    "end": 533.866,
    "text": "在瑜伽哲学中"
  },
  {
    "start": 533.9,
    "end": 538.933,
    "text": "呼吸的停止被称为止息（kumbhaka） 而在道"
  },
  {
    "start": 538.933,
    "end": 540.533,
    "text": "家静定修行中"
  },
  {
    "start": 540.566,
    "end": 542.699,
    "text": "也常会遇到呼吸暂停"
  },
  {
    "start": 542.733,
    "end": 546.533,
    "text": "尤其是在进入深层寂静的意识状态时"
  },
  {
    "start": 546.533,
    "end": 547.866,
    "text": "这里"
  },
  {
    "start": 547.9,
    "end": 552.466,
    "text": "我想先分享一次我亲身经历的时间停止"
  },
  {
    "start": 552.466,
    "end": 553.899,
    "text": "几年前"
  },
  {
    "start": 553.933,
    "end": 555.933,
    "text": "大约黄昏前一个小时"
  },
  {
    "start": 555.933,
    "end": 559.399,
    "text": "我在公园练习道家的天门冥想法"
  },
  {
    "start": 559.4,
    "end": 561.333,
    "text": "当暮色降临时"
  },
  {
    "start": 561.366,
    "end": 564.599,
    "text": "我察觉到自己的呼吸和思绪都停滞了"
  },
  {
    "start": 564.633,
    "end": 566.099,
    "text": "不仅如此"
  },
  {
    "start": 566.1,
    "end": 569.833,
    "text": "我整个人的意识变得极为清明和平静"
  },
  {
    "start": 569.866,
    "end": 571.966,
    "text": "如一潭宁静的湖水"
  },
  {
    "start": 572.0,
    "end": 573.4,
    "text": "在那一刻"
  },
  {
    "start": 573.4,
    "end": 575.1,
    "text": "仿佛时间停止了"
  },
  {
    "start": 575.133,
    "end": 577.899,
    "text": "我悬浮在永恒的精神维度中"
  },
  {
    "start": 577.9,
    "end": 579.7,
    "text": "天色渐暗"
  },
  {
    "start": 579.7,
    "end": 581.6,
    "text": "我起身返回停车处"
  },
  {
    "start": 581.633,
    "end": 583.066,
    "text": "约走了二十分钟"
  },
  {
    "start": 583.066,
    "end": 585.066,
    "text": "让我惊讶的是"
  },
  {
    "start": 585.066,
    "end": 587.666,
    "text": "起身的冲动来自身体深处"
  },
  {
    "start": 587.666,
    "end": 589.499,
    "text": "而非头脑的思考——"
  },
  {
    "start": 589.533,
    "end": 592.333,
    "text": "我没有想现在需要回到车里"
  },
  {
    "start": 592.333,
    "end": 594.733,
    "text": "而是身体自然地发出行动"
  },
  {
    "start": 594.733,
    "end": 596.999,
    "text": "这种不说话的意识状态"
  },
  {
    "start": 597.0,
    "end": 599.333,
    "text": "当时对我来说有点新奇"
  },
  {
    "start": 599.333,
    "end": 601.799,
    "text": "一路上呼吸依然浅缓"
  },
  {
    "start": 601.833,
    "end": 604.966,
    "text": "即使需穿越一些山丘也毫不费力"
  },
  {
    "start": 604.966,
    "end": 607.066,
    "text": "颇具讽刺的是"
  },
  {
    "start": 607.066,
    "end": 609.366,
    "text": "直到我在停车场看到自己的车"
  },
  {
    "start": 609.366,
    "end": 611.233,
    "text": "想起晚上的约会"
  },
  {
    "start": 611.233,
    "end": 613.433,
    "text": "才本能地深吸一口气"
  },
  {
    "start": 613.466,
    "end": 614.999,
    "text": "就在那一瞬间"
  },
  {
    "start": 615.0,
    "end": 616.966,
    "text": "呼吸恢复正常"
  },
  {
    "start": 616.966,
    "end": 620.866,
    "text": "而那种超然的无时间感也随之消失了,"
  },
  {
    "start": 620.9,
    "end": 624.033,
    "text": "我又重新回到了时间之中"
  },
  {
    "start": 624.033,
    "end": 625.633,
    "text": "有趣的是"
  },
  {
    "start": 625.633,
    "end": 629.366,
    "text": "呼吸暂停的概念也出现在埃及炼金术中"
  },
  {
    "start": 629.4,
    "end": 631.5,
    "text": "体现在象征生命之钥的"
  },
  {
    "start": 631.533,
    "end": 632.766,
    "text": "安卡"
  },
  {
    "start": 632.766,
    "end": 634.233,
    "text": "安卡"
  },
  {
    "start": 634.233,
    "end": 636.233,
    "text": "也被称为埃及十字架"
  },
  {
    "start": 636.233,
    "end": 638.199,
    "text": "由三部分组成"
  },
  {
    "start": 638.2,
    "end": 640.9,
    "text": "下方的十字部分象征物质"
  },
  {
    "start": 640.933,
    "end": 645.299,
    "text": "上方的神环（shen loop）象征精神 而中"
  },
  {
    "start": 645.3,
    "end": 649.533,
    "text": "间的交接处神结（shen knot）则代表呼吸"
  },
  {
    "start": 649.566,
    "end": 651.733,
    "text": "埃及炼金术认为"
  },
  {
    "start": 651.733,
    "end": 653.799,
    "text": "只要我们仍在呼吸"
  },
  {
    "start": 653.833,
    "end": 656.866,
    "text": "灵魂便与肉体紧密相连"
  },
  {
    "start": 656.9,
    "end": 658.133,
    "text": "然而"
  },
  {
    "start": 658.166,
    "end": 662.333,
    "text": "当神结松开 呼吸停止或变得极浅时"
  },
  {
    "start": 662.333,
    "end": 664.499,
    "text": "意识便可穿越时间"
  },
  {
    "start": 664.5,
    "end": 666.633,
    "text": "进入永恒的精神维度"
  },
  {
    "start": 666.666,
    "end": 668.366,
    "text": "我们再次看到"
  },
  {
    "start": 668.4,
    "end": 669.766,
    "text": "不同炼金术体系中"
  },
  {
    "start": 669.766,
    "end": 672.366,
    "text": "会反复出现相似的观点"
  },
  {
    "start": 672.4,
    "end": 674.966,
    "text": "我觉得很有趣的一点是"
  },
  {
    "start": 674.966,
    "end": 678.499,
    "text": "道家用神来指代精神（spirit）"
  },
  {
    "start": 678.5,
    "end": 681.1,
    "text": "埃及人也同样使用神这个词"
  },
  {
    "start": 681.133,
    "end": 683.066,
    "text": "来代表精神维度"
  },
  {
    "start": 683.1,
    "end": 686.0,
    "text": "我不确定这是翻译上的巧合"
  },
  {
    "start": 686.0,
    "end": 687.733,
    "text": "还是两种古老文明之间"
  },
  {
    "start": 687.766,
    "end": 690.533,
    "text": "确实存在某种深层联系"
  },
  {
    "start": 690.533,
    "end": 694.366,
    "text": "但这无疑是一个值得深思的现象"
  },
  {
    "start": 694.366,
    "end": 695.166,
    "text": "现在"
  },
  {
    "start": 695.166,
    "end": 695.699,
    "text": "267 00:11:35,733 --> 00:11:41,199 让我们回到思想 时间与呼吸的悖论这一主题"
  },
  {
    "start": 701.2,
    "end": 703.7,
    "text": "作为一名心理治疗师"
  },
  {
    "start": 703.733,
    "end": 710.833,
    "text": "我曾从事心理神经免疫学的研究（即我们的思想和情感如何影响免疫系统）"
  },
  {
    "start": 710.833,
    "end": 711.433,
    "text": "因此"
  },
  {
    "start": 711.433,
    "end": 713.833,
    "text": "我也从身心健康的角度"
  },
  {
    "start": 713.866,
    "end": 717.166,
    "text": "对时间悖论产生了浓厚的兴趣"
  },
  {
    "start": 717.2,
    "end": 718.066,
    "text": "有一项"
  },
  {
    "start": 718.1,
    "end": 720.266,
    "text": "研究观察了因心脏骤停"
  },
  {
    "start": 720.3,
    "end": 722.5,
    "text": "被紧急送医的患者"
  },
  {
    "start": 722.5,
    "end": 724.2,
    "text": "揭示了身体与心理之间"
  },
  {
    "start": 724.233,
    "end": 727.299,
    "text": "一些相互作用的有趣现象"
  },
  {
    "start": 727.3,
    "end": 728.266,
    "text": "在康复"
  },
  {
    "start": 728.266,
    "end": 729.133,
    "text": "期间"
  },
  {
    "start": 729.166,
    "end": 730.866,
    "text": "研究人员询问这些患者"
  },
  {
    "start": 730.866,
    "end": 733.233,
    "text": "关于时间感知的问题"
  },
  {
    "start": 733.266,
    "end": 734.866,
    "text": "结果显示"
  },
  {
    "start": 734.866,
    "end": 736.866,
    "text": "仅凭他们对时间的态度"
  },
  {
    "start": 736.866,
    "end": 740.499,
    "text": "就能大致预测哪些患者会顺利康复"
  },
  {
    "start": 740.533,
    "end": 744.733,
    "text": "哪些则会有更高风险再次心脏骤停"
  },
  {
    "start": 744.733,
    "end": 748.399,
    "text": "那些表示自己正在放松心情照顾自己"
  },
  {
    "start": 748.433,
    "end": 752.799,
    "text": "并认为有充足的时间完成需要完成之事的患者"
  },
  {
    "start": 752.8,
    "end": 754.7,
    "text": "他们更可能康复"
  },
  {
    "start": 754.7,
    "end": 757.233,
    "text": "并避免再次心脏病发作"
  },
  {
    "start": 757.266,
    "end": 758.666,
    "text": "相反"
  },
  {
    "start": 758.7,
    "end": 761.133,
    "text": "那些表示自己面临巨大压力"
  },
  {
    "start": 761.133,
    "end": 763.433,
    "text": "心中有许多未完成之事"
  },
  {
    "start": 763.466,
    "end": 766.499,
    "text": "并感觉时间不多了的患者"
  },
  {
    "start": 766.5,
    "end": 769.5,
    "text": "则往往面临更高的死亡风险"
  },
  {
    "start": 769.533,
    "end": 770.199,
    "text": "对于一"
  },
  {
    "start": 770.2,
    "end": 772.166,
    "text": "位道家修行者来说"
  },
  {
    "start": 772.166,
    "end": 774.766,
    "text": "这些研究发现并不令人意外"
  },
  {
    "start": 774.8,
    "end": 777.066,
    "text": "从道家的角度来看"
  },
  {
    "start": 777.066,
    "end": 779.566,
    "text": "现代社会快节奏的生活方式"
  },
  {
    "start": 779.6,
    "end": 781.433,
    "text": "不仅损害身体健康"
  },
  {
    "start": 781.466,
    "end": 783.466,
    "text": "也妨碍精神修行"
  },
  {
    "start": 783.466,
    "end": 784.333,
    "text": "如果仔"
  },
  {
    "start": 784.366,
    "end": 786.699,
    "text": "细推敲这项研究的背后逻辑"
  },
  {
    "start": 786.7,
    "end": 787.9,
    "text": "不难发现"
  },
  {
    "start": 787.9,
    "end": 793.233,
    "text": "它描绘出一个思想 时间与呼吸之间循环互动"
  },
  {
    "start": 793.266,
    "end": 797.233,
    "text": "悖论式的三角关系 首先"
  },
  {
    "start": 797.233,
    "end": 803.533,
    "text": "思想决定我们如何感知时间（时间本质上是主观的） 其次"
  },
  {
    "start": 803.533,
    "end": 804.999,
    "text": "我们对时间的看法"
  },
  {
    "start": 805.0,
    "end": 807.866,
    "text": "又会影响身体健康 而连接"
  },
  {
    "start": 807.9,
    "end": 810.733,
    "text": "思想与时间的那条无形丝线"
  },
  {
    "start": 810.733,
    "end": 812.999,
    "text": "就是呼吸的节奏"
  },
  {
    "start": 813.033,
    "end": 813.966,
    "text": "举例来"
  },
  {
    "start": 813.966,
    "end": 814.833,
    "text": "说"
  },
  {
    "start": 814.833,
    "end": 818.233,
    "text": "我们的大脑（思想）认为时间不够"
  },
  {
    "start": 818.266,
    "end": 819.633,
    "text": "想加快进度"
  },
  {
    "start": 819.666,
    "end": 821.899,
    "text": "但这种紧迫感的心理"
  },
  {
    "start": 821.933,
    "end": 825.599,
    "text": "反而让我们压力加剧 呼吸变急促"
  },
  {
    "start": 825.6,
    "end": 826.8,
    "text": "结果"
  },
  {
    "start": 826.8,
    "end": 829.166,
    "text": "身体进入持续紧绷状态"
  },
  {
    "start": 829.2,
    "end": 830.533,
    "text": "更易生病"
  },
  {
    "start": 830.533,
    "end": 832.099,
    "text": "可反过来"
  },
  {
    "start": 832.1,
    "end": 835.833,
    "text": "当我们慢下来 放松 呼吸平稳时"
  },
  {
    "start": 835.866,
    "end": 838.333,
    "text": "反而感到时间变多了"
  },
  {
    "start": 838.366,
    "end": 840.799,
    "text": "身体也随之恢复健康"
  },
  {
    "start": 840.8,
    "end": 842.0,
    "text": "因此"
  },
  {
    "start": 842.033,
    "end": 843.566,
    "text": "我们需要定期"
  },
  {
    "start": 843.6,
    "end": 846.633,
    "text": "让被时间束缚的心灵回归宁静"
  },
  {
    "start": 846.633,
    "end": 848.233,
    "text": "放慢生活的节奏"
  },
  {
    "start": 848.266,
    "end": 849.666,
    "text": "放缓呼吸"
  },
  {
    "start": 849.7,
    "end": 850.933,
    "text": "否则"
  },
  {
    "start": 850.966,
    "end": 852.833,
    "text": "我们将不可避免地受到"
  },
  {
    "start": 852.833,
    "end": 855.699,
    "text": "现代生活沉重压力的影响"
  },
  {
    "start": 855.7,
    "end": 856.433,
    "text": "为了"
  },
  {
    "start": 856.433,
    "end": 856.566,
    "text": "帮"
  },
  {
    "start": 856.6,
    "end": 858.566,
    "text": "助人们缓解身心压力"
  },
  {
    "start": 858.6,
    "end": 860.266,
    "text": "我曾向成百上千的人"
  },
  {
    "start": 860.3,
    "end": 863.266,
    "text": "教授一种简单的道家静坐法"
  },
  {
    "start": 863.266,
    "end": 867.566,
    "text": "几乎所有人都对这种快速而简单的冥想方法"
  },
  {
    "start": 867.6,
    "end": 869.9,
    "text": "表示深深的赞赏"
  },
  {
    "start": 869.933,
    "end": 873.099,
    "text": "尤其是那些长期被内在对话困扰"
  },
  {
    "start": 873.1,
    "end": 875.466,
    "text": "难以进入冥想状态的人"
  },
  {
    "start": 875.466,
    "end": 877.433,
    "text": "特别感激这种方法"
  },
  {
    "start": 877.433,
    "end": 878.166,
    "text": "与许多"
  },
  {
    "start": 878.2,
    "end": 881.1,
    "text": "强调清除杂念的冥想方法不同"
  },
  {
    "start": 881.1,
    "end": 882.6,
    "text": "这种道家静修法门"
  },
  {
    "start": 882.633,
    "end": 885.333,
    "text": "并不强求思想的彻底静止"
  },
  {
    "start": 885.333,
    "end": 887.966,
    "text": "反而允许念头自由来去"
  },
  {
    "start": 888.0,
    "end": 889.733,
    "text": "思想的存在"
  },
  {
    "start": 889.733,
    "end": 891.766,
    "text": "不但不会干扰修行"
  },
  {
    "start": 891.8,
    "end": 894.566,
    "text": "反而被纳入修行的一部分"
  },
  {
    "start": 894.566,
    "end": 895.666,
    "text": "暮雨注"
  },
  {
    "start": 895.666,
    "end": 896.333,
    "text": "353 00:14:56,366 --> 00:14:58,166 关于冥想的本质"
  },
  {
    "start": 898.2,
    "end": 902.266,
    "text": "克里希那穆提曾提出过值得参考的见解"
  },
  {
    "start": 902.3,
    "end": 903.666,
    "text": "他强调"
  },
  {
    "start": 903.666,
    "end": 905.399,
    "text": "真正的静心冥想"
  },
  {
    "start": 905.433,
    "end": 909.099,
    "text": "不能只是依循刻板的步骤或权威教条"
  },
  {
    "start": 909.133,
    "end": 911.033,
    "text": "它必须建立在对自我"
  },
  {
    "start": 911.033,
    "end": 914.033,
    "text": "与自我欲望的深刻理解之上"
  },
  {
    "start": 914.033,
    "end": 916.166,
    "text": "他说 若是"
  },
  {
    "start": 916.2,
    "end": 918.433,
    "text": "不了解欲望的运作轨迹"
  },
  {
    "start": 918.466,
    "end": 922.599,
    "text": "静心冥想是无法引导一个人真正开悟的"
  },
  {
    "start": 922.6,
    "end": 925.833,
    "text": "即使是那些认为自己已发现了真理"
  },
  {
    "start": 925.866,
    "end": 927.499,
    "text": "理解了神的人"
  },
  {
    "start": 927.533,
    "end": 930.333,
    "text": "只要他们对内在潜藏的执念"
  },
  {
    "start": 930.366,
    "end": 933.633,
    "text": "欲望 恐惧仍然无知无觉"
  },
  {
    "start": 933.633,
    "end": 936.033,
    "text": "就不可能认识真理"
  },
  {
    "start": 936.033,
    "end": 936.866,
    "text": "他进一"
  },
  {
    "start": 936.9,
    "end": 938.8,
    "text": "步指出 如果"
  },
  {
    "start": 938.8,
    "end": 941.466,
    "text": "我们能了解自己在日常生活中"
  },
  {
    "start": 941.5,
    "end": 944.1,
    "text": "所有愚钝的言语 行动"
  },
  {
    "start": 944.1,
    "end": 945.533,
    "text": "起心动念"
  },
  {
    "start": 945.566,
    "end": 947.833,
    "text": "对待他人的方式和态度"
  },
  {
    "start": 947.833,
    "end": 948.999,
    "text": "那么这份觉知"
  },
  {
    "start": 949.033,
    "end": 951.333,
    "text": "就会破解我们的愚钝"
  },
  {
    "start": 951.333,
    "end": 953.166,
    "text": "因此重点在于"
  },
  {
    "start": 953.2,
    "end": 954.0,
    "text": "了解"
  },
  {
    "start": 954.0,
    "end": 954.733,
    "text": "内观"
  },
  {
    "start": 954.733,
    "end": 956.099,
    "text": "觉察"
  },
  {
    "start": 956.1,
    "end": 956.933,
    "text": "这种观"
  },
  {
    "start": 956.966,
    "end": 960.399,
    "text": "念恰恰与道家静修的精神不谋而合——"
  },
  {
    "start": 960.433,
    "end": 962.533,
    "text": "不是强行压制头脑活动"
  },
  {
    "start": 962.566,
    "end": 966.166,
    "text": "而是在思绪的自然流动中培养觉察力"
  },
  {
    "start": 966.166,
    "end": 966.866,
    "text": "我认为"
  },
  {
    "start": 966.9,
    "end": 969.4,
    "text": "这个冥想方法非常有效"
  },
  {
    "start": 969.4,
    "end": 971.166,
    "text": "又具包容性"
  },
  {
    "start": 971.2,
    "end": 972.266,
    "text": "因此"
  },
  {
    "start": 972.266,
    "end": 975.933,
    "text": "我在下面简要介绍了如何进行这种冥想"
  },
  {
    "start": 975.933,
    "end": 977.233,
    "text": "天门冥"
  },
  {
    "start": 977.233,
    "end": 978.133,
    "text": "想练习"
  },
  {
    "start": 978.166,
    "end": 982.033,
    "text": "是一种基于龙穴的道教静修方式"
  },
  {
    "start": 982.033,
    "end": 983.866,
    "text": "如前所述"
  },
  {
    "start": 983.9,
    "end": 987.0,
    "text": "龙穴是不同类型的气汇聚之处"
  },
  {
    "start": 987.0,
    "end": 990.733,
    "text": "人体中也存在多个这样的能量中心"
  },
  {
    "start": 990.766,
    "end": 993.966,
    "text": "而天门正是其中之一"
  },
  {
    "start": 994.0,
    "end": 999.233,
    "text": "天门是天之气（一种极微妙的能量）流入人体"
  },
  {
    "start": 999.233,
    "end": 1002.333,
    "text": "并与人体本身的地之气交汇的入口"
  },
  {
    "start": 1002.366,
    "end": 1005.533,
    "text": "这个部位蕴藏着强大的能量"
  },
  {
    "start": 1005.533,
    "end": 1008.699,
    "text": "道家先贤早已发现并学会如何"
  },
  {
    "start": 1008.7,
    "end": 1011.433,
    "text": "借助天门的能量进行修炼"
  },
  {
    "start": 1011.433,
    "end": 1012.566,
    "text": "下面"
  },
  {
    "start": 1012.566,
    "end": 1016.099,
    "text": "是具体的冥想步骤  请以舒"
  },
  {
    "start": 1016.1,
    "end": 1017.333,
    "text": "适的姿势坐好"
  },
  {
    "start": 1017.366,
    "end": 1018.566,
    "text": "闭上眼睛"
  },
  {
    "start": 1018.6,
    "end": 1020.1,
    "text": "如果你愿意"
  },
  {
    "start": 1020.1,
    "end": 1021.833,
    "text": "也可以选择躺下"
  },
  {
    "start": 1021.866,
    "end": 1024.466,
    "text": "不过有些人容易因此睡着"
  },
  {
    "start": 1024.466,
    "end": 1025.399,
    "text": "先花一"
  },
  {
    "start": 1025.433,
    "end": 1026.333,
    "text": "点时间"
  },
  {
    "start": 1026.366,
    "end": 1028.233,
    "text": "觉察自己的呼吸"
  },
  {
    "start": 1028.233,
    "end": 1030.133,
    "text": "不要刻意去控制"
  },
  {
    "start": 1030.133,
    "end": 1031.999,
    "text": "只是静静地观察它"
  },
  {
    "start": 1032.033,
    "end": 1035.166,
    "text": "感受呼吸的节奏与深浅"
  },
  {
    "start": 1035.2,
    "end": 1036.133,
    "text": "几分钟"
  },
  {
    "start": 1036.133,
    "end": 1036.899,
    "text": "后"
  },
  {
    "start": 1036.9,
    "end": 1042.9,
    "text": "请将注意力转向鼻梁后方约一英寸（约2.54厘米）的空间"
  },
  {
    "start": 1042.9,
    "end": 1047.5,
    "text": "想象这个区域有一个约一平方英寸的能量开口"
  },
  {
    "start": 1047.5,
    "end": 1050.466,
    "text": "这个点就是你的天门"
  },
  {
    "start": 1050.5,
    "end": 1051.433,
    "text": "接下来"
  },
  {
    "start": 1051.433,
    "end": 1052.266,
    "text": "你要做的"
  },
  {
    "start": 1052.3,
    "end": 1055.733,
    "text": "就是把注意力轻轻地放在这个点上"
  },
  {
    "start": 1055.733,
    "end": 1057.633,
    "text": "不必刻意用力"
  },
  {
    "start": 1057.633,
    "end": 1059.966,
    "text": "避免过度控制和紧张"
  },
  {
    "start": 1060.0,
    "end": 1062.433,
    "text": "只需轻松地意识到它即可"
  },
  {
    "start": 1062.433,
    "end": 1063.266,
    "text": "如果脑"
  },
  {
    "start": 1063.3,
    "end": 1065.7,
    "text": "海中浮现了许多念头或幻想"
  },
  {
    "start": 1065.7,
    "end": 1067.333,
    "text": "不要试图压制它们"
  },
  {
    "start": 1067.366,
    "end": 1069.233,
    "text": "让它们自然流动"
  },
  {
    "start": 1069.233,
    "end": 1070.933,
    "text": "只需保留一部分注意力"
  },
  {
    "start": 1070.966,
    "end": 1073.466,
    "text": "继续轻轻放在天门上"
  },
  {
    "start": 1073.466,
    "end": 1076.199,
    "text": "你可以放心地思考任何事情"
  },
  {
    "start": 1076.2,
    "end": 1078.633,
    "text": "这个练习依然有效"
  },
  {
    "start": 1078.666,
    "end": 1080.666,
    "text": "只要你的一部分觉知"
  },
  {
    "start": 1080.7,
    "end": 1082.5,
    "text": "仍与天门相连"
  },
  {
    "start": 1082.5,
    "end": 1083.6,
    "text": "随着专"
  },
  {
    "start": 1083.6,
    "end": 1084.733,
    "text": "注的持续"
  },
  {
    "start": 1084.766,
    "end": 1087.433,
    "text": "你会注意到 思绪慢了下来"
  },
  {
    "start": 1087.433,
    "end": 1089.699,
    "text": "念头之间的空隙变大"
  },
  {
    "start": 1089.733,
    "end": 1090.833,
    "text": "最终"
  },
  {
    "start": 1090.833,
    "end": 1092.666,
    "text": "可能会有一段时间"
  },
  {
    "start": 1092.7,
    "end": 1095.233,
    "text": "思想会完全停止"
  },
  {
    "start": 1095.233,
    "end": 1098.066,
    "text": "正是在这种深度静止的时刻"
  },
  {
    "start": 1098.1,
    "end": 1101.7,
    "text": "你可能会察觉自己的呼吸已变得非常浅"
  },
  {
    "start": 1101.7,
    "end": 1103.8,
    "text": "甚至暂时停止"
  },
  {
    "start": 1103.833,
    "end": 1105.466,
    "text": "不用担心"
  },
  {
    "start": 1105.5,
    "end": 1107.066,
    "text": "这是自然反应"
  },
  {
    "start": 1107.066,
    "end": 1110.466,
    "text": "代表你已进入一种更深的宁静状态"
  },
  {
    "start": 1110.466,
    "end": 1112.866,
    "text": "也正是在这种状态中"
  },
  {
    "start": 1112.866,
    "end": 1113.966,
    "text": "没有思想"
  },
  {
    "start": 1114.0,
    "end": 1115.033,
    "text": "没有呼吸"
  },
  {
    "start": 1115.033,
    "end": 1118.033,
    "text": "与道的接触悄然发生了"
  },
  {
    "start": 1118.066,
    "end": 1119.066,
    "text": "通常冥"
  },
  {
    "start": 1119.066,
    "end": 1120.466,
    "text": "想大约五分钟后"
  },
  {
    "start": 1120.466,
    "end": 1123.333,
    "text": "就可以明显感知到意识的改变"
  },
  {
    "start": 1123.366,
    "end": 1125.099,
    "text": "随着练习的深入"
  },
  {
    "start": 1125.133,
    "end": 1127.699,
    "text": "你可以逐渐延长冥想时间"
  },
  {
    "start": 1127.7,
    "end": 1130.466,
    "text": "体验更深层的内在寂静"
  },
  {
    "start": 1130.466,
    "end": 1131.233,
    "text": "别被它"
  },
  {
    "start": 1131.233,
    "end": 1134.166,
    "text": "的简单性误导——天门冥想法"
  },
  {
    "start": 1134.2,
    "end": 1136.866,
    "text": "是一种深奥的静心练习"
  },
  {
    "start": 1136.866,
    "end": 1138.699,
    "text": "它能直接带你接触"
  },
  {
    "start": 1138.733,
    "end": 1139.733,
    "text": "道"
  },
  {
    "start": 1139.733,
    "end": 1143.566,
    "text": "随着你与这种深层的宁静日渐熟悉"
  },
  {
    "start": 1143.566,
    "end": 1146.699,
    "text": "你甚至可能在你探索内在世界的过程中"
  },
  {
    "start": 1146.733,
    "end": 1148.833,
    "text": "遇见天界的存有"
  },
  {
    "start": 1148.833,
    "end": 1152.366,
    "text": "他们会以某种方式给予你教导和指引"
  },
  {
    "start": 1152.4,
    "end": 1153.4,
    "text": "在道家"
  },
  {
    "start": 1153.4,
    "end": 1154.566,
    "text": "思想中"
  },
  {
    "start": 1154.566,
    "end": 1157.099,
    "text": "最深奥的秘密只有通过"
  },
  {
    "start": 1157.133,
    "end": 1159.333,
    "text": "道本身才能揭示"
  },
  {
    "start": 1159.333,
    "end": 1162.466,
    "text": "你无法从书籍中找到这些真理"
  },
  {
    "start": 1162.466,
    "end": 1164.233,
    "text": "因为禁止写下它们"
  },
  {
    "start": 1164.266,
    "end": 1165.533,
    "text": "因此"
  },
  {
    "start": 1165.566,
    "end": 1167.833,
    "text": "像天门冥想这样的修行"
  },
  {
    "start": 1167.833,
    "end": 1171.166,
    "text": "犹如一把开启宇宙之门的钥匙"
  },
  {
    "start": 1171.166,
    "end": 1172.366,
    "text": "然而"
  },
  {
    "start": 1172.4,
    "end": 1173.833,
    "text": "就像钥匙一样"
  },
  {
    "start": 1173.866,
    "end": 1176.633,
    "text": "你必须转动它才能打开锁"
  },
  {
    "start": 1176.633,
    "end": 1178.766,
    "text": "如果你想亲身体验"
  },
  {
    "start": 1178.8,
    "end": 1180.2,
    "text": "道的奥秘"
  },
  {
    "start": 1180.2,
    "end": 1182.866,
    "text": "而不仅仅是,阅读它们"
  },
  {
    "start": 1182.866,
    "end": 1183.699,
    "text": "你必须"
  },
  {
    "start": 1183.733,
    "end": 1184.833,
    "text": "转动这把"
  },
  {
    "start": 1184.833,
    "end": 1187.766,
    "text": "钥匙"
  }
]