[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "显化的关键秘密"
  },
  {
    "start": 4.9,
    "end": 6.97,
    "text": "当你产生连贯的情感"
  },
  {
    "start": 6.97,
    "end": 10.57,
    "text": "并将其与思想或意图结合起来时"
  },
  {
    "start": 10.57,
    "end": 14.0,
    "text": "你就创造出了一种类似激光般的力量"
  },
  {
    "start": 14.0,
    "end": 16.42,
    "text": "它可以影响量子领域"
  },
  {
    "start": 16.42,
    "end": 18.46,
    "text": "甚至你的外部现实"
  },
  {
    "start": 18.46,
    "end": 20.09,
    "text": "上一集"
  },
  {
    "start": 20.09,
    "end": 23.71,
    "text": "我们详细介绍了创造与显化的具体方法"
  },
  {
    "start": 23.71,
    "end": 27.53,
    "text": "这是由来自另一个宇宙的外星种族"
  },
  {
    "start": 27.53,
    "end": 29.47,
    "text": "曾经影响了古埃及文明的"
  },
  {
    "start": 29.47,
    "end": 31.58,
    "text": "哈索尔人提供的信息"
  },
  {
    "start": 31.58,
    "end": 34.12,
    "text": "开始本集内容之前"
  },
  {
    "start": 34.12,
    "end": 38.68,
    "text": "我们先简单回顾一下哈索尔人介绍的显化步骤"
  },
  {
    "start": 38.68,
    "end": 40.14,
    "text": "第一步"
  },
  {
    "start": 40.14,
    "end": 43.87,
    "text": "将你的意识集中在你的太阳神经丛脉轮"
  },
  {
    "start": 43.87,
    "end": 46.12,
    "text": "想象一个球体"
  },
  {
    "start": 46.12,
    "end": 49.01,
    "text": "球的中心是你的太阳神经丛"
  },
  {
    "start": 49.01,
    "end": 52.49,
    "text": "这个球体的表面布满无数光点"
  },
  {
    "start": 52.49,
    "end": 55.74,
    "text": "由此你激活了“所有可能性的球体”"
  },
  {
    "start": 55.74,
    "end": 57.35,
    "text": "第二步"
  },
  {
    "start": 57.35,
    "end": 59.16,
    "text": "连接你的未来自我"
  },
  {
    "start": 59.16,
    "end": 62.2,
    "text": "想象你渴望体验的现实"
  },
  {
    "start": 62.2,
    "end": 63.57,
    "text": "然后"
  },
  {
    "start": 63.57,
    "end": 67.0,
    "text": "将这个想象中的未来自我放在你面前"
  },
  {
    "start": 67.0,
    "end": 69.85,
    "text": "一条直线从你的太阳神经丛"
  },
  {
    "start": 69.85,
    "end": 73.11,
    "text": "延伸至这个未来自我的太阳神经丛"
  },
  {
    "start": 73.11,
    "end": 77.34,
    "text": "你未来的自我将作为一个“磁性吸引体”"
  },
  {
    "start": 77.34,
    "end": 79.77,
    "text": "为你吸引来自宇宙之外"
  },
  {
    "start": 79.77,
    "end": 82.51,
    "text": "超越你时间线的资源和能量"
  },
  {
    "start": 82.51,
    "end": 86.29,
    "text": "这将增加你生活中的机缘巧合"
  },
  {
    "start": 86.29,
    "end": 90.13,
    "text": "吸引意想不到的人 情况和机会出现"
  },
  {
    "start": 90.13,
    "end": 91.46,
    "text": "第三步"
  },
  {
    "start": 91.46,
    "end": 95.39,
    "text": "运用爱 欣赏 感激的情感振动"
  },
  {
    "start": 95.39,
    "end": 99.22,
    "text": "来加强你的磁性吸引体（即你未来的自我）"
  },
  {
    "start": 99.22,
    "end": 101.14,
    "text": "当你这样做时"
  },
  {
    "start": 101.14,
    "end": 104.43,
    "text": "加快那个现实吸引到你身边的速度"
  },
  {
    "start": 104.43,
    "end": 107.54,
    "text": "意想不到的偶然事件也会增加"
  },
  {
    "start": 107.54,
    "end": 111.29,
    "text": "这一步涉及本集要讨论的重点概念 ——“"
  },
  {
    "start": 111.29,
    "end": 112.82,
    "text": "连贯的情绪能力”"
  },
  {
    "start": 112.82,
    "end": 114.78,
    "text": "对显化过程的影响"
  },
  {
    "start": 114.78,
    "end": 116.72,
    "text": "最后第四步"
  },
  {
    "start": 116.72,
    "end": 118.5,
    "text": "跟随你的灵感"
  },
  {
    "start": 118.5,
    "end": 122.12,
    "text": "在三维世界里采取具体的行动"
  },
  {
    "start": 122.12,
    "end": 124.94,
    "text": "想了解完整的内容"
  },
  {
    "start": 124.94,
    "end": 127.69,
    "text": "请看上集的延伸阅读部分"
  },
  {
    "start": 127.69,
    "end": 129.57,
    "text": "伟大的人类潜能"
  },
  {
    "start": 129.57,
    "end": 132.05,
    "text": "显化的关键秘密"
  },
  {
    "start": 132.05,
    "end": 135.79,
    "text": "现在让我们从“精确的能量学”角度"
  },
  {
    "start": 135.79,
    "end": 136.74,
    "text": "更深入探讨"
  },
  {
    "start": 136.74,
    "end": 138.94,
    "text": "“创造与显化”的主题"
  },
  {
    "start": 138.94,
    "end": 147.54,
    "text": "以下内容引用自《伟大的人类潜能 在自己的光中行走 -来自昴宿星和哈索尔的教导》"
  },
  {
    "start": 147.54,
    "end": 149.82,
    "text": "作者汤姆·肯永"
  },
  {
    "start": 150.82,
    "end": 154.35,
    "text": "随机光和激光  你"
  },
  {
    "start": 154.35,
    "end": 154.64,
    "text": "的人"
  },
  {
    "start": 154.64,
    "end": 156.37,
    "text": "类情感天性"
  },
  {
    "start": 156.37,
    "end": 156.85,
    "text": "会产"
  },
  {
    "start": 156.85,
    "end": 161.22,
    "text": "生和谐或不和谐的能量场（也可称“谐波场”）"
  },
  {
    "start": 161.22,
    "end": 163.24,
    "text": "我们哈索尔将其称之为"
  },
  {
    "start": 163.24,
    "end": 165.75,
    "text": "“连贯和不连贯”的情绪"
  },
  {
    "start": 165.75,
    "end": 168.66,
    "text": "这与光的本质非常类似"
  },
  {
    "start": 168.66,
    "end": 173.13,
    "text": "光存在两种极化形式 随机光和相干光"
  },
  {
    "start": 173.13,
    "end": 174.53,
    "text": "或称激光"
  },
  {
    "start": 174.53,
    "end": 176.79,
    "text": "在正常情况下"
  },
  {
    "start": 176.79,
    "end": 178.09,
    "text": "光子 以"
  },
  {
    "start": 178.09,
    "end": 180.98,
    "text": "一种无序状态漫无目的的运动"
  },
  {
    "start": 180.98,
    "end": 182.72,
    "text": "可以这么说"
  },
  {
    "start": 182.72,
    "end": 185.07,
    "text": "每个光子都有自己的节奏"
  },
  {
    "start": 185.07,
    "end": 186.37,
    "text": "然而"
  },
  {
    "start": 186.37,
    "end": 190.27,
    "text": "激光强迫光子以一种连贯的方式流动"
  },
  {
    "start": 190.27,
    "end": 193.61,
    "text": "这些光子完全与彼此对齐"
  },
  {
    "start": 193.61,
    "end": 196.47,
    "text": "并可以被引导至特定的结果"
  },
  {
    "start": 196.47,
    "end": 198.85,
    "text": "比如穿透尖锐密实的物体"
  },
  {
    "start": 198.85,
    "end": 202.18,
    "text": "或创造出美丽的全息艺术品"
  },
  {
    "start": 202.18,
    "end": 207.65,
    "text": "意识的激光功能 你"
  },
  {
    "start": 207.65,
    "end": 207.98,
    "text": "的感"
  },
  {
    "start": 207.98,
    "end": 209.44,
    "text": "知天性"
  },
  {
    "start": 209.44,
    "end": 210.37,
    "text": "类似于随"
  },
  {
    "start": 210.37,
    "end": 214.36,
    "text": "机光和相干光 （即激光）之间的关系"
  },
  {
    "start": 214.36,
    "end": 216.7,
    "text": "根据我们的观察"
  },
  {
    "start": 216.7,
    "end": 217.31,
    "text": "大多数"
  },
  {
    "start": 217.31,
    "end": 219.47,
    "text": "人发现很难将连贯的思维"
  },
  {
    "start": 219.47,
    "end": 221.79,
    "text": "保持超过几秒钟"
  },
  {
    "start": 221.79,
    "end": 225.62,
    "text": "并且也不知道如何创造“连贯的情绪状态”"
  },
  {
    "start": 225.62,
    "end": 228.39,
    "text": "并将其持续一段可观的时间"
  },
  {
    "start": 228.39,
    "end": 231.19,
    "text": "你的意识以一种非常类似"
  },
  {
    "start": 231.19,
    "end": 233.93,
    "text": "于激光的方式运作"
  },
  {
    "start": 233.93,
    "end": 235.52,
    "text": "然而许多人无法维持"
  },
  {
    "start": 235.52,
    "end": 237.44,
    "text": "他们意识的激光功能"
  },
  {
    "start": 237.44,
    "end": 240.23,
    "text": "人们或许会在短时间内"
  },
  {
    "start": 240.23,
    "end": 243.84,
    "text": "保持一种思维或连贯的情绪"
  },
  {
    "start": 243.84,
    "end": 246.1,
    "text": "但随后思想开始漫游"
  },
  {
    "start": 246.1,
    "end": 248.15,
    "text": "在量子层面"
  },
  {
    "start": 248.15,
    "end": 250.74,
    "text": "光子不再相互对齐"
  },
  {
    "start": 250.74,
    "end": 253.14,
    "text": "它们向四处散开"
  },
  {
    "start": 253.14,
    "end": 255.74,
    "text": "能量逐渐消散"
  },
  {
    "start": 255.74,
    "end": 260.23,
    "text": "激光意识可以影响分"
  },
  {
    "start": 260.23,
    "end": 260.85,
    "text": "子结"
  },
  {
    "start": 260.85,
    "end": 264.18,
    "text": "构我们在很多情况下提到欣"
  },
  {
    "start": 264.18,
    "end": 266.75,
    "text": "赏和感激的重要性"
  },
  {
    "start": 266.75,
    "end": 269.92,
    "text": "这是因为在你的人类感知天性中"
  },
  {
    "start": 269.92,
    "end": 273.96,
    "text": "有产生类似激光般连贯振动模式的能力"
  },
  {
    "start": 273.96,
    "end": 277.66,
    "text": "这些情感所产生的振动模式"
  },
  {
    "start": 277.66,
    "end": 280.45,
    "text": "能够影响量子层面的现实"
  },
  {
    "start": 280.45,
    "end": 282.27,
    "text": "换句话说"
  },
  {
    "start": 282.27,
    "end": 283.72,
    "text": "你的感知天性"
  },
  {
    "start": 283.72,
    "end": 288.57,
    "text": "可以影响亚原子粒子和亚原子力量的组织排列"
  },
  {
    "start": 288.57,
    "end": 291.81,
    "text": "并会影响分子结构的诞生和破灭 ——"
  },
  {
    "start": 291.81,
    "end": 293.51,
    "text": "这种影响力"
  },
  {
    "start": 293.51,
    "end": 296.26,
    "text": "无论是在你体内还是在外部环境的"
  },
  {
    "start": 296.26,
    "end": 298.99,
    "text": "特定条件之下都能产生"
  },
  {
    "start": 298.99,
    "end": 300.18,
    "text": "我们提醒你"
  },
  {
    "start": 300.18,
    "end": 303.32,
    "text": "认识到自己内在潜能的重要性"
  },
  {
    "start": 303.32,
    "end": 307.73,
    "text": "这种力量取决于你感受连贯情绪的能力"
  },
  {
    "start": 307.73,
    "end": 310.29,
    "text": "当你产生连贯的情感"
  },
  {
    "start": 310.29,
    "end": 314.07,
    "text": "并将其与思想或意图结合起来时"
  },
  {
    "start": 314.07,
    "end": 317.37,
    "text": "你就创造出了一种类似激光般的力量"
  },
  {
    "start": 317.37,
    "end": 319.58,
    "text": "它可以影响量子领域"
  },
  {
    "start": 319.58,
    "end": 321.63,
    "text": "甚至你的外部现实"
  },
  {
    "start": 321.63,
    "end": 324.73,
    "text": "当你处于连贯的情感中时"
  },
  {
    "start": 324.73,
    "end": 326.85,
    "text": "比如欣赏或感激"
  },
  {
    "start": 326.85,
    "end": 329.3,
    "text": "正如我们在上一集提到的"
  },
  {
    "start": 329.3,
    "end": 331.65,
    "text": "你创造了一个磁性吸引体"
  },
  {
    "start": 331.65,
    "end": 335.06,
    "text": "这种磁性吸引体对我们来说"
  },
  {
    "start": 335.06,
    "end": 337.05,
    "text": "是非常迷人的结构"
  },
  {
    "start": 337.05,
    "end": 339.86,
    "text": "它们不仅出现在科技中"
  },
  {
    "start": 339.86,
    "end": 343.2,
    "text": "也出现在人际关系的互动中"
  },
  {
    "start": 343.2,
    "end": 348.14,
    "text": "你既是光又是物质"
  },
  {
    "start": 348.14,
    "end": 350.57,
    "text": "在光与物质的转化中"
  },
  {
    "start": 350.57,
    "end": 353.81,
    "text": "使改变发生在这个时刻"
  },
  {
    "start": 353.81,
    "end": 354.79,
    "text": "我们希望更"
  },
  {
    "start": 354.79,
    "end": 358.45,
    "text": "深入讨论关于通过连贯的情绪"
  },
  {
    "start": 358.45,
    "end": 361.96,
    "text": "来实现积极结果的更微妙层面的观点"
  },
  {
    "start": 361.96,
    "end": 364.23,
    "text": "你的身体构成中"
  },
  {
    "start": 364.23,
    "end": 364.76,
    "text": "物质与"
  },
  {
    "start": 364.76,
    "end": 366.47,
    "text": "光的关系是动态的"
  },
  {
    "start": 366.47,
    "end": 368.9,
    "text": "你既是光又是物质"
  },
  {
    "start": 368.9,
    "end": 371.8,
    "text": "尽管你可能未曾意识到这一点"
  },
  {
    "start": 371.8,
    "end": 373.84,
    "text": "但在你的身体内部"
  },
  {
    "start": 373.84,
    "end": 375.78,
    "text": "光不断地转化为物质"
  },
  {
    "start": 375.78,
    "end": 378.39,
    "text": "而物质又不断地转化回光"
  },
  {
    "start": 378.39,
    "end": 379.74,
    "text": "然而"
  },
  {
    "start": 379.74,
    "end": 381.17,
    "text": "利用光和物质之间"
  },
  {
    "start": 381.17,
    "end": 383.54,
    "text": "的这些转化状态"
  },
  {
    "start": 383.54,
    "end": 385.48,
    "text": "可以带来巨大的潜力"
  },
  {
    "start": 385.48,
    "end": 389.16,
    "text": "虽然有意识地影响从光到物质"
  },
  {
    "start": 389.16,
    "end": 392.09,
    "text": "以及物质回到光的转变过程"
  },
  {
    "start": 392.09,
    "end": 393.75,
    "text": "可能过于复杂"
  },
  {
    "start": 393.75,
    "end": 397.35,
    "text": "但当你创造磁性吸引体时"
  },
  {
    "start": 397.35,
    "end": 399.34,
    "text": "这些过程会自然发生"
  },
  {
    "start": 399.34,
    "end": 401.58,
    "text": "基于我们对这些能量原理"
  },
  {
    "start": 401.58,
    "end": 402.88,
    "text": "的理解"
  },
  {
    "start": 402.88,
    "end": 405.24,
    "text": "掌握产生连贯情绪的能力"
  },
  {
    "start": 405.24,
    "end": 406.86,
    "text": "会对你大有裨益"
  },
  {
    "start": 406.86,
    "end": 410.03,
    "text": "掌握创造连贯性的能力"
  },
  {
    "start": 410.03,
    "end": 411.97,
    "text": "使您能够改善和增强"
  },
  {
    "start": 411.97,
    "end": 415.88,
    "text": "身体和心灵的内部生态 （即使疗愈发生）"
  },
  {
    "start": 415.88,
    "end": 420.86,
    "text": "它还允许您以更高的准确性和更好的结果"
  },
  {
    "start": 420.86,
    "end": 423.66,
    "text": "来设计积极的结果"
  },
  {
    "start": 423.66,
    "end": 426.6,
    "text": "【暮雨·注】 翻译到最"
  },
  {
    "start": 426.6,
    "end": 427.71,
    "text": "后一段"
  },
  {
    "start": 427.71,
    "end": 428.34,
    "text": "我突然"
  },
  {
    "start": 428.34,
    "end": 429.68,
    "text": "意识到"
  },
  {
    "start": 429.68,
    "end": 432.88,
    "text": "这种光与物质的无尽转化状态"
  },
  {
    "start": 432.88,
    "end": 435.03,
    "text": "实际上是促成疗愈"
  },
  {
    "start": 435.03,
    "end": 437.11,
    "text": "促使改变发生的机会"
  },
  {
    "start": 437.11,
    "end": 441.7,
    "text": "这意味着我们永远可以在当下做出选择 ——"
  },
  {
    "start": 441.7,
    "end": 444.14,
    "text": "在物质转化回光时"
  },
  {
    "start": 444.14,
    "end": 448.8,
    "text": "选择放下和释放 在光转化回物质时"
  },
  {
    "start": 448.8,
    "end": 451.12,
    "text": "选择创造更积极"
  },
  {
    "start": 451.12,
    "end": 452.87,
    "text": "更慈悲的结果"
  },
  {
    "start": 452.87,
    "end": 455.25,
    "text": "这就像呼吸一样"
  },
  {
    "start": 455.25,
    "end": 457.19,
    "text": "这是宇宙的呼吸"
  },
  {
    "start": 457.19,
    "end": 460.86,
    "text": "这一设计实在太美妙 太伟大"
  },
  {
    "start": 460.86,
    "end": 467.0,
    "text": "让人不禁感动于源头对众生的慈悲"
  },
  {
    "start": 469.0,
    "end": 473.19,
    "text": "【名词解释】谐波"
  },
  {
    "start": 473.19,
    "end": 474.03,
    "text": "想象"
  },
  {
    "start": 474.03,
    "end": 474.91,
    "text": "一下"
  },
  {
    "start": 474.91,
    "end": 475.53,
    "text": "你在弹"
  },
  {
    "start": 475.53,
    "end": 476.64,
    "text": "吉他弦"
  },
  {
    "start": 476.64,
    "end": 479.81,
    "text": "当你弹出一个音符C时"
  },
  {
    "start": 479.81,
    "end": 482.29,
    "text": "弦开始振动并发出声音"
  },
  {
    "start": 482.29,
    "end": 484.45,
    "text": "这个声音实际上是由"
  },
  {
    "start": 484.45,
    "end": 487.35,
    "text": "不同频率（音高）的C音符组成的"
  },
  {
    "start": 487.35,
    "end": 490.15,
    "text": "最低的声音是你弹出的那"
  },
  {
    "start": 490.15,
    "end": 491.7,
    "text": "个音符"
  },
  {
    "start": 491.7,
    "end": 492.79,
    "text": "它是基波"
  },
  {
    "start": 492.79,
    "end": 493.87,
    "text": "但是"
  },
  {
    "start": 493.87,
    "end": 497.25,
    "text": "还有一些更高频率（C的高音）的声音"
  },
  {
    "start": 497.25,
    "end": 500.12,
    "text": "它们也与这个音符一起发出"
  },
  {
    "start": 500.12,
    "end": 503.6,
    "text": "但它们的频率是基本音符频率的整数倍"
  },
  {
    "start": 503.6,
    "end": 506.57,
    "text": "这些额外的声音就是谐波"
  },
  {
    "start": 506.57,
    "end": 508.34,
    "text": "具体来说"
  },
  {
    "start": 508.34,
    "end": 509.29,
    "text": "第一个谐波可"
  },
  {
    "start": 509.29,
    "end": 511.87,
    "text": "能是C音符频率的两倍"
  },
  {
    "start": 511.87,
    "end": 514.69,
    "text": "接着是C音符频率的三倍"
  },
  {
    "start": 514.69,
    "end": 515.62,
    "text": "四倍"
  },
  {
    "start": 515.62,
    "end": 516.98,
    "text": "依此类推"
  },
  {
    "start": 516.98,
    "end": 518.41,
    "text": "这些谐波一起"
  },
  {
    "start": 518.41,
    "end": 521.68,
    "text": "产生了吉他声音的独特音色"
  },
  {
    "start": 521.68,
    "end": 525.79,
    "text": "让你可以区分吉他声音和其他乐器的声音"
  },
  {
    "start": 525.79,
    "end": 527.01,
    "text": "所以"
  },
  {
    "start": 527.01,
    "end": 528.46,
    "text": "谐波就是基音的整"
  },
  {
    "start": 528.46,
    "end": 530.78,
    "text": "数倍频率的声音成分"
  },
  {
    "start": 530.78,
    "end": 534.53,
    "text": "它们一起创造了我们听到的声音的质地和音色"
  },
  {
    "start": 534.53,
    "end": 537.48,
    "text": "这个概念不仅适用于音乐"
  },
  {
    "start": 537.48,
    "end": 541.97,
    "text": "还适用于电子设备 电力系统等许多领域"
  },
  {
    "start": 541.97,
    "end": 544.68,
    "text": "暮雨认为这也可以用来解释"
  },
  {
    "start": 544.68,
    "end": 549.92,
    "text": "能量场 相干光"
  },
  {
    "start": 549.92,
    "end": 551.61,
    "text": "相干光可以理解"
  },
  {
    "start": 551.61,
    "end": 552.56,
    "text": "为一束光"
  },
  {
    "start": 552.56,
    "end": 553.31,
    "text": "波"
  },
  {
    "start": 553.31,
    "end": 557.09,
    "text": "光波上各点之间具有固定相位关系"
  },
  {
    "start": 557.09,
    "end": 560.22,
    "text": "即所有的光都平行于同一传播轴"
  },
  {
    "start": 560.22,
    "end": 563.75,
    "text": "形成极细 高度聚焦的光束"
  },
  {
    "start": 563.75,
    "end": 566.58,
    "text": "激光就是一种相干光"
  },
  {
    "start": 566.58,
    "end": 569.78,
    "text": "相干光在光学和光通信领域"
  },
  {
    "start": 569.78,
    "end": 571.99,
    "text": "具有重要应用"
  },
  {
    "start": 571.99,
    "end": 573.8,
    "text": "例如相干光通信"
  },
  {
    "start": 573.8,
    "end": 578.29,
    "text": "可以提高传输距离和灵敏度"
  },
  {
    "start": 578.29,
    "end": 582.75,
    "text": "亚原子粒子 亚原子粒子"
  },
  {
    "start": 582.75,
    "end": 583.73,
    "text": "又称次原子"
  },
  {
    "start": 583.73,
    "end": 584.81,
    "text": "粒子"
  },
  {
    "start": 584.81,
    "end": 585.21,
    "text": "是指"
  }
]