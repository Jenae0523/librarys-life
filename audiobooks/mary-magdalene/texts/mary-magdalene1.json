[
  {
    "start": 0.0,
    "end": 4.999,
    "text": "祈请宇宙母亲的祈祷词"
  },
  {
    "start": 8.27,
    "end": 9.89,
    "text": "伟大的母亲"
  },
  {
    "start": 9.89,
    "end": 11.7,
    "text": "神圣的女性"
  },
  {
    "start": 11.7,
    "end": 13.59,
    "text": "宇宙的孕育者"
  },
  {
    "start": 13.59,
    "end": 15.64,
    "text": "灵魂的爱人"
  },
  {
    "start": 15.64,
    "end": 17.94,
    "text": "创造万物的造物主"
  },
  {
    "start": 17.94,
    "end": 20.97,
    "text": "在有界与无界的世界中"
  },
  {
    "start": 20.97,
    "end": 22.84,
    "text": "您是万物的女王"
  },
  {
    "start": 22.84,
    "end": 24.5,
    "text": "在此时"
  },
  {
    "start": 24.5,
    "end": 26.61,
    "text": "我们呼唤您的到来"
  },
  {
    "start": 26.61,
    "end": 29.11,
    "text": "我们是您的孩子"
  },
  {
    "start": 29.11,
    "end": 31.38,
    "text": "请倾听我们的呼唤"
  },
  {
    "start": 31.38,
    "end": 35.4,
    "text": "我们是您们神圣结合的女儿和儿子"
  },
  {
    "start": 35.4,
    "end": 39.73,
    "text": "您对生命的热情在我们的肉体中流淌"
  },
  {
    "start": 39.73,
    "end": 43.49,
    "text": "您与灵魂 ——我们的父亲"
  },
  {
    "start": 43.49,
    "end": 45.93,
    "text": "在时间的起源中相伴"
  },
  {
    "start": 45.93,
    "end": 49.01,
    "text": "从灵魂和物质的祝福与结合中"
  },
  {
    "start": 49.01,
    "end": 50.56,
    "text": "带领我们诞生"
  },
  {
    "start": 50.56,
    "end": 52.85,
    "text": "我们是您的孩子"
  },
  {
    "start": 52.85,
    "end": 55.45,
    "text": "是您肉体和心灵的儿女"
  },
  {
    "start": 55.45,
    "end": 59.8,
    "text": "我们记得您的触摸和您原始的芳香"
  },
  {
    "start": 59.8,
    "end": 61.99,
    "text": "我们渴望您的到来"
  },
  {
    "start": 61.99,
    "end": 64.14,
    "text": "来到我们的内心"
  },
  {
    "start": 64.14,
    "end": 65.82,
    "text": "赐予我们忆起"
  },
  {
    "start": 65.82,
    "end": 67.93,
    "text": "进入我们的思想"
  },
  {
    "start": 67.93,
    "end": 69.71,
    "text": "开启我们的天赋"
  },
  {
    "start": 69.71,
    "end": 72.44,
    "text": "以您的临在来启迪我们"
  },
  {
    "start": 72.44,
    "end": 74.2,
    "text": "揭开面纱"
  },
  {
    "start": 74.2,
    "end": 76.21,
    "text": "让我们得以看清"
  },
  {
    "start": 76.21,
    "end": 78.8,
    "text": "同时开启我们倾听的门户"
  },
  {
    "start": 78.8,
    "end": 83.53,
    "text": "让美丽和狂喜充盈我们的家园和心灵"
  },
  {
    "start": 83.53,
    "end": 86.77,
    "text": "这是我们最需要帮助的时刻"
  },
  {
    "start": 86.77,
    "end": 88.98,
    "text": "我们透过火与水"
  },
  {
    "start": 88.98,
    "end": 90.79,
    "text": "透过大地与风"
  },
  {
    "start": 90.79,
    "end": 93.34,
    "text": "透过一切以您名字命名的事物"
  },
  {
    "start": 93.34,
    "end": 95.64,
    "text": "呼唤您的到来"
  },
  {
    "start": 95.64,
    "end": 98.86,
    "text": "我们呼唤您所有的血统和名字"
  },
  {
    "start": 98.86,
    "end": 100.81,
    "text": "来到我们之中"
  },
  {
    "start": 100.81,
    "end": 102.51,
    "text": "进入我们之内"
  },
  {
    "start": 102.51,
    "end": 106.42,
    "text": "诚心所愿"
  },
  {
    "start": 106.42,
    "end": 109.23,
    "text": "—朱迪·赛恩"
  },
  {
    "start": 109.23,
    "end": 110.23,
    "text": "【暮雨·注】 灵魂 ——我们的父亲"
  },
  {
    "start": 115.7,
    "end": 118.06,
    "text": "在这首祈祷词中"
  },
  {
    "start": 118.06,
    "end": 119.15,
    "text": "“灵魂”"
  },
  {
    "start": 119.15,
    "end": 120.85,
    "text": "被称为“我们的父亲”"
  },
  {
    "start": 120.85,
    "end": 123.06,
    "text": "然而需注意的是"
  },
  {
    "start": 123.06,
    "end": 126.8,
    "text": "这里的“灵魂”与我们通常所说的灵魂"
  },
  {
    "start": 126.8,
    "end": 128.61,
    "text": "并非同一个概念"
  },
  {
    "start": 128.61,
    "end": 131.01,
    "text": "你可以将其理解为"
  },
  {
    "start": 131.01,
    "end": 132.87,
    "text": "“灵魂群” “大灵”"
  },
  {
    "start": 132.87,
    "end": 133.78,
    "text": "或“超灵”"
  },
  {
    "start": 133.78,
    "end": 138.99,
    "text": "我们个体 只是大灵的其中一个灵魂碎片 ——"
  },
  {
    "start": 138.99,
    "end": 142.73,
    "text": "大灵将自己分裂成无数小灵魂"
  },
  {
    "start": 142.73,
    "end": 145.37,
    "text": "它们各自去经历不同的体验"
  },
  {
    "start": 145.37,
    "end": 147.8,
    "text": "完成后又重新融入大灵"
  },
  {
    "start": 147.8,
    "end": 149.06,
    "text": "因此"
  },
  {
    "start": 149.06,
    "end": 151.47,
    "text": "在某些密教传统中"
  },
  {
    "start": 151.47,
    "end": 153.09,
    "text": "它被称为“父亲”"
  },
  {
    "start": 153.09,
    "end": 155.02,
    "text": "这也是耶稣"
  },
  {
    "start": 155.02,
    "end": 157.52,
    "text": "常挂在口中的“我的父”"
  },
  {
    "start": 157.52,
    "end": 159.03,
    "text": "的真实所指"
  },
  {
    "start": 159.03,
    "end": 160.29,
    "text": "因为"
  },
  {
    "start": 160.29,
    "end": 162.09,
    "text": "他也在那些传统中"
  },
  {
    "start": 162.09,
    "end": 164.47,
    "text": "接受了秘密知识的培训"
  },
  {
    "start": 164.47,
    "end": 165.47,
    "text": "69 00:02:45,470 --> 00:02:47,610 【暮雨·注】"
  },
  {
    "start": 167.61,
    "end": 171.41,
    "text": "宇宙母亲  与 女性能量"
  },
  {
    "start": 171.41,
    "end": 175.07,
    "text": "“我们呼唤您所有的血统和名字”"
  },
  {
    "start": 175.07,
    "end": 177.75,
    "text": "这句话是什么意思呢"
  },
  {
    "start": 177.75,
    "end": 181.4,
    "text": "宇宙母亲 所代表的女性能量"
  },
  {
    "start": 181.4,
    "end": 185.92,
    "text": "在各种文化/宗教传统中都有被感应到"
  },
  {
    "start": 185.92,
    "end": 188.68,
    "text": "然后被赋予不同的名字和形象"
  },
  {
    "start": 188.68,
    "end": 191.73,
    "text": "本书中常提到的一个女神"
  },
  {
    "start": 191.73,
    "end": 192.94,
    "text": "“伊西斯”"
  },
  {
    "start": 192.94,
    "end": 196.47,
    "text": "便是宇宙母亲的其中一个化身"
  },
  {
    "start": 196.47,
    "end": 199.32,
    "text": "在古代许多不同的信仰中"
  },
  {
    "start": 199.32,
    "end": 201.3,
    "text": "都有关于她的记载"
  },
  {
    "start": 201.3,
    "end": 203.29,
    "text": "这首祈祷词"
  },
  {
    "start": 203.29,
    "end": 205.85,
    "text": "呼唤宇宙母亲的降临"
  },
  {
    "start": 205.85,
    "end": 208.25,
    "text": "代表着女性能量的回归"
  },
  {
    "start": 208.25,
    "end": 210.71,
    "text": "在过去几千年中"
  },
  {
    "start": 210.71,
    "end": 213.4,
    "text": "地球上的女性能量受到了压制"
  },
  {
    "start": 213.4,
    "end": 216.38,
    "text": "无论你是女性还是男性"
  },
  {
    "start": 216.38,
    "end": 218.15,
    "text": "都需要在此时"
  },
  {
    "start": 218.15,
    "end": 220.39,
    "text": "重新平衡 发展与提升"
  },
  {
    "start": 220.39,
    "end": 223.01,
    "text": "你内在的女性能量"
  },
  {
    "start": 223.01,
    "end": 225.38,
    "text": "成熟的女性能量"
  },
  {
    "start": 225.38,
    "end": 228.76,
    "text": "既富于弹性又具有流动性"
  },
  {
    "start": 228.76,
    "end": 230.89,
    "text": "不会固守僵化的模式"
  },
  {
    "start": 230.89,
    "end": 232.91,
    "text": "也不会与现有体系对抗"
  },
  {
    "start": 232.91,
    "end": 236.8,
    "text": "女性能量不仅充满了理解与温柔"
  },
  {
    "start": 236.8,
    "end": 239.8,
    "text": "还具有敢于臣服的强大力量"
  },
  {
    "start": 239.8,
    "end": 243.38,
    "text": "她将协助你带着冷静的臣服"
  },
  {
    "start": 243.38,
    "end": 245.52,
    "text": "与寂静的内在觉知"
  },
  {
    "start": 245.52,
    "end": 247.08,
    "text": "信任生命之河"
  },
  {
    "start": 247.08,
    "end": 250.59,
    "text": "会引领你走出混乱的旧世界"
  },
  {
    "start": 250.59,
    "end": 253.23,
    "text": "这正是女性能量"
  },
  {
    "start": 253.23,
    "end": 254.93,
    "text": "在此时的意义"
  },
  {
    "start": 254.93,
    "end": 256.93,
    "text": "104 00:04:16,930 --> 00:04:22,060 【延伸阅读】 祈祷词的语言力量"
  },
  {
    "start": 262.06,
    "end": 263.96,
    "text": "自古以来"
  },
  {
    "start": 263.96,
    "end": 266.79,
    "text": "祈祷一直存在于各种传统中"
  },
  {
    "start": 266.79,
    "end": 268.64,
    "text": "它并非迷信"
  },
  {
    "start": 268.64,
    "end": 270.94,
    "text": "也不是空洞的形式主义"
  },
  {
    "start": 270.94,
    "end": 274.0,
    "text": "只是很多人未曾充分理解"
  },
  {
    "start": 274.0,
    "end": 275.9,
    "text": "祈祷的潜在力量"
  },
  {
    "start": 275.9,
    "end": 278.26,
    "text": "以及其背后的科学依据"
  },
  {
    "start": 278.26,
    "end": 279.75,
    "text": "你的祈祷"
  },
  {
    "start": 279.75,
    "end": 281.69,
    "text": "只有在你的意图"
  },
  {
    "start": 281.69,
    "end": 284.25,
    "text": "非常清晰和强烈时"
  },
  {
    "start": 284.25,
    "end": 287.39,
    "text": "才能打开 通往另一个次元的门户"
  },
  {
    "start": 287.39,
    "end": 290.5,
    "text": "在作者 琳达·皓的著作"
  },
  {
    "start": 290.5,
    "end": 293.44,
    "text": "《如何阅读阿卡西记录》中提到"
  },
  {
    "start": 293.44,
    "end": 296.57,
    "text": "进入阿卡西能量场的其中一个方式"
  },
  {
    "start": 296.57,
    "end": 298.73,
    "text": "就是使用“神圣祈祷”"
  },
  {
    "start": 298.73,
    "end": 300.87,
    "text": "书中指出"
  },
  {
    "start": 300.87,
    "end": 302.75,
    "text": "“神圣祈祷” 给予人们"
  },
  {
    "start": 302.75,
    "end": 305.01,
    "text": "“接通阿卡西的密码”"
  },
  {
    "start": 305.01,
    "end": 309.23,
    "text": "让他们成功地进入 体验和退出阿卡西"
  },
  {
    "start": 309.23,
    "end": 312.31,
    "text": "这个神圣祈祷传统建立在"
  },
  {
    "start": 312.31,
    "end": 316.86,
    "text": "特定的音调 词语和词组的振动模式上"
  },
  {
    "start": 316.86,
    "end": 320.27,
    "text": "它们共同激活了神圣光网格的共振"
  },
  {
    "start": 320.27,
    "end": 322.29,
    "text": "构建了一座能量桥梁"
  },
  {
    "start": 322.29,
    "end": 325.08,
    "text": "通向阿卡西记录的特定区域"
  },
  {
    "start": 325.08,
    "end": 329.84,
    "text": "祈祷所创造的能量通道与心密切相关"
  },
  {
    "start": 329.84,
    "end": 332.93,
    "text": "它需要这个人非常积极的内在工作"
  },
  {
    "start": 332.93,
    "end": 335.55,
    "text": "心越通透  越敞开"
  },
  {
    "start": 335.55,
    "end": 338.01,
    "text": "与阿卡西的连接就越强烈"
  },
  {
    "start": 338.01,
    "end": 339.92,
    "text": "每个人的祈祷"
  },
  {
    "start": 339.92,
    "end": 343.23,
    "text": "都散发着独特的灵魂层级信号"
  },
  {
    "start": 343.23,
    "end": 346.72,
    "text": "吸引与之共鸣的存有与其接触"
  },
  {
    "start": 346.72,
    "end": 350.24,
    "text": "茂琳・圣哲曼也在她的著作"
  },
  {
    "start": 350.24,
    "end": 353.59,
    "text": "《超越生命之花》中表达了相似的观点"
  },
  {
    "start": 353.59,
    "end": 354.65,
    "text": "她提到"
  },
  {
    "start": 354.65,
    "end": 357.02,
    "text": "一些强大的咒语"
  },
  {
    "start": 357.02,
    "end": 359.96,
    "text": "可以激活神圣光网的结构"
  },
  {
    "start": 359.96,
    "end": 363.52,
    "text": "创造了通往其它次元的桥梁"
  },
  {
    "start": 363.52,
    "end": 365.98,
    "text": "特定的声音或词语"
  },
  {
    "start": 365.98,
    "end": 369.32,
    "text": "会产生让意识层次改变的振动"
  },
  {
    "start": 369.32,
    "end": 371.57,
    "text": "当它们与身体共振时"
  },
  {
    "start": 371.57,
    "end": 373.77,
    "text": "改变就会发生"
  },
  {
    "start": 373.77,
    "end": 377.11,
    "text": "这引发了一个值得思考的问题"
  },
  {
    "start": 377.11,
    "end": 378.48,
    "text": "你有曾想过"
  },
  {
    "start": 378.48,
    "end": 380.63,
    "text": "我们在日常生活中"
  },
  {
    "start": 380.63,
    "end": 383.93,
    "text": "无论有意 或无意说出的话语"
  },
  {
    "start": 383.93,
    "end": 387.24,
    "text": "也同样具有强大的创造力吗"
  },
  {
    "start": 387.6,
    "end": 389.38,
    "text": "芭芭拉‧布伦南在她的著作"
  },
  {
    "start": 389.38,
    "end": 390.88,
    "text": "《光之显现》 中"
  },
  {
    "start": 390.88,
    "end": 392.68,
    "text": "表达了这样的观点:"
  },
  {
    "start": 392.68,
    "end": 395.46,
    "text": "语言的力量非常强大"
  },
  {
    "start": 395.46,
    "end": 397.64,
    "text": "语言具有创造力"
  },
  {
    "start": 397.64,
    "end": 399.42,
    "text": "在物质层级"
  },
  {
    "start": 399.42,
    "end": 402.34,
    "text": "语言创造出了物质界中的形式"
  },
  {
    "start": 402.34,
    "end": 405.36,
    "text": "它是物质层一切存在形式的模板"
  },
  {
    "start": 405.36,
    "end": 406.71,
    "text": "因此"
  },
  {
    "start": 406.71,
    "end": 409.66,
    "text": "显化过程与语言的力量相关"
  },
  {
    "start": 409.66,
    "end": 412.34,
    "text": "这意味着说出你的真相"
  },
  {
    "start": 412.34,
    "end": 415.22,
    "text": "坚持表达你的真实需求"
  },
  {
    "start": 415.22,
    "end": 417.05,
    "text": "并按照它来生活"
  },
  {
    "start": 417.05,
    "end": 419.94,
    "text": "将真相付诸于行动"
  },
  {
    "start": 419.94,
    "end": 421.22,
    "text": "相反"
  },
  {
    "start": 421.22,
    "end": 423.29,
    "text": "如果你不诚实"
  },
  {
    "start": 423.29,
    "end": 425.86,
    "text": "你会在生活中造成扭曲"
  },
  {
    "start": 425.86,
    "end": 427.09,
    "text": "此外"
  },
  {
    "start": 427.09,
    "end": 431.47,
    "text": "语言还涉及声音或使用声音来创造形式"
  },
  {
    "start": 431.47,
    "end": 436.69,
    "text": "（暮雨注 本书没有对此作进一步的阐述）"
  },
  {
    "start": 436.69,
    "end": 438.94,
    "text": "另一个有趣的观点"
  },
  {
    "start": 438.94,
    "end": 441.37,
    "text": "古梵语中的每个字的发音"
  },
  {
    "start": 441.37,
    "end": 443.63,
    "text": "与身体的能量中心共振"
  },
  {
    "start": 443.63,
    "end": 447.12,
    "text": "当你正确地发出这些音调时"
  },
  {
    "start": 447.12,
    "end": 451.5,
    "text": "那个特定的音调将激活与之对应的能量中心"
  },
  {
    "start": 451.5,
    "end": 456.71,
    "text": "《薄伽梵歌》的内容正是汇总了所有这些神圣音调"
  },
  {
    "start": 456.71,
    "end": 460.74,
    "text": "许多伟大的经典都具有类似的作用"
  },
  {
    "start": 460.74,
    "end": 462.04,
    "text": "例如《圣经》"
  },
  {
    "start": 462.04,
    "end": 462.95,
    "text": "《可兰经》"
  },
  {
    "start": 462.95,
    "end": 464.87,
    "text": "以及众多佛教经文"
  },
  {
    "start": 464.87,
    "end": 466.19,
    "text": "然而"
  },
  {
    "start": 466.19,
    "end": 469.4,
    "text": "这些文本可能在传承的过程中"
  },
  {
    "start": 469.4,
    "end": 472.85,
    "text": "多少存在扭曲"
  },
  {
    "start": 472.85,
    "end": 475.96,
    "text": "（暮雨注 此部分的内容"
  },
  {
    "start": 475.96,
    "end": 478.5,
    "text": "我没有找到可靠的出处"
  },
  {
    "start": 478.5,
    "end": 480.09,
    "text": "仅凭记忆写下的"
  },
  {
    "start": 480.09,
    "end": 484.32,
    "text": "如果有读者或观众了解相关知识"
  },
  {
    "start": 484.32,
    "end": 487.05,
    "text": "请在下面留言或予以纠正"
  },
  {
    "start": 487.05,
    "end": 490.17,
    "text": "感谢"
  },
  {
    "start": 490.17,
    "end": 491.56,
    "text": "最后"
  },
  {
    "start": 491.56,
    "end": 494.48,
    "text": "关于上述理论的科学依据"
  },
  {
    "start": 494.48,
    "end": 498.0,
    "text": "汤姆·肯永 在他的著作《大脑状态》 中"
  },
  {
    "start": 498.0,
    "end": 503.12,
    "text": "从心理声学的角度 探讨了声音 语言和音乐"
  },
  {
    "start": 503.12,
    "end": 506.42,
    "text": "如何影响人类神经系统和行为"
  },
  {
    "start": 506.42,
    "end": 509.54,
    "text": "我们将很快分享相关内容"
  }
]