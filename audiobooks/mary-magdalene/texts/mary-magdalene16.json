[
  {
    "start": 0.0,
    "end": 4.0,
    "text": "这一集将介绍一种"
  },
  {
    "start": 6.37,
    "end": 9.04,
    "text": "所有人都可以操作的简单方法"
  },
  {
    "start": 9.04,
    "end": 10.95,
    "text": "睡眠编程法则"
  },
  {
    "start": 10.95,
    "end": 14.66,
    "text": "你可以将它用于创造更积极的现实"
  },
  {
    "start": 14.66,
    "end": 18.15,
    "text": "当你最大化地利用睡眠编程时"
  },
  {
    "start": 18.15,
    "end": 21.08,
    "text": "它会开始指引你生命的方向"
  },
  {
    "start": 21.08,
    "end": 22.84,
    "text": "到达你想要的目的地"
  },
  {
    "start": 22.84,
    "end": 25.23,
    "text": "你不再只是毫无目的漂荡的"
  },
  {
    "start": 25.23,
    "end": 26.91,
    "text": "集体意识的一部分"
  },
  {
    "start": 26.91,
    "end": 30.29,
    "text": "你可以有意识地选择生命的结果"
  },
  {
    "start": 30.29,
    "end": 32.08,
    "text": "而睡眠编程能保证"
  },
  {
    "start": 32.08,
    "end": 34.45,
    "text": "你会得到你所期望的结果"
  },
  {
    "start": 34.45,
    "end": 36.22,
    "text": "在上一集"
  },
  {
    "start": 36.22,
    "end": 40.86,
    "text": "我们引述了卡洛斯·卡斯塔尼达所著的《做梦的艺术》"
  },
  {
    "start": 40.86,
    "end": 42.85,
    "text": "揭示了“控梦”的奥秘"
  },
  {
    "start": 42.85,
    "end": 46.38,
    "text": "唐望将“做梦”称为“通往永恒的入口”"
  },
  {
    "start": 46.38,
    "end": 49.69,
    "text": "透过“做梦 ”我们能知觉其他世界"
  },
  {
    "start": 49.69,
    "end": 53.08,
    "text": "做梦是调整人能量体的艺术"
  },
  {
    "start": 53.08,
    "end": 55.9,
    "text": "通过移动“集合点”来达成"
  },
  {
    "start": 55.9,
    "end": 59.68,
    "text": "而“控梦”是我们每个人都具备的隐藏功能"
  },
  {
    "start": 59.68,
    "end": 63.44,
    "text": "这本书探讨了通过控制做梦注意力"
  },
  {
    "start": 63.44,
    "end": 66.04,
    "text": "使梦境成为另一种现实"
  },
  {
    "start": 66.04,
    "end": 68.93,
    "text": "进而达到打破知觉限制的目标"
  },
  {
    "start": 68.93,
    "end": 71.36,
    "text": "并目击到宇宙真正的伟大"
  },
  {
    "start": 71.36,
    "end": 72.68,
    "text": "然而"
  },
  {
    "start": 72.68,
    "end": 75.07,
    "text": "这只是“控梦”练习的起点"
  },
  {
    "start": 75.07,
    "end": 78.61,
    "text": "“做梦的艺术”其最伟大的奥秘是——"
  },
  {
    "start": 78.61,
    "end": 79.89,
    "text": "睡眠编程"
  },
  {
    "start": 79.89,
    "end": 85.0,
    "text": "即通过“做梦”进入第二注意力（更深层的意识状态）"
  },
  {
    "start": 85.0,
    "end": 87.77,
    "text": "创造和显化你想要的未来"
  },
  {
    "start": 87.77,
    "end": 89.35,
    "text": "接下来"
  },
  {
    "start": 89.35,
    "end": 93.25,
    "text": "我们将引用三本书的内容来进一步阐释"
  },
  {
    "start": 93.25,
    "end": 98.69,
    "text": "以下内容引用自《做梦的艺术》"
  },
  {
    "start": 98.69,
    "end": 101.82,
    "text": "作者卡洛斯·卡斯塔尼达"
  },
  {
    "start": 101.82,
    "end": 104.87,
    "text": "在第二注意力中意愿"
  },
  {
    "start": 104.87,
    "end": 105.48,
    "text": "借"
  },
  {
    "start": 105.48,
    "end": 107.07,
    "text": "由意愿的翅膀"
  },
  {
    "start": 107.07,
    "end": 109.94,
    "text": "我们可以“梦见”另一个未来的时空"
  },
  {
    "start": 110.32,
    "end": 113.42,
    "text": "暮雨·注用现代人的术语来说"
  },
  {
    "start": 113.42,
    "end": 114.26,
    "text": "我们可以创"
  },
  {
    "start": 114.26,
    "end": 115.94,
    "text": "造并进入另一个平行宇"
  },
  {
    "start": 115.94,
    "end": 117.33,
    "text": "宙的时间线"
  },
  {
    "start": 117.33,
    "end": 120.12,
    "text": "唐望传承的巫术传统"
  },
  {
    "start": 120.12,
    "end": 123.0,
    "text": "是以投射意愿的方式"
  },
  {
    "start": 123.0,
    "end": 125.16,
    "text": "在第二注意力中行动"
  },
  {
    "start": 125.16,
    "end": 128.76,
    "text": "他们通过练习在梦中投射思想"
  },
  {
    "start": 128.76,
    "end": 131.18,
    "text": "来真实地重建他们所选择的任"
  },
  {
    "start": 131.18,
    "end": 132.2,
    "text": "何物体"
  },
  {
    "start": 132.2,
    "end": 134.65,
    "text": "甚至是一个小镇"
  },
  {
    "start": 134.65,
    "end": 136.71,
    "text": "控梦练习  │"
  },
  {
    "start": 136.71,
    "end": 140.41,
    "text": "达到完全知觉  开始时"
  },
  {
    "start": 140.41,
    "end": 143.08,
    "text": "通常先注视一个简单的物体"
  },
  {
    "start": 143.08,
    "end": 145.04,
    "text": "记住一切细节"
  },
  {
    "start": 145.04,
    "end": 146.33,
    "text": "闭上眼睛"
  },
  {
    "start": 146.33,
    "end": 148.73,
    "text": "在脑中重现那件物体"
  },
  {
    "start": 148.73,
    "end": 148.95,
    "text": "然"
  },
  {
    "start": 148.95,
    "end": 151.31,
    "text": "后与真实物体相比较"
  },
  {
    "start": 151.31,
    "end": 152.6,
    "text": "更正错误"
  },
  {
    "start": 152.6,
    "end": 156.23,
    "text": "直到能闭上眼睛完整地看见那物体为止"
  },
  {
    "start": 156.23,
    "end": 157.88,
    "text": "下一阶段"
  },
  {
    "start": 157.88,
    "end": 159.99,
    "text": "便是带那物体入梦"
  },
  {
    "start": 159.99,
    "end": 162.79,
    "text": "在梦中完全使那物体实体化"
  },
  {
    "start": 162.79,
    "end": 166.75,
    "text": "这种做法被称为完全知觉的第一步"
  },
  {
    "start": 166.75,
    "end": 170.08,
    "text": "完成了简单物体的做梦练习后"
  },
  {
    "start": 170.08,
    "end": 172.21,
    "text": "继续尝试更复杂的事物"
  },
  {
    "start": 172.21,
    "end": 174.24,
    "text": "最终目标是"
  },
  {
    "start": 174.24,
    "end": 178.39,
    "text": "巫士全体一致想像出一个完整的世界"
  },
  {
    "start": 178.39,
    "end": 181.14,
    "text": "然后在梦中重现那个世界"
  },
  {
    "start": 181.14,
    "end": 185.83,
    "text": "重新创造出一个可以让他们生存的完整真实空间"
  },
  {
    "start": 185.83,
    "end": 189.76,
    "text": "这些巫士甚至能轻易地将任何人"
  },
  {
    "start": 189.76,
    "end": 191.44,
    "text": "拉入他们的意愿之中"
  },
  {
    "start": 191.44,
    "end": 192.74,
    "text": "即他们的梦中"
  },
  {
    "start": 193.13,
    "end": 198.3,
    "text": "暮雨·注朵洛莉丝·侃南的《三波志愿者与新地球》第三十四章——"
  },
  {
    "start": 198.3,
    "end": 201.44,
    "text": "“更早的转移”中记载了一个催眠案例"
  },
  {
    "start": 201.44,
    "end": 202.45,
    "text": "在美洲原住"
  },
  {
    "start": 202.45,
    "end": 203.9,
    "text": "民生活的地方"
  },
  {
    "start": 203.9,
    "end": 208.6,
    "text": "在过去（西班牙人还未踏上美洲大陆之前）"
  },
  {
    "start": 208.6,
    "end": 212.27,
    "text": "有群人已经能够全体一起进入另一个次元"
  },
  {
    "start": 212.27,
    "end": 214.4,
    "text": "据个案描述"
  },
  {
    "start": 214.4,
    "end": 216.91,
    "text": "那是在第五次元"
  },
  {
    "start": 218.91,
    "end": 224.67,
    "text": "以下内容引用自《人类的下一步 拓展你的宇宙意识》"
  },
  {
    "start": 224.67,
    "end": 230.18,
    "text": "作者大卫·K·米勒信息来自大角星人"
  },
  {
    "start": 230.18,
    "end": 232.84,
    "text": "你可以提升你的多维能力"
  },
  {
    "start": 232.84,
    "end": 236.32,
    "text": "比如将梦境体验视为一种意识"
  },
  {
    "start": 236.32,
    "end": 237.35,
    "text": "状态"
  },
  {
    "start": 237.35,
    "end": 242.09,
    "text": "你通常不会意识到自己处于梦境状态"
  },
  {
    "start": 242.09,
    "end": 244.42,
    "text": "但通过练习清醒梦"
  },
  {
    "start": 244.42,
    "end": 247.19,
    "text": "你可以增强在清醒意识状态下的"
  },
  {
    "start": 247.19,
    "end": 248.76,
    "text": "多维感知能力"
  },
  {
    "start": 249.14,
    "end": 249.5,
    "text": "暮雨"
  },
  {
    "start": 249.5,
    "end": 251.3,
    "text": "·注在大角星人文摘"
  },
  {
    "start": 251.3,
    "end": 255.17,
    "text": "的14集和15集记载了详细的方法"
  },
  {
    "start": 255.17,
    "end": 257.76,
    "text": "训练你的大脑神经系统"
  },
  {
    "start": 257.76,
    "end": 259.8,
    "text": "超越线性感知"
  },
  {
    "start": 259.8,
    "end": 262.02,
    "text": "提升多维感知的能力"
  },
  {
    "start": 262.02,
    "end": 264.0,
    "text": "梦境体验  │"
  },
  {
    "start": 264.0,
    "end": 266.98,
    "text": "练习扬升的一种方式"
  },
  {
    "start": 266.98,
    "end": 269.66,
    "text": "更高的意识始于意识"
  },
  {
    "start": 269.66,
    "end": 270.22,
    "text": "当"
  },
  {
    "start": 270.22,
    "end": 272.76,
    "text": "你意识到自己在做梦时"
  },
  {
    "start": 272.76,
    "end": 275.19,
    "text": "你就可以创造和控制你的梦境"
  },
  {
    "start": 275.19,
    "end": 277.96,
    "text": "你可以梦到自己去第五维度"
  },
  {
    "start": 277.96,
    "end": 280.99,
    "text": "这是你练习扬升的一种方式"
  },
  {
    "start": 280.99,
    "end": 282.55,
    "text": "意识到你的梦境"
  },
  {
    "start": 282.55,
    "end": 282.79,
    "text": "状"
  },
  {
    "start": 282.79,
    "end": 285.94,
    "text": "态会产生延续性的影响"
  },
  {
    "start": 285.94,
    "end": 287.61,
    "text": "即你在第三维度"
  },
  {
    "start": 287.61,
    "end": 290.82,
    "text": "中的行为和所做的事情"
  },
  {
    "start": 290.82,
    "end": 294.15,
    "text": "会影响到你在梦境状态下发生的事"
  },
  {
    "start": 294.15,
    "end": 297.49,
    "text": "也会影响到你如何轻松地进入第五维度"
  },
  {
    "start": 297.49,
    "end": 299.3,
    "text": "反之亦然"
  },
  {
    "start": 299.3,
    "end": 301.38,
    "text": "你在第五维度意识的梦境状"
  },
  {
    "start": 301.38,
    "end": 304.31,
    "text": "态中所做的和经历的事情"
  },
  {
    "start": 304.31,
    "end": 307.29,
    "text": "会影响你的第三维度意识状态"
  },
  {
    "start": 307.29,
    "end": 312.33,
    "text": "有些人在梦境状态下拥有比在第三维度"
  },
  {
    "start": 312.33,
    "end": 315.32,
    "text": "更强大的精神和心灵感应能力"
  },
  {
    "start": 315.32,
    "end": 317.44,
    "text": "在这种情况下"
  },
  {
    "start": 317.44,
    "end": 319.47,
    "text": "所有这些梦境经历"
  },
  {
    "start": 319.47,
    "end": 322.61,
    "text": "都是具有教导和启发性的"
  },
  {
    "start": 324.61,
    "end": 329.73,
    "text": "下面将介绍一种所有人都可以操作的简单方法"
  },
  {
    "start": 329.73,
    "end": 331.68,
    "text": "睡眠编程法则"
  },
  {
    "start": 331.68,
    "end": 335.39,
    "text": "你可以将它用于创造更积极的现实"
  },
  {
    "start": 335.39,
    "end": 341.45,
    "text": "以下内容引用自《在觉知之中创造十大法则 -齐瑞尔》"
  },
  {
    "start": 341.45,
    "end": 345.48,
    "text": "作者弗瑞德・思特灵齐瑞尔是一位来"
  },
  {
    "start": 345.48,
    "end": 345.76,
    "text": "自第"
  },
  {
    "start": 345.76,
    "end": 348.47,
    "text": "七次元的爱的指导灵"
  },
  {
    "start": 348.47,
    "end": 351.19,
    "text": "由弗瑞德・思特灵通灵传导"
  },
  {
    "start": 351.19,
    "end": 354.8,
    "text": "《在觉知之中创造十大法则》中"
  },
  {
    "start": 354.8,
    "end": 355.85,
    "text": "齐瑞尔提供了"
  },
  {
    "start": 355.85,
    "end": 356.97,
    "text": "一个方法"
  },
  {
    "start": 356.97,
    "end": 359.4,
    "text": "以便人类可以开始使用这个方法"
  },
  {
    "start": 359.4,
    "end": 361.29,
    "text": "来掌握自己的命运"
  },
  {
    "start": 361.29,
    "end": 364.35,
    "text": "我们几乎可以把睡眠编程"
  },
  {
    "start": 364.35,
    "end": 366.38,
    "text": "应用在所有的事情上"
  },
  {
    "start": 366.38,
    "end": 366.91,
    "text": "但"
  },
  {
    "start": 366.91,
    "end": 368.42,
    "text": "我们被警告"
  },
  {
    "start": 368.42,
    "end": 371.12,
    "text": "若不是使用在最大的善意上"
  },
  {
    "start": 371.12,
    "end": 373.69,
    "text": "将会吸引业力到使用者身上"
  },
  {
    "start": 373.69,
    "end": 375.35,
    "text": "关于这一点"
  },
  {
    "start": 375.35,
    "end": 379.12,
    "text": "我们留在最后强调"
  },
  {
    "start": 379.12,
    "end": 382.93,
    "text": "睡眠编程是如何运作的"
  },
  {
    "start": 382.93,
    "end": 385.28,
    "text": "透过你的意念意识"
  },
  {
    "start": 385.28,
    "end": 386.93,
    "text": "你有能力和我们称之为"
  },
  {
    "start": 386.93,
    "end": 389.11,
    "text": "集体意识的场域连系"
  },
  {
    "start": 389.11,
    "end": 392.1,
    "text": "在集体意识里有一个实相"
  },
  {
    "start": 392.1,
    "end": 394.15,
    "text": "地球层面的每一个存有"
  },
  {
    "start": 394.15,
    "end": 396.68,
    "text": "都有一个“本质我”或称“高我”"
  },
  {
    "start": 396.68,
    "end": 399.85,
    "text": "人类有两个部分的心智"
  },
  {
    "start": 399.85,
    "end": 401.94,
    "text": "大约10%的“自我心智”"
  },
  {
    "start": 401.94,
    "end": 402.19,
    "text": "和"
  },
  {
    "start": 402.19,
    "end": 404.12,
    "text": "90%的“本质我”"
  },
  {
    "start": 404.12,
    "end": 404.82,
    "text": "由于"
  },
  {
    "start": 404.82,
    "end": 408.19,
    "text": "你的本质我是在集体意识的层面工作"
  },
  {
    "start": 408.19,
    "end": 410.28,
    "text": "它可以超越你的局限"
  },
  {
    "start": 410.28,
    "end": 412.06,
    "text": "如果你认知到——"
  },
  {
    "start": 412.06,
    "end": 413.91,
    "text": "你有一个本质我"
  },
  {
    "start": 413.91,
    "end": 417.5,
    "text": "这个本质我和人类的集体意识是相连的"
  },
  {
    "start": 417.5,
    "end": 420.19,
    "text": "你就可以使用睡眠编程的方法"
  },
  {
    "start": 420.19,
    "end": 422.84,
    "text": "透过你的高我去召请另一个人的高"
  },
  {
    "start": 422.84,
    "end": 424.26,
    "text": "我产生对话"
  },
  {
    "start": 424.26,
    "end": 428.71,
    "text": "那么你就会看到你在物质层面拥有的优势"
  },
  {
    "start": 428.71,
    "end": 431.08,
    "text": "以及你能够多快和另一个人携手"
  },
  {
    "start": 431.08,
    "end": 431.97,
    "text": "合作"
  },
  {
    "start": 431.97,
    "end": 434.95,
    "text": "选择在睡眠状态进行"
  },
  {
    "start": 434.95,
    "end": 439.43,
    "text": "是因为那会让你物质层面的身体不要成为阻碍"
  },
  {
    "start": 439.43,
    "end": 442.34,
    "text": "并让你的高我/本质我能够好好工作"
  },
  {
    "start": 442.34,
    "end": 444.48,
    "text": "但不管你做什么"
  },
  {
    "start": 444.48,
    "end": 447.05,
    "text": "你一定要用最好的意图"
  },
  {
    "start": 447.05,
    "end": 450.61,
    "text": "为人类 为你们双方做更好的服务"
  },
  {
    "start": 450.61,
    "end": 454.82,
    "text": "你不可以用它来使别人的利益受到削减"
  },
  {
    "start": 454.82,
    "end": 457.69,
    "text": "或使他们未能处在爱的情境当中"
  },
  {
    "start": 457.69,
    "end": 463.04,
    "text": "“睡眠编程法则”一定要使用在爱的合一频率中"
  },
  {
    "start": 463.04,
    "end": 464.77,
    "text": "“爱”是你在这个层面上可"
  },
  {
    "start": 464.77,
    "end": 469.73,
    "text": "以使用的最美 也可能是最具威力的要素之一"
  },
  {
    "start": 471.73,
    "end": 477.04,
    "text": "如何将睡眠编程运用在人际关系中"
  },
  {
    "start": 477.04,
    "end": 480.24,
    "text": "让我们用一个简单的例子来说明"
  },
  {
    "start": 480.24,
    "end": 481.88,
    "text": "假设有个年轻人"
  },
  {
    "start": 481.88,
    "end": 483.57,
    "text": "为一个美丽的年轻女子"
  },
  {
    "start": 483.57,
    "end": 487.01,
    "text": "感到无比的痛苦 为她着迷"
  },
  {
    "start": 487.01,
    "end": 489.1,
    "text": "但她几乎没注意到他"
  },
  {
    "start": 489.1,
    "end": 491.68,
    "text": "如果你是那个年轻人"
  },
  {
    "start": 491.68,
    "end": 494.35,
    "text": "你开始使用睡眠编程的方法"
  },
  {
    "start": 494.35,
    "end": 495.26,
    "text": "通过在入睡"
  },
  {
    "start": 495.26,
    "end": 495.74,
    "text": "前召"
  },
  {
    "start": 495.74,
    "end": 496.89,
    "text": "请你的高我"
  },
  {
    "start": 496.89,
    "end": 499.69,
    "text": "首先举个糟糕的例子"
  },
  {
    "start": 499.69,
    "end": 499.9,
    "text": "告"
  },
  {
    "start": 499.9,
    "end": 501.42,
    "text": "诉你不该做什么"
  },
  {
    "start": 501.42,
    "end": 504.69,
    "text": "你不能这样告诉你的高我 \"听好"
  },
  {
    "start": 504.69,
    "end": 507.67,
    "text": "我正试着找机会和某某人约会"
  },
  {
    "start": 507.67,
    "end": 511.06,
    "text": "我已经做了我能想到的一切努力"
  },
  {
    "start": 511.06,
    "end": 512.78,
    "text": "可是却得不到回应"
  },
  {
    "start": 512.78,
    "end": 516.57,
    "text": "所以我要你去和她的高我联络"
  },
  {
    "start": 516.57,
    "end": 519.43,
    "text": "叫她对我的殷勤有所表示"
  },
  {
    "start": 519.43,
    "end": 520.55,
    "text": "现在就"
  },
  {
    "start": 520.55,
    "end": 521.48,
    "text": "去做吧"
  },
  {
    "start": 521.48,
    "end": 522.32,
    "text": "高我"
  },
  {
    "start": 522.32,
    "end": 524.7,
    "text": "\"这绝对是你所能做的最糟"
  },
  {
    "start": 524.7,
    "end": 526.68,
    "text": "糕的事情了"
  },
  {
    "start": 526.68,
    "end": 529.16,
    "text": "因为要知道在物质层面上"
  },
  {
    "start": 529.16,
    "end": 531.18,
    "text": "你的力量压制了另一个人"
  },
  {
    "start": 531.18,
    "end": 535.31,
    "text": "假如那个人对她的本质我没有一点认识"
  },
  {
    "start": 535.31,
    "end": 537.17,
    "text": "那么在精神层面"
  },
  {
    "start": 537.17,
    "end": 540.75,
    "text": "她多少会被一种她不熟悉的感觉所影响"
  },
  {
    "start": 540.75,
    "end": 544.66,
    "text": "这就是为什么你不可以使用那种方法去"
  },
  {
    "start": 544.66,
    "end": 545.94,
    "text": "影响他人"
  },
  {
    "start": 545.94,
    "end": 549.38,
    "text": "正确的方法是 召请你的高我"
  },
  {
    "start": 549.38,
    "end": 551.82,
    "text": "去和另一个人的高我联络"
  },
  {
    "start": 551.82,
    "end": 553.78,
    "text": "讲出那个人的名字"
  },
  {
    "start": 553.78,
    "end": 558.27,
    "text": "你要在最高的振动中（怀着最大的善意）"
  },
  {
    "start": 558.27,
    "end": 561.82,
    "text": "请你的高我让对方的高我知道你的感觉"
  },
  {
    "start": 561.82,
    "end": 563.74,
    "text": "在这个例子中"
  },
  {
    "start": 563.74,
    "end": 567.21,
    "text": "你真正该做的是请她的高我让她知道"
  },
  {
    "start": 567.21,
    "end": 568.23,
    "text": "只要她愿意给你"
  },
  {
    "start": 568.23,
    "end": 571.72,
    "text": "一个在物质层面表达自己的机会"
  },
  {
    "start": 571.72,
    "end": 575.35,
    "text": "你会告诉她所有你认为最好的理由"
  },
  {
    "start": 575.35,
    "end": 577.23,
    "text": "让她可以自己做决定"
  },
  {
    "start": 577.23,
    "end": 578.94,
    "text": "请记住"
  },
  {
    "start": 578.94,
    "end": 582.14,
    "text": "前提是只有在双方都同意的情况下"
  },
  {
    "start": 582.14,
    "end": 584.43,
    "text": "在这种情形下"
  },
  {
    "start": 584.43,
    "end": 585.8,
    "text": "你并没有要求高我"
  },
  {
    "start": 585.8,
    "end": 588.5,
    "text": "做任何不符合对方意愿的事情"
  },
  {
    "start": 588.5,
    "end": 591.42,
    "text": "一旦你做出这样的请求"
  },
  {
    "start": 591.42,
    "end": 594.79,
    "text": "事情就会开始在物质层面发生改变"
  },
  {
    "start": 594.79,
    "end": 596.36,
    "text": "例如"
  },
  {
    "start": 596.36,
    "end": 599.83,
    "text": "第二天你可能会和她在超市偶遇"
  },
  {
    "start": 599.83,
    "end": 601.48,
    "text": "相信我"
  },
  {
    "start": 601.48,
    "end": 602.03,
    "text": "这与你的"
  },
  {
    "start": 602.03,
    "end": 603.87,
    "text": "睡眠编程有关"
  },
  {
    "start": 603.87,
    "end": 607.04,
    "text": "你获得了与她直接接触的机会"
  },
  {
    "start": 607.04,
    "end": 608.51,
    "text": "然后"
  },
  {
    "start": 608.51,
    "end": 611.71,
    "text": "你必须接着让剧本继续进行下去"
  },
  {
    "start": 611.71,
    "end": 613.2,
    "text": "要知道"
  },
  {
    "start": 613.2,
    "end": 616.22,
    "text": "你的高我不会替你经验这个旅程"
  },
  {
    "start": 616.22,
    "end": 619.66,
    "text": "它会为你设置一条路径让事情发生"
  },
  {
    "start": 619.66,
    "end": 620.3,
    "text": "你必"
  },
  {
    "start": 620.3,
    "end": 623.18,
    "text": "须用你在物质层面的意识觉知"
  },
  {
    "start": 623.18,
    "end": 625.44,
    "text": "才能让所有的事发生"
  },
  {
    "start": 625.44,
    "end": 628.41,
    "text": "并且确保结果对双方都有利"
  },
  {
    "start": 628.41,
    "end": 630.61,
    "text": "而不仅仅是一方受益"
  },
  {
    "start": 630.61,
    "end": 634.08,
    "text": "这个例子告诉你如何正确地使用"
  },
  {
    "start": 634.08,
    "end": 636.94,
    "text": "或者如何避免滥用睡眠编程"
  },
  {
    "start": 638.94,
    "end": 643.83,
    "text": "发挥更大的力量  合伙筹划公司"
  },
  {
    "start": 643.83,
    "end": 645.23,
    "text": "然而"
  },
  {
    "start": 645.23,
    "end": 647.19,
    "text": "当你把睡眠编程使用在"
  },
  {
    "start": 647.19,
    "end": 650.48,
    "text": "超越爱情关系之外的意图时"
  },
  {
    "start": 650.48,
    "end": 653.31,
    "text": "这个能量体可以产生更大的力量"
  },
  {
    "start": 653.31,
    "end": 656.77,
    "text": "假设你和另一个人正在合伙筹划一"
  },
  {
    "start": 656.77,
    "end": 657.93,
    "text": "个公司"
  },
  {
    "start": 657.93,
    "end": 660.65,
    "text": "或者说你已经拥有一个公司"
  },
  {
    "start": 660.65,
    "end": 663.14,
    "text": "你想改变一下公司的方向"
  },
  {
    "start": 663.14,
    "end": 663.72,
    "text": "但"
  },
  {
    "start": 663.72,
    "end": 667.77,
    "text": "你在物质层面却很难说服你的伙伴"
  },
  {
    "start": 667.77,
    "end": 670.29,
    "text": "那么你可以使用睡眠编程"
  },
  {
    "start": 670.29,
    "end": 671.72,
    "text": "召请你的高我"
  },
  {
    "start": 671.72,
    "end": 674.6,
    "text": "当然事情并没有那么简单"
  },
  {
    "start": 674.6,
    "end": 676.85,
    "text": "你需要运用其他几项创"
  },
  {
    "start": 676.85,
    "end": 681.67,
    "text": "造法则 真实法则 信任法则和热忱法则"
  },
  {
    "start": 681.67,
    "end": 683.14,
    "text": "（注意不是兴奋"
  },
  {
    "start": 683.14,
    "end": 683.5,
    "text": "）"
  },
  {
    "start": 683.5,
    "end": 686.06,
    "text": "在这些法则的共同作用下"
  },
  {
    "start": 686.06,
    "end": 688.94,
    "text": "将会为你的高我指引方向"
  },
  {
    "start": 688.94,
    "end": 692.58,
    "text": "并为其提供能量去连结另一个人的高我"
  },
  {
    "start": 692.58,
    "end": 694.6,
    "text": "这就像是走在造物者的"
  },
  {
    "start": 694.6,
    "end": 695.91,
    "text": "道路上——"
  },
  {
    "start": 695.91,
    "end": 698.66,
    "text": "当你在混乱中偏离路径时"
  },
  {
    "start": 698.66,
    "end": 700.69,
    "text": "你的结果就会有变化"
  },
  {
    "start": 700.69,
    "end": 704.27,
    "text": "但当你坚定地走在\"真实\"之路上"
  },
  {
    "start": 704.27,
    "end": 706.85,
    "text": "你必定会得到你想要的结果"
  },
  {
    "start": 706.85,
    "end": 709.42,
    "text": "睡眠编程法则也是如此"
  },
  {
    "start": 709.42,
    "end": 712.76,
    "text": "只有当你全然地将所有人的最大利益"
  },
  {
    "start": 712.76,
    "end": 714.24,
    "text": "与你的目标结合起"
  },
  {
    "start": 714.24,
    "end": 715.58,
    "text": "来时"
  },
  {
    "start": 715.58,
    "end": 719.77,
    "text": "你的睡眠编程才会产生你所计划的结果"
  },
  {
    "start": 719.77,
    "end": 721.15,
    "text": "所以"
  },
  {
    "start": 721.15,
    "end": 724.37,
    "text": "要以最大的审慎去使用它"
  },
  {
    "start": 726.37,
    "end": 730.54,
    "text": "高我会拒绝我的睡眠编程请求吗"
  },
  {
    "start": 730.54,
    "end": 731.91,
    "text": "首先"
  },
  {
    "start": 731.91,
    "end": 735.87,
    "text": "高我实际上不可能拒绝人类的任何事"
  },
  {
    "start": 735.87,
    "end": 738.16,
    "text": "因为人类是高我的一部分"
  },
  {
    "start": 738.16,
    "end": 739.98,
    "text": "是它选定要体验的"
  },
  {
    "start": 739.98,
    "end": 744.29,
    "text": "所以当物质层面的你对高我说话时"
  },
  {
    "start": 744.29,
    "end": 746.01,
    "text": "高我必须支持你"
  },
  {
    "start": 746.01,
    "end": 747.63,
    "text": "并听从你的请求"
  },
  {
    "start": 747.63,
    "end": 750.21,
    "text": "其中有一个美妙的部分"
  },
  {
    "start": 750.21,
    "end": 750.44,
    "text": "假"
  },
  {
    "start": 750.44,
    "end": 753.3,
    "text": "如你的请求与所有相关的人的成长不"
  },
  {
    "start": 753.3,
    "end": 754.28,
    "text": "一致"
  },
  {
    "start": 754.28,
    "end": 759.21,
    "text": "或者与\"符合所有人的最高利益\"这个结果相抵触"
  },
  {
    "start": 759.21,
    "end": 761.87,
    "text": "那么高我会重新设定你的请求"
  },
  {
    "start": 761.87,
    "end": 763.09,
    "text": "或者"
  },
  {
    "start": 763.09,
    "end": 766.72,
    "text": "如果你的睡眠编程要求不够清晰"
  },
  {
    "start": 766.72,
    "end": 769.39,
    "text": "你的意图没有完全的明晰"
  },
  {
    "start": 769.39,
    "end": 769.88,
    "text": "那么高"
  },
  {
    "start": 769.88,
    "end": 772.91,
    "text": "我将会采取最高形式的执行"
  },
  {
    "start": 772.91,
    "end": 775.86,
    "text": "它将会诉诸于最高的光的频率"
  },
  {
    "start": 775.86,
    "end": 777.49,
    "text": "也就是诉诸于爱"
  },
  {
    "start": 777.49,
    "end": 779.05,
    "text": "因为高我或本质"
  },
  {
    "start": 779.05,
    "end": 781.92,
    "text": "我是在非常高的光领域运作"
  },
  {
    "start": 781.92,
    "end": 784.25,
    "text": "它自然会洞察你的行为"
  },
  {
    "start": 784.25,
    "end": 786.45,
    "text": "它可以超越和修正你——"
  },
  {
    "start": 786.45,
    "end": 789.77,
    "text": "因为试图要操纵他人而做的设定"
  },
  {
    "start": 789.77,
    "end": 792.85,
    "text": "这样你可以在想要照亮别人的同时"
  },
  {
    "start": 792.85,
    "end": 794.18,
    "text": "也照亮自己"
  },
  {
    "start": 794.18,
    "end": 797.71,
    "text": "你的高我会不惜一切代价保护你"
  },
  {
    "start": 797.71,
    "end": 800.43,
    "text": "因为你是它最重要的一个元素"
  },
  {
    "start": 800.43,
    "end": 801.36,
    "text": "所以"
  },
  {
    "start": 801.36,
    "end": 804.44,
    "text": "当你的请求与最高振动不符时"
  },
  {
    "start": 804.44,
    "end": 807.11,
    "text": "你的高我会利用自己的能量"
  },
  {
    "start": 807.11,
    "end": 809.34,
    "text": "引导你正在送出的力量"
  },
  {
    "start": 809.34,
    "end": 811.32,
    "text": "因此你会发现"
  },
  {
    "start": 811.32,
    "end": 813.52,
    "text": "在睡眠编程中被召请的高"
  },
  {
    "start": 813.52,
    "end": 815.78,
    "text": "我并没有完全按照你的请求"
  },
  {
    "start": 815.78,
    "end": 816.97,
    "text": "行事"
  },
  {
    "start": 816.97,
    "end": 818.99,
    "text": "于是你开始感觉到"
  },
  {
    "start": 818.99,
    "end": 821.73,
    "text": "你好像需要对计划做些改变"
  },
  {
    "start": 821.73,
    "end": 823.01,
    "text": "比方说"
  },
  {
    "start": 823.01,
    "end": 825.6,
    "text": "假设你是一位治疗师"
  },
  {
    "start": 825.6,
    "end": 827.96,
    "text": "正在治疗一位患者"
  },
  {
    "start": 827.96,
    "end": 830.05,
    "text": "那天你正好感到沮丧"
  },
  {
    "start": 830.05,
    "end": 833.84,
    "text": "你超越了医患关系该有的正确态度"
  },
  {
    "start": 833.84,
    "end": 837.1,
    "text": "向你的高我发出睡眠编程请求"
  },
  {
    "start": 837.1,
    "end": 837.88,
    "text": "\"你知道"
  },
  {
    "start": 837.88,
    "end": 841.21,
    "text": "我一直很努力地尝试要治疗这个人"
  },
  {
    "start": 841.21,
    "end": 843.2,
    "text": "但她完全不肯合作"
  },
  {
    "start": 843.2,
    "end": 844.6,
    "text": "我需要你去跟她"
  },
  {
    "start": 844.6,
    "end": 846.18,
    "text": "的高我谈谈"
  },
  {
    "start": 846.18,
    "end": 848.05,
    "text": "叫她现在要配合我"
  },
  {
    "start": 848.05,
    "end": 850.43,
    "text": "我们才能完成这个疗愈工作"
  },
  {
    "start": 850.43,
    "end": 854.94,
    "text": "\"你可以听出这位治疗师的音调和口气"
  },
  {
    "start": 854.94,
    "end": 859.02,
    "text": "他所要求的可能不是对大家最有利的"
  },
  {
    "start": 859.02,
    "end": 861.3,
    "text": "因为可能的情况是——"
  },
  {
    "start": 861.3,
    "end": 863.49,
    "text": "那位患者未能痊愈"
  },
  {
    "start": 863.49,
    "end": 867.12,
    "text": "是因为这与她正在经历的人世功课有关"
  },
  {
    "start": 867.12,
    "end": 869.25,
    "text": "在这种情况下"
  },
  {
    "start": 869.25,
    "end": 872.43,
    "text": "你的高我将与患者的高我进行互动"
  },
  {
    "start": 872.43,
    "end": 873.48,
    "text": "同时回馈你"
  },
  {
    "start": 873.48,
    "end": 875.23,
    "text": "应该采取什么行动"
  },
  {
    "start": 875.23,
    "end": 876.66,
    "text": "例如"
  },
  {
    "start": 876.66,
    "end": 879.97,
    "text": "它可能安排你去和另一个人谈话"
  },
  {
    "start": 879.97,
    "end": 883.39,
    "text": "那个人可能有你当下需要的知识和经验"
  },
  {
    "start": 883.39,
    "end": 886.0,
    "text": "也可能安排另一种存有"
  },
  {
    "start": 886.0,
    "end": 888.93,
    "text": "甚或指导灵或天使来帮助你"
  },
  {
    "start": 888.93,
    "end": 891.27,
    "text": "因此你可能会开始反思"
  },
  {
    "start": 891.27,
    "end": 892.65,
    "text": "\"我真的做对了吗"
  },
  {
    "start": 892.65,
    "end": 896.06,
    "text": "这件事我是不是有些傲慢了"
  },
  {
    "start": 896.06,
    "end": 896.98,
    "text": "\"  天使和"
  },
  {
    "start": 896.98,
    "end": 898.1,
    "text": "指导灵"
  },
  {
    "start": 898.1,
    "end": 900.76,
    "text": "或者与你对话的另一个人类"
  },
  {
    "start": 900.76,
    "end": 902.53,
    "text": "将与你一起寻找出一个"
  },
  {
    "start": 902.53,
    "end": 905.12,
    "text": "更符合当前状况的解决方案"
  },
  {
    "start": 905.12,
    "end": 909.71,
    "text": "高我的工作总是会从最高的层次融入"
  },
  {
    "start": 909.71,
    "end": 913.41,
    "text": "以确保不会强加于那些还没有准备好的人"
  },
  {
    "start": 913.41,
    "end": 915.54,
    "text": "勉强他们做不想做的事"
  },
  {
    "start": 915.54,
    "end": 916.76,
    "text": "因此"
  },
  {
    "start": 916.76,
    "end": 919.04,
    "text": "透过那个更高的振动"
  },
  {
    "start": 919.04,
    "end": 922.2,
    "text": "可以经由患者的高我传达一些信息"
  },
  {
    "start": 922.2,
    "end": 925.09,
    "text": "试着请她从不同的可能性看待事情"
  },
  {
    "start": 925.09,
    "end": 926.49,
    "text": "本质上"
  },
  {
    "start": 926.49,
    "end": 927.07,
    "text": "患者的"
  },
  {
    "start": 927.07,
    "end": 930.64,
    "text": "睡眠编程是受到尊重和保护的"
  },
  {
    "start": 930.64,
    "end": 934.3,
    "text": "在一个不改变灵魂计划的层次上"
  },
  {
    "start": 936.3,
    "end": 940.46,
    "text": "警告  │ 假如使用睡眠编程"
  },
  {
    "start": 940.46,
    "end": 944.01,
    "text": "牺牲他人的利益来满足自身需求"
  },
  {
    "start": 944.01,
    "end": 946.29,
    "text": "会有什么后果"
  },
  {
    "start": 946.29,
    "end": 948.65,
    "text": "如果你已经开始意识到"
  },
  {
    "start": 948.65,
    "end": 951.5,
    "text": "睡眠编程的强大力量"
  },
  {
    "start": 951.5,
    "end": 953.94,
    "text": "并认为它是一个捷径"
  },
  {
    "start": 953.94,
    "end": 955.72,
    "text": "那么你非常有可能"
  },
  {
    "start": 955.72,
    "end": 958.5,
    "text": "每过一段时间就会有冲动"
  },
  {
    "start": 958.5,
    "end": 960.27,
    "text": "想把它用在并不是对"
  },
  {
    "start": 960.27,
    "end": 960.64,
    "text": "所有"
  },
  {
    "start": 960.64,
    "end": 962.52,
    "text": "人最有益的事情上"
  },
  {
    "start": 962.52,
    "end": 963.66,
    "text": "然而"
  },
  {
    "start": 963.66,
    "end": 965.38,
    "text": "你必须明白"
  },
  {
    "start": 965.38,
    "end": 967.33,
    "text": "这样做就是在干涉和改变"
  },
  {
    "start": 967.33,
    "end": 969.32,
    "text": "其他人的生命计划"
  },
  {
    "start": 969.32,
    "end": 972.95,
    "text": "你实际上是按照自己的价值观"
  },
  {
    "start": 972.95,
    "end": 975.71,
    "text": "在评判和改变他们的人生道路"
  },
  {
    "start": 975.71,
    "end": 978.47,
    "text": "通过使用睡眠编程"
  },
  {
    "start": 978.47,
    "end": 981.4,
    "text": "你将他人从他们原本设计好的路径"
  },
  {
    "start": 981.4,
    "end": 982.73,
    "text": "推向混乱"
  },
  {
    "start": 982.73,
    "end": 985.93,
    "text": "尽管结果可能是你想要的"
  },
  {
    "start": 985.93,
    "end": 988.94,
    "text": "但它可能并不是别人的最初计划"
  },
  {
    "start": 988.94,
    "end": 990.83,
    "text": "你必须了解"
  },
  {
    "start": 990.83,
    "end": 993.39,
    "text": "你是为了所有相关人的最大利益"
  },
  {
    "start": 993.39,
    "end": 995.33,
    "text": "而使用睡眠编程"
  },
  {
    "start": 995.33,
    "end": 996.67,
    "text": "否则"
  },
  {
    "start": 996.67,
    "end": 999.67,
    "text": "你将会吸引业力到自己身上——"
  },
  {
    "start": 999.67,
    "end": 1002.59,
    "text": "当你改变了另一个人的生命计划后"
  },
  {
    "start": 1002.59,
    "end": 1006.02,
    "text": "你自己的生命计划也必须随之改变"
  },
  {
    "start": 1006.02,
    "end": 1007.84,
    "text": "这就是后果"
  },
  {
    "start": 1007.84,
    "end": 1009.89,
    "text": "就像蝴蝶效应一样"
  },
  {
    "start": 1009.89,
    "end": 1011.83,
    "text": "在能量层面"
  },
  {
    "start": 1011.83,
    "end": 1014.08,
    "text": "你已经创造了一个空间"
  },
  {
    "start": 1014.08,
    "end": 1016.51,
    "text": "集体意识的振动系统"
  },
  {
    "start": 1016.51,
    "end": 1019.99,
    "text": "在那里以一种变调的振动方式开始运作"
  },
  {
    "start": 1019.99,
    "end": 1021.29,
    "text": "因此"
  },
  {
    "start": 1021.29,
    "end": 1024.73,
    "text": "在那个特殊振动范围内的每一个人"
  },
  {
    "start": 1024.73,
    "end": 1027.15,
    "text": "都会开始感受到它的影响"
  },
  {
    "start": 1027.15,
    "end": 1029.1,
    "text": "所以请牢记"
  },
  {
    "start": 1029.1,
    "end": 1031.61,
    "text": "你要做的不是改变他人的生命体或生"
  },
  {
    "start": 1031.61,
    "end": 1032.99,
    "text": "命计划"
  },
  {
    "start": 1032.99,
    "end": 1035.38,
    "text": "而是请你的高我来协助——"
  },
  {
    "start": 1035.38,
    "end": 1037.66,
    "text": "打破人们之间的藩篱"
  },
  {
    "start": 1037.66,
    "end": 1039.55,
    "text": "软化对方的立场"
  },
  {
    "start": 1039.55,
    "end": 1042.6,
    "text": "这可能需要长久的时间"
  },
  {
    "start": 1042.6,
    "end": 1045.25,
    "text": "但“耐心”是你在这个星球上"
  },
  {
    "start": 1045.25,
    "end": 1048.26,
    "text": "常常需要学习的课题"
  },
  {
    "start": 1048.26,
    "end": 1052.09,
    "text": "保护机制"
  },
  {
    "start": 1052.09,
    "end": 1055.78,
    "text": "假如有人试图用睡眠编程来影响你"
  },
  {
    "start": 1055.78,
    "end": 1057.46,
    "text": "怎么办"
  },
  {
    "start": 1057.46,
    "end": 1060.61,
    "text": "无论如何你始终受到保护"
  },
  {
    "start": 1060.61,
    "end": 1063.56,
    "text": "你确实受到整个系统的保护"
  },
  {
    "start": 1063.56,
    "end": 1067.27,
    "text": "其中一个更微妙和更令人惊讶的保护机制"
  },
  {
    "start": 1067.27,
    "end": 1069.12,
    "text": "是自我系统——"
  },
  {
    "start": 1069.12,
    "end": 1071.38,
    "text": "自我是你的最后防线"
  },
  {
    "start": 1071.38,
    "end": 1072.64,
    "text": "因此"
  },
  {
    "start": 1072.64,
    "end": 1072.92,
    "text": "你不"
  },
  {
    "start": 1072.92,
    "end": 1073.26,
    "text": "会依"
  },
  {
    "start": 1073.26,
    "end": 1076.45,
    "text": "照别人对你的设定来行动"
  },
  {
    "start": 1076.45,
    "end": 1079.24,
    "text": "因为那不符合你当下的特定计划"
  },
  {
    "start": 1079.24,
    "end": 1080.64,
    "text": "所以"
  },
  {
    "start": 1080.64,
    "end": 1083.99,
    "text": "对于睡眠编程这种外来的力量"
  },
  {
    "start": 1083.99,
    "end": 1085.62,
    "text": "你是绝对安全的"
  },
  {
    "start": 1086.01,
    "end": 1091.69,
    "text": "暮雨·注这里是不是与前面的理论（会改变别人的生命计划）相矛盾"
  },
  {
    "start": 1091.69,
    "end": 1095.35,
    "text": "也许这就是大角星人最迷恋的悖论吧"
  },
  {
    "start": 1097.35,
    "end": 1101.52,
    "text": "如何发挥睡眠编程的最高潜能"
  },
  {
    "start": 1101.52,
    "end": 1102.86,
    "text": "首先"
  },
  {
    "start": 1102.86,
    "end": 1106.18,
    "text": "建议你最好把它应用于那些长远的"
  },
  {
    "start": 1106.18,
    "end": 1107.91,
    "text": "且真正会助益你生命的"
  },
  {
    "start": 1107.91,
    "end": 1108.86,
    "text": "事情上"
  },
  {
    "start": 1108.86,
    "end": 1109.99,
    "text": "此外"
  },
  {
    "start": 1109.99,
    "end": 1112.23,
    "text": "重要的是你的意图——"
  },
  {
    "start": 1112.23,
    "end": 1113.96,
    "text": "你的动机或目的"
  },
  {
    "start": 1113.96,
    "end": 1115.63,
    "text": "以及你的坚定程度"
  },
  {
    "start": 1115.63,
    "end": 1117.15,
    "text": "事实上"
  },
  {
    "start": 1117.15,
    "end": 1118.95,
    "text": "你的意愿会为你带来最高"
  },
  {
    "start": 1118.95,
    "end": 1119.39,
    "text": "和最"
  },
  {
    "start": 1119.39,
    "end": 1120.62,
    "text": "详尽的——"
  },
  {
    "start": 1120.62,
    "end": 1122.7,
    "text": "以爱为目的的讯息"
  },
  {
    "start": 1122.7,
    "end": 1125.55,
    "text": "它会提升你和与之相关的人——"
  },
  {
    "start": 1125.55,
    "end": 1127.36,
    "text": "力量和信念"
  },
  {
    "start": 1127.36,
    "end": 1128.59,
    "text": "当然还有爱"
  },
  {
    "start": 1128.98,
    "end": 1129.5,
    "text": "暮雨·注"
  },
  {
    "start": 1129.5,
    "end": 1131.67,
    "text": "《抹大拉手稿》第7集"
  },
  {
    "start": 1131.67,
    "end": 1135.33,
    "text": "探讨了相关的主题"
  },
  {
    "start": 1135.33,
    "end": 1138.22,
    "text": "假如睡眠编程的一切潜力"
  },
  {
    "start": 1138.22,
    "end": 1140.42,
    "text": "被人类充分利用了"
  },
  {
    "start": 1140.42,
    "end": 1142.43,
    "text": "你们将开始意识到"
  },
  {
    "start": 1142.43,
    "end": 1147.27,
    "text": "你们可以不借助电话 电脑或其他任何设备"
  },
  {
    "start": 1147.27,
    "end": 1149.13,
    "text": "就能彼此沟通"
  },
  {
    "start": 1149.13,
    "end": 1151.34,
    "text": "一旦意识到这点"
  },
  {
    "start": 1151.34,
    "end": 1151.78,
    "text": "你们将"
  },
  {
    "start": 1151.78,
    "end": 1155.73,
    "text": "会开始看到它为目前正在进化的世界"
  },
  {
    "start": 1155.73,
    "end": 1157.49,
    "text": "带来什么样的影响"
  },
  {
    "start": 1157.49,
    "end": 1158.07,
    "text": "请"
  },
  {
    "start": 1158.07,
    "end": 1159.48,
    "text": "用睡眠编程"
  },
  {
    "start": 1159.48,
    "end": 1160.95,
    "text": "与你的人类朋友一起"
  },
  {
    "start": 1160.95,
    "end": 1163.94,
    "text": "调整你们的身体 情绪体"
  },
  {
    "start": 1163.94,
    "end": 1165.81,
    "text": "心智体和灵性体"
  },
  {
    "start": 1165.81,
    "end": 1167.8,
    "text": "你也会觉察到"
  },
  {
    "start": 1167.8,
    "end": 1170.36,
    "text": "在这个调整过程中"
  },
  {
    "start": 1170.36,
    "end": 1172.16,
    "text": "你可以如己所愿"
  },
  {
    "start": 1172.16,
    "end": 1175.45,
    "text": "尽力地扩展和提升你的生命"
  },
  {
    "start": 1175.45,
    "end": 1180.47,
    "text": "不要让任何事物阻碍你"
  },
  {
    "start": 1180.47,
    "end": 1182.82,
    "text": "掌握自己的命运"
  },
  {
    "start": 1182.82,
    "end": 1184.83,
    "text": "在地球层面"
  },
  {
    "start": 1184.83,
    "end": 1187.35,
    "text": "有一个大觉醒正在发生"
  },
  {
    "start": 1187.35,
    "end": 1189.76,
    "text": "在整个人类周围蔓延"
  },
  {
    "start": 1189.76,
    "end": 1194.07,
    "text": "这可能是你经历到的最令人振奋的时代"
  },
  {
    "start": 1194.07,
    "end": 1197.54,
    "text": "你有最好的机会去发现各种全新的方式"
  },
  {
    "start": 1197.54,
    "end": 1198.8,
    "text": "参与其中"
  },
  {
    "start": 1198.8,
    "end": 1200.06,
    "text": "不仅在科学"
  },
  {
    "start": 1200.06,
    "end": 1200.72,
    "text": "上"
  },
  {
    "start": 1200.72,
    "end": 1202.68,
    "text": "在灵性层面"
  },
  {
    "start": 1202.68,
    "end": 1205.38,
    "text": "人类越来越能察觉到所有可能"
  },
  {
    "start": 1205.38,
    "end": 1206.61,
    "text": "发生的事"
  },
  {
    "start": 1206.61,
    "end": 1211.24,
    "text": "睡眠编程以及其他十大创造法则"
  },
  {
    "start": 1211.24,
    "end": 1214.38,
    "text": "在你们实际要前往下一个层次时"
  },
  {
    "start": 1214.38,
    "end": 1216.49,
    "text": "是不可或缺的工具"
  },
  {
    "start": 1216.49,
    "end": 1217.65,
    "text": "那么"
  },
  {
    "start": 1217.65,
    "end": 1219.74,
    "text": "什么是下一个层次"
  },
  {
    "start": 1219.74,
    "end": 1222.24,
    "text": "\"下一个层次\"意味着要"
  },
  {
    "start": 1222.24,
    "end": 1224.03,
    "text": "有这样的觉知"
  },
  {
    "start": 1224.03,
    "end": 1226.83,
    "text": "你不能继续做着目前的事"
  },
  {
    "start": 1226.83,
    "end": 1229.62,
    "text": "然后还期望生命会有所改变"
  },
  {
    "start": 1229.62,
    "end": 1232.33,
    "text": "无论你是否参与其中"
  },
  {
    "start": 1232.33,
    "end": 1234.08,
    "text": "生命都会改变"
  },
  {
    "start": 1234.08,
    "end": 1238.1,
    "text": "这个世界正以一个轻快的步伐前进着"
  },
  {
    "start": 1238.1,
    "end": 1238.93,
    "text": "地球正在"
  },
  {
    "start": 1238.93,
    "end": 1240.38,
    "text": "经历的转变"
  },
  {
    "start": 1240.38,
    "end": 1241.56,
    "text": "是超乎任何人"
  },
  {
    "start": 1241.56,
    "end": 1242.73,
    "text": "所能想像的"
  },
  {
    "start": 1242.73,
    "end": 1244.96,
    "text": "我想强调的是"
  },
  {
    "start": 1244.96,
    "end": 1246.39,
    "text": "这个世界的未来"
  },
  {
    "start": 1246.39,
    "end": 1249.6,
    "text": "正在被你们人类集体的觉知改变着"
  },
  {
    "start": 1249.6,
    "end": 1250.56,
    "text": "你——"
  },
  {
    "start": 1250.56,
    "end": 1251.94,
    "text": "就是那个人"
  },
  {
    "start": 1251.94,
    "end": 1254.52,
    "text": "你已经做出了有意识的选择"
  },
  {
    "start": 1254.52,
    "end": 1257.39,
    "text": "决定要前往一个新的觉知层次"
  },
  {
    "start": 1257.39,
    "end": 1260.88,
    "text": "当你最大化地利用睡眠编程时"
  },
  {
    "start": 1260.88,
    "end": 1263.81,
    "text": "它会开始指引你生命的方向"
  },
  {
    "start": 1263.81,
    "end": 1265.57,
    "text": "到达你想要的目的地"
  },
  {
    "start": 1265.57,
    "end": 1267.96,
    "text": "你不再只是毫无目的漂荡的"
  },
  {
    "start": 1267.96,
    "end": 1269.64,
    "text": "集体意识的一部分"
  },
  {
    "start": 1269.64,
    "end": 1273.02,
    "text": "你可以有意识地选择生命的结果"
  },
  {
    "start": 1273.02,
    "end": 1277.18,
    "text": "而睡眠编程能保证你会得到你所期望的结果"
  },
  {
    "start": 1277.18,
    "end": 1280.16,
    "text": "不要让任何事物阻碍你"
  },
  {
    "start": 1280.16,
    "end": 1281.93,
    "text": "你可以掌握自己的命运"
  },
  {
    "start": 1281.93,
    "end": 1283.37,
    "text": "命运——"
  },
  {
    "start": 1283.37,
    "end": 1285.21,
    "text": "只是存在于你们实相中的"
  },
  {
    "start": 1285.21,
    "end": 1287.21,
    "text": "一个简单的意念结果"
  },
  {
    "start": 1287.21,
    "end": 1289.38,
    "text": "你必须掌控它"
  },
  {
    "start": 1289.38,
    "end": 1292.46,
    "text": "务必把“睡眠编程”的潜能发挥到极"
  },
  {
    "start": 1292.46,
    "end": 1294.77,
    "text": "致"
  }
]