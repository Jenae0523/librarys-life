[
  {
    "start": 0.0,
    "end": 2.7,
    "text": "世界三大内在炼金术体系"
  },
  {
    "start": 2.7,
    "end": 7.9,
    "text": "密宗瑜伽 道教内丹术和藏传佛教密宗"
  },
  {
    "start": 7.9,
    "end": 10.566,
    "text": "虽各自拥有独特的发展脉络"
  },
  {
    "start": 10.6,
    "end": 12.133,
    "text": "却与古埃及炼金术"
  },
  {
    "start": 12.133,
    "end": 15.766,
    "text": "在本质上存在诸多共通之处"
  },
  {
    "start": 15.8,
    "end": 18.066,
    "text": "它们如何彼此呼应"
  },
  {
    "start": 18.066,
    "end": 21.933,
    "text": "又分别发展出哪些独特的修行方式"
  },
  {
    "start": 21.966,
    "end": 25.233,
    "text": "正如抹大拉所传授的那样"
  },
  {
    "start": 25.233,
    "end": 27.1,
    "text": "埃及炼金术的核心任务"
  },
  {
    "start": 27.133,
    "end": 29.766,
    "text": "是强化Ka体（能量体）"
  },
  {
    "start": 29.766,
    "end": 33.266,
    "text": "以转化意识并加速个人进化"
  },
  {
    "start": 33.266,
    "end": 38.066,
    "text": "这一过程通过进入高度的狂喜状态来实现"
  },
  {
    "start": 38.1,
    "end": 39.7,
    "text": "因为狂喜与极乐"
  },
  {
    "start": 39.733,
    "end": 43.666,
    "text": "能极大地增强 Ka 体的能量场"
  },
  {
    "start": 43.666,
    "end": 46.033,
    "text": "为了达成这一目标"
  },
  {
    "start": 46.033,
    "end": 50.033,
    "text": "修行者通常会选择两条主要路径"
  },
  {
    "start": 50.066,
    "end": 53.133,
    "text": "1.神圣伴侣关系 ——适"
  },
  {
    "start": 53.133,
    "end": 56.033,
    "text": "用于在亲密关系中修行的人"
  },
  {
    "start": 56.033,
    "end": 58.5,
    "text": "通过实践伊西斯性魔法"
  },
  {
    "start": 58.533,
    "end": 62.233,
    "text": "狂喜会在性爱过程中自然产生"
  },
  {
    "start": 62.233,
    "end": 66.266,
    "text": "2.独自修行 ——适用于个人修炼者"
  },
  {
    "start": 66.3,
    "end": 68.666,
    "text": "他们通过修炼荷鲁斯炼金术"
  },
  {
    "start": 68.666,
    "end": 71.333,
    "text": "直接激发自身内在力量"
  },
  {
    "start": 71.333,
    "end": 73.466,
    "text": "唤醒狂喜状态"
  },
  {
    "start": 73.5,
    "end": 76.3,
    "text": "但无论是独自修行者"
  },
  {
    "start": 76.3,
    "end": 79.433,
    "text": "还是选择走上神圣关系之路"
  },
  {
    "start": 79.433,
    "end": 85.766,
    "text": "本章都将为他们提供重要的参考价值"
  },
  {
    "start": 85.766,
    "end": 86.733,
    "text": "29 00:01:26,766 --> 00:01:30,266 以女性为基础的炼金术"
  },
  {
    "start": 90.266,
    "end": 92.9,
    "text": "熟悉这些炼金术传统的读者"
  },
  {
    "start": 92.9,
    "end": 94.766,
    "text": "或许已经注意到"
  },
  {
    "start": 94.8,
    "end": 98.333,
    "text": "这部手稿对性行为的看法与众不同"
  },
  {
    "start": 98.333,
    "end": 104.2,
    "text": "作为一名研究世界各地炼金术体系与神秘传统的学者"
  },
  {
    "start": 104.2,
    "end": 106.033,
    "text": "这正是抹大拉的教义中"
  },
  {
    "start": 106.033,
    "end": 108.766,
    "text": "最先吸引我注意的地方"
  },
  {
    "start": 108.8,
    "end": 111.2,
    "text": "总结其中的差异——"
  },
  {
    "start": 111.233,
    "end": 113.366,
    "text": "抹大拉所传授的知识"
  },
  {
    "start": 113.4,
    "end": 116.533,
    "text": "本质上是以女性能量为基础的"
  },
  {
    "start": 116.533,
    "end": 118.9,
    "text": "根据抹大拉的说法"
  },
  {
    "start": 118.933,
    "end": 122.7,
    "text": "女性的天性中蕴藏着创造的秘密"
  },
  {
    "start": 122.7,
    "end": 127.3,
    "text": "她提到自己曾接受荷鲁斯炼金术的训练"
  },
  {
    "start": 127.333,
    "end": 131.1,
    "text": "并学习如何通过冥想唤醒昆达里尼"
  },
  {
    "start": 131.133,
    "end": 132.566,
    "text": "然而"
  },
  {
    "start": 132.566,
    "end": 134.533,
    "text": "当她与Yeshua 在一起时"
  },
  {
    "start": 134.533,
    "end": 137.833,
    "text": "尤其是在他们亲密结合的过程中"
  },
  {
    "start": 137.866,
    "end": 142.633,
    "text": "炼金术的转化会自然发生——换句话说"
  },
  {
    "start": 142.633,
    "end": 147.133,
    "text": "炼金术能量会自行激活并彼此交融"
  },
  {
    "start": 147.166,
    "end": 149.4,
    "text": "而无需她主动干预"
  },
  {
    "start": 149.4,
    "end": 152.833,
    "text": "她还详细讲述了一个重要原则"
  },
  {
    "start": 152.833,
    "end": 154.9,
    "text": "女性在与伴侣的关系中"
  },
  {
    "start": 154.933,
    "end": 157.9,
    "text": "必须感到安全和被欣赏"
  },
  {
    "start": 157.9,
    "end": 159.9,
    "text": "只有在这样的前提下"
  },
  {
    "start": 159.9,
    "end": 162.0,
    "text": "伊西斯性魔法所带来的"
  },
  {
    "start": 162.0,
    "end": 165.833,
    "text": "转化性炼金术才会真正发生"
  },
  {
    "start": 165.866,
    "end": 170.966,
    "text": "如果关系中具备了安全感与欣赏这两个要素"
  },
  {
    "start": 170.966,
    "end": 174.133,
    "text": "女性便能够完全敞开心扉"
  },
  {
    "start": 174.166,
    "end": 178.833,
    "text": "让神圣女性能量的奥秘通过她自然展现"
  },
  {
    "start": 178.833,
    "end": 182.733,
    "text": "当这种现象发生于性爱过程中"
  },
  {
    "start": 182.733,
    "end": 184.766,
    "text": "女性通常会颤抖"
  },
  {
    "start": 184.8,
    "end": 187.533,
    "text": "如果她允许这种振颤"
  },
  {
    "start": 187.566,
    "end": 189.366,
    "text": "顺应能量的波动"
  },
  {
    "start": 189.366,
    "end": 193.166,
    "text": "便会更深入地进入神秘的体验"
  },
  {
    "start": 193.2,
    "end": 195.7,
    "text": "如果男性能够训练自己"
  },
  {
    "start": 195.7,
    "end": 198.666,
    "text": "融入伴侣释放的振动能量中"
  },
  {
    "start": 198.7,
    "end": 206.633,
    "text": "那么二者便可以共同强化各自的Ka体（这正是埃及炼金术的核心目标之一）"
  },
  {
    "start": 206.633,
    "end": 210.266,
    "text": "这一炼金术体系的独特之处在于"
  },
  {
    "start": 210.3,
    "end": 213.233,
    "text": "女性在其中占据核心地位"
  },
  {
    "start": 213.233,
    "end": 218.633,
    "text": "这与许多其他炼金术传统截然不同"
  },
  {
    "start": 218.666,
    "end": 219.633,
    "text": "70 00:03:39,666 --> 00:03:43,133 男性主导的炼金术系统"
  },
  {
    "start": 223.166,
    "end": 225.2,
    "text": "・道教"
  },
  {
    "start": 225.2,
    "end": 227.7,
    "text": "世界上的主要炼金术体系"
  },
  {
    "start": 227.733,
    "end": 230.266,
    "text": "都明显偏向男性"
  },
  {
    "start": 230.3,
    "end": 231.733,
    "text": "例如"
  },
  {
    "start": 231.766,
    "end": 233.433,
    "text": "在道教典籍中"
  },
  {
    "start": 233.466,
    "end": 235.666,
    "text": "关于男性修行的书面指导"
  },
  {
    "start": 235.666,
    "end": 238.3,
    "text": "远多于针对女性的内容"
  },
  {
    "start": 238.333,
    "end": 242.466,
    "text": "尽管有些人认为道教是母系教派"
  },
  {
    "start": 242.466,
    "end": 246.3,
    "text": "但在实践中（至少在过去几百年间）"
  },
  {
    "start": 246.333,
    "end": 247.8,
    "text": "大部分修行的重点"
  },
  {
    "start": 247.833,
    "end": 250.9,
    "text": "都集中在男性修行者身上"
  },
  {
    "start": 250.9,
    "end": 252.8,
    "text": "毫无疑问"
  },
  {
    "start": 252.8,
    "end": 256.733,
    "text": "中国历史上存在高度发展的女性修行者"
  },
  {
    "start": 256.766,
    "end": 263.6,
    "text": "但她们的身影在道教炼金术典籍中并不常见（尽管也有一些例外）"
  },
  {
    "start": 263.6,
    "end": 265.2,
    "text": "事实上"
  },
  {
    "start": 265.2,
    "end": 267.2,
    "text": "在过去几个世纪里"
  },
  {
    "start": 267.233,
    "end": 269.066,
    "text": "部分修炼双修的道士"
  },
  {
    "start": 269.066,
    "end": 271.433,
    "text": "将女性视为气 的容器 ——"
  },
  {
    "start": 271.466,
    "end": 274.566,
    "text": "仅仅为了吸取女性 多余的气"
  },
  {
    "start": 274.566,
    "end": 277.833,
    "text": "而很少考虑女性的感受和安全"
  },
  {
    "start": 277.866,
    "end": 280.6,
    "text": "这种不道德的修行方式"
  },
  {
    "start": 280.6,
    "end": 286.6,
    "text": "反映了当时道教性炼金术中的性别偏见"
  },
  {
    "start": 286.633,
    "end": 287.6,
    "text": "94 00:04:47,633 --> 00:04:50,233 ・藏传佛教"
  },
  {
    "start": 290.266,
    "end": 292.733,
    "text": "藏传佛教中"
  },
  {
    "start": 292.733,
    "end": 296.366,
    "text": "女性能量在理论上受到高度尊崇"
  },
  {
    "start": 296.4,
    "end": 298.4,
    "text": "但在实际运作中"
  },
  {
    "start": 298.4,
    "end": 302.666,
    "text": "女性往往被置于权力和地位较低的位置"
  },
  {
    "start": 302.666,
    "end": 304.333,
    "text": "例如"
  },
  {
    "start": 304.366,
    "end": 308.7,
    "text": "度母是一位历史上真实生活在藏地的女性"
  },
  {
    "start": 308.733,
    "end": 311.466,
    "text": "她也是藏传佛教的大菩萨"
  },
  {
    "start": 311.466,
    "end": 312.966,
    "text": "据传"
  },
  {
    "start": 312.966,
    "end": 315.0,
    "text": "当她证得开悟时"
  },
  {
    "start": 315.0,
    "end": 318.866,
    "text": "一群喇嘛感知到世间出现了一位开悟者"
  },
  {
    "start": 318.9,
    "end": 321.933,
    "text": "便前往寻找这道新生的光明"
  },
  {
    "start": 321.966,
    "end": 323.266,
    "text": "然而"
  },
  {
    "start": 323.266,
    "end": 326.133,
    "text": "当他们追踪光源来到她的村庄"
  },
  {
    "start": 326.133,
    "end": 328.366,
    "text": "发现她是一个女人时"
  },
  {
    "start": 328.4,
    "end": 329.666,
    "text": "顿感失望"
  },
  {
    "start": 329.666,
    "end": 332.533,
    "text": "对她说 现在你已开悟"
  },
  {
    "start": 332.566,
    "end": 335.266,
    "text": "那你可以转世为一个男人了"
  },
  {
    "start": 335.3,
    "end": 336.833,
    "text": "然而"
  },
  {
    "start": 336.833,
    "end": 338.766,
    "text": "度母坚定地回应"
  },
  {
    "start": 338.8,
    "end": 341.666,
    "text": "我将永远以女性形态存在"
  },
  {
    "start": 341.866,
    "end": 343.433,
    "text": "直到今天"
  },
  {
    "start": 343.466,
    "end": 347.766,
    "text": "她仍然以女性的形象居住在一个微妙的领域——"
  },
  {
    "start": 347.766,
    "end": 350.6,
    "text": "被西藏人称为报身界"
  },
  {
    "start": 350.633,
    "end": 354.0,
    "text": "一个纯净的光与声音的领域"
  },
  {
    "start": 354.0,
    "end": 357.366,
    "text": "她被尊称为迅速的救度者"
  },
  {
    "start": 357.366,
    "end": 360.933,
    "text": "以其迅速救度众生的力量而闻名"
  },
  {
    "start": 360.966,
    "end": 364.366,
    "text": "是一位强大而慈悲的觉悟者"
  },
  {
    "start": 364.366,
    "end": 365.866,
    "text": "然而"
  },
  {
    "start": 365.866,
    "end": 369.866,
    "text": "男性优越感——这种根深蒂固的观念"
  },
  {
    "start": 369.9,
    "end": 373.166,
    "text": "不仅存在于藏传佛教的某些方面"
  },
  {
    "start": 373.2,
    "end": 377.933,
    "text": "也深植于整个佛教体系之中"
  },
  {
    "start": 377.966,
    "end": 378.933,
    "text": "127 00:06:18,933 --> 00:06:21,633 ・密宗瑜伽"
  },
  {
    "start": 381.666,
    "end": 384.5,
    "text": "起源于印度的密宗瑜伽"
  },
  {
    "start": 384.5,
    "end": 386.733,
    "text": "其性别观念相对复杂"
  },
  {
    "start": 386.766,
    "end": 388.466,
    "text": "虽然理论上强调"
  },
  {
    "start": 388.466,
    "end": 391.9,
    "text": "男性和女性能量的互补与平衡"
  },
  {
    "start": 391.933,
    "end": 394.1,
    "text": "但在传统的实践中"
  },
  {
    "start": 394.1,
    "end": 397.466,
    "text": "男性和女性的角色存在不平等"
  },
  {
    "start": 397.5,
    "end": 401.766,
    "text": "男性瑜伽士往往占据更为主导的地位"
  },
  {
    "start": 401.766,
    "end": 403.966,
    "text": "被视为能量的引导者"
  },
  {
    "start": 403.966,
    "end": 407.633,
    "text": "他们通过与女性的结合来转化能量"
  },
  {
    "start": 407.666,
    "end": 413.566,
    "text": "而女性则更多承担能量激发或容器的角色"
  },
  {
    "start": 413.566,
    "end": 415.566,
    "text": "这种结构导致男性"
  },
  {
    "start": 415.566,
    "end": 418.633,
    "text": "在实践中拥有更高的主导权"
  },
  {
    "start": 418.633,
    "end": 420.066,
    "text": "然而"
  },
  {
    "start": 420.066,
    "end": 423.233,
    "text": "随着现代性别平等观念的兴起"
  },
  {
    "start": 423.233,
    "end": 426.9,
    "text": "密宗瑜伽的性别界限正在逐步打破"
  },
  {
    "start": 426.933,
    "end": 429.266,
    "text": "越来越多的女性瑜伽士"
  },
  {
    "start": 429.266,
    "end": 432.233,
    "text": "开始获得平等的修行地位"
  },
  {
    "start": 432.266,
    "end": 437.2,
    "text": "不再受限于传统性别角色的划分"
  },
  {
    "start": 437.2,
    "end": 438.166,
    "text": "147 00:07:18,200 --> 00:07:22,333 基督教剥夺妇女权利的历史"
  },
  {
    "start": 442.366,
    "end": 444.433,
    "text": "纵观基督教历史"
  },
  {
    "start": 444.433,
    "end": 446.133,
    "text": "可以清晰地看到"
  },
  {
    "start": 446.166,
    "end": 448.466,
    "text": "教会如何在制度和典籍中"
  },
  {
    "start": 448.466,
    "end": 450.733,
    "text": "削弱女性的地位"
  },
  {
    "start": 450.766,
    "end": 452.9,
    "text": "在黑暗时代"
  },
  {
    "start": 452.9,
    "end": 455.2,
    "text": "教会召开了尼西亚会议"
  },
  {
    "start": 455.233,
    "end": 457.066,
    "text": "试图整合早期基督教的"
  },
  {
    "start": 457.066,
    "end": 459.466,
    "text": "大量福音书和圣典"
  },
  {
    "start": 459.466,
    "end": 463.066,
    "text": "在罗马皇帝君士坦丁的命令下"
  },
  {
    "start": 463.1,
    "end": 466.933,
    "text": "会议负责决定——从众多经文中挑选出"
  },
  {
    "start": 466.933,
    "end": 469.733,
    "text": "哪些可以纳入《新约》"
  },
  {
    "start": 469.766,
    "end": 472.266,
    "text": "哪些则应被摒弃"
  },
  {
    "start": 472.266,
    "end": 473.633,
    "text": "最终"
  },
  {
    "start": 473.666,
    "end": 476.966,
    "text": "许多原始的神圣文本被舍弃"
  },
  {
    "start": 477.0,
    "end": 480.9,
    "text": "教会只保留了符合其自身统治目标的经文"
  },
  {
    "start": 480.9,
    "end": 483.766,
    "text": "随着教会权力的扩张"
  },
  {
    "start": 483.766,
    "end": 485.733,
    "text": "基督教早期的神秘传统"
  },
  {
    "start": 485.733,
    "end": 488.433,
    "text": "逐渐被政治利益取代"
  },
  {
    "start": 488.466,
    "end": 490.566,
    "text": "在此过程中"
  },
  {
    "start": 490.6,
    "end": 492.433,
    "text": "许多尊崇女性的典籍"
  },
  {
    "start": 492.433,
    "end": 495.966,
    "text": "被贴上异端邪说的标签"
  },
  {
    "start": 496.0,
    "end": 498.533,
    "text": "而罗马天主教会随即展开了"
  },
  {
    "start": 498.533,
    "end": 502.033,
    "text": "一场压制女性权利的长期运动"
  },
  {
    "start": 502.066,
    "end": 503.633,
    "text": "在中世纪"
  },
  {
    "start": 503.633,
    "end": 506.3,
    "text": "尤其是宗教裁判所时期"
  },
  {
    "start": 506.333,
    "end": 511.666,
    "text": "教会频繁将被指控为女巫的女性施以火刑"
  },
  {
    "start": 511.666,
    "end": 514.133,
    "text": "而所谓的女巫"
  },
  {
    "start": 514.166,
    "end": 517.566,
    "text": "往往只是草药医生或民间治疗师"
  },
  {
    "start": 517.6,
    "end": 519.333,
    "text": "事实上"
  },
  {
    "start": 519.333,
    "end": 523.033,
    "text": "任何敢于挑战教会父权权威的女性"
  },
  {
    "start": 523.066,
    "end": 526.933,
    "text": "都有可能面临残酷的死亡威胁"
  },
  {
    "start": 526.966,
    "end": 529.933,
    "text": "虽然现代教会在表面上"
  },
  {
    "start": 529.933,
    "end": 533.9,
    "text": "已不再以如此极端的方式剥夺女性权利"
  },
  {
    "start": 533.933,
    "end": 537.8,
    "text": "但这一体系中的性别不平等依然存在"
  },
  {
    "start": 537.8,
    "end": 543.733,
    "text": "只是方式变得更加隐晦而不易察觉"
  },
  {
    "start": 543.733,
    "end": 544.7,
    "text": "184 00:09:04,733 --> 00:09:08,666 本土文化对宗教有什么影响"
  },
  {
    "start": 548.666,
    "end": 551.133,
    "text": "宗教与文化之间的关系"
  },
  {
    "start": 551.166,
    "end": 554.133,
    "text": "如同一幅紧密编织的挂毯"
  },
  {
    "start": 554.166,
    "end": 556.933,
    "text": "相互交织 彼此塑造"
  },
  {
    "start": 556.933,
    "end": 560.533,
    "text": "宗教信仰渗透进本土文化"
  },
  {
    "start": 560.566,
    "end": 564.966,
    "text": "而文化的价值观也反过来影响宗教的演变"
  },
  {
    "start": 564.966,
    "end": 568.833,
    "text": "这两者在许多层面上密不可分"
  },
  {
    "start": 568.833,
    "end": 570.166,
    "text": "同样"
  },
  {
    "start": 570.2,
    "end": 572.6,
    "text": "起源于宗教洞见的神秘传统"
  },
  {
    "start": 572.633,
    "end": 574.633,
    "text": "与炼金术体系"
  },
  {
    "start": 574.633,
    "end": 577.666,
    "text": "理论上应当超越世俗问题"
  },
  {
    "start": 577.666,
    "end": 579.3,
    "text": "然而在现实中"
  },
  {
    "start": 579.333,
    "end": 583.9,
    "text": "它们依然受到特定文化假设的深刻影响"
  },
  {
    "start": 583.933,
    "end": 585.266,
    "text": "因此"
  },
  {
    "start": 585.266,
    "end": 586.633,
    "text": "我们可以看到"
  },
  {
    "start": 586.666,
    "end": 588.0,
    "text": "男性主导的观念"
  },
  {
    "start": 588.0,
    "end": 591.6,
    "text": "不仅塑造了世俗社会的权力结构"
  },
  {
    "start": 591.6,
    "end": 594.133,
    "text": "也深深烙印在世界各地的"
  },
  {
    "start": 594.166,
    "end": 599.166,
    "text": "神秘学和炼金术体系之中"
  },
  {
    "start": 599.2,
    "end": 600.166,
    "text": "204 00:10:00,166 --> 00:10:03,300 整合与借鉴"
  },
  {
    "start": 603.333,
    "end": 607.566,
    "text": "作为一本旨在传授炼金术体系的文本"
  },
  {
    "start": 607.566,
    "end": 610.966,
    "text": "《抹大拉手稿》的独特之处在于"
  },
  {
    "start": 611.0,
    "end": 614.766,
    "text": "其方法论深受女性神秘传统的影响"
  },
  {
    "start": 614.8,
    "end": 616.666,
    "text": "这或许因为它与"
  },
  {
    "start": 616.666,
    "end": 620.5,
    "text": "古埃及伊西斯信仰的渊源密切相关"
  },
  {
    "start": 620.5,
    "end": 623.433,
    "text": "手稿中的部分炼金术理论"
  },
  {
    "start": 623.466,
    "end": 625.433,
    "text": "与世界各大炼金术流派"
  },
  {
    "start": 625.433,
    "end": 627.8,
    "text": "或传承体系相一致"
  },
  {
    "start": 627.833,
    "end": 629.3,
    "text": "然而"
  },
  {
    "start": 629.3,
    "end": 632.566,
    "text": "其中某些观点则与传统炼金术体系"
  },
  {
    "start": 632.6,
    "end": 634.9,
    "text": "存在显著差异"
  },
  {
    "start": 634.9,
    "end": 636.4,
    "text": "例如"
  },
  {
    "start": 636.433,
    "end": 640.066,
    "text": "手稿高度重视伴侣之间的亲密关系"
  },
  {
    "start": 640.1,
    "end": 643.266,
    "text": "在其炼金术体系中"
  },
  {
    "start": 643.266,
    "end": 647.666,
    "text": "性行为不仅仅是激活特定炼金过程的工具"
  },
  {
    "start": 647.666,
    "end": 650.6,
    "text": "而是一种建立在情感与精神联结"
  },
  {
    "start": 650.633,
    "end": 653.166,
    "text": "基础上的神圣实践"
  },
  {
    "start": 653.166,
    "end": 656.2,
    "text": "男女之间的深层情感联结"
  },
  {
    "start": 656.233,
    "end": 659.366,
    "text": "被视为炼金术转化的基础"
  },
  {
    "start": 659.366,
    "end": 660.8,
    "text": "此外"
  },
  {
    "start": 660.8,
    "end": 662.266,
    "text": "手稿认为"
  },
  {
    "start": 662.266,
    "end": 664.0,
    "text": "女性天生掌握着"
  },
  {
    "start": 664.0,
    "end": 667.133,
    "text": "某些炼金术转化的关键钥匙"
  },
  {
    "start": 667.166,
    "end": 671.566,
    "text": "而这些钥匙无法通过强迫或掠夺获得"
  },
  {
    "start": 671.566,
    "end": 675.6,
    "text": "只有在亲密关系中建立了安全感与爱时"
  },
  {
    "start": 675.6,
    "end": 678.033,
    "text": "它们才会自然显现"
  },
  {
    "start": 678.033,
    "end": 679.766,
    "text": "这种观点"
  },
  {
    "start": 679.8,
    "end": 684.2,
    "text": "使得手稿在众多炼金术体系中独树一帜"
  },
  {
    "start": 684.233,
    "end": 687.033,
    "text": "我深信协同作用的力量"
  },
  {
    "start": 687.033,
    "end": 689.866,
    "text": "因此建议那些研究手稿的人"
  },
  {
    "start": 689.9,
    "end": 692.2,
    "text": "也应当了解当代可接触到的"
  },
  {
    "start": 692.2,
    "end": 694.666,
    "text": "其他主要炼金术体系"
  },
  {
    "start": 694.7,
    "end": 696.5,
    "text": "换句话说"
  },
  {
    "start": 696.533,
    "end": 698.233,
    "text": "我们应当将手稿置于"
  },
  {
    "start": 698.266,
    "end": 701.033,
    "text": "更广阔的炼金术背景之中"
  },
  {
    "start": 701.033,
    "end": 703.766,
    "text": "以便更全面地理解其内涵"
  },
  {
    "start": 703.8,
    "end": 705.3,
    "text": "因此"
  },
  {
    "start": 705.3,
    "end": 708.266,
    "text": "接下来我将分三章简要概述"
  },
  {
    "start": 708.3,
    "end": 711.1,
    "text": "其他三大内在炼金术流派"
  },
  {
    "start": 711.1,
    "end": 715.6,
    "text": "尤其是 它们在性炼金术方面的 核心观点"
  },
  {
    "start": 715.6,
    "end": 717.066,
    "text": "我希望"
  },
  {
    "start": 717.1,
    "end": 721.2,
    "text": "这能为有兴趣的读者提供更宽广的视角"
  },
  {
    "start": 721.2,
    "end": 724.366,
    "text": "帮助他们更好地理解手稿的意义"
  },
  {
    "start": 724.4,
    "end": 727.3,
    "text": "并更有效地运用其中的实践"
  },
  {
    "start": 727.3,
    "end": 731.4,
    "text": "以促进自身成长"
  }
]