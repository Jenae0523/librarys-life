[
  {
    "start": 0.966,
    "end": 3.966,
    "text": "《大角星人文摘》 Ektara（科学官）"
  },
  {
    "start": 8.5,
    "end": 10.766,
    "text": "去掉无知的神秘"
  },
  {
    "start": 10.8,
    "end": 14.933,
    "text": "从5维现实到3维现实进行交流的悖论"
  },
  {
    "start": 14.966,
    "end": 17.033,
    "text": "类似于一个氢原子"
  },
  {
    "start": 17.033,
    "end": 18.9,
    "text": "它拥有一个电子"
  },
  {
    "start": 18.933,
    "end": 20.733,
    "text": "包含潜在的纽带"
  },
  {
    "start": 20.766,
    "end": 23.066,
    "text": "就像人类存有一样"
  },
  {
    "start": 23.1,
    "end": 26.333,
    "text": "氢原子存在于自己的特殊空间里"
  },
  {
    "start": 26.333,
    "end": 29.866,
    "text": "它们不时地与其它原子结构结合"
  },
  {
    "start": 29.866,
    "end": 32.8,
    "text": "以创造新的排列和新的可能"
  },
  {
    "start": 32.833,
    "end": 33.933,
    "text": "例如"
  },
  {
    "start": 33.933,
    "end": 34.966,
    "text": "氢和氧"
  },
  {
    "start": 35.0,
    "end": 36.333,
    "text": "分开来看"
  },
  {
    "start": 36.366,
    "end": 40.133,
    "text": "这两种气体都是短暂的 高度瞬变的"
  },
  {
    "start": 40.133,
    "end": 42.8,
    "text": "但当它们结合在一起时"
  },
  {
    "start": 42.833,
    "end": 46.366,
    "text": "它们会完全转变成另一种不同的状态"
  },
  {
    "start": 46.366,
    "end": 47.733,
    "text": "你们称之为水"
  },
  {
    "start": 47.766,
    "end": 49.5,
    "text": "从外太空看"
  },
  {
    "start": 49.533,
    "end": 52.566,
    "text": "水是你们星球视觉品质的特征"
  },
  {
    "start": 52.566,
    "end": 55.333,
    "text": "就空间感知的角度而言"
  },
  {
    "start": 55.366,
    "end": 57.7,
    "text": "你们的星球主要是蓝色的"
  },
  {
    "start": 57.7,
    "end": 59.366,
    "text": "像人类一样"
  },
  {
    "start": 59.366,
    "end": 62.6,
    "text": "水也不了解它自己的根源或者结构"
  },
  {
    "start": 62.6,
    "end": 64.633,
    "text": "如果水有意识"
  },
  {
    "start": 64.666,
    "end": 66.633,
    "text": "类似人类的意识"
  },
  {
    "start": 66.633,
    "end": 68.0,
    "text": "它可能会明白"
  },
  {
    "start": 68.0,
    "end": 70.733,
    "text": "它覆盖了地球表面的三分之二"
  },
  {
    "start": 70.766,
    "end": 72.533,
    "text": "这是它的现实"
  },
  {
    "start": 72.566,
    "end": 73.433,
    "text": "但是"
  },
  {
    "start": 73.433,
    "end": 78.933,
    "text": "它既不理解它是由于两种气体偶然结合而产生的事实"
  },
  {
    "start": 78.933,
    "end": 82.8,
    "text": "也不理解3维现实仅仅是一种可能"
  },
  {
    "start": 82.833,
    "end": 86.466,
    "text": "只有那些从外太空观察你们行星的人"
  },
  {
    "start": 86.466,
    "end": 89.4,
    "text": "才有可能了解行星的轨道性质"
  },
  {
    "start": 89.433,
    "end": 91.533,
    "text": "和它表面的明亮颜色"
  },
  {
    "start": 91.566,
    "end": 93.366,
    "text": "从历史上看"
  },
  {
    "start": 93.366,
    "end": 95.666,
    "text": "我们把人类进入太空探险"
  },
  {
    "start": 95.666,
    "end": 99.6,
    "text": "和人类从太空的角度第一次感知地球"
  },
  {
    "start": 99.633,
    "end": 102.166,
    "text": "视为扩展人类意识的基准"
  },
  {
    "start": 102.166,
    "end": 105.966,
    "text": "从外太空观看这些地球拼图的人类"
  },
  {
    "start": 106.0,
    "end": 108.333,
    "text": "他们的想象力发生了变化"
  },
  {
    "start": 108.333,
    "end": 112.166,
    "text": "除了那些最顽固 最无知的人以外"
  },
  {
    "start": 112.2,
    "end": 114.5,
    "text": "任何个人都能清楚地看到"
  },
  {
    "start": 114.5,
    "end": 116.833,
    "text": "纤细和脆弱的大自然"
  },
  {
    "start": 116.866,
    "end": 118.966,
    "text": "以及地球的精致之美"
  },
  {
    "start": 118.966,
    "end": 121.433,
    "text": "这种简单的感知转变"
  },
  {
    "start": 121.466,
    "end": 123.466,
    "text": "从外太空看地球"
  },
  {
    "start": 123.466,
    "end": 127.1,
    "text": "开启了一扇通往更高行星意识的大门"
  },
  {
    "start": 127.133,
    "end": 129.166,
    "text": "这种感知的转变"
  },
  {
    "start": 129.166,
    "end": 132.166,
    "text": "从外太空观察你们行星的能力"
  },
  {
    "start": 132.2,
    "end": 134.266,
    "text": "是向前迈出的一步"
  },
  {
    "start": 134.3,
    "end": 137.933,
    "text": "但这种视角仍然仅限于3维现实"
  },
  {
    "start": 137.933,
    "end": 139.9,
    "text": "作为人类存有"
  },
  {
    "start": 139.933,
    "end": 142.733,
    "text": "你面临的困难中有一种催眠"
  },
  {
    "start": 142.733,
    "end": 146.133,
    "text": "那是由于你的大脑和神经系统的运作"
  },
  {
    "start": 146.133,
    "end": 149.033,
    "text": "你相信你对世界的感官经验"
  },
  {
    "start": 149.066,
    "end": 150.8,
    "text": "是现实的全部"
  },
  {
    "start": 150.8,
    "end": 152.566,
    "text": "但事实并非如此"
  },
  {
    "start": 152.566,
    "end": 156.0,
    "text": "你生活在一个比你想象的更广阔"
  },
  {
    "start": 156.033,
    "end": 157.1,
    "text": "更复杂"
  },
  {
    "start": 157.1,
    "end": 159.933,
    "text": "更神秘 更奇怪的宇宙中"
  },
  {
    "start": 159.966,
    "end": 161.733,
    "text": "你的视觉能力是"
  },
  {
    "start": 161.733,
    "end": 164.366,
    "text": "视觉神经和大脑视觉中枢"
  },
  {
    "start": 164.366,
    "end": 166.133,
    "text": "进化发展的结果"
  },
  {
    "start": 166.133,
    "end": 168.6,
    "text": "但这些复杂的神经结构"
  },
  {
    "start": 168.6,
    "end": 171.9,
    "text": "只能感知到非常狭窄的能量频谱"
  },
  {
    "start": 171.933,
    "end": 174.2,
    "text": "在没有帮助的情况下"
  },
  {
    "start": 174.2,
    "end": 178.5,
    "text": "你无法看到紫外线 x射线或伽玛射线"
  },
  {
    "start": 178.533,
    "end": 182.3,
    "text": "更不用说你的科学还没有发现的更高光谱"
  },
  {
    "start": 182.3,
    "end": 183.366,
    "text": "但是"
  },
  {
    "start": 183.366,
    "end": 184.933,
    "text": "由于你对这个世界的"
  },
  {
    "start": 184.966,
    "end": 187.333,
    "text": "感官体验是如此之广"
  },
  {
    "start": 187.333,
    "end": 189.8,
    "text": "以至于你相信它是真实的"
  },
  {
    "start": 189.8,
    "end": 193.533,
    "text": "但无论你是通过你的眼睛 你的耳朵"
  },
  {
    "start": 193.566,
    "end": 194.7,
    "text": "你的味觉"
  },
  {
    "start": 194.7,
    "end": 197.9,
    "text": "你的嗅觉 你的触觉所感知的"
  },
  {
    "start": 197.9,
    "end": 201.866,
    "text": "所有这些都只是你面前的一小部分"
  },
  {
    "start": 201.9,
    "end": 203.866,
    "text": "79 00:03:23,900 --> 00:03:26,400 依附地球的智能体"
  },
  {
    "start": 206.4,
    "end": 208.133,
    "text": "在这个地球上"
  },
  {
    "start": 208.166,
    "end": 210.833,
    "text": "在电磁频谱的其它部分中"
  },
  {
    "start": 210.833,
    "end": 213.5,
    "text": "存在着你们感知不到的存有"
  },
  {
    "start": 213.5,
    "end": 215.9,
    "text": "但是他们在你们中间行走"
  },
  {
    "start": 215.9,
    "end": 217.433,
    "text": "在你们中间移动"
  },
  {
    "start": 217.466,
    "end": 222.3,
    "text": "我们这里谈论的不是来自外太空的非行星智能体"
  },
  {
    "start": 222.3,
    "end": 224.233,
    "text": "稍后我们会讲到他们"
  },
  {
    "start": 224.266,
    "end": 225.933,
    "text": "我们现在谈论的是"
  },
  {
    "start": 225.933,
    "end": 228.333,
    "text": "你们星球上的共同居住者"
  },
  {
    "start": 228.366,
    "end": 230.3,
    "text": "如果你们训练自己"
  },
  {
    "start": 230.3,
    "end": 233.2,
    "text": "去感知周围更大的可能宇宙"
  },
  {
    "start": 233.2,
    "end": 236.266,
    "text": "那么你们可能会发现我们所说的真相"
  },
  {
    "start": 236.266,
    "end": 237.333,
    "text": "但是"
  },
  {
    "start": 237.366,
    "end": 240.366,
    "text": "对于你们中那些被囚禁和被制约"
  },
  {
    "start": 240.366,
    "end": 243.433,
    "text": "以适应地心引力束缚的人来说"
  },
  {
    "start": 243.433,
    "end": 246.5,
    "text": "我们的话听起来一定像是一种神话"
  },
  {
    "start": 246.5,
    "end": 249.9,
    "text": "你们遍及世界的萨满传统都知道"
  },
  {
    "start": 249.933,
    "end": 250.8,
    "text": "这些存在于"
  },
  {
    "start": 250.833,
    "end": 253.366,
    "text": "电磁频谱其它部分的存有"
  },
  {
    "start": 253.366,
    "end": 256.4,
    "text": "萨满师经常称他们为精灵"
  },
  {
    "start": 256.4,
    "end": 257.9,
    "text": "但对我们来说"
  },
  {
    "start": 257.9,
    "end": 260.533,
    "text": "他们只是处于不同的振动场中"
  },
  {
    "start": 260.566,
    "end": 262.1,
    "text": "对我们来说"
  },
  {
    "start": 262.1,
    "end": 264.666,
    "text": "他们只是意识的另一种形式"
  },
  {
    "start": 264.666,
    "end": 267.366,
    "text": "充满希望 梦想和抱负"
  },
  {
    "start": 267.4,
    "end": 268.9,
    "text": "就像人类一样"
  },
  {
    "start": 268.933,
    "end": 272.7,
    "text": "与这些生活在地球表面和地球内部的"
  },
  {
    "start": 272.7,
    "end": 275.533,
    "text": "高电磁智能体交流是可能的"
  },
  {
    "start": 275.533,
    "end": 277.933,
    "text": "其中一些电磁智能体"
  },
  {
    "start": 277.966,
    "end": 279.933,
    "text": "生活在你们大气层的"
  },
  {
    "start": 279.966,
    "end": 281.833,
    "text": "高纬高海拔地区"
  },
  {
    "start": 281.833,
    "end": 284.9,
    "text": "如果你接触一个电磁智能体"
  },
  {
    "start": 284.9,
    "end": 288.033,
    "text": "请注意它可能是仁慈的或邪恶的"
  },
  {
    "start": 288.066,
    "end": 289.7,
    "text": "在某些情况下"
  },
  {
    "start": 289.7,
    "end": 291.233,
    "text": "他们相当中立"
  },
  {
    "start": 291.266,
    "end": 293.733,
    "text": "既不支持也不反对你"
  },
  {
    "start": 293.733,
    "end": 297.366,
    "text": "与地球相关的这些电磁智能体中"
  },
  {
    "start": 297.366,
    "end": 300.266,
    "text": "他们有限的技术比你的更先进"
  },
  {
    "start": 300.3,
    "end": 303.866,
    "text": "他们中的一些乘着碟形设备移动,"
  },
  {
    "start": 303.9,
    "end": 308.0,
    "text": "这些碟形设备可以从更高的电磁频谱移动"
  },
  {
    "start": 308.0,
    "end": 310.3,
    "text": "进入3维的时间和空间"
  },
  {
    "start": 310.333,
    "end": 312.0,
    "text": "换句话说"
  },
  {
    "start": 312.0,
    "end": 314.466,
    "text": "当你发现不明飞行物时"
  },
  {
    "start": 314.466,
    "end": 316.4,
    "text": "它可能来自外太空"
  },
  {
    "start": 316.4,
    "end": 318.266,
    "text": "但也可能来自地球"
  },
  {
    "start": 318.266,
    "end": 322.3,
    "text": "因为你们人类只看到眼前的一小片世界"
  },
  {
    "start": 322.333,
    "end": 326.1,
    "text": "所以你们倾向于认为自己是最智力的物种"
  },
  {
    "start": 326.1,
    "end": 328.133,
    "text": "我们对此提出异议"
  },
  {
    "start": 328.166,
    "end": 329.333,
    "text": "我们可以说"
  },
  {
    "start": 329.333,
    "end": 330.7,
    "text": "在某些方面"
  },
  {
    "start": 330.733,
    "end": 332.666,
    "text": "鲸类物种更先进"
  },
  {
    "start": 332.666,
    "end": 334.166,
    "text": "毫无疑问"
  },
  {
    "start": 334.166,
    "end": 337.166,
    "text": "居住在地球的高电磁智能体"
  },
  {
    "start": 337.2,
    "end": 338.933,
    "text": "在许多情况下"
  },
  {
    "start": 338.933,
    "end": 341.066,
    "text": "远远超过人类的智力"
  },
  {
    "start": 341.1,
    "end": 342.733,
    "text": "就像我说的"
  },
  {
    "start": 342.733,
    "end": 344.933,
    "text": "你们生活在一个比你想象中"
  },
  {
    "start": 344.966,
    "end": 347.666,
    "text": "更神秘 更奇怪的宇宙里"
  },
  {
    "start": 347.7,
    "end": 350.733,
    "text": "在我们对地球的早期探索中"
  },
  {
    "start": 350.733,
    "end": 353.133,
    "text": "在现代智人出现之前"
  },
  {
    "start": 353.133,
    "end": 355.5,
    "text": "我们遇到了这些行星界更高的"
  },
  {
    "start": 355.5,
    "end": 357.333,
    "text": "电磁频谱智能体"
  },
  {
    "start": 357.366,
    "end": 361.166,
    "text": "他们在你们成为一个物种之前就在这里了"
  },
  {
    "start": 361.166,
    "end": 363.9,
    "text": "在你们史前时代的早期"
  },
  {
    "start": 363.933,
    "end": 365.866,
    "text": "意味着你们的这段历史"
  },
  {
    "start": 365.866,
    "end": 369.366,
    "text": "尚未以你们可识别的形式记录的时期"
  },
  {
    "start": 369.366,
    "end": 371.633,
    "text": "许多早期人类感觉到"
  },
  {
    "start": 371.666,
    "end": 374.1,
    "text": "这些高电磁智能体的存在"
  },
  {
    "start": 374.1,
    "end": 376.933,
    "text": "感知到这些存在的早期人类"
  },
  {
    "start": 376.933,
    "end": 378.5,
    "text": "成为了萨满师"
  },
  {
    "start": 378.533,
    "end": 381.9,
    "text": "萨满传统在世界各地发展"
  },
  {
    "start": 381.9,
    "end": 383.7,
    "text": "萨满师中的每一个"
  },
  {
    "start": 383.7,
    "end": 386.233,
    "text": "都受到他们地理位置的影响"
  },
  {
    "start": 386.266,
    "end": 390.666,
    "text": "人们在世界的这个地方遇到的高电磁智能体"
  },
  {
    "start": 390.666,
    "end": 393.133,
    "text": "不同于在另一个地方遇到的"
  },
  {
    "start": 393.133,
    "end": 396.033,
    "text": "从我们观察事物的方式来看"
  },
  {
    "start": 396.066,
    "end": 399.5,
    "text": "世界各地萨满传统的部分差异"
  },
  {
    "start": 399.5,
    "end": 402.2,
    "text": "并不仅仅是由于地理位置"
  },
  {
    "start": 402.233,
    "end": 404.266,
    "text": "文化和历史所致"
  },
  {
    "start": 404.266,
    "end": 406.266,
    "text": "其中一些差异是由于"
  },
  {
    "start": 406.3,
    "end": 409.1,
    "text": "这些地区的萨满师遇到了不同的"
  },
  {
    "start": 409.1,
    "end": 410.933,
    "text": "更高电磁智能体"
  },
  {
    "start": 410.933,
    "end": 413.766,
    "text": "在这种非常复杂的情况下"
  },
  {
    "start": 413.8,
    "end": 416.233,
    "text": "再加上非行星智能体"
  },
  {
    "start": 416.266,
    "end": 420.233,
    "text": "你们有了一幅非常 非常复杂的织锦挂毯"
  },
  {
    "start": 420.233,
    "end": 422.166,
    "text": "就像我说的那样"
  },
  {
    "start": 422.2,
    "end": 426.1,
    "text": "人类遇到的一些UFO是非行星起源的"
  },
  {
    "start": 426.133,
    "end": 428.633,
    "text": "但也有一些是地球起源的"
  },
  {
    "start": 428.633,
    "end": 431.166,
    "text": "它们可以以电磁智能体的形式"
  },
  {
    "start": 431.166,
    "end": 433.366,
    "text": "出现在更高的频谱上"
  },
  {
    "start": 433.4,
    "end": 435.733,
    "text": "虽然听起来很奇怪"
  },
  {
    "start": 435.766,
    "end": 437.333,
    "text": "但其中一些飞船"
  },
  {
    "start": 437.333,
    "end": 439.966,
    "text": "是来自未来的人类旅行者"
  },
  {
    "start": 439.966,
    "end": 443.466,
    "text": "为了探索和理解而旅行回到过去"
  },
  {
    "start": 443.5,
    "end": 447.3,
    "text": "这些来自未来的人类旅行者中的一些人"
  },
  {
    "start": 447.3,
    "end": 450.666,
    "text": "返回以尝试纠正他们认为的“不平衡”"
  },
  {
    "start": 450.666,
    "end": 452.266,
    "text": "我们观察到"
  },
  {
    "start": 452.266,
    "end": 455.066,
    "text": "这些来自你们未来的人类访客"
  },
  {
    "start": 455.1,
    "end": 457.966,
    "text": "大多乘坐碟形飞船旅行"
  },
  {
    "start": 457.966,
    "end": 460.466,
    "text": "因为这是他们开发的主要技术"
  },
  {
    "start": 460.5,
    "end": 461.766,
    "text": "准确地"
  },
  {
    "start": 461.8,
    "end": 463.866,
    "text": "我应该说你们发展了"
  },
  {
    "start": 463.866,
    "end": 466.666,
    "text": "因为这些访客是你们未来的祖先"
  },
  {
    "start": 466.666,
    "end": 469.466,
    "text": "这是一个非常奇怪的情况"
  },
  {
    "start": 469.466,
    "end": 471.1,
    "text": "可能难以理解"
  },
  {
    "start": 471.133,
    "end": 473.433,
    "text": "未来人类使用碟形飞船"
  },
  {
    "start": 473.466,
    "end": 475.5,
    "text": "穿越你们时间的可能"
  },
  {
    "start": 475.533,
    "end": 478.033,
    "text": "只是意识扩展的一种表达"
  },
  {
    "start": 478.033,
    "end": 479.666,
    "text": "换句话说"
  },
  {
    "start": 479.666,
    "end": 481.9,
    "text": "你们对3维现实的理解"
  },
  {
    "start": 481.9,
    "end": 484.1,
    "text": "不仅是狭隘和有限的"
  },
  {
    "start": 484.133,
    "end": 486.866,
    "text": "你们对时间的理解也是有限的"
  },
  {
    "start": 486.866,
    "end": 490.866,
    "text": "当一个物种到达一个确定的发展点时"
  },
  {
    "start": 490.9,
    "end": 494.066,
    "text": "在时间上向前或向后移动的能力"
  },
  {
    "start": 494.066,
    "end": 497.433,
    "text": "就像在你们的世界里搭地铁一样简单"
  },
  {
    "start": 497.466,
    "end": 499.066,
    "text": "想象一下"
  },
  {
    "start": 499.066,
    "end": 503.6,
    "text": "未来的人类如何通过时间流动力学的扩展镜头"
  },
  {
    "start": 503.6,
    "end": 506.4,
    "text": "来看待其历史和古代祖先"
  },
  {
    "start": 506.433,
    "end": 507.566,
    "text": "也就是你们"
  },
  {
    "start": 507.6,
    "end": 511.033,
    "text": "你们认为时间在一条直线上流动"
  },
  {
    "start": 511.033,
    "end": 513.266,
    "text": "但这是一种有限的理解"
  },
  {
    "start": 513.266,
    "end": 514.966,
    "text": "因为你们的感官决定了"
  },
  {
    "start": 514.966,
    "end": 517.133,
    "text": "你们对物理现实的了解"
  },
  {
    "start": 517.166,
    "end": 519.933,
    "text": "你们生活在一个比你想象中"
  },
  {
    "start": 519.966,
    "end": 522.033,
    "text": "更复杂的三维存在里"
  },
  {
    "start": 522.033,
    "end": 524.766,
    "text": "你们正处在一个时间点上"
  },
  {
    "start": 524.766,
    "end": 528.633,
    "text": "未来的探险者将返回以查找问题所在"
  },
  {
    "start": 528.633,
    "end": 531.466,
    "text": "你们正处在那个时间的尖端"
  },
  {
    "start": 531.466,
    "end": 534.233,
    "text": "你们是许多观察者的观察对象"
  },
  {
    "start": 534.266,
    "end": 536.533,
    "text": "对于未来的人类来说"
  },
  {
    "start": 536.566,
    "end": 538.366,
    "text": "你们就像尼安德特人"
  },
  {
    "start": 538.366,
    "end": 540.966,
    "text": "这是复杂性的一个层次"
  },
  {
    "start": 540.966,
    "end": 542.9,
    "text": "让我们来添加另一层"
  },
  {
    "start": 542.933,
    "end": 547.0,
    "text": "我们在这里谈论的是与地球相关的智能体"
  },
  {
    "start": 547.0,
    "end": 550.533,
    "text": "即人类(未来的人类)和高电磁智能体"
  },
  {
    "start": 550.566,
    "end": 555.566,
    "text": "现在让我们谈谈非地球智能体"
  },
  {
    "start": 555.566,
    "end": 557.533,
    "text": "217 00:09:17,566 --> 00:09:19,833 非行星智能体"
  },
  {
    "start": 559.833,
    "end": 563.066,
    "text": "在这里我需要展示一个流程图"
  },
  {
    "start": 563.066,
    "end": 566.566,
    "text": "让我们从三类非行星的存有开始"
  },
  {
    "start": 566.566,
    "end": 567.933,
    "text": "然后再扩展"
  },
  {
    "start": 567.966,
    "end": 569.233,
    "text": "首先"
  },
  {
    "start": 569.233,
    "end": 570.8,
    "text": "你们会称他们为"
  },
  {
    "start": 570.833,
    "end": 572.433,
    "text": "外星智能体"
  },
  {
    "start": 572.466,
    "end": 575.1,
    "text": "只是因为你们不了解他们的本质"
  },
  {
    "start": 575.1,
    "end": 576.466,
    "text": "(相信我"
  },
  {
    "start": 576.466,
    "end": 579.433,
    "text": "你们对他们来说也像外星人一样"
  },
  {
    "start": 579.433,
    "end": 580.633,
    "text": ")第一类"
  },
  {
    "start": 580.666,
    "end": 583.6,
    "text": "不是优先的而是任意选择的"
  },
  {
    "start": 583.633,
    "end": 587.333,
    "text": "是那些拥有物理容器旅行的外星存有"
  },
  {
    "start": 587.333,
    "end": 590.133,
    "text": "这些非行星智能体中的一些"
  },
  {
    "start": 590.166,
    "end": 592.766,
    "text": "仍然存在于三维容器中"
  },
  {
    "start": 592.766,
    "end": 594.6,
    "text": "你可以称之为飞船"
  },
  {
    "start": 594.633,
    "end": 599.033,
    "text": "一些存有有能力改变其飞船的分子结构"
  },
  {
    "start": 599.033,
    "end": 600.833,
    "text": "这样他们可以从一个维度"
  },
  {
    "start": 600.833,
    "end": 603.7,
    "text": "向上或向下移动到另一个维度"
  },
  {
    "start": 603.733,
    "end": 608.633,
    "text": "我们大角星人拥有这项技术的非常先进的形式"
  },
  {
    "start": 608.666,
    "end": 611.6,
    "text": "它允许我们的飞船根据需要"
  },
  {
    "start": 611.6,
    "end": 613.966,
    "text": "轻松地移动到其它维度"
  },
  {
    "start": 613.966,
    "end": 616.933,
    "text": "我们的飞船主要停留在5维"
  },
  {
    "start": 616.966,
    "end": 620.4,
    "text": "但在需要的时候可以进入更高的维度"
  },
  {
    "start": 620.4,
    "end": 623.733,
    "text": "在非常 非常罕见的情况下"
  },
  {
    "start": 623.766,
    "end": 626.466,
    "text": "我们可以转移进入3维现实"
  },
  {
    "start": 626.5,
    "end": 628.566,
    "text": "但这需要巨大的能量"
  },
  {
    "start": 628.566,
    "end": 630.4,
    "text": "我们不会轻易这样做"
  },
  {
    "start": 630.433,
    "end": 634.733,
    "text": "第二类非行星访客包括高电磁智能体"
  },
  {
    "start": 634.766,
    "end": 638.666,
    "text": "类似于依附在地球的高电磁智能体"
  },
  {
    "start": 638.666,
    "end": 641.233,
    "text": "这些存有没有飞船或容器"
  },
  {
    "start": 641.233,
    "end": 645.033,
    "text": "他们以独特的电磁场在空间中移动"
  },
  {
    "start": 645.033,
    "end": 648.633,
    "text": "集体地 单个地或两者兼而有之"
  },
  {
    "start": 648.633,
    "end": 650.9,
    "text": "他们具有单个的身份"
  },
  {
    "start": 650.9,
    "end": 652.4,
    "text": "可以集体行动"
  },
  {
    "start": 652.433,
    "end": 655.1,
    "text": "第三类是最特殊的一类"
  },
  {
    "start": 655.1,
    "end": 656.966,
    "text": "尽管对你们来说"
  },
  {
    "start": 657.0,
    "end": 660.066,
    "text": "我所讨论的一切似乎都很特殊"
  },
  {
    "start": 660.066,
    "end": 662.166,
    "text": "这些非行星智能体"
  },
  {
    "start": 662.2,
    "end": 665.0,
    "text": "是来自遥远文明的思想投射"
  },
  {
    "start": 665.0,
    "end": 667.4,
    "text": "它们只是观察的能量点"
  },
  {
    "start": 667.4,
    "end": 668.9,
    "text": "它们不互动"
  },
  {
    "start": 668.933,
    "end": 671.066,
    "text": "它们完全是为了自己"
  },
  {
    "start": 671.066,
    "end": 673.466,
    "text": "它们只是为了观察你们的行星"
  },
  {
    "start": 673.5,
    "end": 677.566,
    "text": "和你们的太阳系里正在发生的事情"
  },
  {
    "start": 677.6,
    "end": 679.566,
    "text": "263 00:11:19,600 --> 00:11:21,033 灵魂"
  },
  {
    "start": 681.033,
    "end": 686.1,
    "text": "根据我们自己和其他许多存有(但不是全部)的体验"
  },
  {
    "start": 686.1,
    "end": 689.1,
    "text": "我们拥有一个不可毁灭的能量点"
  },
  {
    "start": 689.133,
    "end": 691.0,
    "text": "除非有特殊情况"
  },
  {
    "start": 691.033,
    "end": 693.3,
    "text": "当我们肉体死亡时"
  },
  {
    "start": 693.3,
    "end": 694.633,
    "text": "这个能量点"
  },
  {
    "start": 694.666,
    "end": 695.666,
    "text": "即火花"
  },
  {
    "start": 695.666,
    "end": 697.2,
    "text": "会继续存在"
  },
  {
    "start": 697.233,
    "end": 700.0,
    "text": "但不会以个体身份继续存在"
  },
  {
    "start": 700.0,
    "end": 702.233,
    "text": "仿佛是第五元素"
  },
  {
    "start": 702.266,
    "end": 705.966,
    "text": "我们所有经验的积累被压缩成一个奇点"
  },
  {
    "start": 706.0,
    "end": 708.566,
    "text": "它在空间移动一段时间"
  },
  {
    "start": 708.566,
    "end": 711.366,
    "text": "或者在更高维度的现实中"
  },
  {
    "start": 711.4,
    "end": 716.2,
    "text": "在那里个体决定是否重新进入并体验一个“生命”"
  },
  {
    "start": 716.233,
    "end": 717.866,
    "text": "通过这种方式"
  },
  {
    "start": 717.866,
    "end": 720.666,
    "text": "我们可以选择“化身进入一个身体”"
  },
  {
    "start": 720.7,
    "end": 723.533,
    "text": "在任何一个现实维度中"
  },
  {
    "start": 723.666,
    "end": 728.333,
    "text": "【第五元素 是被视为地 水 火 风以外"
  },
  {
    "start": 728.333,
    "end": 730.1,
    "text": "构成宇宙的元素"
  },
  {
    "start": 730.133,
    "end": 731.866,
    "text": "在物理学中"
  },
  {
    "start": 731.9,
    "end": 735.366,
    "text": "第五元素是暗能量的一种假设形式"
  },
  {
    "start": 735.366,
    "end": 739.166,
    "text": "作为对宇宙加速膨胀的观察结果的解释"
  },
  {
    "start": 739.2,
    "end": 741.633,
    "text": "引用自《维基百科》】 【"
  },
  {
    "start": 741.666,
    "end": 748.1,
    "text": "奇点  体积无限小 密度无限大 时空曲率无限大的点"
  },
  {
    "start": 748.1,
    "end": 750.666,
    "text": "引用自《维基百科》】"
  },
  {
    "start": 750.666,
    "end": 752.433,
    "text": "我们可以选择"
  },
  {
    "start": 752.466,
    "end": 756.233,
    "text": "但它是否发生会受到许多因素的影响"
  },
  {
    "start": 756.233,
    "end": 759.433,
    "text": "我们必须具备那个维度的品质"
  },
  {
    "start": 759.466,
    "end": 763.333,
    "text": "那个我们希望进入成为一个具体存有的维度"
  },
  {
    "start": 763.366,
    "end": 764.5,
    "text": "所以"
  },
  {
    "start": 764.5,
    "end": 769.0,
    "text": "如果我们希望死后化身到一个更高维度的现实"
  },
  {
    "start": 769.0,
    "end": 771.1,
    "text": "那么我们必须在活着的时候"
  },
  {
    "start": 771.133,
    "end": 773.3,
    "text": "发展出更高的品质"
  },
  {
    "start": 773.3,
    "end": 777.166,
    "text": "我们观察到类似的事情发生在人类身上"
  },
  {
    "start": 777.2,
    "end": 780.833,
    "text": "许多传统和宗教都在谈论灵魂"
  },
  {
    "start": 780.866,
    "end": 782.6,
    "text": "而我们的经验是"
  },
  {
    "start": 782.6,
    "end": 785.0,
    "text": "个体幸存而整体死亡"
  },
  {
    "start": 785.033,
    "end": 786.733,
    "text": "以及前进或后退"
  },
  {
    "start": 786.766,
    "end": 788.633,
    "text": "进入维度现实"
  },
  {
    "start": 788.633,
    "end": 790.366,
    "text": "这样的情况不存在"
  },
  {
    "start": 790.366,
    "end": 792.566,
    "text": "但是有一个能量点"
  },
  {
    "start": 792.6,
    "end": 793.6,
    "text": "即火花"
  },
  {
    "start": 793.6,
    "end": 795.033,
    "text": "会持续下去"
  },
  {
    "start": 795.066,
    "end": 798.933,
    "text": "这是你们称之为可能性的其中一个问题"
  },
  {
    "start": 798.933,
    "end": 801.666,
    "text": "许多人类存有理解到"
  },
  {
    "start": 801.7,
    "end": 804.433,
    "text": "灵魂带着个人的历史和身份"
  },
  {
    "start": 804.466,
    "end": 808.033,
    "text": "当我们观察人类经历死亡的过程时"
  },
  {
    "start": 808.033,
    "end": 809.7,
    "text": "我们没有看到这一点"
  },
  {
    "start": 809.7,
    "end": 812.666,
    "text": "但我们确实经历了一个能量点"
  },
  {
    "start": 812.7,
    "end": 813.8,
    "text": "即火花"
  },
  {
    "start": 813.8,
    "end": 815.6,
    "text": "在死亡中幸存"
  },
  {
    "start": 815.633,
    "end": 818.666,
    "text": "没有个人历史也没有个人身份"
  },
  {
    "start": 818.666,
    "end": 820.366,
    "text": "那一生的本质"
  },
  {
    "start": 820.4,
    "end": 822.7,
    "text": "就其振动天性而言"
  },
  {
    "start": 822.733,
    "end": 826.6,
    "text": "提炼成被火花或能量点所包围的精华"
  },
  {
    "start": 826.6,
    "end": 828.866,
    "text": "它有一种磁性吸引力"
  },
  {
    "start": 828.866,
    "end": 830.766,
    "text": "与要发展的振动频率"
  },
  {
    "start": 830.8,
    "end": 833.2,
    "text": "或者维度现实相匹配"
  },
  {
    "start": 833.2,
    "end": 838.5,
    "text": "这就是为什么我们大角星人喜欢尽可能延长我们的寿命"
  },
  {
    "start": 838.5,
    "end": 843.166,
    "text": "我们开发了再生技术来帮助我们"
  },
  {
    "start": 843.166,
    "end": 845.133,
    "text": "324 00:14:05,166 --> 00:14:07,166 电磁智能体"
  },
  {
    "start": 847.166,
    "end": 850.066,
    "text": "在你们的古代历史和神话中"
  },
  {
    "start": 850.1,
    "end": 853.5,
    "text": "古代文化与这些高电磁智能体互动"
  },
  {
    "start": 853.533,
    "end": 854.833,
    "text": "再一次"
  },
  {
    "start": 854.833,
    "end": 856.533,
    "text": "为了澄清术语"
  },
  {
    "start": 856.533,
    "end": 858.7,
    "text": "更高的电磁智能体"
  },
  {
    "start": 858.7,
    "end": 861.2,
    "text": "我们只是指一个电磁实体"
  },
  {
    "start": 861.2,
    "end": 864.933,
    "text": "他存在于比人类更高的振动频率中"
  },
  {
    "start": 864.966,
    "end": 867.4,
    "text": "让我们通过紫外线的镜头"
  },
  {
    "start": 867.4,
    "end": 869.233,
    "text": "来观察电磁频谱"
  },
  {
    "start": 869.266,
    "end": 872.8,
    "text": "一些存有存在于紫外线光谱中"
  },
  {
    "start": 872.8,
    "end": 877.6,
    "text": "一些存有存在于x射线光谱或伽玛射线光谱中"
  },
  {
    "start": 877.6,
    "end": 880.066,
    "text": "在史前文化的早期"
  },
  {
    "start": 880.066,
    "end": 883.033,
    "text": "特别是在希腊神文化的早期"
  },
  {
    "start": 883.066,
    "end": 886.066,
    "text": "存在着对“其它世界存有”的接纳"
  },
  {
    "start": 886.066,
    "end": 889.466,
    "text": "这些存有以神话人物的形式出现"
  },
  {
    "start": 889.5,
    "end": 891.966,
    "text": "其中许多本质上是动物"
  },
  {
    "start": 892.0,
    "end": 894.9,
    "text": "关于电磁智能体存在的知识"
  },
  {
    "start": 894.9,
    "end": 897.9,
    "text": "分布于地球每个文化的早期中"
  },
  {
    "start": 897.933,
    "end": 899.033,
    "text": "因此"
  },
  {
    "start": 899.033,
    "end": 901.433,
    "text": "在世界上的各种文化中"
  },
  {
    "start": 901.433,
    "end": 904.166,
    "text": "你可以看到对花仙 地精"
  },
  {
    "start": 904.166,
    "end": 905.966,
    "text": "矮仙 水仙"
  },
  {
    "start": 906.0,
    "end": 907.566,
    "text": "天马 半人马"
  },
  {
    "start": 907.566,
    "end": 910.933,
    "text": "和许多其它超凡脱俗形态的描述"
  },
  {
    "start": 910.933,
    "end": 913.4,
    "text": "这是具有心理意识的人类"
  },
  {
    "start": 913.433,
    "end": 916.6,
    "text": "与这些高电磁智能体相遇的结果"
  },
  {
    "start": 916.6,
    "end": 918.466,
    "text": "在某些情况下"
  },
  {
    "start": 918.5,
    "end": 922.9,
    "text": "人类感知到的形式是准确的或接近准确的印象"
  },
  {
    "start": 922.933,
    "end": 925.2,
    "text": "但在大多数情况下"
  },
  {
    "start": 925.2,
    "end": 928.733,
    "text": "印象是由人类的期望和信念所着色的"
  },
  {
    "start": 928.766,
    "end": 929.866,
    "text": "但是"
  },
  {
    "start": 929.866,
    "end": 931.9,
    "text": "高电磁智能体的存在"
  },
  {
    "start": 931.933,
    "end": 934.233,
    "text": "与所接收到的印象无关"
  },
  {
    "start": 934.233,
    "end": 935.5,
    "text": "再一次"
  },
  {
    "start": 935.533,
    "end": 938.133,
    "text": "这是感知相对性的一种表达"
  },
  {
    "start": 938.166,
    "end": 940.633,
    "text": "当低振动现实的存有"
  },
  {
    "start": 940.633,
    "end": 943.733,
    "text": "与高振动现实的存有互动时"
  },
  {
    "start": 943.766,
    "end": 946.766,
    "text": "这尤其适用"
  },
  {
    "start": 946.766,
    "end": 948.733,
    "text": "364 00:15:48,766 --> 00:15:50,200 天使"
  },
  {
    "start": 950.233,
    "end": 952.933,
    "text": "既然我们谈到了这个话题"
  },
  {
    "start": 952.933,
    "end": 956.333,
    "text": "我想从我们的角度来谈谈天使现象"
  },
  {
    "start": 956.366,
    "end": 958.366,
    "text": "天使是存在的"
  },
  {
    "start": 958.4,
    "end": 960.3,
    "text": "他们是仁慈和善意的"
  },
  {
    "start": 960.3,
    "end": 961.3,
    "text": "然而"
  },
  {
    "start": 961.333,
    "end": 963.8,
    "text": "它们是更高的电磁智能体"
  },
  {
    "start": 963.833,
    "end": 965.8,
    "text": "当人类遇到其中一个"
  },
  {
    "start": 965.833,
    "end": 968.466,
    "text": "仁慈的 善意的智能体"
  },
  {
    "start": 968.466,
    "end": 970.133,
    "text": "人类很可能会通过"
  },
  {
    "start": 970.133,
    "end": 973.033,
    "text": "他对信念的期望来过滤体验"
  },
  {
    "start": 973.033,
    "end": 974.066,
    "text": "但此外"
  },
  {
    "start": 974.1,
    "end": 977.4,
    "text": "我希望在这个讨论中指出的一点是"
  },
  {
    "start": 977.4,
    "end": 978.133,
    "text": "是的"
  },
  {
    "start": 978.166,
    "end": 980.733,
    "text": "这些“天使”是仁慈和善意的–"
  },
  {
    "start": 980.733,
    "end": 982.9,
    "text": "一些比其他更智慧"
  },
  {
    "start": 982.9,
    "end": 985.3,
    "text": "一些更擅长创造结果"
  },
  {
    "start": 985.3,
    "end": 986.766,
    "text": "在我看来"
  },
  {
    "start": 986.8,
    "end": 989.9,
    "text": "天使这个话题的困难之处在于"
  },
  {
    "start": 989.9,
    "end": 993.3,
    "text": "这个概念被宗教 心理教条和谬见"
  },
  {
    "start": 993.333,
    "end": 994.9,
    "text": "所拖累和玷污"
  },
  {
    "start": 994.9,
    "end": 997.266,
    "text": "这是一个奇妙的经历"
  },
  {
    "start": 997.3,
    "end": 1000.166,
    "text": "遇到仁慈 智慧和技艺精湛的"
  },
  {
    "start": 1000.166,
    "end": 1001.766,
    "text": "高电磁智能体"
  },
  {
    "start": 1001.766,
    "end": 1004.3,
    "text": "对人类和电磁实体来说"
  },
  {
    "start": 1004.333,
    "end": 1006.4,
    "text": "都是非常有益的体验"
  },
  {
    "start": 1006.4,
    "end": 1007.433,
    "text": "但是"
  },
  {
    "start": 1007.466,
    "end": 1009.333,
    "text": "人类必须意识到"
  },
  {
    "start": 1009.333,
    "end": 1013.133,
    "text": "他从体验中提取内容的责任担在他身上"
  },
  {
    "start": 1013.166,
    "end": 1014.3,
    "text": "所以"
  },
  {
    "start": 1014.3,
    "end": 1016.266,
    "text": "如果你和“天使”互动"
  },
  {
    "start": 1016.266,
    "end": 1018.2,
    "text": "要保持头脑清醒"
  },
  {
    "start": 1018.233,
    "end": 1021.666,
    "text": "如果“天使”告诉你必须做什么事"
  },
  {
    "start": 1021.666,
    "end": 1024.2,
    "text": "要么你是在和白痴打交道"
  },
  {
    "start": 1024.233,
    "end": 1026.366,
    "text": "要么是在和伪装成仁慈的"
  },
  {
    "start": 1026.366,
    "end": 1028.166,
    "text": "邪恶实体打交道"
  },
  {
    "start": 1028.166,
    "end": 1029.766,
    "text": "任何存有"
  },
  {
    "start": 1029.8,
    "end": 1031.266,
    "text": "人类或其他"
  },
  {
    "start": 1031.266,
    "end": 1035.133,
    "text": "想要拥有你的主权意志的都是要避开的"
  },
  {
    "start": 1035.166,
    "end": 1038.033,
    "text": "莉莉丝是另一个电磁频谱"
  },
  {
    "start": 1038.033,
    "end": 1041.066,
    "text": "人们据此讲述了许多故事"
  },
  {
    "start": 1041.066,
    "end": 1044.566,
    "text": "但与莉莉丝的相遇发生在星体层"
  },
  {
    "start": 1044.6,
    "end": 1048.933,
    "text": "那里存在着大部分的(但不是全部)电磁智能体"
  },
  {
    "start": 1048.966,
    "end": 1050.633,
    "text": "与人类一样"
  },
  {
    "start": 1050.633,
    "end": 1054.966,
    "text": "这些电磁智能体可以上升到更高的星体层"
  },
  {
    "start": 1054.966,
    "end": 1056.833,
    "text": "也可以超越星体层"
  },
  {
    "start": 1056.866,
    "end": 1059.433,
    "text": "进入一些人称呼的以太层"
  },
  {
    "start": 1059.433,
    "end": 1061.633,
    "text": "但我们简单称之为5维"
  },
  {
    "start": 1061.633,
    "end": 1065.633,
    "text": "你的宇宙比你想象的要陌生得多"
  },
  {
    "start": 1065.666,
    "end": 1067.633,
    "text": "414 00:17:47,666 --> 00:17:49,666 大角星走廊"
  },
  {
    "start": 1069.666,
    "end": 1071.133,
    "text": "有些人描述了"
  },
  {
    "start": 1071.133,
    "end": 1074.333,
    "text": "大角星和你们地球之间的维度桥梁"
  },
  {
    "start": 1074.366,
    "end": 1076.933,
    "text": "他们称之为大角星走廊"
  },
  {
    "start": 1076.933,
    "end": 1078.466,
    "text": "对我们来说"
  },
  {
    "start": 1078.466,
    "end": 1080.233,
    "text": "它只是一个星门"
  },
  {
    "start": 1080.266,
    "end": 1081.9,
    "text": "一个多维门户"
  },
  {
    "start": 1081.9,
    "end": 1083.933,
    "text": "一个多维空间的通道"
  },
  {
    "start": 1083.933,
    "end": 1088.666,
    "text": "它允许我们的飞船以比光速还快的速度进入"
  },
  {
    "start": 1088.7,
    "end": 1091.1,
    "text": "不仅仅是你们地球领域"
  },
  {
    "start": 1091.1,
    "end": 1093.366,
    "text": "而且是你们整个太阳系"
  },
  {
    "start": 1093.366,
    "end": 1096.5,
    "text": "在穿越如此广阔的距离时"
  },
  {
    "start": 1096.533,
    "end": 1097.733,
    "text": "这是必要的"
  },
  {
    "start": 1097.733,
    "end": 1100.1,
    "text": "这个大角星门户的目的"
  },
  {
    "start": 1100.133,
    "end": 1104.066,
    "text": "是让我们的船只根据需要快速移动到位"
  },
  {
    "start": 1104.1,
    "end": 1107.666,
    "text": "我所说的“需要”是指我们自己决定的位置"
  },
  {
    "start": 1107.666,
    "end": 1109.066,
    "text": "这个星门"
  },
  {
    "start": 1109.1,
    "end": 1110.566,
    "text": "这个多维通道"
  },
  {
    "start": 1110.566,
    "end": 1112.533,
    "text": "仅适用于我们的飞船"
  },
  {
    "start": 1112.566,
    "end": 1115.066,
    "text": "它不是与我们联系的方法"
  },
  {
    "start": 1115.066,
    "end": 1117.233,
    "text": "除了极其罕见的个体"
  },
  {
    "start": 1117.233,
    "end": 1120.8,
    "text": "当个体已经达到一定程度的了解"
  },
  {
    "start": 1120.833,
    "end": 1124.166,
    "text": "他准备好并且愿意接触大角星人"
  },
  {
    "start": 1124.2,
    "end": 1127.4,
    "text": "那么大角星人将创建一个微隧道"
  },
  {
    "start": 1127.4,
    "end": 1129.3,
    "text": "一个较小的星门"
  },
  {
    "start": 1129.3,
    "end": 1130.766,
    "text": "如果你愿意"
  },
  {
    "start": 1130.8,
    "end": 1132.766,
    "text": "允许你更高的面向"
  },
  {
    "start": 1132.766,
    "end": 1136.133,
    "text": "你的高维体过境到大角星人那里"
  },
  {
    "start": 1136.166,
    "end": 1138.066,
    "text": "或在某些情况下"
  },
  {
    "start": 1138.066,
    "end": 1140.633,
    "text": "大角星人过境到人类那里"
  },
  {
    "start": 1140.666,
    "end": 1144.133,
    "text": "这也是人们进入大角星飞船的途径"
  },
  {
    "start": 1144.133,
    "end": 1147.266,
    "text": "这个被称为大角星走廊的门户"
  },
  {
    "start": 1147.266,
    "end": 1149.766,
    "text": "并不是一个自然形成的漩涡"
  },
  {
    "start": 1149.8,
    "end": 1151.9,
    "text": "它是由我们创造的"
  },
  {
    "start": 1151.933,
    "end": 1153.333,
    "text": "由我们支持的"
  },
  {
    "start": 1153.366,
    "end": 1156.066,
    "text": "保护生命 智力和自由"
  },
  {
    "start": 1156.066,
    "end": 1157.833,
    "text": "是我们使命的一部分"
  },
  {
    "start": 1157.833,
    "end": 1159.266,
    "text": "这条走廊"
  },
  {
    "start": 1159.266,
    "end": 1161.166,
    "text": "就像一些人所说的"
  },
  {
    "start": 1161.2,
    "end": 1163.033,
    "text": "仅仅用于5维飞船"
  },
  {
    "start": 1163.066,
    "end": 1165.133,
    "text": "在地球 你们的太阳系"
  },
  {
    "start": 1165.133,
    "end": 1167.0,
    "text": "和大角星之间移动"
  },
  {
    "start": 1167.0,
    "end": 1169.566,
    "text": "还有其它的星门和通道"
  },
  {
    "start": 1169.6,
    "end": 1173.1,
    "text": "从大角星到你们银河系的其它位置"
  },
  {
    "start": 1173.1,
    "end": 1175.133,
    "text": "因为这个多维隧道"
  },
  {
    "start": 1175.133,
    "end": 1178.233,
    "text": "也就是一些人所说的大角星走廊"
  },
  {
    "start": 1178.266,
    "end": 1181.5,
    "text": "是专门为大角星5维飞船使用的"
  },
  {
    "start": 1181.533,
    "end": 1184.4,
    "text": "所以让我来谈谈微型隧道"
  },
  {
    "start": 1184.4,
    "end": 1186.5,
    "text": "因为它们可以被人类使用"
  },
  {
    "start": 1186.533,
    "end": 1190.033,
    "text": "当个体准备好并愿意接触时"
  },
  {
    "start": 1190.066,
    "end": 1192.0,
    "text": "在大多数情况下"
  },
  {
    "start": 1192.0,
    "end": 1193.8,
    "text": "这种接触都是通过"
  },
  {
    "start": 1193.8,
    "end": 1196.4,
    "text": "其中一个微隧道建立起来的"
  },
  {
    "start": 1196.4,
    "end": 1199.3,
    "text": "这些微隧道连接着高维体"
  },
  {
    "start": 1199.333,
    "end": 1202.4,
    "text": "特别是人类的5维体与大角星人"
  },
  {
    "start": 1202.4,
    "end": 1204.433,
    "text": "和/或大角星飞船"
  },
  {
    "start": 1204.433,
    "end": 1206.233,
    "text": "通过它们建立联系"
  },
  {
    "start": 1206.233,
    "end": 1208.2,
    "text": "关于这些微隧道"
  },
  {
    "start": 1208.233,
    "end": 1209.833,
    "text": "我想讨论两类"
  },
  {
    "start": 1209.833,
    "end": 1213.033,
    "text": "第一类是身体和能量场的区域"
  },
  {
    "start": 1213.066,
    "end": 1215.833,
    "text": "这些微隧道在这里建立接触"
  },
  {
    "start": 1215.833,
    "end": 1218.3,
    "text": "第二类是意识接触所需的"
  },
  {
    "start": 1218.333,
    "end": 1220.733,
    "text": "身体/思想活动水平"
  },
  {
    "start": 1220.733,
    "end": 1223.166,
    "text": "让我们首先谈谈第二类"
  },
  {
    "start": 1223.166,
    "end": 1224.366,
    "text": "通常"
  },
  {
    "start": 1224.4,
    "end": 1227.1,
    "text": "人类与大角星人之间的接触"
  },
  {
    "start": 1227.133,
    "end": 1230.2,
    "text": "由于人类的感知而受到限制"
  },
  {
    "start": 1230.2,
    "end": 1231.966,
    "text": "对于人类来说"
  },
  {
    "start": 1231.966,
    "end": 1234.3,
    "text": "在3维遇到大角星人"
  },
  {
    "start": 1234.333,
    "end": 1236.966,
    "text": "这将是非同寻常的的 罕见的"
  },
  {
    "start": 1237.0,
    "end": 1238.2,
    "text": "且不可能的"
  },
  {
    "start": 1238.2,
    "end": 1241.8,
    "text": "这是因为改变维度需要巨大的能量"
  },
  {
    "start": 1241.8,
    "end": 1242.933,
    "text": "因此"
  },
  {
    "start": 1242.933,
    "end": 1246.466,
    "text": "调节人类存有复杂的身体/思想"
  },
  {
    "start": 1246.466,
    "end": 1250.366,
    "text": "来建立交流的微隧道更方便 更有效"
  },
  {
    "start": 1250.366,
    "end": 1251.433,
    "text": "毕竟"
  },
  {
    "start": 1251.466,
    "end": 1254.333,
    "text": "我们大角星人是个务实的群体"
  },
  {
    "start": 1254.333,
    "end": 1256.933,
    "text": "我们不喜欢浪费能源或资源"
  },
  {
    "start": 1256.933,
    "end": 1259.6,
    "text": "当交流的微隧道建立后"
  },
  {
    "start": 1259.6,
    "end": 1263.266,
    "text": "它会改变人类的大脑状态和生理活动"
  },
  {
    "start": 1263.266,
    "end": 1265.866,
    "text": "用你们的科学术语来说"
  },
  {
    "start": 1265.9,
    "end": 1267.833,
    "text": "阿尔法α活动增加"
  },
  {
    "start": 1267.833,
    "end": 1269.6,
    "text": "但阿尔法α活动只是"
  },
  {
    "start": 1269.633,
    "end": 1271.933,
    "text": "在这些交流过程中发生的"
  },
  {
    "start": 1271.966,
    "end": 1273.933,
    "text": "众多大脑状态之一"
  },
  {
    "start": 1273.933,
    "end": 1276.566,
    "text": "人类的大脑非常复杂"
  },
  {
    "start": 1276.566,
    "end": 1279.8,
    "text": "多个频率在你们的大脑中同时发生"
  },
  {
    "start": 1279.833,
    "end": 1284.533,
    "text": "较高的意识状态与较高的大脑频率有关"
  },
  {
    "start": 1284.566,
    "end": 1287.3,
    "text": "这样说过于简单且不准确"
  },
  {
    "start": 1287.333,
    "end": 1290.566,
    "text": "这是对人类生理和潜能的严重误解"
  },
  {
    "start": 1290.566,
    "end": 1297.866,
    "text": "当微隧道在大角星人和/或大角星飞船与人类存有之间建立起来时"
  },
  {
    "start": 1297.866,
    "end": 1300.433,
    "text": "人类的感知会自发地转变"
  },
  {
    "start": 1300.466,
    "end": 1303.233,
    "text": "感知具有很大的流动性"
  },
  {
    "start": 1303.233,
    "end": 1307.1,
    "text": "一个人可以同时意识到至少两个现实"
  },
  {
    "start": 1307.1,
    "end": 1311.4,
    "text": "人类现实和与大角星人互动的高维现实"
  },
  {
    "start": 1311.433,
    "end": 1313.8,
    "text": "在一些罕见的情况下"
  },
  {
    "start": 1313.833,
    "end": 1317.2,
    "text": "个体将会失去其3维现实的轨迹"
  },
  {
    "start": 1317.2,
    "end": 1319.466,
    "text": "世界似乎消失了"
  },
  {
    "start": 1319.5,
    "end": 1321.333,
    "text": "他体验的大角星现实"
  },
  {
    "start": 1321.366,
    "end": 1323.333,
    "text": "将成为唯一的关注点"
  },
  {
    "start": 1323.333,
    "end": 1324.9,
    "text": "在这些时刻"
  },
  {
    "start": 1324.933,
    "end": 1327.233,
    "text": "人类可能会得出结论"
  },
  {
    "start": 1327.266,
    "end": 1331.066,
    "text": "认为他的身体已被带进大角星飞船"
  },
  {
    "start": 1331.1,
    "end": 1332.866,
    "text": "但事实并非如此"
  },
  {
    "start": 1332.866,
    "end": 1334.733,
    "text": "原因很简单"
  },
  {
    "start": 1334.766,
    "end": 1337.8,
    "text": "人类大脑被多维相遇所淹没"
  },
  {
    "start": 1337.8,
    "end": 1340.066,
    "text": "停止追踪3维现实"
  },
  {
    "start": 1340.066,
    "end": 1341.8,
    "text": "对个人而言"
  },
  {
    "start": 1341.8,
    "end": 1343.833,
    "text": "这意味着大脑和思想"
  },
  {
    "start": 1343.866,
    "end": 1347.033,
    "text": "不再接受来自五种感官的输入"
  },
  {
    "start": 1347.033,
    "end": 1350.233,
    "text": "唯一的输入是在发生相遇的维度中"
  },
  {
    "start": 1350.266,
    "end": 1351.966,
    "text": "正在发生的事情"
  },
  {
    "start": 1351.966,
    "end": 1353.866,
    "text": "在某些情况下"
  },
  {
    "start": 1353.866,
    "end": 1356.233,
    "text": "大角星人建立微隧道"
  },
  {
    "start": 1356.266,
    "end": 1359.4,
    "text": "目的是与特定的人类存有交流"
  },
  {
    "start": 1359.4,
    "end": 1361.266,
    "text": "在某些情况下"
  },
  {
    "start": 1361.266,
    "end": 1365.266,
    "text": "人类存有会建立微隧道以联系大角星人"
  },
  {
    "start": 1365.3,
    "end": 1368.1,
    "text": "这些微隧道是双向的道路"
  },
  {
    "start": 1368.1,
    "end": 1371.666,
    "text": "你可以通过有意识的转换大脑和思想"
  },
  {
    "start": 1371.666,
    "end": 1372.866,
    "text": "与大角星人"
  },
  {
    "start": 1372.866,
    "end": 1376.333,
    "text": "或大角星现实的某些方面进行联系"
  },
  {
    "start": 1376.366,
    "end": 1378.966,
    "text": "稍后我会回到这个话题"
  },
  {
    "start": 1378.966,
    "end": 1380.033,
    "text": "但是"
  },
  {
    "start": 1380.066,
    "end": 1382.933,
    "text": "如果我们现在讨论第一类问题"
  },
  {
    "start": 1382.966,
    "end": 1385.233,
    "text": "将会更好地理解这一点"
  },
  {
    "start": 1385.233,
    "end": 1388.333,
    "text": "这些微隧道在多维空间移动"
  },
  {
    "start": 1388.333,
    "end": 1390.566,
    "text": "连接进入你的能量场"
  },
  {
    "start": 1390.566,
    "end": 1394.266,
    "text": "也就是你的古代传统所称的光环(气场)"
  },
  {
    "start": 1394.266,
    "end": 1397.9,
    "text": "但更确切地说是进入你的一个或多个脉轮"
  },
  {
    "start": 1397.933,
    "end": 1400.366,
    "text": "大多数人类存有是通过"
  },
  {
    "start": 1400.366,
    "end": 1402.666,
    "text": "他们的第三眼(松果体)或顶轮"
  },
  {
    "start": 1402.666,
    "end": 1404.733,
    "text": "与大角星人接触的"
  },
  {
    "start": 1404.766,
    "end": 1406.733,
    "text": "这意味着微隧道会进入"
  },
  {
    "start": 1406.733,
    "end": 1408.966,
    "text": "这些脉轮中的一个或多个"
  },
  {
    "start": 1408.966,
    "end": 1412.933,
    "text": "并且这些涡流(你的脉轮)产生的精微能量"
  },
  {
    "start": 1412.966,
    "end": 1415.166,
    "text": "会受到微隧道的影响"
  },
  {
    "start": 1415.166,
    "end": 1417.233,
    "text": "用一个比喻来说"
  },
  {
    "start": 1417.266,
    "end": 1420.866,
    "text": "它可以改变你精微能量体内的齿轮运动"
  },
  {
    "start": 1420.866,
    "end": 1424.233,
    "text": "当你的精微能量体发生变化时"
  },
  {
    "start": 1424.266,
    "end": 1427.166,
    "text": "你的大脑和思想也随之变化"
  },
  {
    "start": 1427.166,
    "end": 1429.366,
    "text": "它们被迫做出调整"
  },
  {
    "start": 1429.4,
    "end": 1431.4,
    "text": "正如我所说的那样"
  },
  {
    "start": 1431.433,
    "end": 1433.566,
    "text": "这种精微能量体的变化"
  },
  {
    "start": 1433.6,
    "end": 1436.2,
    "text": "导致阿尔法波活动增加"
  },
  {
    "start": 1436.2,
    "end": 1438.7,
    "text": "带来放松的身体意识状态"
  },
  {
    "start": 1438.7,
    "end": 1442.433,
    "text": "随着微隧道在脉轮附近增加影响"
  },
  {
    "start": 1442.466,
    "end": 1445.566,
    "text": "将会有更高的大脑频率峰值"
  },
  {
    "start": 1445.566,
    "end": 1447.133,
    "text": "不仅是伽玛波"
  },
  {
    "start": 1447.133,
    "end": 1449.366,
    "text": "而且还超出了伽玛波"
  },
  {
    "start": 1449.4,
    "end": 1453.8,
    "text": "达到更高的大脑活动阈值(120+赫兹)"
  },
  {
    "start": 1453.8,
    "end": 1458.133,
    "text": "当个人体验自己被带上大角星飞船时"
  },
  {
    "start": 1458.133,
    "end": 1460.233,
    "text": "这些微隧道中的一个"
  },
  {
    "start": 1460.266,
    "end": 1462.7,
    "text": "将跨维连接到脐轮"
  },
  {
    "start": 1462.7,
    "end": 1465.3,
    "text": "从而导致整个精微能量体"
  },
  {
    "start": 1465.3,
    "end": 1468.233,
    "text": "与飞船的振动现实产生共振"
  },
  {
    "start": 1468.266,
    "end": 1470.5,
    "text": "发生这种情况时"
  },
  {
    "start": 1470.5,
    "end": 1472.9,
    "text": "人类有两个平行的体验"
  },
  {
    "start": 1472.933,
    "end": 1474.2,
    "text": "同时在身体里"
  },
  {
    "start": 1474.2,
    "end": 1475.5,
    "text": "和在飞船上"
  },
  {
    "start": 1475.5,
    "end": 1477.766,
    "text": "在交流的某一时刻"
  },
  {
    "start": 1477.8,
    "end": 1481.633,
    "text": "人类可能体验到自己仅仅是在飞船上"
  },
  {
    "start": 1481.633,
    "end": 1484.0,
    "text": "这与意识从身体的输入"
  },
  {
    "start": 1484.0,
    "end": 1487.233,
    "text": "转移到飞船上高维体的输入有关"
  },
  {
    "start": 1487.266,
    "end": 1490.566,
    "text": "处于这种身体/思想状态下"
  },
  {
    "start": 1490.566,
    "end": 1494.333,
    "text": "个人可以在短时间内接收到很多信息"
  },
  {
    "start": 1494.333,
    "end": 1496.0,
    "text": "获得大量知识"
  },
  {
    "start": 1496.033,
    "end": 1500.1,
    "text": "这是因为我们主要的交流方式是全息感应"
  },
  {
    "start": 1500.133,
    "end": 1501.8,
    "text": "而不是文字语言"
  },
  {
    "start": 1501.8,
    "end": 1502.933,
    "text": "因此"
  },
  {
    "start": 1502.966,
    "end": 1504.966,
    "text": "根据你的3维时钟"
  },
  {
    "start": 1504.966,
    "end": 1508.833,
    "text": "个体可能只在飞船上体验自己几分钟"
  },
  {
    "start": 1508.866,
    "end": 1511.966,
    "text": "但是在大角星飞船的高维现实中"
  },
  {
    "start": 1511.966,
    "end": 1516.9,
    "text": "可以下载大量信息和深刻见解"
  }
]